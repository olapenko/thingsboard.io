---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { Products } from '@models/site.models';

import Hero from '@components/Landing/Hero.astro';
import EcosystemMark from '@components/Landing/EcosystemMark.astro';
import SectionHeader from '@components/Landing/SectionHeader.astro';
import PricingBackground from '@components/Pricing/PricingBackground.astro';
import { buildFaqPageSchema } from '@util/faq-schema';

import {
	onPremBenefits,
	onPremChoice,
	onPremCompare,
	onPremCtas,
	onPremFaq,
	onPremHeroCaption,
} from '~/data/onPremPage';

/**
 * ThingsBoard On-premises.
 *
 * WIP. The Cloud page's pattern, with develop's on-premises content curated onto it — the copy,
 * prices, plan limits and link targets come from `develop.tbqa.cloud/products/thingsboard-pe/` and
 * live in `src/data/onPremPage.ts`. Everything visual is shared: `styles/_product-page.scss` and
 * `util/faq-tabs.ts` are the same files the Cloud page uses, so the two cannot drift.
 *
 * WHAT THIS PAGE DOES DIFFERENTLY FROM THE CLOUD ONE, and why:
 *
 *   - NO "Platform features" section. That list is identical on both pages — it is the platform,
 *     not the deployment — so stating it twice says nothing about the choice a reader is here to
 *     make. It is the one section deliberately dropped.
 *   - The comparison is a different KIND of comparison. Cloud's table puts two ways to buy one
 *     product side by side; this one puts the platform against assembling your own stack, so the
 *     right-hand column is not a product and the headings say so.
 *   - The decision band is subscription against perpetual licence, which is the actual commercial
 *     choice a self-hosting reader faces. Cloud's is Public against Private.
 *   - The mark is the green `homeProducts` gives On-premises, not the Cloud indigo.
 *
 * WHAT DEVELOP HAD THAT IS NOT CARRIED OVER YET — all noted rather than silently dropped.
 * Re-checked against develop section by section, 2026-09-22; the first two were missing from
 * this list, not just from the page:
 *   - `#tb-customers`, the customer logo strip, with its three case-study links (T-Mobile CZ,
 *     Schwarz, Tektelic). The only social proof develop puts on this page.
 *   - `#platform`, "Everything you need to build, deploy, and scale IoT solutions" — the
 *     four-stage Connect / Context / Automate / Operate journey and its diagram. NOT the same
 *     section as the feature blocks below, which is why it was missed the first time.
 *   - The seven feature blocks (white-labeling, RBAC, integrations, entity groups, scheduler,
 *     reporting, CSV/XLS export) with their docs links. Several of these are in the comparison
 *     table already; the rest want a home on a later pass.
 *   - `#deploy-anywhere`, "Deploy anywhere, scale without surprises". Its headline claim, "From
 *     5 devices to 5+ million", is the one `scale-visual.ts` rejects as unsupported — so the
 *     panel can be carried over but that sentence cannot, and the benefit tile already states
 *     the benchmarked version.
 *   - The "Managed Services" panel, which on develop links to
 *     `/pricing/?product=thingsboard-private-cloud`.
 *   - The prose under "Simple and predictable pricing models". The chooser replaced the section;
 *     the paragraph explaining WHY the two models exist has no home yet.
 *
 * DELIBERATE DIVERGENCES from develop, so a later reader does not "fix" them back:
 *   - The hero badge. Develop shows "Top supplier retail 2024"; `HERO_ACHIEVEMENT = null` opts
 *     out, because this page's hero already carries the product mark.
 *   - The hero actions. Develop opens on "Get it now" → `/pricing/`; this page opens on
 *     "Install for free" → the install guide, and leaves pricing to the chooser.
 *   - Title and subtitle. Develop's H1 is "ThingsBoard On-premises IoT Platform".
 */

// The same asset the Cloud page knocks out on its squircle. `homeProducts` fills the On-premises
// badge with #1f8b4d, so the two products are marked the same way and coloured differently.
const TB_MARK = '/src/assets/images/landings/thingsboard-mark.svg';
/**
 * The product name for RENDERED headings, carrying a non-breaking hyphen (U+2011) so it never
 * splits across two lines — the hero's H1 was breaking after "On-" at tablet widths. Written as an
 * escape rather than the literal character, which is invisible in a diff.
 *
 * Deliberately NOT used in `<title>`, the meta description, aria-labels or URLs: nothing wraps
 * there, and a non-standard hyphen costs a reader's Ctrl-F and a crawler's exact match for nothing.
 */
const NAME = 'ThingsBoard On\u2011premises';

// `Hero` shows the "Top supplier retail 2024" badge for CE, PE and both PaaS products unless a page
// opts out. `null` is that opt-out — an omitted prop takes the default instead.
const HERO_ACHIEVEMENT = null;

/**
 * The hero's lede, built to mirror the Cloud page's clause for clause, because the two pages ARE
 * the same fork: "An IoT platform for device management, data processing and visualization —
 * fully managed by OUR team…" against "…deployed and run by YOUR team". That is the decision
 * `homeProducts.ts` names — "two deployments, one decision: who runs it" — and saying it in the
 * same words on both pages is what makes the two heroes read as two answers, not two products.
 *
 * WHAT CAME OUT. "Deployed where your policies and operations require it" is develop's own H2,
 * and it is the vaguest sentence on that page: it promises placement without naming one.
 * Develop's compressed version of the same page is better, and the second clause is taken from
 * it — the meta description, "full control of infrastructure, data location and compliance".
 * "Infrastructure" is the one word dropped, because the clause before already says your team
 * deploys and runs it, which is what controlling the infrastructure IS. Without it this lede is
 * the Cloud page's length and sets the same four lines at 1440.
 *
 * "Your data centre, your cloud account, or fully offline" came out because the two tiles
 * immediately below said it twice already. The hero was the third. Offline keeps its places —
 * the home card and the chooser, where the add-on it needs can be stated alongside it.
 *
 * A const rather than a literal in the tag: a `{/* … *\/}` comment among JSX attributes is not
 * valid there. The dev server rendered it anyway; `astro check` reported 8 errors for it.
 */
const HERO_SUBTITLE =
	'An IoT platform for device management, data processing and visualization — deployed and run by your team, with full control of data location and compliance.';

/** Answers shown per topic before "More questions", as on the Cloud page. */
const FAQ_VISIBLE = 6;

/**
 * FAQPage structured data, BUILT BUT NOT EMITTED — and that is deliberate.
 *
 * The Cloud page publishes its schema, and the same argument applies here: most topics sit behind
 * `hidden` panels, so an extractor that skips hidden content sees a fraction of what the page says.
 * What stops it is that this FAQ contradicts itself, in the repo's own live data:
 *
 *   - REFUNDS. Billing says there are no refunds for unused time but "the funds for the remaining
 *     period will be saved on your account balance"; Trials says "No, all sales are final". A
 *     credit balance and all-sales-final are not the same policy.
 *   - ANNUAL PAYMENT. Two answers offer "pay annually with card or wire transfer"; a third says
 *     "we currently offer only a monthly subscription".
 *
 * Publishing those as schema.org lets a search engine surface either side as the authoritative
 * answer, under our own markup. `/pricing/` renders the same data and emits schema for the Cloud
 * context ONLY (`FAQ_JSONLD_CONTEXT`), so nothing publishes these today and withholding costs us
 * nothing we currently have. Flip `jsonLd={faqPageSchema}` back on once the copy is reconciled.
 */
const faqPageSchema = buildFaqPageSchema(onPremFaq);
---

<BaseLayout
	headerVariant="transparent"
	forceLightTheme
	title="ThingsBoard On-premises"
	description="ThingsBoard On-premises — the full IoT platform, deployed and run on infrastructure you control, under a subscription or a perpetual licence."
>
	<Hero
		product={Products.PE}
		title={NAME}
		subtitle={HERO_SUBTITLE}
		achievement={HERO_ACHIEVEMENT}
		buttons={[
			{
				text: onPremCtas.install.text,
				icon: 'tabler:server',
				href: onPremCtas.install.href,
				variant: 'brand',
				ariaLabel: 'Installation guides for ThingsBoard On-premises',
			},
			{ text: onPremCtas.secondary.text, icon: 'tabler:message-circle', href: onPremCtas.secondary.href, variant: 'outline' },
		]}
		layout="split"
		showArrow={false}
		anchorLink="#benefits"
	>
		{/* `kicker` is Hero's own slot, directly above the headline — the mark is an inlined SVG
		    rather than a Tabler name, so it cannot ride on a prop the way a glyph would. */}
		<span slot="kicker" class="hero-mark" aria-hidden="true">
			<EcosystemMark src={TB_MARK} class="hero-mark__glyph" filled />
		</span>
		<ul class="hero-caption" aria-label="Getting started with ThingsBoard On-premises">
			{
				onPremHeroCaption.map((item) => (
					<li>
						<Icon name="tabler:check" aria-hidden="true" />
						{item}
					</li>
				))
			}
		</ul>
	</Hero>

	<section id="overflow">
		<section id="benefits">
			<div class="main-div">
				<SectionHeader
					title={`Why ${NAME}`}
					subtitle="For teams whose data, network or compliance position means the platform has to live on their own infrastructure."
					titleSize="title"
					subtitleMeasure="copy"
				/>
				<div class="benefit-grid">
					{
						onPremBenefits.map((benefit) => (
							<div class="benefit-card">
								<Icon
									name={benefit.icon}
									class="benefit-card__icon"
									style={`color: ${benefit.color}`}
									aria-hidden="true"
								/>
								<h3 class="benefit-card__title">{benefit.title}</h3>
								<p class="benefit-card__text">{benefit.description}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section id="matrix">
			<div class="main-div">
				<SectionHeader
					title="ThingsBoard vs a custom IoT stack"
					subtitle="What the platform brings built in, against what the same solution costs to assemble from separate services."
					titleSize="title"
					subtitleMeasure="copy"
				/>

				{/* `scope` on every header cell: the row labels are headers too, which is what lets a screen
				    reader announce "Monitoring, ThingsBoard, Prometheus and Grafana…" instead of the value
				    alone. The right-hand column is NOT a product — the caption says so outright, since a
				    two-column table invites the reader to assume it is. */}
				<div class="matrix-scroll">
					<table class="matrix">
						<caption class="sr-only">
							ThingsBoard compared with an IoT stack assembled from separate services
						</caption>
						<thead>
							<tr>
								<th scope="col">Capability</th>
								{
									onPremChoice.columns.map((column) => (
										<th scope="col">
											<span class="matrix__col">
												<Icon name={column.icon} class="matrix__col-mark" aria-hidden="true" />
												{column.name}
											</span>
										</th>
									))
								}
							</tr>
						</thead>
						<tbody>
							{
								onPremCompare.map((group) => (
									<>
										<tr class="matrix__group">
											{/* A group heading spans the table, so it is a header for everything under it. */}
											<th scope="colgroup" colspan="3">
												<span>
													<span class="group-mark" style={`--group-mark-color: ${group.color}`} aria-hidden="true">
														<Icon name={group.icon} />
													</span>
													{group.title}
												</span>
											</th>
										</tr>
										{group.rows.map((row) => (
											<tr>
												<th scope="row">{row.label}</th>
												{row.values.map((value, i) => (
													<td>
														{/* The column's name, in the cell. Hidden above 880 where the header row
														    does the job; below it the table reflows to blocks and this is what
														    keeps every value attached to its column. */}
														<span class="matrix__cell-label">{onPremChoice.columns[i].name}</span>
														<span>{value}</span>
													</td>
												))}
											</tr>
										))}
									</>
								))
							}
						</tbody>
					</table>
				</div>
			</div>
		</section>

		{/* The choice, under the table that informs it — and outside that section's measure, so its
		    ground runs the full width the way the bookend's does. On this page the two options are
		    the two ways to licence a self-hosted deployment, not two products. */}
		<section id="choose">
			<PricingBackground contained />
			<div class="choice__inner">
				<h3 class="choice__title">{onPremChoice.title}</h3>
				<p class="choice__lead">{onPremChoice.lead}</p>

				<div class="choice-grid">
					{
						onPremChoice.options.map((option) => (
							<div class="choice-card">
								<h4 class="choice-card__name">
									<Icon name={option.icon} class="choice-card__mark" aria-hidden="true" />
									{option.name}
								</h4>
								<p class="choice-card__price">
									{option.price}
									<span class="choice-card__price-note">{option.priceNote}</span>
								</p>
								<p class="choice-card__summary">{option.summary}</p>
								<ul class="choice-card__points">
									{option.points.map((point) => (
										<li>
											<Icon name="tabler:check" aria-hidden="true" />
											{point}
										</li>
									))}
								</ul>
								<div class="choice-card__actions">
									<a
										class:list={['choice-card__cta', `choice-card__cta--${option.cta.variant}`]}
										href={option.cta.href}
									>
										<Icon name={option.cta.icon} class="choice-card__cta-icon" aria-hidden="true" />
										{option.cta.text}
										<span class="sr-only">— {option.name}</span>
									</a>
									<a class="choice-card__plans" href={option.plansHref}>
										See plans
										<span class="sr-only">for the {option.name}</span>
										<Icon name="tabler:chevron-right" aria-hidden="true" />
									</a>
								</div>
							</div>
						))
					}
				</div>

				{/* The mirror of the Cloud page's on-premises line: the exit to the managed alternative. */}
				<p class="choice-note">
					<Icon name={onPremCtas.cloud.icon} class="choice-note__mark" aria-hidden="true" />
					{onPremCtas.cloud.lead}
					<a href={onPremCtas.cloud.href}>{onPremCtas.cloud.text}</a>{onPremCtas.cloud.tail}
				</p>
			</div>
		</section>

		<section id="faq">
			<div class="main-div">
				<SectionHeader title={`${NAME} FAQ`} titleSize="title" />
				<div class="faq-layout">
					<div class="faq-tabs" role="tablist" aria-orientation="vertical" aria-label="FAQ topics">
						{
							onPremFaq.map((category, i) => (
								<button
									type="button"
									role="tab"
									id={`faq-tab-${i}`}
									class:list={['faq-tab', i === 0 && 'is-active']}
									aria-controls={`faq-panel-${i}`}
									aria-selected={i === 0 ? 'true' : 'false'}
									tabindex={i === 0 ? 0 : -1}
								>
									{category.label}
								</button>
							))
						}
					</div>

					<div class="faq-panels">
						{
							onPremFaq.map((category, i) => (
								<div
									role="tabpanel"
									id={`faq-panel-${i}`}
									class="faq-panel"
									aria-labelledby={`faq-tab-${i}`}
									hidden={i !== 0}
								>
									{category.items.map((item, j) => (
										<details class:list={['faq-item', j >= FAQ_VISIBLE && 'faq-item--extra']}>
											<summary>
												<span>{item.question}</span>
												<Icon name="tabler:chevron-down" class="faq-item__chevron" aria-hidden="true" />
											</summary>
											<div class="faq-item__answer" set:html={item.answer} />
										</details>
									))}
									{category.items.length > FAQ_VISIBLE && (
										<button type="button" class="faq-more" aria-expanded="false">
											<span class="faq-more__label">More questions</span>
											<Icon name="tabler:chevron-down" class="faq-more__chevron" aria-hidden="true" />
										</button>
									)}
								</div>
							))
						}
					</div>
				</div>
			</div>
		</section>
	</section>

	<section class="page-closing">
		<PricingBackground contained />
		<div class="page-closing__inner">
			<h2 class="page-closing__title">Ready to deploy ThingsBoard?</h2>
			<p class="page-closing__lead">
				Start on the Free plan and run it on your own hardware, or talk to our team about a perpetual licence and
				offline operation.
			</p>
			<div class="page-closing__actions">
				<a class="page-closing__primary" href={onPremCtas.install.href}>
					<Icon name="tabler:server" aria-hidden="true" />
					{onPremCtas.install.text}
				</a>
				<a class="page-closing__secondary" href={onPremCtas.secondary.href}>
					<Icon name="tabler:message-circle" aria-hidden="true" />
					{onPremCtas.secondary.text}
				</a>
			</div>
			<p class="page-closing__note">
				<a href={onPremCtas.legal.href}>{onPremCtas.legal.text}</a>
			</p>
		</div>
	</section>
</BaseLayout>

<script>
	// The FAQ tab set, shared with the Cloud page — see `util/faq-tabs.ts`.
	import { mountFaqTabs } from '~/util/faq-tabs';

	mountFaqTabs();
</script>

<style is:global lang="scss">
	@use '../../../styles/variables' as *;
	// Every visual rule on this page is the Cloud page's, shared rather than copied.
	@use '../../../styles/product-page';

	// This page's own, and most of it is one decision: On-premises is the green product, so the
	// page's own primaries, the hero it opens on and the band it closes on take that green where
	// the Cloud page takes the brand purple. Site chrome is deliberately NOT in this set — the
	// header's "Try for free" and the footer's "Subscribe" are the same on every page, and the
	// partial keeps them on `$color-brand` for that reason.
	:root {
		--page-accent: #{$color-pe-dark};
		// Near-black with the product's cast, as the Cloud page's `#121425` is near-black with the
		// primary's. The page opens and closes on the same hue at two lightnesses.
		--page-hero-ground: #101a14;
		--page-hero-wash: #{rgba($color-pe-dark, 0.32)};
		--page-band: #f1f8f4;
		// The field is drawn at 3.5–10% opacity, where `$color-pe-dark` all but vanishes — so the
		// motion takes the lifted PE green, as the field's own blue is lifted off the brand purple.
		--page-wave: #{$color-pe-hover};
		// The chooser's prices sit on the dark band, where the accent itself is unreadable — this
		// is the same lift `$color-brand-dark` is to `$color-brand`, in the product's hue.
		--page-accent-light: #b4e7cd;
		--page-sticky-band: #e7f4ec;
		// 5.74:1 on the pinned row. `$color-pe-dark` would be 3.82:1 there — it clears AA as a
		// fill under white, not as text.
		--page-accent-ink: #{$color-pe-link};
	}

	// The comparison keeps a white ground: the two light bands either side of it — the pinned
	// header and the bookend — are the tinted ones, so the table reads as the thing between them
	// rather than a third tint.
	#matrix {
		--matrix-band: #fff;
	}

	// The badge takes the same green rather than a second literal of it.
	#hero.split .hero-mark {
		--page-mark-color: var(--page-accent);
	}


</style>
