---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { Products } from '@models/site.models';

import Hero from '@components/Landing/Hero.astro';
import CustomersLogo from '@components/Landing/CustomersLogo.astro';
import IntroSection from '@components/Landing/IntroSection.astro';
import SectionHeader from '@components/Landing/SectionHeader.astro';
import PricingBackground from '@components/Pricing/PricingBackground.astro';
import { heroLcpPreload } from '@util/lcp-preload';

import {
	paasBenefits,
	paasChoice,
	paasCompare,
	paasCompareLead,
	paasCtas,
	paasFaq,
	paasShared,
	paasWhiteLabeling,
} from '~/data/paasPage';

/**
 * ThingsBoard Cloud.
 *
 * The develop page's content in the homepage candidate's language. Nothing here is a new claim:
 * the copy, the prices and the link targets come from `develop.tbqa.cloud/products/paas/` and live
 * in `src/data/paasPage.ts` — see the note there for why they could not be taken from a branch.
 *
 * WHAT CHANGED, and it is only ever the frame:
 *
 *   - The hero takes the homepage's split layout, brand primary and outline secondary, in place of
 *     the full-bleed image and lone outline button.
 *   - `CustomersLogo` runs `onDark`, closing the hero rather than opening the content — the
 *     homepage's own arrangement, and the near half of its bookend.
 *   - The five icon cards become four squircle-marked cards plus a chooser. Develop's fifth card,
 *     "Public vs Private cloud choice", was doing a different job from the other four: it picks
 *     between two products where they describe one. It leads instead, as the two-card `#choice`.
 *   - The matrix is rebuilt rather than reused. `PaasComparisonMatrix` in this repo is the OLD
 *     Cloud-vs-PE table and answers a different question; develop's is Public vs Private.
 *   - The FAQ is 82 `<details>` under seven headings, where develop runs a sidebar of category tabs
 *     over a panel with "Load more". Same answers, no script: a tab set that hides six sevenths of
 *     the page's text behind JavaScript is not what "simple" should buy.
 *   - The closing band is the bookend — the same #121425 ground and wave field as `ClosingCta`,
 *     with this page's CTAs instead of the homepage's.
 *
 * The background blobs (`#background` and its seven divs) are gone with the rest of that layer.
 */

const HERO_BACKGROUND = '/hero/pe-cover.webp';
---

<BaseLayout
	headerVariant="transparent"
	forceLightTheme
	title="ThingsBoard Cloud"
	description="ThingsBoard Cloud — fully managed, scalable, fault-tolerant IoT platform with infrastructure managed by our team."
	preloadLcpImage={heroLcpPreload(HERO_BACKGROUND)}
>
	<Hero
		product={Products.PAAS}
		backgroundImage={HERO_BACKGROUND}
		title="ThingsBoard Cloud"
		subtitle="Fully managed, scalable and fault-tolerant platform for your IoT applications"
		buttons={[
			{
				text: paasCtas.primary.text,
				icon: 'tabler:cloud-filled',
				href: paasCtas.primary.href,
				variant: 'brand',
				ariaLabel: 'Try ThingsBoard Cloud for free',
			},
			{ text: paasCtas.secondary.text, icon: 'tabler:message-circle', href: paasCtas.secondary.href, variant: 'outline' },
		]}
		layout="split"
		showArrow={false}
		anchorLink="#intro"
		videoBackground={{
			webm: 'https://video.thingsboard.io/pe-cover.webm',
			mp4: 'https://video.thingsboard.io/pe-cover.mp4',
		}}
	>
		<p class="header-animation hero-note">
			Evaluating for a large deployment?
			<a href={paasCtas.privateCloud.href}>
				Talk to us about Private Cloud
				<Icon name="tabler:chevron-right" size="14" aria-hidden="true" />
			</a>
		</p>
	</Hero>

	<CustomersLogo productTag="paas" onDark />

	<section id="overflow">
		<IntroSection
			title="ThingsBoard Cloud is an IoT platform for device management, data processing, and visualization with infrastructure managed by our team"
			description="For everyone who would like to use ThingsBoard but doesn't want to host their own instance of the platform."
			titleLink={null}
		/>

		{/* The chooser. Develop states this as a card in the grid; it is the page's first question. */}
		<section id="choice">
			<div class="main-div">
				<SectionHeader title={paasChoice.title} subtitle={paasChoice.lead} titleSize="section" subtitleMeasure="copy" />
				<div class="choice-grid">
					{
						paasChoice.options.map((option) => (
							<a class="choice-card" href={option.href}>
								<h3 class="choice-card__name">{option.name}</h3>
								<p class="choice-card__summary">{option.summary}</p>
								<ul class="choice-card__points">
									{option.points.map((point) => (
										<li>
											<Icon name="tabler:check" aria-hidden="true" />
											{point}
										</li>
									))}
								</ul>
								<span class="choice-card__action">
									See plans
									<Icon name="tabler:chevron-right" aria-hidden="true" />
								</span>
							</a>
						))
					}
				</div>
			</div>
		</section>

		<section id="benefits">
			<div class="main-div">
				<SectionHeader
					title="Why ThingsBoard Cloud"
					subtitle="We run the platform, so the only thing your team builds is the solution on top of it."
					titleSize="section"
					subtitleMeasure="copy"
				/>
				<div class="benefit-grid">
					{
						paasBenefits.map((benefit) => (
							<div class="benefit-card">
								<span class="benefit-card__badge" style={`--badge-color: ${benefit.color}`} aria-hidden="true">
									<Icon name={benefit.icon} />
								</span>
								<h3 class="benefit-card__title">{benefit.title}</h3>
								<p class="benefit-card__text">{benefit.description}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section id="matrix">
			<div class="main-div">
				<SectionHeader
					title="Public Cloud vs Private Cloud"
					subtitle="Where the two differ — infrastructure and scale, reliability and operations, compliance, and what each one costs."
					titleSize="section"
					subtitleMeasure="copy"
				/>

				{/* `scope` on every header cell: the row labels are headers too, which is what lets a screen
				    reader announce "Uptime SLA, Private Cloud, 99.9% – 99.99%" instead of the value alone. */}
				<div class="matrix-scroll">
					<table class="matrix">
						<caption class="sr-only">
							ThingsBoard Public Cloud compared with ThingsBoard Private Cloud
						</caption>
						<thead>
							<tr>
								<th scope="col">Feature</th>
								<th scope="col">Public Cloud</th>
								<th scope="col">Private Cloud</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<th scope="row">{paasCompareLead.label}</th>
								{paasCompareLead.values.map((value) => <td>{value}</td>)}
							</tr>
							{
								paasCompare.map((group) => (
									<>
										<tr class="matrix__group">
											{/* A group heading spans the table, so it is a header for everything under it. */}
											<th scope="colgroup" colspan="3">
												{group.title}
											</th>
										</tr>
										{group.rows.map((row) => (
											<tr>
												<th scope="row">{row.label}</th>
												{row.values.map((value) => (
													<td class:list={[value === '—' && 'matrix__none']}>
														{value === '—' ? <span class="sr-only">Not included</span> : null}
														<span aria-hidden={value === '—' ? 'true' : undefined}>{value}</span>
													</td>
												))}
											</tr>
										))}
									</>
								))
							}
							<tr class="matrix__group">
								<th scope="colgroup" colspan="3">The same platform on both</th>
							</tr>
							<tr>
								<th scope="row">{paasWhiteLabeling.label}</th>
								{paasWhiteLabeling.values.map((value) => <td>{value}</td>)}
							</tr>
						</tbody>
					</table>
				</div>

				<div class="matrix-cta">
					<a class="matrix-cta__primary" href={paasCtas.primary.href}>
						<Icon name="tabler:cloud-filled" aria-hidden="true" />
						{paasCtas.primary.text}
						<span class="sr-only">— ThingsBoard Public Cloud</span>
					</a>
					<a class="matrix-cta__secondary" href={paasCtas.privateCloud.href}>
						{paasCtas.privateCloud.text}
						<span class="sr-only">— ThingsBoard Private Cloud</span>
						<Icon name="tabler:chevron-right" aria-hidden="true" />
					</a>
				</div>
			</div>
		</section>

		<section id="shared">
			<div class="main-div">
				<SectionHeader
					title="The same platform on both"
					subtitle="Every capability below is included in ThingsBoard Public Cloud and ThingsBoard Private Cloud alike."
					titleSize="section"
					subtitleMeasure="copy"
				/>
				<div class="shared-groups">
					{
						paasShared.map((group) => (
							<div class="shared-group">
								<h3 class="shared-group__title">{group.title}</h3>
								<dl class="shared-group__list">
									{group.rows.map((row) => (
										<div class="shared-row">
											<dt>{row.label}</dt>
											<dd>{row.detail}</dd>
										</div>
									))}
								</dl>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section id="faq">
			<div class="main-div">
				<SectionHeader title="ThingsBoard Cloud FAQ" titleSize="section" />
				<div class="faq-groups">
					{
						paasFaq.map((category) => (
							<div class="faq-group">
								<h3 class="faq-group__title">{category.title}</h3>
								{category.items.map((item) => (
									<details class="faq-item">
										<summary>
											<span>{item.q}</span>
											<Icon name="tabler:chevron-down" class="faq-item__chevron" aria-hidden="true" />
										</summary>
										<div class="faq-item__answer" set:html={item.a} />
									</details>
								))}
							</div>
						))
					}
				</div>
			</div>
		</section>
	</section>

	{/* The far half of the bookend: ClosingCta's ground and field, this page's calls to action. */}
	<section class="paas-closing">
		<PricingBackground contained />
		<div class="paas-closing__inner">
			<h2 class="paas-closing__title">Ready to build on ThingsBoard Cloud?</h2>
			<p class="paas-closing__lead">
				Start free on Public Cloud in under five minutes, or talk to our team about a dedicated Private Cloud cluster.
			</p>
			<div class="paas-closing__actions">
				<a class="paas-closing__primary" href={paasCtas.primary.href}>
					<Icon name="tabler:cloud-filled" aria-hidden="true" />
					{paasCtas.primary.text}
				</a>
				<a class="paas-closing__secondary" href={paasCtas.secondary.href}>
					<Icon name="tabler:message-circle" aria-hidden="true" />
					{paasCtas.secondary.text}
				</a>
			</div>
			<p class="paas-closing__note">
				<a href={paasCtas.privacy.href}>{paasCtas.privacy.text}</a>
			</p>
		</div>
	</section>
</BaseLayout>

<style is:global lang="scss">
	@use '../../../styles/landing';
	@use '../../../styles/variables' as *;
	// The homepage's measure and row rhythm. This page has no alternating rows, so only the first
	// half of the file applies — `.main-div` at 1000, giving the 960 column the grids below assume.
	@use '../../../styles/sections-flat';

	// ---------------------------------------------------------------------------------------------
	// Page tokens. Restated from the homepage rather than shared: the two pages are the only things
	// on the site using them, and lifting them into `_variables.scss` would make them theme colours,
	// which they are not — see the same note on `ClosingCta`.
	// ---------------------------------------------------------------------------------------------
	// Visually hidden, still announced. The site has no global utility for this — the one `.sr-only`
	// in the repo is scoped inside `FeedbackPrompt` — so the table's caption and the CTAs' product
	// suffixes need it declared here or they would render as visible stray text.
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}

	html:root {
		--home-header-h: 64px;
		--sl-color-text-accent: #{$color-brand};
		--color-primary: #{$color-brand};
		--tb-main-color: #{$color-brand};
		--hero-muted: rgba(150, 164, 255, 0.72);
	}

	header.header {
		height: var(--home-header-h);
		transition-duration: 0.1s;
	}

	// The scrim under the transparent bar, as the homepage sets it: this hero is a split panel too,
	// so the nav crosses both the black column and the footage and needs one continuous ground.
	header.header:not(.opened-burger):not([data-header-scrolled]):has([data-header-variant='transparent']) {
		background-color: rgba(0, 0, 0, 0.8);
	}

	#hero .button.brand {
		background-color: $color-brand;
		color: #fff;
		font-weight: $font-weight-bold;

		&:hover {
			background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2));
		}

		&:active {
			background-image: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3));
		}
	}

	.hero-note {
		@include type-small;
		margin: 24px 0 0;
		color: rgba(255, 255, 255, 0.6);

		// Restated locally for the same reason the homepage restates it: this paragraph is slotted
		// into Hero, so it never receives that component's scope hash and none of its
		// `.header-animation` rules match.
		&.header-animation {
			opacity: 0;
			transform: translate3d(0, 45px, 0);
			animation-name: slideup-in;
			animation-duration: 600ms;
			animation-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94);
			animation-fill-mode: forwards;
			animation-delay: 1200ms;
		}

		@media (prefers-reduced-motion: reduce) {
			&.header-animation {
				animation: none;
				opacity: 1;
				transform: none;
			}
		}

		a {
			display: flex;
			width: fit-content;
			align-items: center;
			gap: 2px;
			margin-top: 6px;
			color: rgba(255, 255, 255, 0.85);
			text-decoration: underline;
			text-underline-offset: 3px;

			&:hover,
			&:focus-visible {
				color: #fff;
			}
		}
	}

	#overflow {
		position: relative;
		overflow: hidden;
	}

	// ---------------------------------------------------------------------------------------------
	// The chooser
	// ---------------------------------------------------------------------------------------------
	#choice {
		padding-bottom: $spacing-20;

		@include media-down(md) {
			padding-bottom: $spacing-12;
		}

		.section-header {
			margin-bottom: $spacing-10;
		}
	}

	.choice-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: $spacing-6;
		max-width: 960px;
		margin-inline: auto;

		@include media-down(md) {
			grid-template-columns: 1fr;
		}
	}

	.choice-card {
		display: flex;
		flex-direction: column;
		gap: $spacing-3;
		padding: $spacing-8;
		border: 1px solid rgba(61, 80, 245, 0.16);
		border-radius: 16px;
		background-color: #fff;
		color: var(--color-text);
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			transform 0.15s ease;

		&:hover,
		&:focus-visible {
			border-color: $color-brand;
			transform: translateY(-2px);
		}

		&:focus-visible {
			outline: 2px solid $color-brand;
			outline-offset: 3px;
		}

		@media (prefers-reduced-motion: reduce) {
			transition: border-color 0.15s ease;

			&:hover,
			&:focus-visible {
				transform: none;
			}
		}

		&__name {
			@include subsection-title;
			margin: 0;
			color: var(--color-text);
		}

		&__summary {
			@include type-body;
			margin: 0;
			color: var(--color-text-secondary);
		}

		&__points {
			@include type-small;
			display: flex;
			flex-direction: column;
			gap: $spacing-2;
			margin: $spacing-2 0 0;
			padding: 0;
			list-style: none;

			li {
				display: flex;
				align-items: flex-start;
				gap: $spacing-2;
			}

			svg {
				flex: none;
				width: 18px;
				height: 18px;
				margin-top: 2px;
				color: $color-brand;
			}
		}

		&__action {
			@include type-action;
			display: inline-flex;
			align-items: center;
			gap: 2px;
			margin-top: auto;
			padding-top: $spacing-4;
			color: $color-brand;

			svg {
				width: 18px;
				height: 18px;
			}
		}

		&:hover &__action,
		&:focus-visible &__action {
			text-decoration: underline;
			text-underline-offset: 3px;
		}
	}

	// ---------------------------------------------------------------------------------------------
	// Benefits
	// ---------------------------------------------------------------------------------------------
	#benefits {
		padding-top: $spacing-16;
		padding-bottom: $spacing-20;
		// The primary-derived light the homepage gives its bands.
		background-color: #f5f6ff;

		@include media-down(md) {
			padding-top: $spacing-10;
			padding-bottom: $spacing-12;
		}

		.section-header {
			margin-bottom: $spacing-10;
		}
	}

	.benefit-grid {
		display: grid;
		// Two across, stated rather than auto-fit. There are four cards, and at the 960 measure
		// `minmax(300px, 1fr)` fits three — which leaves the fourth alone on a row. Two gives a 2×2
		// and a 468px column, wide enough for "Everything you need to build IoT solutions" to sit on
		// two lines instead of three.
		grid-template-columns: repeat(2, 1fr);
		gap: $spacing-6;
		max-width: 960px;
		margin-inline: auto;

		@include media-down(md) {
			grid-template-columns: 1fr;
		}
	}

	.benefit-card {
		padding: $spacing-8;
		border-radius: 16px;
		background-color: #fff;

		&__badge {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			// The 48px tile at 32% radius that `SectionHeader` and `FeatureBlockSection` both draw.
			width: 48px;
			height: 48px;
			margin-bottom: $spacing-4;
			border-radius: 32%;
			background-color: var(--badge-color);
			color: #fff;

			svg {
				width: 26px;
				height: 26px;
			}
		}

		&__title {
			@include subsection-title;
			margin: 0 0 $spacing-2;
			color: var(--color-text);
		}

		&__text {
			@include type-body;
			margin: 0;
			color: var(--color-text-secondary);
		}
	}

	// ---------------------------------------------------------------------------------------------
	// The matrix
	// ---------------------------------------------------------------------------------------------
	#matrix {
		padding-top: $spacing-20;
		padding-bottom: $spacing-20;

		@include media-down(md) {
			padding-top: $spacing-12;
			padding-bottom: $spacing-12;
		}

		.section-header {
			margin-bottom: $spacing-10;
		}
	}

	// The table keeps its own width below the measure and scrolls rather than wrapping prices onto
	// four lines. `tabindex` is not set on it: `overflow` alone makes it keyboard-scrollable in every
	// engine that ships this table, and a focusable div with no label is worse than neither.
	.matrix-scroll {
		max-width: 960px;
		margin-inline: auto;
		overflow-x: auto;
	}

	.matrix {
		width: 100%;
		min-width: 720px;
		border-collapse: collapse;
		text-align: left;

		caption {
			text-align: left;
		}

		thead th {
			@include type-small-strong;
			position: sticky;
			top: 0;
			padding: $spacing-4;
			border-bottom: 2px solid rgba(61, 80, 245, 0.2);
			background-color: #fff;
			color: var(--color-text);

			&:not(:first-child) {
				color: $color-brand;
			}
		}

		tbody th[scope='row'] {
			@include type-small-strong;
			width: 30%;
			padding: $spacing-4;
			color: var(--color-text);
			vertical-align: top;
		}

		td {
			@include type-small;
			padding: $spacing-4;
			color: var(--color-text-secondary);
			vertical-align: top;
		}

		tbody tr:not(.matrix__group) {
			border-bottom: 1px solid rgba(15, 23, 42, 0.08);
		}

		&__group th {
			@include type-eyebrow;
			padding: $spacing-8 $spacing-4 $spacing-2;
			color: $color-brand;
		}

		// An em dash is a value here, not an absence of one — the cell says "not included", which the
		// sr-only span states in words for anyone who cannot see that it is a dash.
		&__none {
			color: rgba(15, 23, 42, 0.4);
		}
	}

	.matrix-cta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: $spacing-4;
		margin-top: $spacing-10;

		&__primary,
		&__secondary {
			// ClosingCta's geometry, which is the hero pair's — so every button on the page matches.
			@include type-button;
			display: inline-flex;
			align-items: center;
			gap: $spacing-2;
			height: 44px;
			padding: 0 $spacing-4;
			border-radius: $radius-md;
			text-decoration: none;

			svg {
				width: 18px;
				height: 18px;
				flex: 0 0 auto;
			}

			&:focus-visible {
				outline: 2px solid $color-brand;
				outline-offset: 3px;
			}
		}

		&__primary {
			background-color: $color-brand;
			color: #fff;

			&:hover {
				background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2));
			}
		}

		&__secondary {
			border: 1px solid rgba(61, 80, 245, 0.35);
			color: $color-brand;

			&:hover {
				background-color: rgba(61, 80, 245, 0.08);
			}
		}
	}

	// ---------------------------------------------------------------------------------------------
	// The shared half
	// ---------------------------------------------------------------------------------------------
	#shared {
		padding-top: $spacing-16;
		padding-bottom: $spacing-20;
		background-color: #f5f6ff;

		@include media-down(md) {
			padding-top: $spacing-10;
			padding-bottom: $spacing-12;
		}

		.section-header {
			margin-bottom: $spacing-10;
		}
	}

	.shared-groups {
		display: flex;
		flex-direction: column;
		gap: $spacing-10;
		max-width: 960px;
		margin-inline: auto;
	}

	.shared-group {
		&__title {
			@include type-eyebrow;
			margin: 0 0 $spacing-4;
			color: $color-brand;
		}

		&__list {
