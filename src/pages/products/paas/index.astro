---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { Products } from '@models/site.models';

import Band from '@components/ui/Band.astro';
import Mark from '@components/ui/Mark.astro';
import Hero from '@components/Landing/Hero.astro';
import Bookend from '@components/Landing/Bookend.astro';
import BenefitGrid from '@components/Landing/BenefitGrid.astro';
import ChoiceBand from '@components/Landing/ChoiceBand.astro';
import ProductFaq from '@components/Landing/ProductFaq.astro';
import ProductMatrix from '@components/Landing/ProductMatrix.astro';
import SectionHeader from '@components/Landing/SectionHeader.astro';
import { BOOKENDS } from '@data/bookends';

import {
	paasBenefits,
	paasChoice,
	paasCompare,
	paasCompareLead,
	paasCtas,
	paasHeroCaption,
	paasFaq,
	paasOnPremises,
} from '@data/paasPage';

/**
 * ThingsBoard Cloud.
 *
 * Main's page in the homepage candidate's language. Nothing here is a new claim: the copy, the
 * prices and the link targets are main's (the content team's, edited in `thingsboard.one`) and
 * live in `src/data/paasPage.ts` — see the note there before changing a word.
 *
 * WHAT CHANGED, and it is only ever the frame:
 *
 *   - The hero is the type alone, centred on the page's ground (`Hero`'s split layout with
 *     `panel={false}`), with the brand primary and outline secondary in place of the full-bleed
 *     image and lone outline button, and the deployment's mark over the headline.
 *   - The customer strip and the "Top supplier retail 2024" badge are both off.
 *   - The choice between the two deployments is the two-card chooser UNDER the comparison table,
 *     with the entry price and a call to action on each card — once, after the reader has seen
 *     what there is to decide on.
 *   - NO "Platform features" section, as on main (the content team dropped it on 2026-09-25).
 *     Those capabilities are the platform, not the deployment — identical on Cloud, Private Cloud
 *     and On-premises — so listing them says nothing about the choice a reader is here to make.
 *   - The matrix is `ProductMatrix`, Cloud against Private Cloud, main's rows.
 *   - The FAQ is a sidebar of topics, one panel, six answers behind "Load more" — with real tab
 *     semantics and keyboard support, and degrades to the first topic's answers as prose when the
 *     script does not run (`ProductFaq`, shared with On-premises).
 *   - Every section is a `ui/Band`, and the blocks are the ones the On-premises page renders:
 *     `BenefitGrid`, `ProductMatrix`, `ChoiceBand`, `ProductFaq`.
 *   - The two-card chooser, `ChoiceBand`, sits on the hero's ground after the table, and the page
 *     closes on `Bookend`, light, with this page's CTAs.
 *
 * The background blobs (`#background` and its seven divs) are gone with the rest of that layer.
 */

// `Hero` shows the "Top supplier retail 2024" badge for CE, PE and both PaaS products unless a page
// opts out, and `null` is that opt-out — an omitted prop takes the default instead.
const HERO_ACHIEVEMENT = null;

// Answers shown per topic before "More questions". The count is per panel, so a topic at or under it
// renders no button at all.
const FAQ_VISIBLE = 6;

// NO FAQPage structured data, as on main. The answers are the pricing FAQ's own (`paasFaq`), and
// `/pricing/` already publishes them as its one FAQPage; the same questions marked up on two pages
// would compete with each other for the same result.
---

<BaseLayout
	search={false}
	hero="dark"
	forceLightTheme
	title="ThingsBoard Cloud"
	description="ThingsBoard Cloud — an IoT platform for device management, data processing, and visualization, with the infrastructure managed by our team."
>
	<Hero
		product={Products.PAAS}
		title="ThingsBoard Cloud"
		subtitle="Device management, data processing and visualization — fully managed by our team, on shared infrastructure or a dedicated private cluster."
		achievement={HERO_ACHIEVEMENT}
		buttons={[
			{
				text: paasCtas.primary.text,
				icon: 'tabler:cloud-filled',
				href: paasCtas.primary.href,
				variant: 'brand',
				attrs: paasCtas.primary.attrs,
			},
			{
				text: paasCtas.secondary.text,
				icon: 'tabler:message-circle',
				href: paasCtas.secondary.href,
				variant: 'outline',
			},
		]}
		layout="split"
		panel={false}
		buttonsStackBelow={480}
		showArrow={false}
		anchorLink="#benefits"
	>
		{/* `kicker` is Hero's own slot, directly above the headline: the product's app logo, the
		    ThingsBoard mark knocked out of the page's accent, as the deployments band draws it. */}
		<Mark slot="kicker" size={{ base: 64, md: 88 }} logo="thingsboard" class="hero-mark" />
		<ul class="hero-caption" aria-label="Getting started with ThingsBoard Cloud">
			{paasHeroCaption.map((item) => (
				<li>
					<Icon name="tabler:check" aria-hidden="true" />
					{item}
				</li>
			))}
		</ul>
	</Hero>

	<section id="overflow">
		<Band id="benefits" ground="tint" groundColor={BOOKENDS.cloud.band} pad={{ top: 'md', bottom: 'lg' }}>
			<SectionHeader
				title="Why ThingsBoard Cloud"
				subtitle="For teams who want the platform running today, with the infrastructure handled."
				titleSize="title"
				subtitleMeasure="copy"
				spacing="md"
			/>
			<BenefitGrid items={paasBenefits} />
		</Band>

		<Band id="matrix" pad="lg">
			<SectionHeader
				title="ThingsBoard Cloud vs Private Cloud"
				subtitle="Where the two differ — infrastructure and scale, reliability and operations, compliance, and what each one costs."
				titleSize="title"
				subtitleMeasure="copy"
				spacing="md"
			/>
			{/* The column names and marks come from `paasChoice`, so the header pill and the cards below
			    cannot drift — they are labelling the same two things. */}
			<ProductMatrix
				caption="ThingsBoard Cloud vs ThingsBoard Private Cloud compared across infrastructure and scale, reliability and operations, compliance, and commercials"
				firstLabel="Feature"
				columns={[paasChoice.options[0], paasChoice.options[1]]}
				lead={paasCompareLead}
				groups={paasCompare}
			/>
		</Band>

		{/* The choice, directly under the table that informs it, its ground the full width as the
		    bookend's is. */}
		<ChoiceBand
			title={paasChoice.title}
			lead={paasChoice.lead}
			options={paasChoice.options}
			productName="ThingsBoard"
			note={{
				icon: paasOnPremises.icon,
				lead: paasOnPremises.lead,
				link: { text: paasOnPremises.text, href: paasOnPremises.href },
			}}
		/>

		<Band id="faq" pad="lg">
			<SectionHeader title="ThingsBoard Cloud FAQ" titleSize="title" spacing="md" />
			<ProductFaq categories={paasFaq} visibleCount={FAQ_VISIBLE} />
		</Band>
	</section>

	<Bookend id="cloud" ways="buttons" tone="light" links={false} cross={false} />
</BaseLayout>

<style is:global lang="scss">
	// Every rule this page used to declare inline now lives here, shared with the On-premises page.
	// See the file header for what a page still sets for itself.
	@use '../../../styles/product-page';
</style>
