---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { Products } from '@models/site.models';

import Hero from '@components/Landing/Hero.astro';
import EcosystemMark from '@components/Landing/EcosystemMark.astro';
import SectionHeader from '@components/Landing/SectionHeader.astro';
import PricingBackground from '@components/Pricing/PricingBackground.astro';
import { heroLcpPreload } from '@util/lcp-preload';

import {
	paasBenefits,
	paasChoice,
	paasCompare,
	paasCompareLead,
	paasCtas,
	paasFaq,
	paasShared,
} from '~/data/paasPage';

/**
 * ThingsBoard Cloud.
 *
 * The develop page's content in the homepage candidate's language. Nothing here is a new claim:
 * the copy, the prices and the link targets come from `develop.tbqa.cloud/products/paas/` and live
 * in `src/data/paasPage.ts` — see the note there for why they could not be taken from a branch.
 *
 * WHAT CHANGED, and it is only ever the frame:
 *
 *   - The hero is the homepage's split layout, with the brand primary and outline secondary in
 *     place of the full-bleed image and lone outline button, and the deployment's mark over the
 *     headline. It carries develop's long statement as its subtitle, so the page says what it is
 *     in the hero rather than in a band below it — which is why there is no `IntroSection` here.
 *   - The customer strip and the "Top supplier retail 2024" badge are both off.
 *   - The five icon cards become four squircle-marked cards. Develop's fifth, "Public vs Private
 *     cloud choice", was doing a different job from the other four — it picks between two products
 *     where they describe one — so it is the two-card chooser UNDER the comparison table, with the
 *     entry price and a call to action on each card. It briefly led the page instead, which put the
 *     same decision twice: once before the reader had seen anything to decide on, and again as the
 *     table's own CTA row.
 *   - "Platform features" LEADS the comparison rather than closing it: what you get on either
 *     deployment, then how the two differ. Develop has this the other way round, as the second half
 *     of one table. `White-labeling` did not come with it — it is the one row of that half whose
 *     columns differ, so it stays in the table.
 *   - The matrix is rebuilt rather than reused. `PaasComparisonMatrix` in this repo is the OLD
 *     Cloud-vs-PE table and answers a different question; develop's is Public vs Private.
 *   - The FAQ keeps develop's shape — a sidebar of topics, one panel, six answers behind "Load
 *     more" — with real tab semantics and keyboard support, and degrades to the first topic's
 *     answers as prose when the script does not run.
 *   - The closing band is the bookend — the same #121425 ground and wave field as `ClosingCta`,
 *     with this page's CTAs instead of the homepage's.
 *
 * The background blobs (`#background` and its seven divs) are gone with the rest of that layer.
 */

const HERO_BACKGROUND = '/hero/pe-cover.webp';

// The mark the candidate's deployments band gives ThingsBoard Cloud — `homeProducts` knocks this
// same asset out white on a squircle filled with the primary, so the product is marked the same way
// in both places.
const TB_MARK = '/src/assets/images/landings/thingsboard-mark.svg';

// `Hero` shows the "Top supplier retail 2024" badge for CE, PE and both PaaS products unless a page
// opts out, and `null` is that opt-out — an omitted prop takes the default instead.
const HERO_ACHIEVEMENT = null;

// Answers shown per topic before "Load more", as develop shows six. The count is per panel, so
// the four topics at or under it render no button at all.
const FAQ_VISIBLE = 6;
---

<BaseLayout
	headerVariant="transparent"
	forceLightTheme
	title="ThingsBoard Cloud"
	description="ThingsBoard Cloud — fully managed, scalable, fault-tolerant IoT platform with infrastructure managed by our team."
	preloadLcpImage={heroLcpPreload(HERO_BACKGROUND)}
>
	<Hero
		product={Products.PAAS}
		backgroundImage={HERO_BACKGROUND}
		title="ThingsBoard Cloud"
		subtitle="An IoT platform for device management, data processing and visualization — fully managed by our team, on shared public cloud or a dedicated private cluster."
		achievement={HERO_ACHIEVEMENT}
		buttons={[
			{
				text: paasCtas.primary.text,
				icon: 'tabler:cloud-filled',
				href: paasCtas.primary.href,
				variant: 'brand',
				ariaLabel: 'Try ThingsBoard Cloud for free',
			},
			{ text: paasCtas.secondary.text, icon: 'tabler:message-circle', href: paasCtas.secondary.href, variant: 'outline' },
		]}
		layout="split"
		showArrow={false}
		anchorLink="#benefits"
		videoBackground={{
			webm: 'https://video.thingsboard.io/pe-cover.webm',
			mp4: 'https://video.thingsboard.io/pe-cover.mp4',
		}}
	>
		{/* `kicker` is Hero's own slot, directly above the headline — the mark is an inlined SVG
		    rather than a Tabler name, so it cannot ride on a prop the way a glyph would. */}
		<span slot="kicker" class="hero-mark" aria-hidden="true">
			<EcosystemMark src={TB_MARK} class="hero-mark__glyph" filled />
		</span>
	</Hero>

	<section id="overflow">
		<section id="benefits">
			<div class="main-div">
				<SectionHeader
					title="Why ThingsBoard Cloud"
					subtitle="For everyone who would like to use ThingsBoard but doesn't want to host their own instance of the platform."
					titleSize="title"
					subtitleMeasure="copy"
				/>
				<div class="benefit-grid">
					{
						paasBenefits.map((benefit) => (
							<div class="benefit-card">
								<Icon name={benefit.icon} class="benefit-card__icon" aria-hidden="true" />
								<h3 class="benefit-card__title">{benefit.title}</h3>
								<p class="benefit-card__text">{benefit.description}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section id="shared">
			<div class="main-div">
				<SectionHeader
					title="Platform features"
					subtitle="Every capability below is included in ThingsBoard Public Cloud and ThingsBoard Private Cloud alike."
					titleSize="title"
					subtitleMeasure="copy"
				/>
				<div class="shared-groups">
					{
						paasShared.map((group) => (
							<div class="shared-group">
								<h3 class="shared-group__title">
									<span class="group-mark" style={`--group-mark-color: ${group.color}`} aria-hidden="true">
										<Icon name={group.icon} />
									</span>
									{group.title}
								</h3>
								<dl class="shared-group__list">
									{group.rows.map((row) => (
										<div class="shared-row">
											<dt>{row.label}</dt>
											<dd>{row.detail}</dd>
										</div>
									))}
								</dl>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section id="matrix">
			<div class="main-div">
				<SectionHeader
					title="Public Cloud vs Private Cloud"
					subtitle="Where the two differ — infrastructure and scale, reliability and operations, compliance, and what each one costs."
					titleSize="title"
					subtitleMeasure="copy"
				/>

				{/* `scope` on every header cell: the row labels are headers too, which is what lets a screen
				    reader announce "Uptime SLA, Private Cloud, 99.9% – 99.99%" instead of the value alone. */}
				<div class="matrix-scroll">
					<table class="matrix">
						<caption class="sr-only">
							ThingsBoard Public Cloud compared with ThingsBoard Private Cloud
						</caption>
						<thead>
							<tr>
								<th scope="col">Feature</th>
								<th scope="col">Public Cloud</th>
								<th scope="col">Private Cloud</th>
							</tr>
						</thead>
						<tbody>
							<tr>
								<th scope="row">{paasCompareLead.label}</th>
								{paasCompareLead.values.map((value) => <td>{value}</td>)}
							</tr>
							{
								paasCompare.map((group) => (
									<>
										<tr class="matrix__group">
											{/* A group heading spans the table, so it is a header for everything under it. */}
											<th scope="colgroup" colspan="3">
												<span>
													<span class="group-mark" style={`--group-mark-color: ${group.color}`} aria-hidden="true">
														<Icon name={group.icon} />
													</span>
													{group.title}
												</span>
											</th>
										</tr>
										{group.rows.map((row) => (
											<tr>
												<th scope="row">{row.label}</th>
												{row.values.map((value) => (
													<td class:list={[value === '—' && 'matrix__none']}>
														{value === '—' ? <span class="sr-only">Not included</span> : null}
														<span aria-hidden={value === '—' ? 'true' : undefined}>{value}</span>
													</td>
												))}
											</tr>
										))}
									</>
								))
							}
						</tbody>
					</table>
				</div>

			</div>
		</section>


		{/* The choice, directly under the table that informs it — and outside that section's measure,
		    so its ground runs the full width the way the bookend's does. */}
		<section id="choose">
			<PricingBackground contained />
			{/* The choice, directly under the table that informs it. Each card is a plain <div>, not
			    a link: it carries two actions, and an anchor cannot contain another one. */}
			<div class="choice__inner">
				<h3 class="choice__title">{paasChoice.title}</h3>
				<p class="choice__lead">{paasChoice.lead}</p>

				<div class="choice-grid">
					{
						paasChoice.options.map((option) => (
							<div class="choice-card">
								<h4 class="choice-card__name">{option.name}</h4>
								<p class="choice-card__price">
									{option.price}
									<span class="choice-card__price-note">{option.priceNote}</span>
								</p>
								<p class="choice-card__summary">{option.summary}</p>
								<ul class="choice-card__points">
									{option.points.map((point) => (
										<li>
											<Icon name="tabler:check" aria-hidden="true" />
											{point}
										</li>
									))}
								</ul>
								<div class="choice-card__actions">
									<a class="choice-card__cta" href={option.cta.href}>
										{option.cta.text}
										{/* Each card's actions read "Try Cloud for free" and "See plans" — fine beside
										    their own heading, ambiguous in a list of every link on the page. */}
										<span class="sr-only">— ThingsBoard {option.name}</span>
									</a>
									<a class="choice-card__plans" href={option.plansHref}>
										See plans
										<span class="sr-only">for ThingsBoard {option.name}</span>
										<Icon name="tabler:chevron-right" aria-hidden="true" />
									</a>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section id="faq">
			<div class="main-div">
				<SectionHeader
					title="ThingsBoard Cloud FAQ"
					titleSize="title"
				/>
				{/* Develop's arrangement: a sidebar of topics beside one panel, and each panel showing its
				    first `FAQ_VISIBLE` answers behind a "Load more". The tabs are real `role="tab"`
				    buttons with roving tabindex, so the set is operable from the keyboard — arrows to
				    move, Home/End to the ends — which develop's own sidebar is not. */}
				<div class="faq-layout">
					<div class="faq-tabs" role="tablist" aria-orientation="vertical" aria-label="FAQ topics">
						{
							paasFaq.map((category, i) => (
								<button
									type="button"
									role="tab"
									id={`faq-tab-${i}`}
									class:list={['faq-tab', i === 0 && 'is-active']}
									aria-controls={`faq-panel-${i}`}
									aria-selected={i === 0 ? 'true' : 'false'}
									tabindex={i === 0 ? 0 : -1}
								>
									{category.title}
								</button>
							))
						}
					</div>

					<div class="faq-panels">
						{
							paasFaq.map((category, i) => (
								<div
									role="tabpanel"
									id={`faq-panel-${i}`}
									class="faq-panel"
									aria-labelledby={`faq-tab-${i}`}
									hidden={i !== 0}
								>
									{category.items.map((item, j) => (
										<details class:list={['faq-item', j >= FAQ_VISIBLE && 'faq-item--extra']}>
											<summary>
												<span>{item.q}</span>
												<Icon name="tabler:chevron-down" class="faq-item__chevron" aria-hidden="true" />
											</summary>
											<div class="faq-item__answer" set:html={item.a} />
										</details>
									))}
									{category.items.length > FAQ_VISIBLE && (
										<button type="button" class="faq-more" aria-expanded="false">
											<span class="faq-more__label">More questions</span>
											<Icon name="tabler:chevron-down" class="faq-more__chevron" aria-hidden="true" />
										</button>
									)}
								</div>
							))
						}
					</div>
				</div>
			</div>
		</section>
	</section>

	{/* The far half of the bookend: ClosingCta's ground and field, this page's calls to action. */}
	<section class="paas-closing">
		<PricingBackground contained />
		<div class="paas-closing__inner">
			<h2 class="paas-closing__title">Ready to build on ThingsBoard Cloud?</h2>
			<p class="paas-closing__lead">
				Start free on Public Cloud in under five minutes, or talk to our team about a dedicated Private Cloud cluster.
			</p>
			<div class="paas-closing__actions">
				<a class="paas-closing__primary" href={paasCtas.primary.href}>
					<Icon name="tabler:cloud-filled" aria-hidden="true" />
					{paasCtas.primary.text}
				</a>
				<a class="paas-closing__secondary" href={paasCtas.secondary.href}>
					<Icon name="tabler:message-circle" aria-hidden="true" />
					{paasCtas.secondary.text}
				</a>
			</div>
			<p class="paas-closing__note">
				<a href={paasCtas.privacy.href}>{paasCtas.privacy.text}</a>
			</p>
		</div>
	</section>
</BaseLayout>


<script>
	// The FAQ tab set and its per-panel "Load more".
	//
	// Progressive enhancement is deliberate: the markup ships with panel 0 visible and the other six
	// `hidden`, so with no JavaScript a reader still gets the General answers rather than a bare list
	// of seven dead buttons. That is also why the script sets no ARIA that the markup has not already
	// declared — it only keeps those attributes true as the state changes.
	function initPaasFaq() {
		const layout = document.querySelector<HTMLElement>('.faq-layout');
		if (!layout) return;

		const tabs = Array.from(layout.querySelectorAll<HTMLButtonElement>('.faq-tab'));
		const panels = Array.from(layout.querySelectorAll<HTMLElement>('.faq-panel'));
		if (tabs.length === 0 || tabs.length !== panels.length) return;

		function select(index: number, { focus = false } = {}) {
			tabs.forEach((tab, i) => {
				const active = i === index;
				tab.classList.toggle('is-active', active);
				tab.setAttribute('aria-selected', String(active));
				// Roving tabindex: one stop for the whole set, so Tab leaves the tablist rather than
				// walking all seven topics before reaching the answers.
				tab.tabIndex = active ? 0 : -1;
				panels[i].hidden = !active;
			});
			if (focus) tabs[index].focus();
		}

		tabs.forEach((tab, i) => {
			tab.addEventListener('click', () => select(i));

			tab.addEventListener('keydown', (event) => {
				// Both orientations: the sidebar is a column on desktop and a row on phones, and the
				// arrows a reader reaches for follow what they see.
				const moves: Record<string, number> = {
					ArrowDown: 1,
					ArrowRight: 1,
					ArrowUp: -1,
					ArrowLeft: -1,
				};

				if (event.key === 'Home') {
					event.preventDefault();
					select(0, { focus: true });
					return;
				}

				if (event.key === 'End') {
					event.preventDefault();
					select(tabs.length - 1, { focus: true });
					return;
				}

				const step = moves[event.key];
				if (!step) return;
				event.preventDefault();
				select((i + step + tabs.length) % tabs.length, { focus: true });
			});
		});

		panels.forEach((panel) => {
			const more = panel.querySelector<HTMLButtonElement>('.faq-more');
			if (!more) return;
			const label = more.querySelector<HTMLElement>('.faq-more__label');

			more.addEventListener('click', () => {
				const expanded = panel.classList.toggle('is-expanded');
				more.setAttribute('aria-expanded', String(expanded));
				if (label) label.textContent = expanded ? 'Fewer questions' : 'More questions';
			});
		});
	}

	initPaasFaq();
	// The site runs client-side navigation, which swaps the body without reloading. Without this the
	// tabs are inert on every page reached by a link rather than by a fresh load.
	document.addEventListener('astro:page-load', initPaasFaq);
</script>

<style is:global lang="scss">
	@use '../../../styles/landing';
	@use '../../../styles/variables' as *;
	// The homepage's measure and row rhythm. This page has no alternating rows, so only the first
	// half of the file applies — `.main-div` at 1000, giving the 960 column the grids below assume.
	@use '../../../styles/sections-flat';

	// ---------------------------------------------------------------------------------------------
	// Page tokens. Restated from the homepage rather than shared: the two pages are the only things
	// on the site using them, and lifting them into `_variables.scss` would make them theme colours,
	// which they are not — see the same note on `ClosingCta`.
	// ---------------------------------------------------------------------------------------------
	// Visually hidden, still announced. The site has no global utility for this — the one `.sr-only`
	// in the repo is scoped inside `FeedbackPrompt` — so the table's caption and the CTAs' product
	// suffixes need it declared here or they would render as visible stray text.
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}

	html:root {
		--home-header-h: 64px;
		--sl-color-text-accent: #{$color-brand};
		--color-primary: #{$color-brand};
		--tb-main-color: #{$color-brand};
		--hero-muted: rgba(150, 164, 255, 0.72);
	}

	header.header {
		height: var(--home-header-h);
		transition-duration: 0.1s;
	}

	// The scrim under the transparent bar, as the homepage sets it: this hero is a split panel too,
	// so the nav crosses both the black column and the footage and needs one continuous ground.
	header.header:not(.opened-burger):not([data-header-scrolled]):has([data-header-variant='transparent']) {
		background-color: rgba(0, 0, 0, 0.8);
	}

	// ---------------------------------------------------------------------------------------------
	// THE MARKETING BAR, ALIGNED WITH THE HOMEPAGE.
	//
	// This page is on the home nav — see `HOME_NAV_ROUTES` in `components/starlight/Header.astro`,
	// which is what gives it the larger logo, the GitHub button, the Sign in region and "Try for
	// free" in place of "Try it now", and drops the promo banner.
	//
	// The rules below are COPIED VERBATIM from `pages/index.astro`, which is still their source of
	// truth. Two pages now carry the same block, so they can drift: the moment a third joins, this
	// belongs in a partial both `@use`. It was not extracted now because the homepage's copy is
	// interleaved with its hero and bookend rules — `.n-button--filled` is declared in the same
	// rule as `#hero .button.brand` — and splitting that up reorders a signed-off page's cascade
	// for no gain on this branch.
	// ---------------------------------------------------------------------------------------------

	// `.logo--lg` in the header component resolves to `header .logo.logo--lg`,
	// which ties with a plain `header.header .logo` — so match its class count
	// and win on order rather than relying on it.
	header.header .logo.logo--lg {
		height: 50px;
		width: 175px;

		@media screen and (min-width: 1025px) {
			width: 215px;
		}

		@media screen and (min-width: 1281px) and (max-width: 1599px) {
			width: 160px;
		}

		// Phones: 175px put the wordmark shoulder to shoulder with the Menu
		// button on a 375px screen. Height follows so the mark keeps its ratio
		// inside the box — width drives `contain` at every one of these sizes.
		@media screen and (max-width: 767px) {
			width: 168px;
			height: 48px;
		}

		@media screen and (max-width: 480px) {
			width: 152px;
			height: 44px;
		}
	}

	// Primary: one purple across the page — the header CTA, the hero, and the
	// n-button primaries in the sections below. White on #3d50f5 is 5.73:1, which
	// clears AA for body-sized text.
	.n-button--filled,
	#hero .button.brand,
	.paas-closing__primary {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		font-weight: $font-weight-bold;
		background-color: $color-brand;
		color: #fff;
	}

	// The bookend's secondary is NOT in the rule above: two filled purples would close the page on
	// one choice made twice. It carries the hero's outline instead (declared with the rest of
	// `.paas-closing` below), so here it needs only the shimmer's scaffolding and not the fill.
	.paas-closing__secondary {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		font-weight: $font-weight-bold;
	}

	// Shimmer: a single skewed highlight crossing on hover. Transform-only, so it
	// composites rather than repainting, and it runs once per hover instead of
	// looping.
	.n-button--filled::after,
	#hero .button.brand::after,
	#hero .learn-tb::after,
	.paas-closing__primary::after,
	.paas-closing__secondary::after {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 45%;
		z-index: -1;
		pointer-events: none;
		background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.38), transparent);
		transform: translateX(-160%) skewX(-18deg);
	}

	.n-button--filled:hover::after,
	.n-button--filled:focus-visible::after,
	#hero .button.brand:hover::after,
	#hero .button.brand:focus-visible::after,
	#hero .learn-tb:hover::after,
	#hero .learn-tb:focus-visible::after,
	.paas-closing__primary:hover::after,
	.paas-closing__primary:focus-visible::after,
	.paas-closing__secondary:hover::after,
	.paas-closing__secondary:focus-visible::after {
		animation: btn-shimmer 0.75s cubic-bezier(0.4, 0, 0.2, 1);
	}

	// The bookend gets the hero's focus ring too. It had none — only a colour
	// change on :focus-visible, which is not a focus indicator on a dark ground.
	.paas-closing__primary:focus-visible,
	.paas-closing__secondary:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 3px;
	}

	@keyframes btn-shimmer {
		from {
			transform: translateX(-160%) skewX(-18deg);
		}
		to {
			transform: translateX(320%) skewX(-18deg);
		}
	}

	// Secondary, dark-on-light: a tint on hover rather than a fill, so it never
	// reads as a primary mid-interaction.
	.n-button--filled:hover,
	#hero .button.brand:hover {
		background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2));
	}

	.n-button--filled:active,
	#hero .button.brand:active {
		background-image: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3));
	}

	// Primary trimmed to balance the shorter menu, floored at 40px so it stays a
	// comfortable target alongside the Sign in secondary.
	header.header .head-buttons .n-button.try {
		width: auto;
		height: 40px;
		min-height: 40px;
		padding: 0 18px;
		font-size: 14px;
	}

	// Tighter than the 0.875rem default — four controls sit in this cluster. Set
	// as the token so the bar and the open drawer cannot drift apart: the shared
	// drawer rule used to restate the default, which widened every gap by 6px and
	// made the cluster spread as it opened.
	header.header .head-buttons {
		--tb-cluster-gap: 8px;
	}

	// The widget was floating off the pair. Two things were doing it, and the
	// larger one was not the margin.
	//
	// GitHubButton reserves a fixed 100px wrap (132 above 1600, where the "Star"
	// label shows) so the star count arriving later cannot shift the nav. But the
	// button itself is only 36px until that count loads — the count cell is
	// `width: 0` and expands to 61px on `.is-loaded` — so the reservation renders
	// as up to 64px of empty space, and it all sits on the RIGHT, between the star
	// and Sign in. Measured 82px from the button's edge to Sign in against the 8px
	// that separates Sign in from Try for free.
	//
	// Right-aligning the button inside its own wrap keeps the reservation exactly
	// as it was — nothing shifts when the count lands, it just grows leftward into
	// space that was already empty — and puts the star on the cluster's 8px gap in
	// both states. The 10px margin on top of that gap goes with it.
	// `text-align` rather than a flex context, because `display` on this wrap is
	// the component's visibility switch — `none` by default, `block` at its own
	// breakpoints and at the tablet one below. Setting it here would show the
	// widget at every width.
	header.header .head-buttons .gh-wrap {
		text-align: right;
		margin-right: 0;
	}

	// GitHubButton hides itself below 1120px, which suited a bar that dropped
	// every control into the drawer at 1280. Now that the tablet bar keeps the
	// account controls, the stars fit alongside them with room to spare, and on
	// this page the count is part of the pitch. Scoped here rather than lowering
	// the component's own breakpoint, which every other page shares.
	@media screen and (min-width: 768px) and (max-width: 1119px) {
		header.header .head-buttons .gh-wrap {
			display: block;
		}
	}

	// Only `.n-button.price` gets an explicit white on the transparent header, so
	// the Sign in secondary inherited dark text and vanished over the hero.
	header.header .region-signin summary {
		font-size: 15px;
	}

	// White only while the bar is actually transparent over the hero. Both guards
	// are load-bearing, and each one covers a surface this white would otherwise
	// be invisible against:
	//   :not(.opened-burger)        — the drawer is a light surface
	//   :not([data-header-scrolled]) — the scrolled bar flips to solid white
	//
	// The three states are now mutually exclusive by condition rather than by
	// source order, which is what went wrong before: the two guards each add
	// specificity, and with only the first of them this selector outweighed the
	// [data-header-scrolled] rule below that had been winning on order alone.
	// Ordering is no longer what keeps them apart, so adding a fourth state
	// can't silently break the other three.
	header.header:not(.opened-burger):not([data-header-scrolled]):has([data-header-variant='transparent'])
		.region-signin
		summary {
		color: #fff;
	}

	header.header[data-header-scrolled] .region-signin summary {
		color: var(--color-text);
	}

	// Region marks: set in type, sized alike, so they read as a pair.
	//
	// The one place below the 14px floor that stays there on purpose. "US" and "EU" in a 24px square
	// are a mark rather than a line of text — there is no reading to do, and at 14 the two letters
	// stop fitting the square. `line-height` is stated rather than inherited: the badge appears in
	// two places with different surrounding leadings, and without this it took 15 in the header and
	// 20 inside a card, which is the same mark set two ways.
	.region-badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 24px;
		height: 24px;
		margin-right: 8px;
		border-radius: 4px;
		font-size: 10px;
		font-weight: 700;
		line-height: 1;
		letter-spacing: 0.02em;
		color: #fff;
		flex: 0 0 auto;
	}

	.region-badge--us {
		background-color: $color-brand;
	}

	.region-badge--eu {
		background-color: #0f161d;
	}

	.region-signin__menu a {
		display: flex;
		align-items: center;
	}

	.n-button--outlined:hover {
		background-color: rgba(61, 80, 245, 0.08);
	}

	.n-button--outlined:active {
		background-color: rgba(61, 80, 245, 0.14);
	}

	// GitHub button in its dark dress, to sit on the hero's black header. Same
	// palette the component already ships behind [data-theme='dark'] — the
	// homepage forces the light theme, so it never reaches it.
	//
	// Gated on the same two states as the Sign in white above, so the widget
	// flips with the bar instead of staying dark on it: the scrolled header and
	// the open drawer are both light surfaces, and a near-black pill with a
	// black count sat on them as a hole. Nothing needs restating for the light
	// case — dropping out of these selectors hands the widget back to the
	// component's own default dress, which is the light one.
	header.header:not([data-header-scrolled]):not(.opened-burger) .gh-button {
		background: #21262d;
		border-color: #30363d;
		color: #e6edf3;
		box-shadow: 0 1px 0 rgba(0, 0, 0, 0.2);
	}

	header.header:not([data-header-scrolled]):not(.opened-burger) .gh-button:hover {
		border-color: #58a6ff;
		color: #e6edf3;
	}

	header.header:not([data-header-scrolled]):not(.opened-burger) .gh-sep {
		background-color: #30363d;
	}

	header.header:not([data-header-scrolled]):not(.opened-burger) .gh-count {
		background-color: #161b22;
		color: #e6edf3;
	}

	// ---------------------------------------------------------------------------------------------
	// THE HERO
	//
	// `body` on each selector: Astro scopes the component's own rules with `:where()`, which carries
	// no specificity, but `#hero.split` there and `#hero.split` here would still tie and fall to
	// whichever sheet the bundler emits last. The element selector breaks it outright.
	// ---------------------------------------------------------------------------------------------

	// The section's height is the video panel's — 16:9 of two thirds of the measure — and on a tall
	// window that left the hero about two fifths of the screen with the text column half empty under
	// it. A floor, not a fixed height, so the panel still grows with the viewport up to its own
	// 720px cap. Only from `lg`, where the two are side by side; below that they stack and the
	// height is the sum of the two, which needs no floor.
	@include media-up(lg) {
		body #hero.split {
			min-height: min(88vh, 680px);
		}
	}

	// The ground the bookend uses — near-black tinted with the primary — so the page opens and
	// closes on the same colour instead of opening on flat black.
	body #hero.split,
	body #hero.split #hero-content {
		background-color: #121425;
	}

	// The hue itself: one soft wash from the top-left corner, behind the type. Kept wide and low in
	// alpha so it reads as a tint on the ground rather than as a shape.
	body #hero.split #hero-content {
		background-image: radial-gradient(115% 85% at 0% 0%, rgba(61, 80, 245, 0.32), transparent 62%);
	}

	// The product's mark, as the deployments band draws it: the TB glyph knocked out white on a
	// squircle filled with the primary. 72px and 32% radius are that badge's own numbers.
	.hero-mark {
		display: grid;
		place-items: center;
		width: 72px;
		height: 72px;
		margin-bottom: $spacing-5;
		border-radius: 32%;
		background-color: $color-brand;

		// Slotted content never receives Hero's scope hash, so the reveal its siblings get from
		// `.header-animation` does not reach here — restated, one step ahead of the headline.
		opacity: 0;
		transform: translate3d(0, 45px, 0);
		animation: slideup-in 600ms cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;

		@media (prefers-reduced-motion: reduce) {
			animation: none;
			opacity: 1;
			transform: none;
		}

		// `EcosystemCard`'s own rule for this mark, to the number: 82% of the squircle, height from
		// the artwork. A flat 40px on a 72px tile is 56%, which is what left the glyph adrift in the
		// middle of it — the card has always filled the badge far harder than that.
		&__glyph {
			width: 82%;
			height: auto;
		}
	}

	// NO `overflow: hidden` HERE, and that is load-bearing.
	//
	// It was carried over from the old page, where it clipped the seven absolutely-positioned
	// background blobs. Those went with the rest of that layer. What it still did was make this
	// element a scroll container — `hidden` is programmatically scrollable, so it counts — and
	// `position: sticky` resolves against the nearest scrollport. Every sticky thing inside it,
	// including the comparison table's header row, was pinning to a wrapper that never scrolls.
	//
	// If something inside ever does overflow sideways, clip it on that thing, not here.
	#overflow {
		position: relative;
	}

	// THE GROUP MARK, on the subheadings inside the feature list and the comparison table — the level
	// the reader is actually navigating by. It was on the four section titles first, which put a
	// squircle over headings that already had a whole band to themselves.
	//
	// 26px, not the 40 `SectionHeader` gives its own badge: this sits on a 16px line of text, and at
	// 40 the mark rather than the words would be the heading.
	//
	// The hue is the SECTION's, set once on each of the two below rather than per group. Nine marks
	// in nine colours would code something the page never decodes; one colour per section says which
	// half of the comparison you are reading, which is the only distinction here that means anything.
	.group-mark {
		// `inline-flex` with BOTH axes stated, not `inline-grid` + `place-items`. The table's own
		// heading rule is `.matrix__group span`, which also matches this span — it is a span inside
		// that cell — and at (0,1,1) it beat `.group-mark` and forced `display: inline-flex` here.
		// The glyph then sat at flex-start with no `justify-content` to hold it, jammed against the
		// left edge of its own squircle. Stating both axes makes the rule survive being re-displayed.
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: none;
		width: 36px;
		height: 36px;
		border-radius: 32%;
		background-color: var(--group-mark-color, #{$color-brand});
		color: #fff;

		// No `:global()`: this block is already global, and the wrapper made the selector a no-op —
		// which is why the glyph was rendering at its 1em default rather than at the size set here.
		svg {
			width: 20px;
			height: 20px;
		}
	}

	// ---------------------------------------------------------------------------------------------
	// Benefits
	// ---------------------------------------------------------------------------------------------
	#benefits {
		padding-top: $spacing-16;
		padding-bottom: $spacing-20;

		@include media-down(md) {
			padding-top: $spacing-10;
			padding-bottom: $spacing-12;
		}

		.section-header {
			margin-bottom: $spacing-10;
		}
	}

	.benefit-grid {
		display: grid;
		// Three across, two down. Four in a row left the set with no shape — six in a 3x2 reads as a
		// block of claims rather than a strip of them, and 304 a column at the 960 measure gives the
		// longer titles two lines instead of three.
		grid-template-columns: repeat(3, 1fr);
		gap: $spacing-8 $spacing-6;
		max-width: 960px;
		margin-inline: auto;

		@include media-down(lg) {
			grid-template-columns: repeat(2, 1fr);
		}

		@include media-down(md) {
			grid-template-columns: 1fr;
		}
	}

	// No card, and no squircle. `FeatureTile` on the homepage is the same kind of item — one glyph,
	// one line of title, one line of copy — and it draws the glyph black and solid at 28px with no
	// fill behind it. Four of these in a row is exactly the case that treatment was written for: a
	// filled mark per tile would be an accent system with nothing to decode.
	.benefit-card {
		display: flex;
		flex-direction: column;
		gap: $spacing-2;
		// The separation, as a rule over each tile rather than a box around it. Six unboxed tiles on
		// white had nothing marking where one ended and the next began; a line above each one gives
		// the grid its columns back without putting the cards back.
		padding-top: $spacing-5;
		border-top: 1px solid rgba(15, 23, 42, 0.12);

		&__icon {
			width: 28px;
			height: 28px;
			color: var(--color-text);
		}

		&__title {
			@include type-tile;
			margin: $spacing-1 0 0;
			color: var(--color-text);
		}

		&__text {
			@include type-small;
			margin: 0;
			color: var(--color-text-secondary);
			text-wrap: pretty;
		}
	}

	// ---------------------------------------------------------------------------------------------
	// The matrix
	// ---------------------------------------------------------------------------------------------
	#matrix {
		// White. The hue sits on Platform features above, and two tinted bands in a row would read as
		// one long section rather than two.
		//
		// Still declared as a custom property, because the table's PINNED CELLS have to repaint this
		// exact colour to hide the values scrolling under them — a literal here and another one there
		// is the pair that silently breaks the moment either is retuned.
		--matrix-band: #fff;
		padding-top: $spacing-20;
		padding-bottom: $spacing-20;
		background-color: var(--matrix-band);

		@include media-down(md) {
			padding-top: $spacing-12;
			padding-bottom: $spacing-12;
		}

		.section-header {
			margin-bottom: $spacing-10;
		}
	}

	// The table keeps its own width below the measure and scrolls rather than wrapping prices onto
	// four lines. `tabindex` is not set on it: `overflow` alone makes it keyboard-scrollable in every
	// engine that ships this table, and a focusable div with no label is worse than neither.
	.matrix-scroll {
		max-width: 960px;
		margin-inline: auto;
		overflow-x: auto;

		// AND THIS IS WHAT LETS THE HEADER PIN TO THE PAGE.
		//
		// `position: sticky` resolves against the nearest scrollport, and a horizontal scroll
		// container is a scrollport on BOTH axes — CSS forces `overflow-y: visible` to compute to
		// `auto` once the other axis is not `visible`. Inside this box, `top:` therefore pins to a
		// box that never scrolls vertically, which is no pinning at all.
		//
		// But the box only has to scroll while it is narrower than the table. `.main-div` is capped
		// at 1000 with 20px of padding, so the column is `min(viewport - 40, 960)`, and it drops
		// under the table's 820 at a 860px viewport. Above that the table fits, the box has nothing
		// to scroll, and dropping `overflow` hands the header back to the page's own scrollport.
		// 880 rather than 860, so the switch happens with room to spare rather than exactly as the
		// last pixel fits.
		//
		// Below 880 the header does not pin — the pinned first COLUMN is what carries a reader
		// there, and that is the axis that actually moves on a phone.
		@media (min-width: 880px) {
			overflow: visible;
		}
	}

	.matrix {
		width: 100%;
		// Sized for the copy: at the base step the longest cells — the starting prices and the support
		// tiers — wrap a line further at 720 than they do here, and the table is already horizontally
		// scrollable, so the width costs nothing a narrow screen was not already paying.
		min-width: 820px;
		// `separate`, not `collapse`. A collapsed table's borders belong to the table rather than to
		// the cells, so a cell lifted out by `position: sticky` leaves its borders behind and the
		// pinned column loses its rules in Chrome and Safari. The borders sit on the cells instead,
		// and `border-spacing: 0` keeps the grid as tight as `collapse` drew it.
		border-collapse: separate;
		border-spacing: 0;
		text-align: left;

		caption {
			text-align: left;
		}

		thead th {
			@include type-body;
			font-weight: $font-weight-medium;
			padding: $spacing-3 $spacing-4;
			color: var(--color-text);

			&:not(:first-child) {
				color: $color-brand;
			}
		}

		tbody th[scope='row'] {
			@include type-body;
			font-weight: $font-weight-medium;
			width: 30%;
			padding: $spacing-3 $spacing-4;
			color: var(--color-text);
			vertical-align: top;
		}

		// On a phone the label column is 30% OF THE TABLE, not of the screen — 246px of the 335 a
		// 375px viewport gives it, leaving 89px of the value the reader scrolled across to read. A
		// fixed 150 leaves 185, which fits "Dedicated, isolated Kubernetes cluster" in three lines
		// instead of six. The longest labels wrap to three lines at this width, which is the cheaper
		// of the two costs: a label the reader already has beside them, against a value they cannot
		// see at all.
		@include media-down(md) {
			thead th:first-child,
			tbody th[scope='row'] {
				width: 150px;
			}
		}

		// THE PINNED COLUMN. The row label is what a value is meaningless without, so it is the one
		// that stays: scrolled across to Private Cloud, "From $1,499 / month" still has "Starting
		// price" beside it. Each pinned cell needs its own opaque ground — this section is white — or
		// the values scrolling underneath read straight through it.
		thead th:first-child,
		tbody th[scope='row'] {
			position: sticky;
			left: 0;
			z-index: 1;
			background-color: var(--matrix-band, #fff);
			// The edge that says the column is pinned rather than merely first. A shadow, not a
			// border, so it sits outside the cell box and cannot shift the column's width.
			box-shadow: 1px 0 0 rgba(15, 23, 42, 0.08);
		}

		// ------------------------------------------------------------------------------------------
		// THE HEADER PILL, pinned under the fixed bar.
		//
		// A row of three cells drawn as one rounded bar: the outer two take the round ends, the
		// middle inherits the fill, and `border-spacing: 0` leaves no seam between them. It needs a
		// ground of its own — the section is white and the rows pass underneath it.
		//
		// Restated here rather than up in `thead th` because the pinned-column rule above selects
		// `thead th:first-child` at (0,0,3) and would otherwise repaint the corner with the body's
		// ground. Same specificity, later in the sheet.
		// ------------------------------------------------------------------------------------------
		thead th,
		thead th:first-child {
			position: sticky;
			top: calc(var(--home-header-h, 64px) + #{$spacing-2});
			// Over the body's pinned column (1) and over the group headings, both of which scroll
			// under this row.
			z-index: 3;
			background-color: #eef0ff;
			box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
		}

		thead th:first-child {
			// The corner is in the pinned column as well as the pinned row, so it outranks the rest
			// of its own row — without this the first body label paints over it while scrolling
			// sideways.
			z-index: 4;
			border-top-left-radius: $radius-full;
			border-bottom-left-radius: $radius-full;
		}

		thead th:last-child {
			border-top-right-radius: $radius-full;
			border-bottom-right-radius: $radius-full;
		}

		td {
			@include type-body;
			padding: $spacing-3 $spacing-4;
			color: var(--color-text-secondary);
			vertical-align: top;
		}

		// On the cells rather than the row — see `border-collapse` above.
		tbody tr:not(.matrix__group) > * {
			border-bottom: 1px solid rgba(15, 23, 42, 0.08);
		}

		// A heading for the rows under it, not a kicker over the table. It was `type-eyebrow` —
		// uppercase and tracked — which reads as a label for the whole section each time it appears,
		// and appears six times. Sentence case at the body-strong step says "these rows go together"
		// without competing with the section's own H2.
		// A level above the rows, and it has to be said in the type: at the rows' own 16px medium
		// nothing but the colour marked it as a heading.
		&__group th {
			font-size: $font-size-xl;
			font-weight: $font-weight-bold;
			line-height: 1.3;
			// The one place that keeps real air: this is the seam between two groups of rows, and it
			// is the only thing separating them now that the rows themselves are tight.
			padding: $spacing-8 $spacing-4 $spacing-3;
			color: var(--color-text);
		}

		// The group heading spans all three columns, so pinning the CELL would pin the full table
		// width and move nothing. Its text is pinned instead and stays in view above the label column
		// while the values scroll past. `left` matches the cells' own padding, so the heading keeps
		// its left edge aligned with them.
		// `inline-flex`, NOT `flex`: a block-level box here would fill the cell, which spans all three
		// columns, and an element as wide as its container cannot move — the pinning would do
		// nothing. Shrink-to-fit is what lets it hold the left edge while the values scroll past.
		// `th > span`, NOT `span`: the descendant form also matched `.group-mark` nested inside this
		// one and re-displayed it — see the note on that class.
		&__group th > span {
			position: sticky;
			left: $spacing-4;
			display: inline-flex;
			align-items: center;
			gap: $spacing-3;
		}

		// An em dash is a value here, not an absence of one — the cell says "not included", which the
		// sr-only span states in words for anyone who cannot see that it is a dash.
		&__none {
			color: rgba(15, 23, 42, 0.4);
		}
	}

	// ---------------------------------------------------------------------------------------------
	// THE CHOICE, under the table that informs it.
	//
	// This was two buttons in a `.matrix-cta` row, with the same decision also put as a full section
	// at the top of the page. One decision, asked twice, and the first time before the reader had
	// seen anything to decide on. The cards are the top section's, moved down and given the entry
	// price and their own call to action.
	// ---------------------------------------------------------------------------------------------
	// The decision band. `ClosingCta`'s ground and its wave field, so the two places the page asks
	// for something look like each other — and `isolation` for the same reason that component needs
	// it: it makes a stacking context, so the field's `z-index: -1` lands above this background
	// instead of dropping behind it.
	#choose {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		background-color: #121425;
		color: #fff;
		padding: $spacing-20 0;

		@include media-down(md) {
			padding: $spacing-12 0;
		}
	}

	.choice {
		&__inner {
			@include container;
			position: relative;
			max-width: 1000px;
		}

		&__title {
			@include type-section;
			margin: 0 0 $spacing-3;
			text-align: center;
			color: #fff;
		}

		&__lead {
			@include type-body;
			max-width: 65ch;
			margin: 0 auto $spacing-10;
			text-align: center;
			text-wrap: pretty;
			color: rgba(255, 255, 255, 0.72);
		}
	}

	.choice-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: $spacing-6;
		max-width: 960px;
		margin-inline: auto;

		@include media-down(md) {
			grid-template-columns: 1fr;
		}
	}

	.choice-card {
		display: flex;
		flex-direction: column;
		gap: $spacing-3;
		padding: $spacing-8;
		// A panel ON the ground rather than a card cut out of it: a white card here would hide the
		// wave field it is sitting on, which is the reason the band has one.
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 16px;
		background-color: rgba(255, 255, 255, 0.06);

		&__name {
			@include subsection-title;
			margin: 0;
			color: #fff;
		}

		// The entry number and nothing else. The ladder is `/pricing/`'s, which "See plans" opens on
		// the right product.
		&__price {
			// One step under the name: the name identifies the option and the price qualifies it, so
			// the eye should land on "Public Cloud" and then on "From $0", not the other way round.
			// The name is `subsection-title`, which steps 32 -> 24 below `md`, so this steps with it
			// — left at a flat 24 the two would tie on a phone and the order would stop reading.
			@include type-card;

			@include media-down(md) {
				font-size: $font-size-xl;
			}
			display: flex;
			flex-direction: column;
			gap: 2px;
			margin: 0;
			// The repo's own dark-mode brand. #3d50f5 on this ground is 2.1:1 and unreadable.
			color: $color-brand-dark;
		}

		&__price-note {
			@include type-body;
			color: rgba(255, 255, 255, 0.6);
		}

		&__summary {
			@include type-body;
			margin: 0;
			color: rgba(255, 255, 255, 0.72);
		}

		&__points {
			@include type-body;
			display: flex;
