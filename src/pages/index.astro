---
import BaseLayout from '@layouts/BaseLayout.astro';
// TEMP-INTERNAL-NAV
import InternalNav from './internal/_InternalNav.astro';
import { Icon } from 'astro-icon/components';
import CustomersLogo from '@components/Landing/CustomersLogo.astro';
import Hero from '@components/Landing/Hero.astro';
import DashboardShowcase from '@components/Landing/DashboardShowcase.astro';
import { Products } from '@models/site.models';
import IntroSection from '@components/Landing/IntroSection.astro';
import PlatformClear from '@components/Landing/PlatformClear.astro';
import { PLATFORM_SECTION_COPY } from '@data/platform-visual';
import FeatureBlockSection from '@components/Landing/FeatureBlockSection.astro';

import ConnectHub from '@components/Landing/ConnectHub.astro';
import SolutionFlow from '@components/Landing/SolutionFlow.astro';
import TwinCorridor from '@components/Landing/TwinCorridor.astro';
import NormalizeSeries from '@components/Landing/NormalizeSeries.astro';
import ScaleDuo from '@components/Landing/ScaleDuo.astro';

import { CONNECT_COPY } from '@data/connect-visual';
import { DIGITAL_TWIN_COPY } from '@data/digital-twin-visual';
import { NORMALIZE_COPY } from '@data/normalize-visual';
import { SCALE_COPY } from '@data/scale-visual';
import { SOLUTION_COPY } from '@data/solution-flow';
import AiSection from '@components/Landing/AiSection.astro';
import FeatureTile from '@components/Landing/FeatureTile.astro';
import ClosingCta from '@components/Landing/ClosingCta.astro';
import EcosystemCard from '@components/Landing/EcosystemCard.astro';
import SectionHeader from '@components/Landing/SectionHeader.astro';
import { homeFeatures } from '~/data/homeFeatures';
import { homeEcosystem } from '~/data/homeEcosystem';

// Trial: the filled badge treatment, now carried by the mobile card alone — the
// other six were tried filled and reverted. A card opts in with its own `filled`
// key in `homeEcosystem`; this flips the whole trial off.
const ECOSYSTEM_FILLED = true;
import { homeProducts } from '~/data/homeProducts';
import PricingBackground from '@components/Pricing/PricingBackground.astro';
import { homeCarouselItems } from '~/data/homeCarousel';
import { heroLcpPreload } from '@util/lcp-preload';

/**
 * The homepage.
 *
 * The five key visuals run as `FeatureBlockSection` rows — the repo's own alternating row, given a
 * component in its default slot instead of an image, with `imageFirst` alternating the sides. They
 * replaced `ManageSection`, `ScadaSection` and `ReactSection`, which said the same things in
 * screenshots; `RuleEngineSection` went with them, having been behind `{false && …}` since before
 * this work started.
 *
 * Each visual draws itself from a design unit derived from the width this row gives it — see
 * `src/components/Landing/CLAUDE.md` before changing one. They were built and judged at
 * `/internal/launch-visuals/`, which is still the place to do that.
 */

// Passed to both <Hero> and the preload, so the <link> can't name a file the CSS
// won't paint — which is also why backgroundImage isn't left to Hero's default.
// One 16:9 asset at every width. tb-cover-mobile.webp is a 700x1080 portrait
// crop, art-directed for the old full-bleed hero; the split layout's panel is
// 16:9 everywhere, so that crop lost most of its height to `cover` and read as
// a fragment of a dashboard. tb-cover.webp is exactly 1920x1080, so it fits the
// panel with no crop at all.
const HERO_BACKGROUND = '/images/hero/tb-cover.webp';
---

<BaseLayout
	headerVariant="transparent"
	forceLightTheme
	title="ThingsBoard - The all-in-one IoT platform"
	description="ThingsBoard is an open-source IoT platform for device management, data collection, processing, and visualization for your IoT projects."
	customTitle={true}
	preloadLcpImage={heroLcpPreload(HERO_BACKGROUND)}
>
	<!-- HERO -->
	<Hero
		product={Products.CE}
		backgroundImage={HERO_BACKGROUND}
		title={['ThingsBoard', 'The all-in-one IoT platform']}
		subtitle="Device management, data processing & visualization for teams who build IoT for clients — with fully white-labeled apps, multi-tenant isolation, and any-device connectivity."
		buttons={[
			{
				text: 'Try for free',
				icon: 'tabler:cloud-filled',
				href: 'https://thingsboard.cloud/signup',
				variant: 'brand',
				ariaLabel: 'Try ThingsBoard Cloud for free',
			},
			{ text: 'Install', icon: 'tabler:download', href: '/installations/', variant: 'outline' },
		]}
		layout="split"
		showArrow={false}
		anchorLink="#intro"
		videoBackground={{
			webm: 'https://video.thingsboard.io/tb-cover2.webm',
			mp4: 'https://video.thingsboard.io/tb-cover2.mp4',
		}}
	>
		<p class="header-animation hero-note">
			Evaluating for a large deployment?
			<a href="/contact-us/">
				Talk to an expert
				<Icon name="tabler:chevron-right" size="14" aria-hidden="true" />
			</a>
		</p>
	</Hero>

	<!-- Dark strip closing the hero, rather than opening the page content. -->
	<CustomersLogo productTag="ce" onDark />

	<section id="overflow">
		{
			/* The centred section: the statement, and the platform visual under it.
		    
		    THIS DISPLACED THE PUBLISHED STATEMENT that used to sit here. That copy was approved and is
		    one revert away — see the commit that removed `data/home-intro.ts`. What replaces it was
		    written for this section with the drawing under it, which is why the heading carries no
		    link: "ThingsBoard" is the first word of a sentence here, and a link inside it is a second
		    thing to look at in the largest line on the page.

		    The visual is NOT inside `.new-rows`. It is a full-width section rather than a row's media,
		    and `styles/_home-intro.scss` gives it the 1000 measure — so it gets a 960 column, where it
		    stays horizontal and simply scales. */
		}
		<IntroSection title={PLATFORM_SECTION_COPY.title} description={PLATFORM_SECTION_COPY.description} titleLink={null}>
			<PlatformClear />
		</IntroSection>

		{
			/* The five new key visuals, in running order, alternating sides. Wrapped so the page can
		    tighten the row and alternate its wash without touching the shared component, which two
		    product pages also use. */
		}
		<div class="new-rows">
			<FeatureBlockSection
				heading={CONNECT_COPY.title}
				description={CONNECT_COPY.body}
				links={[{ href: CONNECT_COPY.link.href, text: CONNECT_COPY.link.text }]}
				badge={CONNECT_COPY.badge}
				imageEqual
			>
				{
					/* The hub at five arms a side: ten protocols arriving at one platform, each on a line
				    that runs off and fades out where a device icon would have been. It replaced the
				    cloud, which said "whatever you have is already in here" by piling up names; this
				    says "everything arrives at one place" and draws the arrival.

				    Colour is texture, not a coding — four hues in rotation, no hue repeating down a
				    column or across a row. Nothing on the page names a route, so a coding would have
				    been a key with nothing to decode it; the paragraph beside it lists the routes in
				    words instead.

				    The cloud and ConnectFlow are both still in the sandbox, and either is the fallback
				    if this does not survive review. */
				}
				<ConnectHub arms="five" />
			</FeatureBlockSection>

			<FeatureBlockSection
				heading={SOLUTION_COPY.title}
				description={SOLUTION_COPY.body}
				links={[{ href: SOLUTION_COPY.link.href, text: SOLUTION_COPY.link.text }]}
				badge={SOLUTION_COPY.badge}
				imageFirst
				imageEqual
			>
				<SolutionFlow />
			</FeatureBlockSection>

			<FeatureBlockSection
				heading={DIGITAL_TWIN_COPY.title}
				description={DIGITAL_TWIN_COPY.body}
				links={[{ href: DIGITAL_TWIN_COPY.link.href, text: DIGITAL_TWIN_COPY.link.text }]}
				badge={DIGITAL_TWIN_COPY.badge}
				imageEqual
			>
				{/* The nested reading: the unit in its zone on the left, the same path on the right. */}
				<TwinCorridor zone />
			</FeatureBlockSection>
		</div>

		{
			/* AI, ported from the `tb-landing-prototype` repo's section 06.

		    HERE, between "Model your real world" and "Turn IoT data into action": the rows before it
		    are about describing your system, the rows after are about acting on what it produces, and
		    this is the seam. It is NOT a `FeatureBlockSection` — two routes shown side by side is a
		    comparison, and the alternating row carries one subject at a time.

		    IT BREAKS `.new-rows` IN TWO, and has to. That container is not just a wrapper: it sets
		    `.new-rows .main-div { padding: 80px 20px }`, which would reach every one of this section's
		    own `.main-div`s and blow apart the band geometry the windows are docked to. The rows
		    resume in a second block below, carrying the wash across the seam — see
		    `new-rows--continued`. */
		}
		<AiSection />

		<div class="new-rows new-rows--continued">
			<FeatureBlockSection
				heading={NORMALIZE_COPY.title}
				description={NORMALIZE_COPY.body}
				links={[{ href: NORMALIZE_COPY.link.href, text: NORMALIZE_COPY.link.text }]}
				badge={NORMALIZE_COPY.badge}
				imageFirst
				imageEqual
			>
				<NormalizeSeries motion="pulse" />
			</FeatureBlockSection>

			<FeatureBlockSection
				heading={SCALE_COPY.title}
				description={SCALE_COPY.body}
				links={[{ href: SCALE_COPY.link.href, text: SCALE_COPY.link.text }]}
				badge={SCALE_COPY.badge}
				imageEqual
			>
				<ScaleDuo animate hue="field" />
			</FeatureBlockSection>
		</div>

		<!-- Dashboard Description Section -->
		<section id="dashboard_description">
			<div class="main-div">
				{
					/* The mark is `tabler:chart-dots` at #006bc7, and neither is new. The glyph is the one
					   the platform visual already gives its Operate stage, whose note reads "Dashboards,
					   SCADA, reports" — this section is that stage, so it takes that stage's icon rather
					   than a fresh one. The hue is the sixth of the section colours, the only one with no
					   home on the page: Operate itself is coded indigo, and indigo is already the brand,
					   the solution row's badge and the app squircle. A fourth job for it was not worth
					   the saving. */
				}
				<SectionHeader
					title="Build real-time IoT dashboards"
					subtitle="Build the view your users need from 600+ widgets, and control devices from the same screen. No front-end work required."
					titleSize="section"
					subtitleMeasure="copy"
					badge={{ icon: 'tabler:chart-dots', color: '#006bc7' }}
				>
					<div class="view-all-link">
						<a href="/use-cases/">Browse all use cases</a>
					</div>
				</SectionHeader>
				<DashboardShowcase items={homeCarouselItems} interval={12000} />
			</div>
		</section>

		<!-- Products + ecosystem share one band; the wave field is Products' own -->
		<div class="home-band">
			<!-- Products Section -->
			<section id="products">
				<PricingBackground contained />
				<div class="main-div">
					<SectionHeader
						title="Products"
						subtitle="The same platform and the same features either way — what changes is who runs it. We host, scale and upgrade it for you, or you deploy it inside your own network."
						theme="dark"
						titleSize="title"
						subtitleMeasure="copy"
					/>
					<div class="product-list">
						{homeProducts.map((product) => <EcosystemCard {...product} />)}
					</div>
				</div>
			</section>

			<!-- Product Ecosystem Section -->
			<section id="product-ecosystem">
				<div class="main-div">
					<SectionHeader
						title="Product ecosystem"
						subtitle="Add what your project needs — protocol bridges, analytics, edge nodes, a mobile app, and a library of ready-made components."
						titleSize="section"
						subtitleMeasure="copy"
					/>
					<div class="product-ecosystem-list">
						{
							homeEcosystem.map((product) => (
								<EcosystemCard
									name={product.name}
									label={product.label}
									description={product.description}
									icon={product.icon}
									filled={ECOSYSTEM_FILLED && (product.filled ?? false)}
									href={product.href}
									accent={product.accent}
									action={product.action}
									addOn={product.addOn}
									wide={product.wide}
									videoWebm={product.videoWebm}
									videoMp4={product.videoMp4}
									stores={product.stores}
									flipped={product.flipped}
									tiles={product.tiles}
								/>
							))
						}
					</div>
				</div>
			</section>
		</div>

		<!-- Bottom Features Section -->
		<section id="bottom-features">
			<div class="main-div">
				{
					/* Heading and cards both come from `develop`'s own closing feature section, so the two
					   pages make the same argument in the same words. No subtitle: develop carries none,
					   and the ten cards under it are the answer to the question the title asks. */
				}
				<SectionHeader title="Why choose ThingsBoard" titleSize="section" />
				<div id="cards">
					{homeFeatures.map((feature) => <FeatureTile {...feature} />)}
				</div>
			</div>
		</section>
	</section>

	<ClosingCta />
	{
		/* TEMP-INTERNAL-NAV — remove before this branch reaches main.
	    The key visuals are judged here now, and nothing links back to the sandbox they were built
	    in. This is the internal switcher: a pill in the bottom-left corner that collapses to a dot,
	    on every other internal page already. It is NOT production chrome.

	    To remove: `grep -rn TEMP-INTERNAL-NAV src/pages/index.astro` and delete both hits. */
	}
	<InternalNav />
</BaseLayout>

{/* Scoped to `.new-rows`, so none of it reaches the product pages that share this component. */}
<style is:global lang="scss">
	@use '../styles/variables' as *;
	@use '../styles/home-rows';
	@use '../styles/home-intro';
</style>

<style is:global lang="scss">
	@use '../styles/landing';
	@use '../styles/variables' as *;
	// FLAT SECTIONS TRIAL — delete this one line to revert the homepage to the
	// diagonal bands, card shadows and full-strength accents. See the file
	// header in _sections-flat.scss for what it changes and why.
	@use '../styles/sections-flat';

	// --- Homepage facelift: menu height, primaries, secondaries, GitHub button ---

	.hero-note {
		@include type-small;
		margin: 24px 0 0;
		// Secondary: it sat at the same full white as .tb-sub-title, so a
		// qualifying aside carried the weight of the hero's body copy. The link
		// keeps its brighter 0.85 — it is the actionable half, and dimming an
		// underlined link along with its label costs affordance rather than
		// emphasis. Last in the reveal (nth-child(5) -> 1200ms), so it arrives
		// after the buttons rather than alongside the headline.
		color: rgba(255, 255, 255, 0.6);

		// The `header-animation` class alone does nothing here: this paragraph is
		// slotted into Hero, so it never receives Hero's scope hash and none of
		// that component's `.header-animation` rules match it — measured as
		// `animation-delay: 0s` and `opacity: 1` while the headline, subtitle and
		// buttons all animated. The reveal is restated locally instead, picking up
		// the stagger after the buttons' 900ms. `slideup-in` is emitted unscoped,
		// so the keyframes themselves are shared rather than duplicated.
		&.header-animation {
			opacity: 0;
			transform: translate3d(0, 45px, 0);
			animation-name: slideup-in;
			animation-duration: 600ms;
			animation-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94);
			animation-fill-mode: forwards;
			animation-delay: 1200ms;
		}

		// Authoring this reveal fresh, so it gets the guard the component's own
		// sequence never had.
		@media (prefers-reduced-motion: reduce) {
			&.header-animation {
				animation: none;
				opacity: 1;
				transform: none;
			}
		}

		a {
			// Always its own line. Side by side only ever fitted at the widest
			// columns, and the 8px that set the link off from the question became a
			// stray indent the moment the note wrapped — the link hung in from the
			// paragraph's left edge with nothing above it. Stacking retires the
			// margin instead of tuning it per breakpoint. `fit-content` keeps the
			// underline on the words rather than running the paragraph's width.
			display: flex;
			width: fit-content;
			align-items: center;
			gap: 2px;
			margin-top: 6px;
			color: rgba(255, 255, 255, 0.85);
			text-decoration: underline;
			text-underline-offset: 3px;

			&:hover,
			&:focus-visible {
				color: #fff;
			}
		}
	}

	// `html:root` rather than `:root`: Starlight sets its accent on `:root` too,
	// and at equal specificity the winner is whichever sheet lands last.
	html:root {
		// Shorter menu. Hero reads it too, so the video panel and the text column
		// stay clear of it without a second constant to keep in sync.
		--home-header-h: 64px;

		// One purple. `--color-primary` resolves through Starlight's accent, which
		// was still the old #1a6fd4, and `--tb-main-color` was #2a7dec — while
		// `--color-primary-rgb` had already moved to 61,80,245.
		--sl-color-text-accent: #{$color-brand};
		--color-primary: #{$color-brand};
		--tb-main-color: #{$color-brand};

		// Muted hero text. Full alpha and a stronger chroma: dropping the alpha
		// mixes the colour toward the black column, which is what kept flattening
		// the hue. Vividness has to come from the colour, not the opacity.
		--hero-muted: rgba(150, 164, 255, 0.72);
	}

	header.header {
		height: var(--home-header-h);
		transition-duration: 0.1s;
	}

	// The transparent bar gets a scrim rather than nothing. It spans both halves
	// of the split hero — the black text column and the video panel — and over
	// the footage the nav had no ground of its own, so its legibility changed
	// with whatever frame was playing. 80% black reads as one continuous surface
	// across both halves while the panel still shows through.
	//
	// Both guards match the Sign in and GitHub rules below: the scrolled bar has
	// its own solid surface, and the open drawer is a light one, so neither wants
	// black poured over it. Scoped to this page — the three product pages also
	// use `transparent`, over a full-bleed image rather than a split panel, and
	// changing their heroes was not asked for.
	header.header:not(.opened-burger):not([data-header-scrolled]):has([data-header-variant='transparent']) {
		background-color: rgba(0, 0, 0, 0.8);
	}

	// `.logo--lg` in the header component resolves to `header .logo.logo--lg`,
	// which ties with a plain `header.header .logo` — so match its class count
	// and win on order rather than relying on it.
	header.header .logo.logo--lg {
		height: 50px;
		width: 175px;

		@media screen and (min-width: 1025px) {
			width: 215px;
		}

		@media screen and (min-width: 1281px) and (max-width: 1599px) {
			width: 160px;
		}

		// Phones: 175px put the wordmark shoulder to shoulder with the Menu
		// button on a 375px screen. Height follows so the mark keeps its ratio
		// inside the box — width drives `contain` at every one of these sizes.
		@media screen and (max-width: 767px) {
			width: 168px;
			height: 48px;
		}

		@media screen and (max-width: 480px) {
			width: 152px;
			height: 44px;
		}
	}

	// Primary: one purple across the page — the header CTA, the hero, and the
	// n-button primaries in the sections below. White on #3d50f5 is 5.73:1, which
	// clears AA for body-sized text.
	.n-button--filled,
	#hero .button.brand,
	.closing-cta__primary {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		font-weight: $font-weight-bold;
		background-color: $color-brand;
		color: #fff;
	}

	// Install was in the rule above, so the bookend closed on two filled purples
	// — two primaries reading as one choice made twice. It is the secondary, and
	// `ClosingCta` already declares the hero's outline for it (same 0.35 white
	// rule, same 0.14 hover tint), so it only needs the shimmer's scaffolding
	// from that rule and not the fill.
	.closing-cta__secondary {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		font-weight: $font-weight-bold;
	}

	// Shimmer: a single skewed highlight crossing on hover. Transform-only, so it
	// composites rather than repainting, and it runs once per hover instead of
	// looping.
	.n-button--filled::after,
	#hero .button.brand::after,
	#hero .learn-tb::after,
	.closing-cta__primary::after,
	.closing-cta__secondary::after {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 45%;
		z-index: -1;
		pointer-events: none;
		background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.38), transparent);
		transform: translateX(-160%) skewX(-18deg);
	}

	.n-button--filled:hover::after,
	.n-button--filled:focus-visible::after,
	#hero .button.brand:hover::after,
	#hero .button.brand:focus-visible::after,
	#hero .learn-tb:hover::after,
	#hero .learn-tb:focus-visible::after,
	.closing-cta__primary:hover::after,
	.closing-cta__primary:focus-visible::after,
	.closing-cta__secondary:hover::after,
	.closing-cta__secondary:focus-visible::after {
		animation: btn-shimmer 0.75s cubic-bezier(0.4, 0, 0.2, 1);
	}

	// The bookend gets the hero's focus ring too. It had none — only a colour
	// change on :focus-visible, which is not a focus indicator on a dark ground.
	.closing-cta__primary:focus-visible,
	.closing-cta__secondary:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 3px;
	}

	@keyframes btn-shimmer {
		from {
			transform: translateX(-160%) skewX(-18deg);
		}
		to {
			transform: translateX(320%) skewX(-18deg);
		}
	}

	// Secondary, dark-on-light: a tint on hover rather than a fill, so it never
	// reads as a primary mid-interaction.
	.n-button--filled:hover,
	#hero .button.brand:hover {
		background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2));
	}

	.n-button--filled:active,
	#hero .button.brand:active {
		background-image: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3));
	}

	// Primary trimmed to balance the shorter menu, floored at 40px so it stays a
	// comfortable target alongside the Sign in secondary.
	header.header .head-buttons .n-button.try {
		width: auto;
		height: 40px;
		min-height: 40px;
		padding: 0 18px;
		font-size: 14px;
	}

	// Tighter than the 0.875rem default — four controls sit in this cluster. Set
	// as the token so the bar and the open drawer cannot drift apart: the shared
	// drawer rule used to restate the default, which widened every gap by 6px and
	// made the cluster spread as it opened.
	header.header .head-buttons {
		--tb-cluster-gap: 8px;
	}

	// The widget was floating off the pair. Two things were doing it, and the
	// larger one was not the margin.
	//
	// GitHubButton reserves a fixed 100px wrap (132 above 1600, where the "Star"
	// label shows) so the star count arriving later cannot shift the nav. But the
	// button itself is only 36px until that count loads — the count cell is
	// `width: 0` and expands to 61px on `.is-loaded` — so the reservation renders
	// as up to 64px of empty space, and it all sits on the RIGHT, between the star
	// and Sign in. Measured 82px from the button's edge to Sign in against the 8px
	// that separates Sign in from Try for free.
	//
	// Right-aligning the button inside its own wrap keeps the reservation exactly
	// as it was — nothing shifts when the count lands, it just grows leftward into
	// space that was already empty — and puts the star on the cluster's 8px gap in
	// both states. The 10px margin on top of that gap goes with it.
	// `text-align` rather than a flex context, because `display` on this wrap is
	// the component's visibility switch — `none` by default, `block` at its own
	// breakpoints and at the tablet one below. Setting it here would show the
	// widget at every width.
	header.header .head-buttons .gh-wrap {
		text-align: right;
		margin-right: 0;
	}

	// GitHubButton hides itself below 1120px, which suited a bar that dropped
	// every control into the drawer at 1280. Now that the tablet bar keeps the
	// account controls, the stars fit alongside them with room to spare, and on
	// this page the count is part of the pitch. Scoped here rather than lowering
	// the component's own breakpoint, which every other page shares.
	@media screen and (min-width: 768px) and (max-width: 1119px) {
		header.header .head-buttons .gh-wrap {
			display: block;
		}
	}

	// Only `.n-button.price` gets an explicit white on the transparent header, so
	// the Sign in secondary inherited dark text and vanished over the hero.
	header.header .region-signin summary {
		font-size: 15px;
	}

	// White only while the bar is actually transparent over the hero. Both guards
	// are load-bearing, and each one covers a surface this white would otherwise
	// be invisible against:
	//   :not(.opened-burger)        — the drawer is a light surface
	//   :not([data-header-scrolled]) — the scrolled bar flips to solid white
	//
	// The three states are now mutually exclusive by condition rather than by
	// source order, which is what went wrong before: the two guards each add
	// specificity, and with only the first of them this selector outweighed the
	// [data-header-scrolled] rule below that had been winning on order alone.
	// Ordering is no longer what keeps them apart, so adding a fourth state
	// can't silently break the other three.
	// The star widget joins each of these: it takes its ink, border and hover from
	// `currentColor`, so naming the colour here is the whole of its theming — the
	// border and the Octicon follow without a rule of their own. Added as separate
	// selectors rather than a `:is()` so each keeps the specificity the note above
	// depends on.
	header.header:not(.opened-burger):not([data-header-scrolled]):has([data-header-variant='transparent'])
		.region-signin
		summary,
	header.header:not(.opened-burger):not([data-header-scrolled]):has([data-header-variant='transparent'])
		.gh-button {
		color: #fff;
	}

	header.header[data-header-scrolled] .region-signin summary,
	header.header[data-header-scrolled] .gh-button {
		color: var(--color-text);
	}

	// No mark beside either region. A flag answers "whose country is this?" when the
	// menu is asking where the data should live, and no set of flags settles it —
	// one excludes Canada, two excludes Mexico, three is unreadable at this size. A
	// neutral glyph avoided the claim but said nothing either: the same globe twice,
	// told apart only by hue. The region names are short and unambiguous on their
	// own, so they carry it, set larger than the rest of the menu.

	.n-button--outlined:hover {
		background-color: rgba(61, 80, 245, 0.08);
	}

	.n-button--outlined:active {
		background-color: rgba(61, 80, 245, 0.14);
	}

	// The star widget needs nothing here any more. It used to be dressed in
	// GitHub's own palette (#21262d / #30363d / #e6edf3), which is a near-black
	// pill: invisible over the dark hero and a hole on the light scrolled bar, so
	// this block repainted it per state. It now takes its border, ink and hover
	// from `currentColor` — the same contract `.region-signin summary` keeps — so
	// it follows the bar through transparent, scrolled and drawer on its own, and
	// there is no second palette to keep in sync. See GitHubButton.astro.

	// The old accent (#1a6fd4) is hardcoded inside the section components rather
	// than read from a token, so it can't be retired by changing a variable.
	// These overrides are scoped to this page: the same components keep their
	// existing blue everywhere else on the site.
	#overflow {
		// Arrows and their SVGs take `currentColor`, so recolouring the link they
		// sit in carries them along.
		a.heading-1,
		a.read-more-link,
		a.product-card__link,
		a.ecosystem-card__link,
		a.dashboard-slide__link,
		.dashboard-slide a,
		p a,
		li a,
		h2 a,
		h3 a {
			color: $color-brand;
		}
	}

	// The section components pin their arrow colour with ID-scoped selectors —
	// `#manage a.read-more-link .arrow` and friends, specificity (1,2,1) — which
	// outranks a plain `#overflow a.read-more-link` (1,1,1). Repeating the id
	// takes this to (2,2,1), covering every section without naming each one.
	#overflow#overflow {
		a.read-more-link .arrow,
		a.read-more-link .arrow-container,
		.dashboard-slide a .arrow,
		.view-all-link a,
		a.rule-button,
		.feature-des a {
			color: $color-brand;
		}

		// The tile title is the card, not a link to look at — it stays black and
		// carries the stretched hit area.
		.feature-tile__link {
			color: var(--color-text);
		}

		.feature-tile__doc {
			color: inherit;
		}

		// No underlines at rest — the card is quiet until you approach it.
		.feature-tile__link,
		.feature-tile__doc {
			text-decoration: none;
			text-underline-offset: 2px;
		}

		.feature-tile:hover .feature-tile__link,
		.feature-tile:hover .feature-tile__doc,
		.feature-tile:focus-within .feature-tile__link,
		.feature-tile:focus-within .feature-tile__doc {
			text-decoration: underline;
			text-decoration-color: rgba(0, 0, 0, 0.35);
		}

		.feature-tile__title:hover .feature-tile__link,
		.feature-tile__link:focus-visible,
		.feature-tile__doc:hover,
		.feature-tile__doc:focus-visible {
			color: $color-brand;
			text-decoration-color: currentColor;
		}
	}

	// The footer is the one place the declared number is the measure rather than
	// the measure plus 40: the shared component replaces the container padding
	// with `padding: 5.75rem 0`, so 960 puts its content on 240 with the grids.
	//
	// `!important` because the component carries its own `max-width: 1400px
	// !important` above 1500px — nothing but an `!important` reaches past that,
	// and without it the footer alone would widen on large monitors. `body` breaks
	// the specificity tie with the component's own `footer .main-div`.
	body footer .main-div {
		max-width: 960px !important;
	}

	// The gutter, for the same reason. `<footer>` carries `padding-inline: 30px`,
	// which the 960 cap hides on desktop — the container is centred inside it
	// either way — but below about 1020 it becomes the gutter, and the footer was
	// the one block sitting on 30 while the whole page sat on 20.
	body footer {
		padding-inline: $spacing-5;
	}

	// Intro section. The paragraph has auto side margins but no max-width, so it
	// ran the full 1400px container — around 180 characters a line, well past a
	// readable measure. 65ch is the conventional range; the title's 48px bottom
	// margin also left the text reading as a separate block rather than as part
	// of the same thought.
	//
	// The 960 container cap that used to live here is now the page default in
	// _sections-flat.scss, so this section gets it without asking. The 65ch below
	// is a TYPE measure and stays — it is doing a different job.
	#overflow .intro-section {
		&__title {
			margin-bottom: $spacing-4;
		}

		&__text {
			max-width: 65ch;
		}
	}

	// THE `#overflow` HEADING RULES ARE GONE, and this note is what they leave behind.
	//
	// There were four: a blanket weight on every h2 and h3, a blanket 32px on every h2, a colour on
	// the h2s that were not SectionHeader's, and a colour on the wordmark link inside the intro
	// title. Between them they decided the type of five section headings and five row headings from
	// here, keyed to an ID — (1,0,1) and (1,1,0), which no class, no mixin and no custom property in
	// any component can reach. The practical effect was that the shared type scale had no authority
	// on this page: editing `section-title` in `_variables.scss` moved nothing, and a fix to
	// `SectionHeader` for its own `theme="dark"` had already had to be rerouted through a custom
	// property to get out from under one of them. The comment that shipped with that fix says so.
	//
	// Where each went, all of it checked against a computed-style snapshot of the whole page:
	//
	//   weight    Redundant. Every one of these headings reaches 700 through its own mixin now that
	//             `$font-weight-semibold` is an alias of `$font-weight-bold` — which is what they
	//             were painting all along, since Ubuntu has no 600.
	//   size      `SectionHeader`'s new `titleSize` prop, whose three values are the three mixins.
	//             The intro statement keeps its own 32px in `_home-intro.scss`, class-only, where it
	//             was already stated and already documented as being shadowed by the ID rule.
	//   colour    `IntroSection` already sets `color: var(--color-text)` on its own title, and the
	//             wordmark link is already black from `_home-intro.scss`. Both were duplicates.

	@media (prefers-reduced-motion: reduce) {
		.n-button--filled:hover::after,
		.n-button--filled:focus-visible::after,
		#hero .button.brand:hover::after,
		#hero .button.brand:focus-visible::after,
		#hero .learn-tb:hover::after,
		#hero .learn-tb:focus-visible::after {
			animation: none;
		}
	}

	// Even out ragged headings and keep single-word orphans off the last line of
	// body copy. Both properties are ignored where unsupported, so the fallback
	// is simply today's wrapping.
	h1,
	h2,
	h3,
	.tb-sub-title {
		text-wrap: balance;
	}

	p {
		text-wrap: pretty;
	}

	// Remove white section backgrounds on home page. The customer-logo strip is
	// exempt: it carries a deliberate dark background so it reads as the closing
	// band of the hero, and this rule outranks the component's own scoped style
	// (Astro wraps that scope in :where(), which adds no specificity).
	:root section:not(.customers-logo--dark):not(.closing-cta) {
		background: none;
	}

	// Overflow container
	#overflow {
		overflow: hidden;

		@include media-down(md) {
			#react {
				margin-top: $spacing-12;
			}
		}
	}

	// Products section
	#products,
	#product-ecosystem {
		width: 100%;
		padding-top: $spacing-24;
		position: relative;

		@include media-down(md) {
			padding-top: 60px;
			margin-bottom: 60px;
		}
	}

	// Products gets a plain rectangular band instead of the skewed decorative
	// wedges, with the pricing wave field animating inside it. `isolation` makes
	// the section a stacking context, so the field's z-index:-1 lands above this
	// background rather than behind it.
	// Products and the ecosystem are one band with one wave field behind both.
	// `isolation` makes this a stacking context, so the field's z-index:-1 lands
	// above this background rather than behind it.
	.home-band {
		position: relative;
		isolation: isolate;
		// Primary-derived rather than the legacy cool grey $color-bg-light
		// (#f7f9fc): color-mix(in srgb, #3d50f5 5%, #fff). Same value as the
		// alternating strips and the dashboards block, so every light band on the
		// page is one tint related to the brand.
		background: #f5f6ff;

		// Match the homepage primary rather than the pricing page's blue.
		.pricing-bg {
			--pricing-wave-color: #{$color-brand};
		}
	}

	// The two halves meet inside the band, so the gap between them is theirs to
	// share — not two full section paddings stacked.
	#products {
		// Holds the wave field: without a stacking context here, its z-index:-1
		// would drop behind the band's background and disappear.
		isolation: isolate;
		padding-top: $spacing-16;
		// Was 24px, halved on the reasoning that the ecosystem's own 24 completed
		// the gap between them. That held while the two shared one light band; now
		// the section ends on a hard colour edge, so the 24 read as the cards
		// being cropped by it. Matched to the top instead — the band is its own
		// composition and sits its content centred in 64px.
		padding-bottom: $spacing-16;

		@include media-down(md) {
			// Same reasoning against the shared rule's 60px top.
			padding-bottom: 60px;
			// The shared rule's margin would cut a white gap through the band.
			margin-bottom: 0;
		}
	}

	// ── The deployments half, inverted ───────────────────────────────────
	// Products runs dark while the ecosystem under it stays light, so "who owns
	// the infrastructure" reads as its own decision rather than the first row of
	// a longer catalogue. The band's light fill still paints underneath — this
	// covers it for the section's own bounds — and the `isolation` above keeps
	// the wave field's z-index:-1 above this fill instead of behind it.
	//
	// Both values are the light band's recipe inverted: the same primary tinting
	// a near-black, rather than a neutral grey.
	//   band  color-mix(in srgb, #3d50f5 8%, #0e0f13)
	//   card  color-mix(in srgb, #3d50f5 6%, #1e1f23)  ← the dark theme's surface
	#products {
		background: #121425;

		// The field paints at 3.5–5.5% ink, and the brand indigo simply isn't
		// there at that opacity on a near-black. The wave lightens so the motion
		// survives; the band keeps the brand.
		.pricing-bg {
			--pricing-wave-color: #8b9bff;
		}
	}

	// The cards stay WHITE on this band, so everything that used to re-point their
	// colours here is gone: the surface, the ink, the hairline, the label and link
	// greys, the lightened name tint and two restated shadows.
	//
	// They were inverted first and the result read subtle. The dark theme's own
	// text pair is built for a page that is dark throughout, where the eye is
	// adapted to it; dropped into one band on a light page the same ratios read a
	// stop down, and the description — the longest text on the card — sat at the
	// bottom of that range at 6.2:1. White puts it back to the component's own ink
	// at ~13:1 and makes these two read as the same object as the seven ecosystem
	// cards below: same component, same treatment, different ground.
	//
	// What is left of the inversion is the BAND — dark ground, dark section header.
	// That is what marks the section, and white cards separate from it further than
	// dark cards on dark ever did.

	// 24px was this section's half of a 48px gap it shared with Products while the
	// two sat in one light band. Products is its own dark band now, so there is no
	// shared gap — the heading was starting 24px under a hard colour edge, which
	// read as squeezed against it rather than spaced from it. A section that opens
	// a band takes the band's own opening measure.
	#product-ecosystem {
		padding-top: $spacing-16;
		padding-bottom: $spacing-24;

		@include media-down(md) {
			padding-top: 60px;
			padding-bottom: 60px;
		}
	}

	#products .section-header {
		margin-bottom: $spacing-12;
	}

	// Products leads the band at `titleSize="title"` (40px) and the ecosystem reads as a continuation
	// rather than a peer, so it takes `titleSize="section"` (32px). Both are stated at the call sites
	// above; they used to be `#products .section-header__title` and a nested rule under
	// `#product-ecosystem`, which is why the mixins could not be edited.
	//
	// 40, not 48. `type-display` is still there and still the top of the ladder, but nothing on this
	// page is using it: a one-word heading over two cards was not carrying 48px, and the copy is
	// likely to be rewritten anyway. One step down still leads the band and no longer shouts.
	//
	// The subtitle measure went the same way, as `subtitleMeasure="copy"`. It shipped at the
	// component's 900px against the intro's 65ch (587px) and the rows' 46ch (415px) — one lede type
	// at three measures, the widest running about 110 characters a line. `SectionHeader` turns out to
	// have exactly one caller, this file, so the prop is the whole story rather than a homepage patch.

	// The row headings and the dashboards tab titles used to come through at #353841, the body text
	// colour, against #17181c everywhere else on the page. The rule that fixed it listed `#manage`
	// and `#scada` — neither of which exists on this page, so two thirds of it never matched
	// anything. `.dashshow__title` now sets the colour in `DashboardShowcase` itself, which is the
	// only place it is used, and the row headings were already reaching #17181c on their own.

	// Spacing only. The title size that used to be nested in here is `titleSize="section"` now.
	#product-ecosystem .section-header {
		margin-bottom: $spacing-8;
	}

	// The heading sat flush against the band's top edge (padding-top was 0), and
	// the gap under it was 100px — the header's own 50px margin plus #cards'
	// 50px padding, stacked. The band gets a top to match its bottom, and the
	// tiles come up to one 32px step under the heading.
	#bottom-features .section-header {
		margin-bottom: $spacing-8;
	}

	// Top-section actions read as labels, matching the cards'
	// `.ecosystem-card__link`: medium weight, accent colour, no arrow, underline
	// on hover. The shared ReadMoreLink stacks three chevrons at 0.2/0.5/1 opacity
	// and slides them 10/20/30px on hover — that stays for the seven other pages
	// using the component, so this is scoped to the three row sections.
	#manage,
	#scada,
	#react {
		.read-more-link .arrow-container {
			display: none;
		}

		.read-more-link:hover,
		.read-more-link:focus-visible {
			text-decoration: underline;
		}
	}

	// No hover treatment on this pair beyond what the component gives every card:
	// the link underlining, the pointer, and the 2px lift, which is back now that
	// there is no shared seam for it to tear open. The card's drop shadow stays
	// invisible either way — black at 8% on a near-black band.

	// Two cards, not one object. They used to sit flush, sharing a 1px seam with
	// only the outer corners rounded, so the pair read as one panel split down the
	// middle. Apart, each deployment is its own card at its own full radius, on the
	// same gutter the ecosystem grid below already uses — so the two product
	// sections sit on one rhythm instead of two.
	.product-list {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: $spacing-5;
		width: 100%;
		max-width: 960px;
		margin: 0 auto;

		@include media-down(md) {
			grid-template-columns: 1fr;
		}
	}

	.product-ecosystem-list {
		// Grid rather than flex: the app card spans two columns, which flex can
		// only fake with hand-computed basis values that break at every new width.
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		align-items: stretch;
		gap: $spacing-5;
		margin: 0 auto;

		// Matches the intro section's 960px measure, so the two sections share a
		// left and right edge down the page.
		width: 100%;
		min-width: 0;
		max-width: 960px;

		> .ecosystem-card--wide {
			grid-column: span 2;
		}

		// Five singles plus two 2-spans is nine cells — three clean rows.
		> .ecosystem-card--flipped {
			grid-column: span 2;
		}

		// Three columns need roughly 300px each to hold the copy; below that the
		// measure gets too tight, so drop to two, then to one.
		@include media-down(lg) {
			grid-template-columns: repeat(2, 1fr);
		}

		@include media-down(md) {
			grid-template-columns: 1fr;

			> .ecosystem-card--wide,
			> .ecosystem-card--flipped {
				grid-column: span 1;
			}
		}
	}

	// Dashboard section
	#dashboard_description {
		margin-top: $spacing-16;
		margin-bottom: $spacing-16;

		@include media-down(md) {
			margin-top: $spacing-8;
			margin-bottom: $spacing-8;
		}

		// The 960 measure this section wanted is now the page default in
		// _sections-flat.scss — the ID-doubled override that used to be here was
		// there to outrank `@layer landing`'s 1400, and it was itself being beaten
		// by a `!important` in the flat layer. Both are gone.

		.section-header {
			margin-bottom: $spacing-8;
		}

		// Sits under the lede now, so it reads as part of the header rather than a
		// footnote to the board.
		.view-all-link {
			margin-top: $spacing-4;

			a {
				@include type-action;
				color: var(--color-primary, #{$color-brand});

				// `:focus-visible` alongside `:hover`, as the other outgoing links have
				// it — on hover alone a keyboard reader reaching this link got colour
				// and nothing else.
				&:hover,
				&:focus-visible {
					text-decoration: underline;
					// 3px, as every other outgoing link on this page underlines. Left
					// unset it fell back to `auto`, which rides tight under the
					// baseline — the same link treatment drawn two ways.
					text-underline-offset: 3px;
				}
			}
		}
	}

	// Bottom features section
	#bottom-features {
		padding-top: $spacing-16;
		padding-bottom: $spacing-20;
		// A STEP DOWN FROM THE BAND ABOVE IT, not a new colour. This was #f5f6ff — the same value
		// `.home-band` carries — so the ecosystem section and this one shared a ground and read as one
		// long block with a heading in the middle of it. Same recipe, twice the ink:
		// color-mix(in srgb, #3d50f5 10%, #fff) against the band's 5%. Still the page's one light
		// tint, still derived from the primary, just far enough off the band to be its own section.
		//
		// It buys the tiles something too. They are white with a hairline, and white on #f5f6ff is a
		// luminance ratio of 1.076 — the reason `FeatureTile` needs that edge at all. On this ground
		// the card reads as a card before the border does any work.
		background-color: #eceefe;
	}

	#cards {
		padding-top: 0;
		// THREE ACROSS, NOT FOUR. Four put the descriptions on a 24-character measure once this
		// section took develop's copy — two and three sentences a card rather than the one line the
		// auto-fill this replaced was tuned for, which ran the longest of them to ten lines. Three
		// gives ~34, on the same three-two-one ladder the ecosystem grid above it uses, so the page's
		// two card grids break at the same widths instead of one reflowing on its own schedule.
		//
		// FLEX RATHER THAN GRID, for the last row. Ten cards over three columns leaves one on its own,
		// and a grid pins it to the first track — an orphan hard against the left edge under two full
		// rows. Flex centres a short row for free, and it is the only part of this that grid cannot do
		// without naming the leftover by `nth-child`, which would be wrong again the moment a card is
		// added or dropped.
		//
		// The basis is the track width written out: the container less the gaps between n cards,
		// divided by n. `flex-shrink: 1` is deliberate — at an exact basis a sub-pixel rounding could
		// otherwise tip the third card onto its own row.
		--cards-per-row: 3;

		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: $spacing-3;
		width: 100%;
		max-width: 960px;
		margin-inline: auto;

		> * {
			flex: 0 1 calc((100% - (var(--cards-per-row) - 1) * #{$spacing-3}) / var(--cards-per-row));
			// Without this a long word sets the card's floor and the row overflows instead of wrapping.
			min-width: 0;
		}

		@include media-down(lg) {
			--cards-per-row: 2;
		}

		@include media-down(md) {
			--cards-per-row: 1;
		}
	}
</style>
