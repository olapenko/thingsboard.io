---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import CustomersLogo from '../components/Landing/CustomersLogo.astro';
import Hero from '../components/Landing/Hero.astro';
import Carousel from '@components/Carousel/Carousel.astro';
import CarouselSlide from '@components/Carousel/CarouselSlide.astro';
import DashboardSlide from '@components/Landing/DashboardSlide.astro';
import { Products } from '@models/site.models';
import IntroSection from '@components/Landing/IntroSection.astro';
import FeatureCard from '@components/Landing/FeatureCard.astro';
import ProductCard from '@components/Landing/ProductCard.astro';
import EcosystemCard from '@components/Landing/EcosystemCard.astro';
import SectionHeader from '@components/Landing/SectionHeader.astro';
import ManageSection from '@components/Landing/ManageSection.astro';
import RuleEngineSection from '@components/Landing/RuleEngineSection.astro';
import ScadaSection from '@components/Landing/ScadaSection.astro';
import ReactSection from '@components/Landing/ReactSection.astro';
import { homeFeatures } from '~/data/homeFeatures';
import { homeEcosystem } from '~/data/homeEcosystem';
import { homeCarouselItems } from '~/data/homeCarousel';
import { heroLcpPreload } from '@util/lcp-preload';

// Passed to both <Hero> and the preload, so the <link> can't name a file the CSS
// won't paint — which is also why backgroundImage isn't left to Hero's default.
// One 16:9 asset at every width. tb-cover-mobile.webp is a 700x1080 portrait
// crop, art-directed for the old full-bleed hero; the split layout's panel is
// 16:9 everywhere, so that crop lost most of its height to `cover` and read as
// a fragment of a dashboard. tb-cover.webp is exactly 1920x1080, so it fits the
// panel with no crop at all.
const HERO_BACKGROUND = '/images/hero/tb-cover.webp';
---

<BaseLayout
	headerVariant="transparent"
	forceLightTheme
	title="ThingsBoard - The all-in-one IoT platform"
	description="ThingsBoard is an open-source IoT platform for device management, data collection, processing, and visualization for your IoT projects."
	customTitle={true}
	preloadLcpImage={heroLcpPreload(HERO_BACKGROUND)}
>
	<!-- HERO -->
	<Hero
		product={Products.CE}
		backgroundImage={HERO_BACKGROUND}
		title={['ThingsBoard', 'The all-in-one IoT platform']}
		subtitle="White-labeled and multi-tenant, deployable on our cloud or inside your own network, with device management, data processing, and visualisation built in."
		buttons={[
			{
				text: 'Try for free',
				icon: 'tabler:cloud-filled',
				href: 'https://thingsboard.cloud/signup',
				variant: 'brand',
				ariaLabel: 'Try ThingsBoard Cloud for free',
			},
			{ text: 'Install', icon: 'tabler:download', href: '/installations/', variant: 'outline' },
		]}
		layout="split"
		showArrow={false}
		anchorLink="#intro"
		videoBackground={{
			webm: 'https://video.thingsboard.io/tb-cover2.webm',
			mp4: 'https://video.thingsboard.io/tb-cover2.mp4',
		}}
	>
		<a slot="kicker" href="https://u24.gov.ua/" target="_blank" rel="noopener noreferrer" class="ua-kicker">
			<svg class="ua-kicker__flag" width="30" height="20" viewBox="0 0 3 2" aria-hidden="true">
				<rect width="3" height="1" fill="#0057b7"></rect>
				<rect y="1" width="3" height="1" fill="#ffdd00"></rect>
			</svg>
			<span class="ua-kicker__label">Support Ukraine</span>
		</a>

		<p class="hero-note">
			Evaluating for a large deployment?
			<a href="/contact-us/">
				Talk to an expert
				<Icon name="tabler:chevron-right" size="14" aria-hidden="true" />
			</a>
		</p>
	</Hero>

	<!-- Dark strip closing the hero, rather than opening the page content. -->
	<CustomersLogo productTag="ce" onDark />

	<section id="overflow">
		<IntroSection />

		<!-- Manage Section -->
		<ManageSection />

		<!-- SCADA Section -->
		<ScadaSection />

		<!-- React Section -->
		<ReactSection />

		<!-- Products Section -->
		<section id="products">
			<div class="main-div">
				<div class="background" aria-hidden="true">
					<div class="products"></div>
					<div class="small7"></div>
					<div class="small8"></div>
				</div>
				<SectionHeader title="Products" theme="dark" />
				<div class="product-list">
					<ProductCard
						name="Community Edition"
						productLabel="ThingsBoard"
						description="Bring your ideas to life"
						image="/src/assets/images/landings/ce/community.svg"
						imageWidth={228}
						imageHeight={134}
						href="/docs/"
						linkText="See Community Edition documentation"
					/>
					<ProductCard
						name="Cloud"
						productLabel="ThingsBoard"
						description="Keep everything in a secure cloud"
						image="/src/assets/images/landings/ce/cloud.svg"
						imageWidth={280}
						imageHeight={164}
						href="/products/paas/"
						linkText="See Cloud documentation"
						featured={true}
					/>
					<ProductCard
						name="Professional Edition"
						productLabel="ThingsBoard"
						description="Get all the functions of ThingsBoard"
						image="/src/assets/images/landings/ce/professional.svg"
						imageWidth={228}
						imageHeight={140}
						href="/products/thingsboard-pe/"
						linkText="See Professional Edition documentation"
					/>
				</div>
			</div>
		</section>

		<!-- Product Ecosystem Section -->
		<section id="product-ecosystem">
			<div class="main-div">
				<div class="background" aria-hidden="true">
					<div class="product-ecosystem"></div>
				</div>
				<SectionHeader title="Product ecosystem" />
				<div class="product-ecosystem-list">
					{
						homeEcosystem.map((product) => (
							<EcosystemCard
								name={product.name}
								description={product.description}
								icon={product.icon}
								href={product.href}
							/>
						))
					}
				</div>
			</div>
		</section>

		<!-- Dashboard Description Section -->
		<section id="dashboard_description">
			<div class="main-div">
				<div class="background" aria-hidden="true">
					<div class="dashboards"></div>
					<div class="small9"></div>
					<div class="small10"></div>
				</div>
				<SectionHeader
					title="Real-Time IoT Dashboards"
					subtitle="ThingsBoard allows you to create rich IoT Dashboards for data visualization and remote device control in real-time. More than 600 customizable widgets allows you to build end-user custom dashboards for most IoT use-cases."
					align="left"
				/>
				<Carousel
					showDots={true}
					showArrows={true}
					loop={true}
					autoplay={true}
					autoplayInterval={15000}
					slideCount={homeCarouselItems.length}
					ariaLabel="IoT dashboard examples"
				>
					{
						homeCarouselItems.map((item, i) => (
							<CarouselSlide index={i} total={homeCarouselItems.length}>
								<DashboardSlide item={item} />
							</CarouselSlide>
						))
					}
				</Carousel>
				<div class="view-all-link">
					<a href="/products/">View all products</a>
				</div>
			</div>
		</section>

		<!-- Rule Engine Section -->
		<RuleEngineSection />

		<!-- Bottom Features Section -->
		<section id="bottom-features">
			<div class="main-div">
				<div class="background hidden" aria-hidden="true">
					<div class="bottom-features1"></div>
					<div class="bottom-features2"></div>
					<div class="small11"></div>
					<div class="small12"></div>
					<div class="bottom-features3"></div>
					<div class="small13"></div>
					<div class="small14"></div>
					<div class="small15"></div>
				</div>
				<SectionHeader title="ThingsBoard Features" />
				<div id="cards">
					{
						homeFeatures.map((feature) => (
							<FeatureCard
								icon={feature.icon}
								title={feature.title}
								description={feature.description}
								href={feature.href}
							/>
						))
					}
				</div>
			</div>
		</section>
	</section>
</BaseLayout>

<style is:global lang="scss">
	@use '../styles/landing';
	@use '../styles/variables' as *;

	// --- Homepage facelift: menu height, primaries, secondaries, GitHub button ---

	.hero-note {
		margin: 24px 0 0;
		font-size: 14px;
		line-height: 1.4;
		color: #fff;

		a {
			display: inline-flex;
			align-items: center;
			gap: 2px;
			// Set the link off from the question rather than letting it run on.
			margin-left: 8px;
			color: rgba(255, 255, 255, 0.85);
			text-decoration: underline;
			text-underline-offset: 3px;

			&:hover,
			&:focus-visible {
				color: #fff;
			}
		}
	}

	// `html:root` rather than `:root`: Starlight sets its accent on `:root` too,
	// and at equal specificity the winner is whichever sheet lands last.
	html:root {
		// Shorter menu. Hero reads it too, so the video panel and the text column
		// stay clear of it without a second constant to keep in sync.
		--home-header-h: 64px;

		// One purple. `--color-primary` resolves through Starlight's accent, which
		// was still the old #1a6fd4, and `--tb-main-color` was #2a7dec — while
		// `--color-primary-rgb` had already moved to 61,80,245.
		--sl-color-text-accent: #{$color-brand};
		--color-primary: #{$color-brand};
		--tb-main-color: #{$color-brand};

		// Muted hero text. Full alpha and a stronger chroma: dropping the alpha
		// mixes the colour toward the black column, which is what kept flattening
		// the hue. Vividness has to come from the colour, not the opacity.
		--hero-muted: rgba(150, 164, 255, 0.72);
	}

	header.header {
		height: var(--home-header-h);
		transition-duration: 0.1s;
	}

	// `.logo--lg` in the header component resolves to `header .logo.logo--lg`,
	// which ties with a plain `header.header .logo` — so match its class count
	// and win on order rather than relying on it.
	header.header .logo.logo--lg {
		height: 50px;
		width: 175px;

		@media screen and (min-width: 1025px) {
			width: 215px;
		}

		@media screen and (min-width: 1281px) and (max-width: 1599px) {
			width: 160px;
		}

		// Phones: 175px put the wordmark shoulder to shoulder with the Menu
		// button on a 375px screen. Height follows so the mark keeps its ratio
		// inside the box — width drives `contain` at every one of these sizes.
		@media screen and (max-width: 767px) {
			width: 168px;
			height: 48px;
		}

		@media screen and (max-width: 480px) {
			width: 152px;
			height: 44px;
		}
	}

	// Primary: one purple across the page — the header CTA, the hero, and the
	// n-button primaries in the sections below. White on #3d50f5 is 5.73:1, which
	// clears AA for body-sized text.
	.n-button--filled,
	#hero .button.brand {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		font-weight: $font-weight-bold;
		background-color: $color-brand;
		color: #fff;
	}

	// Shimmer: a single skewed highlight crossing on hover. Transform-only, so it
	// composites rather than repainting, and it runs once per hover instead of
	// looping.
	.n-button--filled::after,
	#hero .button.brand::after,
	#hero .learn-tb::after {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 45%;
		z-index: -1;
		pointer-events: none;
		background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.38), transparent);
		transform: translateX(-160%) skewX(-18deg);
	}

	.n-button--filled:hover::after,
	.n-button--filled:focus-visible::after,
	#hero .button.brand:hover::after,
	#hero .button.brand:focus-visible::after,
	#hero .learn-tb:hover::after,
	#hero .learn-tb:focus-visible::after {
		animation: btn-shimmer 0.75s cubic-bezier(0.4, 0, 0.2, 1);
	}

	@keyframes btn-shimmer {
		from {
			transform: translateX(-160%) skewX(-18deg);
		}
		to {
			transform: translateX(320%) skewX(-18deg);
		}
	}

	// Secondary, dark-on-light: a tint on hover rather than a fill, so it never
	// reads as a primary mid-interaction.
	.n-button--filled:hover,
	#hero .button.brand:hover {
		background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2));
	}

	.n-button--filled:active,
	#hero .button.brand:active {
		background-image: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3));
	}

	// Primary trimmed to balance the shorter menu, floored at 40px so it stays a
	// comfortable target alongside the Sign in secondary.
	header.header .head-buttons .n-button.try {
		width: auto;
		height: 40px;
		min-height: 40px;
		padding: 0 18px;
		font-size: 14px;
	}

	header.header .head-buttons {
		gap: 8px;
	}

	// Different animal — a third-party widget rather than one of our buttons, so
	// it gets air instead of joining the pair.
	header.header .head-buttons .gh-wrap {
		margin-right: 10px;
	}

	// GitHubButton hides itself below 1120px, which suited a bar that dropped
	// every control into the drawer at 1280. Now that the tablet bar keeps the
	// account controls, the stars fit alongside them with room to spare, and on
	// this page the count is part of the pitch. Scoped here rather than lowering
	// the component's own breakpoint, which every other page shares.
	@media screen and (min-width: 768px) and (max-width: 1119px) {
		header.header .head-buttons .gh-wrap {
			display: block;
		}
	}

	// Only `.n-button.price` gets an explicit white on the transparent header, so
	// the Sign in secondary inherited dark text and vanished over the hero.
	header.header .region-signin summary {
		font-size: 15px;
	}

	// `:not(.opened-burger)` because the burger drawer flips to a light surface:
	// unscoped, this white followed the control into the drawer and tied on
	// specificity with the drawer's own rule, so Sign in rendered white on white
	// — sized and clickable, but invisible. Same guard the nav rules use.
	header.header:not(.opened-burger):has([data-header-variant='transparent']) .region-signin summary {
		color: #fff;
	}

	header.header[data-header-scrolled] .region-signin summary {
		color: var(--color-text);
	}

	// Region marks: set in type, sized alike, so they read as a pair.
	.region-badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 24px;
		height: 24px;
		margin-right: 8px;
		border-radius: 4px;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.02em;
		color: #fff;
		flex: 0 0 auto;
	}

	.region-badge--us {
		background-color: $color-brand;
	}

	.region-badge--eu {
		background-color: #0f161d;
	}

	.region-signin__menu a {
		display: flex;
		align-items: center;
	}

	.n-button--outlined:hover {
		background-color: rgba(61, 80, 245, 0.08);
	}

	.n-button--outlined:active {
		background-color: rgba(61, 80, 245, 0.14);
	}

	// GitHub button in its dark dress, to sit on the hero's black header. Same
	// palette the component already ships behind [data-theme='dark'] — the
	// homepage forces the light theme, so it never reaches it.
	header.header .gh-button {
		background: #21262d;
		border-color: #30363d;
		color: #e6edf3;
		box-shadow: 0 1px 0 rgba(0, 0, 0, 0.2);
	}

	header.header .gh-button:hover {
		border-color: #58a6ff;
		color: #e6edf3;
	}

	header.header .gh-sep {
		background-color: #30363d;
	}

	header.header .gh-count {
		background-color: #161b22;
		color: #e6edf3;
	}

	// The old accent (#1a6fd4) is hardcoded inside the section components rather
	// than read from a token, so it can't be retired by changing a variable.
	// These overrides are scoped to this page: the same components keep their
	// existing blue everywhere else on the site.
	#overflow {
		// Arrows and their SVGs take `currentColor`, so recolouring the link they
		// sit in carries them along.
		a.heading-1,
		a.read-more-link,
		a.product-card__link,
		a.ecosystem-card__link,
		a.dashboard-slide__link,
		.dashboard-slide a,
		p a,
		li a,
		h2 a,
		h3 a {
			color: $color-brand;
		}

		.scada-mode-selector {
			background-color: rgba(61, 80, 245, 0.08);
		}

		.scada-mode-selector .mode.active {
			background-color: $color-brand;
		}

		// Decorative dot in ManageSection, painted from the old $color-primary.
		.small2 {
			background-color: $color-brand;
		}
	}

	// The section components pin their arrow colour with ID-scoped selectors —
	// `#manage a.read-more-link .arrow` and friends, specificity (1,2,1) — which
	// outranks a plain `#overflow a.read-more-link` (1,1,1). Repeating the id
	// takes this to (2,2,1), covering every section without naming each one.
	#overflow#overflow {
		a.read-more-link .arrow,
		a.read-more-link .arrow-container,
		.dashboard-slide a .arrow,
		.view-all-link a,
		a.rule-button,
		.feature-des a {
			color: $color-brand;
		}
	}

	// Intro section. The paragraph has auto side margins but no max-width, so it
	// ran the full 1400px container — around 180 characters a line, well past a
	// readable measure. 65ch is the conventional range; the title's 48px bottom
	// margin also left the text reading as a separate block rather than as part
	// of the same thought.
	#overflow .intro-section {
		.main-div {
			max-width: 960px;
		}

		&__title {
			margin-bottom: $spacing-4;
		}

		&__text {
			max-width: 65ch;
		}
	}

	// Section headings step down so the hero leads on size as well as weight, and
	// go bold to match it — Ubuntu has no 600, so 700 is both "semibold" and the
	// ceiling; setting it explicitly just makes that intent visible.
	#overflow h2,
	#overflow h3 {
		font-weight: $font-weight-bold;
	}

	#overflow h2 {
		font-size: $font-size-4xl;
		line-height: 1.2;
		color: var(--color-text);
	}

	// The logomark now carries the brand at the top of the section, so the
	// wordmark inside the heading doesn't need to as well — black reads as one
	// sentence rather than a link dropped into a title.
	#overflow .intro-section__title a {
		color: var(--color-text);
	}

	@media (prefers-reduced-motion: reduce) {
		.n-button--filled:hover::after,
		.n-button--filled:focus-visible::after,
		#hero .button.brand:hover::after,
		#hero .button.brand:focus-visible::after,
		#hero .learn-tb:hover::after,
		#hero .learn-tb:focus-visible::after {
			animation: none;
		}
	}

	// u24 link, sitting above the H1. The label stays in the accessibility tree
	// at all times — it is the link's accessible name — and is only revealed
	// visually on hover or keyboard focus.
	.ua-kicker {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 16px;
		color: var(--hero-muted, rgba(255, 255, 255, 0.65));
		font-size: 13px;
		line-height: 1;
		text-decoration: none;

		&:hover,
		&:focus-visible {
			color: rgba(255, 255, 255, 0.9);
		}
	}

	.ua-kicker__flag {
		display: block;
		flex: 0 0 auto;
		// 30x20 on a 0 0 3 2 viewBox puts the seam on an exact pixel boundary and
		// gives each stripe a whole 10px; crispEdges stops the renderer softening
		// it back into a half-pixel blend.
		shape-rendering: crispEdges;
	}

	.ua-kicker__label {
		display: inline-block;
		max-width: 0;
		overflow: hidden;
		white-space: nowrap;
		opacity: 0;
		transition:
			max-width 0.35s ease,
			opacity 0.25s ease;
	}

	.ua-kicker:hover .ua-kicker__label,
	.ua-kicker:focus-visible .ua-kicker__label {
		max-width: 12rem;
		opacity: 1;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		.ua-kicker__label {
			transition: none;
		}
	}

	// Even out ragged headings and keep single-word orphans off the last line of
	// body copy. Both properties are ignored where unsupported, so the fallback
	// is simply today's wrapping.
	h1,
	h2,
	h3,
	.tb-sub-title {
		text-wrap: balance;
	}

	p {
		text-wrap: pretty;
	}

	// Remove white section backgrounds on home page. The customer-logo strip is
	// exempt: it carries a deliberate dark background so it reads as the closing
	// band of the hero, and this rule outranks the component's own scoped style
	// (Astro wraps that scope in :where(), which adds no specificity).
	:root section:not(.customers-logo--dark) {
		background: none;
	}

	// Overflow container
	#overflow {
		overflow: hidden;

		@include media-down(md) {
			#react {
				margin-top: $spacing-12;
			}
		}
	}

	// Products section
	#products,
	#product-ecosystem {
		width: 100%;
		padding-top: $spacing-24;
		position: relative;

		@include media-down(md) {
			padding-top: 60px;
			margin-bottom: 60px;
		}
	}

	#products .section-header,
	#product-ecosystem .section-header {
		margin-bottom: 72px;
	}

	#bottom-features .section-header {
		margin-bottom: 50px;
	}

	.product-list {
		display: flex;
		margin: 0 $spacing-10;

		@include media-down(lg) {
			flex-direction: column;
			margin: 0;
		}

		@include media-up(lg) {
			margin: 0 30px;
		}
	}

	.product-ecosystem-list {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: $spacing-10;
		margin: 0;

		@include media-down(lg) {
			grid-template-columns: repeat(2, 1fr);
		}

		@include media-down(md) {
			grid-template-columns: 1fr;
		}
	}

	// Dashboard section
	#dashboard_description {
		margin-top: 186px;
		margin-bottom: $spacing-30;
		background-color: var(--color-bg-light);

		@include media-down(md) {
			margin-top: $spacing-5;
			margin-bottom: 60px;
		}

		.view-all-link {
			text-align: center;
			margin-top: $spacing-8;

			a {
				font-size: $font-size-lg;
				font-weight: $font-weight-medium;
				color: #1a6fd4;

				&:hover {
					text-decoration: underline;
				}
			}
		}

		.carousel-wrapper {
			margin-top: $spacing-10;
		}
	}

	// Bottom features section
	#bottom-features {
		padding-bottom: $spacing-20;
		background-color: var(--color-bg-light);
	}

	#cards {
		padding-top: 50px;
		display: flex;
		flex-wrap: wrap;
