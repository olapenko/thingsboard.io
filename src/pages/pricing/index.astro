---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import Button from '@components/ui/Button.astro';
import Card from '@components/ui/Card.astro';
import Segmented from '@components/ui/Segmented.astro';
import Tabs from '@components/ui/Tabs.astro';
import SectionHeader from '@components/Landing/SectionHeader.astro';
import BenefitGrid from '@components/Landing/BenefitGrid.astro';
import ProductMatrix from '@components/Landing/ProductMatrix.astro';
import ProductFaq from '@components/Landing/ProductFaq.astro';

import PricingBackground from '@components/Pricing/PricingBackground.astro';
import { buildFaqPageSchema } from '@util/faq-schema';
import { CLOUD_REGIONS } from '@util/cloud-regions';

import PricingPrepaint from './_PricingPrepaint.astro';
import PlanCards from './_PlanCards.astro';
import AddOnCards from './_AddOnCards.astro';
import TopUpList from './_TopUpList.astro';
import PricingNote from './_PricingNote.astro';
import TbPaygCalculator from '@components/Pricing/TbPaygCalculator.astro';
import TbPrivateCloudCalculator from '@components/Pricing/TbPrivateCloudCalculator.astro';

import { tbCloudData, tbCloudTopUps } from '@data/pricing/tb-cloud';
import { tbPrivateCloudData, tbPrivateCloudAddOns } from '@data/pricing/tb-private-cloud';
import {
	tbPerpetualAddOns,
	tbPerpetualHero,
	tbSelfManagedAddOns,
	tbSelfManagedData,
} from '@data/pricing/tb-self-managed';
import { cloudAddOns } from '@data/pricing/add-ons';
import { pcFeatureHeaders, pcFeatureRows } from '@data/pricing/tb-private-cloud-features';
import { pricingFaqData } from '@data/pricing/faq';
import {
	DEFAULT_DEPLOYMENT,
	DEPLOYMENTS,
	MAIN_TAB_ORDER,
	answerSnippets,
	mainCopy,
	mainTabTooltips,
	type DeploymentId,
} from '@data/pricing-page';

/**
 * PRICING: the page section for section and word for word as it shipped, in the new pages' styles.
 *
 * THE STRUCTURE: the title, the three deployment tabs (On-premises, Cloud — the default — and
 * Private Cloud), a header row with the section's toggle, the plan cards, the upsell under them,
 * add-ons, top-ups or the comparison, and the FAQ for the tab on screen, on the wave ground. The
 * plans open above the fold at 1440 × 900.
 *
 * THE STYLE is the kit's: `SectionHeader` for every heading, `ui/Button` (sm, the primary filled
 * once per row, every other action an outline), `ui/Tabs` for the deployments and `ui/Segmented`
 * for every toggle; cards on the kit's tile surface, the popular one ringed in the scheme's fill,
 * the cards of a row on one subgrid so their prices and buttons line up; the product pages'
 * comparison table (`ProductMatrix`), benefit tiles (`BenefitGrid`) and FAQ (`ProductFaq`);
 * On-premises in its own green, as its product page has it; the add-ons wearing their products'
 * marks; the upsells as one centred line with a glyph and a link or a button (`_PricingNote`).
 *
 * THE TWO CALCULATORS (subscription and Private Cloud) are the ones that shipped, mounted at the
 * foot of the page and opened from the notes and from the FAQ's "Plan Calculator" links. The
 * On-premises plan buttons go through `getLicense()` — the licence portal with the visitor's UTM
 * and referral ids, as before — and every plan button keeps its GTM id.
 */

// Answers shown per topic before "More questions", as main and the product pages show six.
const FAQ_VISIBLE = 6;

const byId = (id: DeploymentId) => DEPLOYMENTS.find((d) => d.id === id)!;
const tabs = MAIN_TAB_ORDER.map(byId);

const faqFor = (id: DeploymentId) => {
	const faq = pricingFaqData.find((f) => f.contextId === id);
	if (!faq) throw new Error(`pricing draft: main's FAQ has no "${id}" context`);
	return faq;
};

/** Main's tooltip text for a line with a `faqId` and no tooltip: the answer, cut to 120. */
const snippets = answerSnippets(pricingFaqData.flatMap((f) => f.categories));

/** Every answer id per deployment, so a tooltip's "Read more" opens its own FAQ and no other. */
const answerIds = new Map<DeploymentId, Set<string>>(
	DEPLOYMENTS.map((d) => [d.id, new Set(faqFor(d.id).categories.flatMap((c) => c.items.map((i) => i.id)))])
);
const faqPrefix = (id: DeploymentId) => `faq-${id}-`;
const answers = (id: DeploymentId) => answerIds.get(id)!;

// Main's one-FAQPage-per-page rule, kept: the default tab's answers, all of them.
const faqPageSchema = buildFaqPageSchema(faqFor(DEFAULT_DEPLOYMENT).categories);

// The data says `na`, the region module says `us`; the switch speaks the module's.
const cloudRegion = {
	us: { plans: tbCloudData.na.plans, addOns: cloudAddOns.na, topUps: tbCloudTopUps.na },
	eu: { plans: tbCloudData.eu.plans, addOns: cloudAddOns.eu, topUps: tbCloudTopUps.eu },
};
---

<BaseLayout
	hero="light"
	forceLightTheme
	title="Pricing"
	description="ThingsBoard IoT Platform pricing — compare On-premises, ThingsBoard Cloud and Private Cloud plans with transparent subscription and perpetual licensing."
	jsonLd={faqPageSchema}
>
	<PricingBackground />
	<div class="p2" data-pricing-page>
		<header class="p2-intro">
			<SectionHeader
				level={1}
				title={mainCopy.title}
				titleSize="display"
				align="center"
				titleMeasure="full"
				spacing="none"
			/>
			<Tabs
				label="Deployment"
				class="p2-deploy"
				size={{ base: 'sm', sm: 'md' }}
				selected={tabs.findIndex((d) => d.id === DEFAULT_DEPLOYMENT)}
				items={tabs.map((d) => ({ label: d.name, icon: d.icon, panel: `plans-${d.id}`, title: mainTabTooltips[d.id] }))}
			/>

			<PricingPrepaint tabs="p2-deploy" ids={MAIN_TAB_ORDER} />
		</header>

		{/* ─── On-premises ──────────────────────────────────────────────────────────────────── */}
		<section
			id="plans-thingsboard-pe"
			class="p2-panel"
			role="tabpanel"
			aria-labelledby="plans-thingsboard-pe-tab"
			data-deploy-panel="thingsboard-pe"
			data-accent="onprem"
		>
			<div class="p2-head">
				<div>
					<div data-onprem-show="payg">
						<SectionHeader
							title={mainCopy.onPremPayg.title}
							subtitle={mainCopy.onPremPayg.subtitle}
							ledeTone="muted"
							align="left"
							spacing="none"
						/>
					</div>
					<div data-onprem-show="perpetual">
						<SectionHeader
							title={mainCopy.onPremPerpetual.title}
							subtitle={mainCopy.onPremPerpetual.subtitle}
							ledeTone="muted"
							align="left"
							spacing="none"
						/>
					</div>
				</div>
				{/* The ⓘ sits inside each option, after its label: a button cannot hold another
				    button, so here it is a mark with the tooltip, tied to the option by
				    `aria-describedby`, and shown on hover or while the option has focus. */}
				<Segmented
					size="sm"
					label="Licensing"
					name="onpremBilling"
					initialFromRoot
					options={(['payg', 'perpetual'] as const).map((value) => ({
						label: mainCopy.licensing[value].label,
						value,
						describedBy: `licensing-tip-${value}`,
					}))}
				>
					{/* One slot per option, named by its value (a slot's name cannot come from a map). */}
					<span slot="payg" class="tip tip--inline">
						<span class="tip__btn" aria-hidden="true">
							<Icon name="tabler:info-circle" />
						</span>
						<span class="tip__body" role="tooltip" id="licensing-tip-payg">
							{mainCopy.licensing.payg.tip}
						</span>
					</span>
					<span slot="perpetual" class="tip tip--inline">
						<span class="tip__btn" aria-hidden="true">
							<Icon name="tabler:info-circle" />
						</span>
						<span class="tip__body" role="tooltip" id="licensing-tip-perpetual">
							{mainCopy.licensing.perpetual.tip}
						</span>
					</span>
				</Segmented>
			</div>

			<div data-onprem-show="payg">
				<PlanCards
					plans={tbSelfManagedData.payg.plans}
					snippets={snippets}
					answers={answers('thingsboard-pe')}
					faqPrefix={faqPrefix('thingsboard-pe')}
				/>
				<PricingNote
					icon="tabler:calculator"
					text={mainCopy.upsellNotSure.heading}
					link={{ text: mainCopy.upsellNotSure.cta }}
					calc="payg"
				/>
				<div class="p2-block">
					<SectionHeader
						title={mainCopy.addOns.title}
						subtitle={mainCopy.addOns.subtitle}
						ledeTone="muted"
						align="left"
						spacing="sm"
					/>
					<AddOnCards
						addOns={tbSelfManagedAddOns}
						answers={answers('thingsboard-pe')}
						faqPrefix={faqPrefix('thingsboard-pe')}
					/>
				</div>
			</div>

			<div data-onprem-show="perpetual">
				<Card role="panel">
					<div class="p2-promo">
						<div class="p2-promo__lead">
							<h3 class="p2-promo__title">{tbPerpetualHero.title}</h3>
							{tbPerpetualHero.subtitle && <p class="p2-promo__subtitle">{tbPerpetualHero.subtitle}</p>}
							{tbPerpetualHero.priceLabel && <p class="p2-promo__price">{tbPerpetualHero.priceLabel}</p>}
							<Button size="sm" href={tbPerpetualHero.ctaHref} class="p2-promo__cta">
								{tbPerpetualHero.ctaText.charAt(0) + tbPerpetualHero.ctaText.slice(1).toLowerCase()}
							</Button>
						</div>
						<div class="p2-promo__body">
							<p class="p2-promo__desc">{tbPerpetualHero.description}</p>
							<ul class="p2-checks">
								{tbPerpetualHero.features.map((f) => (
									<li>
										<Icon name="tabler:check" aria-hidden="true" />
										{f}
									</li>
								))}
							</ul>
						</div>
					</div>
				</Card>
				{tbSelfManagedData.perpetual.benefits && (
					<div class="p2-block">
						<SectionHeader title={mainCopy.perpetualBenefits} ledeTone="muted" align="left" spacing="sm" />
						<BenefitGrid items={tbSelfManagedData.perpetual.benefits} />
					</div>
				)}
				<div class="p2-block">
					<SectionHeader
						title={mainCopy.addOns.title}
						subtitle={mainCopy.addOns.subtitle}
						ledeTone="muted"
						align="left"
						spacing="sm"
					/>
					<AddOnCards
						addOns={tbPerpetualAddOns}
						answers={answers('thingsboard-pe')}
						faqPrefix={faqPrefix('thingsboard-pe')}
					/>
				</div>
				<PricingNote
					icon="tabler:message-circle"
					text={mainCopy.perpetualHelp}
					link={{ text: mainCopy.contactUs, href: tbPerpetualHero.ctaHref }}
					spaced
				/>
			</div>
		</section>

		{/* ─── Cloud ─────────────────────────────────────────────────────────────────────────── */}
		<section
			id="plans-thingsboard-cloud"
			class="p2-panel"
			role="tabpanel"
			aria-labelledby="plans-thingsboard-cloud-tab"
			data-deploy-panel="thingsboard-cloud"
		>
			<div class="p2-head">
				<SectionHeader
					title={tbCloudData.na.sectionTitle}
					subtitle={tbCloudData.na.sectionSubtitle}
					ledeTone="muted"
					align="left"
					spacing="none"
				/>
				<Segmented
					size="sm"
					label="Cloud region"
					name="cloudRegion"
					initialFromRoot
					options={CLOUD_REGIONS.map((r) => ({ label: r.name, value: r.id }))}
				/>
			</div>

			{CLOUD_REGIONS.map((r) => (
				<div data-region-show={r.id}>
					<PlanCards
						plans={cloudRegion[r.id].plans}
						snippets={snippets}
						answers={answers('thingsboard-cloud')}
						faqPrefix={faqPrefix('thingsboard-cloud')}
					/>
				</div>
			))}
			<PricingNote
				icon="tabler:cloud-lock"
				text={mainCopy.upsellPrivateCloud.heading}
				link={{ text: mainCopy.upsellPrivateCloud.cta, href: '?product=thingsboard-private-cloud' }}
				go="thingsboard-private-cloud"
			/>

			<div class="p2-block">
				<SectionHeader
					title={mainCopy.addOns.title}
					subtitle={mainCopy.addOns.subtitle}
					ledeTone="muted"
					align="left"
					spacing="sm"
				/>
				{CLOUD_REGIONS.map((r) => (
					<div data-region-show={r.id}>
						<AddOnCards
							addOns={cloudRegion[r.id].addOns}
							answers={answers('thingsboard-cloud')}
							faqPrefix={faqPrefix('thingsboard-cloud')}
						/>
					</div>
				))}
			</div>

			<div class="p2-block">
				<SectionHeader title={mainCopy.topUps} ledeTone="muted" align="left" spacing="sm" />
				{CLOUD_REGIONS.map((r) => (
					<div data-region-show={r.id}>
						<TopUpList groups={cloudRegion[r.id].topUps} />
					</div>
				))}
			</div>
		</section>

		{/* ─── Private Cloud ─────────────────────────────────────────────────────────────────── */}
		<section
			id="plans-thingsboard-private-cloud"
			class="p2-panel"
			role="tabpanel"
			aria-labelledby="plans-thingsboard-private-cloud-tab"
			data-deploy-panel="thingsboard-private-cloud"
		>
			<div class="p2-head">
				<SectionHeader
					title={tbPrivateCloudData.sectionTitle}
					subtitle={tbPrivateCloudData.sectionSubtitle}
					ledeTone="muted"
					align="left"
					spacing="none"
				/>
				<Segmented
					size="sm"
					label="Billing period"
					name="pcBilling"
					initialFromRoot
					options={[
						{ label: tbPrivateCloudData.billingOptions.monthly, value: 'monthly' },
						{
							label: tbPrivateCloudData.billingOptions.annual,
							value: 'annual',
							badge: tbPrivateCloudData.billingOptions.discount,
							title: mainCopy.pcBillingHint,
						},
					]}
				/>
			</div>

			<PlanCards
				plans={tbPrivateCloudData.plans}
				snippets={snippets}
				answers={answers('thingsboard-private-cloud')}
				faqPrefix={faqPrefix('thingsboard-private-cloud')}
			/>
			<PricingNote
				icon="tabler:calculator"
				text={mainCopy.upsellNotSure.heading}
				link={{ text: mainCopy.upsellNotSure.cta }}
				calc="pc"
			/>

			<div class="p2-block">
				<SectionHeader
					title={mainCopy.addOns.title}
					subtitle={mainCopy.addOns.subtitle}
					ledeTone="muted"
					align="left"
					spacing="sm"
				/>
				<AddOnCards
					addOns={tbPrivateCloudAddOns}
					answers={answers('thingsboard-private-cloud')}
					faqPrefix={faqPrefix('thingsboard-private-cloud')}
				/>
			</div>

			<div class="p2-block">
				<SectionHeader
					title={mainCopy.comparison.title}
					subtitle={mainCopy.comparison.subtitle}
					ledeTone="muted"
					align="left"
					spacing="sm"
				/>
				<Card role="panel" pad="sm">
					<ProductMatrix
						caption={mainCopy.comparison.caption}
						firstLabel="Feature"
						columns={pcFeatureHeaders.map((name) => ({ name }))}
						rows={pcFeatureRows.map((row) => ({ label: row.feature, values: row.values }))}
						align="center"
					/>
				</Card>
			</div>
		</section>

		{/* ─── FAQ, for the tab on screen ────────────────────────────────────────────────────── */}
		<section class="p2-faq">
			{tabs.map((d) => {
				const faq = faqFor(d.id);
				const prefix = faqPrefix(d.id);
				return (
					<div data-deploy-panel={d.id} data-accent={d.id === 'thingsboard-pe' ? 'onprem' : undefined}>
						<SectionHeader title={faq.title} align="left" spacing="sm" />
						<ProductFaq
							categories={faq.categories}
							visibleCount={FAQ_VISIBLE}
							idPrefix={`faq-${d.id}`}
							itemIdPrefix={prefix}
							label={`${d.name} FAQ topics`}
							analytics
						/>
					</div>
				);
			})}
		</section>
	</div>

	{/* The calculators, as they shipped: each defines its opener on `window` and loads its own script on first use. */}
	<TbPaygCalculator />
	<TbPrivateCloudCalculator />
</BaseLayout>

<script>
	import { mountPricingState } from './_pricing-state';

	declare function gtag(...args: unknown[]): void;
	const report = (event: string, params: Record<string, string>) => {
		if (typeof gtag !== 'undefined') gtag('event', event, params);
	};

	// The On-premises plan buttons: the licence portal, with the visitor's UTM and referral ids from
	// storage, as the page has always sent them; the button's href is the plain address without them.
	const getLicense = (productId: string, planId: string) => {
		let url = `https://license.thingsboard.io/signup?createSubscription=true&productId=${productId}&planId=${planId}`;
		try {
			const utm = JSON.parse(localStorage.getItem('utm') ?? 'null') as Record<string, string> | null;
			if (utm) Object.keys(utm).forEach((key) => (url += `&${key}=${encodeURIComponent(utm[key])}`));
			const fpr = localStorage.getItem('fpr');
			if (fpr) url += `&fpr=${encodeURIComponent(fpr)}`;
		} catch {
			/* malformed storage: the plain address still works */
		}
		report('PriceLink', { event_category: `${productId}/${planId}`, event_label: url });
		window.open(url, '_blank');
	};

	document.addEventListener('click', (e) => {
		const t = e.target as HTMLElement | null;
		if (!t) return;
		const plan = t.closest<HTMLElement>('.plan__cta[data-product-id][data-plan-id]');
		if (plan) {
			e.preventDefault();
			getLicense(plan.dataset.productId!, plan.dataset.planId!);
			return;
		}
		// The notes' buttons and the FAQ answers' "Plan Calculator" links.
		const calc = t.closest<HTMLElement>('[data-open-calc]');
		if (calc) {
			e.preventDefault();
			const open = (window as unknown as Record<string, (() => void) | undefined>)[
				calc.dataset.openCalc === 'pc' ? 'openTbPcCalc' : 'openTbPaygCalc'
			];
			open?.();
		}
	});

	mountPricingState({
		tabs: 'p2-deploy',
		plans: () => document.querySelector('.p2-deploy'),
		// The deployment on screen, for analytics, as the page has always reported it.
		onDeploy: (id) => report('PriceOpen', { event_category: id }),
	});

	/**
	 * A shown tip, kept 12px inside the window: centred on its ⓘ it overruns the edge beside a row's
	 * first or last card. Measured once it is displayed, which `:hover` and `:focus` have already
	 * done by the time these events arrive. On a phone it docks to the screen instead and needs none.
	 */
	function placeTip(tip: Element | null | undefined) {
		const body = tip?.querySelector<HTMLElement>('.tip__body');
		if (!body) return;
		body.style.removeProperty('--tip-dx');
		const r = body.getBoundingClientRect();
		if (!r.width || getComputedStyle(body).position === 'fixed') return;
		const edge = document.documentElement.clientWidth - 12;
		let dx = r.right > edge ? edge - r.right : 0;
		if (r.left + dx < 12) dx = 12 - r.left;
		if (dx) body.style.setProperty('--tip-dx', `${Math.round(dx)}px`);
	}

	document.addEventListener('mouseover', (event) => placeTip((event.target as Element | null)?.closest?.('.tip')));
	document.addEventListener('focusin', (event) => {
		const target = event.target as Element | null;
		placeTip(target?.closest('.tip') ?? target?.querySelector('.tip'));
	});

	document.addEventListener('keydown', (event) => {
		// Escape closes a tooltip held open by focus.
		if (event.key === 'Escape') {
			const active = document.activeElement as HTMLElement | null;
			if (active?.classList.contains('tip__btn')) active.blur();
		}
	});
</script>

<style is:global lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/surface' as *;
	// Which blocks show, by the state on <html>.
	@use './pricing-state';

	// Main's ground: the wave field is fixed behind the page, so the body lets it through in light
	// mode, as the contact page does.
	:root:not([data-theme='dark']) body:has(.p2) {
		background-color: transparent;
	}

	// THE ACCENT is the scheme: brand on the page, `data-accent="onprem"` on On-premises' blocks and
	// its FAQ, so their buttons, marks, checks and tooltips take its green.
	// The field turns over too: the lifted green the On-premises page draws its waves in, since the
	// accent itself all but vanishes at the field's 3.5–10%.
	html[data-deploy='thingsboard-pe'] body .pricing-bg {
		--pricing-wave-color: #{$color-pe-hover};
	}

	.p2 {
		position: relative;
		max-width: calc(960px + #{$spacing-5} * 2);
		margin: 0 auto;
		padding: 0 $spacing-5 $spacing-20;
	}

	.p2-intro {
		padding-top: calc(var(--home-header-h, #{$header-height}) + #{$spacing-10});
		text-align: center;

		@include media-down(md) {
			padding-top: calc(var(--home-header-h, #{$header-height}) + #{$spacing-6});
		}
	}

	.p2-panel {
		margin-top: $spacing-10;
	}

	.p2-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: $spacing-4 $spacing-6;
		margin-bottom: $spacing-6;

		@include media-down(md) {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	// A block after the plans: Add-ons, Top-ups, the comparison, the benefits.
	.p2-block {
		margin-top: $spacing-16;

		@include media-down(md) {
			margin-top: $spacing-12;
		}
	}

	// An ⓘ inside an option, right after its label: the option's own 8px gap halved, so the mark
	// reads as the label's rather than as a third item in the pill. Muted in both states — the
	// pressed option's glyph rule would otherwise colour it, and an accent ⓘ reads as a second control.
	// Its tooltip also opens while the option has focus.
	.ui-seg__opt .tip--inline {
		margin-left: -#{$spacing-1};

		.tip__btn {
			cursor: inherit;
		}

		.tip__btn svg {
			color: inherit;
		}
	}

	// ---------------------------------------------------------------------------------------------
	// THE PLANS. Each card spans five of the grid's rows as a SUBGRID, so name, description, price,
	// button and list sit level across a row whatever the copy. Main's cards do the same with six
	// spacer-padded feature rows; these keep only the real lines.
	// ---------------------------------------------------------------------------------------------
	// FOUR PLANS FIT THE MEASURE: 228px a card at 960, and still 203 at a 900px window, below which
	// they pair up. FIVE DO NOT: 179px at 960, where "100M data points/mo" and its ⓘ break over two
	// lines in three cards of five. So Cloud's grid escapes the measure, centred on it, out to main's
	// 1120 — or to the window, less the page's gutters and a scrollbar's width, when that is
	// narrower. Under 1100 there is no room to escape into, and the five go three and two instead.
	.plan-grid {
		display: grid;
		grid-template-columns: repeat(var(--plan-cols, 4), minmax(0, 1fr));
		column-gap: $spacing-4;
		row-gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;

		@media (min-width: 1100px) {
			&--5 {
				--plan-escape: min(1120px, calc(100vw - #{$spacing-5} * 2 - 16px));
				width: var(--plan-escape);
				margin-inline: calc((100% - var(--plan-escape)) / 2);
			}
		}

		@media (max-width: 1099px) {
			&--5 {
				grid-template-columns: repeat(3, minmax(0, 1fr));
			}
		}

		@media (max-width: 899px) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		@include media-down(md) {
			&,
			&--5 {
				grid-template-columns: minmax(0, 1fr);
			}
		}
	}

	.plan {
		@include surface(tile);

		display: grid;
		grid-row: span 5;
		grid-template-rows: subgrid;
		row-gap: 0;
		align-content: start;
		margin: 0 0 $spacing-4;
		padding: $spacing-5 $spacing-4;

		// The ring carries it; the shadow stays the cards' own, not a coloured glow.
		&--popular {
			box-shadow:
				0 0 0 2px var(--accent-fill),
				var(--elev-tile);
		}

		&__head {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: $spacing-2;
		}

		&__name {
			font-size: $font-size-xl;
			font-weight: $font-weight-bold;
			line-height: 1.3;
			margin: 0;
			color: var(--color-text);
		}

		&__desc {
			@include type-small;
			margin: $spacing-1 0 0;
			color: var(--color-text-secondary);
		}

		&__price {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			gap: 0 $spacing-1;
			margin: $spacing-4 0 0;
		}

		&__amount {
			font-size: $font-size-4xl;
			font-weight: $font-weight-bold;
			line-height: 1.15;
			color: var(--color-text);
			font-variant-numeric: tabular-nums;
		}

		&__period {
			@include type-small;
			color: var(--color-text-secondary);
		}

		.plan__cta {
			margin-top: $spacing-4;
		}

		&__features {
			@include type-small;
			display: flex;
			flex-direction: column;
			gap: $spacing-2;
			margin: $spacing-5 0 0;
			padding: 0;
			list-style: none;
			color: var(--color-text-secondary);

			li {
				display: flex;
				align-items: flex-start;
				gap: $spacing-2;
				margin: 0;
			}

			> li > svg {
				flex: none;
				width: 16px;
				height: 16px;
				margin-top: 3px;
				color: var(--accent-fill);
			}

			// White labeling and the per-device overage: what a plan adds, in the ink.
			.is-highlight {
				color: var(--color-text);
				font-weight: $font-weight-medium;
			}
		}
	}

	// Main's upsell under the cards, as one centred line: a glyph in the ink, the question in the
	// secondary grey, and the product pages' outgoing link ("See plans") in the tab's accent. It was a
	// card with a button, then a line with a button; both weighed as much as a plan. The glyph is
	// the reason the line reads as a note rather than as a caption that lost its card.
	// Inline rather than flex: on a phone it wraps as the sentence it is, the glyph staying with the
	// first word and the link with its chevron, where a flex row dropped the glyph onto a line alone.
	.p2-note {
		@include type-body;
		margin: $spacing-4 0 0;
		color: var(--color-text-secondary);
		text-align: center;
		text-wrap: balance;

		&--spaced {
			margin-top: $spacing-12;
		}

		// 24, the line's own height, so the glyph reads as the line's mark rather than a bullet.
		&__mark {
			width: 24px;
			height: 24px;
			// With the space the markup leaves after it, 8px to the text.
			margin-right: $spacing-1;
			vertical-align: -6px;
			color: var(--color-text);
		}

		// `ui/Link`, set into the sentence: 4 after the question, on the line's own baseline.
		.ui-link {
			margin-left: $spacing-1;
			vertical-align: bottom;
		}
	}

	// ---------------------------------------------------------------------------------------------
	// THE ⓘ. Hover or focus shows it; on a phone it docks to the bottom of the screen instead of
	// hanging off a card's edge.
	// ---------------------------------------------------------------------------------------------
	.tip {
		position: relative;
		display: inline-flex;
		margin-left: $spacing-1;
		vertical-align: -3px;
	}

	.tip__btn {
		display: inline-grid;
		place-items: center;
		width: 16px;
		height: 16px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: none;
		color: rgba(15, 23, 42, 0.42);
		cursor: help;

		svg {
			width: 16px;
			height: 16px;
		}

		&:hover,
		&:focus-visible {
			color: var(--accent-ink);
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 2px;
		}
	}

	.tip__body {
		@include type-small;
		position: absolute;
		bottom: calc(100% + 8px);
		left: 50%;
		z-index: 30;
		display: block;
		width: 260px;
		padding: 10px 12px;
		border-radius: 8px;
		background-color: #17181c;
		box-shadow: 0 8px 24px rgba(16, 24, 40, 0.24);
		color: rgba(255, 255, 255, 0.92);
		font-weight: $font-weight-normal;
		text-align: left;
		white-space: normal;
		// HIDDEN BY `display`, not by visibility: a hidden tip still has a box, and the ones on a row's
		// last card reached up to 80px past the window at tablet widths and scrolled the page sideways.
		// Shown, it is centred on its ⓘ and nudged back inside the window by `--tip-dx` (the page
		// script measures it); `translate` carries the placing so the reveal's `transform` stays free.
		display: none;
		translate: calc(-50% + var(--tip-dx, 0px)) 0;

		// The bridge over the 8px gap, so the pointer can reach a link inside without the tip closing.
		&::after {
			content: '';
			position: absolute;
			top: 100%;
			right: 0;
			left: 0;
			height: 10px;
		}

		a {
			color: var(--accent-light);
			text-decoration: underline;
			text-underline-offset: 2px;
		}

		@include media-down(md) {
			position: fixed;
			right: $spacing-4;
			bottom: $spacing-4;
			left: $spacing-4;
			width: auto;
			translate: none;
		}
	}

	@keyframes tip-in {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
	}

	// The last word and its ⓘ wrap together, so the icon never lands on a line of its own.
	.tip-anchor {
		white-space: nowrap;
	}

	.tip__more {
		margin-left: $spacing-1;
		white-space: nowrap;
	}

	.tip:hover .tip__body,
	.tip:focus-within .tip__body,
	.ui-seg__opt:focus-visible .tip--inline .tip__body {
		display: block;
		animation: tip-in 0.12s ease;

		@media (prefers-reduced-motion: reduce) {
			animation: none;
		}
	}

	// ---------------------------------------------------------------------------------------------
	// ADD-ONS: main's three cards — icon, name, line, price.
	// ---------------------------------------------------------------------------------------------
	.addon-cards {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: $spacing-4;
		margin: 0;
		padding: 0;
		list-style: none;

		@include media-down(lg) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.addon-card {
		@include surface(tile);

		display: flex;
		align-items: flex-start;
		gap: $spacing-4;
		margin: 0;
		padding: $spacing-5;

		&__body {
			min-width: 0;
		}

		&__name {
			@include type-tile;
			margin: 0;
			color: var(--color-text);
		}

		&__desc {
			@include type-small;
			margin: 2px 0 0;
			color: var(--color-text-secondary);
		}

		&__price {
			@include type-small;
			margin: $spacing-2 0 0;
			color: var(--color-text-secondary);

			strong {
				font-weight: $font-weight-bold;
				color: var(--color-text);
			}
		}

		// A priced note ("Pricing based on deployment scale") is a statement, not an amount.
		&__price-note {
			font-weight: $font-weight-medium;
			color: var(--color-text);
		}

		&__fee {
			display: block;
		}
	}

	// ---------------------------------------------------------------------------------------------
	// TOP-UPS: main's two columns of packs, each a row that opens on what it adds.
	// ---------------------------------------------------------------------------------------------
	.topup-cols {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: $spacing-6;
		align-items: start;

		@include media-down(md) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.topup-col__title {
		margin: 0 0 $spacing-3;
		font-size: $font-size-lg;
		font-weight: $font-weight-bold;
		line-height: 1.4;
		color: var(--color-text);
	}

	.topup-col__list {
		display: flex;
		flex-direction: column;
		gap: $spacing-2;
	}

	// A row of a list: the kit's surface, as a region row is.
	.topup {
		@include surface(row);

		summary {
			display: flex;
			align-items: center;
			gap: $spacing-3;
			min-height: 44px;
			padding: 0 $spacing-4;
			cursor: pointer;
			list-style: none;

			&::-webkit-details-marker {
				display: none;
			}

			&:hover .topup__name {
				color: var(--accent-ink);
			}

			&:focus-visible {
				outline: 2px solid var(--focus-ring);
				outline-offset: 2px;
				border-radius: $radius-lg;
			}
		}

		&__name {
			@include type-small-strong;
			flex: 1 1 auto;
			min-width: 0;
			color: var(--color-text);
		}

		&__price {
			@include type-small;
			color: var(--color-text-secondary);
			white-space: nowrap;

			strong {
				font-weight: $font-weight-bold;
				color: var(--color-text);
			}
		}

		&__chevron {
			flex: none;
			width: 18px;
			height: 18px;
			color: var(--color-text-secondary);
			transition: transform 0.15s ease;

			@media (prefers-reduced-motion: reduce) {
				transition: none;
			}
		}

		&[open] .topup__chevron {
			transform: rotate(180deg);
		}

		&__details {
			@include type-small;
			margin: 0;
			padding: 0 $spacing-4 $spacing-3;

			div {
				display: flex;
				justify-content: space-between;
				gap: $spacing-4;
				padding: $spacing-1 0;
			}

			dt {
				color: var(--color-text-secondary);
			}

			dd {
				margin: 0;
				font-weight: $font-weight-medium;
				color: var(--color-text);
				text-align: right;
			}
		}
	}

	// ---------------------------------------------------------------------------------------------
	// PERPETUAL: main's promo card, then its benefits.
	// ---------------------------------------------------------------------------------------------
	.p2-promo {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
		gap: $spacing-6 $spacing-10;

		@include media-down(md) {
			grid-template-columns: minmax(0, 1fr);
		}

		&__lead {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
		}

		&__title {
			@include type-card;
			margin: 0;
			color: var(--color-text);
		}

		&__subtitle {
			@include type-body;
			margin: $spacing-3 0 0;
			font-weight: $font-weight-medium;
			color: var(--color-text);
		}

		&__price {
			@include type-card;
			margin: $spacing-5 0 $spacing-5;
			color: var(--accent-ink);
		}

		&__desc {
			@include type-body;
			margin: 0 0 $spacing-4;
			color: var(--color-text-secondary);
		}
	}

	.p2-checks {
		@include type-body;
		display: flex;
		flex-direction: column;
		gap: $spacing-2;
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--color-text);

		li {
			display: flex;
			align-items: flex-start;
			gap: $spacing-2;
			margin: 0;
		}

		svg {
			flex: none;
			width: 20px;
			height: 20px;
			margin-top: 2px;
			color: var(--accent-fill);
		}
	}

	// ---------------------------------------------------------------------------------------------
	// FAQ: main's topics and answers in `ProductFaq`, the product pages' FAQ. Its colour is the
	// scheme's: the On-premises panel sets `data-accent="onprem"`.
	// ---------------------------------------------------------------------------------------------
	.p2-faq {
		margin-top: $spacing-20;

		@include media-down(md) {
			margin-top: $spacing-12;
		}
	}
</style>
