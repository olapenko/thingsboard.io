---
/**
 * The upsell under a row of plans, as one centred line: a glyph, the question, and a link out of it
 * — or a button that opens one of the calculators. The old page drew each as a card with a button,
 * which under a row of plan cards weighed as much as a plan. The link is `ui/Link`, the button
 * `ui/Button`; the line's rules are the page's (`.p2-note`).
 *
 * Underscore-prefixed so Astro does not make it a route.
 */
import { Icon } from 'astro-icon/components';
import Link from '@components/ui/Link.astro';
import Button from '@components/ui/Button.astro';

interface Props {
	icon: string;
	text: string;
	link: { text: string; href?: string };
	/** A deployment id: the link switches the page's tab rather than leaving it. */
	go?: string;
	/** A calculator to open instead of a link: the subscription one or Private Cloud's. */
	calc?: 'payg' | 'pc';
	/** Set apart from what is above it, where it closes a block rather than following a row of cards. */
	spaced?: boolean;
}

const { icon, text, link, go, calc, spaced = false } = Astro.props;
---

<p class:list={['p2-note', spaced && 'p2-note--spaced']}>
	<Icon name={icon} class="p2-note__mark" aria-hidden="true" />
	<span class="p2-note__text">{text}</span>
	{calc ? (
		<Button variant="tertiary" size="sm" type="button" iconEnd="tabler:calculator" attrs={{ 'data-open-calc': calc }}>
			{link.text}
		</Button>
	) : (
		<Link href={link.href} attrs={{ 'data-deploy-go': go }}>
			{link.text}
		</Link>
	)}
</p>
