---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import NButton from '../components/Landing/NButton.astro';
import PricingBackground from '../components/Pricing/PricingBackground.astro';
---

<BaseLayout
	headerVariant="transparent-hover"
	title="Thank You | Contact Us"
	description="Thank you for getting in touch with ThingsBoard. We will respond as soon as possible."
	noIndex={true}
>
	<PricingBackground />
	<div class="thanks-page">
		<div class="thanks-card">
			<span class="thanks-mark" aria-hidden="true">
				<Icon name="tabler:circle-check" />
			</span>
			<h1 class="thanks-title">Thanks, your message is on its way</h1>
			<p class="thanks-lede">
				Someone from our team will read it and reply to the email address you gave us, as soon as we can.
			</p>
			<div class="thanks-actions">
				<NButton href="/">Back to the homepage</NButton>
				<NButton href="/docs/" variant="outlined">Browse the docs</NButton>
			</div>
		</div>
	</div>
</BaseLayout>

<style lang="scss" is:global>
	// The contact page's ground, the pricing page's wave field: the body lets it through in light mode.
	:root:not([data-theme='dark']) body:has(.thanks-page) {
		background-color: transparent;
	}
</style>

<style lang="scss">
	@use '../styles/variables' as *;

	.thanks-page {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: calc(100svh - var(--sl-nav-height, 72px));
		padding: calc(#{$header-height} + #{$spacing-8}) $spacing-5 $spacing-20;

		@include media-down(md) {
			padding-left: $spacing-4;
			padding-right: $spacing-4;
		}

		:where(p, h1) {
			margin: 0;
		}
	}

	.thanks-card {
		max-width: 560px;
		text-align: center;
	}

	.thanks-mark {
		display: inline-grid;
		place-items: center;
		width: 56px;
		height: 56px;
		margin-bottom: $spacing-6;
		border-radius: 32%;
		color: var(--color-success);
		background: color-mix(in srgb, var(--color-success) 12%, var(--color-bg-surface));

		:global(svg) {
			width: 30px;
			height: 30px;
		}
	}

	.thanks-title {
		@include type-title;
		color: var(--color-text);
		text-wrap: balance;
	}

	.thanks-lede {
		@include type-body;
		max-width: 44ch;
		margin: $spacing-4 auto 0;
		font-size: $font-size-lg;
		line-height: 1.55;
		color: var(--color-text-secondary);

		@include media-down(md) {
			font-size: $font-size-base;
		}
	}

	.thanks-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: $spacing-3;
		margin-top: $spacing-8;
	}
</style>
