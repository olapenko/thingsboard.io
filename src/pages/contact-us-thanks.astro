---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/Landing/PageIntro.astro';
import PricingBackground from '@components/Pricing/PricingBackground.astro';
import Card from '@components/ui/Card.astro';
import Link from '@components/ui/Link.astro';
import LinkCard from '@components/ui/LinkCard.astro';
import Mark from '@components/ui/Mark.astro';

// The form keeps what was sent in this tab's sessionStorage under this key (`ContactForm.astro`),
// never in the URL. Older than an hour, it belongs to an earlier visit and the page stays generic.
const SENT_KEY = 'tb-contact-sent';
const SENT_MAX_AGE_MS = 60 * 60 * 1000;

interface NextLink {
	icon: string;
	title: string;
	line: string;
	href: string;
	/** Opens the header's region dialog instead of the fallback host (`CloudRegionDialog`). */
	cloudAuth?: 'signup';
	/** The one tile in colour, on the step the page leads with: a wash of the brand blue, which is
	 *  ThingsBoard Cloud's in the menu and the Products section. */
	accent?: boolean;
}

const TRY_CLOUD: NextLink = {
	icon: 'tabler:cloud',
	title: 'Try ThingsBoard Cloud',
	line: 'Start free, with nothing to install and no credit card.',
	href: 'https://thingsboard.cloud/signup',
	cloudAuth: 'signup',
	accent: true,
};
const STORIES: NextLink = {
	icon: 'tabler:building-factory-2',
	title: 'Customer stories',
	line: 'How companies across industries use ThingsBoard.',
	href: '/case-studies/',
};
// While the reply is on its way: try the platform, or see who runs it. The same two for everyone.
const NEXT: NextLink[] = [TRY_CLOUD, STORIES];
---

<BaseLayout
	headerVariant="solid-shadow"
	forceLightTheme
	footer="map"
	title="Thank You | Contact Us"
	description="Thank you for getting in touch with ThingsBoard. We will respond as soon as possible."
	noIndex={true}
>
	<PricingBackground />
	<div class="thanks-page">
		<Card as="section" role="panel" pad="xl" class="thanks-card" attrs={{ 'aria-labelledby': 'thanks-title' }}>
			{/* The outcome in the success green, which is the On-premises scheme's fill. */}
			<div class="thanks-intro" data-accent="onprem">
				<Mark size={64} icon="tabler:check" lift class="thanks-mark" />
				<PageIntro
					align="center"
					eyebrow="Message sent"
					title="Thanks, your message is on its way"
					lede="Someone from our team will read it and reply by email as soon as we can."
					ledeMeasure="narrow"
					titleId="thanks-title"
					partAttrs={{ title: { 'data-thanks': 'title' }, subtitle: { 'data-thanks': 'lede' } }}
				/>
			</div>

			<p class="thanks-fix" data-thanks="fix" hidden>
				Wrong address, or forgot something?{' '}
				<Link variant="inline" href="/contact-us/?resend">
					Edit and send again
				</Link>
			</p>
		</Card>

		<section class="thanks-next" aria-labelledby="thanks-next-title">
			<h2 class="thanks-next__title" id="thanks-next-title">
				While you wait
			</h2>
			<ul class="thanks-links">
				{NEXT.map((link) => (
					<LinkCard
						as="li"
						href={link.href}
						title={link.title}
						line={link.line}
						icon={link.icon}
						markFill={link.accent ? 'wash' : 'neutral'}
						linkAttrs={link.cloudAuth ? { 'data-cloud-auth': link.cloudAuth } : {}}
					/>
				))}
			</ul>
		</section>

		<Link class="thanks-home" href="/" dir="back" tone="muted">
			Back to the homepage
		</Link>
	</div>

	{/* Personalises the page from what the form kept for it. Inline and after the content, so it
		   runs while the page is still being parsed: the generic copy is the fallback, not a flash. */}
	<script is:inline define:vars={{ SENT_KEY, SENT_MAX_AGE_MS }}>
		(() => {
			let sent = null;
			try {
				sent = JSON.parse(sessionStorage.getItem(SENT_KEY) || 'null');
			} catch {
				// Storage blocked or the entry unreadable: the page stays generic.
			}
			if (!sent || typeof sent.at !== 'number' || Date.now() - sent.at > SENT_MAX_AGE_MS) return;

			const part = (name) => document.querySelector(`[data-thanks="${name}"]`);

			if (sent.firstName) part('title').textContent = `Thanks, ${sent.firstName}. Your message is on its way.`;

			if (sent.email) {
				// Built as nodes, not markup: the address is the reader's own input.
				const address = document.createElement('strong');
				address.textContent = sent.email;
				part('lede').replaceChildren(
					'Someone from our team will read it and reply to ',
					address,
					' as soon as we can.'
				);
				part('fix').hidden = false;
			}
		})();
	</script>
</BaseLayout>

<style lang="scss" is:global>
	// The contact page's ground, the pricing page's wave field: the body lets it through in light mode.
	:root:not([data-theme='dark']) body:has(.thanks-page) {
		background-color: transparent;
	}
</style>

<style lang="scss">
	@use '../styles/variables' as *;

	.thanks-page {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 1000px;
		margin: 0 auto;
		padding: calc(var(--home-header-h, #{$header-height}) + #{$spacing-12}) $spacing-5 $spacing-20;

		@include media-down(md) {
			padding: calc(var(--home-header-h, #{$header-height}) + #{$spacing-8}) $spacing-4 $spacing-16;
		}

		:where(p, h2, ul) {
			margin: 0;
		}
	}

	// The form's own card (`Card` panel, the xl padding), so the answer sits where the question was
	// asked.
	.thanks-card {
		width: 100%;
		max-width: 620px;
		text-align: center;
	}

	// `Mark` 64, centred above the eyebrow, with the lift it takes on a card. It pops in; the check
	// is the icon set's, so the stroke no longer draws itself after the tile lands.
	.thanks-mark {
		margin-bottom: $spacing-6;
		animation: thanks-pop 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.3) both;

		@media (prefers-reduced-motion: reduce) {
			animation: none;
		}
	}

	@keyframes thanks-pop {
		from {
			transform: scale(0.6);
			opacity: 0;
		}
	}

	// `PageIntro`, centred, with the narrow lede (46ch, the secondary grey, 16 on phones). What the
	// page keeps beyond it: 16 between the title and the lede rather than the header's 20, and a lede
	// that breaks anywhere, so a long address the script writes in cannot overflow the card.
	// Through the header's own classes, one level deeper than its rules, so they win on weight
	// rather than on stylesheet order.
	.thanks-intro {
		:global(.section-header .section-header__title) {
			margin-bottom: $spacing-4;
		}

		:global(.section-header .section-header__subtitle) {
			overflow-wrap: anywhere;
		}

		:global(.section-header__subtitle strong) {
			font-weight: $font-weight-medium;
			color: var(--color-text);
		}
	}

	.thanks-fix {
		@include type-small;
		margin-top: $spacing-6;
		color: var(--color-text-secondary);

		&[hidden] {
			display: none;
		}
	}

	.thanks-next {
		width: 100%;
		margin-top: $spacing-16;

		@include media-down(md) {
			margin-top: $spacing-12;
		}
	}

	.thanks-next__title {
		@include type-card;
		margin-bottom: $spacing-5;
		text-align: center;
		color: var(--color-text);
	}

	// The two next steps are `LinkCard`s: tiles with a 48 mark, the brand wash on the one the page
	// leads with and the neutral grey on the other (option B: colour is kept for the action and the
	// outcome).
	.thanks-links {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: $spacing-4;
		max-width: 820px;
		margin: 0 auto;
		padding: 0;
		list-style: none;

		@include media-down(md) {
			grid-template-columns: minmax(0, 1fr);
			max-width: 620px;
		}
	}

	.thanks-home {
		margin-top: $spacing-10;
	}
</style>
