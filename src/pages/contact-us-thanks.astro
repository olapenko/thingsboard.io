---
// TEMP-INTERNAL-NAV
import InternalNav from '@root/pages/internal/_InternalNav.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import PricingBackground from '../components/Pricing/PricingBackground.astro';

// The form keeps what was sent in this tab's sessionStorage under this key (`ContactForm.astro`),
// never in the URL. Older than an hour, it belongs to an earlier visit and the page stays generic.
const SENT_KEY = 'tb-contact-sent';
const SENT_MAX_AGE_MS = 60 * 60 * 1000;

interface NextLink {
	icon: string;
	title: string;
	line: string;
	href: string;
	external?: boolean;
	/** Opens the header's region dialog instead of the fallback host (`CloudRegionDialog`). */
	cloudAuth?: 'signup';
	/** The one tile in colour: the Cloud product's blue, on the step the page leads with. */
	accent?: boolean;
}

const TRY_CLOUD: NextLink = {
	icon: 'tabler:cloud',
	title: 'Try ThingsBoard Cloud',
	line: 'Start free, with nothing to install and no credit card.',
	href: 'https://thingsboard.cloud/signup',
	cloudAuth: 'signup',
	accent: true,
};
const STORIES: NextLink = {
	icon: 'tabler:building-factory-2',
	title: 'Customer stories',
	line: 'How companies across industries use ThingsBoard.',
	href: '/case-studies/',
};
// While the reply is on its way: try the platform, or see who runs it. The same two for everyone.
const NEXT: NextLink[] = [TRY_CLOUD, STORIES];
---

<BaseLayout
	headerVariant="transparent"
	headerScrolledAtTop
	forceLightTheme
	footer="map"
	title="Thank You | Contact Us"
	description="Thank you for getting in touch with ThingsBoard. We will respond as soon as possible."
	noIndex={true}
>
	<PricingBackground />
	<div class="thanks-page">
		<section class="thanks-card" aria-labelledby="thanks-title">
			<span class="thanks-mark" aria-hidden="true">
				<svg viewBox="0 0 32 32" fill="none">
					<path
						d="M8 16.5l5.5 5.5L24 10.5"
						stroke="currentColor"
						stroke-width="3.5"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</span>
			<p class="thanks-eyebrow">Message sent</p>
			<h1 class="thanks-title" id="thanks-title" data-thanks="title">Thanks, your message is on its way</h1>
			<p class="thanks-lede" data-thanks="lede">
				Someone from our team will read it and reply by email as soon as we can.
			</p>

			<p class="thanks-fix" data-thanks="fix" hidden>
				Wrong address, or forgot something? <a href="/contact-us/?resend">Edit and send again</a>
			</p>
		</section>

		<section class="thanks-next" aria-labelledby="thanks-next-title">
			<h2 class="thanks-next__title" id="thanks-next-title">While you wait</h2>
			<ul class="thanks-links">
				{
					NEXT.map((link) => (
						<li>
							<a
								class="thanks-link"
								href={link.href}
								data-cloud-auth={link.cloudAuth}
								{...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
							>
								<span class:list={['thanks-link__icon', link.accent && 'thanks-link__icon--accent']} aria-hidden="true">
									<Icon name={link.icon} />
								</span>
								<span class="thanks-link__title">
									{link.title}
									<Icon
										name={link.external ? 'tabler:arrow-up-right' : 'tabler:arrow-right'}
										class="thanks-link__arrow"
										aria-hidden="true"
									/>
									{link.external && <span class="thanks-sr"> (opens in a new tab)</span>}
								</span>
								<span class="thanks-link__line">{link.line}</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<a class="thanks-home" href="/">
			<Icon name="tabler:arrow-left" aria-hidden="true" />
			Back to the homepage
		</a>
	</div>

	{
		/* Personalises the page from what the form kept for it. Inline and after the content, so it
		   runs while the page is still being parsed: the generic copy is the fallback, not a flash. */
	}
	<script is:inline define:vars={{ SENT_KEY, SENT_MAX_AGE_MS }}>
		(() => {
			let sent = null;
			try {
				sent = JSON.parse(sessionStorage.getItem(SENT_KEY) || 'null');
			} catch {
				sent = null;
			}
			if (!sent || typeof sent.at !== 'number' || Date.now() - sent.at > SENT_MAX_AGE_MS) return;

			const part = (name) => document.querySelector(`[data-thanks="${name}"]`);

			if (sent.firstName) part('title').textContent = `Thanks, ${sent.firstName}. Your message is on its way.`;

			if (sent.email) {
				// Built as nodes, not markup: the address is the reader's own input.
				const address = document.createElement('strong');
				address.textContent = sent.email;
				part('lede').replaceChildren(
					'Someone from our team will read it and reply to ',
					address,
					' as soon as we can.'
				);
				part('fix').hidden = false;
			}
		})();
	</script>
	{
		/* TEMP-INTERNAL-NAV — remove before this branch reaches main, with the homepage's.
	    The internal switcher, so this page can be reached from the sandbox and back. It is NOT
	    production chrome: the page is shown as it ships, with only the island over it.

	    To remove: `grep -rln TEMP-INTERNAL-NAV src/pages` and delete both hits in each file. */
	}
	<InternalNav />
</BaseLayout>

<style lang="scss" is:global>
	// The homepage's bar, as on the contact page.
	@use '../styles/marketing-bar';

	// The contact page's ground, the pricing page's wave field: the body lets it through in light mode.
	:root:not([data-theme='dark']) body:has(.thanks-page) {
		background-color: transparent;
	}
</style>

<style lang="scss">
	@use '../styles/variables' as *;

	.thanks-page {
		// The panel lift, as on the form's card: a contact line and a soft drop, no edge.
		--thanks-shadow: var(--elev-panel);
		--thanks-shadow-hover:
			0 1px 2px rgba(var(--color-shadow-ui-rgb, 16, 24, 40), 0.08),
			0 22px 44px -18px rgba(var(--color-shadow-ui-rgb, 16, 24, 40), 0.3);

		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 1000px;
		margin: 0 auto;
		padding: calc(var(--home-header-h, #{$header-height}) + #{$spacing-12}) $spacing-5 $spacing-20;

		@include media-down(md) {
			padding: calc(var(--home-header-h, #{$header-height}) + #{$spacing-8}) $spacing-4 $spacing-16;
		}

		:where(p, h1, h2, ul) {
			margin: 0;
		}
	}

	// The form's own card, so the answer sits where the question was asked.
	.thanks-card {
		width: 100%;
		max-width: 620px;
		padding: $spacing-12 $spacing-10;
		text-align: center;
		background: var(--color-bg-surface);
		border-radius: $radius-xl;
		box-shadow: var(--thanks-shadow);

		@include media-down(md) {
			padding: $spacing-8 $spacing-5;
		}
	}

	// The homepage's centred section mark — 64px, a 40px glyph, the 32% squircle — in the success
	// green, with the closing badge's 155deg lift so it isn't a flat chip, and the UI shadow's
	// blue-black ink rather than a green glow. White on the green's darker half is 4.6:1 and up.
	.thanks-mark {
		display: inline-grid;
		place-items: center;
		width: 64px;
		height: 64px;
		margin-bottom: $spacing-6;
		border-radius: 32%;
		color: #fff;
		background: linear-gradient(
			155deg,
			color-mix(in srgb, var(--color-success) 80%, #fff) 0%,
			var(--color-success) 55%,
			color-mix(in srgb, var(--color-success) 88%, #000) 100%
		);
		box-shadow:
			0 1px 2px rgba(var(--color-shadow-ui-rgb, 16, 24, 40), 0.1),
			0 10px 22px -10px rgba(var(--color-shadow-ui-rgb, 16, 24, 40), 0.4);
		animation: thanks-pop 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.3) both;

		svg {
			width: 40px;
			height: 40px;
		}

		path {
			stroke-dasharray: 26;
			stroke-dashoffset: 26;
			animation: thanks-draw 0.35s 0.2s ease-out forwards;
		}

		@media (prefers-reduced-motion: reduce) {
			animation: none;

			path {
				stroke-dashoffset: 0;
				animation: none;
			}
		}
	}

	@keyframes thanks-pop {
		from {
			transform: scale(0.6);
			opacity: 0;
		}
	}

	@keyframes thanks-draw {
		to {
			stroke-dashoffset: 0;
		}
	}

	.thanks-eyebrow {
		@include type-eyebrow;
		margin-bottom: $spacing-3;
		color: var(--color-success);
	}

	.thanks-title {
		@include type-title;
		color: var(--color-text);
		text-wrap: balance;
	}

	.thanks-lede {
		@include type-body;
		max-width: 46ch;
		margin: $spacing-4 auto 0;
		font-size: $font-size-lg;
		line-height: 1.55;
		color: var(--color-text-secondary);
		overflow-wrap: anywhere;

		@include media-down(md) {
			font-size: $font-size-base;
		}

		:global(strong) {
			font-weight: $font-weight-medium;
			color: var(--color-text);
		}
	}

	.thanks-fix {
		@include type-small;
		margin-top: $spacing-6;
		color: var(--color-text-secondary);

		&[hidden] {
			display: none;
		}

		a {
			font-weight: $font-weight-medium;
			color: var(--color-primary);
			text-decoration: underline;
			text-underline-offset: 2px;
		}
	}

	.thanks-next {
		width: 100%;
		margin-top: $spacing-16;

		@include media-down(md) {
			margin-top: $spacing-12;
		}
	}

	.thanks-next__title {
		@include type-card;
		margin-bottom: $spacing-5;
		text-align: center;
		color: var(--color-text);
	}

	.thanks-links {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: $spacing-4;
		max-width: 820px;
		margin: 0 auto;
		padding: 0;
		list-style: none;

		@include media-down(md) {
			grid-template-columns: minmax(0, 1fr);
			max-width: 620px;
		}

		li {
			display: flex;
		}
	}

	.thanks-link {
		display: grid;
		grid-template-columns: auto 1fr;
		grid-template-rows: auto 1fr;
		column-gap: 14px;
		row-gap: 2px;
		width: 100%;
		padding: $spacing-5;
		color: var(--color-text);
		text-decoration: none;
		background: var(--color-bg-surface);
		border-radius: $radius-xl;
		box-shadow: var(--thanks-shadow);
		transition: box-shadow 0.15s ease;

		&:hover,
		&:focus-visible {
			box-shadow: var(--thanks-shadow-hover);
			text-decoration: none;

			.thanks-link__title {
				color: var(--color-primary);
			}

			:global(.thanks-link__arrow) {
				transform: translateX(2px);
			}
		}

		&:focus-visible {
			outline: 2px solid var(--color-primary);
			outline-offset: 2px;
		}
	}

	.thanks-link__icon {
		display: grid;
		place-items: center;
		grid-row: 1 / span 2;
		width: 48px;
		height: 48px;
		border-radius: 32%;
		// Neutral ink (option B): colour on this page is kept for the action and the outcome.
		color: var(--color-text);
		background: color-mix(in srgb, var(--color-text) 6%, var(--color-bg-surface));

		:global(svg) {
			width: 26px;
			height: 26px;
		}
	}

	// The lead step's tile, in the Cloud product's blue — the menu's and the Products section's
	// colour for ThingsBoard Cloud — so the next step reads first without another accent on the page.
	.thanks-link__icon--accent {
		color: var(--color-product-cloud);
		background: color-mix(in srgb, var(--color-product-cloud) 10%, var(--color-bg-surface));
	}

	.thanks-link__title {
		@include type-tile;
		display: inline-flex;
		align-items: center;
		gap: 4px;
		align-self: end;
		transition: color 0.15s ease;

		:global(.thanks-link__arrow) {
			flex: none;
			width: 16px;
			height: 16px;
			transition: transform 0.15s ease;
		}
	}

	.thanks-link__line {
		@include type-small;
		color: var(--color-text-secondary);
	}

	.thanks-home {
		@include type-link;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: $spacing-10;
		color: var(--color-text-secondary);
		text-decoration: none;

		:global(svg) {
			width: 18px;
			height: 18px;
		}

		&:hover {
			color: var(--color-primary);
			text-decoration: underline;
			text-underline-offset: 3px;
		}
	}

	.thanks-sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
</style>
