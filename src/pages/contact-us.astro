---
import BaseLayout from '@layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import ContactForm from '../components/ContactForm.astro';
import PricingBackground from '../components/Pricing/PricingBackground.astro';

// The heading the page opens with, and the two that replace it when a Private Cloud order lands
// here (`?pcorder` from the pricing plans, `?tbmqorder`). The swap runs inline before first paint,
// so the reader never sees the default heading flash by.
const INTRO = {
	eyebrow: 'Contact us',
	title: 'Let’s talk about what you’re building',
	lede: 'Planning a rollout, weighing up Private Cloud, or looking for a partner? Tell us a little about it, and someone from our team will write back by email.',
};
const INTENTS = {
	pcorder: {
		eyebrow: 'Private Cloud',
		title: 'Get your private IoT platform',
		lede: 'A dedicated ThingsBoard cluster, run by us for you. Tell us about your devices, your data and where you’d like it hosted, and we’ll come back with a setup and a quote sized to it.',
	},
	tbmqorder: {
		eyebrow: 'TBMQ Private Cloud',
		title: 'Get your private MQTT broker',
		lede: 'A dedicated TBMQ broker, run by us for you. Tell us about your clients, your message rates and where you’d like it hosted, and we’ll come back with a setup and a quote sized to it.',
	},
};

const ELSEWHERE = [
	{
		icon: 'tabler:lifebuoy',
		lead: 'Already a customer?',
		label: 'Open a ticket in the Support portal',
		href: 'https://thingsboard-portal.atlassian.net/servicedesk/customer/portal/1',
		external: true,
	},
	{
		icon: 'tabler:messages',
		lead: 'Using Community Edition?',
		label: 'Ask the community forum on GitHub',
		href: 'https://github.com/thingsboard/thingsboard/discussions',
		external: true,
	},
	{
		icon: 'tabler:mail',
		lead: 'Prefer email?',
		label: 'info@thingsboard.io',
		href: 'mailto:info@thingsboard.io',
		external: false,
	},
];
---

<BaseLayout
	headerVariant="transparent-hover"
	title="Contact Us"
	description="Talk to the ThingsBoard team about your IoT project — products and pricing, Private Cloud, professional services, training or partnership."
>
	<PricingBackground />
	<div class="contact-page">
		<header class="contact-intro">
			<p class="contact-intro__eyebrow" data-intro="eyebrow">{INTRO.eyebrow}</p>
			<h1 class="contact-intro__title" data-intro="title">{INTRO.title}</h1>
			<p class="contact-intro__lede" data-intro="lede">{INTRO.lede}</p>
		</header>
		<script is:inline define:vars={{ INTENTS }}>
			(() => {
				const params = new URLSearchParams(window.location.search);
				const key = Object.keys(INTENTS).find((k) => params.has(k));
				if (!key) return;
				document.documentElement.dataset.contactIntent = key;
				const root = document.currentScript.previousElementSibling;
				['eyebrow', 'title', 'lede'].forEach((part) => {
					const el = root.querySelector(`[data-intro="${part}"]`);
					if (el) el.textContent = INTENTS[key][part];
				});
			})();
		</script>

		<div class="contact-form-slot">
			<ContactForm />
		</div>

		<aside class="contact-elsewhere" aria-labelledby="contact-elsewhere-title">
			<h2 class="contact-elsewhere__title" id="contact-elsewhere-title">Looking for something else?</h2>
			<ul class="contact-elsewhere__list">
				{
					ELSEWHERE.map((item) => (
						<li class="contact-elsewhere__item">
							<span class="contact-elsewhere__icon" aria-hidden="true">
								<Icon name={item.icon} />
							</span>
							<span class="contact-elsewhere__text">
								<span class="contact-elsewhere__lead">{item.lead}</span>
								<a
									class="contact-elsewhere__link"
									href={item.href}
									{...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
								>
									{item.label}
									{item.external && (
										<Icon name="tabler:arrow-up-right" class="contact-elsewhere__ext" aria-hidden="true" />
									)}
									{item.external && <span class="contact-sr"> (opens in a new tab)</span>}
								</a>
							</span>
						</li>
					))
				}
			</ul>
		</aside>
	</div>
</BaseLayout>

<style lang="scss" is:global>
	// The pricing page's ground: the wave field is fixed behind the page, so the body has to let it
	// through in light mode, as it does there. Dark mode keeps its own ground, as pricing does.
	:root:not([data-theme='dark']) body:has(.contact-page) {
		background-color: transparent;
	}
</style>

<style lang="scss">
	@use '../styles/variables' as *;

	.contact-page {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		grid-template-rows: auto 1fr;
		grid-template-areas:
			'intro form'
			'aside form';
		gap: 0 $spacing-16;
		max-width: 1152px;
		margin: 0 auto;
		padding: calc(#{$header-height} + #{$spacing-12}) $spacing-5 $spacing-24;

		@include media-down(lg) {
			grid-template-columns: minmax(0, 1fr);
			grid-template-rows: none;
			grid-template-areas: 'intro' 'form' 'aside';
			max-width: 680px;
			padding-top: calc(#{$header-height} + #{$spacing-8});
			padding-bottom: $spacing-16;
		}

		@include media-down(md) {
			padding-left: $spacing-4;
			padding-right: $spacing-4;
		}

		:where(p, h1, h2, ul) {
			margin: 0;
		}
	}

	.contact-intro {
		grid-area: intro;
		padding-top: $spacing-6;

		@include media-down(lg) {
			padding-top: 0;
			margin-bottom: $spacing-8;
		}

		&__eyebrow {
			@include type-eyebrow;
			margin-bottom: $spacing-3;
			color: var(--color-primary);
		}

		&__title {
			@include type-title;
			color: var(--color-text);
			text-wrap: balance;
		}

		&__lede {
			@include type-body;
			max-width: 44ch;
			margin-top: $spacing-5;
			font-size: $font-size-lg;
			line-height: 1.55;
			color: var(--color-text-secondary);

			@include media-down(md) {
				font-size: $font-size-base;
			}
		}
	}

	.contact-form-slot {
		grid-area: form;
		min-width: 0;
	}

	.contact-elsewhere {
		grid-area: aside;
		align-self: start;
		margin-top: $spacing-12;
		padding-top: $spacing-8;
		border-top: 1px solid var(--color-border-light);

		@include media-down(lg) {
			margin-top: $spacing-10;
		}

		&__title {
			@include type-tile;
			margin-bottom: $spacing-5;
			color: var(--color-text);
		}

		&__list {
			display: grid;
			gap: $spacing-5;
			padding: 0;
			list-style: none;
		}

		&__item {
			display: flex;
			align-items: flex-start;
			gap: 14px;
		}

		&__icon {
			display: grid;
			place-items: center;
			flex: none;
			width: 40px;
			height: 40px;
			border-radius: 32%;
			color: var(--color-primary);
			background: color-mix(in srgb, var(--color-primary) 9%, var(--color-bg-surface));

			:global(svg) {
				width: 20px;
				height: 20px;
			}
		}

		&__text {
			display: flex;
			flex-direction: column;
			min-width: 0;
		}

		&__lead {
			@include type-small;
			color: var(--color-text-secondary);
		}

		&__link {
			@include type-link;
			display: inline-flex;
			align-items: center;
			gap: 4px;
			width: fit-content;
			color: var(--color-text);
			text-decoration: none;
			overflow-wrap: anywhere;

			&:hover {
				color: var(--color-primary);
				text-decoration: underline;
				text-underline-offset: 3px;
			}

			:global(.contact-elsewhere__ext) {
				flex: none;
				width: 16px;
				height: 16px;
				color: var(--color-text-secondary);
			}

			&:hover :global(.contact-elsewhere__ext) {
				color: inherit;
			}
		}
	}

	.contact-sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
</style>
