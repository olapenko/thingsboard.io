---
import BaseLayout from '@layouts/BaseLayout.astro';
import RegionChoice from '@components/Landing/RegionChoice.astro';
---

<BaseLayout
	forceLightTheme
	title="ThingsBoard choose region"
	description="ThingsBoard is an open-source IoT platform for device management, data collection, processing and visualization for your IoT projects"
	noIndex
>
	<section class="intro">
		<h1>Where should we store your data?</h1>
		<div class="details">
			<p class="margin">Pick a cluster for localized performance and regulatory compliance.</p>
		</div>
		{/* The region dialog's rows, as everywhere else the region is asked. This page is on the old
		    header, which does not mount the dialog, so the rows carry the analytics ids themselves. */}
		<RegionChoice layout="row" flow="signup" gtm class="regions" />
	</section>

	<section class="map-container">
		<object id="map" data="/images/region-map.svg"></object>
	</section>
</BaseLayout>

<script>
	// The map lifts the continent a row leads to while the row is hovered. The map names its two
	// regions for the continent; the rows carry the region's id.
	const MAP_REGION: Record<string, string> = { us: 'north-america', eu: 'europe' };

	document.getElementById('map')!.addEventListener('load', function (this: HTMLObjectElement) {
		const svgDoc = this.contentDocument!;
		const rows = document.querySelectorAll<HTMLElement>('.regions .region-choice__row');

		rows.forEach((row) => {
			const region = () => svgDoc.querySelector('.' + MAP_REGION[row.dataset.region ?? '']);
			row.addEventListener('mouseenter', () => region()?.classList.add('region-selected'));
			row.addEventListener('mouseleave', () => region()?.classList.remove('region-selected'));
		});
	});
</script>

<style lang="scss">
	.intro {
		padding: 40px 30px 55px;
		width: 830px;
		max-width: 100%;
		margin: 0 auto;
		text-align: center;

		@media (max-width: 1279px) {
			padding: 24px 12px 55px;
		}

		@media (max-width: 959px) {
			padding: 16px 24px 48px;
		}

		@media (max-width: 599px) {
			padding: 12px 16px 24px;
		}

		h1 {
			font-size: 48px;
			font-weight: 600;
			line-height: 54px;
			margin-bottom: 24px;

			@media (max-width: 599px) {
				font-size: 32px;
			}
		}

		.details {
			color: #707275;
			margin-bottom: 40px;

			@media (max-width: 599px) {
				margin-bottom: 24px;
			}

			p {
				font-size: 18px;
				line-height: 28px;
				letter-spacing: 0.027px;

				&.margin {
					margin-bottom: 1rem;
				}

				@media (max-width: 599px) {
					font-size: 16px;
					line-height: 24px;
				}
			}
		}

		// The rows on the measure the hub and the dialog give them, centred under the title; their
		// own text reads from the start.
		.regions {
			max-width: 480px;
			margin-inline: auto;
			text-align: start;
		}
	}

	.map-container {
		margin-bottom: 55px;
		padding-left: 0;
		padding-right: 0;

		object {
			display: block;
			width: 90%;
			max-width: 1550px;
			margin: 0 auto;
		}

		@media (max-width: 959px) {
			padding-left: 24px;
			padding-right: 24px;

			object {
				width: 100%;
			}
		}

		@media (max-width: 599px) {
			margin-bottom: 40px;
			padding-left: 16px;
			padding-right: 16px;
		}
	}
</style>
