---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHeader from '@components/Landing/SectionHeader.astro';
import RegionChoice from '@components/Landing/RegionChoice.astro';
import InstallOptions from '@components/Landing/InstallOptions.astro';
import Button from '@components/ui/Button.astro';
import Card from '@components/ui/Card.astro';
import Link from '@components/ui/Link.astro';
import Mark from '@components/ui/Mark.astro';
import { markBySrc } from '@data/marks';
import { installProducts, type InstallProduct } from '@data/installationsHub';

/**
 * The installations hub: every ThingsBoard product with something to install, or nothing to, one
 * SECTION each, in the homepage's idiom (rebuilt 2026-09-27; the copy and the reasoning are in
 * `@data/installationsHub`). A section is the product's mark on its squircle, its name and one
 * line, then the way in on the left and the ways in on the right: Cloud's two regions as sign-up
 * rows, the others' installation guide with their options, each linking to its own guide, and
 * pricing where there is a price.
 *
 * Only the two platforms carry a colour, on their squircle and their button; the ecosystem
 * products keep their own mark on the white tile and a neutral button, as the homepage keeps them.
 */

/**
 * The tile's artwork, from the path the homepage's entries still name: the ThingsBoard logo for
 * the two platforms, the product's own mark for the rest. A path with no mark fails the build
 * rather than drawing an empty tile.
 */
const markOf = (p: InstallProduct) => {
	const name = markBySrc(p.icon);
	if (!name) throw new Error(`installations: no mark in @data/marks for "${p.icon}".`);
	return name === 'thingsboard' ? { logo: name } : { product: name };
};

/** The name with its distinguishing word tinted, as the homepage's product cards set theirs. */
const nameParts = (name: string, highlight?: string) => {
	if (!highlight) return [{ text: name, tint: false }];
	const at = name.indexOf(highlight);
	if (at === -1) throw new Error(`installations: no "${highlight}" in "${name}" to tint.`);
	return [
		{ text: name.slice(0, at), tint: false },
		{ text: highlight, tint: true },
		{ text: name.slice(at + highlight.length), tint: false },
	].filter((part) => part.text);
};

/** The old tabbed page's product ids, each to the section that holds it now (the script resolves them). */
const aliases = Object.fromEntries(installProducts.flatMap((p) => (p.aliases ?? []).map((a) => [a, p.id])));
---

<BaseLayout
	forceLightTheme
	title="Install ThingsBoard"
	description="Get ThingsBoard running: sign up for ThingsBoard Cloud in your region, or install ThingsBoard On-premises, Edge, Trendz and the IoT Gateway from their guides."
>
	<section id="installations" class="install">
		<div class="main-div">
			<SectionHeader
				title="Get ThingsBoard running"
				subtitle="Pick where it runs. Cloud needs nothing installed; everything else has a guide for every way it installs."
				titleSize="title"
				subtitleMeasure="copy"
				level={1}
			/>

			{/* The page's contents: one link per section, the word the section's title tints. Sticky
				    under the header while the sections run in one column (see the style). */}
			<nav
				class="install-nav"
				aria-label="Products on this page"
				data-install-nav
				data-aliases={JSON.stringify(aliases)}
			>
				<ul class="install-nav__list" role="list">
					{installProducts.map((p) => (
						<li>
							<a class="install-nav__link" href={`#${p.id}`} style={`--tab-accent: ${p.badgeFill ?? p.accent}`}>
								{p.navLabel ?? p.nameHighlight ?? p.name}
							</a>
						</li>
					))}
				</ul>
			</nav>

			{installProducts.map((p) => (
				<article
					id={p.id}
					aria-labelledby={`${p.id}-title`}
					class:list={['install__product', p.regions && 'install__product--band']}
					style={p.badgeFill ? `--badge-fill: ${p.badgeFill}` : undefined}
				>
					<div class="install__head">
						{/* A platform's tile is filled with its colour and the logo knocked out white, as the
							    homepage's two product cards draw it; the others keep their own mark on white. 64
							    while the section runs in one column, 72 (the product cards' step) once its two
							    columns sit side by side. */}
						<Mark
							size={{ base: 64, lg: 72 }}
							fill={p.badgeFill ? 'solid' : 'white'}
							accent={p.badgeFill ?? p.accent}
							lift
							{...markOf(p)}
						/>
						<div>
							<p class="install__label">{p.label}</p>
							<h2 class="install__title" id={`${p.id}-title`}>
								{nameParts(p.name, p.nameHighlight).map((part) =>
									part.tint ? <span class="install__title-accent">{part.text}</span> : part.text
								)}
							</h2>
						</div>
					</div>

					<div class="install__grid">
						<div class="install__copy">
							<p class="install__text">{p.description}</p>

							{/* The page's header mounts the region dialog, which carries the analytics ids, so
								    these rows go without them (`gtm`): a page never carries an id twice. */}
							{p.regions && (
								<div class="install__try">
									<p class="install__try-label">Try now</p>
									<RegionChoice layout="row" flow="signup" srSuffix="for ThingsBoard Cloud" class="install__regions" />
								</div>
							)}

							<div class="install__actions">
								{p.primary && (
									<Button
										href={p.primary.href}
										variant={p.badgeFill ? 'primary' : 'secondary'}
										accent={p.badgeFill}
										icon={p.cornerIcon}
										srSuffix={`— ${p.name}`}
									>
										{p.primary.label}
									</Button>
								)}
								{p.links.map((link) => (
									<Link href={link.href} srSuffix={`— ${p.name}`}>
										{link.label}
									</Link>
								))}
							</div>
						</div>

						{p.aside && (
							<Card role="panel" pad="md" class="install__aside">
								<ul class="install__hosts" role="list" aria-label={`${p.aside.title} runs on`}>
									{p.aside.hosts.map((host) => (
										<li class="install__host">
											<Icon name={host.icon} class="install__host-mark" aria-hidden="true" />
											<span class="install__host-sr">{host.name}</span>
										</li>
									))}
								</ul>
								<div class="install__aside-head">
									<Icon name="tabler:cloud-lock" class="install__aside-glyph" aria-hidden="true" />
									<h3 class="install__aside-title">{p.aside.title}</h3>
								</div>
								<p class="install__text">{p.aside.text}</p>
								<div class="install__actions">
									{p.aside.links.map((link) => (
										<Link href={link.href} srSuffix={`— ${p.name}`}>
											{link.label}
										</Link>
									))}
								</div>
							</Card>
						)}

						{p.options && (
							<Card role="panel" pad="md">
								<InstallOptions groups={p.options} />
							</Card>
						)}
					</div>
				</article>
			))}
		</div>
	</section>
</BaseLayout>

<script>
	const nav = document.querySelector<HTMLElement>('[data-install-nav]');
	if (nav) follow(nav);

	/**
	 * The page nav: lights the section being read, keeps its link in view when the row scrolls
	 * sideways, lands a click under the header and the nav, and sends the old tabbed page's
	 * addresses to their sections. Without script the links are plain anchors and land by the
	 * root's `scroll-padding-top`, which the style sizes for the nav.
	 */
	function follow(nav: HTMLElement) {
		const list = nav.querySelector<HTMLElement>('ul');
		const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'));
		const found = links.map((a) => document.getElementById(a.hash.slice(1)));
		if (!list || found.some((s) => !s)) return;
		const sections = found as HTMLElement[];
		const root = document.documentElement;
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
		const behavior = (): ScrollBehavior => (reduce.matches ? 'instant' : 'smooth');

		// `?product=thingsboard-cloud` and `#tab-thingsboard-pe`, the old page's tab addresses, which
		// docs pages still link. Rewritten to the section's own anchor, without a history entry.
		const aliases: Record<string, string> = JSON.parse(nav.dataset.aliases ?? '{}');
		const url = new URL(window.location.href);
		const fromQuery = url.searchParams.get('product');
		const fromHash = url.hash.slice(1);
		const legacy =
			(fromQuery && aliases[fromQuery]) ||
			(fromHash && !document.getElementById(fromHash) && aliases[fromHash.replace(/^tab-/, '')]) ||
			'';
		const landing = legacy ? document.getElementById(legacy) : null;
		if (landing) {
			if (fromQuery && aliases[fromQuery]) url.searchParams.delete('product');
			url.hash = legacy;
			history.replaceState(null, '', url);
			landing.scrollIntoView({ block: 'start', behavior: 'instant' });
			// Again once images and fonts have settled, unless the reader has moved on.
			let moved = false;
			const stop = () => (moved = true);
			['wheel', 'touchstart', 'keydown'].forEach((t) =>
				window.addEventListener(t, stop, { once: true, passive: true })
			);
			window.addEventListener('load', () => moved || landing.scrollIntoView({ block: 'start', behavior: 'instant' }), {
				once: true,
			});
		}

		let current = -1;
		let frame = 0;

		const update = () => {
			frame = 0;
			const pad = parseFloat(getComputedStyle(root).scrollPaddingTop) || 0;
			const sticky = getComputedStyle(nav).position === 'sticky';
			const stuck = sticky && nav.getBoundingClientRect().top <= (parseFloat(getComputedStyle(nav).top) || 0) + 0.5;
			nav.toggleAttribute('data-stuck', stuck);
			root.toggleAttribute('data-install-nav-stuck', stuck);

			// The section being read is the last one whose top has passed a line a quarter of the way
			// into the page under the header; at the very end of the page, the last one, however short.
			const line = pad + (window.innerHeight - pad) * 0.25;
			const atEnd = window.scrollY + window.innerHeight >= root.scrollHeight - 2;
			let next = atEnd ? sections.length - 1 : -1;
			if (!atEnd) sections.forEach((s, i) => s.getBoundingClientRect().top <= line && (next = i));
			if (next === current) return;
			current = next;
			links.forEach((a, i) =>
				i === current ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')
			);

			// The row scrolls sideways on a phone: bring the lit link to its middle.
			const lit = links[current];
			if (lit && list.scrollWidth > list.clientWidth) {
				list.scrollTo({ left: lit.offsetLeft - (list.clientWidth - lit.offsetWidth) / 2, behavior: behavior() });
			}
		};

		const schedule = () => {
			if (!frame) frame = requestAnimationFrame(update);
		};
		window.addEventListener('scroll', schedule, { passive: true });
		window.addEventListener('resize', schedule);
		update();

		// `scrollIntoView` honours the root's `scroll-padding-top`, so the section lands where a plain
		// anchor would, smoothly. The address follows without a history entry per click; focus moves
		// to the section, so the next Tab continues from there.
		nav.addEventListener('click', (event) => {
			const link = (event.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
			const target = link ? document.getElementById(link.hash.slice(1)) : null;
			if (!target) return;
			event.preventDefault();
			target.scrollIntoView({ block: 'start', behavior: behavior() });
			history.replaceState(null, '', `#${target.id}`);
			if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
			target.focus({ preventScroll: true });
		});
	}
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	// The page nav's row: its own height, and what an anchor clears under the header.
	$install-nav-h: 48px;

	// The homepage's ground and measure: a section on white, its content on the 960 the homepage's
	// product grids sit on (`.main-div` at 1000 with 20 of padding).
	.install {
		padding: $spacing-12 0 $spacing-20;
		background: var(--color-bg, #fff);
		// The Cloud band below runs to the viewport's edges through negative margins; clipped here so
		// a classic scrollbar's width never becomes sideways scroll.
		overflow-x: clip;

		// Centred by hand: the homepage's `landing` sheet, which centres every section's
		// `.main-div`, is not loaded on this page.
		.main-div {
			max-width: $page-measure-box;
			margin-inline: auto;
			padding-inline: $spacing-5;
		}
	}

	// ── The page nav ──────────────────────────────────────────────────
	// One link per section under the intro, as an underlined tab row: grey words, the section being
	// read in ink over a 3px rounded bar in that product's colour (asked 2026-10-05): the row is the
	// one place every product shows its hue, while the sections keep it to the two platforms. Links,
	// not ARIA tabs: they go to a place on the page rather than switch a panel.
	//
	// STICKY AT EVERY WIDTH, under the header and the promo strip as it collapses: the page is
	// several screens per product, and the row is the one place that shows what else it holds.
	// Full-bleed, as the Cloud band is, so once stuck it reads as the header's second line rather
	// than a strip floating on the measure. No hairline at any point: stuck, the header's shadow
	// marks its edge; at rest, the Cloud band's own edge is right under it.
	.install-nav {
		position: sticky;
		top: calc(var(--promo-cur, 0px) + var(--home-header-h, 64px));
		// Over the sections scrolling under it (their tiles and panels lift on shadows), under the
		// header's 8888 and the menu that opens from it.
		z-index: 10;
		margin: $spacing-8 calc(50% - 50vw) 0;
		background: var(--color-bg, #fff);
		transition: box-shadow 0.15s ease;

		// Stuck: the header's shadow, which the header gives up meanwhile (below), so the two read as
		// one bar with a second line.
		&[data-stuck] {
			box-shadow: var(--shadow-header);
		}

		@media (prefers-reduced-motion: reduce) {
			transition: none;
		}
	}

	// CENTRED WHEREVER IT FITS, SCROLLING WHERE IT DOES NOT. The row is its own sideways scroller at
	// every width, and the first and last items take the spare room as auto margins: while there is
	// room they centre the row (tablet, desktop, a 375 phone), and when there is none they fall to
	// zero, so the row starts at its padding and scrolls (a 320 phone), rather than centring and
	// cutting off both ends the way `justify-content: center` would. 16 between and at the ends on a
	// phone, which holds all five at 375; 24 between from `md`.
	.install-nav__list {
		position: relative;
		display: flex;
		gap: $spacing-4;
		height: $install-nav-h;
		margin: 0;
		padding: 0 $spacing-4;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		list-style: none;
		scrollbar-width: none;

		&::-webkit-scrollbar {
			display: none;
		}

		@include media-up(md) {
			gap: $spacing-6;
		}

		> li {
			display: flex;
			flex: none;

			&:first-child {
				margin-inline-start: auto;
			}

			&:last-child {
				margin-inline-end: auto;
			}
		}
	}

	// The bar is drawn rather than a border, so it can round its top corners and grow from the
	// middle; the word keeps its weight and only changes ink, so nothing in the row shifts.
	.install-nav__link {
		@include type-small-strong;

		position: relative;
		display: flex;
		align-items: center;
		color: var(--color-text-secondary, #{$color-text-secondary});
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.15s ease;

		&::after {
			content: '';
			position: absolute;
			right: 0;
			bottom: 0;
			left: 0;
			height: 3px;
			border-radius: 3px 3px 0 0;
			background: var(--tab-accent, var(--color-text, #17181c));
			transform: scaleX(0);
			transition: transform 0.2s ease;
		}

		&:hover {
			color: var(--color-text, #17181c);
		}

		&:focus-visible {
			outline: 2px solid var(--tab-accent, var(--color-text, #17181c));
			outline-offset: -2px;
			border-radius: 4px;
		}

		&[aria-current] {
			color: var(--color-text, #17181c);

			&::after {
				transform: scaleX(1);
			}
		}

		@media (prefers-reduced-motion: reduce) {
			transition: none;

			&::after {
				transition: none;
			}
		}
	}

	// An anchor lands its section under the header and the nav: the root's padding is what both a
	// plain anchor and the script's `scrollIntoView` honour. It replaces Starlight's 1.5rem over the
	// header; the sections bring their own top padding.
	:global(:root:has([data-install-nav])) {
		scroll-padding-top: calc(var(--home-header-h, 64px) + #{$install-nav-h});
	}

	:global(:root[data-install-nav-stuck] header.header[data-header-scrolled]) {
		box-shadow: none;
	}

	// Focus moved to a section by a nav click is for the next Tab, not something to draw.
	.install__product:focus {
		outline: none;
	}

	// ── One product, one section ──────────────────────────────────────
	// Sections, not cards: full-width rows on the site's one hairline, the way the page's own
	// content runs.
	.install__product {
		padding: $spacing-10 0;
		border-top: 1px solid var(--color-border);

		&:first-of-type {
			border-top: 0;
			padding-top: $spacing-4;
		}
	}

	// On a phone the gap gives back what the tile gained on the ladder (64 for the 56 it was), so
	// the name starts where it did and "ThingsBoard Cloud" still holds one line at 375.
	.install__head {
		display: flex;
		align-items: center;
		gap: $spacing-5;
		margin-bottom: $spacing-5;

		@include media-down(sm) {
			gap: $spacing-3;
		}
	}

	// The card's label and title, at the section's size: the eyebrow over a 28px name, the
	// distinguishing word in the platform's colour and plain everywhere else.
	.install__label {
		@include type-eyebrow;

		margin: 0 0 $spacing-1;
		color: var(--color-text-secondary, #{$color-text-secondary});
	}

	.install__title {
		@include type-subsection;

		margin: 0;
		color: var(--color-text, #17181c);
	}

	// One unit: "On-premises" never breaks at its hyphen ("ThingsBoard On-" over "premises" at 375).
	.install__title-accent {
		color: var(--badge-fill, inherit);
		white-space: nowrap;
	}

	// The way in on the left, the ways in on the right; one column below `lg`. At a 768 tablet the
	// two columns left the panel 300 wide, and the longest chips ("Building from source",
	// "Docker Linux / macOS") ran out of it; in one column the panel takes the full row and its chips
	// sit several to a line.
	// The way in takes the larger share (13 to 10, asked 2026-09-27 from five to six): 520 of the
	// 920 the gap leaves, which holds a product's button and its two links on one row — 497 for
	// On-premises, the widest set — and the panel of chips beside it wraps without complaint.
	.install__grid {
		display: grid;
		grid-template-columns: minmax(0, 13fr) minmax(0, 10fr);
		gap: $spacing-8 $spacing-10;
		align-items: start;

		@include media-down(lg) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.install__text {
		@include type-body;

		margin: 0;
		max-width: 46ch;
		color: var(--color-text, #17181c);
	}

	// ── The way in ────────────────────────────────────────────────────
	// The product's button and its quiet links on one row: a platform's button in its colour, the
	// others' a neutral outline, so nothing but the two platforms carries a colour on this page.
	.install__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: $spacing-3 $spacing-4;
		margin-top: $spacing-6;
	}

	// ── Cloud's regions ───────────────────────────────────────────────
	// The two regions as the region dialog's rows, set on the page, under "Try now" in the
	// platform's colour: the section's tint is the band below, so the block itself is bare and the
	// white rows on it are the buttons. 480 wide, so the action at a row's end stays near its name.
	.install__try {
		margin-top: $spacing-6;
	}

	.install__try-label {
		@include type-eyebrow;

		margin: 0 0 $spacing-3;
		color: var(--badge-fill);
	}

	.install__regions {
		max-width: 480px;
	}

	// THE CLOUD SECTION IS A BAND (asked 2026-09-26, moved off the Try now block): the platform's
	// tint run full-bleed, 22% at the top-left down to 6% at the bottom-right, the content staying on
	// the measure — the homepage's band idiom, for the one section that is the way in with nothing
	// to install. Its hairline goes, since the band's own edge is the boundary.
	.install__product--band {
		margin-inline: calc(50% - 50vw);
		padding-inline: calc(50vw - 50%);
		border-top: 0;
		background: linear-gradient(
			150deg,
			color-mix(in srgb, var(--badge-fill) 22%, #fff),
			color-mix(in srgb, var(--badge-fill) 6%, #fff)
		);

		&:first-of-type {
			padding-top: $spacing-10;
		}

		+ .install__product {
			border-top: 0;
		}
	}

	// ── Private Cloud, beside Cloud's way in ──────────────────────────
	// EVERY RIGHT COLUMN IS A PANEL — Private Cloud beside Cloud's way in, and the ways in beside
	// every other product's — so the second column reads as its own thing rather than as more of
	// the same column (asked for the aside first, then for the rest). A white Card panel, on the
	// Cloud band too, where it matches the white region rows beside it. At 20 of padding rather than
	// the panel's 32: the 400 column then keeps 360 for chips, which holds the rows the page was set
	// to (AWS beside Azure under On-premises, Trendz Cloud beside Ubuntu Server); at 32 those pairs
	// ran one chip to a line and the page grew by 280px.
	.install__aside-head {
		display: flex;
		align-items: center;
		gap: $spacing-3;
		margin-bottom: $spacing-3;
	}

	// The cloud with a lock, bare, in the platform's colour: a dedicated cluster, yours alone. No
	// tile — the section's tile is the product's, and a second one read as a second product.
	.install__aside-glyph {
		flex: none;
		width: 24px;
		height: 24px;
		color: var(--badge-fill);
	}

	// A step under the card size (asked smaller, 2026-09-27): the tile's own title weight, so the
	// second offering sits under the product's name rather than beside it.
	.install__aside-title {
		@include type-tile;

		margin: 0;
		color: var(--color-text, #17181c);
	}

	.install__aside .install__actions {
		margin-top: $spacing-3;
	}

	// ── Where Private Cloud runs ──────────────────────────────────────
	// The clouds open the panel as its picture: one row of marks in one ink, the muted grey, with no
	// names beside them (screen readers get the names) and linking nowhere — the panel's links are the
	// ways in, and these are a fact about the offering. 32 tall; AWS's mark is a wordmark with its
	// smile under it, so it runs larger to sit at the same visual height as the two glyphs.
	.install__hosts {
		display: flex;
		align-items: center;
		gap: $spacing-6;
		margin: 0 0 $spacing-5;
		padding: 0;
		list-style: none;
	}

	.install__host {
		display: flex;
		color: var(--color-text-secondary, #{$color-text-secondary});
	}

	.install__host-mark {
		flex: none;
		width: 32px;
		height: 32px;
	}

	.install__host-mark[data-icon='simple-icons:amazonwebservices'] {
		width: 48px;
		height: 48px;
		margin-block: -8px;
