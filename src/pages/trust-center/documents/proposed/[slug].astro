---
import DocumentsProposedPage from '@components/TrustCenter/DocumentsProposedPage.astro';
import { LIBRARY } from '@data/trust-center/documents-proposed';

// PROPOSED: a document's own address, the library with its details open (`DocumentsProposedPage`).

export function getStaticPaths() {
	return LIBRARY.map((d) => ({ params: { slug: d.slug } }));
}
---

<DocumentsProposedPage open={Astro.params.slug} />
