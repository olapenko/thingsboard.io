---
import Band from '@components/ui/Band.astro';
import DocumentLibraryProposed from '@components/TrustCenter/DocumentLibraryProposed.astro';
import LibraryCompare from '@components/TrustCenter/LibraryCompare.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';

// PROPOSED: the document library as the review of 2026-10-12 suggests it, beside the current one
// (`/trust-center/documents/`), which it leaves untouched.
---

<TrustCenterLayout
	title="Documents"
	eyebrow="Trust Center"
	lede="Public documents open right away. Add the ones under NDA you need and request them together: we send our mutual NDA, then the documents within two business days."
	description="ThingsBoard's security, compliance and privacy documents: certificates, audit evidence, policies, legal terms and questionnaires."
>
	<LibraryCompare slot="hero" current="proposed" />
	<Band pad={{ top: 'sm', bottom: 'lg' }}>
		<div class="tc-stack">
			<DocumentLibraryProposed />
		</div>
	</Band>
</TrustCenterLayout>
