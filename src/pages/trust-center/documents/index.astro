---
import DocLibrary from '@components/TrustCenter/DocLibrary.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { crumbs } from '@data/trust-center/nav';

/** The document library, as drafted: the filters and one flat list of all the documents. */
---

<TrustCenterLayout
	title="Documents"
	lede="Public documents are available right away. Documents marked NDA are shared within two business days after we sign a mutual NDA."
	crumbs={crumbs('documents')}
	description="ThingsBoard's security and compliance documents: certificates, policies, reports and questionnaires, public or under NDA."
>
	<section class="tc-section" aria-label="Document library">
		<DocLibrary />
	</section>
</TrustCenterLayout>
