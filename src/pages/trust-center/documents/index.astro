---
import Band from '@components/ui/Band.astro';
import DocumentLibrary from '@components/TrustCenter/DocumentLibrary.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
---

<TrustCenterLayout
	title="Documents"
	lede="Public documents are available right away. Documents under NDA are shared within two business days after we sign a mutual NDA: tick the ones you need and request them together."
	description="ThingsBoard's security, compliance and privacy documents: public documents, documents under NDA, and planned questionnaires."
>
	<Band pad={{ top: 'sm', bottom: 'lg' }}>
		<div class="tc-stack">
			<DocumentLibrary />
		</div>
	</Band>
</TrustCenterLayout>
