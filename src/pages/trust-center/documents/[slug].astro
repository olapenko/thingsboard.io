---
import DocumentsPage from '@components/TrustCenter/DocumentsPage.astro';
import { LIBRARY } from '@data/trust-center/library';

// A requested document's own address: the library with it in the request (`DocumentsPage`). An open
// document has none; its page or file is its address.

export function getStaticPaths() {
	return LIBRARY.filter((d) => d.tier !== 'open').map((d) => ({ params: { slug: d.slug } }));
}
---

<DocumentsPage open={Astro.params.slug} />
