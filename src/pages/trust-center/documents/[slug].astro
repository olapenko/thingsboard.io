---
import { Icon } from 'astro-icon/components';
import DataTable from '@components/DataTable.astro';
import Button from '@components/ui/Button.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import {
	ACCESS_ACTION,
	ACCESS_LABEL,
	DOCS_WITH_PAGE,
	docActionHref,
	isOffSite,
	type Access,
	type TcDoc,
} from '@data/trust-center/documents';
import { crumbs } from '@data/trust-center/nav';

/**
 * A document's page, as drafted, for every document that is not a page already: its description,
 * access, category, version and owner, and one action (View, Request via NDA, Request). A link to
 * share: it ends there, with no "Read next" (`next={[]}`) and no list of neighbours, which were the
 * next in the category rather than related; the breadcrumb and the bookend's "Get documents" lead
 * back to the library.
 */

export function getStaticPaths() {
	return DOCS_WITH_PAGE.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}

const { doc } = Astro.props as { doc: TcDoc };
/**
 * The access field's badge, large: the page's one status, so it reads at a glance. The document
 * lists' icons (a globe for public, a lock for NDA), a clock for what is planned; the success green
 * for public, as the hub's "Certified" wears, the site's red for NDA (here only: the lists keep their
 * neutral lock), the ink's tint for planned. The draft's note under it.
 */
const ACCESS_BADGE: Record<Access, { icon: string; tone: 'ok' | 'nda' | 'flat' }> = {
	public: { icon: 'tabler:world', tone: 'ok' },
	nda: { icon: 'tabler:lock', tone: 'nda' },
	pending: { icon: 'tabler:clock', tone: 'flat' },
};
const ACCESS_NOTE: Record<Access, string> = {
	public: '',
	nda: 'Released after a mutual NDA, usually within two business days.',
	pending: 'Not published yet.',
};
const badge = ACCESS_BADGE[doc.access];
const action = docActionHref(doc);
const dead = doc.access === 'public' && !doc.file;
---

<TrustCenterLayout
	title={doc.name}
	lede={doc.description}
	crumbs={crumbs('documents', doc.name)}
	description={doc.description}
	next={[]}
>
	{/* The details at the main measure, the request beside them: what the page is for, in reach. */}
	<section class="tc-section tc-split tc-split--from-lg" aria-label="Document details">
		<DataTable
			caption={`${doc.name}: access, category, version and owner`}
			columns={[{ srLabel: 'Topic' }, { srLabel: 'Details' }]}
			colgroup={false}
			headerHidden
			class="tc-facts"
		>
			<tr>
				<th scope="row">Access</th>
				<td>
					<span class:list={['tc-badge', `tc-badge--${badge.tone}`]}>
						<Icon name={badge.icon} aria-hidden="true" />
						{ACCESS_LABEL[doc.access]}
					</span>
					{ACCESS_NOTE[doc.access] && <p class="tc-badge__note">{ACCESS_NOTE[doc.access]}</p>}
				</td>
			</tr>
			<tr>
				<th scope="row">Category</th>
				<td>{doc.category}</td>
			</tr>
			<tr>
				<th scope="row">Version</th>
				<td>{doc.version}</td>
			</tr>
			<tr>
				<th scope="row">Owner</th>
				<td>{doc.owner}</td>
			</tr>
		</DataTable>
		<div class="tc-aside">
			{dead ? (
				<Button href="#" size="md" attrs={{ 'data-dead': '', 'aria-disabled': 'true' }}>
					{ACCESS_ACTION[doc.access]}
				</Button>
			) : (
				<Button href={action} size="md" external={isOffSite(action)}>
					{ACCESS_ACTION[doc.access]}
				</Button>
			)}
		</div>
	</section>
</TrustCenterLayout>
