---
import Band from '@components/ui/Band.astro';
import Controls from '@components/TrustCenter/Controls.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { DATA_CONTROLS } from '@data/trust-center/controls';

// Data security keeps what is about the data itself; what depends on the deployment points to the
// deployment pages (edit 2). See `@data/trust-center/controls`.
---

<TrustCenterLayout
	title="Data security"
	eyebrow="Security"
	lede="What happens to the data your devices send to the platform, from the moment it arrives until you delete it."
	description="How ThingsBoard protects your data: ownership, encryption in transit, secrets and passwords, and export."
>
	<Band pad={{ top: 'sm', bottom: 'lg' }}>
		<div class="tc-stack">
			<Controls items={DATA_CONTROLS} />
		</div>
	</Band>
</TrustCenterLayout>
