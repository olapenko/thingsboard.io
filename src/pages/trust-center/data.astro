---
import Link from '@components/ui/Link.astro';
import Catalog from '@components/TrustCenter/Catalog.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { CAT_DATA } from '@data/trust-center/catalogs';
import { crumbs, tc } from '@data/trust-center/nav';
---

<TrustCenterLayout
	title="Data security"
	lede="What happens to the data your devices send to the platform, from the moment it arrives until you delete it."
	crumbs={crumbs('data')}
	description="What happens to the data your devices send to ThingsBoard: ownership, isolation, encryption, storage region, backups, retention, export and deletion."
>
	<section class="tc-section" aria-label="Data security">
		<Catalog rows={CAT_DATA} label="Data security controls" />
		<p class="tc-note">
			Related:{' '}
			<Link href={tc('subprocessors')} size="sm">
				Sub-processors
			</Link>{' '}
			·{' '}
			<Link href={tc('cloud')} size="sm">
				Cloud and Private Cloud
			</Link>
		</p>
	</section>
</TrustCenterLayout>
