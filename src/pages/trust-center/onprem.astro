---
import Band from '@components/ui/Band.astro';
import DocRows from '@components/TrustCenter/DocRows.astro';
import Facts from '@components/TrustCenter/Facts.astro';
import ItemList from '@components/TrustCenter/ItemList.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { ONPREM_DOCS, ONPREM_GUIDES } from '@data/trust-center/deployment';
import { link } from '@data/trust-center/html';
import { tc } from '@data/trust-center/nav';

// On-premises. What is built in is a line and a link to the Security page (edit 4); security
// fixes keep the on-premises how-to and link the policy under Dev security (edit 5); the per-product
// note lives on the Deployment hub, under Commitment and responsibility (edit 14).

const FACTS = [
	{
		term: 'You run',
		html: `Infrastructure, network perimeter, OS and database patching, platform upgrades, TLS certificates, backups, high availability and recovery. ${link(`${tc('deployment')}#who-handles-what`, 'Who handles what')}`,
	},
	{
		term: 'Built into the product',
		html: `The same controls as every deployment: ${link(`${tc('security')}#access`, 'Access control')} and ${link(`${tc('security')}#product`, 'Product security')}.`,
	},
	{
		id: 'security-fixes',
		term: 'Security fixes',
		html: `Apply patch releases without downtime, and pin a three-part tag such as 4.2.1-latest to receive hotfixes automatically. ${link(`${tc('security')}#security-fixes`, 'How we ship fixes')}`,
	},
	{
		term: 'Release support',
		html: `For production, use the latest LTS line. ${link(`${tc('security')}#release-support`, 'Support periods')}`,
	},
	{
		id: 'network-requirements',
		term: 'Network requirements',
		html: 'An outbound connection to license.thingsboard.io for the hourly license check. Perpetual licenses can use the offline licensing add-on instead.',
	},
];
---

<TrustCenterLayout
	title="On-premises"
	lede="You run the platform on your own infrastructure and keep full control over it. We are responsible for the product code, security fixes and the guides below. Our certificates cover how we build and support the software; your installation is your own scope."
	description="Security for ThingsBoard on your own infrastructure: what you run, how fixes reach you, network requirements and the configuration guides."
>
	<Band pad={{ top: 'sm', bottom: 'lg' }}>
		<div class="tc-stack">
			<Facts rows={FACTS} />
			<section class="tc-section" id="guides" aria-labelledby="guides-title">
				<h2 class="tc-h2" id="guides-title">
					Security configuration guides
				</h2>
				<ItemList compact items={ONPREM_GUIDES.map((g) => ({ title: g.label, href: g.href }))} />
			</section>
			<section class="tc-section" aria-labelledby="onprem-docs">
				<h2 class="tc-h2" id="onprem-docs">
					Documents
				</h2>
				<DocRows items={ONPREM_DOCS} />
			</section>
		</div>
	</Band>
</TrustCenterLayout>
