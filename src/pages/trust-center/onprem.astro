---
import Band from '@components/ui/Band.astro';
import LibraryDocRows from '@components/TrustCenter/LibraryDocRows.astro';
import Facts from '@components/TrustCenter/Facts.astro';
import ItemList from '@components/TrustCenter/ItemList.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import WhoHandles from '@components/TrustCenter/WhoHandles.astro';
import { ONPREM_GUIDES, ONPREM_RESPONSIBILITY, SUPPORT_TEXT } from '@data/trust-center/deployment';
import { documentsFor, ONPREM_PRODUCT_DOCS } from '@data/trust-center/library';
import { link, mailLink } from '@data/trust-center/html';
import { SECURITY_EMAIL, tc } from '@data/trust-center/nav';

// On-premises, the section's one page. What is built in is a line and a link to the Security page
// (edit 4); security fixes keep the on-premises how-to and link the policy under Dev security
// (edit 5). From the Deployment hub (review of 2026-10-12): Who handles what (after the facts), which
// replaces the "You run" fact, the per-product note under it (edit 14), and support as a fact.
//
// PROPOSED (review of 2026-10-12): the documents are the product-wide library's for on-premises;
// the product documentation the list also held (installation guides, release notes, the license
// server's network requirements) is a list of its own.

const FACTS = [
	{
		term: 'Built into the product',
		html: `The same controls as every deployment: ${link(`${tc('security')}#access`, 'Access control')} and ${link(`${tc('security')}#product`, 'Product security')}.`,
	},
	{
		id: 'security-fixes',
		term: 'Security fixes',
		html: `Apply patch releases without downtime, and pin a three-part tag such as 4.2.1-latest to receive hotfixes automatically. ${link(`${tc('security')}#security-fixes`, 'How we ship fixes')}`,
	},
	{
		term: 'Release support',
		html: `For production, use the latest LTS line. ${link(`${tc('security')}#release-support`, 'Support periods')}`,
	},
	{
		id: 'network-requirements',
		term: 'Network requirements',
		html: 'An outbound connection to license.thingsboard.io for the hourly license check. Perpetual licenses can use the offline licensing add-on instead.',
	},
	{ term: 'Support', html: SUPPORT_TEXT.onprem },
];
---

<TrustCenterLayout
	title="On-premises"
	lede="You run the platform on your own infrastructure and keep full control over it. We are responsible for the product code, security fixes and the guides below. Our certificates cover how we build and support the software; your installation is your own scope."
	description="Security for ThingsBoard on your own infrastructure: what you run, how fixes reach you, network requirements and the configuration guides."
>
	<Band pad={{ top: 'sm', bottom: 'lg' }}>
		<div class="tc-stack">
			<Facts rows={FACTS} />
			<section class="tc-section" id="who-handles-what" aria-labelledby="who-handles-what-title">
				<h2 class="tc-h2" id="who-handles-what-title">
					Who handles what
				</h2>
				<WhoHandles items={ONPREM_RESPONSIBILITY} />
				<p class="tc-copy">
					ThingsBoard Edge, IoT Gateway, TBMQ, Trendz and the mobile apps split responsibility differently. Write to{' '}
					<Fragment set:html={mailLink(SECURITY_EMAIL)} /> for a breakdown by product.
				</p>
			</section>
			<section class="tc-section" id="guides" aria-labelledby="guides-title">
				<h2 class="tc-h2" id="guides-title">
					Security configuration guides
				</h2>
				<ItemList compact items={ONPREM_GUIDES.map((g) => ({ title: g.label, href: g.href }))} />
			</section>
			<section class="tc-section" aria-labelledby="onprem-docs">
				<h2 class="tc-h2" id="onprem-docs">
					Documents
				</h2>
				<LibraryDocRows items={documentsFor('onprem')} deployment="onprem" />
			</section>
			<section class="tc-section" aria-labelledby="onprem-product-docs">
				<h2 class="tc-h2" id="onprem-product-docs">
					Product documentation
				</h2>
				<ItemList
					items={ONPREM_PRODUCT_DOCS.map((d) => ({
						title: d.name,
						actions: [
							d.href
								? { label: 'Open', href: d.href }
								: {
										label: 'Ask for it',
										href: `${tc('contact')}?subject=${d.askSubject}&about=${encodeURIComponent(d.name)}`,
									},
						],
					}))}
				/>
			</section>
		</div>
	</Band>
</TrustCenterLayout>
