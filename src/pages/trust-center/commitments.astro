---
import ProductMatrix from '@components/Landing/ProductMatrix.astro';
import Card from '@components/ui/Card.astro';
import FactTable from '@components/TrustCenter/FactTable.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import {
	COMMITMENTS,
	COMMITMENTS_LEDE,
	CONFIGURE_INTRO,
	CONFIGURE_LIST,
	PER_PRODUCT_NOTE,
	RESPONSIBILITY,
	RESPONSIBILITY_COLUMNS,
} from '@data/trust-center/deployment';
import { crumbs } from '@data/trust-center/nav';

/**
 * Commitment and responsibility, as drafted: our commitments, what ThingsBoard handles in each
 * deployment model (the product pages' comparison table, in the draft's two groups), and what is
 * built for you to configure.
 */
---

<TrustCenterLayout
	title="Commitment and responsibility"
	lede={COMMITMENTS_LEDE}
	crumbs={crumbs('commitments')}
	description="What ThingsBoard commits to, what it handles in ThingsBoard Cloud, Private Cloud and on-premises, and the security controls built for you to configure."
>
	<section class="tc-section" aria-labelledby="commitments-title">
		<h2 class="tc-h3" id="commitments-title">
			Our commitments
		</h2>
		<FactTable caption="Our commitments" rows={COMMITMENTS} />
	</section>

	<section class="tc-section" aria-labelledby="handles-title">
		<h2 class="tc-h3" id="handles-title">
			What ThingsBoard handles
		</h2>
		<ProductMatrix
			caption="What ThingsBoard handles in ThingsBoard Cloud, Private Cloud and on-premises"
			firstLabel="Area"
			columns={RESPONSIBILITY_COLUMNS}
			groups={RESPONSIBILITY}
		/>
	</section>

	<section class="tc-section" aria-labelledby="configure-title">
		<Card role="panel" class="tc-box">
			<h2 class="tc-box__title" id="configure-title">
				Built for you to configure
			</h2>
			<p class="tc-copy tc-copy--muted">{CONFIGURE_INTRO}</p>
			<ul class="tc-box__list">
				{CONFIGURE_LIST.map((item) => (
					<li>{item}</li>
				))}
			</ul>
		</Card>
		<p class="tc-note" set:html={PER_PRODUCT_NOTE} />
	</section>
</TrustCenterLayout>
