---
import { Icon } from 'astro-icon/components';
import ProductMatrix from '@components/Landing/ProductMatrix.astro';
import DocTable from '@components/TrustCenter/DocTable.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import {
	CLOUD_COLUMNS,
	CLOUD_COMPARE,
	CLOUD_DOCS,
	CLOUD_LEDE,
	PRIVATE_CLOUD_DOCS,
	PRIVATE_CLOUD_DOCS_INTRO,
} from '@data/trust-center/deployment';
import { DEPLOYMENT_ICON } from '@data/trust-center/deployment-marks';
import { crumbs } from '@data/trust-center/nav';

/**
 * ThingsBoard Cloud and Private Cloud, as drafted: the comparison, then the documents, one section
 * with a column for each model under its icon (Private Cloud's lists only what differs, and says
 * so). The comparison is the product pages' `ProductMatrix`, which reflows on a phone.
 */
---

<TrustCenterLayout
	title="ThingsBoard Cloud and Private Cloud"
	lede={CLOUD_LEDE}
	crumbs={crumbs('cloud')}
	description="How ThingsBoard runs ThingsBoard Cloud and Private Cloud: hosting, data residency, isolation, encryption, backups, availability, uptime, retention, access and leaving."
>
	<section class="tc-section" aria-label="ThingsBoard Cloud compared with Private Cloud">
		<ProductMatrix
			caption="ThingsBoard Cloud compared with Private Cloud"
			firstLabel="Topic"
			columns={CLOUD_COLUMNS}
			rows={CLOUD_COMPARE}
		/>
	</section>

	<section class="tc-section tc-section--h2" aria-labelledby="cloud-docs-title">
		<h2 class="tc-h2" id="cloud-docs-title">
			Documents
		</h2>
		<div class="tc-doccols">
			<div>
				<h3 class="tc-doccols__title">
					<Icon name={DEPLOYMENT_ICON.cloud} aria-hidden="true" />
					ThingsBoard Cloud
				</h3>
				<DocTable caption="Documents for ThingsBoard Cloud" rows={CLOUD_DOCS} />
			</div>
			<div>
				<h3 class="tc-doccols__title">
					<Icon name={DEPLOYMENT_ICON.private} aria-hidden="true" />
					Private Cloud
				</h3>
				<p class="tc-note tc-doccols__intro">{PRIVATE_CLOUD_DOCS_INTRO}</p>
				<DocTable caption="Documents for Private Cloud" rows={PRIVATE_CLOUD_DOCS} />
			</div>
		</div>
	</section>
</TrustCenterLayout>
