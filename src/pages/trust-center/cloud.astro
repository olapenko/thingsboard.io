---
import ProductMatrix from '@components/Landing/ProductMatrix.astro';
import Link from '@components/ui/Link.astro';
import DocTable from '@components/TrustCenter/DocTable.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import {
	CLOUD_COLUMNS,
	CLOUD_COMPARE,
	CLOUD_DOCS,
	CLOUD_LEDE,
	PRIVATE_CLOUD_DOCS,
	PRIVATE_CLOUD_DOCS_INTRO,
} from '@data/trust-center/deployment';
import { crumbs, tc } from '@data/trust-center/nav';

/**
 * ThingsBoard Cloud and Private Cloud, as drafted: the comparison, then the documents for each. The
 * comparison is the product pages' `ProductMatrix`, which reflows on a phone.
 */
---

<TrustCenterLayout
	title="ThingsBoard Cloud and Private Cloud"
	crumbs={crumbs('cloud')}
	description="How ThingsBoard runs ThingsBoard Cloud and Private Cloud: hosting, data residency, isolation, encryption, backups, availability, uptime, retention, access and leaving."
>
	<Link slot="before-title" href={`${tc()}#deployment`} dir="back" class="tc-back">
		Trust Center
	</Link>
	{/* The draft's lede links to Product security, so the page writes it itself. */}
	<p slot="intro" class="tc-lede" set:html={CLOUD_LEDE} />

	<section class="tc-section" aria-label="ThingsBoard Cloud compared with Private Cloud">
		<ProductMatrix
			caption="ThingsBoard Cloud compared with Private Cloud"
			firstLabel="Topic"
			columns={CLOUD_COLUMNS}
			rows={CLOUD_COMPARE}
		/>
	</section>

	<section class="tc-section" aria-labelledby="cloud-docs-title">
		<h2 class="tc-h3" id="cloud-docs-title">
			Documents for ThingsBoard Cloud
		</h2>
		<DocTable caption="Documents for ThingsBoard Cloud" rows={CLOUD_DOCS} />
	</section>

	<section class="tc-section" aria-labelledby="private-docs-title">
		<h2 class="tc-h3" id="private-docs-title">
			Documents for Private Cloud
		</h2>
		<p class="tc-lead">{PRIVATE_CLOUD_DOCS_INTRO}</p>
		<DocTable caption="Documents for Private Cloud" rows={PRIVATE_CLOUD_DOCS} />
	</section>
</TrustCenterLayout>
