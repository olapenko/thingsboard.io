---
import Band from '@components/ui/Band.astro';
import ProductMatrix from '@components/Landing/ProductMatrix.astro';
import LibraryDocRows from '@components/TrustCenter/LibraryDocRows.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { CLOUD_COLUMNS, CLOUD_ROWS, PROVIDER_CERTIFICATIONS } from '@data/trust-center/deployment';
import { documentsFor } from '@data/trust-center/library';
import { tc } from '@data/trust-center/nav';

// ThingsBoard Cloud and Private Cloud: the home of every deployment fact the overview, the FAQ and
// Data security point to. The comparison is the product pages' `ProductMatrix`, which reflows to
// labelled blocks on a phone rather than scrolling sideways.
//
// PROPOSED (review of 2026-10-12): the documents are the product-wide library's, for Cloud, and for
// Private Cloud only what differs from Cloud (the section's own words).

const cloudDocs = documentsFor('cloud');
const privateOnly = documentsFor('private-cloud').filter((d) => !d.appliesTo.includes('cloud'));
---

<TrustCenterLayout
	title="ThingsBoard Cloud and Private Cloud"
	lede="In both models, ThingsBoard runs the platform and the infrastructure under it. ThingsBoard Cloud is multi-tenant; Private Cloud is a dedicated single-tenant instance in the environment and region you choose."
	description="How ThingsBoard Cloud and Private Cloud host, isolate, back up and protect your data, side by side."
>
	<Band pad={{ top: 'sm', bottom: 'lg' }}>
		<div class="tc-stack">
			<section class="tc-section" aria-labelledby="compare">
				<div class="tc-section__head">
					<h2 class="tc-h2" id="compare">
						Side by side
					</h2>
					<p class="tc-copy">
						In both, you focus on your solution and we take care of running it. Our certifications and everything under{' '}
						<a href={`${tc('security')}#product`}>Product security</a> apply to both.
					</p>
				</div>
				<ProductMatrix
					caption="ThingsBoard Cloud and Private Cloud compared: who runs them, hosting, residency, isolation, network protection, backups, availability, uptime, certifications, retention, access and leaving"
					firstLabel="Topic"
					columns={CLOUD_COLUMNS}
					rows={CLOUD_ROWS}
				/>
				<p class="tc-copy">
					Live status:{' '}
					<a href="https://status.thingsboard.cloud/" target="_blank" rel="noopener noreferrer">
						North America<span class="ui-sr"> (opens in a new tab)</span>
					</a>{' '}
					·{' '}
					<a href="https://status.eu.thingsboard.cloud/" target="_blank" rel="noopener noreferrer">
						EU<span class="ui-sr"> (opens in a new tab)</span>
					</a>
				</p>
				{/* prettier-ignore */}
				<p class="tc-copy">Our hosting providers' own certifications: for ThingsBoard Cloud in <a href={PROVIDER_CERTIFICATIONS.cloud.href} target="_blank" rel="noopener noreferrer">{PROVIDER_CERTIFICATIONS.cloud.label}<span class="ui-sr"> (opens in a new tab)</span></a>; for Private Cloud on {PROVIDER_CERTIFICATIONS.privateCloud.map((p, i, all) => <>{i > 0 && (i === all.length - 1 ? ' or ' : ', ')}<a href={p.href} target="_blank" rel="noopener noreferrer">{p.label}<span class="ui-sr"> (opens in a new tab)</span></a></>)}.</p>
			</section>

			<section class="tc-section" aria-labelledby="cloud-docs">
				<div class="tc-section__head">
					<h2 class="tc-h2" id="cloud-docs">
						Documents for ThingsBoard Cloud
					</h2>
				</div>
				<LibraryDocRows items={cloudDocs} deployment="cloud" />
			</section>

			<section class="tc-section" aria-labelledby="private-docs">
				<div class="tc-section__head">
					<h2 class="tc-h2" id="private-docs">
						Documents for Private Cloud
					</h2>
					<p class="tc-copy">
						Same set as ThingsBoard Cloud, with its own SBOM, privacy terms and DPA, and no tracking. Only the
						differences are listed.
					</p>
				</div>
				<LibraryDocRows items={privateOnly} deployment="private-cloud" />
			</section>
		</div>
	</Band>
</TrustCenterLayout>
