---
import { VERIFICATION } from '@data/trust-center/status';
import Tag from '@components/TrustCenter/Tag.astro';
import Band from '@components/ui/Band.astro';
import Button from '@components/ui/Button.astro';
import Facts from '@components/TrustCenter/Facts.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { link, mailLink } from '@data/trust-center/html';
import { SECURITY_EMAIL, tc } from '@data/trust-center/nav';

const FACTS = [
	{
		term: 'Consumer rights',
		html: `We handle requests to know, delete and correct personal information through the same procedure as ${link(`${tc('compliance/gdpr')}#data-subject-requests`, 'GDPR requests')}. Write to ${mailLink(SECURITY_EMAIL)}.`,
	},
	{ term: 'Sale of data', html: 'We do not sell personal information.' },
];
---

<TrustCenterLayout
	title="CCPA"
	eyebrow="Compliance"
	lede="We meet CCPA requirements through the same privacy program and declare our compliance."
	description="How ThingsBoard meets the CCPA: consumer rights and the sale of personal information."
>
	<div slot="hero" class="tc-hero-tags">
		<Tag tag={VERIFICATION.declared} />
	</div>
	<Band pad={{ top: 'sm', bottom: 'lg' }}>
		<div class="tc-stack">
			<section class="tc-section" aria-label="CCPA">
				<Facts rows={FACTS} />
				<div class="tc-actions-row">
					<Button href={`${tc('contact')}?subject=dsr`} variant="secondary">
						Make a privacy request
					</Button>
				</div>
			</section>
		</div>
	</Band>
</TrustCenterLayout>
