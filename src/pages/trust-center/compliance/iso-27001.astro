---
import { VERIFICATION } from '@data/trust-center/status';
import Tag from '@components/TrustCenter/Tag.astro';
import Band from '@components/ui/Band.astro';
import Button from '@components/ui/Button.astro';
import Facts from '@components/TrustCenter/Facts.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { requestHref } from '@data/trust-center/documents';
import { extLink, link } from '@data/trust-center/html';
import { tc } from '@data/trust-center/nav';
import { CERT_VALIDATOR } from '@data/trust-center/overview';

// ISO/IEC 27001: the home of its dates and number (edit 1). The vendor-assessment row keeps its
// clause reference and links the Compliance page's section for the rest (edit 11).

const FACTS = [
	{ term: 'Status', html: '<b>Certified.</b> Issued 9 September 2026 by Swiss Approval North America.' },
	{ term: 'Registration No', html: '372-02-270-00460' },
	{
		term: 'Validity',
		html: `9 September 2026 – 8 September 2027, within a three-year cycle running to 8 September 2029, with annual surveillance audits. ${extLink(CERT_VALIDATOR, 'Verify the certificate')}.`,
	},
	{
		term: 'Statement of Applicability',
		html: '93 Annex A controls: 91 implemented, 1 implemented partially (A.8.12) and 1 not applicable (A.8.30). Available under NDA.',
	},
	{
		id: 'what-it-covers',
		term: 'What it covers',
		html: "Our management system, meaning how we build, maintain and support the software. It doesn't certify the product itself, and it doesn't cover your own installation.",
	},
	{
		term: 'For your vendor assessment',
		html: `Supplier evidence in your own ISMS (A.5.19–A.5.23). ${link(`${tc('compliance')}#compliant-solution`, 'Using our certificates in your audit')}`,
	},
];
---

<TrustCenterLayout
	title="ISO/IEC 27001:2022"
	eyebrow="Compliance"
	lede="Information security management system, including Amendment 1:2024."
	description="ThingsBoard's ISO/IEC 27001:2022 certificate: registration, validity, Statement of Applicability and scope."
>
	<div slot="hero" class="tc-hero-tags">
		<Tag tag={VERIFICATION.certified} />
	</div>
	<Band pad={{ top: 'sm', bottom: 'lg' }}>
		<div class="tc-stack">
			<section class="tc-section" aria-label="Certificate">
				<Facts rows={FACTS} />
				<div class="tc-actions-row">
					<Button href={requestHref(['statement-of-applicability', 'internal-audit-report-2026'])} variant="secondary">
						Request the SoA and audit report
					</Button>
				</div>
			</section>
		</div>
	</Band>
</TrustCenterLayout>
