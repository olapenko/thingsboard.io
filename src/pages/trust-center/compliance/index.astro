---
import { Icon } from 'astro-icon/components';
import Button from '@components/ui/Button.astro';
import Card from '@components/ui/Card.astro';
import Link from '@components/ui/Link.astro';
import Mark from '@components/ui/Mark.astro';
import CertSeal from '@components/TrustCenter/CertSeal.astro';
import FactTable from '@components/TrustCenter/FactTable.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { AUDIT, CERTS, CERT_DETAILS, COMPLIANCE_LEDE, ISO_CARDS, PRIVACY } from '@data/trust-center/compliance';
import { crumbs } from '@data/trust-center/nav';

/**
 * Compliance, on white with one blue-tinted band (13 Oct 2026; the cards may take a tint later; see
 * `COMPLIANCE_LEDE` in `@data/trust-center/compliance` for what it replaced):
 * 1. The lede: our position in one sentence.
 * 2. Certifications and assurance: the two ISO cards, then the draft's fact table (certification
 *    body, scope, pentest, data centers) with the validator beside it.
 * 3. Using our compliance in your audit, on the band: the guidance with the Statement of
 *    Applicability request under it, and beside it, in the aside, the controls auditors look for.
 * 4. Privacy and data protection, in the certifications' order: GDPR and CCPA as equal cards,
 *    then the commitments both laws share, with why there is no certificate beside them.
 */
---

<TrustCenterLayout
	title="Compliance"
	lede={COMPLIANCE_LEDE}
	crumbs={crumbs('compliance')}
	description="ThingsBoard's ISO/IEC 27001:2022 and ISO 9001:2015 certification, its scope, penetration testing, data centers, GDPR and CCPA, and using our compliance in your own audit."
>
	<section class="tc-section" aria-labelledby="certs-title">
		<div>
			<h2 class="tc-h2" id="certs-title">
				Certifications and assurance
			</h2>
			<div class="tc-certs">
				{ISO_CARDS.map((cert) => (
					<Card role="tile" href={cert.href} title={cert.title} class="tc-cert tc-cert--row">
						<CertSeal slot="mark" number={cert.number ?? cert.mark} size={96} class="tc-cert__seal" />
						<p class="tc-cert__line">{cert.line}</p>
						<span class="tc-cert__status tc-cert__status--line">
							<Icon name="tabler:circle-check-filled" aria-hidden="true" />
							{cert.status}
						</span>
						{cert.registration && <p class="tc-cert__reg">Reg. No {cert.registration}</p>}
						<Link slot="footer" href={cert.href} size="md">
							Learn more
						</Link>
					</Card>
				))}
			</div>
			{/* The details, and beside them the proof: the validator asks for a registration number,
			    which the cards just above carry. */}
			<div class="tc-split tc-compliance__facts">
				<FactTable caption="Certification and assurance details" rows={CERT_DETAILS} />
				<div class="tc-aside">
					<Button href={CERTS.verify.href} variant="secondary" size="md" external>
						{CERTS.verify.label}
					</Button>
					<p class="tc-note">{CERTS.verify.note}</p>
				</div>
			</div>
		</div>
	</section>

	<section class="tc-section tc-section--h2 tc-band tc-band--tint" aria-labelledby="audit-title">
		<div class="tc-band__inner">
			<h2 class="tc-h2" id="audit-title">
				{AUDIT.title}
			</h2>
			<div class="tc-split tc-audit">
				<div>
					<p class="tc-lead">{AUDIT.text}</p>
					<div class="tc-audit__cta">
						<Button href={AUDIT.cta.href} size="md">
							{AUDIT.cta.label}
						</Button>
					</div>
				</div>
				<div class="tc-aside">
					<p class="tc-note">{AUDIT.controlsLead}</p>
					<ul class="tc-tile__list tc-audit__list">
						{AUDIT.controls.map((control) => (
							<li>
								<Icon name="tabler:check" aria-hidden="true" />
								<Link variant="inline" href={control.href}>
									{control.label}
								</Link>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<section class="tc-section tc-section--h2" aria-labelledby="privacy-title">
		<div>
			<h2 class="tc-h2" id="privacy-title">
				{PRIVACY.title}
			</h2>
			<p class="tc-lead">{PRIVACY.lead}</p>
			{/* The laws first, as the certificates open their section; then what we do under both. */}
			<div class="tc-certs tc-certs--laws">
				{PRIVACY.laws.map((law) => (
					<Card role="tile" href={law.href} title={law.title} class="tc-law">
						<Mark slot="mark" size={64} icon={law.icon} accent={law.accent} />
						<p class="tc-law__text">{law.text}</p>
						<Link slot="footer" href={law.href} size="md">
							Learn more
						</Link>
					</Card>
				))}
			</div>
			<div class="tc-split tc-privacy__commitments">
				<ul class="tc-tile__list tc-privacy__list">
					{PRIVACY.commitments.map((point) => (
						<li>
							<Icon name="tabler:check" aria-hidden="true" />
							<span set:html={point} />
						</li>
					))}
				</ul>
				{/* Why there is no certificate, beside what we commit to: the badge says it at a glance, as
				    "Certified" does for the ISO cards, and the note says how. */}
				<div class="tc-aside">
					<span class="tc-badge tc-badge--flat">
						<Icon name="tabler:writing-sign" aria-hidden="true" />
						Self-declared
					</span>
					<p class="tc-note">{PRIVACY.note}</p>
				</div>
			</div>
		</div>
	</section>
</TrustCenterLayout>
