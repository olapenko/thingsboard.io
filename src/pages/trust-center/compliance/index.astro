---
import { Icon } from 'astro-icon/components';
import Card from '@components/ui/Card.astro';
import Link from '@components/ui/Link.astro';
import CertSeal from '@components/TrustCenter/CertSeal.astro';
import FactTable from '@components/TrustCenter/FactTable.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { BUILDING_COMPLIANT, COMPLIANCE_FACTS, ISO_CARDS, PRIVACY } from '@data/trust-center/compliance';
import { crumbs } from '@data/trust-center/nav';

/**
 * Compliance: the draft's "Building a compliant solution" paragraph as the lede (the only text
 * addressed to the reader, and the draft gave this page no lede), its two certificates under the lede
 * (a card each, the seal large beside the words), its facts, then "Privacy and data protection":
 * GDPR as five proven points and CCPA in one line (drafted here; the draft had two thin rows).
 */
---

<TrustCenterLayout
	title="Compliance"
	lede={BUILDING_COMPLIANT.paragraphs[0]}
	crumbs={crumbs('compliance')}
	description="ThingsBoard's ISO/IEC 27001:2022 and ISO 9001:2015 certification, its scope, penetration testing, data centers, and GDPR and CCPA."
>
	{/* The two certificates under the lede: a card each, the seal large on the left, the words on the right. */}
	<div slot="intro" class="tc-certs tc-certs--hero" aria-label="Certificates">
		{ISO_CARDS.map((cert) => (
			<Card role="tile" href={cert.href} title={cert.title} class="tc-cert tc-cert--row">
				<CertSeal slot="mark" number={cert.number ?? cert.mark} size={96} class="tc-cert__seal" />
				<p class="tc-cert__line">{cert.line}</p>
				<span class="tc-seals__badge tc-cert__status">
					<Icon name="tabler:circle-check-filled" aria-hidden="true" />
					{cert.status}
				</span>
				<Link slot="footer" href={cert.href} size="sm">
					Learn more
				</Link>
			</Card>
		))}
	</div>

	<section class="tc-section" aria-label="Certification details">
		<FactTable caption="Certification details" rows={COMPLIANCE_FACTS} />
	</section>

	{/* Privacy and data protection: GDPR as five points, each with the page that proves it, CCPA in one
	    line, and why there is no certificate, said once. Replaces the draft's two thin rows and their
	    "Self-declared" chips (see PRIVACY in `@data/trust-center/compliance`). */}
	<section class="tc-section tc-section--h2" aria-labelledby="privacy-title">
		<h2 class="tc-h2" id="privacy-title">
			{PRIVACY.title}
		</h2>
		<p class="tc-lead">{PRIVACY.lead}</p>
		<div class="tc-privacy">
			<Card role="tile" title={PRIVACY.gdpr.title} titleSize="card" class="tc-privacy__card">
				<ul class="tc-tile__list tc-privacy__list">
					{PRIVACY.gdpr.points.map((point) => (
						<li>
							<Icon name="tabler:check" aria-hidden="true" />
							<span>
								{point.text}{' '}
								<Link variant="inline" href={point.link.href}>
									{point.link.label}
								</Link>
							</span>
						</li>
					))}
				</ul>
			</Card>
			<Card role="tile" title={PRIVACY.ccpa.title} titleSize="card" class="tc-privacy__card">
				<p class="tc-privacy__text">{PRIVACY.ccpa.text}</p>
				<Link slot="footer" href={PRIVACY.ccpa.link.href} size="sm">
					{PRIVACY.ccpa.link.label}
				</Link>
			</Card>
		</div>
		<p class="tc-note">{PRIVACY.note}</p>
	</section>
</TrustCenterLayout>
