---
import { Icon } from 'astro-icon/components';
import Button from '@components/ui/Button.astro';
import Card from '@components/ui/Card.astro';
import Link from '@components/ui/Link.astro';
import CertSeal from '@components/TrustCenter/CertSeal.astro';
import DeclaredMark from '@components/TrustCenter/DeclaredMark.astro';
import FactTable from '@components/TrustCenter/FactTable.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { ASSURANCE_FACTS, AUDIT, CERT_FACTS, COMPLIANCE_LEDE, ISO_CARDS, PRIVACY } from '@data/trust-center/compliance';
import { crumbs } from '@data/trust-center/nav';

/**
 * Compliance, in five parts (the structure of 13 Oct 2026; see `COMPLIANCE_LEDE` in
 * `@data/trust-center/compliance` for what it replaced and how to go back):
 * 1. The lede: our position in one sentence.
 * 2. Certifications: the two ISO cards (the seal large beside the words) and their details.
 * 3. Independent assurance: the yearly pentest and the data centers' attestations.
 * 4. Privacy and data protection: GDPR's five proven points and CCPA's line, each under a flat
 *    "Declared" mark, never a seal; the note on why there is no certificate.
 * 5. Using our compliance in your audit: the guidance, the controls linked to their pages, and the
 *    Statement of Applicability to request.
 */
---

<TrustCenterLayout
	title="Compliance"
	lede={COMPLIANCE_LEDE}
	crumbs={crumbs('compliance')}
	description="ThingsBoard's ISO/IEC 27001:2022 and ISO 9001:2015 certification, its scope, penetration testing, data centers, GDPR and CCPA, and using our compliance in your own audit."
>
	<section class="tc-section" aria-labelledby="certs-title">
		<h2 class="tc-h2" id="certs-title">
			Certifications
		</h2>
		<div class="tc-certs">
			{ISO_CARDS.map((cert) => (
				<Card role="tile" href={cert.href} title={cert.title} class="tc-cert tc-cert--row">
					<CertSeal slot="mark" number={cert.number ?? cert.mark} size={96} class="tc-cert__seal" />
					<p class="tc-cert__line">{cert.line}</p>
					<span class="tc-seals__badge tc-cert__status">
						<Icon name="tabler:circle-check-filled" aria-hidden="true" />
						{cert.status}
					</span>
					<Link slot="footer" href={cert.href} size="sm">
						Learn more
					</Link>
				</Card>
			))}
		</div>
		<FactTable caption="Certification details" rows={CERT_FACTS} class="tc-compliance__facts" />
	</section>

	<section class="tc-section tc-section--h2" aria-labelledby="assurance-title">
		<h2 class="tc-h2" id="assurance-title">
			Independent assurance
		</h2>
		<FactTable caption="Independent assurance" rows={ASSURANCE_FACTS} />
	</section>

	<section class="tc-section tc-section--h2" aria-labelledby="privacy-title">
		<h2 class="tc-h2" id="privacy-title">
			{PRIVACY.title}
		</h2>
		<p class="tc-lead">{PRIVACY.lead}</p>
		<div class="tc-privacy">
			<Card role="tile" title={PRIVACY.gdpr.title} titleSize="card" class="tc-privacy__card">
				<DeclaredMark slot="mark" kind="gdpr" class="tc-privacy__mark" />
				<span class="tc-declared-chip">{PRIVACY.gdpr.status}</span>
				<ul class="tc-tile__list tc-privacy__list">
					{PRIVACY.gdpr.points.map((point) => (
						<li>
							<Icon name="tabler:check" aria-hidden="true" />
							<span>
								{point.text}{' '}
								<Link variant="inline" href={point.link.href}>
									{point.link.label}
								</Link>
							</span>
						</li>
					))}
				</ul>
			</Card>
			<Card role="tile" title={PRIVACY.ccpa.title} titleSize="card" class="tc-privacy__card">
				<DeclaredMark slot="mark" kind="ccpa" class="tc-privacy__mark" />
				<span class="tc-declared-chip">{PRIVACY.ccpa.status}</span>
				<p class="tc-privacy__text">{PRIVACY.ccpa.text}</p>
				<Link slot="footer" href={PRIVACY.ccpa.link.href} size="sm">
					{PRIVACY.ccpa.link.label}
				</Link>
			</Card>
		</div>
		<p class="tc-note">{PRIVACY.note}</p>
	</section>

	<section class="tc-section tc-section--h2" aria-labelledby="audit-title">
		<h2 class="tc-h2" id="audit-title">
			{AUDIT.title}
		</h2>
		<p class="tc-lead">{AUDIT.text}</p>
		<p class="tc-copy tc-audit__lead">{AUDIT.controlsLead}</p>
		<ul class="tc-tile__list tc-audit__list">
			{AUDIT.controls.map((control) => (
				<li>
					<Icon name="tabler:check" aria-hidden="true" />
					<Link variant="inline" href={control.href}>
						{control.label}
					</Link>
				</li>
			))}
		</ul>
		<div class="tc-audit__cta">
			<Button href={AUDIT.cta.href} size="md" variant="secondary" icon="tabler:lock">
				{AUDIT.cta.label}
			</Button>
		</div>
	</section>
</TrustCenterLayout>
