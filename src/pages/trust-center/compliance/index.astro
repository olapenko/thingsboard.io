---
import { Icon } from 'astro-icon/components';
import Card from '@components/ui/Card.astro';
import CardGrid from '@components/ui/CardGrid.astro';
import Mark from '@components/ui/Mark.astro';
import FactTable from '@components/TrustCenter/FactTable.astro';
import StatusChip from '@components/TrustCenter/StatusChip.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { BUILDING_COMPLIANT, COMPLIANCE_FACTS, ISO_CARDS, PRIVACY_CARDS } from '@data/trust-center/compliance';
import { crumbs } from '@data/trust-center/nav';

/**
 * Compliance: the draft's two certificates and its facts, then its privacy pair (GDPR, CCPA) under
 * their own heading, and its "Building a compliant solution" last, as the closing guidance. The
 * draft had the privacy cards inside that box, as the examples ending its second sentence.
 */
---

<TrustCenterLayout
	title="Compliance"
	crumbs={crumbs('compliance')}
	description="ThingsBoard's ISO/IEC 27001:2022 and ISO 9001:2015 certification, its scope, penetration testing, data centers, and GDPR and CCPA."
>
	<section class="tc-section" aria-label="Certificates">
		<CardGrid cols={2}>
			{ISO_CARDS.map((cert) => (
				<Card role="tile" href={cert.href} title={cert.title} class="tc-cert">
					<Mark slot="mark" size={48} icon="tabler:certificate" accent="brand" />
					<p class="tc-cert__line">{cert.line}</p>
					<StatusChip tone="ok" class="tc-cert__status">
						{cert.status}
					</StatusChip>
				</Card>
			))}
		</CardGrid>
	</section>

	<section class="tc-section" aria-label="Certification details">
		<FactTable caption="Certification details" rows={COMPLIANCE_FACTS} />
	</section>

	{/* The draft's privacy cards, as rows: the draft tucked them into the box below as the examples
	    closing its second sentence; here that sentence leads them under their own heading. */}
	<section class="tc-section tc-section--h2" aria-labelledby="privacy-title">
		<h2 class="tc-h2" id="privacy-title">
			Privacy
		</h2>
		<p class="tc-lead">{BUILDING_COMPLIANT.paragraphs[1]}</p>
		<ul class="tc-doclist">
			{PRIVACY_CARDS.map((card) => (
				<li class="tc-doclist__row">
					<a class="tc-doclist__link" href={card.href}>
						<span class="tc-doclist__text">
							<span class="tc-doclist__name">{card.title}</span>
							<span class="tc-doclist__cat">{card.line}</span>
						</span>
						<StatusChip tone="ok">{card.status}</StatusChip>
						<span class="tc-doclist__action">
							Details
							<Icon name="tabler:chevron-right" aria-hidden="true" />
						</span>
					</a>
				</li>
			))}
		</ul>
	</section>

	<section class="tc-section tc-section--h2" aria-labelledby="building-title">
		<h2 class="tc-h2" id="building-title">
			{BUILDING_COMPLIANT.title}
		</h2>
		<p class="tc-copy">{BUILDING_COMPLIANT.paragraphs[0]}</p>
	</section>
</TrustCenterLayout>
