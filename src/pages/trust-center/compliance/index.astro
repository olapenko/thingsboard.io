---
import Band from '@components/ui/Band.astro';
import Button from '@components/ui/Button.astro';
import Mark from '@components/ui/Mark.astro';
import CertSeal from '@components/TrustCenter/CertSeal.astro';
import Facts from '@components/TrustCenter/Facts.astro';
import TcTiles from '@components/TrustCenter/TcTiles.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { requestIn } from '@data/trust-center/library';
import { extLink, link, mailLink } from '@data/trust-center/html';
import { SECURITY_EMAIL, tc } from '@data/trust-center/nav';
import { CERT_VALIDATOR, CERTIFICATES, PRIVACY } from '@data/trust-center/overview';
import { VERIFICATION } from '@data/trust-center/status';

// Compliance: the section's one page (review of 2026-10-12). Its four parts are tiles across the
// hero's foot, as the overview lists its topics: each certificate under its seal, Certified, and each
// regulation under its mark, Self-declared, each a jump to its part. The cards that said the same
// in two bands are gone. Then the parts in two groups: Certifications, what the two certificates
// share stated once (the body, the validity, the scope) and each certificate's own facts under it;
// Building a compliant solution, the audit use of them; and Privacy, GDPR and CCPA. CCPA's requests
// go through GDPR's procedure, so its row links there rather than restating the address, and the
// one request button is GDPR's. Sub-processors is a GDPR row now (it was in the sidebar), and the
// penetration test and the data centers are links in the Related line at the foot (edits 6 and 12).

const CERT_FACTS = [
	{
		term: 'Certification body',
		html: `Swiss Approval North America (IAS-accredited, IAF MLA), with a surveillance audit every year. Verify the certificates at ${extLink(CERT_VALIDATOR, 'swissapproval.ch/certificate-validator')}.`,
	},
	{
		term: 'Validity',
		html: '9 September 2026 – 8 September 2027, within a three-year cycle running to 8 September 2029.',
	},
	{
		term: 'Certified scope',
		html: 'Software design and development, maintenance, training, IT consulting services, support services, integration services; cloud services; software QA testing; software licensing.',
	},
];

const ISO_27001 = [
	{ term: 'Registration No', html: '372-02-270-00460' },
	{
		term: 'Statement of Applicability',
		html: '93 Annex A controls: 91 implemented, 1 implemented partially (A.8.12) and 1 not applicable (A.8.30). Available under NDA.',
	},
	{
		id: 'what-it-covers',
		term: 'What it covers',
		html: "Our management system, meaning how we build, maintain and support the software. It doesn't certify the product itself, and it doesn't cover your own installation.",
	},
	{
		term: 'For your vendor assessment',
		html: `Supplier evidence in your own ISMS (A.5.19–A.5.23). ${link('#compliant-solution', 'Using our certificates in your audit')}`,
	},
];

const ISO_9001 = [
	{ term: 'Registration No', html: '372-02-100-02170 · IAF Code 33' },
	{ term: 'For procurement', html: 'Use it as supplier evidence under clause 8.4 of your own QMS.' },
];

const GDPR = [
	{
		term: 'Scope of application',
		html: 'We apply data minimization and storage limitation to all personal data we process, wherever the person lives.',
	},
	{ term: 'Legal basis', html: 'When we process data on your behalf, the Data Processing Addendum applies.' },
	{
		id: 'data-subject-requests',
		term: 'Data subject requests',
		html: `We handle requests to access, correct or delete data under a documented procedure, and complete erasure requests within 30 days. Write to ${mailLink(SECURITY_EMAIL)}.`,
	},
	{
		term: 'Breach notification',
		html: 'Breaches go through our incident process. We notify affected parties and regulators as the law and our contracts require.',
	},
	{
		term: 'Sub-processors',
		html: `Every vendor that may access customer or personal data passes a security assessment first, and signs a DPA where personal data is involved. ${link(tc('subprocessors'), 'The list of sub-processors')}`,
	},
];

const CCPA = [
	{
		term: 'Consumer rights',
		html: `We handle requests to know, delete and correct personal information through the same procedure as ${link('#data-subject-requests', 'GDPR requests')}.`,
	},
	{ term: 'Sale of data', html: 'We do not sell personal information.' },
];

const [iso27001, iso9001] = CERTIFICATES;
const [gdpr, ccpa] = PRIVACY;

const TILES = [
	...CERTIFICATES.map((c) => ({
		title: c.title,
		subtitle: c.subtitle,
		href: `#${c.href.split('#')[1]}`,
		seal: c.number,
		tag: VERIFICATION.certified,
	})),
	...PRIVACY.map((p) => ({
		title: p.title,
		subtitle: p.subtitle,
		href: `#${p.href.split('#')[1]}`,
		icon: p.icon,
		hue: p.accent,
		tag: VERIFICATION.declared,
	})),
];
---

<TrustCenterLayout
	title="Compliance"
	lede="Independent certification of how we build and run ThingsBoard, and how we meet privacy law."
	description="ThingsBoard's ISO/IEC 27001 and ISO 9001 certifications, their scope and verification, and how we meet GDPR and CCPA."
>
	<TcTiles slot="heroFoot" kind="contents" label="On this page" items={TILES} />

	<Band pad="lg" labelledby="certifications-title">
		<div class="tc-stack">
			<section class="tc-section" id="certifications">
				<div class="tc-section__head">
					<h2 class="tc-h2" id="certifications-title">
						Certifications
					</h2>
					<p class="tc-copy">What the two certificates share: who issued them, for how long and for what.</p>
				</div>
				<Facts rows={CERT_FACTS} />
			</section>

			<section class="tc-section" id="iso-27001" aria-labelledby="iso-27001-title">
				<div class="tc-mark-head">
					<CertSeal number={iso27001.number} size={48} />
					<div class="tc-mark-head__text">
						<h3 class="tc-h3" id="iso-27001-title">
							{iso27001.title}
						</h3>
						<p class="tc-copy">Information security management system, including Amendment 1:2024.</p>
					</div>
				</div>
				<Facts rows={ISO_27001} />
				<div class="tc-actions-row">
					<Button href={requestIn(['statement-of-applicability', 'internal-audit-report-2026'])} variant="secondary">
						Request the SoA and audit report
					</Button>
				</div>
			</section>

			<section class="tc-section" id="iso-9001" aria-labelledby="iso-9001-title">
				<div class="tc-mark-head">
					<CertSeal number={iso9001.number} size={48} />
					<div class="tc-mark-head__text">
						<h3 class="tc-h3" id="iso-9001-title">
							{iso9001.title}
						</h3>
						<p class="tc-copy">
							Quality management system, run as one integrated system together with information security.
						</p>
					</div>
				</div>
				<Facts rows={ISO_9001} />
			</section>
		</div>
	</Band>

	<Band ground="tint" pad="lg" labelledby="compliant-solution-title">
		<div class="tc-section" id="compliant-solution">
			<h2 class="tc-h2" id="compliant-solution-title">
				Building a compliant solution on ThingsBoard
			</h2>
			<p class="tc-copy">
				You can certify the solution you build on ThingsBoard, for example to ISO/IEC 27001. Our ISO certificates count
				as supplier evidence in your audit, and under NDA we share the Statement of Applicability and audit reports. The
				platform gives you the controls auditors look for: access control, an audit log, encryption in transit and a
				choice of data region, so you don't need to build them from scratch.
			</p>
		</div>
	</Band>

	<Band pad="lg" labelledby="privacy-title">
		<div class="tc-stack">
			<div class="tc-section__head" id="privacy">
				<h2 class="tc-h2" id="privacy-title">
					Privacy
				</h2>
				<p class="tc-copy">
					We meet privacy regulations through our own data protection program and declare our compliance.
				</p>
			</div>

			<section class="tc-section" id="gdpr" aria-labelledby="gdpr-title">
				<div class="tc-mark-head">
					<Mark size={48} icon={gdpr.icon} accent={gdpr.accent} fill="solid" />
					<div class="tc-mark-head__text">
						<h3 class="tc-h3" id="gdpr-title">
							{gdpr.title}
						</h3>
						<p class="tc-copy">{gdpr.subtitle}.</p>
					</div>
				</div>
				<Facts rows={GDPR} />
				<div class="tc-actions-row">
					<Button href={`${tc('contact')}?subject=dsr`} variant="secondary">
						Make a data subject request
					</Button>
				</div>
			</section>

			<section class="tc-section" id="ccpa" aria-labelledby="ccpa-title">
				<div class="tc-mark-head">
					<Mark size={48} icon={ccpa.icon} accent={ccpa.accent} fill="solid" />
					<div class="tc-mark-head__text">
						<h3 class="tc-h3" id="ccpa-title">
							{ccpa.title}
						</h3>
						<p class="tc-copy">{ccpa.subtitle}.</p>
					</div>
				</div>
				<Facts rows={CCPA} />
			</section>

			<p class="tc-copy">
				Related: <a href="/products/paas/dpa/">Data Processing Addendum</a> ·{' '}
				<a href="/products/paas/privacy-policy/">Privacy Policy</a> ·{' '}
				<a href={`${tc('security')}#penetration-testing`}>Penetration testing</a> ·{' '}
				<a href={tc('cloud')}>Data center certifications</a>
			</p>
		</div>
	</Band>
</TrustCenterLayout>
