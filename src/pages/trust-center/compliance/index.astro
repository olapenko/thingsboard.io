---
import Band from '@components/ui/Band.astro';
import CardGrid from '@components/ui/CardGrid.astro';
import Link from '@components/ui/Link.astro';
import Mark from '@components/ui/Mark.astro';
import CertSeal from '@components/TrustCenter/CertSeal.astro';
import Facts from '@components/TrustCenter/Facts.astro';
import TcCard from '@components/TrustCenter/TcCard.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { extLink, link } from '@data/trust-center/html';
import { tc } from '@data/trust-center/nav';
import { CERT_VALIDATOR, CERTIFICATES, PRIVACY } from '@data/trust-center/overview';
import { VERIFICATION } from '@data/trust-center/status';

// Compliance. The certificates open the page on a tint, verified; the certification body's row names the
// issuer and how to verify, not the dates (each ISO page has its own, edit 1); the pentest and the
// data centers are a line and a link each (edits 6 and 12). GDPR and CCPA are cards on the tint,
// marked as declared, not certified.

const FACTS = [
	{
		term: 'Certification body',
		html: `Swiss Approval North America (IAS-accredited, IAF MLA), with a surveillance audit every year. Verify the certificates at ${extLink(CERT_VALIDATOR, 'swissapproval.ch/certificate-validator')}.`,
	},
	{
		term: 'Certified scope',
		html: 'Software design and development, maintenance, training, IT consulting services, support services, integration services; cloud services; software QA testing; software licensing.',
	},
	{
		term: 'Penetration testing',
		html: `An independent test every year. ${link(`${tc('appsec')}#penetration-testing`, 'The latest test')}`,
	},
	{
		term: 'Data centers',
		html: `ThingsBoard Cloud and Private Cloud run in certified data centers. ${link(tc('cloud'), 'Certifications by deployment')}`,
	},
];
---

<TrustCenterLayout
	title="Compliance"
	lede="Independent certification of how we build and run ThingsBoard, and how we meet privacy law."
	description="ThingsBoard's ISO/IEC 27001 and ISO 9001 certifications, their scope and verification, and how we meet GDPR and CCPA."
>
	<Band ground="tint" pad={{ top: 'md', bottom: 'lg' }}>
		<div class="tc-section">
			<CardGrid cols={2}>
				{CERTIFICATES.map((cert) => (
					<TcCard layout="row" href={cert.href} title={cert.title} text={cert.subtitle} tag={VERIFICATION.certified}>
						<CertSeal slot="lead" number={cert.number} />
					</TcCard>
				))}
			</CardGrid>
			<Link href={CERT_VALIDATOR} size="sm" external>
				Verify the certificates
			</Link>
		</div>
	</Band>

	<Band pad="lg">
		<Facts rows={FACTS} />
	</Band>

	<Band ground="tint" pad="lg" labelledby="compliant-solution">
		<div class="tc-section" id="compliant-solution">
			<div class="tc-section__head">
				<h2 class="tc-h2" id="compliant-solution-title">
					Building a compliant solution on ThingsBoard
				</h2>
				<p class="tc-copy">
					You can certify the solution you build on ThingsBoard, for example to ISO/IEC 27001. Our ISO certificates
					count as supplier evidence in your audit, and under NDA we share the Statement of Applicability and audit
					reports. The platform gives you the controls auditors look for: access control, an audit log, encryption in
					transit and a choice of data region, so you don't need to build them from scratch.
				</p>
				<p class="tc-copy">
					We meet privacy regulations through our own data protection program and declare our compliance, for example:
				</p>
			</div>
			<CardGrid cols={2}>
				{PRIVACY.map((item) => (
					<TcCard layout="row" href={item.href} title={item.title} text={item.subtitle} tag={VERIFICATION.declared}>
						<Mark slot="lead" size={48} icon={item.icon} accent={item.accent} fill="solid" />
					</TcCard>
				))}
			</CardGrid>
		</div>
	</Band>
</TrustCenterLayout>
