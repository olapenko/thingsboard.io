---
import Band from '@components/ui/Band.astro';
import Mark from '@components/ui/Mark.astro';
import Controls from '@components/TrustCenter/Controls.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { HUES } from '@data/trust-center/nav';
import { SECURITY_TOPICS } from '@data/trust-center/overview';

// Security: the section's one page. Its four topics were pages of their own (Product, Data, Access,
// Dev); each is a band now, white and tint in turn, anchored and listed "On this page": the topic's
// mark and h2, the line that was its page's lede, its controls (h3 under the h2) and the note the
// page closed on. Data security keeps what is about the data itself (edit 2; `@data/trust-center/controls`).
---

<TrustCenterLayout
	title="Security"
	lede="How the platform protects device connections, your data and your users, and how we build and release the software you run."
	description="ThingsBoard security: product security, data security, access control and how we develop and release the platform."
	anchors={SECURITY_TOPICS.map((topic) => ({ label: topic.title, href: `#${topic.id}` }))}
>
	{SECURITY_TOPICS.map((topic, i) => (
		<Band
			ground={i % 2 ? 'tint' : 'flat'}
			pad={i === 0 ? { top: 'md', bottom: 'lg' } : 'lg'}
			labelledby={`${topic.id}-title`}
		>
			<div class="tc-section" id={topic.id}>
				<div class="tc-mark-head">
					<Mark size={48} icon={topic.icon} accent={HUES.blue} fill="solid" />
					<div class="tc-mark-head__text">
						<h2 class="tc-h2" id={`${topic.id}-title`}>
							{topic.title}
						</h2>
						<p class="tc-copy">{topic.lede}</p>
					</div>
				</div>
				<Controls items={topic.controls} level={3} />
				{topic.note && <p class="tc-copy" set:html={topic.note} />}
			</div>
		</Band>
	))}
</TrustCenterLayout>
