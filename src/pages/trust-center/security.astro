---
import { Icon } from 'astro-icon/components';
import Band from '@components/ui/Band.astro';
import Mark from '@components/ui/Mark.astro';
import Controls from '@components/TrustCenter/Controls.astro';
import TcTiles from '@components/TrustCenter/TcTiles.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { SECURITY_TOPICS } from '@data/trust-center/overview';

// Security: the section's one page. Its four topics were pages of their own (Product, Data, Access,
// Dev); each is a band now, white and tint in turn: the topic's mark and h2, the line that was its
// page's lede, its controls (h3 under the h2) and the note the page closed on. Data security keeps
// what is about the data itself (edit 2; `@data/trust-center/controls`). The four are tiles across
// the hero's foot, as the overview lists its topics, each a jump to its band. Access control closes
// on what is yours to configure, from the Deployment hub (review of 2026-10-12).
---

<TrustCenterLayout
	title="Security"
	lede="How the platform protects device connections, your data and your users, and how we build and release the software you run."
	description="ThingsBoard security: product security, data security, access control and how we develop and release the platform."
>
	<TcTiles
		slot="heroFoot"
		kind="contents"
		label="On this page"
		items={SECURITY_TOPICS.map((topic) => ({
			title: topic.title,
			subtitle: topic.subtitle,
			href: `#${topic.id}`,
			hue: topic.hue,
			icon: topic.icon,
		}))}
	/>
	{SECURITY_TOPICS.map((topic, i) => (
		<Band ground={i % 2 ? 'tint' : 'flat'} pad="lg" labelledby={`${topic.id}-title`}>
			<div class="tc-section" id={topic.id}>
				<div class="tc-mark-head">
					<Mark size={48} icon={topic.icon} accent={topic.hue} fill="solid" />
					<div class="tc-mark-head__text">
						<h2 class="tc-h2" id={`${topic.id}-title`}>
							{topic.title}
						</h2>
						<p class="tc-copy">{topic.lede}</p>
					</div>
				</div>
				<Controls items={topic.controls} level={3} />
				{topic.note && <p class="tc-copy" set:html={topic.note} />}
				{topic.checks && (
					<div class="tc-section" id={topic.checks.id}>
						<div class="tc-section__head">
							<h3 class="tc-h3">{topic.checks.title}</h3>
							<p class="tc-copy">{topic.checks.lede}</p>
						</div>
						<ul class="tc-checks">
							{topic.checks.items.map((item) => (
								<li>
									<Icon name="tabler:check" aria-hidden="true" />
									{item}
								</li>
							))}
						</ul>
					</div>
				)}
			</div>
		</Band>
	))}
</TrustCenterLayout>
