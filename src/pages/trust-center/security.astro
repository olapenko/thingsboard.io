---
import { Icon } from 'astro-icon/components';
import Band from '@components/ui/Band.astro';
import Mark from '@components/ui/Mark.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { HUES } from '@data/trust-center/nav';
import { SECURITY_TOPICS } from '@data/trust-center/overview';

// The Security hub (build v3; a plain label until then): its four pages, each with what it covers,
// from the draft's tiles. The tab lands here, and the pills in the hero go on to each page.
---

<TrustCenterLayout
	title="Security"
	lede="How the platform protects device connections, your data and your users, and how we build and release the software you run."
	description="ThingsBoard security: product security, data security, access control and how we develop and release the platform."
>
	<Band pad={{ top: 'md', bottom: 'lg' }}>
		<ul class="tc-topics">
			{SECURITY_TOPICS.map((topic) => (
				<li class="tc-topic">
					<Mark size={48} icon={topic.icon} accent={HUES.blue} fill="solid" />
					<div class="tc-topic__body">
						<h2 class="tc-topic__title">
							<a href={topic.href}>{topic.title}</a>
						</h2>
						<p class="tc-topic__sub">{topic.subtitle}</p>
						<ul class="tc-topic__points">
							{topic.points.map((point) => (
								<li>
									<Icon name="tabler:check" aria-hidden="true" />
									{point}
								</li>
							))}
						</ul>
					</div>
				</li>
			))}
		</ul>
	</Band>
</TrustCenterLayout>
