---
import { Icon } from 'astro-icon/components';
import Band from '@components/ui/Band.astro';
import Button from '@components/ui/Button.astro';
import Card from '@components/ui/Card.astro';
import CardGrid from '@components/ui/CardGrid.astro';
import Link from '@components/ui/Link.astro';
import Mark from '@components/ui/Mark.astro';
import ProductFaq from '@components/Landing/ProductFaq.astro';
import ItemList from '@components/TrustCenter/ItemList.astro';
import Tag from '@components/TrustCenter/Tag.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { DOC_GROUPS, DOCS, docHref } from '@data/trust-center/documents';
import { TC_FAQ } from '@data/trust-center/faq';
import { HUES, sectionFor, tc } from '@data/trust-center/nav';
import { CERT_VALIDATOR, CERTIFICATES, DEPLOYMENTS, TOPICS } from '@data/trust-center/overview';
import { ACCESS, VERIFICATION } from '@data/trust-center/status';

/**
 * The Trust Center's overview, build v2.
 *
 * - The hero carries the proof: both certificates, verified, with the way to check them.
 * - The six topics mirror the section bar, each marked in its section's hue.
 * - Bands alternate white and tint; cards sit only on the tint (the deployments, getting in touch).
 * - Documents list by group with their access; requesting happens in the library.
 * - The FAQ is the product pages' (`ProductFaq`), 21 questions in five topics, all visible.
 */

const groups = DOC_GROUPS.map((name, gi) => ({ name, docs: DOCS.filter((d) => d.group === gi) }));
---

<TrustCenterLayout
	title="Trust Center"
	eyebrow="Security, compliance and privacy"
	lede="Security is built into every layer of ThingsBoard, from device connections to the way we develop and run the platform. Your data stays isolated, encrypted in transit and under your control."
	description="Security, compliance and privacy at ThingsBoard: certifications, documents, data protection by deployment, and how to report a vulnerability."
>
	<div slot="hero" class="tc-proof">
		<CardGrid cols={2}>
			{CERTIFICATES.map((cert) => (
				<Card role="row" href={cert.href} title={cert.title} class="tc-proof__card">
					<Mark slot="mark" size={40} icon="tabler:certificate" accent={HUES.violet} fill="solid" />
					<p class="tc-card-text">{cert.subtitle}</p>
					<div slot="footer">
						<Tag tag={VERIFICATION.certified} />
					</div>
				</Card>
			))}
		</CardGrid>
		<p class="tc-proof__note">
			Issued by Swiss Approval North America on 9 September 2026.
			<Link href={CERT_VALIDATOR} size="sm" external>
				Verify the certificates
			</Link>
		</p>
	</div>

	<Band pad={{ top: 'sm', bottom: 'lg' }} labelledby="topics">
		<div class="tc-section">
			<h2 class="tc-h2" id="topics">
				What we cover
			</h2>
			<ul class="tc-topics">
				{TOPICS.map((topic) => (
					<li class="tc-topic">
						<Mark size={48} icon={topic.icon} accent={sectionFor(topic.href).hue} fill="solid" />
						<div class="tc-topic__body">
							<h3 class="tc-topic__title">
								<a href={topic.href}>{topic.title}</a>
							</h3>
							<p class="tc-topic__sub">{topic.subtitle}</p>
							<ul class="tc-topic__points" style={`--tc-point: ${sectionFor(topic.href).hue}`}>
								{topic.points.map((point) => (
									<li>
										<Icon name="tabler:check" aria-hidden="true" />
										{point}
									</li>
								))}
							</ul>
						</div>
					</li>
				))}
			</ul>
		</div>
	</Band>

	<Band ground="tint" pad="lg" labelledby="deployment">
		<div class="tc-section">
			<div class="tc-section__head">
				<h2 class="tc-h2" id="deployment">
					Cloud and on-premises
				</h2>
				<p class="tc-copy">
					Whether you use ThingsBoard Cloud, Private Cloud or run the platform on-premises, you get the same security
					features and the same engineering practices behind every release.
				</p>
			</div>
			<CardGrid cols={2}>
				{DEPLOYMENTS.map((d) => (
					<Card href={d.href} title={d.title}>
						<Mark slot="mark" size={48} icon={d.icon} accent={HUES.teal} fill="solid" />
						<p class="tc-card-text">{d.text}</p>
					</Card>
				))}
			</CardGrid>
		</div>
	</Band>

	<Band pad="lg" labelledby="documents">
		<div class="tc-section">
			<div class="tc-section__head">
				<h2 class="tc-h2" id="documents">
					Documents
				</h2>
				<p class="tc-copy">
					Public documents are open to everyone. Documents that describe our weak spots, such as the Statement of
					Applicability and the pentest summary, are shared under a mutual NDA, within two business days of signing it.
				</p>
			</div>
			<div class="tc-docgroups">
				{groups.map((g) => (
					<div class="tc-docgroup">
						<h3 class="tc-docgroup__title">{g.name}</h3>
						<ItemList
							compact
							columns={1}
							items={g.docs.map((d) => ({ title: d.name, href: docHref(d), tags: [ACCESS[d.access]] }))}
						/>
					</div>
				))}
			</div>
			<div class="tc-actions-row">
				<Button href={tc('documents')} accent={HUES.orange}>
					Browse and request documents
				</Button>
			</div>
		</div>
	</Band>

	<Band ground="tint" pad="lg" labelledby="get-in-touch">
		<div class="tc-section">
			<h2 class="tc-h2" id="get-in-touch">
				Get in touch
			</h2>
			<CardGrid cols={2}>
				<Card title="Found a vulnerability?">
					<Mark slot="mark" size={48} icon="tabler:bug" accent={HUES.brand} fill="solid" />
					<p class="tc-card-text">
						Report it to us privately instead of opening a public issue, so we can fix it before anyone can exploit it.
						We reply within three business days with an investigation plan and keep you updated until the fix is out.
					</p>
					<div slot="footer">
						<Button href={tc('report-vulnerability')} size="sm">
							Report a vulnerability
						</Button>
					</div>
				</Card>
				<Card title="A question about security, compliance or privacy?">
					<Mark slot="mark" size={48} icon="tabler:message-circle" accent={HUES.brand} fill="solid" />
					<p class="tc-card-text">Ask us, or request documents under NDA. We reply by email.</p>
					<div slot="footer">
						<Button href={tc('contact')} size="sm" variant="secondary">
							Contact us
						</Button>
					</div>
				</Card>
			</CardGrid>
		</div>
	</Band>

	<Band pad="lg" labelledby="faq">
		<div class="tc-section">
			<h2 class="tc-h2" id="faq">
				Trust Center FAQ
			</h2>
			<ProductFaq categories={TC_FAQ} visibleCount={7} idPrefix="tc-faq" label="FAQ topics" />
		</div>
	</Band>
</TrustCenterLayout>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	.tc-proof {
		display: grid;
		gap: $spacing-4;
		max-width: 760px;
	}

	.tc-proof__note {
		@include type-small;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: $spacing-2 $spacing-4;
		color: var(--color-text-secondary);
	}

	.tc-topics {
		display: grid;
		gap: $spacing-10 $spacing-12;
		padding: 0;
		list-style: none;

		@include media-up(md) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		@include media-up(lg) {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	.tc-topic {
		display: grid;
		gap: $spacing-4;
		align-content: start;
	}

	.tc-topic__body {
		display: grid;
		gap: $spacing-1;
		min-width: 0;
	}

	.tc-topic__title {
		@include type-tile-lg;

		a {
			color: var(--color-text);
			text-decoration: none;

			&:hover {
				color: var(--accent-ink);
				text-decoration: underline;
				text-underline-offset: 3px;
			}
		}
	}

	.tc-topic__sub {
		@include type-small;
		color: var(--color-text-muted);
	}

	.tc-topic__points {
		display: grid;
		gap: $spacing-1;
		margin-top: $spacing-3;
		padding: 0;
		list-style: none;

		li {
			@include type-small;
			display: grid;
			grid-template-columns: 16px minmax(0, 1fr);
			gap: $spacing-2;
			color: var(--color-text-secondary);
		}

		svg {
			width: 16px;
			height: 16px;
			margin-top: 3px;
			color: var(--tc-point);
		}
	}

	.tc-docgroups {
		display: grid;
		gap: $spacing-8 $spacing-10;

		@include media-up(md) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.tc-docgroup {
		display: grid;
		gap: $spacing-2;
		align-content: start;
	}

	.tc-docgroup__title {
		@include type-tile;
		color: var(--color-text);
	}
</style>
