---
import { Icon } from 'astro-icon/components';
import Button from '@components/ui/Button.astro';
import Card from '@components/ui/Card.astro';
import CardGrid from '@components/ui/CardGrid.astro';
import Field from '@components/ui/Field.astro';
import Link from '@components/ui/Link.astro';
import Mark from '@components/ui/Mark.astro';
import CertSeal from '@components/TrustCenter/CertSeal.astro';
import FaqList from '@components/TrustCenter/FaqList.astro';
import HubDocuments from '@components/TrustCenter/HubDocuments.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { tc } from '@data/trust-center/nav';
import {
	DEPLOYMENT_CARDS,
	HUB_CERTIFICATIONS,
	HUB_DOCUMENTS_INTRO,
	OVERVIEW_LEDE,
	DEPLOYMENTS_LEAD,
	TILES,
	VULNERABILITY_BANNER,
} from '@data/trust-center/overview';

/**
 * The Trust Center's hub, in the draft's order: the hero (the Overview's first paragraph as its lede, the two
 * actions, and the draft's Certifications panel as its visual, a seal per certificate with its
 * line), then the six topic tiles, Deployments (Cloud and on-premises, led by the Overview's second paragraph), Documents, the small Contact us form (it
 * opens the reader's mail app, as drafted), Found a vulnerability?, and the FAQ.
 *
 * Not carried over from the draft, which was one page standing in for the site: the mock header and
 * promo strip, and the page's own search box (the site's search covers the pages, and its shortcut
 * is the site search's).
 */
---

<TrustCenterLayout
	title="Trust Center"
	eyebrow="Security, compliance and privacy"
	lede={OVERVIEW_LEDE}
	description="Security, compliance and privacy at ThingsBoard: certifications, how the platform protects your data, what we handle in each deployment model, documents, and how to reach us."
>
	<Fragment slot="actions">
		<Button href={tc('contact')} size="md">
			Contact us
		</Button>
		<Button href={tc('report-vulnerability')} size="md" variant="secondary" icon="tabler:bug">
			Report a vulnerability
		</Button>
	</Fragment>
	{/* The draft's Certifications panel, as the hero's visual: a seal per certificate with its line. */}
	<ul slot="visual" class="tc-seals" id="compliance" aria-label="Certifications">
		{HUB_CERTIFICATIONS.map((cert) => (
			<li class="tc-seals__item">
				<CertSeal number={cert.number} size={96} />
				<span class="ui-sr">{cert.title}</span>
				<span class="tc-seals__badge">
					<Icon name="tabler:circle-check" aria-hidden="true" />
					Certified · {cert.issued}
				</span>
				<span class="tc-seals__caption">Reg. {cert.registration}</span>
			</li>
		))}
	</ul>

	<section class="tc-section tc-section--h2" id="highlights" aria-label="Security highlights">
		<CardGrid cols={3}>
			{TILES.map((tile) => (
				<Card role="tile" href={tile.href} title={tile.title} class="tc-tile">
					<Mark slot="mark" size={40} icon={tile.icon} accent="brand" />
					<p class="tc-tile__sub">{tile.subtitle}</p>
					<ul class="tc-tile__list">
						{tile.points.map((point) => (
							<li>
								<Icon name="tabler:check" aria-hidden="true" />
								{point}
							</li>
						))}
					</ul>
					<span class="tc-tile__more" aria-hidden="true">
						Read the section
						<Icon name="tabler:chevron-right" aria-hidden="true" />
					</span>
				</Card>
			))}
		</CardGrid>
	</section>

	<section class="tc-section tc-section--h2" id="deployment" aria-labelledby="deployment-title">
		<h2 class="tc-h2" id="deployment-title">
			Deployments
		</h2>
		<p class="tc-lead">{DEPLOYMENTS_LEAD}</p>
		<CardGrid cols={2}>
			{DEPLOYMENT_CARDS.map((card) => (
				<Card role="tile" href={card.href} title={card.title} class="tc-dep">
					<Mark slot="mark" size={48} icon={card.icon} accent="brand" />
					<p class="tc-dep__text">{card.text}</p>
					<dl class="tc-dep__rows">
						{card.rows.map((row) => (
							<>
								<dt>{row.label}</dt>
								<dd set:html={row.html} />
							</>
						))}
					</dl>
					<Link slot="footer" href={card.href}>
						{card.link}
					</Link>
				</Card>
			))}
		</CardGrid>
	</section>

	<section class="tc-section tc-section--h2" id="documents" aria-labelledby="documents-title">
		<div class="tc-section__head">
			<h2 class="tc-h2" id="documents-title">
				Documents
			</h2>
			<Link href={tc('documents')} class="tc-section__link">
				Browse all documents
			</Link>
		</div>
		<p class="tc-lead" set:html={HUB_DOCUMENTS_INTRO} />
		<HubDocuments />
	</section>

	<section class="tc-section" id="request" aria-labelledby="request-title">
		{/* The draft's small form: the button opens a mail to security@thingsboard.io with the three fields. */}
		<Card as="form" role="panel" class="tc-quickform" attrs={{ id: 'tc-quick', novalidate: 'novalidate' }}>
			<h2 class="tc-h3" id="request-title">
				Contact us
			</h2>
			<div class="tc-quickform__row">
				<Field name="name" id="rq-name" label="Name" placeholder="Jane Reviewer" autocomplete="name" size="md" />
				<Field
					name="email"
					id="rq-email"
					label="Work email"
					type="email"
					placeholder="jane@company.com"
					autocomplete="email"
					inputmode="email"
					size="md"
				/>
				<Field
					name="question"
					id="rq-what"
					label="Your question"
					placeholder="e.g. SoA and the pen-test report for a vendor assessment"
					size="md"
				/>
				<Button type="button" size="md" attrs={{ id: 'rq-send' }}>
					Contact us
				</Button>
			</div>
		</Card>
	</section>

	<section class="tc-section" id="report" aria-labelledby="report-title">
		<Card role="panel" class="tc-banner">
			<div class="tc-banner__body">
				<h2 class="tc-h3" id="report-title">
					{VULNERABILITY_BANNER.title}
				</h2>
				<p class="tc-copy">{VULNERABILITY_BANNER.text}</p>
			</div>
			<Button href={VULNERABILITY_BANNER.href} size="md">
				{VULNERABILITY_BANNER.button}
			</Button>
		</Card>
	</section>

	<section class="tc-section tc-section--h2" id="faq" aria-labelledby="faq-title">
		<h2 class="tc-h2" id="faq-title">
			Trust Center FAQs
		</h2>
		<FaqList />
	</section>
</TrustCenterLayout>

<script>
	const send = document.getElementById('rq-send');
	send?.addEventListener('click', () => {
		const value = (id: string) => (document.getElementById(id) as HTMLInputElement | null)?.value.trim() ?? '';
		const body = encodeURIComponent(
			`Name: ${value('rq-name')}\nWork email: ${value('rq-email')}\n\nQuestion:\n${value('rq-what')}\n`
		);
		window.location.href = `mailto:security@thingsboard.io?subject=${encodeURIComponent('Trust Center inquiry')}&body=${body}`;
	});
</script>
