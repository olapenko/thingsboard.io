---
import { Icon } from 'astro-icon/components';
import Button from '@components/ui/Button.astro';
import Card from '@components/ui/Card.astro';
import CardGrid from '@components/ui/CardGrid.astro';
import Link from '@components/ui/Link.astro';
import Mark from '@components/ui/Mark.astro';
import CertSeal from '@components/TrustCenter/CertSeal.astro';
import ProductFaq from '@components/Landing/ProductFaq.astro';
import HubDocuments from '@components/TrustCenter/HubDocuments.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { TC_FAQ } from '@data/trust-center/faq';
import { tc } from '@data/trust-center/nav';
import { TC_UPDATED, formatDate } from '@data/trust-center/pages';
import {
	DEPLOYMENT_CARDS,
	HUB_CERTIFICATIONS,
	HUB_DOCUMENTS_INTRO,
	OVERVIEW_LEDE,
	TILE_MARK,
	DEPLOYMENTS_LEAD,
	TILES,
} from '@data/trust-center/overview';

/**
 * The Trust Center's hub, in the draft's order: the hero (the Overview's first paragraph as its lede, the two
 * actions, and the draft's Certifications panel as its visual, a seal per certificate with its
 * line), then the six topic tiles, Deployments (Cloud and on-premises, led by the Overview's second
 * paragraph), Documents, and the FAQ (the product pages' `ProductFaq`: the draft's five categories as
 * topics, five answers each before "More questions"). It closes on the Trust Center's bookend, as
 * every page does (`TrustCenterLayout`): the contact form, the library and the vulnerability report as
 * three cards. The bookend replaces the draft's small mailto form and its "Found a vulnerability?"
 * banner.
 *
 * Not carried over from the draft, which was one page standing in for the site: the mock header and
 * promo strip, and the page's own search box (the site's search covers the pages, and its shortcut
 * is the site search's).
 */

/** Answers per FAQ topic before "More questions": the largest topic (Cloud, seven) holds two back. */
const FAQ_VISIBLE = 5;
---

<TrustCenterLayout
	title="Trust Center"
	wave
	eyebrow="Security, compliance and privacy"
	lede={OVERVIEW_LEDE}
	description="Security, compliance and privacy at ThingsBoard: certifications, how the platform protects your data, what we handle in each deployment model, documents, and how to reach us."
>
	<Fragment slot="actions">
		<Button href={tc('contact')} size="md">
			Contact us
		</Button>
		{/* Two weights: Contact us the primary, the documents (what most visitors come for) the secondary,
		    and the report a quiet line under both, in ink, for the few who need it. The bookend offers all
		    three again. */}
		<Button href={tc('documents')} size="md" variant="secondary" icon="tabler:file-text">
			Browse documents
		</Button>
		<p class="tc-hero__note">
			<Icon name="tabler:bug" aria-hidden="true" />
			<span>
				Found a vulnerability?{' '}
				<Link variant="inline" tone="ink" href={tc('report-vulnerability')}>
					Report it privately
				</Link>
			</span>
		</p>
	</Fragment>
	{/* The draft's Certifications panel, as the hero's visual: a seal per certificate with its line. */}
	<ul slot="visual" class="tc-seals" id="compliance" aria-label="Certifications">
		{HUB_CERTIFICATIONS.map((cert) => (
			<li class="tc-seals__item">
				<a class="tc-seals__link" href={cert.href}>
					<CertSeal number={cert.number} size={96} />
					<span class="ui-sr">{cert.title}</span>
					<span class="tc-seals__badge">
						<Icon name="tabler:circle-check-filled" aria-hidden="true" />
						Certified · {cert.issued}
					</span>
					<span class="tc-seals__caption">Reg. {cert.registration}</span>
				</a>
			</li>
		))}
	</ul>

	{/* The draft's footer line, said once for the whole Trust Center, as the first line of its content:
	    how often it is reviewed, and when it last was. Its "Owner: IMS Manager" is left out. CLARIFY: whether the owner should be named
	    here, and how. */}
	<p class="tc-dateline tc-dateline--lead">
		<Icon name="tabler:calendar-check" class="tc-dateline__icon" aria-hidden="true" />
		<span>
			We review this Trust Center at least every six months. Last reviewed{' '}
			<time datetime={TC_UPDATED}>{formatDate(TC_UPDATED)}</time>.
		</span>
	</p>

	<section class="tc-section tc-section--h2" id="highlights" aria-label="Security highlights">
		<CardGrid cols={3}>
			{TILES.map((tile) => (
				<Card role="tile" href={tile.href} title={tile.title} class="tc-tile">
					<Mark slot="mark" size={40} icon={tile.icon} accent={TILE_MARK} />
					<p class="tc-tile__sub">{tile.subtitle}</p>
					<ul class="tc-tile__list">
						{tile.points.map((point) => (
							<li>
								<Icon name="tabler:check" aria-hidden="true" />
								{point}
							</li>
						))}
					</ul>
					<span class="tc-tile__more" aria-hidden="true">
						Learn more
						<Icon name="tabler:chevron-right" aria-hidden="true" />
					</span>
				</Card>
			))}
		</CardGrid>
	</section>

	{/* Full bleed, on a wash from the Cloud's blue to on-premises' green, the site's colours for the two. */}
	<section
		class="tc-section tc-section--h2 tc-band tc-band--deployments"
		id="deployment"
		aria-labelledby="deployment-title"
	>
		<div class="tc-band__inner">
			<h2 class="tc-h2" id="deployment-title">
				Deployments
			</h2>
			<p class="tc-lead">{DEPLOYMENTS_LEAD}</p>
			<CardGrid cols={2}>
				{DEPLOYMENT_CARDS.map((card) => (
					<Card role="tile" href={card.href} title={card.title} class="tc-dep">
						<Mark slot="mark" size={48} icon={card.icon} accent={card.accent} />
						<p class="tc-dep__text">{card.text}</p>
						<dl class="tc-dep__rows">
							{card.rows.map((row) => (
								<>
									<dt>{row.label}</dt>
									<dd set:html={row.html} />
								</>
							))}
						</dl>
						<Link slot="footer" href={card.href}>
							{card.link}
						</Link>
					</Card>
				))}
			</CardGrid>
		</div>
	</section>

	<section class="tc-section tc-section--h2" id="documents" aria-labelledby="documents-title">
		<h2 class="tc-h2" id="documents-title">
			Documents
		</h2>
		<p class="tc-lead" set:html={HUB_DOCUMENTS_INTRO} />
		<HubDocuments />
	</section>

	<section class="tc-section tc-section--h2" id="faq" aria-labelledby="faq-title">
		<h2 class="tc-h2" id="faq-title">
			Trust Center FAQs
		</h2>
		<ProductFaq categories={TC_FAQ} visibleCount={FAQ_VISIBLE} idPrefix="tc-faq" />
	</section>
</TrustCenterLayout>
