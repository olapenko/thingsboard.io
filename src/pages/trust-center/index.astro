---
import Band from '@components/ui/Band.astro';
import Button from '@components/ui/Button.astro';
import CardGrid from '@components/ui/CardGrid.astro';
import Link from '@components/ui/Link.astro';
import Mark from '@components/ui/Mark.astro';
import ProductFaq from '@components/Landing/ProductFaq.astro';
import CertSeal from '@components/TrustCenter/CertSeal.astro';
import ItemList from '@components/TrustCenter/ItemList.astro';
import TcCard from '@components/TrustCenter/TcCard.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { DOC_GROUPS, DOCS, docHref } from '@data/trust-center/documents';
import { TC_FAQ } from '@data/trust-center/faq';
import { HUES, SECTIONS, tc } from '@data/trust-center/nav';
import { CERT_VALIDATOR, CERTIFICATES } from '@data/trust-center/overview';
import { ACCESS, VERIFICATION } from '@data/trust-center/status';

/**
 * The Trust Center's overview, build v3.
 *
 * - The hero is the intro alone; the certificates are the first band's, not the hero's.
 * - "What we cover" lists the four sections, each with its line and its pages: every section has a
 *   hub now, and the topics' points live there.
 * - Bands alternate white and tint; cards sit only on the tint (the certificates, getting in touch).
 * - Documents list by group with their access; requesting happens in the library.
 * - The FAQ is the product pages' (`ProductFaq`), 21 questions in five topics, all visible.
 */

const sections = SECTIONS.filter((s) => s.key !== 'overview');
const groups = DOC_GROUPS.map((name, gi) => ({ name, docs: DOCS.filter((d) => d.group === gi) }));
---

<TrustCenterLayout
	title="Trust Center"
	eyebrow="Security, compliance and privacy"
	lede="Security is built into every layer of ThingsBoard, from device connections to the way we develop and run the platform. Your data stays isolated, encrypted in transit and under your control."
	description="Security, compliance and privacy at ThingsBoard: certifications, documents, data protection by deployment, and how to report a vulnerability."
>
	<Band pad={{ top: 'md', bottom: 'lg' }} labelledby="topics">
		<div class="tc-section">
			<h2 class="tc-h2" id="topics">
				What we cover
			</h2>
			<ul class="tc-topics">
				{sections.map((s) => (
					<li class="tc-topic" style={`--tc-topic-hue: ${s.hue}`}>
						<Mark size={48} icon={s.icon} accent={s.hue} fill="solid" />
						<div class="tc-topic__body">
							<h3 class="tc-topic__title">
								<a href={s.href}>{s.label}</a>
							</h3>
							<p class="tc-topic__sub">{s.summary}</p>
							{s.pages.length > 1 && (
								<ul class="tc-topic__links" aria-label={`${s.label} pages`}>
									{s.pages.slice(1).map((p) => (
										<li>
											<a href={p.href}>{p.label}</a>
										</li>
									))}
								</ul>
							)}
						</div>
					</li>
				))}
			</ul>
		</div>
	</Band>

	<Band ground="tint" pad="lg" labelledby="certifications">
		<div class="tc-section">
			<div class="tc-section__head">
				<h2 class="tc-h2" id="certifications">
					Certifications
				</h2>
				<p class="tc-copy">Issued by Swiss Approval North America on 9 September 2026, audited every year.</p>
			</div>
			<CardGrid cols={2}>
				{CERTIFICATES.map((cert) => (
					<TcCard layout="row" href={cert.href} title={cert.title} text={cert.subtitle} tag={VERIFICATION.certified}>
						<CertSeal slot="lead" number={cert.number} />
					</TcCard>
				))}
			</CardGrid>
			<Link href={CERT_VALIDATOR} size="sm" external>
				Verify the certificates
			</Link>
		</div>
	</Band>

	<Band pad="lg" labelledby="documents">
		<div class="tc-section">
			<div class="tc-section__head">
				<h2 class="tc-h2" id="documents">
					Documents
				</h2>
				<p class="tc-copy">
					Public documents are open to everyone. Documents that describe our weak spots, such as the Statement of
					Applicability and the pentest summary, are shared under a mutual NDA, within two business days of signing it.
				</p>
			</div>
			<div class="tc-docgroups">
				{groups.map((g) => (
					<div class="tc-docgroup">
						<h3 class="tc-docgroup__title">{g.name}</h3>
						<ItemList
							compact
							columns={1}
							items={g.docs.map((d) => ({ title: d.name, href: docHref(d), tags: [ACCESS[d.access]] }))}
						/>
					</div>
				))}
			</div>
			<div class="tc-actions-row">
				<Button href={tc('documents')} accent={HUES.orange}>
					Browse and request documents
				</Button>
			</div>
		</div>
	</Band>

	<Band ground="tint" pad="lg" labelledby="get-in-touch">
		<div class="tc-section">
			<h2 class="tc-h2" id="get-in-touch">
				Get in touch
			</h2>
			<CardGrid cols={2}>
				<TcCard
					title="Found a vulnerability?"
					text="Report it to us privately instead of opening a public issue, so we can fix it before anyone can exploit it. We reply within three business days with an investigation plan and keep you updated until the fix is out."
				>
					<Mark slot="lead" size={48} icon="tabler:bug" accent={HUES.brand} fill="solid" />
					<Button slot="footer" href={tc('report-vulnerability')} size="sm">
						Report a vulnerability
					</Button>
				</TcCard>
				<TcCard
					title="A question about security, compliance or privacy?"
					text="Ask us, or request documents under NDA. We reply by email."
				>
					<Mark slot="lead" size={48} icon="tabler:message-circle" accent={HUES.brand} fill="solid" />
					<Button slot="footer" href={tc('contact')} size="sm" variant="secondary">
						Contact us
					</Button>
				</TcCard>
			</CardGrid>
		</div>
	</Band>

	<Band pad="lg" labelledby="faq">
		<div class="tc-section">
			<h2 class="tc-h2" id="faq">
				Trust Center FAQ
			</h2>
			<ProductFaq categories={TC_FAQ} visibleCount={7} idPrefix="tc-faq" label="FAQ topics" />
		</div>
	</Band>
</TrustCenterLayout>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	.tc-docgroups {
		display: grid;
		gap: $spacing-8 $spacing-10;

		@include media-up(md) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.tc-docgroup {
		display: grid;
		gap: $spacing-2;
		align-content: start;
	}

	.tc-docgroup__title {
		@include type-tile;
		color: var(--color-text);
	}
</style>
