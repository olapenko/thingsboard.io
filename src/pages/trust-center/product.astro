---
import Band from '@components/ui/Band.astro';
import Controls from '@components/TrustCenter/Controls.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { PRODUCT_CONTROLS } from '@data/trust-center/controls';
---

<TrustCenterLayout
	title="Product security"
	eyebrow="Security"
	lede="How the platform protects device connections, credentials and secrets, so you don't have to build this layer yourself."
	description="How ThingsBoard protects device connections, credentials and secrets: device authentication, encrypted transport, secrets storage and custom domains."
>
	<Band pad={{ top: 'sm', bottom: 'lg' }}>
		<div class="tc-stack">
			<Controls items={PRODUCT_CONTROLS} />
			<p class="tc-copy">
				Full documentation for every feature is in the{' '}
				<a href="/docs/pe/user-guide/security/overview/">Security section</a> of the docs.
			</p>
		</div>
	</Band>
</TrustCenterLayout>
