---
import Catalog from '@components/TrustCenter/Catalog.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { CAT_PRODUCT } from '@data/trust-center/catalogs';
import { crumbs } from '@data/trust-center/nav';
---

<TrustCenterLayout
	title="Product security"
	lede="How the platform protects device connections, credentials and secrets, so you don't have to build this layer yourself."
	family="security"
	crumbs={crumbs('product')}
	description="How ThingsBoard protects device connections, credentials and secrets: secrets storage, device authentication, encrypted transport and custom domains."
>
	<section class="tc-section" aria-label="Product security">
		<Catalog rows={CAT_PRODUCT} label="Product security controls" />
	</section>
</TrustCenterLayout>
