---
import Catalog from '@components/TrustCenter/Catalog.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { CAT_ACCESS } from '@data/trust-center/catalogs';
import { crumbs } from '@data/trust-center/nav';
---

<TrustCenterLayout
	title="Access control"
	lede="Who can sign in, what each user can see, and a record of what they did. We built these controls into the platform; you decide how strictly to apply them in your tenant."
	family="security"
	crumbs={crumbs('access')}
	nextCount={3}
	description="Access control in ThingsBoard: two-factor authentication, single sign-on, API keys, role-based access, session lifetimes, the audit log and password policies."
>
	<section class="tc-section" aria-label="Access control">
		<Catalog rows={CAT_ACCESS} label="Access controls" />
	</section>
</TrustCenterLayout>
