---
import Band from '@components/ui/Band.astro';
import Controls from '@components/TrustCenter/Controls.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { ACCESS_CONTROLS } from '@data/trust-center/controls';
---

<TrustCenterLayout
	title="Access control"
	eyebrow="Security"
	lede="Who can sign in, what each user can see, and a record of what they did. We built these controls into the platform; you decide how strictly to apply them in your tenant."
	description="ThingsBoard's access controls: two-factor authentication, single sign-on, API keys, role-based access, sessions, the audit log and password policies."
>
	<Band pad={{ top: 'sm', bottom: 'lg' }}>
		<div class="tc-stack">
			<Controls items={ACCESS_CONTROLS} />
		</div>
	</Band>
</TrustCenterLayout>
