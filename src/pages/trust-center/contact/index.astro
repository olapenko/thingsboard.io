---
import ContactFormProto from '@components/TrustCenter/ContactFormProto.astro';
import FormPage, { type ElsewhereItem } from '@components/TrustCenter/FormPage.astro';
import { SECURITY_EMAIL, tc } from '@data/trust-center/nav';

/**
 * The Trust Center's own contact page, on Contact us's page and form (`FormPage`, `ContactFormProto`),
 * with only the security topics. Every Request link and the hub's Contact us land here.
 *
 * Chosen over merging the topics into `/contact-us/`, which stays possible: see `ContactFormProto`.
 * The merged prototype, `/trust-center/contact/merged/`, and the switch between the two are in git up
 * to 06af87e21.
 */

const ELSEWHERE: ElsewhereItem[] = [
	{
		icon: 'tabler:shield-exclamation',
		lead: 'Found a vulnerability?',
		label: 'Report it privately',
		href: tc('report-vulnerability'),
		accent: 'alert',
	},
	{ icon: 'tabler:file-text', lead: 'Looking for a document?', label: 'Browse the documents', href: tc('documents') },
	{ icon: 'tabler:mail', lead: 'Prefer email?', label: SECURITY_EMAIL, href: `mailto:${SECURITY_EMAIL}` },
];
---

<FormPage
	title="Contact our security team"
	lede="Request documents, send us a security questionnaire, or ask about compliance and privacy. We reply by email."
	description="Ask ThingsBoard's security team about security, compliance or privacy, or request documents under NDA."
	metaTitle="Contact · Trust Center"
	back={{ label: 'Trust Center', href: tc() }}
	elsewhere={ELSEWHERE}
>
	<ContactFormProto />
</FormPage>
