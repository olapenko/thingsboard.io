---
import ContactFormProto from '@components/TrustCenter/ContactFormProto.astro';
import FormPage, { type ElsewhereItem } from '@components/TrustCenter/FormPage.astro';
import ProtoSwitch from '@components/TrustCenter/ProtoSwitch.astro';
import { tc } from '@data/trust-center/nav';

/**
 * PROTOTYPE, the merged version: the site's Contact us page (`pages/contact-us.astro`) as it would read
 * with the Trust Center's topics ported in. Its intro, its "Looking for something else?" and its form,
 * the form with one more topic group (`ContactFormProto`, `merged`). A Trust Center link carries
 * `?security`, which swaps the intro for the security team's and keeps only that group; `?pcorder`
 * still swaps it for Private Cloud's.
 *
 * Under `/trust-center/` only while it is a prototype: nothing here changes `/contact-us/` until the
 * port is asked for. The port is the SECURITY blocks of `ContactFormProto`, the `security` intent
 * below, and the vulnerability line in ELSEWHERE.
 */

// Contact us's intro and intents, as they are; `security` is the addition.
const INTRO = {
	eyebrow: 'Contact us',
	title: 'Let’s talk about what you’re building',
	lede: 'Planning a rollout, weighing up Private Cloud, or looking for a partner? Tell us a little about it, and someone from our team will write back by email.',
};
const INTENTS = {
	pcorder: {
		eyebrow: 'Private Cloud',
		title: 'Get your private IoT platform',
		lede: 'A dedicated ThingsBoard cluster, run by us for you. Tell us about your devices, your data and where you’d like it hosted, and we’ll come back with a setup and a quote sized to it.',
	},
	security: {
		eyebrow: 'Trust Center',
		title: 'Contact our security team',
		lede: 'Request documents, send us a security questionnaire, or ask about compliance and privacy. We reply by email.',
	},
};

// Contact us's three, and the vulnerability report's way in (SECURITY), so a report never lands here.
const ELSEWHERE: ElsewhereItem[] = [
	{
		icon: 'tabler:lifebuoy',
		lead: 'Already a customer?',
		label: 'Open a ticket in the Support portal',
		href: 'https://thingsboard-portal.atlassian.net/servicedesk/customer/portal/1',
		external: true,
	},
	{
		icon: 'tabler:brand-github',
		lead: 'Running ThingsBoard on your own servers?',
		label: 'Ask on GitHub issues',
		href: 'https://github.com/thingsboard/thingsboard/issues',
		external: true,
	},
	{
		icon: 'tabler:bug',
		lead: 'Found a security vulnerability?',
		label: 'Report it privately',
		href: tc('report-vulnerability'),
		accent: 'alert',
	},
	{ icon: 'tabler:mail', lead: 'Prefer email?', label: 'info@thingsboard.io', href: 'mailto:info@thingsboard.io' },
];
---

<FormPage
	eyebrow={INTRO.eyebrow}
	title={INTRO.title}
	lede={INTRO.lede}
	description="Prototype: the site's Contact us page with the Trust Center's security topics added."
	metaTitle="Contact Us (merged prototype)"
	elsewhere={ELSEWHERE}
	intents={INTENTS}
>
	<ProtoSwitch slot="top" current="merged" />
	<ContactFormProto variant="merged" />
</FormPage>
