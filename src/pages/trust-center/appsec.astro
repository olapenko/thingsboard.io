---
import Catalog from '@components/TrustCenter/Catalog.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { CAT_APPSEC } from '@data/trust-center/catalogs';
import { crumbs } from '@data/trust-center/nav';
---

<TrustCenterLayout
	title="Dev security"
	lede="How we build, test and release the software you run. These practices come from years of delivering production IoT solutions on our own platform."
	family="security"
	crumbs={crumbs('appsec')}
	description="How ThingsBoard builds, tests and releases its software: code review, separate environments, scanning, change management, penetration testing, security fixes and release support."
>
	<section class="tc-section" aria-label="Dev security">
		<Catalog rows={CAT_APPSEC} label="Development security practices" />
	</section>
</TrustCenterLayout>
