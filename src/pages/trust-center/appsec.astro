---
import Band from '@components/ui/Band.astro';
import Controls from '@components/TrustCenter/Controls.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { DEV_CONTROLS } from '@data/trust-center/controls';
import { tc } from '@data/trust-center/nav';
---

<TrustCenterLayout
	title="Dev security"
	eyebrow="Security"
	lede="How we build, test and release the software you run. These practices come from years of delivering production IoT solutions on our own platform."
	description="How ThingsBoard builds and releases its software: code review, scanning, change management, penetration testing, security fixes and release support."
>
	<Band pad={{ top: 'sm', bottom: 'lg' }}>
		<div class="tc-stack">
			<Controls items={DEV_CONTROLS} />
			<p class="tc-copy">
				Found a weakness in our software? <a href={tc('report-vulnerability')}>Report it privately</a>, and we'll
				respond within three business days.
			</p>
		</div>
	</Band>
</TrustCenterLayout>
