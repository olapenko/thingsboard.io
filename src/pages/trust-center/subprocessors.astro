---
import Band from '@components/ui/Band.astro';
import Facts from '@components/TrustCenter/Facts.astro';
import SubprocessorUpdates from '@components/TrustCenter/SubprocessorUpdates.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { SUBPROCESSORS } from '@data/trust-center/deployment';

// Sub-processors, as a fact list (a vendor, then what it does and where) rather than a table of its
// own, and the subscription to changes on a tint below it.

const ROWS = SUBPROCESSORS.map((v) => ({
	term: v.vendor,
	html: `${v.purpose}<br><span class="tc-muted">${v.location}</span>`,
}));
---

<TrustCenterLayout
	title="Sub-processors"
	lede="These vendors may have access to customer or personal data. Each one passes a security assessment before we start working with it, and we sign a DPA whenever personal data is involved."
	description="The vendors that may have access to ThingsBoard customer or personal data, with their purpose and location."
>
	<Band pad={{ top: 'sm', bottom: 'lg' }}>
		<div class="tc-stack">
			<Facts rows={ROWS} />
			<p class="tc-copy">
				Location means the hosting region for infrastructure providers and the country of the contracting entity for
				other vendors; exact data regions are set out in each vendor's DPA. We notify customers of material changes to
				this list, as set out in the <a href="/products/paas/dpa/">DPA</a>.
			</p>
		</div>
	</Band>
	<Band ground="tint" pad="lg">
		<SubprocessorUpdates />
	</Band>
</TrustCenterLayout>
