---
import ProductMatrix from '@components/Landing/ProductMatrix.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { crumbs } from '@data/trust-center/nav';
import { SUBPROCESSORS, SUBPROCESSORS_NOTE } from '@data/trust-center/subprocessors';

/**
 * Sub-processors, as drafted: the vendors with their purpose and location. On the product pages'
 * comparison table, the vendor the row's label, so it reflows on a phone instead of scrolling.
 */
---

<TrustCenterLayout
	title="Sub-processors"
	lede="These vendors may have access to customer or personal data. Each one passes a security assessment before we start working with it, and we sign a DPA whenever personal data is involved."
	crumbs={crumbs('subprocessors')}
	description="The vendors that may access customer or personal data on ThingsBoard's behalf, with each one's purpose and location."
>
	<section class="tc-section" aria-label="Sub-processors">
		<ProductMatrix
			caption="Sub-processors, with each vendor's purpose and location"
			firstLabel="Vendor"
			columns={[{ name: 'Purpose' }, { name: 'Location' }]}
			rows={SUBPROCESSORS.map((s) => ({ label: s.vendor, values: [s.purpose, s.location] }))}
		/>
		<p class="tc-note" set:html={SUBPROCESSORS_NOTE} />
	</section>
</TrustCenterLayout>
