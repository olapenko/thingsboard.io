---
import ContactForm from '@components/TrustCenter/ContactForm.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { crumbs, tc } from '@data/trust-center/nav';

/** The Trust Center contact form, as drafted, centred like the draft's. */
---

<TrustCenterLayout
	title="Trust Center contact form"
	lede="Ask about security, compliance or privacy, or request documents under NDA."
	crumbs={crumbs('contact')}
	align="center"
	description="Ask ThingsBoard about security, compliance or privacy, or request documents under NDA."
>
	<p slot="intro" class="tc-vnote">
		Found a vulnerability? Use the <a href={tc('report-vulnerability')}>vulnerability report form</a> instead.
	</p>
	<ContactForm />
</TrustCenterLayout>
