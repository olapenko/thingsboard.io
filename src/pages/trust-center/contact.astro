---
import Band from '@components/ui/Band.astro';
import ContactRequestForm from '@components/TrustCenter/ContactRequestForm.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { tc } from '@data/trust-center/nav';

/**
 * The Trust Center's contact form (the draft's `#/contact`): security, compliance and privacy
 * questions, and requests for documents under NDA. Other pages link here with the subject and the
 * documents set (`requestHref`, `askHref` in `@data/trust-center/documents`); the form reads them.
 */
---

<TrustCenterLayout
	title="Trust Center contact form"
	metaTitle="Contact form · Trust Center"
	description="Ask ThingsBoard about security, compliance or privacy, or request security documents under NDA."
	eyebrow="Get in touch"
	lede="Ask about security, compliance or privacy, or request documents under NDA."
>
	{/* One line, unformatted: Prettier would break the link off its words with whitespace Astro keeps. */}
	{/* prettier-ignore */}
	<p slot="hero" class="tc-copy">Found a vulnerability? Use the <a href={tc('report-vulnerability')}>vulnerability report form</a> instead.</p>
	<Band ground="tint" pad={{ top: 'sm', bottom: 'lg' }}>
		<ContactRequestForm />
	</Band>
</TrustCenterLayout>
