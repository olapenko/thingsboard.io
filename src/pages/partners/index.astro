---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/Landing/PageIntro.astro';
import Band from '@components/ui/Band.astro';
import CardGrid from '@components/ui/CardGrid.astro';
import LinkCard from '@components/ui/LinkCard.astro';

/**
 * THE PARTNERS HUB: the three programmes the menu's Company › Partners group lists, as one page to
 * link them by. NOT LINKED from the menu or the footers since 2026-10-05, by the owner's call: it is a
 * technical page, and the menu lists the three programmes themselves. It stays up for whoever has its
 * address (and the sitemap).
 *
 * The words are the programmes' own: each card's line is its page's meta description, shortened.
 * In the menu's order, and under the menu's names.
 */
interface Programme {
	title: string;
	line: string;
	href: string;
	icon: string;
}

const PROGRAMMES: Programme[] = [
	{
		title: 'Affiliate program',
		line: 'Earn a 30% recurring commission on every sale you refer.',
		href: '/partners/affiliate/',
		icon: 'tabler:coins',
	},
	{
		title: 'Hardware partners',
		line: 'Sensors, gateways and IoT devices compatible with ThingsBoard.',
		href: '/partners/hardware/',
		icon: 'tabler:cpu',
	},
	{
		title: 'Distributors',
		line: 'Local distributors and system integrators who support ThingsBoard in your country.',
		href: '/partners/distributors/',
		icon: 'tabler:map-pin',
	},
];
---

<BaseLayout
	forceLightTheme
	title="Partners | ThingsBoard"
	description="ThingsBoard partners: find a local distributor or a compatible device, or join the affiliate program."
>
	<Band as="section" pad={{ top: 'lg', bottom: 'xl' }} attrs={{ 'aria-labelledby': 'partners-title' }}>
		<PageIntro
			eyebrow="Partners"
			title="ThingsBoard partners"
			lede="Find a local distributor or a compatible device, or join the affiliate program."
			titleId="partners-title"
		/>
		<CardGrid cols={3} class="partners-grid">
			{PROGRAMMES.map((p) => (
				<LinkCard layout="tall" href={p.href} title={p.title} line={p.line} icon={p.icon} />
			))}
		</CardGrid>
	</Band>
</BaseLayout>

<style lang="scss">
	@use '../../styles/variables' as *;

	// The intro's own spacing is none (`PageIntro`); the grid stands a step under it.
	.partners-grid {
		margin-top: $spacing-10;
	}
</style>
