---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import Variant from '@root/pages/internal/_Variant.astro';
import AiSection from '@components/Landing/AiSection.astro';
import AiSectionNext from '@components/Landing/AiSectionNext.astro';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * The AI section — "Build IoT solutions faster than ever with AI inside ThingsBoard".
 *
 * A SECTION rather than a row: it carries its own header and two full-bleed bands, so every direction
 * here is a `bleed` Variant. The desktop view is the section edge to edge at this window's width, as
 * `index.astro` places it; the phone view frames it at 375, so its viewport queries fire against a
 * real phone viewport rather than a narrow box.
 *
 * ADD a direction at the TOP — newest first — as a component beside `AiSection`, never as an edit to
 * it: `AiSection` is the one on the homepage, and it stays the last direction on this page as the
 * reference the others are judged against. A candidate that differs by one setting can instead be a
 * prop on `AiSection` whose default is today's behaviour, passed here through `props`.
 *
 * PROMOTED 2026-09-23: the toggle with the hand-off, now `AiSection`'s default and the homepage's.
 * The plain-fade toggle was retired and deleted with it. `layout="bands"` is the page that came
 * before, kept beside the reference so the two can still be compared.
 *
 * NEXT (2026-09-24): `AiSectionNext`, a full COPY of the shipping section — its own data file and chat
 * window — rather than a prop, because it is for different content that may change the sizing.
 */
---

<VisualPage visual="ai">
	<Variant
		visual={kv('ai')}
		component={AiSectionNext}
		bleed
		name="AiSectionNext"
		note="candidate · a copy of the shipping section for new content. The terminal now runs a CODING AGENT (`AgentTerminal`, no agent named): the Slack transcript typed into an input docked at the bottom, `✻ Thinking…` as the last line of the log while it works, tool results nested under `⎿`; the log scrolls at the CLI's 18px, and the window now ends inside the crop instead of running past it"
	/>

	<Variant
		visual={kv('ai')}
		component={AiSection}
		props={{ wash: 'cycle' }}
		bleed
		name="AiSection · wash follows the mark"
		note="experimental · the band's wash cycles with the mark's colours, in step; the kicker-less copy, so no coloured type rides a moving ground"
	/>

	<Variant
		visual={kv('ai')}
		component={AiSection}
		props={{ copy: 'value' }}
		bleed
		name="AiSection · value copy"
		note="candidate · a kicker naming the tool, and headlines that say what you get"
	/>

	<Variant
		visual={kv('ai')}
		component={AiSection}
		props={{ layout: 'bands' }}
		bleed
		name="AiSection · bands"
		note="previous homepage · both routes stacked, with the lede and the kickers"
	/>

	<Variant
		visual={kv('ai')}
		component={AiSection}
		bleed
		name="AiSection"
		note="shipping · on the homepage — the toggle with the hand-off, promoted from this page on 2026-09-23"
	/>
</VisualPage>

{
	/* THE HOMEPAGE'S CONTEXT, which the section is drawn against and the playground does not load.
	   Here rather than in `_Variant`, because every sandbox page imports that and none of the others
	   want any of it.

	   Found by diffing the computed style of every element in the section, `/` against this page, at
	   the same width — and the diff is the test if a variant ever looks different here: before this
	   block the chat's app bar, chip and composer line all came out shorter (line-height `normal`
	   against 24px) and the title sat 27px lower (the UA's h2 margin). */
}
<style lang="scss" is:global>
	@use '../../../styles/variables' as *;

	// The `section .main-div` container, its ~5px margin that `.ai__band` zeroes, and the 1000px
	// measure. `landing` also gives every `section` the page ground, which `index.astro` strips again
	// — the bands carry their own gradient, and a fill under them is a colour the homepage never paints.
	@use '../../../styles/landing';
	@use '../../../styles/sections-flat';

	:root section {
		background: none;
	}

	// The rest reaches the SECTION ONLY, through its wrapper, and every selector is `:where()`-wrapped
	// so it lands at the specificity the homepage's own rule has. One class heavier and these would
	// start beating the section's scoped rules, which is the opposite of fidelity.

	// What the homepage body passes down: `BaseLayout`'s two Starlight properties, and Starlight's
	// body rule reading them. The playground's body sets its own colour and no line-height.
	.vx__bleed {
		--sl-line-height: 1.5;
		--__sl-font: #{$font-family-base};
		line-height: var(--sl-line-height);
		color: var(--sl-color-text);
	}

	// Starlight's reset, in Starlight's layer — so, as on the homepage, anything the section writes
	// beats it.
	@layer starlight.reset {
		:where(.vx__bleed) * {
			margin: 0;
		}

		:where(.vx__bleed) :is(input, button, textarea, select) {
			font: inherit;
		}

		:where(.vx__bleed) :is(p, h1, h2, h3, h4, h5, h6, code) {
			overflow-wrap: break-word;
		}
	}

	// `index.astro`'s page-wide wrapping.
	:where(.vx__bleed) :is(h1, h2, h3) {
		text-wrap: balance;
	}

	:where(.vx__bleed) p {
		text-wrap: pretty;
	}

	// The playground caps every `svg` at its box; the homepage does not.
	:where(.vx__bleed) svg {
		max-width: none;
	}
</style>
