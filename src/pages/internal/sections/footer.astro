---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import Variant from '@root/pages/internal/_Variant.astro';
import FooterStage from '@root/pages/internal/_FooterStage.astro';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * The footer: every marketing page's last word, drawn here under the homepage's closing band.
 *
 * THE ONE IN USE (`Landing/Footer`) is a newsletter, four award badges, the logo, six links — Get
 * Started, Documentation, Use cases, Blog, Services, Contact us — and the social row. It names none
 * of the products, so a reader who reaches the bottom of any page is told nothing about what the
 * platform is made of.
 *
 * THE CANDIDATE (`Landing/FooterMap`, contents in `data/footer-map.ts`) maps it: the two ways to run
 * it and the six products around it, as the Products menu groups them, then four link columns —
 * Solutions, Developers, Services, Company — then the bottom line. `layout` sets how much room
 * the map takes: tiles with a line each, or one row of chips. Both are on black, a step down from
 * the closing band's indigo, with no line at the seam.
 *
 * PROMOTED 2026-09-30 to running orders A and B: "Platform map" closes the homepage there
 * (`footer: 'map'` in `data/home-compositions.ts`, read by `starlight/Footer.astro`). Live keeps
 * main's footer, and so does every other marketing page — "Site footer" below; the docs footer
 * (`DocFooter`) is not touched by either.
 */
---

<VisualPage visual="footer">
	<aside class="brief">
		<p class="brief__kicker">The footer</p>
		<dl class="brief__facts">
			<div>
				<dt>In use</dt>
				<dd>
					<em>Platform map</em> on the homepage in orders A and B. Everywhere else, and in Live, the site footer: newsletter
					and four badges, the logo beside six links, copyright and social, on <code>#0f161d</code> under the closing band’s
					<code>#121425</code>, naming no product.
				</dd>
			</div>
			<div>
				<dt>Asked</dt>
				<dd>A new footer that unpacks the platform, in place of the old, simple one.</dd>
			</div>
			<div>
				<dt>Candidate</dt>
				<dd>
					<code>components/Landing/FooterMap.astro</code> — <code>layout</code> (map · focus). The brand row with the newsletter;
					the platform as the Products menu groups it (<em>IoT platforms</em>, <em>Product ecosystem</em>), each product
					with its mark and hue; four link columns (no Build: it waits for the capability pages); GitHub, YouTube and
					LinkedIn only in the social row; copyright, cookie policy and the badges at the foot.
				</dd>
			</div>
			<div>
				<dt>Words</dt>
				<dd>
					The site’s own: the menu’s group names, each ecosystem card’s kicker, the Products section’s sentence split
					for the two platforms, main’s meta description under the logo, the newsletter’s words verbatim. Every link
					names a page that exists in <code>src/pages/</code> or the docs.
				</dd>
			</div>
			<div>
				<dt>WIP</dt>
				<dd>
					Where case studies go. The footer has no link to them (they were Solutions’ last link, and read as one more
					use case); Clients feedback is in Company. A <em>Customers</em> group under Solutions (both, case studies arrowed)
					was tried and parked undecided — <code>FOOTER_CUSTOMERS_WIP</code> in
					<code>data/footer-map.ts</code>.
				</dd>
			</div>
			<div>
				<dt>Not done</dt>
				<dd>
					The rest of the marketing pages (they keep <code>Landing/Footer</code>; A and B have the map). MailerLite’s
					success state (the form posts to a new tab, as the one in use does today).
				</dd>
			</div>
		</dl>
	</aside>

	{
		/* The bookends' ground, for every bookend tab at once: each one's own (the homepage's dark,
	    the product pages' light), or all dark, or all light. Moved into the page bar by
	    `_VisualPage`; remembered per browser. */
	}
	<div class="page-ctl" role="group" aria-label="Bookend ground" data-bk-tone-ctl>
		<span class="page-ctl__name">Bookend ground</span>
		<button type="button" data-bk-tone="own" aria-pressed="true">As set</button>
		<button type="button" data-bk-tone="dark" aria-pressed="false">Dark</button>
		<button type="button" data-bk-tone="light" aria-pressed="false">Light</button>
	</div>

	<Variant
		visual={kv('footer')}
		component={FooterStage}
		props={{ footer: 'map' }}
		bleed
		shipping
		name="Platform map"
		note="On the homepage in A and B since 2026-09-30 · brand row with the newsletter; a panel mapping the platform — the two platforms with their filled badges, the six ecosystem products on washes of their own hue, a line under each — then four link columns and the foot · on black under the closing band, no line at the seam"
	/>

	<Variant
		visual={kv('footer')}
		component={FooterStage}
		props={{ footer: 'focus' }}
		bleed
		name="Platforms and highlights"
		note="candidate · one Platform group of four peers — ThingsBoard Cloud, ThingsBoard, Pricing, Installation options — a mark and a name each, no lines; the six ecosystem products move to a link column in front of the other four, with the License portal at its foot"
	/>

	<Variant
		visual={kv('footer')}
		component={FooterStage}
		props={{ footer: 'in-use' }}
		bleed
		name="Site footer"
		note="the footer every other marketing page has, and the Live order: main's, under the same closing band"
	/>

	{
		/* ---- Bookends ------------------------------------------------------------------------------
	    The band that closes a page, as one component (`Landing/Bookend`, words in `data/bookends.ts`),
	    each over the footer that ships on A and B. "Home" is today's band, centred; the others are
	    columns — an intro beside the way in — with only what the decision needs. The regions and
	    guides are the installations hub's own. The ground switch above flips them all. */
	}
	<Variant
		visual={kv('footer')}
		component={FooterStage}
		props={{ bookend: { id: 'home', ways: 'buttons' } }}
		bleed
		name="Bookend · Home"
		note="reference · the homepage's closing band as the component: ClosingCta's words and buttons — Start free on Cloud, Install On-premises, and Talk to an expert under its question"
	/>

	<Variant
		visual={kv('footer')}
		component={FooterStage}
		props={{ bookend: { id: 'home', ways: 'regions' } }}
		bleed
		name="Bookend · Home, regions"
		note="regions first: the two white region cards under the lede, “Start free on Cloud” over them, and no buttons; beside them three side cards with no accent — Installation options, Pricing, Talk to an expert — each an icon, a name and one line"
	/>

	<Variant
		visual={kv('footer')}
		component={FooterStage}
		props={{ bookend: { id: 'cloud' } }}
		bleed
		name="Bookend · Cloud"
		note="two columns: the intro with Talk to an expert; “Try Cloud for free” over the two regions and See plans · the mark, the line to On-premises and the privacy note go (the footer has the privacy policy)"
	/>

	<Variant
		visual={kv('footer')}
		component={FooterStage}
		props={{ bookend: { id: 'onprem' } }}
		bleed
		name="Bookend · On-premises"
		note="two columns: the intro with Install for free and Talk to an expert; four platforms from the hub and all the options · the mark, pricing (in the footer), the line to Cloud and the licence note go"
	/>
</VisualPage>

{/* The homepage's context the section is drawn against: `_bleed-context.scss`. */}
<style lang="scss" is:global>
	@use '../bleed-context';
</style>

{/* The brief's chrome, as the flow pages carry it. */}
<style lang="scss">
	@use '../../../styles/variables' as *;

	.brief {
		max-width: 1200px;
		margin: 0 auto $spacing-12;
		padding: $spacing-6;
		border-radius: $radius-lg;
		background: var(--color-bg-secondary, #f5f6ff);
	}

	.brief__kicker {
		@include text-xs;
		margin: 0 0 $spacing-4;
		font-family: $font-family-mono;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-secondary, #5b616e);
	}

	.brief__facts {
		display: grid;
		gap: $spacing-3;
		margin: 0;

		> div {
			display: grid;
			grid-template-columns: 110px minmax(0, 1fr);
			gap: $spacing-4;

			@media (max-width: 599px) {
				grid-template-columns: 1fr;
				gap: $spacing-1;
			}
		}

		dt {
			@include text-s;
			font-family: $font-family-mono;
			color: var(--color-text-secondary, #5b616e);
		}

		dd {
			@include text-s;
			margin: 0;
			max-width: 80ch;
		}

		code {
			font-family: $font-family-mono;
			font-size: 0.92em;
		}

		em {
			font-style: normal;
			font-weight: $font-weight-medium;
		}
	}
</style>

<script>
	/**
	 * The bookends' ground switch. `As set` puts back each bookend's own `data-tone` (kept on first run
	 * as `data-tone-own`); `Dark` and `Light` set them all. Remembered in localStorage, and heard by the
	 * phone frames through the `storage` event, since they are documents of their own.
	 */
	const KEY = 'launch-visuals:bookend-tone';
	type Tone = 'own' | 'dark' | 'light';

	const read = (): Tone => {
		try {
			const v = localStorage.getItem(KEY);
			return v === 'dark' || v === 'light' ? v : 'own';
		} catch {
			return 'own';
		}
	};

	const apply = (tone: Tone) => {
		document.querySelectorAll<HTMLElement>('.bk').forEach((el) => {
			if (!el.dataset.toneOwn) el.dataset.toneOwn = el.dataset.tone;
			el.dataset.tone = tone === 'own' ? el.dataset.toneOwn : tone;
		});
		document.querySelectorAll<HTMLButtonElement>('[data-bk-tone]').forEach((b) => {
			b.setAttribute('aria-pressed', String(b.dataset.bkTone === tone));
		});
	};

	document.querySelectorAll<HTMLButtonElement>('[data-bk-tone]').forEach((b) =>
		b.addEventListener('click', () => {
			const tone = b.dataset.bkTone as Tone;
			try {
				localStorage.setItem(KEY, tone);
			} catch {
				/* the switch still works for this page */
			}
			apply(tone);
		})
	);

	window.addEventListener('storage', (e) => {
		if (e.key === KEY) apply(read());
	});

	apply(read());
</script>
