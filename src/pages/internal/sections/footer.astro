---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import Variant from '@root/pages/internal/_Variant.astro';
import FooterStage from '@root/pages/internal/_FooterStage.astro';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * The footer: every marketing page's last word, drawn here under the homepage's closing band.
 *
 * THE ONE IN USE (`Landing/Footer`) is a newsletter, four award badges, the logo, six links — Get
 * Started, Documentation, Use cases, Blog, Services, Contact us — and the social row. It names none
 * of the products, so a reader who reaches the bottom of any page is told nothing about what the
 * platform is made of.
 *
 * THE CANDIDATE (`Landing/FooterMap`, contents in `data/footer-map.ts`) maps it: the two ways to run
 * it and the six products around it, as the Products menu groups them, then four link columns —
 * Solutions, Developers, Services, Company — then the bottom line. `layout` sets how much room
 * the map takes: tiles with a line each, or one row of chips. Both are on black, a step down from
 * the closing band's indigo, with no line at the seam.
 *
 * PROMOTED 2026-09-30 to running orders A and B: "Platform map" closes the homepage there
 * (`footer: 'map'` in `data/home-compositions.ts`, read by `starlight/Footer.astro`). Live keeps
 * main's footer, and so does every other marketing page — "Site footer" below; the docs footer
 * (`DocFooter`) is not touched by either.
 */
---

<VisualPage visual="footer">
	<aside class="brief">
		<p class="brief__kicker">The footer</p>
		<dl class="brief__facts">
			<div>
				<dt>In use</dt>
				<dd>
					<em>Platform map</em> on the homepage in orders A and B. Everywhere else, and in Live, the site footer: newsletter
					and four badges, the logo beside six links, copyright and social, on <code>#0f161d</code> under the closing band’s
					<code>#121425</code>, naming no product.
				</dd>
			</div>
			<div>
				<dt>Asked</dt>
				<dd>A new footer that unpacks the platform, in place of the old, simple one.</dd>
			</div>
			<div>
				<dt>Candidate</dt>
				<dd>
					<code>components/Landing/FooterMap.astro</code> — <code>layout</code> (map · strip). The brand row with the newsletter;
					the platform as the Products menu groups it (<em>IoT platforms</em>, <em>Product ecosystem</em>), each product
					with its mark and hue; four link columns (no Build: it waits for the capability pages); GitHub, YouTube and
					LinkedIn only in the social row; copyright, cookie policy and the badges at the foot.
				</dd>
			</div>
			<div>
				<dt>Words</dt>
				<dd>
					The site’s own: the menu’s group names, each ecosystem card’s kicker, the Products section’s sentence split
					for the two platforms, main’s meta description under the logo, the newsletter’s words verbatim. Every link
					names a page that exists in <code>src/pages/</code> or the docs.
				</dd>
			</div>
			<div>
				<dt>WIP</dt>
				<dd>
					Where case studies go. The footer has no link to them (they were Solutions’ last link, and read as one more
					use case); Clients feedback is in Company. A <em>Customers</em> group under Solutions (both, case studies arrowed)
					was tried and parked undecided — <code>FOOTER_CUSTOMERS_WIP</code> in
					<code>data/footer-map.ts</code>.
				</dd>
			</div>
			<div>
				<dt>Not done</dt>
				<dd>
					The rest of the marketing pages (they keep <code>Landing/Footer</code>; A and B have the map). MailerLite’s
					success state (the form posts to a new tab, as the one in use does today).
				</dd>
			</div>
		</dl>
	</aside>

	<Variant
		visual={kv('footer')}
		component={FooterStage}
		props={{ footer: 'map' }}
		bleed
		shipping
		name="Platform map"
		note="On the homepage in A and B since 2026-09-30 · brand row with the newsletter; a panel mapping the platform — the two platforms with their filled badges, the six ecosystem products on washes of their own hue, a line under each — then four link columns and the foot · on black under the closing band, no line at the seam"
	/>

	<Variant
		visual={kv('footer')}
		component={FooterStage}
		props={{ footer: 'focus' }}
		bleed
		name="Platforms and highlights"
		note="candidate · one Platform group of four peers — ThingsBoard Cloud, ThingsBoard, Pricing, Installation options — a mark and a name each, no lines; the six ecosystem products move to a link column in front of the other four, with the License portal at its foot"
	/>

	<Variant
		visual={kv('footer')}
		component={FooterStage}
		props={{ footer: 'strip' }}
		bleed
		name="Platform strip"
		note="the same map as one wrapping row of chips — marks and names, no lines, no panel · a third of the height, for a footer that should stay a footer"
	/>

	<Variant
		visual={kv('footer')}
		component={FooterStage}
		props={{ footer: 'in-use' }}
		bleed
		name="Site footer"
		note="the footer every other marketing page has, and the Live order: main's, under the same closing band"
	/>
</VisualPage>

{/* The homepage's context the section is drawn against: `_bleed-context.scss`. */}
<style lang="scss" is:global>
	@use '../bleed-context';
</style>

{/* The brief's chrome, as the flow pages carry it. */}
<style lang="scss">
	@use '../../../styles/variables' as *;

	.brief {
		max-width: 1200px;
		margin: 0 auto $spacing-12;
		padding: $spacing-6;
		border-radius: $radius-lg;
		background: var(--color-bg-secondary, #f5f6ff);
	}

	.brief__kicker {
		@include text-xs;
		margin: 0 0 $spacing-4;
		font-family: $font-family-mono;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-secondary, #5b616e);
	}

	.brief__facts {
		display: grid;
		gap: $spacing-3;
		margin: 0;

		> div {
			display: grid;
			grid-template-columns: 110px minmax(0, 1fr);
			gap: $spacing-4;

			@media (max-width: 599px) {
				grid-template-columns: 1fr;
				gap: $spacing-1;
			}
		}

		dt {
			@include text-s;
			font-family: $font-family-mono;
			color: var(--color-text-secondary, #5b616e);
		}

		dd {
			@include text-s;
			margin: 0;
			max-width: 80ch;
		}

		code {
			font-family: $font-family-mono;
			font-size: 0.92em;
		}

		em {
			font-style: normal;
			font-weight: $font-weight-medium;
		}
	}
</style>
