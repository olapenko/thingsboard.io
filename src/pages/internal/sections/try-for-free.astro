---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import Variant from '@root/pages/internal/_Variant.astro';
import CloudSignup from '@root/pages/internal/_CloudSignup.astro';
import TryFreeDialog from '@root/pages/internal/_TryFreeDialog.astro';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * The "Try for free" funnel — where the primary button goes, and what it lands on.
 *
 * Not a section. The two directions here are the two ends of one path: the CHOOSER the CTA could
 * open on the site, and the SIGN-UP PAGE in the product that the path ends on, drafted with the one
 * control that lets the region be corrected there instead of asked for up front. Both are `bleed`
 * directions because both are whole screens — the hero's column and the product's page — and the
 * phone frame is the only honest view of a bottom sheet or a stacked card.
 *
 * WHAT IT IS TODAY (2026-09-24, on FE-handoff): the hero's "Try for free" goes straight to
 * `thingsboard.cloud/signup` — North America, with no way to Europe once there — while the
 * header's goes to `/installations/`, a four-tab product catalogue with the two region buttons
 * under its first tab. Same label, two destinations; three clicks and two decisions on the header
 * path before a form appears.
 *
 * WHERE THIS IS HEADED: one destination for both buttons — the sign-up page of the region the site
 * picks by geography — with the region switch IN the form as the correction, and `/installations/`
 * kept as the Install button's page. The dialog is the fallback for as long as the product's form
 * has no switch: it keeps Europe visible on the site side at the cost of one decision. The geo
 * default itself and the hub's rewrite are not drafted here.
 *
 * The brief under the strip carries the facts a reader of this page needs without the analysis it
 * came from; `_CloudSignup` and `_TryFreeDialog` each say why they are shaped as they are.
 */
---

<VisualPage visual="try-for-free">
	<aside class="brief">
		<p class="brief__kicker">The funnel</p>
		<dl class="brief__facts">
			<div>
				<dt>Today</dt>
				<dd>
					Hero <em>Try for free</em> → <code>thingsboard.cloud/signup</code> (US only, no way to EU). Header
					<em>Try for free</em> → <code>/installations/</code> → region → sign-up. Same label, two destinations.
				</dd>
			</div>
			<div>
				<dt>Drafted here</dt>
				<dd>
					The product's sign-up page with a data-region switch, checked from the host the site sent the visitor to. A
					thin dialog for the CTA: two regions, the nearest marked, self-hosting one line below.
				</dd>
			</div>
			<div>
				<dt>Not drafted</dt>
				<dd>
					The geo default (edge <code>CF-IPCountry</code>, client <code>Intl</code> timezone) and
					<code>/installations/</code> rewritten as the Install page.
				</dd>
			</div>
			<div>
				<dt>Peers</dt>
				<dd>
					PostHog, Sentry, Datadog and Bitwarden ask the region inside the form, defaulted. Grafana, HiveMQ and Supabase
					send the CTA straight to sign-up. EMQX has a chooser page, and even its Cloud tab asks no region.
				</dd>
			</div>
		</dl>
	</aside>

	<Variant
		visual={kv('try-for-free')}
		component={CloudSignup}
		props={{ region: 'us' }}
		bleed
		name="Sign-up page · data-region switch"
		note="the thingsboard.cloud/signup card, form only, at the live card's measures · the switch sits between the logo and the providers, checked from the host — see the component's note on preselection"
	/>

	<Variant
		visual={kv('try-for-free')}
		component={TryFreeDialog}
		props={{ id: 'tfd-plain', nearest: 'us' }}
		bleed
		name="Dialog · region first, install demoted"
		note="candidate · the CTA opens a thin chooser on the hero: two region cards, the nearest chipped and focused, self-hosting as a line beneath; a bottom sheet under 560"
	/>
</VisualPage>

<style lang="scss">
	@use '../../../styles/variables' as *;

	.brief {
		max-width: 1200px;
		margin: 0 auto $spacing-12;
		padding: $spacing-6;
		border-radius: $radius-lg;
		background: var(--color-bg-secondary, #f5f6ff);
	}

	.brief__kicker {
		@include text-xs;
		margin: 0 0 $spacing-4;
		font-family: $font-family-mono;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-secondary, #5b616e);
	}

	.brief__facts {
		display: grid;
		gap: $spacing-3;
		margin: 0;

		> div {
			display: grid;
			grid-template-columns: 110px minmax(0, 1fr);
			gap: $spacing-4;

			@media (max-width: 599px) {
				grid-template-columns: 1fr;
				gap: $spacing-1;
			}
		}

		dt {
			@include text-s;
			font-family: $font-family-mono;
			color: var(--color-text-secondary, #5b616e);
		}

		dd {
			@include text-s;
			margin: 0;
			max-width: 80ch;
		}

		code {
			font-family: $font-family-mono;
			font-size: 0.92em;
		}

		em {
			font-style: normal;
			font-weight: $font-weight-medium;
		}
	}
</style>
