---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import Variant from '@root/pages/internal/_Variant.astro';
import NormalizeSeries from '@components/Landing/NormalizeSeries.astro';
import AutomateSwitch from '@components/Landing/AutomateSwitch.astro';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * Normalize — the transform flow, and since running order A the first of three.
 *
 * Its own route, so opening it compiles and renders this visual and nothing else. `_VisualPage`
 * carries what every visual's page shares: the strip of links between them and the promote/retire
 * control.
 *
 * The design's "Turn IoT data into action" section made two arguments under one heading: normalize
 * the data, then act on it. `AutomateSwitch` is the second argument drawn at last, in two steps —
 * Filter and Notify — on this drawing's own skeleton, with a switch over the three. The row's copy
 * already named all three steps, so it did not need splitting after all.
 */
---

<VisualPage visual="normalize">
	{
		/* The switch first: it is what `/` renders (running orders A and B), promoted 2026-09-27 over the
	    switch with the mark, which stays below as the reference, pinned to both of its drawings so a
	    default that moves cannot move it. Pulse is the handoff's, and main's: it runs on
	    `/internal/homepages/live/`, and Still is what Pulse was judged against. */
	}
	<Variant
		visual={kv('normalize')}
		component={AutomateSwitch}
		props={{ id: 'sandbox-automate-chart', filter: 'chart', notify: 'feed' }}
		shipping
		name="Switch without the mark"
		note="Shipping in A and B · Filter as the morning's openings in bars against a draggable 3:00 limit, the live one climbing past it and the alarm opening where it crosses; Notify as the alarm node and one line curving to four channels, each opening in turn into its message, clickable; Normalize as before (2026-09-27)"
	/>

	<Variant
		visual={kv('normalize')}
		component={AutomateSwitch}
		props={{ id: 'sandbox-automate', filter: 'flow', notify: 'flow' }}
		name="Switch"
		note="previous · Normalize · Filter · Notify, one skeleton, a switch over the row’s media; the mark holds its place across all three, and no caption under the drawing (2026-09-26)"
	/>

	<Variant
		visual={kv('normalize')}
		component={NormalizeSeries}
		props={{ motion: 'pulse' }}
		name="Pulse"
		note="One pip per device, in and out a transit later — the handoff’s"
	/>

	<Variant
		visual={kv('normalize')}
		component={NormalizeSeries}
		name="Still"
		note="the same drawing with no motion — what the pulse has to earn its place against"
	/>
</VisualPage>
