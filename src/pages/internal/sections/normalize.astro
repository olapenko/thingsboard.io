---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import Variant from '@root/pages/internal/_Variant.astro';
import NormalizeSeries from '@components/Landing/NormalizeSeries.astro';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * Normalize — the transform flow.
 *
 * Its own route, so opening it compiles and renders this visual and nothing else. `_VisualPage`
 * carries what every visual's page shares: the strip of links between them and the promote/retire
 * control.
 *
 * First half of the design's "Turn IoT data into action" section. The second half — a rule chain
 * raising an alarm and notifying — is a separate argument and will be its own visual, so the copy
 * in this row still covers both and will need splitting with it.
 */
---

<VisualPage visual="normalize">
	{
		/* Two directions, and the difference between them is the whole question: whether the movement
	    adds anything. That is only answerable against the same drawing holding still, which is why
	    the still cut is a direction of its own rather than a probe under this one. */
	}
	<Variant
		visual={kv('normalize')}
		component={NormalizeSeries}
		props={{ motion: 'pulse' }}
		shipping
		name="Pulse"
		note="One pip per device, in and out a transit later"
	/>

	<Variant
		visual={kv('normalize')}
		component={NormalizeSeries}
		name="Still"
		note="the same drawing with no motion — what the pulse has to earn its place against"
	/>
</VisualPage>
