---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import Variant from '@root/pages/internal/_Variant.astro';
import NormalizeSeries from '@components/Landing/NormalizeSeries.astro';
import AutomateSwitch from '@components/Landing/AutomateSwitch.astro';
import FilterChart from '@components/Landing/FilterChart.astro';
import FilterFlow from '@components/Landing/FilterFlow.astro';
import NotifyFeed from '@components/Landing/NotifyFeed.astro';
import NotifyFlow from '@components/Landing/NotifyFlow.astro';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * Data — "Turn IoT data into action": the row, and each of the three visuals it can hold.
 *
 * Its own route, so opening it compiles and renders this row and nothing else. `_VisualPage`
 * carries what every visual's page shares: the strip of links between them and the promote/retire
 * control.
 *
 * FOUR GROUPS (`<Variant group>`), since 2026-09-30. ROW is the row as a whole — three visuals under
 * a switch (A and B), or Normalize alone (Live, and the handoff). Then one group per visual, NORMALIZE,
 * FILTER and NOTIFY, each judged in the row on its own, so a version of one drawing is compared with
 * the other versions of that drawing rather than behind two clicks in the switch. Each group's own
 * direction in use comes first.
 *
 * The design's "Turn IoT data into action" section made two arguments under one heading: normalize
 * the data, then act on it. `AutomateSwitch` is the second argument drawn at last, in two steps —
 * Filter and Notify — on this drawing's own skeleton, with a switch over the three. The row's copy
 * already named all three steps, so it did not need splitting after all.
 */
---

<VisualPage visual="normalize">
	{/* ── Row: one visual or three ─────────────────────────────────────────────────────────────── */}
	<Variant
		visual={kv('normalize')}
		group="Row"
		component={AutomateSwitch}
		props={{ id: 'sandbox-automate-chart', filter: 'chart', notify: 'feed' }}
		shipping
		name="Three visuals, a switch over them"
		note="In use in A and B · Normalize, Filter and Notify under one switch: Filter as the chart, Notify as the feed, no mark (2026-09-27)"
	/>

	<Variant
		visual={kv('normalize')}
		group="Row"
		component={NormalizeSeries}
		props={{ motion: 'pulse' }}
		name="One visual, Normalize alone"
		note="The Live order's, and the handoff's · the Normalize drawing pulsing, and nothing to switch"
	/>

	{/* Pinned to both of its drawings, so a default that moves cannot move it. */}
	<Variant
		visual={kv('normalize')}
		group="Row"
		component={AutomateSwitch}
		props={{ id: 'sandbox-automate', filter: 'flow', notify: 'flow' }}
		name="Three visuals, the mark held across"
		note="previous · the three on one skeleton under the switch, the mark holding its place as it changes; no caption under the drawing (2026-09-26)"
	/>

	{/* ── Normalize ─────────────────────────────────────────────────────────────────────────────── */}
	<Variant
		visual={kv('normalize')}
		group="Normalize"
		component={NormalizeSeries}
		props={{ motion: 'pulse' }}
		shipping
		name="Pulse"
		note="In use in every order · one pip per device, in and out a transit later — the handoff's, and main's"
	/>

	<Variant
		visual={kv('normalize')}
		group="Normalize"
		component={NormalizeSeries}
		name="Still"
		note="The same drawing with no motion — what the pulse has to earn its place against"
	/>

	{/* ── Filter ────────────────────────────────────────────────────────────────────────────────── */}
	<Variant
		visual={kv('normalize')}
		group="Filter"
		component={FilterChart}
		shipping
		name="Chart"
		note="In use in A and B · the morning's openings as bars against a draggable 3:00 limit; the live one climbs past it and the alarm opens where it crosses; no mark (2026-09-27)"
	/>

	<Variant
		visual={kv('normalize')}
		group="Filter"
		component={FilterFlow}
		name="Flow"
		note="previous · the spark, the mark and the alarm, as the switch first shipped (2026-09-26)"
	/>

	{
		/* ── Notify ──────────────────────────────────────────────────────────────────────────────────
		   The feed's heads, 2026-09-30. The right-hand column mixed two people, a Slack channel and the
		   CRM's route; each of the others says one kind of thing for all four (`NOTIFY_ASIDES`), and
		   wherever the column goes, "via n8n" goes onto the ticket. The address won. */
	}
	<Variant
		visual={kv('normalize')}
		group="Notify"
		component={NotifyFeed}
		props={{ aside: 'address' }}
		shipping
		name="Feed · the address, beside the channel"
		note="In use in A and B since 2026-09-30 · where it landed in each channel's own notation: an email address, a number, #cold-chain, a ticket; via n8n on the ticket"
	/>

	<Variant
		visual={kv('normalize')}
		group="Notify"
		component={NotifyFeed}
		props={{ aside: 'address-time' }}
		name="Feed · the address beside, when on the right"
		note="Candidate 2026-09-30 · where each landed, in its channel's notation, after the channel; the time it landed on the right"
	/>

	<Variant
		visual={kv('normalize')}
		group="Notify"
		component={NotifyFeed}
		props={{ aside: 'who' }}
		name="Feed · who, beside the channel"
		note="Candidate 2026-09-30 · the people each channel reaches, after its name: Store manager, On-call tech, Cold-chain team, Service desk; no column"
	/>

	<Variant
		visual={kv('normalize')}
		group="Notify"
		component={NotifyFeed}
		props={{ aside: 'who-time' }}
		name="Feed · who beside, when on the right"
		note="Candidate 2026-09-30 · the people after the channel, and the column kept for one thing: the time each landed, a second or three after the alarm"
	/>

	<Variant
		visual={kv('normalize')}
		group="Notify"
		component={NotifyFeed}
		props={{ aside: 'time' }}
		name="Feed · when, on the right"
		note="Candidate 2026-09-30 · the column as delivery times only, in the node's clock face, so it is one width down all four"
	/>

	<Variant
		visual={kv('normalize')}
		group="Notify"
		component={NotifyFeed}
		props={{ aside: 'none' }}
		name="Feed · the channel alone"
		note="Candidate 2026-09-30 · nothing beside the channel; the message says the rest"
	/>

	<Variant
		visual={kv('normalize')}
		group="Notify"
		component={NotifyFeed}
		props={{ aside: 'to' }}
		name="Feed · who or where, on the right"
		note="previous, 2026-09-27 to 2026-09-30 · Store manager, On-call tech, #cold-chain, via n8n: two people, a channel and a route in one column"
	/>

	<Variant
		visual={kv('normalize')}
		group="Notify"
		component={NotifyFlow}
		name="Flow"
		note="previous · the alarm through the mark into four messages at once, as the switch first shipped (2026-09-26)"
	/>
</VisualPage>
