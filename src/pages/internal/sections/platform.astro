---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import Variant from '@root/pages/internal/_Variant.astro';
import PlatformClear from '@components/Landing/PlatformClear.astro';
import { PLATFORM_SECTION_COPY } from '@data/platform-visual';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * The platform overview — equipment, people, and the loop between them.
 *
 * NO FEATURE ROW on this page, unlike every other visual here. This one is a full-width section
 * diagram, not a media slot: a row hands its media 525px, and at 525 this composition is already in
 * its stacked form. Judging it in a row would be judging a different picture.
 *
 * It is shown in the CENTRED section instead: the homepage's own statement block, with the real
 * copy, and the visual under it rather than beside it, as it runs first thing below the hero. Under
 * it, a 950 probe: the width the wide form is least legible at, and the way to see whether a change
 * to the drawing actually moved the floor.
 *
 * `PlatformClear` is on the homepage. `PlatformRaised`, the one it replaced, and `PlatformLoop`
 * before that were retired from this page on 2026-09-25; their files stay, because `PlatformClear`'s
 * header reads as differences from them and points to `PlatformLoop` for the foundations strip.
 */
---

<VisualPage visual="platform">
	{
		/* The foundations strip is off by default. It is three more things to read in the
	    densest part of the picture and it carries none of the argument, but it is the only claim
	    about what sits under the four stages — so it is switchable here rather than deleted, and the
	    switch covers every probe on the page at once so the two states are compared like for like. */
	}
	<div class="page-ctl">
		<span class="page-ctl__name">Foundations strip</span>
		<button type="button" data-found-toggle aria-pressed="false">Off</button>
	</div>

	<Variant
		visual={kv('platform')}
		component={PlatformClear}
		intro={PLATFORM_SECTION_COPY}
		shipping
		name="Centred"
		note="The centred section, statement over the visual"
	/>

	<Variant
		visual={kv('platform')}
		component={PlatformClear}
		deskWidth={950}
		name="At 950"
		note="the width the drawing is hardest to read at: wide form, unit 0.842, floor u(14) at 11.8px"
	/>
</VisualPage>

<script>
	// The foundations switch. Sets the attribute the component's own CSS reads, on every view on the
	// page at once, and remembers the choice so a reload does not reset it mid-comparison. The
	// component's root is `.plat`, so one selector reaches both views.
	const KEY = 'launch-visuals:platform-foundations';
	const btn = document.querySelector<HTMLButtonElement>('[data-found-toggle]');
	const targets = Array.from(document.querySelectorAll<HTMLElement>('.plat'));

	const apply = (on: boolean) => {
		targets.forEach((t) => t.toggleAttribute('data-found', on));
		if (!btn) return;
		btn.setAttribute('aria-pressed', String(on));
		btn.textContent = on ? 'On' : 'Off';
	};

	let saved = false;
	try {
		saved = localStorage.getItem(KEY) === 'on';
	} catch {
		/* private window; the default is fine */
	}
	apply(saved);

	btn?.addEventListener('click', () => {
		const on = btn.getAttribute('aria-pressed') !== 'true';
		apply(on);
		try {
			localStorage.setItem(KEY, on ? 'on' : 'off');
		} catch {
			/* ignore */
		}
	});
</script>

<style lang="scss">
	@use '../../../styles/variables' as *;

	.lede {
		@include text-s;
		max-width: 1200px;
		margin: 0 auto $spacing-6;
		color: var(--color-text-secondary, #5b616e);
	}
</style>
