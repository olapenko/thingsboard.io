---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import Variant from '@root/pages/internal/_Variant.astro';
import ChoiceCards from '@root/pages/internal/_ChoiceCards.astro';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * The choice cards — the Cloud page's Public/Private pair and the On-premises page's licence pair,
 * each on its own page's dark ground. A component check, not a homepage section: the cards ship on
 * those two pages, and treatments get judged here before touching them there.
 *
 * 2026-09-24, judged here on arrival: the hairline retired (the 6% fill holds the edge alone, the
 * same call the deployment pair's glass direction settled), and each option's glyph now rides its
 * CTA — the homepage pair's promoted treatment, carried over.
 */
---

<VisualPage visual="choice">
	<Variant
		visual={kv('choice')}
		component={ChoiceCards}
		props={{ source: 'paas' }}
		bleed
		name="Cloud · Public vs Private"
		note="shipping · the Cloud page's pair on its #choose ground; no hairline, glyphs on the CTAs"
	/>

	<Variant
		visual={kv('choice')}
		component={ChoiceCards}
		props={{ source: 'onprem' }}
		bleed
		name="On-premises · subscription vs perpetual"
		note="shipping · the licence pair on the PE page's own green-tinted ground"
	/>
</VisualPage>
