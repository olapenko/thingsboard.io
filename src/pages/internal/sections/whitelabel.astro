---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import Variant from '@root/pages/internal/_Variant.astro';
import WhiteLabelApp from '@components/Landing/WhiteLabelApp.astro';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * White-labeling — the branded app.
 *
 * Its own route, so opening it compiles and renders this visual and nothing else. `_VisualPage`
 * carries what every visual's page shares: the strip of links between them and the promote/retire
 * control.
 */
---

<VisualPage visual="whitelabel">
	{
		/* The published section shows a screenshot of the White Labeling settings form. This shows the
	    result instead: one app, three customers, and a control that swaps between them.

	    Rotation is off on the phone. It is not a second direction — it is the same drawing with the
	    one prop that only means something at a width where the control is the only way through. */
	}
	<Variant
		visual={kv('whitelabel')}
		component={WhiteLabelApp}
		phoneProps={{ autoRotate: false }}
		name="One app"
		note="one app, three customers, a control that swaps between them — rotates on its own until a click takes over"
	/>
</VisualPage>
