---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import Variant from '@root/pages/internal/_Variant.astro';
import ConnectCloud from '@components/Landing/ConnectCloud.astro';
import ConnectCloudOpen from '@components/Landing/ConnectCloudOpen.astro';
import ConnectHub from '@components/Landing/ConnectHub.astro';
import ConnectFlow from '@components/Landing/ConnectFlow.astro';
import { CONNECT_ROUTES } from '@data/connect-visual';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * Connect devices — the hub that ships, and everything it was chosen over.
 *
 * Its own route, so opening it compiles and renders this visual and nothing else. `_VisualPage`
 * carries what every visual's page shares: the strip of links between them and the promote/retire
 * control.
 *
 * Three families here, in the order they were made backwards: the HUB says "everything arrives at
 * one place" and draws the arrival; the CLOUD says "whatever you have is already in here" and is
 * deliberately unordered; ConnectFlow says "four ways in" and names them. The shipped one is first.
 */
const connect = kv('connect');
---

<VisualPage visual="connect">
	{
		/* SHIPPED. Five a side on the four-arm cut's metrics — same chip size, column and pitch, so
	    the pair below shows only what a fifth arm costs.

	    The sketch had a device icon on the outer end of every line. They are gone and the line
	    dissolves into the page instead: ten glyphs is ten more things to read in a picture about
	    protocols, and each one claims a device-to-protocol pairing that is a simplification. A line
	    that fades says "and whatever else you have" without naming anything. */
	}
	<Variant
		visual={connect}
		component={ConnectHub}
		props={{ arms: 'five' }}
		shipping
		name="Five arms"
		note="Five a side, ten protocols, colour as texture"
	/>

	{/* The four-arm cut, which the five is an extension of rather than a replacement for. */}
	<Variant
		visual={connect}
		component={ConnectHub}
		name="Four arms"
		note="four a side, larger chips, the metrics the five inherits"
	/>

	{
		/* The advised twelve in two ranks: four inner, two tucked into the gaps further out with
	    their lines running through between. Shorter than the single-rank cut and much wider — a
	    second chip column on each side is what it costs, and the width shows up as smaller type on
	    a phone. */
	}
	<Variant
		visual={connect}
		component={ConnectHub}
		props={{ arms: 'six-stagger' }}
		name="Staggered"
		note="the advised twelve in two ranks — shorter, and much wider"
	/>

	{
		/* The twelve the CEO advised, as drawn. Colour is the four-hue rotation — see the component
	    for why that set cannot be coded by route without one hue appearing once. */
	}
	<Variant
		visual={connect}
		component={ConnectHub}
		props={{ arms: 'six-advised' }}
		name="Advised twelve"
		note="the set as drawn · colour as texture, because this one cannot be coded by route"
	/>

	{/* The same twelve arms with names picked four per route, so colour codes rather than decorates. */}
	<Variant
		visual={connect}
		component={ConnectHub}
		props={{ arms: 'six' }}
		name="Six arms"
		note="twelve names chosen four per route, so the hues code rather than decorate"
	/>

	{
		/* --- the cloud, vendor-neutral and in three colours -------------------------------------
	    Same composition and same 422 units as the cut below, so the two are a true A/B: the only
	    things that differ are the words and the number of accents.

	    Where the older cloud names ChirpStack, TTN, LORIOT, ThingPark, AWS IoT, Azure IoT, Pub/Sub
	    and AWS SQS, this names the category — "MQTT brokers", "Cloud platforms". And four routes
	    fold into three: straight in, through a gateway, through an integration, which is how the
	    connectivity guide groups them and takes the tightest accent pair from dE 4.02 to dE 8.7. */
	}
	<Variant
		visual={connect}
		component={ConnectCloudOpen}
		name="Cloud · open"
		note="the cloud with no vendor names and three accents"
	/>

	{
		/* The cloud drops its group captions, so its four accents are the only thing saying which
	    route a chip belongs to — and how loudly they say it is the open question.

	    "Tinted · light" is the same coding at 10% rather than 18%, and it is worth checking what
	    that costs as well as what it buys: the four hues get harder to tell from each other the
	    paler they are, and telling them apart is the entire job.

	    A coloured stripe down each chip was tried and dropped: too noisy at twenty-four of them. */
	}
	<div class="page-ctl" role="group" aria-label="Cloud chip style" data-chip-switch>
		<span class="page-ctl__name">Cloud chips</span>
		<button type="button" data-chip-pick="tint" aria-pressed="true">Tinted</button>
		<button type="button" data-chip-pick="tint-light" aria-pressed="false">Tinted · light</button>
		<button type="button" data-chip-pick="text" aria-pressed="false">White + colour text</button>
	</div>

	{
		/* Names and accents come from CONNECT_ROUTES, so the cuts cannot disagree about what is
	    supported or what colour a route is. The four accents group the chips and nothing names the
	    grouping: the copy used to key them with coloured marks on four terms, and that key has been
	    removed. The hues now read as texture across twenty-four names rather than as four families. */
	}
	<Variant
		visual={connect}
		component={ConnectCloud}
		name="Cloud · vendors"
		note="the cloud with vendor names and four accents, no key"
	/>

	{/* --- the routes, the family both clouds replaced ------------------------------------- */}
	{
		/* The alternative grouping: the four routes the connectivity guide defines, rather than three
	    that merge LPWAN networks into "networks & clouds". Kept beside the three-group version rather
	    than replacing it — the simpler read and the accurate one are a real trade, and the fourth
	    card costs height the phone width can least afford. */
	}
	<Variant
		visual={connect}
		component={ConnectFlow}
		props={{ groups: CONNECT_ROUTES }}
		name="Flow · 4 routes"
		note="superseded · as the connectivity guide groups them · shadow surface (the default)"
	/>

	{
		/* Two routes each side of the node, which trades width for height: the same four routes are
	    412 units tall stacked and 196 split. For a full-bleed band rather than a column, so its
	    desktop view is a section width rather than the row. */
	}
	<Variant
		visual={connect}
		component={ConnectFlow}
		props={{ groups: CONNECT_ROUTES, layout: 'split' }}
		deskWidth={1120}
		name="Flow · split"
		note="superseded · 2 routes → app ← 2 routes, for a full-bleed band"
	/>

	{
		/* An EXHIBIT, not a direction: the split layout's handover, one pixel either side of it. 1000
	    is the last width that still gets the wide arrangement and 999 regroups into one column, so
	    this pair is the only record of where the threshold sits. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">Flow · split · threshold</span>
			<span class="stage__note">exhibit · 1000px still wide, 999px regrouped</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 1000px">
				<ConnectFlow groups={CONNECT_ROUTES} layout="split" />
			</div>
			<div class="probe" style="--probe: 999px">
				<ConnectFlow groups={CONNECT_ROUTES} layout="split" />
			</div>
		</div>
	</figure>
</VisualPage>

<script>
	// The cloud's chip coding. Drives `data-chip` on every ConnectCloud on the page, which is the
	// same attribute the component's own prop sets — so the sandbox and a real page cannot disagree
	// about what a value means.
	const CHIP_KEY = 'launch-visuals:chip';
	document.querySelectorAll<HTMLElement>('[data-chip-switch]').forEach((group) => {
		const picks = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-chip-pick]'));
		// Every cloud on the page. It used to be scoped to `[data-page-panel="connect"]`, back when
		// nine visuals shared one page and the selector had to say which panel it meant; this page
		// holds nothing but Connect, and that wrapper no longer exists.
		const clouds = Array.from(document.querySelectorAll<HTMLElement>('.cl'));
		// Two things from one pick: `data-chip` chooses the coding, `--connect-tint` its strength. The
		// property goes on :root rather than on the clouds because the section's copy reads it too,
		// and that copy is not inside any of them.
		const apply = (value: string) => {
			clouds.forEach((c) => c.setAttribute('data-chip', value === 'tint-light' ? 'tint' : value));
			if (value === 'tint-light') document.documentElement.style.setProperty('--connect-tint', '10%');
			else document.documentElement.style.removeProperty('--connect-tint');
			picks.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.chipPick === value)));
		};
		let saved: string | null = null;
		try {
			saved = localStorage.getItem(CHIP_KEY);
		} catch {
			/* private mode; fine */
		}
		if (saved) apply(saved);
		picks.forEach((b) =>
			b.addEventListener('click', () => {
				const value = b.dataset.chipPick ?? 'tint';
				apply(value);
				try {
					localStorage.setItem(CHIP_KEY, value);
				} catch {
					/* ignore */
				}
			})
		);
	});
</script>
