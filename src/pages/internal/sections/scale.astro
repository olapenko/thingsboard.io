---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import Variant from '@root/pages/internal/_Variant.astro';
import ScaleGrowth from '@components/Landing/ScaleGrowth.astro';
import ScaleDuo from '@components/Landing/ScaleDuo.astro';
import ScaleGrid from '@components/Landing/ScaleGrid.astro';
import ScalePair from '@components/Landing/ScalePair.astro';
import ScaleSetup from '@components/Landing/ScaleSetup.astro';
import { SCALE_CANDIDATE_COPY, SCALE_MODES_ALT } from '@data/scale-visual';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * Scale — the two-mode card and the cuts it was chosen over.
 *
 * Its own route, so opening it compiles and renders this visual and nothing else. `_VisualPage`
 * carries what every visual's page shares: the strip of links between them and the promote/retire
 * control.
 *
 * The scale half of "Deploy anywhere, scale without surprises", split off from the deployment half.
 * Every figure is from the repo's own 24h benchmarks rather than an estimate — see
 * `src/data/scale-visual.ts` for which scenario each one comes from.
 *
 * Eleven directions, newest first, which is also roughly worst-to-best backwards: the run from the
 * abstract field at the foot to the two-mode card at the top is the argument this page records.
 */
---

<VisualPage visual="scale">
	{
		/* SHIPPED. The homepage renders this, so the top of this page is no longer a proposal but the
	    thing itself — kept because the sandbox is where it is seen at a width the homepage does not
	    offer. Two deployment modes and nothing else: hybrid storage left the drawing and joined the
	    chip list, where it always belonged, because it is a choice of database and not a topology.

	    The colour is now on the FIELD rather than on the card: same two hues, same 6-to-14% strength,
	    but the card is a plain white surface and the wash has moved into the drawing's empty cells.
	    A tinted panel with a drawing on it made the panel the object; a white card with one coloured
	    object on it makes the drawing the object, which is what the four visuals above this row
	    already do. */
	}
	<Variant
		visual={kv('scale')}
		component={ScaleDuo}
		props={{ animate: true, hue: 'field' }}
		shipping
		name="Duo · field hue"
		note="White cards, the wash in the cells, ingest ripple"
	/>

	{
		/* The same cut with the colour where it used to be — on the card, at 6%, with white cells.
	    Held so the swap can be judged against what it replaced rather than from memory. */
	}
	<Variant
		visual={kv('scale')}
		component={ScaleDuo}
		props={{ animate: true }}
		name="Duo · card hue"
		note="former · what the homepage rendered before the field carried the colour"
	/>

	{
		/* The same cut with the cards' second copy draft: what you operate, and what happens on the
	    bad day. The only difference is the words on the two cards. */
	}
	<Variant
		visual={kv('scale')}
		component={ScaleDuo}
		props={{ modes: SCALE_MODES_ALT, animate: true }}
		name="Duo · copy B"
		note="card copy draft 2 · what you operate, and what happens on the bad day"
	/>

	{/* Held for comparison, not proposed. */}
	<Variant visual={kv('scale')} component={ScaleSetup} name="Setup" note="fifth cut · mode, fleet, machines, stack" />

	{
		/* The FORMER incumbent. It rendered the scale section of the homepage until ScaleDuo replaced
	    it, and nothing renders it there now — it stays on disk, and on this page, so the thing the
	    candidate was measured against is still on screen beside it. */
	}
	<Variant
		visual={kv('scale')}
		component={ScaleGrowth}
		name="Growth"
		note="former incumbent · what the homepage rendered before ScaleDuo"
	/>

	{
		/* --- sixth cut -----------------------------------------------------------------------
	    Two topologies as peers, with hybrid storage drawn as the thing that joins them rather than a
	    step between them. The docs list TWO deployment architectures and put storage in a separate
	    table; all four combinations exist, so the three-card row was one axis pretending to be
	    another. Each card states both of its ceilings, and the step between them is the join's
	    doing. */
	}
	<Variant
		visual={kv('scale')}
		component={ScalePair}
		name="Pair"
		note="sixth cut · two topologies, storage as the option across both"
	/>

	{
		/* The levelled cut with each technology's own mark in place of its chip, drawn monochrome so
	    four brand palettes do not land on a card built on one. The PREVIOUS candidate — its copy was
	    rewritten because the original contradicted it, so this row carries that draft and ScaleDuo's
	    put the million back on the single-server card. */
	}
	<Variant
		visual={SCALE_CANDIDATE_COPY}
		component={ScaleGrid}
		props={{ equalHeight: true, thirdRole: true, logos: true }}
		name="Grid · logos"
		note="previous candidate · abstract field, three modes, marks only, no words"
	/>

	{
		/* Grouping: what STORES the telemetry on one line, what MOVES it on the next, rather than one
	    arbitrary run. It also makes the Hybrid-to-Cluster step read as "a second group appears". */
	}
	<Variant
		visual={kv('scale')}
		component={ScaleGrid}
		props={{ equalHeight: true, thirdRole: true, logos: true, grouped: true }}
		name="Grid · logos grouped"
		note="both at once · marks only, split into storage and transport"
	/>

	<Variant
		visual={kv('scale')}
		component={ScaleGrid}
		props={{ equalHeight: true, thirdRole: true, grouped: true }}
		name="Grid · grouped"
		note="storage on one line, transport and coordination on the next"
	/>

	{
		/* The abstract cut levelled: three cards of one height, so the growth is said only by what is
	    inside them. Carries the third colour in the cluster. A full-bleed field was tried alongside
	    this and removed — the card is 10 units wider than its content, so the cells met the card's
	    border and its rounded corners with nothing between them. */
	}
	<Variant
		visual={kv('scale')}
		component={ScaleGrid}
		props={{ equalHeight: true, thirdRole: true }}
		name="Grid · equal height"
		note="abstract · one height for all three · third colour in the cluster"
	/>

	{
		/* --- abstract cut -------------------------------------------------------------------
	    A footprint rather than an inventory: a quiet field of squircles for capacity not yet taken,
	    and the few lit cells are what a deployment occupies. No legend, because two lit colours
	    joined by a bridge need no key. Nothing here is countable against a docs table — which is both
	    why it cannot be wrong and why it carries no fact a reader can act on. */
	}
	<Variant
		visual={kv('scale')}
		component={ScaleGrid}
		name="Grid"
		note="abstract · one cell, two joined, a connected patch"
	/>
</VisualPage>
