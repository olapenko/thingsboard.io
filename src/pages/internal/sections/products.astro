---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import Variant from '@root/pages/internal/_Variant.astro';
import ProductsBand from '@root/pages/internal/_ProductsBand.astro';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * The Products section — the deployment pair on the dark band.
 *
 * A section of CARDS rather than a drawing, carried by `_ProductsBand`, which restates the
 * homepage's ground and geometry (see its docblock). A `bleed` Variant like the AI section's,
 * since the band paints its own ground edge to edge — and a Variant rather than a still so the
 * page gets the phone view every other section has: the same route in a real 375 iframe, where
 * the pair actually stacks.
 *
 * PROMOTED 2026-09-24: the candidate direction — microcopy under each CTA, the deployment glyph
 * on the button, the product name bold — is now the component's own behaviour and the homepage's.
 * The words moved into `homeProducts` (`primaryNote`), the flags were deleted with the losing
 * form, and this page is back to one direction: the reference.
 */
---

<VisualPage visual="products">
	<Variant
		visual={kv('products')}
		component={ProductsBand}
		props={{ dark: true }}
		bleed
		name="Deployment pair · glass"
		note="candidate · the product pages' own choice-card panel — 6% white fill, 16% hairline — instead of white cards cut out of the band"
	/>

	<Variant
		visual={kv('products')}
		component={ProductsBand}
		bleed
		name="Deployment pair"
		note="shipping · promoted 2026-09-24 — full-bleed CTA with the deployment glyph, the step under each button, bold name, the ecosystem glow"
	/>
</VisualPage>
