---
import PlaygroundLayout from '@layouts/PlaygroundLayout.astro';
import { Icon } from 'astro-icon/components';
import { KEY_VISUALS, type KeyVisual } from '@root/pages/internal/_key-visuals';

/**
 * The hub: one tile per section, each linking to its own page.
 *
 * This page used to BE the sandbox — nine visuals as tab panels in one 1346-line file. Opening it
 * compiled and rendered all fifty-eight stages to look at six of them, and the tab strip was
 * machinery that existed only because they shared a page.
 *
 * Now each visual is a route: `/internal/sections/<id>/`, one file, compiled on its own. The hub is
 * the only thing that knows they are a set, and it says three things the flat list could not:
 *
 * - WHERE EACH STANDS. On the homepage (numbered, in page order), drawn and waiting for a section,
 *   or a component check with no section in mind. Read from the data — a visual with a `home`
 *   anchor is on the page — so the grouping cannot drift from the strip's seam.
 * - WHAT IT LOOKS LIKE AT A GLANCE. The section's own mark, the tile the homepage row carries, and a
 *   wash of its hue; the palette is the page's, so the hub reads as the page's table of contents.
 * - HOW FAR ALONG IT IS. Directions counted from the page's own source, and the promote/retire marks
 *   the section pages keep in localStorage, read back here.
 *
 * ADD a visual: an entry in `_key-visuals.ts` and a page beside this one. It appears here, and in
 * the strip on every other visual's page, with no other edit. REMOVE one: delete those two things.
 */

/**
 * Directions per page, counted from the source: one `<Variant>` is one direction. A page with none
 * is a set of stills (`<figure class="stage">`), and says so rather than claiming zero.
 */
const sources = import.meta.glob<string>('./*.astro', { query: '?raw', import: 'default', eager: true });
const count = (id: string, re: RegExp) => (sources[`./${id}.astro`] ?? '').match(re)?.length ?? 0;

const status = (id: string) => {
	const directions = count(id, /^\s*<Variant\b/gm);
	if (directions) return `${directions} ${directions === 1 ? 'direction' : 'directions'}`;
	const stills = count(id, /<figure class="stage\b/g);
	return `${stills || 1} ${stills > 1 ? 'stills' : 'still'}`;
};

const onHome = KEY_VISUALS.filter((v) => v.home);
const waiting = KEY_VISUALS.filter((v) => !v.home && !v.check);
const checks = KEY_VISUALS.filter((v) => v.check);

const groups: { title: string; note: string; items: KeyVisual[]; numbered?: boolean }[] = [
	{ title: 'On the homepage', note: 'In the order the page runs them.', items: onHome, numbered: true },
	{ title: 'Waiting for a section', note: 'Drawn, reviewed, and not on the page yet.', items: waiting },
	{ title: 'Component checks', note: 'No section of their own; here to prove a component renders.', items: checks },
].filter((g) => g.items.length);

/** Tiles without a mark of their own get a neutral one, so the grid keeps its rhythm. */
const FALLBACK_BADGE = { icon: 'tabler:code', color: '#5b616e' };
---

<PlaygroundLayout
	title="Sections"
	description="Every homepage section on its own page, at the widths it gets on the page it is headed for."
>
	<div class="hub">
		{
			groups.map((g) => (
				<section class="hub__group">
					<header class="hub__group-head">
						<h2>{g.title}</h2>
						<span class="hub__group-count">{g.items.length}</span>
						<p>{g.note}</p>
					</header>

					<ul class="hub__grid">
						{g.items.map((v, i) => {
							const badge = v.badge ?? FALLBACK_BADGE;
							return (
								<li class="tile" style={`--hue: ${badge.color}`}>
									<div class="tile__top">
										<span class="tile__badge" aria-hidden="true">
											<Icon name={badge.icon} />
										</span>
										{g.numbered && <span class="tile__num">{String(i + 1).padStart(2, '0')}</span>}
									</div>

									<p class="tile__label">{v.label}</p>
									<a class="tile__title" href={`/internal/sections/${v.id}/`}>
										{v.title ?? v.label}
									</a>

									<p class="tile__foot">
										<span class="tile__status">
											{status(v.id)}
											<span class="tile__marks" data-marks={v.id} />
										</span>
										{v.home && (
											<a class="tile__home" href={`/#${v.home}`} title="See it in its row on the homepage">
												Homepage
												<Icon name="tabler:arrow-up-right" aria-hidden="true" />
											</a>
										)}
									</p>
								</li>
							);
						})}
					</ul>
				</section>
			))
		}
	</div>
</PlaygroundLayout>

<script>
	// The promote/retire marks the section pages write (see `_VisualPage`), tallied per visual. Keyed
	// `visual/name`, so the prefix is the visual. Read-only here: marking is done on the section's own
	// page, where the direction is in front of you.
	type Marks = Record<string, { state: 'promote' | 'retire'; label: string }>;
	let marks: Marks = {};
	try {
		marks = JSON.parse(localStorage.getItem('launch-visuals:marks') || '{}') as Marks;
	} catch {
		/* private window, cleared site data — the tiles just show their counts */
	}

	document.querySelectorAll<HTMLElement>('[data-marks]').forEach((el) => {
		const mine = Object.entries(marks).filter(([key]) => key.startsWith(`${el.dataset.marks}/`));
		const n = (state: string) => mine.filter(([, m]) => m.state === state).length;
		(
			[
				['promote', 'promoted'],
				['retire', 'retired'],
			] as const
		).forEach(([state, word]) => {
			if (!n(state)) return;
			const part = document.createElement('span');
			part.className = `tile__mark tile__mark--${state}`;
			part.textContent = ` · ${n(state)} ${word}`;
			el.append(part);
		});
	});
</script>

<style lang="scss">
	@use '../../../styles/variables' as *;

	.hub {
		max-width: 1200px;
		margin: 0 auto;
	}

	.hub__group + .hub__group {
		margin-top: $spacing-16;
	}

	.hub__group-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: $spacing-1 $spacing-3;
		margin-bottom: $spacing-5;
		padding-bottom: $spacing-3;
		border-bottom: 1px solid var(--sl-color-hairline-light);

		h2 {
			@include card-title;
			margin: 0;
		}

		p {
			@include text-s;
			flex-basis: 100%;
			margin: 0;
			color: var(--color-text-secondary, #5b616e);
		}
	}

	.hub__group-count {
		@include text-xs;
		padding: 2px 7px;
		border-radius: 999px;
		background: var(--sl-color-gray-6, #f2f3f7);
		font-family: $font-family-mono;
		color: var(--color-text-secondary, #5b616e);
	}

	.hub__grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: $spacing-4;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	// ── Tile ─────────────────────────────────────────────
	// The whole tile is the link to the section's page — a stretched `::after` on the title, so the
	// accessible name stays the headline — and the homepage link sits above that layer as a second,
	// smaller destination. Nesting one <a> in another is not an option.
	.tile {
		position: relative;
		display: flex;
		flex-direction: column;
		padding: $spacing-5;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: $radius-lg;
		// The section's hue as a wash from the top, the way the two-wide ecosystem cards carry their
		// accent: enough to tell the tiles apart at a glance, not enough to read as a fill.
		background:
			radial-gradient(120% 90% at 0% 0%, color-mix(in srgb, var(--hue) 13%, transparent), transparent 70%),
			var(--color-bg-surface, #fff);
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease,
			transform 0.15s ease;

		&:hover {
			border-color: color-mix(in srgb, var(--hue) 45%, transparent);
			box-shadow: 0 8px 24px -8px color-mix(in srgb, var(--hue) 30%, transparent);
			transform: translateY(-2px);
		}

		&:has(.tile__title:focus-visible) {
			outline: 2px solid var(--hue);
			outline-offset: 2px;
		}
	}

	.tile__top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		margin-bottom: $spacing-4;
	}

	// The homepage row's own mark (`.feature-badge`), at hub size: a squircle in the section's hue
	// with the glyph at ~58% of the tile.
	.tile__badge {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 32%;
		background: var(--hue);
		color: #fff;

		:global([data-icon]) {
			width: 23px;
			height: 23px;
		}
	}

	.tile__num {
		@include card-title;
		font-family: $font-family-mono;
		font-weight: 400;
		line-height: 1;
		color: color-mix(in srgb, var(--hue) 55%, var(--color-text-secondary, #5b616e));
	}

	.tile__label {
		@include text-xs;
		margin: 0 0 $spacing-1;
		font-family: $font-family-mono;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-text-secondary, #5b616e);
	}

	.tile__title {
		@include card-title-sm;
		flex: 1;
		color: var(--color-text, #17181c);
		text-decoration: none;
		text-wrap: pretty;

		&::after {
			content: '';
			position: absolute;
			inset: 0;
			border-radius: inherit;
		}

		&:focus-visible {
			outline: none;
		}
	}

	.tile__foot {
		@include text-xs;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: $spacing-3;
		margin: $spacing-5 0 0;
		padding-top: $spacing-3;
		border-top: 1px solid color-mix(in srgb, var(--hue) 14%, var(--sl-color-hairline-light));
		font-family: $font-family-mono;
		color: var(--color-text-secondary, #5b616e);
	}

	.tile__status {
		min-width: 0;
	}

	// Built by the script, so `:global` — a scoped rule would not reach it.
	.tile__marks :global(.tile__mark--promote) {
		color: #1f8b4d;
	}

	.tile__home {
		position: relative;
		z-index: 1;
		display: inline-flex;
		flex: none;
		align-items: center;
		gap: 2px;
		padding: 3px 6px 3px 8px;
		margin: -3px -6px -3px 0;
		border-radius: 999px;
		color: color-mix(in srgb, var(--hue) 80%, #000);
		text-decoration: none;

		:global([data-icon]) {
			width: 14px;
			height: 14px;
		}

		&:hover {
			background: color-mix(in srgb, var(--hue) 10%, transparent);
		}

		&:focus-visible {
			outline: 2px solid var(--hue);
			outline-offset: 1px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tile {
			transition: none;

			&:hover {
				transform: none;
			}
		}
	}
</style>
