---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import Variant from '@root/pages/internal/_Variant.astro';
import TrustBand from '@components/Landing/TrustBand.astro';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * The trust band: three white cards between the use cases and Products — security, scale, openness
 * — each opening on a small drawing, on a ground that runs from white into the bookends' indigo.
 *
 * SHIPPING SINCE 2026-09-27: "One topology at a time" (`TrustVisualStages`, `TrustBand`'s default),
 * promoted over "Three cards" (`TrustVisual`, NEW WITH THE RUNNING ORDERS on 2026-09-26), which stays
 * below as the reference, pinned to `drawings: 'cards'` so a default that moves cannot move it.
 *
 * CANDIDATE, 2026-10-01: "Heading, ground turned over" — the band under a visible section heading,
 * on its ground run the other way, to part it from the use cases above. Sandbox only.
 */
---

<VisualPage visual="trust">
	<Variant
		visual={kv('trust')}
		component={TrustBand}
		props={{ drawings: 'stages' }}
		bleed
		shipping
		name="One topology at a time"
		note="Shipping in A and B · the shield on the bookends' navy beside white ISO seals its size, grey-ringed, with small ribbons; scale as one strip of nodes that recolours and grows — monolith, hybrid, then the cluster scaling out and folding home — over a devices bar in 25 / 25 / 50 filling at one pace on the pulse's beat, each stage's stores lit; the repo as GitHub shows it in the brand's blue, GitHub's mark closing its foot, the ThingsBoard mark white on the On-premises green as its org"
	/>

	<Variant
		visual={kv('trust')}
		component={TrustBand}
		props={{ drawings: 'stages', heading: true, ground: 'fall' }}
		bleed
		name="Heading, ground turned over"
		note="candidate, 2026-10-01 · the shipping cards under a visible heading — “Safe to build on”, draft words that say the three titles as one line — and the ground turned over: the bookends' indigo at the top, white at the foot, so the band starts on its own edge under the use cases' white instead of running on from it"
	/>

	<Variant
		visual={kv('trust')}
		component={TrustBand}
		props={{ drawings: 'cards' }}
		bleed
		name="Three cards"
		note="previous · ISO seals with SSO and 2FA, the monolith over the cluster with its pulse, the GitHub tile and its stars; white cards on a white-to-indigo ground"
	/>
</VisualPage>

{/* The homepage's context the section is drawn against: `_bleed-context.scss`. */}
<style lang="scss" is:global>
	@use '../bleed-context';
</style>
