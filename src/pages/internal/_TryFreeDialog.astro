---
import { Icon } from 'astro-icon/components';

/**
 * The CTA as a thin chooser: "Try for free" opens a dialog that asks ONE thing — where the data
 * should live — with the two regions as visible cards, the nearest one marked, and self-hosting
 * demoted to a line beneath. Nothing else: no tabs, no product list, no paragraph about the cloud.
 * Tabs would rebuild the `/installations/` hub inside a modal, and the hub is the thing this
 * replaces as the button's destination.
 *
 * It is a native `<dialog>`, opened with `showModal()`: focus trap, Escape, the backdrop and the
 * top layer come from the browser rather than from a script. Under 560px it becomes a bottom
 * sheet, because a centred card at phone width is a card with 16px either side pretending to be a
 * page.
 *
 * THE BAND under the trigger is a slice of the hero — the black column, the headline pair and the
 * CTA row as `Hero.astro` sets them — so the button is judged on the ground it ships on, and the
 * phone frame reads as the top of a phone screen rather than as a button in a strip. Its type is
 * restated here rather than imported: `Hero.astro`'s rules are scoped to its own markup.
 *
 * WHICH REGION IS "nearest" is the website's geo default — the same call that picks the host for
 * the plain-link version of this CTA (edge: `CF-IPCountry`; client: an `Intl` timezone under
 * `Europe/`). It gets the chip and the initial focus, so Enter straight after the click is the
 * one-decision path; the other region is one Tab away. Nothing is preselected in the sense of
 * navigating: a dialog that opened and left would be the interstitial it is meant to remove.
 *
 * Two dialogs can share a page (the sandbox stacks directions), so every id is derived from the
 * `id` prop rather than generated.
 */
interface Props {
	/** Prefix for the ids the dialog's labelling needs. Distinct per instance on a page. */
	id?: string;
	/** The region the geo default chose: chipped and focused first. */
	nearest?: 'us' | 'eu';
	/**
	 * The cloud glyph on the trigger. Off by default here: a button that opens a chooser holding
	 * an Install link is not a Cloud button, and the glyph would promise one. The plain-link CTA
	 * keeps it, because that one IS Cloud-only.
	 */
	icon?: boolean;
}

const { id = 'tfd', nearest = 'us', icon = false } = Astro.props;

const REGIONS = [
	{ id: 'us', name: 'North America', note: 'Hosted in the United States', href: 'https://thingsboard.cloud/signup' },
	{ id: 'eu', name: 'Europe', note: 'Hosted in the European Union', href: 'https://eu.thingsboard.cloud/signup' },
] as const;
---

<div class="tfd" data-tfd>
	<div class="tfd__band">
		<div class="tfd__copy">
			<p class="tfd__brand">ThingsBoard</p>
			<p class="tfd__headline">The all-in-one IoT platform</p>
			<p class="tfd__sub">
				Device management, data processing &amp; visualization for teams who build IoT for clients.
			</p>
			<div class="tfd__ctas">
				<button type="button" class="tfd__cta tfd__cta--brand" data-tfd-open aria-haspopup="dialog">
					{icon && <Icon name="tabler:cloud-filled" aria-hidden="true" />}
					Try for free
				</button>
				<a class="tfd__cta tfd__cta--outline" href="/installations/">
					<Icon name="tabler:download" aria-hidden="true" />
					Install
				</a>
			</div>
		</div>
	</div>

	<dialog class="tfd__dlg" aria-labelledby={`${id}-title`} data-tfd-dlg>
		<div class="tfd__panel">
			<form method="dialog">
				<button type="submit" class="tfd__close" aria-label="Close">
					<Icon name="tabler:x" aria-hidden="true" />
				</button>
			</form>

			<p class="tfd__kicker">
				<Icon name="tabler:cloud-filled" aria-hidden="true" />
				ThingsBoard Cloud · free, no card needed
			</p>
			<h2 class="tfd__title" id={`${id}-title`}>Where should your data live?</h2>
			<p class="tfd__lede">Pick the region closest to you. Your account and its data stay there.</p>

			<div class="tfd__regions">
				{
					REGIONS.map((r) => (
						<a class="tfd__region" href={r.href} data-nearest={r.id === nearest ? '' : undefined} id={`${id}-${r.id}`}>
							<Icon name="tabler:cloud" class={`tfd__glyph tfd__glyph--${r.id}`} aria-hidden="true" />
							<span class="tfd__rname">{r.name}</span>
							<span class="tfd__rnote">{r.note}</span>
							{r.id === nearest && <span class="tfd__chip">Nearest to you</span>}
							<Icon name="tabler:chevron-right" class="tfd__go" aria-hidden="true" />
						</a>
					))
				}
			</div>

			<p class="tfd__alt">
				Rather run it yourself?
				<a href="/installations/">
					Install on your own servers
					<Icon name="tabler:chevron-right" aria-hidden="true" />
				</a>
			</p>
		</div>
	</dialog>
</div>

<script>
	// One handler per instance, found by the root rather than by id, so a page holding two of these
	// (the sandbox does) wires both. Listeners sit on the nodes, which is what lets them survive the
	// phone frame's trim: `_VisualPage` MOVES the direction's row into an empty body, it does not
	// clone it.
	document.querySelectorAll<HTMLElement>('[data-tfd]').forEach((root) => {
		const dlg = root.querySelector<HTMLDialogElement>('[data-tfd-dlg]');
		const open = root.querySelector<HTMLButtonElement>('[data-tfd-open]');
		if (!dlg || !open) return;

		open.addEventListener('click', () => {
			dlg.showModal();
			// `showModal` lands on the first focusable — the close button. The nearest region is the
			// answer most people came for, so it takes the focus instead: Enter is then the whole
			// interaction.
			root.querySelector<HTMLElement>('[data-nearest]')?.focus();
		});

		// The panel fills the dialog box, so a click whose target is the dialog element itself can only
		// have landed on the backdrop.
		dlg.addEventListener('click', (e) => {
			if (e.target === dlg) dlg.close();
		});
	});
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	.tfd {
		p,
		h2 {
			margin: 0;
		}
	}

	// ---- The hero slice ---------------------------------------------------------------------
	// The black column, at the hero's own sizes: 44px buttons, 16px labels, the brand fill and
	// the 35% white rule on the outline, from `Hero.astro`'s split layout.
	.tfd__band {
		display: flex;
		align-items: center;
		padding: 56px 24px;
		background: #000;
		color: #fff;

		// In a phone frame the band is the phone's whole screen, so the sheet has a viewport to rise
		// into; the frame is sized from the document, and a 200px document would give the dialog
		// 200px to open in.
		:global(html[data-kv-frame]) & {
			min-height: 100svh;
			padding-top: 88px;
		}
	}

	.tfd__copy {
		width: 100%;
		max-width: 560px;
		margin: 0 auto;
	}

	.tfd__brand {
		font-size: 32px;
		font-weight: $font-weight-bold;
		line-height: 1.15;
		color: rgba(255, 255, 255, 0.55);
	}

	.tfd__headline {
		font-size: 32px;
		font-weight: $font-weight-bold;
		line-height: 1.15;
		margin-bottom: 16px;
		text-wrap: balance;
	}

	.tfd__sub {
		font-size: 16px;
		line-height: 1.5;
		color: rgba(255, 255, 255, 0.85);
		margin-bottom: 24px;
	}

	.tfd__ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.tfd__cta {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 44px;
		padding: 0 16px;
		border: 1px solid transparent;
		border-radius: $radius-sm;
		font: inherit;
		font-size: 16px;
		line-height: 1;
		color: #fff;
		text-decoration: none;
		cursor: pointer;
		transition:
			background-color $transition-base,
			border-color $transition-base;

		[data-icon] {
			width: 18px;
			height: 18px;
		}

		&:focus-visible {
			outline: 2px solid #fff;
			outline-offset: 3px;
		}
	}

	.tfd__cta--brand {
		background: $color-brand;
		border-color: $color-brand;
		font-weight: $font-weight-bold;

		&:hover {
			background: color-mix(in srgb, #{$color-brand} 88%, #fff);
			border-color: color-mix(in srgb, #{$color-brand} 88%, #fff);
		}
	}

	.tfd__cta--outline {
		background: transparent;
		border-color: rgba(255, 255, 255, 0.35);
		font-weight: $font-weight-medium;

		&:hover {
			background: rgba(255, 255, 255, 0.14);
			border-color: rgba(255, 255, 255, 0.55);
		}
	}

	// ---- The dialog ---------------------------------------------------------------------------
	.tfd__dlg {
		width: min(560px, calc(100vw - 32px));
		max-width: none;
		padding: 0;
		border: 0;
		border-radius: $radius-xl;
		background: #fff;
		color: #17181c;
		box-shadow:
			0 1px 2px rgb(23 24 28 / 12%),
			0 24px 64px rgb(23 24 28 / 24%);

		&::backdrop {
			background: rgb(23 24 28 / 55%);
		}

		// A bottom sheet on a phone: full width, the top corners rounded, sat on the bottom edge.
		@media (max-width: 559px) {
			width: 100vw;
			max-height: calc(100svh - 24px);
			margin: auto 0 0;
			border-radius: $radius-xl $radius-xl 0 0;
		}
	}

	.tfd__panel {
		position: relative;
		padding: 32px;

		@media (max-width: 559px) {
			padding: 24px 16px 32px;
		}
	}

	.tfd__close {
		position: absolute;
		top: 16px;
		right: 16px;
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: #5b616e;
		cursor: pointer;

		[data-icon] {
			width: 20px;
			height: 20px;
		}

		&:hover {
			background: #f2f4f8;
			color: #17181c;
		}

		&:focus-visible {
			outline: 2px solid $color-brand;
			outline-offset: 2px;
		}
	}

	.tfd__kicker {
		display: flex;
		align-items: center;
		gap: 6px;
		margin-bottom: 12px;
		padding-right: 44px;
		font-size: 13px;
		font-weight: $font-weight-medium;
		color: $color-brand;

		[data-icon] {
			width: 16px;
			height: 16px;
		}
	}

	.tfd__title {
		font-size: 24px;
		font-weight: $font-weight-bold;
		line-height: 1.2;
		margin-bottom: 8px;
		text-wrap: balance;
	}

	.tfd__lede {
		font-size: 15px;
		line-height: 1.5;
		color: #5b616e;
		margin-bottom: 24px;
	}

	.tfd__regions {
		display: grid;
		gap: 12px;
		margin-bottom: 20px;
	}

	// One card per region: glyph, name over its note, the chip if it is the nearest, a chevron.
	// The glyph takes the header's region hues — the brand blue for North America, the teal for
	// Europe — so the two read as the same pair the Sign in menu shows.
	.tfd__region {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto auto;
		grid-template-rows: auto auto;
		column-gap: 14px;
		align-items: center;
		padding: 16px;
		border: 1px solid #e2e5ea;
		border-radius: 12px;
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease;

		&:hover,
		&:focus-visible {
			border-color: $color-brand;
			box-shadow: 0 0 0 3px rgb(61 80 245 / 15%);
			outline: none;

			.tfd__go {
				transform: translateX(2px);
				color: $color-brand;
			}
		}
	}

	.tfd__glyph {
		grid-row: 1 / 3;
		width: 28px;
		height: 28px;

		&--us {
			color: $color-brand;
		}

		&--eu {
			color: #0e8aa8;
		}
	}

	.tfd__rname {
		grid-column: 2;
		font-size: 17px;
		font-weight: $font-weight-bold;
		line-height: 1.3;
	}

	.tfd__rnote {
		grid-column: 2;
		font-size: 14px;
		line-height: 1.4;
		color: #5b616e;
	}

	.tfd__chip {
		grid-column: 3;
		grid-row: 1 / 3;
		padding: 3px 9px;
		border-radius: 999px;
		background: rgb(61 80 245 / 10%);
		color: $color-brand;
		font-size: 12px;
		font-weight: $font-weight-medium;
		white-space: nowrap;
	}

	.tfd__go {
		grid-column: 4;
		grid-row: 1 / 3;
		width: 20px;
		height: 20px;
		color: #9aa0ab;
		transition:
			transform 0.15s ease,
			color 0.15s ease;
	}

	// The other route, as a sentence rather than a third card: it is here to be found, not to be
	// weighed against the two above.
	.tfd__alt {
		font-size: 14px;
		line-height: 1.5;
		color: #5b616e;

		a {
			display: inline-flex;
			align-items: center;
			gap: 2px;
			margin-left: 4px;
			color: #17181c;
			font-weight: $font-weight-medium;
			text-decoration: none;

			[data-icon] {
				width: 16px;
				height: 16px;
			}

			&:hover {
				text-decoration: underline;
			}
		}
	}
</style>
