---
import PlaygroundLayout from '@layouts/PlaygroundLayout.astro';
import Button from '@components/ui/Button.astro';
import Link from '@components/ui/Link.astro';
import Chip from '@components/ui/Chip.astro';
import Tabs from '@components/ui/Tabs.astro';
import TabPanel from '@components/ui/TabPanel.astro';
import Card from '@components/ui/Card.astro';
import Band from '@components/ui/Band.astro';
import { designHref, designPage, navGroups } from '@root/pages/internal/_design';

/**
 * Design system › Foundations: the values every `ui/` component is drawn with — the accent schemes,
 * the grounds and the focus ring they pick, elevation, radius, spacing, icon sizes and motion. The
 * first half of what was the kit page; the components are on Components, the type roles on Type.
 *
 * The values under a swatch or a box are READ in the browser from what rendered (`_kit-measure.ts`),
 * so this page cannot disagree with the tokens: change `_theme.scss` and the caption changes with it.
 * The tables of where each value is used are written by hand and are the part that can go stale.
 */
const PAGE = designPage('foundations');
const TYPE_PAGE = designPage('type');

const SCHEMES = [
	{ id: 'brand', name: 'brand', use: 'Cloud, the site' },
	{ id: 'onprem', name: 'onprem', use: 'On-premises' },
	{ id: 'neutral', name: 'neutral', use: 'Quiet controls, the dialog close' },
] as const;
const SCHEME_ROLES = [
	{ v: '--accent-fill', name: 'fill', use: 'Primary buttons, solid marks, pressed toggles' },
	{ v: '--accent-on-fill', name: 'on-fill', use: 'Text on the fill' },
	{ v: '--accent-ink', name: 'ink', use: 'Links, tertiary labels, tints on light' },
	{ v: '--accent-light', name: 'light', use: 'The same on a dark ground' },
] as const;

const ELEVATION = [
	{ token: '--elev-tile', use: 'A card in a grid, a row in a list', where: 'Card tile and row, region rows' },
	{ token: '--elev-tile-hover', use: 'A link tile under the pointer', where: 'Card with href, on hover' },
	{ token: '--elev-panel', use: 'A card that stands alone', where: 'Card panel, the contact form' },
	{ token: '--elev-dialog', use: 'The top layer', where: 'Dialog' },
	{ token: '--elev-mark', use: 'A mark on a card or straddling one', where: 'Mark lift' },
] as const;

const RADII = [
	{ name: '2px', box: '2px', where: 'An inline link’s focus ring' },
	{ name: 'md · 6', box: '6px', where: 'Button, Field' },
	{ name: 'lg · 8', box: '8px', where: 'Card tile and row, list and grid tabs, region rows' },
	{ name: 'xl · 16', box: '16px', where: 'Card panel and ghost, Dialog' },
	{ name: 'full', box: '100px', where: 'Chip, segmented tabs and thumb' },
	{ name: '32%', box: '32%', where: 'Mark, at every size' },
	{ name: '50%', box: '50%', where: 'Mark circle (region globes)' },
] as const;

const SPACING = [4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 100, 120];
const BAND_PADS = [
	['none', 0, 0],
	['sm', 48, 32],
	['md', 64, 48],
	['lg', 80, 48],
	['xl', 96, 64],
] as const;
const GROUNDS = [
	{ ground: 'flat', note: 'White' },
	{ ground: 'tint', note: '--band-tint' },
	{ ground: 'fade', note: 'White to 10% of the hue' },
	{ ground: 'hue', note: '22% to 6% of the hue, 150°' },
	{ ground: 'dark', note: '--band-indigo, sets data-surface="dark"' },
] as const;
---

<PlaygroundLayout title={PAGE.label} description={PAGE.blurb}>
	<div class="kit">
		<nav class="kit__nav" aria-label={PAGE.label}>
			{navGroups(PAGE).map((g) => (
				<div class="kit__nav-group">
					<p class="kit__nav-title">{g.title}</p>
					<ul>
						{g.items.map((s) => (
							<li>
								<a href={`#${s.id}`}>{s.label}</a>
							</li>
						))}
					</ul>
				</div>
			))}
			<div class="kit__nav-group">
				<p class="kit__nav-title">{TYPE_PAGE.label}</p>
				<ul>
					<li>
						<a href={designHref(TYPE_PAGE)}>The role ladder</a>
					</li>
				</ul>
			</div>
		</nav>

		<main class="kit__main">
			<!-- ── Colour ── -->
			<section class="kit-sec" id="colour">
				<header class="kit-sec__head">
					<h2>Colour</h2>
					<p>
						An accent is four values, set on any ancestor with <code>data-accent</code>; a component's
						<code>accent</code> prop takes a scheme or a one-off colour for itself alone. The ratios are measured.
					</p>
					<p class="kit-sec__src">src/styles/_theme.scss</p>
				</header>
				<div class="kit-schemes">
					{SCHEMES.map((sc) => (
						<div class="kit-scheme" data-accent={sc.id}>
							<p class="kit-scheme__name">
								<code>{sc.name}</code> <span>{sc.use}</span>
							</p>
							<ul class="kit-scheme__swatches">
								{SCHEME_ROLES.map((r) => (
									<li>
										<span class="kit-swatch" style={`background: var(${r.v})`} />
										<b>{r.name}</b>
										<code data-var={r.v} />
									</li>
								))}
							</ul>
							<p class="kit-scheme__ratios" data-ratios />
						</div>
					))}
				</div>
				<table class="kit-table">
					<thead>
						<tr>
							<th>Role</th>
							<th>Variable</th>
							<th>Used for</th>
						</tr>
					</thead>
					<tbody>
						{SCHEME_ROLES.map((r) => (
							<tr>
								<td>{r.name}</td>
								<td>
									<code>{r.v}</code>
								</td>
								<td>{r.use}</td>
							</tr>
						))}
					</tbody>
				</table>
			</section>

			<!-- ── Grounds and focus ── -->
			<section class="kit-sec" id="grounds">
				<header class="kit-sec__head">
					<h2>Grounds and focus</h2>
					<p>
						<code>data-surface</code> on an ancestor says what a control sits on: a Band sets it from its ground, a Card
						and a Dialog set <code>light</code>. It picks each component's dark look and the focus ring (2px, 3px out,
						keyboard only). Tab through the row on each ground.
					</p>
					<p class="kit-sec__src">src/components/ui/Band.astro · src/styles/_surface.scss</p>
				</header>
				<div class="kit-grounds">
					{GROUNDS.map((g) => (
						<figure class="kit-ground">
							<Band ground={g.ground} pad="sm" hue={g.ground === 'hue' || g.ground === 'fade' ? '#3d50f5' : undefined}>
								<div class="kit-ground__row">
									<Button size="sm">Primary</Button>
									<Button size="sm" variant="secondary">
										Secondary
									</Button>
									<Link href="#grounds" size="sm">
										Link
									</Link>
								</div>
							</Band>
							<figcaption>
								<b>{g.ground}</b> {g.note}
							</figcaption>
						</figure>
					))}
					<figure class="kit-ground">
						<Band ground="dark" pad="sm">
							<div class="kit-ground__card" data-surface="light">
								<Button size="sm">Primary</Button>
								<Button size="sm" variant="secondary">
									Secondary
								</Button>
								<Link href="#grounds" size="sm">
									Link
								</Link>
							</div>
						</Band>
						<figcaption>
							<b>white box in dark</b> data-surface="light" brings the light look back
						</figcaption>
					</figure>
				</div>
				<div class="kit-rings">
					<figure class="kit-ring">
						<span class="kit-ring__sample" style="--r: var(--focus-ring-light)"></span>
						<figcaption>
							<b>On light</b> <code data-var="--focus-ring-light"></code>
						</figcaption>
					</figure>
					<figure class="kit-ring kit-ring--dark">
						<span class="kit-ring__sample" style="--r: var(--focus-ring-dark)"></span>
						<figcaption>
							<b>On dark</b> <code data-var="--focus-ring-dark"></code>
						</figcaption>
					</figure>
				</div>
			</section>

			<!-- ── Elevation ── -->
			<section class="kit-sec" id="elevation">
				<header class="kit-sec__head">
					<h2>Elevation</h2>
					<p>
						Five lifts, all cast in one UI ink (<code>--color-shadow-ui-rgb</code>), so a card throws the same shadow on
						white and on a tint. Nothing else casts a shadow.
					</p>
					<p class="kit-sec__src">src/styles/_theme.scss</p>
				</header>
				<div class="kit-elev">
					{ELEVATION.map((e) => (
						<figure class="kit-elev__item">
							<span class="kit-elev__box" style={`box-shadow: var(${e.token})`} />
							<figcaption>
								<code>{e.token}</code>
								<span>{e.use}</span>
								<span class="kit-muted">{e.where}</span>
							</figcaption>
						</figure>
					))}
				</div>
				<div class="kit-elev kit-elev--tint">
					{ELEVATION.map((e) => (
						<figure class="kit-elev__item">
							<span class="kit-elev__box" style={`box-shadow: var(${e.token})`} />
							<figcaption>
								<code>{e.token}</code> <span class="kit-muted">on the tint</span>
							</figcaption>
						</figure>
					))}
				</div>
				<table class="kit-table">
					<thead>
						<tr>
							<th>Token</th>
							<th>Value</th>
						</tr>
					</thead>
					<tbody>
						{ELEVATION.map((e) => (
							<tr>
								<td>
									<code>{e.token}</code>
								</td>
								<td>
									<code class="kit-value" data-var={e.token} />
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</section>

			<!-- ── Radius ── -->
			<section class="kit-sec" id="radius">
				<header class="kit-sec__head">
					<h2>Radius</h2>
					<p>One corner per role. A component owns its corner; a page never sets one.</p>
					<p class="kit-sec__src">src/styles/_variables.scss ($radius-*)</p>
				</header>
				<div class="kit-radii">
					{RADII.map((r) => (
						<figure class="kit-radius">
							<span class="kit-radius__box" style={`border-radius: ${r.box}`} />
							<figcaption>
								<b>{r.name}</b>
								<span class="kit-muted">{r.where}</span>
							</figcaption>
						</figure>
					))}
				</div>
			</section>

			<!-- ── Spacing ── -->
			<section class="kit-sec" id="spacing">
				<header class="kit-sec__head">
					<h2>Spacing</h2>
					<p>
						The scale every gap and padding is drawn from (<code>$spacing-*</code>), and the five steps a Band pads a
						section with, which drop a step below 750.
					</p>
					<p class="kit-sec__src">src/styles/_variables.scss · src/components/ui/Band.astro</p>
				</header>
				<div class="kit-scale">
					{SPACING.map((n) => (
						<div class="kit-scale__step">
							<span class="kit-scale__bar" style={`width: ${n}px`} />
							<code>{n}</code>
						</div>
					))}
				</div>
				<table class="kit-table">
					<thead>
						<tr>
							<th>Band pad</th>
							<th>From 750</th>
							<th>Below 750</th>
						</tr>
					</thead>
					<tbody>
						{BAND_PADS.map(([name, wide, narrow]) => (
							<tr>
								<td>
									<code>{name}</code>
								</td>
								<td>{wide}</td>
								<td>{narrow}</td>
							</tr>
						))}
					</tbody>
				</table>
			</section>

			<!-- ── Icons and motion ── -->
			<section class="kit-sec" id="icons">
				<header class="kit-sec__head">
					<h2>Icons and motion</h2>
					<p>
						Tabler glyphs, sized by the component they sit in. Motion is short and stops for anyone who asked for less (
						<code>prefers-reduced-motion</code>).
					</p>
				</header>
				<table class="kit-table">
					<thead>
						<tr>
							<th>Where</th>
							<th>Icon</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td>Button xs · sm · md and lg · xl</td>
							<td>16 · 18 · 20 · 22</td>
						</tr>
						<tr>
							<td>Link chevron and arrow</td>
							<td>1.25em of the text (18 · 20 · 22); the arrow 1em</td>
						</tr>
						<tr>
							<td>Chip md · sm</td>
							<td>20 · 16</td>
						</tr>
						<tr>
							<td>Tabs list · grid · segmented</td>
							<td>20 · 18 · 20</td>
						</tr>
						<tr>
							<td>Mark</td>
							<td>60% of the tile (its ladder)</td>
						</tr>
					</tbody>
				</table>
				<div class="kit-specs" style="--spec-h: 46px; --spec-w: 150px">
					<figure class="kit-spec" data-m="dur">
						<Button>Button</Button>
						<figcaption>
							<b>Button colour</b>
							<span class="kit-m"></span>
						</figcaption>
					</figure>
					<figure class="kit-spec" data-m="dur">
						<Chip href="#icons">Chip</Chip>
						<figcaption>
							<b>Chip</b>
							<span class="kit-m"></span>
						</figcaption>
					</figure>
					<figure class="kit-spec" data-m="dur">
						<Card href="#icons" title="Card" pad="sm" />
						<figcaption>
							<b>Card lift</b>
							<span class="kit-m"></span>
						</figcaption>
					</figure>
					<figure class="kit-spec" data-m="dur" data-m-el=".ui-seg__thumb">
						<Tabs
							label="Motion"
							items={[
								{ label: 'One', panel: 'kit-motion-a' },
								{ label: 'Two', panel: 'kit-motion-b' },
							]}
						/>
						<figcaption>
							<b>Segmented thumb</b>
							<span class="kit-m"></span>
						</figcaption>
					</figure>
				</div>
				<div class="kit-panels">
					<TabPanel id="kit-motion-a" selected>
						<span></span>
					</TabPanel>
					<TabPanel id="kit-motion-b">
						<span></span>
					</TabPanel>
				</div>
			</section>
		</main>
	</div>
</PlaygroundLayout>

<script>
	import '@root/pages/internal/design-system/_kit-measure';
</script>

<style lang="scss">
	@use '../../../styles/variables' as *;
	@use 'kit';

	// ── Colour ──
	.kit-schemes {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px;

		@include media-down(lg) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.kit-scheme {
		display: grid;
		gap: 14px;
		padding: 20px;
		border: 1px solid rgba(23, 24, 28, 0.08);
		border-radius: 12px;
	}

	.kit-scheme__name {
		@include type-small;

		margin: 0;
		color: var(--color-text-secondary);

		code {
			@include type-small-strong;

			color: var(--color-text);
		}
	}

	.kit-scheme__swatches {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;

		li {
			display: grid;
			gap: 4px;
		}

		b {
			@include type-small-strong;
		}

		code {
			@include type-small;

			color: var(--color-text-secondary);
		}
	}

	.kit-swatch {
		display: block;
		height: 48px;
		border-radius: 8px;
		box-shadow: inset 0 0 0 1px rgba(23, 24, 28, 0.08);
	}

	.kit-scheme__ratios {
		@include type-small;

		margin: 0;
		color: var(--color-text-secondary);
	}

	// ── Grounds ──
	.kit-grounds {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 16px;
	}

	.kit-ground {
		display: grid;
		gap: 8px;
		margin: 0;

		> :global(.ui-band) {
			overflow: hidden;
			border-radius: 12px;
			box-shadow: inset 0 0 0 1px rgba(23, 24, 28, 0.06);
		}

		figcaption {
			@include type-small;

			color: var(--color-text-secondary);

			b {
				color: var(--color-text);
			}
		}
	}

	.kit-ground__row,
	.kit-ground__card {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 16px;
	}

	.kit-ground__card {
		padding: 16px;
		border-radius: 8px;
		background: #fff;
	}

	.kit-rings {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
	}

	.kit-ring {
		display: flex;
		align-items: center;
		gap: 16px;
		margin: 0;
		padding: 20px 24px;
		border: 1px solid rgba(23, 24, 28, 0.08);
		border-radius: 12px;

		figcaption {
			@include type-small;

			display: grid;
			color: var(--color-text-secondary);

			b {
				color: var(--color-text);
			}
		}
	}

	.kit-ring--dark {
		border-color: transparent;
		background: var(--band-indigo);

		figcaption,
		figcaption b {
			color: #fff;
		}
	}

	.kit-ring__sample {
		width: 96px;
		height: 36px;
		border-radius: 6px;
		background: var(--accent-fill);
		outline: 2px solid var(--r);
		outline-offset: 3px;
	}

	// ── Elevation ──
	.kit-elev {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 24px;
		padding: 40px 32px 32px;
		border: 1px solid rgba(23, 24, 28, 0.08);
		border-radius: 12px;
		background: #fff;

		@include media-down(lg) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.kit-elev--tint {
		border-color: transparent;
		background: var(--band-tint);
	}

	.kit-elev__item {
		display: grid;
		align-content: start;
		gap: 16px;
		margin: 0;

		figcaption {
			@include type-small;

			display: grid;
			gap: 2px;
		}
	}

	.kit-elev__box {
		display: block;
		height: 96px;
		border-radius: 8px;
		background: #fff;
	}

	// ── Radius ──
	.kit-radii {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
		gap: 24px;
	}

	.kit-radius {
		display: grid;
		align-content: start;
		gap: 10px;
		margin: 0;

		figcaption {
			@include type-small;

			display: grid;
			gap: 2px;
		}
	}

	.kit-radius__box {
		display: block;
		width: 96px;
		height: 96px;
		border: 2px solid var(--accent-fill);
		background: color-mix(in srgb, var(--accent-fill) 8%, #fff);
	}

	// ── Spacing ──
	.kit-scale {
		display: grid;
		gap: 6px;
	}

	.kit-scale__step {
		display: grid;
		grid-template-columns: 128px auto;
		align-items: center;
		gap: 16px;

		code {
			@include type-small;

			color: var(--color-text-secondary);
		}
	}

	.kit-scale__bar {
		display: block;
		height: 12px;
		border-radius: 2px;
		background: color-mix(in srgb, var(--accent-fill) 60%, #fff);
	}
</style>
