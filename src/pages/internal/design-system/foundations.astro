---
import { readFileSync, readdirSync } from 'node:fs';
import { join, relative } from 'node:path';
import PlaygroundLayout from '@layouts/PlaygroundLayout.astro';
import Button from '@components/ui/Button.astro';
import Link from '@components/ui/Link.astro';
import Chip from '@components/ui/Chip.astro';
import Tabs from '@components/ui/Tabs.astro';
import TabPanel from '@components/ui/TabPanel.astro';
import Card from '@components/ui/Card.astro';
import Band from '@components/ui/Band.astro';
import { designHref, designPage, navGroups } from '@root/pages/internal/_design';

/**
 * Design system › Foundations: the values every `ui/` component is drawn with — the accent schemes,
 * the grounds and the focus ring they pick, elevation, radius, spacing, icon sizes and motion. The
 * first half of what was the kit page; the components are on Components, the type roles on Type.
 *
 * The values under a swatch or a box are READ in the browser from what rendered (`_kit-measure.ts`),
 * so this page cannot disagree with the tokens: change `_theme.scss` and the caption changes with it.
 * The tables of where each value is used are written by hand and are the part that can go stale.
 */
const PAGE = designPage('foundations');
const TYPE_PAGE = designPage('type');

const SCHEMES = [
	{ id: 'brand', name: 'brand', use: 'Cloud, the site' },
	{ id: 'onprem', name: 'onprem', use: 'On-premises' },
	{ id: 'neutral', name: 'neutral', use: 'Quiet controls, the dialog close' },
] as const;
const SCHEME_ROLES = [
	{ v: '--accent-fill', name: 'fill', use: 'Primary buttons, solid marks, pressed toggles' },
	{ v: '--accent-on-fill', name: 'on-fill', use: 'Text on the fill' },
	{ v: '--accent-ink', name: 'ink', use: 'Links, tertiary labels, tints on light' },
	{ v: '--accent-light', name: 'light', use: 'The same on a dark ground' },
] as const;

const ELEVATION = [
	{ token: '--elev-tile', use: 'A card in a grid, a row in a list', where: 'Card tile and row, region rows' },
	{ token: '--elev-tile-hover', use: 'A link tile under the pointer', where: 'Card with href, on hover' },
	{ token: '--elev-panel', use: 'A card that stands alone', where: 'Card panel, the contact form' },
	{ token: '--elev-dialog', use: 'The top layer', where: 'Dialog' },
	{ token: '--elev-mark', use: 'A mark on a card or straddling one', where: 'Mark lift' },
] as const;

const RADII = [
	{ name: '2px', box: '2px', where: 'An inline link’s focus ring' },
	{ name: 'md · 6', box: '6px', where: 'Button, Field' },
	{ name: 'lg · 8', box: '8px', where: 'Card tile and row, list and grid tabs, region rows' },
	{ name: 'xl · 16', box: '16px', where: 'Card panel and ghost, Dialog' },
	{ name: 'full', box: '100px', where: 'Chip, segmented tabs and thumb' },
	{ name: '32%', box: '32%', where: 'Mark, at every size' },
	{ name: '50%', box: '50%', where: 'Mark circle (region globes)' },
] as const;

const SPACING = [4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 100, 120];
const BAND_PADS = [
	['none', 0, 0],
	['sm', 48, 32],
	['md', 64, 48],
	['lg', 80, 48],
	['xl', 96, 64],
] as const;
const GROUNDS = [
	{ ground: 'flat', note: 'White' },
	{ ground: 'tint', note: '--band-tint' },
	{ ground: 'fade', note: 'White to 10% of the hue' },
	{ ground: 'hue', note: '22% to 6% of the hue, 150°' },
	{ ground: 'dark', note: '--band-indigo, sets data-surface="dark"' },
] as const;

/**
 * The palette: every other named colour in `_theme.scss`, by what it is for. `on` says what a
 * swatch's ratio measures — `text`: the colour as text on the page ground · `ground`: body text
 * (`--color-text`) on it · `dark-ground`: white on it. A group with `dark` is drawn a second time
 * inside `data-theme="dark"`, which is where `_theme.scss` puts the dark values. `noDark` is for a
 * token that takes its dark value from Starlight: Starlight sets that on the root, so a swatch on
 * this light page cannot draw it.
 */
type Swatch = { v: string; use: string; on?: 'text' | 'ground' | 'dark-ground'; noDark?: string };
/** `note` is trusted HTML, so a token in it can sit in `<code>`. */
type PaletteGroup = { id: string; title: string; note: string; dark: boolean; tokens: Swatch[] };

const PALETTE: PaletteGroup[] = [
	{
		id: 'neutrals',
		title: 'Text, grounds and rules',
		note: 'The neutrals every page sits on. Text is measured on the page ground, a ground by the body text on it.',
		dark: true,
		tokens: [
			{ v: '--color-text', use: 'Body text, headings' },
			{ v: '--color-text-secondary', use: 'Supporting text' },
			{ v: '--color-text-muted', use: 'Captions, meta' },
			{ v: '--color-text-light', use: 'Placeholders, faint labels' },
			{ v: '--color-bg', use: 'The page', on: 'ground' },
			{ v: '--color-bg-surface', use: 'A raised surface', on: 'ground' },
			{ v: '--color-bg-light', use: 'A tinted block', on: 'ground' },
			{ v: '--color-bg-muted', use: 'A quiet block', on: 'ground' },
			{ v: '--color-bg-dark', use: 'A dark block', on: 'dark-ground' },
			{ v: '--color-border', use: 'Rules, card edges' },
			{ v: '--color-border-light', use: 'Field edges' },
		],
	},
	{
		id: 'status',
		title: 'Status',
		note: 'Messages and validation.',
		dark: true,
		tokens: [
			{ v: '--color-success', use: 'Done, valid' },
			{ v: '--color-danger', use: 'Errors' },
			{ v: '--color-warning', use: 'Warnings' },
			{ v: '--color-notice', use: 'Notice text and icon' },
			{ v: '--color-notice-fill', use: 'Notice ground', on: 'ground' },
		],
	},
	{
		id: 'accents',
		title: 'Accent palette',
		note: 'The hues the redesigned key visuals share: connect routes, the twin’s series, the ecosystem cards. Light only: the pages that read them force the light theme.',
		dark: false,
		tokens: [
			{ v: '--color-accent-cyan', use: 'Key visuals' },
			{ v: '--color-accent-violet', use: 'Key visuals' },
			{ v: '--color-accent-lime', use: 'Key visuals' },
			{ v: '--color-accent-green', use: 'Key visuals, kickers' },
			{ v: '--color-accent-amber', use: 'Key visuals, IoT Hub' },
			{ v: '--color-accent-red', use: 'Key visuals' },
		],
	},
	{
		id: 'bands',
		title: 'Bands and maps',
		note: 'The grounds a Band paints, and the region pickers’ second hue. Light only.',
		dark: false,
		tokens: [
			{ v: '--band-indigo', use: 'The dark bookend band', on: 'dark-ground' },
			{ v: '--band-wave', use: 'Its wave line' },
			{ v: '--band-tint', use: 'The tint band', on: 'ground' },
			{ v: '--region-eu', use: 'Europe on the region pickers' },
		],
	},
	{
		id: 'legacy',
		title: 'Older tokens',
		note: 'From before the redesign and still defined. <code>--color-primary</code> reads Starlight’s accent, which is the brand indigo now, not the old #2a7dec blue it falls back to.',
		dark: true,
		tokens: [
			{ v: '--color-brand', use: 'The brand indigo' },
			{ v: '--color-primary', use: 'Old primary, docs links', noDark: 'Starlight’s dark accent' },
			{ v: '--color-primary-hover', use: 'Its hover', noDark: 'Starlight’s dark accent' },
			{ v: '--color-primary-dark', use: 'Old dark blue' },
			{ v: '--color-primary-darker', use: 'Old navy', on: 'dark-ground' },
			{ v: '--color-dark', use: 'Near-black', on: 'dark-ground' },
			{ v: '--color-dark-alt', use: 'Near-black, warmer', on: 'dark-ground' },
			{ v: '--tb-main-color', use: 'Docs main colour' },
			{ v: '--menu-icon-color', use: 'Mega-menu icons', noDark: 'Starlight’s dark accent' },
			{ v: '--color-light-blue-low', use: 'Badge ground', on: 'ground' },
			{ v: '--color-light-blue', use: 'Badge' },
			{ v: '--color-light-blue-high', use: 'Badge, strong' },
			{ v: '--color-edge-low', use: 'Edge badge ground', on: 'ground' },
			{ v: '--color-edge', use: 'Edge badge' },
			{ v: '--color-edge-high', use: 'Edge badge, strong' },
		],
	},
];

/**
 * The two product sets side by side, one row per product: `--color-product-*` and `--brand-*` came
 * at different times and name the same products in different hues.
 */
const PRODUCT_SETS = ['--color-product-*', '--brand-*', '--brand-*-text'] as const;
const PRODUCTS: { name: string; tokens: (string | null)[] }[] = [
	{ name: 'Community', tokens: ['--color-product-ce', '--brand-ce', null] },
	{ name: 'Professional', tokens: ['--color-product-pe', '--brand-pe', null] },
	{ name: 'Cloud', tokens: ['--color-product-cloud', '--brand-cloud', null] },
	{ name: 'Trendz', tokens: ['--color-product-trendz', '--brand-trendz', '--brand-trendz-text'] },
	{ name: 'IoT Gateway', tokens: ['--color-product-gw', '--brand-gateway', null] },
	{ name: 'Edge', tokens: [null, '--brand-edge', '--brand-edge-text'] },
	{ name: 'Mobile', tokens: [null, '--brand-mobile', null] },
	{ name: 'IoT Hub', tokens: ['--color-product-iot-hub', null, null] },
];

/**
 * Who reads each token: the files under `src/` that write `var(--token`, read as the page renders.
 * `_theme.scss` defines them and the internal pages draw them, so neither counts.
 */
const SRC = join(process.cwd(), 'src');
const SKIP = new Set([join(SRC, 'pages', 'internal'), join(SRC, 'styles', '_theme.scss')]);
const srcFiles: string[] = [];
const walk = (dir: string) => {
	for (const entry of readdirSync(dir, { withFileTypes: true })) {
		const path = join(dir, entry.name);
		if (SKIP.has(path)) continue;
		if (entry.isDirectory()) walk(path);
		else if (/\.(astro|scss|css|ts|tsx|mdx)$/.test(entry.name)) srcFiles.push(path);
	}
};
walk(SRC);
const sources = srcFiles.map((path) => ({ path: relative(process.cwd(), path), text: readFileSync(path, 'utf8') }));
const readers = (token: string) => {
	const call = new RegExp(`var\\(\\s*${token}(?![\\w-])`);
	return sources.filter((f) => call.test(f.text)).map((f) => f.path);
};
const filesWord = (n: number) => (n === 0 ? 'in no file' : n === 1 ? 'in 1 file' : `in ${n} files`);
---

<PlaygroundLayout title={PAGE.label} description={PAGE.blurb}>
	<div class="kit">
		<nav class="kit__nav" aria-label={PAGE.label}>
			{navGroups(PAGE).map((g) => (
				<div class="kit__nav-group">
					<p class="kit__nav-title">{g.title}</p>
					<ul>
						{g.items.map((s) => (
							<li>
								<a href={`#${s.id}`}>{s.label}</a>
							</li>
						))}
					</ul>
				</div>
			))}
			<div class="kit__nav-group">
				<p class="kit__nav-title">{TYPE_PAGE.label}</p>
				<ul>
					<li>
						<a href={designHref(TYPE_PAGE)}>The role ladder</a>
					</li>
				</ul>
			</div>
		</nav>

		<main class="kit__main">
			<!-- ── Colour ── -->
			<section class="kit-sec" id="colour">
				<header class="kit-sec__head">
					<h2>Colour</h2>
					<p>
						An accent is four values, set on any ancestor with <code>data-accent</code>; a component's
						<code>accent</code> prop takes a scheme or a one-off colour for itself alone. The ratios are measured.
					</p>
					<p class="kit-sec__src">src/styles/_theme.scss</p>
				</header>
				<div class="kit-schemes">
					{SCHEMES.map((sc) => (
						<div class="kit-scheme" data-accent={sc.id}>
							<p class="kit-scheme__name">
								<code>{sc.name}</code> <span>{sc.use}</span>
							</p>
							<ul class="kit-scheme__swatches">
								{SCHEME_ROLES.map((r) => (
									<li>
										<span class="kit-swatch" style={`background: var(${r.v})`} />
										<b>{r.name}</b>
										<code data-var={r.v} />
									</li>
								))}
							</ul>
							<p class="kit-scheme__ratios" data-ratios />
						</div>
					))}
				</div>
				<table class="kit-table">
					<thead>
						<tr>
							<th>Role</th>
							<th>Variable</th>
							<th>Used for</th>
						</tr>
					</thead>
					<tbody>
						{SCHEME_ROLES.map((r) => (
							<tr>
								<td>{r.name}</td>
								<td>
									<code>{r.v}</code>
								</td>
								<td>{r.use}</td>
							</tr>
						))}
					</tbody>
				</table>
			</section>

			<!-- ── Palette ── -->
			<section class="kit-sec" id="palette">
				<header class="kit-sec__head">
					<h2>Palette</h2>
					<p>
						Every other named colour, by what it is for. A group with dark values is drawn twice, the second time inside{' '}
						<code>data-theme="dark"</code>. The hex and the ratio are measured from the swatch; the file count is how
						many files outside <code>internal/</code> read the token with <code>var()</code>.
					</p>
					<p class="kit-sec__src">src/styles/_theme.scss</p>
				</header>
				{PALETTE.map((g) => (
					<div class="pal-group" id={`palette-${g.id}`}>
						<div class="pal-group__head">
							<h3>{g.title}</h3>
							<p set:html={g.note} />
						</div>
						<div class="pal-rows" role="table" aria-label={g.title}>
							<div class="pal-row pal-row--head" role="row">
								<span role="columnheader">Token</span>
								<span role="columnheader">Light</span>
								<span role="columnheader">Dark</span>
							</div>
							{g.tokens.map((t) => {
								const users = readers(t.v);
								return (
									<div class="pal-row" role="row">
										<div class="pal-name" role="cell">
											<code>{t.v}</code>
											<span>
												{t.use} ·{' '}
												<span
													class:list={['pal-files', users.length === 0 && 'pal-files--none']}
													title={users.join('\n') || undefined}
												>
													{filesWord(users.length)}
												</span>
											</span>
										</div>
										<div class="pal-cell" role="cell">
											<span
												class="pal-chip"
												data-chip={t.on ?? 'text'}
												data-token={t.v}
												style={`background: var(${t.v})`}
											/>
											<span class="pal-read" />
										</div>
										<div class="pal-cell" role="cell">
											{g.dark && t.noDark ? (
												<span class="pal-none">{t.noDark}</span>
											) : g.dark ? (
												<>
													<span
														class="pal-chip"
														data-theme="dark"
														data-chip={t.on ?? 'text'}
														data-token={t.v}
														style={`background: var(${t.v})`}
													/>
													<span class="pal-read" />
												</>
											) : (
												<span class="pal-none">light only</span>
											)}
										</div>
									</div>
								);
							})}
						</div>
					</div>
				))}

				<div class="pal-group" id="palette-products">
					<div class="pal-group__head">
						<h3>Product colours</h3>
						<p>
							Two sets name the products, and they disagree: <code>--color-product-*</code> colours product cards and
							the chat’s keys; <code>--brand-*</code> was made for the old mega-menu. Each cell is light, then dark.
						</p>
					</div>
					<div class="pal-scroll">
						<table class="kit-table pal-products">
							<thead>
								<tr>
									<th scope="col">Product</th>
									{PRODUCT_SETS.map((s) => (
										<th scope="col">
											<code>{s}</code>
										</th>
									))}
								</tr>
							</thead>
							<tbody>
								{PRODUCTS.map((p) => (
									<tr>
										<th scope="row">{p.name}</th>
										{p.tokens.map((token) =>
											token ? (
												<td>
													<code class="pal-products__token">{token}</code>
													<span class="pal-files">{filesWord(readers(token).length)}</span>
													<div class="pal-products__pair">
														{['light', 'dark'].map((theme) => (
															<div class="pal-cell">
																<span
																	class="pal-chip"
																	data-theme={theme === 'dark' ? 'dark' : undefined}
																	data-chip="text"
																	data-token={token}
																	style={`background: var(${token})`}
																/>
																<span class="pal-read" />
															</div>
														))}
													</div>
												</td>
											) : (
												<td class="pal-none">none</td>
											)
										)}
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</div>
			</section>

			<!-- ── Grounds and focus ── -->
			<section class="kit-sec" id="grounds">
				<header class="kit-sec__head">
					<h2>Grounds and focus</h2>
					<p>
						<code>data-surface</code> on an ancestor says what a control sits on: a Band sets it from its ground, a Card
						and a Dialog set <code>light</code>. It picks each component's dark look and the focus ring (2px, 3px out,
						keyboard only). Tab through the row on each ground.
					</p>
					<p class="kit-sec__src">src/components/ui/Band.astro · src/styles/_surface.scss</p>
				</header>
				<div class="kit-grounds">
					{GROUNDS.map((g) => (
						<figure class="kit-ground">
							<Band ground={g.ground} pad="sm" hue={g.ground === 'hue' || g.ground === 'fade' ? '#3d50f5' : undefined}>
								<div class="kit-ground__row">
									<Button size="sm">Primary</Button>
									<Button size="sm" variant="secondary">
										Secondary
									</Button>
									<Link href="#grounds" size="sm">
										Link
									</Link>
								</div>
							</Band>
							<figcaption>
								<b>{g.ground}</b> {g.note}
							</figcaption>
						</figure>
					))}
					<figure class="kit-ground">
						<Band ground="dark" pad="sm">
							<div class="kit-ground__card" data-surface="light">
								<Button size="sm">Primary</Button>
								<Button size="sm" variant="secondary">
									Secondary
								</Button>
								<Link href="#grounds" size="sm">
									Link
								</Link>
							</div>
						</Band>
						<figcaption>
							<b>white box in dark</b> data-surface="light" brings the light look back
						</figcaption>
					</figure>
				</div>
				<div class="kit-rings">
					<figure class="kit-ring">
						<span class="kit-ring__sample" style="--r: var(--focus-ring-light)"></span>
						<figcaption>
							<b>On light</b> <code data-var="--focus-ring-light"></code>
						</figcaption>
					</figure>
					<figure class="kit-ring kit-ring--dark">
						<span class="kit-ring__sample" style="--r: var(--focus-ring-dark)"></span>
						<figcaption>
							<b>On dark</b> <code data-var="--focus-ring-dark"></code>
						</figcaption>
					</figure>
				</div>
			</section>

			<!-- ── Elevation ── -->
			<section class="kit-sec" id="elevation">
				<header class="kit-sec__head">
					<h2>Elevation</h2>
					<p>
						Five lifts, all cast in one UI ink (<code>--color-shadow-ui-rgb</code>), so a card throws the same shadow on
						white and on a tint. Nothing else casts a shadow.
					</p>
					<p class="kit-sec__src">src/styles/_theme.scss</p>
				</header>
				<div class="kit-elev">
					{ELEVATION.map((e) => (
						<figure class="kit-elev__item">
							<span class="kit-elev__box" style={`box-shadow: var(${e.token})`} />
							<figcaption>
								<code>{e.token}</code>
								<span>{e.use}</span>
								<span class="kit-muted">{e.where}</span>
							</figcaption>
						</figure>
					))}
				</div>
				<div class="kit-elev kit-elev--tint">
					{ELEVATION.map((e) => (
						<figure class="kit-elev__item">
							<span class="kit-elev__box" style={`box-shadow: var(${e.token})`} />
							<figcaption>
								<code>{e.token}</code> <span class="kit-muted">on the tint</span>
							</figcaption>
						</figure>
					))}
				</div>
				<table class="kit-table">
					<thead>
						<tr>
							<th>Token</th>
							<th>Value</th>
						</tr>
					</thead>
					<tbody>
						{ELEVATION.map((e) => (
							<tr>
								<td>
									<code>{e.token}</code>
								</td>
								<td>
									<code class="kit-value" data-var={e.token} />
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</section>

			<!-- ── Radius ── -->
			<section class="kit-sec" id="radius">
				<header class="kit-sec__head">
					<h2>Radius</h2>
					<p>One corner per role. A component owns its corner; a page never sets one.</p>
					<p class="kit-sec__src">src/styles/_variables.scss ($radius-*)</p>
				</header>
				<div class="kit-radii">
					{RADII.map((r) => (
						<figure class="kit-radius">
							<span class="kit-radius__box" style={`border-radius: ${r.box}`} />
							<figcaption>
								<b>{r.name}</b>
								<span class="kit-muted">{r.where}</span>
							</figcaption>
						</figure>
					))}
				</div>
			</section>

			<!-- ── Spacing ── -->
			<section class="kit-sec" id="spacing">
				<header class="kit-sec__head">
					<h2>Spacing</h2>
					<p>
						The scale every gap and padding is drawn from (<code>$spacing-*</code>), and the five steps a Band pads a
						section with, which drop a step below 750.
					</p>
					<p class="kit-sec__src">src/styles/_variables.scss · src/components/ui/Band.astro</p>
				</header>
				<div class="kit-scale">
					{SPACING.map((n) => (
						<div class="kit-scale__step">
