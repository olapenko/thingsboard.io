---
import PlaygroundLayout from '@layouts/PlaygroundLayout.astro';
import LogoRoom from '@root/pages/internal/design-system/_LogoRoom.astro';
import { designPage } from '@root/pages/internal/_design';

/** The Logo Room's spec page (`_room.ts`): the room component, drawing this page's sections. */
const PAGE = designPage('logos');
---

<PlaygroundLayout title={`${PAGE.label} · Spec`} description={PAGE.blurb} head={false}>
	<LogoRoom page="spec" />
</PlaygroundLayout>
