---
import { Icon } from 'astro-icon/components';
import LogoCell from '@root/pages/internal/design-system/_LogoCell.astro';
import type { Cell, ToneView } from '@root/pages/internal/design-system/_logos';

/**
 * A mark's Colours part, on its sheet and on the Add sheet alike. A card per ground, On light and On dark,
 * each its preview with the values it is drawn in: the primary and, where the mark has one, the
 * secondary (the second tone of two-tone artwork). Each value says where it comes from beside it: its
 * token, the token's dark value, `auto` (the room's rule, `@util/oklch`, following its light value), or
 * none. Under the cards, a line where a colour is too close to another mark's or the site draws the mark
 * otherwise; then the palette, its colours to pick from and a dialog to propose a token. Only what applies
 * is shown. The room's script drives it, by its data attributes.
 */
interface Props {
	/** The mark's id, or `new` for the mark the Add sheet is drafting. */
	id: string;
	label: string;
	tones: { first: ToneView; second?: ToneView };
	/** Its secondary as the row starts, where it has none yet: the Add sheet's, added with a button. */
	secondStart?: ToneView;
	/** The set's colours, as dots to pick from and for the closest one. */
	colours: { label: string; hex: string; ids: string[]; second?: boolean }[];
	/** Its signature tile, in the light and the dark values; none on the Add sheet, whose stage draws them. */
	preview?: { light: Cell; dark: Cell };
	/** Where the site draws it in values of its own. */
	sources?: { where: string; hex: string; want: string; verdict: string }[];
}
const { id, label, tones, secondStart, colours, preview, sources = [] } = Astro.props;
const second = tones.second ?? secondStart;
const ROLES = [
	['first', 'Primary', tones.first],
	['second', 'Secondary', second],
] as const;
const GROUNDS = [
	['light', 'On light'],
	['dark', 'On dark'],
] as const;
/** Where a value comes from, beside its token: for a dark value, what gave it; for a light one, a missing token. */
const fromOf = (t: ToneView, g: 'light' | 'dark') =>
	g === 'light' ? (t.token ? '' : 'no token') : { set: 'set', token: 'dark of', derived: 'auto' }[t.darkFrom];
const differing = sources.filter((x) => x.verdict !== 'same');
/** The tones a token could be proposed for: the mark's own with none yet. */
const untokened =
	id === 'new' ? [] : ROLES.filter(([role, , t]) => t && !t.token && (role === 'first' || tones.second));
---

<div class="ct" data-tones-for={id}>
	{/* Titled by the sheet's Colours tab; the Add sheet's second tone is added and taken out here. */}
	{second && !tones.second && (
		<div class="ct__bar">
			<span class="ct__acts">
				<button type="button" class="ct__btn" data-add-second hidden>
					<Icon name="tabler:plus" aria-hidden="true" />
					Add secondary
				</button>
				<button type="button" class="ct__btn" data-drop-second hidden>
					<Icon name="tabler:minus" aria-hidden="true" />
					Remove secondary
				</button>
			</span>
		</div>
	)}
	<div class="ct__grounds" role="group" aria-label={`${label}'s colours`}>
		{GROUNDS.map(([g, ground]) => (
			<section class="ct__ground" data-ground-card={g} aria-label={ground}>
				<p class="ct__gname">{ground}</p>
				{preview && (
					<figure
						class="ct__tp"
						data-tp={g}
						style={[`--pa: ${tones.first[g]}`, tones.second && `--ps: ${tones.second[g]}`, `--pt: ${tones.first.light}`]
							.filter(Boolean)
							.join('; ')}
					>
						<LogoCell cell={preview[g]} />
					</figure>
				)}
				{ROLES.map(([role, name, t]) => {
					if (!t) return null;
					const hex = t[g];
					const key = `${role}:${g}`;
					const lead = key === 'first:light';
					return (
						<div
							class="ct__cell"
							data-tc={key}
							data-tone-row={role}
							data-base={hex}
							data-from={g === 'dark' ? t.darkFrom : undefined}
							data-active={lead ? '' : undefined}
							hidden={role === 'second' && !tones.second}
						>
							<span class="ct__lab">{name}</span>
							<label
								class="ct__chip"
								style={`--c: ${hex}`}
								title={`Pick its ${name.toLowerCase()}, ${ground.toLowerCase()}`}
							>
								{lead ? (
									<input type="color" value={hex} data-try-for={id} aria-label={`${label}: ${name}, ${ground}`} />
								) : (
									<input type="color" value={hex} data-tone-pick aria-label={`${label}: ${name}, ${ground}`} />
								)}
							</label>
							<span class="ct__val">
								{lead ? (
									<input
										class="ct__hex"
										type="text"
										value={hex}
										maxlength="7"
										spellcheck="false"
										autocomplete="off"
										data-hex-for={id}
										aria-label={`${label}: ${name}, ${ground}, hex`}
									/>
								) : (
									<input
										class="ct__hex"
										type="text"
										value={hex}
										maxlength="7"
										spellcheck="false"
										autocomplete="off"
										data-tone-hex
										aria-label={`${label}: ${name}, ${ground}, hex`}
									/>
								)}
								<span class="ct__from" data-from-text>
									{fromOf(t, g)}
								</span>
								{t.token && (g === 'light' || t.darkFrom === 'token') && (
									<code class="ct__code" data-src-token>
										{t.token}
									</code>
								)}
								{g === 'dark' && (
									<button type="button" class="ct__auto" data-use-derived={t.derived} hidden>
										<Icon name="tabler:refresh" aria-hidden="true" />
										auto
									</button>
								)}
							</span>
							{lead ? (
								<dl class="ct__checks" data-live-for={id} data-hex={hex}>
									<dt class="ct__vh">White on it, and it on white</dt>
									<dd class="ct__check" />
								</dl>
							) : (
								<dl class="ct__checks" data-tone-check>
									<dt class="ct__vh">{role === 'first' ? 'On night' : 'Apart from the primary'}</dt>
									<dd class="ct__check" />
								</dl>
							)}
						</div>
					);
				})}
			</section>
		))}
	</div>
	<p class="ct__note" data-nearest data-set={JSON.stringify(colours.filter((c) => !c.second))} hidden></p>
	{differing.map((x) => (
		<p class="ct__note ct__note--warn" data-verdict={x.verdict}>
			<Icon name="tabler:alert-triangle" aria-hidden="true" />
			<span>
				{x.where}: <code class="ct__code">{x.hex}</code> where its record has <code class="ct__code">{x.want}</code>
			</span>
		</p>
	))}

	<div class="ct__palette">
		<div class="ct__bar">
			<p class="ct__sub">Palette</p>
			{id !== 'new' && (
				<button type="button" class="ct__btn" data-propose-open aria-expanded="false">
					<Icon name="tabler:plus" aria-hidden="true" />
					Propose a token
				</button>
			)}
		</div>
		{(
			[
				['Primaries', false],
				['Secondaries', true],
			] as const
		).map(([name, isSecond]) => (
			<Fragment>
				<p class="ct__rowlab">{name}</p>
				<div class="ct__dots" role="group" aria-label={`${name}: for the value in hand`}>
					{colours
						.filter((c) => !!c.second === isSecond)
						.map((c) => (
							<button
								type="button"
								class:list={['pgs__dotc', c.hex === tones.first.light && 'pgs__dotc--own']}
								data-try-pick={id}
								data-hex={c.hex}
								style={`--c: ${c.hex}`}
								title={`${c.label} · ${c.hex}`}
								aria-label={`Try ${c.label}'s ${c.hex}`}
							/>
						))}
				</div>
			</Fragment>
		))}
		<p class="ct__rowlab" data-added-label hidden>
			Proposed here
		</p>
		<div class="ct__dots" data-added-dots role="group" aria-label="Colours proposed here"></div>

		{id !== 'new' && (
			<div class="ct__dialog" data-propose role="dialog" aria-label="Propose a token" hidden>
				<div class="ct__bar">
					<p class="ct__sub">Propose a token</p>
					<button type="button" class="ct__x" data-propose-close aria-label="Close">
						<Icon name="tabler:x" aria-hidden="true" />
					</button>
				</div>
				<p class="ct__lede">
					A new theme colour, light and dark. Copy as patch sends it for review; once decided, it moves into{' '}
					<code class="ct__code">_theme.scss</code>.
				</p>
				<div class="ct__form">
					<label for={`propose-for-${id}`}>For</label>
					<select id={`propose-for-${id}`} data-propose-for>
						{untokened.map(([role, name]) => (
							<option value={role}>
								{label}’s {name.toLowerCase()}
							</option>
						))}
						<option value="">A new colour</option>
					</select>
					<label for={`propose-token-${id}`}>Token</label>
					<input
						id={`propose-token-${id}`}
						class="ct__hex ct__hex--wide"
						type="text"
						spellcheck="false"
						autocomplete="off"
						data-propose-token
					/>
					<span>Light</span>
					<span class="ct__val">
						<label class="ct__chip" title="Pick its light value">
							<input type="color" data-propose-pick="light" aria-label="Its light value" />
						</label>
						<input
							class="ct__hex"
							type="text"
							maxlength="7"
							spellcheck="false"
							autocomplete="off"
							data-propose-hex="light"
							aria-label="Its light value, hex"
						/>
					</span>
					<span>Dark</span>
					<span class="ct__val">
						<label class="ct__chip" title="Pick its dark value">
							<input type="color" data-propose-pick="dark" aria-label="Its dark value" data-cp-dark />
						</label>
						<input
							class="ct__hex"
							type="text"
							maxlength="7"
							spellcheck="false"
							autocomplete="off"
							data-propose-hex="dark"
							aria-label="Its dark value, hex"
						/>
						<span class="ct__from" data-propose-auto>
							auto
						</span>
					</span>
				</div>
				<p class="ct__msg" data-propose-msg aria-live="polite"></p>
				<div class="ct__acts ct__acts--end">
					<button type="button" class="ct__btn" data-propose-close>
						Cancel
					</button>
					<button type="button" class="ct__btn ct__btn--go" data-propose-go>
						Propose token
					</button>
				</div>
			</div>
		)}
	</div>
</div>

<style lang="scss">
	@use '../../../styles/variables' as *;

	// The room's hairline, as its sheets draw their cells.
	$line: rgba(23, 24, 28, 0.08);

	.ct {
		display: grid;
		gap: 12px;
	}

	// A heading and its actions, on one line.
	.ct__bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
	}

	.ct__sub {
		margin: 0;
		font-size: 15px;
		font-weight: $font-weight-medium;
		color: var(--color-text);
	}

	.ct__acts {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;

		&--end {
			justify-content: flex-end;
		}
	}

	// A card per ground: its preview, then its values. Side by side, or stacked where they do not fit.
	.ct__grounds {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 10px;
	}

	.ct__ground {
		display: grid;
		align-content: start;
		gap: 6px;
		padding: 12px;
		border-radius: 16px;
		box-shadow: inset 0 0 0 1px $line;
	}

	.ct__gname {
		margin: 0 0 2px;
		font-size: 12px;
		color: var(--color-text-secondary);
	}

	// Its tile, larger than the canvas draws it, on its own ground.
	.ct__tp {
		display: grid;
		place-items: center;
		height: 156px;
		margin: 0 0 4px;
		border-radius: 12px;
		background: #f3f4f8;

		&[data-tp='dark'] {
			background: #0b0d1f;
		}

		> :global(*) {
			transform: scale(1.3);
		}

		// Its tones from its own figure, whatever is tried on the sheet around it.
		:global(.lc-draft) {
			--lc-accent: var(--pa) !important;
			--lc-second: var(--ps) !important;
			--lc-tint: var(--pt) !important;
		}
	}

	// A value: its name above, then its swatch, hex, source and check on one line. The value in hand
	// takes the palette's dots.
	.ct__cell {
		display: grid;
		grid-template-columns: 28px minmax(0, 1fr) auto;
		align-items: center;
		gap: 3px 8px;
		padding: 7px 8px;
		border-radius: 10px;
		cursor: pointer;

		&:hover {
			background: #f6f7fb;
		}

		&[data-active] {
			box-shadow: inset 0 0 0 1.5px var(--color-text);
		}

		&[hidden] {
			display: none;
		}
	}

	.ct__lab {
		grid-column: 1 / -1;
		font-size: 12px;
		color: var(--color-text-secondary);
	}

	.ct__chip {
		position: relative;
		width: 28px;
		height: 28px;
		overflow: hidden;
		border-radius: 32%;
		background: var(--c);
		box-shadow: inset 0 0 0 1px rgba(23, 24, 28, 0.1);
		cursor: pointer;

		input {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			opacity: 0;
			cursor: pointer;
		}

		&:focus-within {
			outline: 2px solid var(--focus-ring);
			outline-offset: 2px;
		}
	}

	.ct__val {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px 6px;
		min-width: 0;
	}

	// Code, inline: a hex or a token on a quiet chip. The hex fields wear the same, to be typed in.
	.ct__code,
	.ct__hex {
		padding: 1px 6px;
		border: 1px solid $line;
		border-radius: 6px;
		background: #f4f5f8;
		color: var(--color-text);
		font-family: $font-family-mono;
		font-size: 12px;
		line-height: 18px;
		white-space: nowrap;
	}

	.ct__hex {
		box-sizing: border-box;
		width: calc(7ch + 20px);
		text-transform: lowercase;

		&:hover {
			border-color: rgba(23, 24, 28, 0.2);
		}

		&:focus-visible {
			border-color: transparent;
			outline: 2px solid var(--focus-ring);
		}

		&[data-invalid] {
			border-color: #d92d20;
		}

		&--wide {
			width: 100%;
			text-transform: none;
		}
	}

	.ct__from {
		font-size: 11px;
		color: var(--color-text-secondary);

		&:empty {
			display: none;
		}
	}

	.ct__checks {
		margin: 0;
	}

	.ct__vh {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	// A check, quiet: green when it holds, red when not.
	.ct__check {
		margin: 0;
		padding: 0 6px;
		border-radius: 6px;
		font-size: 11px;
		font-variant-numeric: tabular-nums;
		line-height: 18px;
		white-space: nowrap;

		&:empty {
			display: none;
		}

		&:global(.pr-check--pass) {
			background: #e3f4ea;
			color: #00692f;
		}

		&:global(.pr-check--fail) {
			background: rgba(200, 50, 20, 0.1);
			color: #b42318;
		}
	}

	// Back to the rule's value, beside a value set by hand.
	.ct__auto {
		display: inline-flex;
		align-items: center;
		gap: 3px;
		padding: 0 6px 0 4px;
		border: 0;
		border-radius: 100px;
		background: #eef0f5;
		color: var(--color-text);
		font: inherit;
		font-size: 11px;
		line-height: 18px;
		cursor: pointer;

		&[hidden] {
			display: none;
		}

		&:hover {
			background: #e3e6ee;
		}

		:global(svg) {
			width: 12px;
			height: 12px;
		}
	}

	// A line under the cards: a colour too close to another, the site drawing the mark otherwise.
	.ct__note {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px;
		margin: 0;
		font-size: 12px;
		color: var(--color-text-secondary);

		&[hidden] {
			display: none;
		}

		&[data-clash],
		&--warn {
			color: #9a3412;
		}

		:global(svg) {
			flex: none;
			width: 15px;
			height: 15px;
		}
	}

	.ct__btn {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 5px 12px;
		border: 1px solid rgba(23, 24, 28, 0.14);
		border-radius: 100px;
		background: #fff;
		color: var(--color-text);
		font: inherit;
		font-size: 12px;
		cursor: pointer;

		&[hidden] {
			display: none;
		}

		&:hover {
			background: #f6f7fb;
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 1px;
		}

		&--go {
			border-color: transparent;
			background: var(--color-text);
			color: #fff;

			&:hover {
				background: #2b2d33;
			}
		}

		:global(svg) {
			width: 14px;
			height: 14px;
		}
	}

	// The palette: the set's colours to pick from, by tone, and its token dialog.
	.ct__palette {
		display: grid;
		gap: 6px;
		margin-top: 6px;
		padding-top: 14px;
		border-top: 1px solid $line;
	}

	.ct__rowlab {
		margin: 4px 0 0;
		font-size: 12px;
		color: var(--color-text-secondary);

		&[hidden] {
			display: none;
		}
	}

	.ct__dots {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;

		&:empty {
			display: none;
		}
	}

	.pgs__dotc {
		width: 22px;
		height: 22px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: var(--c);
		box-shadow: inset 0 0 0 1px rgba(23, 24, 28, 0.1);
		cursor: pointer;
		transition: transform 0.15s;

		&:hover {
			transform: scale(1.15);
		}

		&[data-on] {
			box-shadow:
				0 0 0 2px #fff,
				0 0 0 3.5px var(--c);
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 3px;
		}
	}

	// The token dialog: under the palette's dots, in the flow of the sheet.
	.ct__dialog {
		display: grid;
		gap: 10px;
		margin-top: 8px;
		padding: 14px;
		border-radius: 16px;
		background: #fff;
		box-shadow:
			inset 0 0 0 1px rgba(23, 24, 28, 0.14),
			0 10px 24px -12px rgba(23, 24, 28, 0.2);

		&[hidden] {
			display: none;
		}
	}

	.ct__lede {
		margin: 0;
		font-size: 12px;
		line-height: 1.5;
		color: var(--color-text-secondary);
	}

	.ct__form {
		display: grid;
		grid-template-columns: 56px minmax(0, 1fr);
		align-items: center;
		gap: 8px 10px;
		font-size: 12px;
		color: var(--color-text-secondary);

		select {
			padding: 4px 8px;
			border: 1px solid rgba(23, 24, 28, 0.14);
			border-radius: 8px;
			background: #fff;
			color: var(--color-text);
			font: inherit;
			font-size: 13px;
		}
	}

	.ct__msg {
		margin: 0;
		font-size: 12px;
		color: var(--color-text-secondary);

		&:empty {
			display: none;
		}

		&[data-bad] {
			color: #b42318;
		}
	}

	.ct__x {
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		padding: 0;
		border: 0;
		border-radius: 8px;
		background: none;
		color: var(--color-text-secondary);
		cursor: pointer;

		&:hover {
			background: #f1f2f6;
		}

		:global(svg) {
			width: 16px;
			height: 16px;
		}
	}
</style>
