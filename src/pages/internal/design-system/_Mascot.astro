---
/**
 * The AI mascot, a placeholder: the AI core's tile in the brand indigo, flat, with white eyes and the
 * sparkle worn above it. Three moods for the chat: waiting it blinks; thinking its eyes glance up and
 * the sparkle turns; answered the eyes close in a smile. Ideas shows it, and Round 4 as its route.
 */
export type MascotMood = 'idle' | 'think' | 'done';

interface Props {
	mood: MascotMood;
	/** Its width in pixels; the height follows, the sparkle taking the top sixth. */
	size?: number;
}

const { mood, size = 72 } = Astro.props;
---

<svg class:list={['masc', `masc--${mood}`]} viewBox="0 0 64 76" width={size} height={Math.round((size * 76) / 64)}>
	<path class="masc__spark" d="M32 1C33 6 34 7 39 8C34 9 33 10 32 15C31 10 30 9 25 8C30 7 31 6 32 1Z" />
	<rect class="masc__head" x="4" y="18" width="56" height="56" rx="18" />
	{mood === 'done' ? (
		<g class="masc__smile">
			<path d="M19 46q5-7 10 0" />
			<path d="M35 46q5-7 10 0" />
		</g>
	) : (
		<g class="masc__eyes">
			<rect x="20" y="38" width="7" height="13" rx="3.5" />
			<rect x="37" y="38" width="7" height="13" rx="3.5" />
		</g>
	)}
</svg>

<style lang="scss">
	.masc {
		overflow: visible;
	}

	.masc__head,
	.masc__spark {
		fill: var(--color-brand);
	}

	.masc__eyes rect {
		fill: #fff;
		transform-box: fill-box;
		transform-origin: center;
	}

	.masc__smile path {
		fill: none;
		stroke: #fff;
		stroke-width: 3.5;
		stroke-linecap: round;
	}

	.masc__spark {
		transform-box: fill-box;
		transform-origin: center;
	}

	.masc--idle .masc__eyes rect {
		animation: masc-blink 4s infinite;
	}

	.masc--think {
		.masc__eyes {
			transform: translate(3px, -4px);
		}

		.masc__eyes rect {
			height: 10px;
		}

		.masc__spark {
			animation: masc-turn 2.4s cubic-bezier(0.45, 0, 0.55, 1) infinite;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.masc--idle .masc__eyes rect,
		.masc--think .masc__spark {
			animation: none;
		}
	}

	@keyframes masc-blink {
		0%,
		92%,
		100% {
			transform: scaleY(1);
		}

		96% {
			transform: scaleY(0.1);
		}
	}

	@keyframes masc-turn {
		to {
			transform: rotate(180deg);
		}
	}
</style>
