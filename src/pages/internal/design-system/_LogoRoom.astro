	`linear-gradient(155deg, color-mix(in srgb, ${hue} ${DARKTINT_GLOW[s]}%, #15161b) 0%, color-mix(in srgb, ${hue} ${DARKTINT_GLOW[s] - 12}%, #15161b) 55%, #0d0e11 100%)`;
