function playOf(r: (typeof ROWS)[number]): PlayVariant[] {
	const out: PlayVariant[] = [];
	const add = (m: Material, cells: (Cell | undefined)[], v?: Version) =>
		out.push({ m, cells: cells.filter((c): c is Cell => !!c), status: v?.status ?? 'exploring' });
	const hue = r.hue ?? '#17181c';
	const art = ART[r.id];
	const icon = ICON[r.id];
	// White
	if (r.white) add('white', [r.white.cell], r.white);
	// On-premises on White is Round 3's A: the platform's own neutral tile, as its sets and notes say. B,
	// the logomark in green, stays a candidate on its sheet.
	else if (r.id === 'onprem') add('white', [ROWS.find((x) => x.id === 'platform')?.white?.cell]);
	else if (r.id === 'community') add('white', [draft(CE_SVG, CE_ART, 'white', CE_HUE, 'wide')]);
	else if (icon) add('white', [iconTile(icon, 'white', hue)]);
	else add('white', [logoOn('white', hue)]);
	// Colour
	if (r.filled) add('colour', [r.filled.cell], r.filled);
	else if (icon) add('colour', [iconTile(icon, 'solid', hue)]);
	else add('colour', []);
	// Tint: the lists' tile where the product is listed; tried here for the rest (the platform's on the ink).
	if (r.tint) add('tint', [r.tint.cell], r.tint);
	else if (icon) add('tint', [tile('', { size: 88, icon, fill: 'wash', accent: hue })]);
	else if (r.id === 'community') add('tint', []);
	else add('tint', [tile('', { size: 88, logo: 'thingsboard', fill: r.hue ? 'wash' : 'neutral', accent: hue })]);
	// Black: the artwork in its dark-ground colour on near-black; a product's own art keeps its colours.
	const black = art
		? draft(
				read(MARKS[art].src),
				MARKS[art].art,
				'dark',
				'#ffffff',
				'wide' in MARKS[art] && MARKS[art].wide ? 'wide' : 'product'
			)
		: r.id === 'community'
			? draft(CE_SVG, CE_ART, 'dark', darkOf(CE_HUE), 'wide')
			: r.id === 'iot-hub'
				? draft(HUB_SVG, HUB_ART, 'dark', darkOf(hub.accent), 'icon')
				: icon
					? iconTile(icon, 'solid', '#17181c')
					: logoOn('dark', r.id === 'platform' || r.id === 'mobile' ? '#ffffff' : darkOf(hue));
	add('black', [black]);
	// Dark tint: the art on near-black taken toward its colour, an ink mark in its dark-theme value. Not
	// for the icon marks (the AI's), which Mark draws, and has no such fill.
	const tintInk = r.hue ? darkOf(r.hue) : '#ffffff';
	const darkTint = art
		? draft(
				read(MARKS[art].src),
				MARKS[art].art,
				'darktint',
				'#ffffff',
				'wide' in MARKS[art] && MARKS[art].wide ? 'wide' : 'product',
				r.hue
			)
		: r.id === 'community'
			? draft(CE_SVG, CE_ART, 'darktint', darkOf(CE_HUE), 'wide', CE_HUE)
			: r.id === 'iot-hub'
				? draft(HUB_SVG, HUB_ART, 'darktint', darkOf(hub.accent), 'icon', hub.accent)
				: icon
					? undefined
					: logoOn('darktint', r.id === 'platform' ? '#ffffff' : tintInk, r.hue ?? '#17181c');
	add('darktint', [darkTint]);
	if (r.id === 'platform') add('both', [r.white?.cell, black], r.white);
	add('off', []);
	return out;
}
