														<span class="pr-blank pr-blank--s" aria-label="To draw" />
													)
												)}
											</span>
											<span class="pr-round__text">
												<b>{r?.label}</b>
												<span>{(r ? candidatesOf(r) : []).map((c) => `${c.label}: ${c.note}`).join(' · ')}</span>
											</span>
											<button
												type="button"
												class="pr-open"
												data-pick={id}
												aria-controls="pg-sheet"
												aria-expanded="false"
											>
												Open sheet
											</button>
										</li>
									);
								})}
							</ul>
