													<div class="pr-plans__row">
														{g.plans.map((pl) => (
															<span class="pr-plan__name">
																{pl.name}{' '}
																<small>
																	{pl.shade === 0 ? (g.tile === 'white' ? 'pure' : 'lightest') : `shade ${pl.shade}`}
																</small>
															</span>
														))}
													</div>
												</div>
											)}
										</div>
									))}
								</div>
								<p class="pr-plans__key">Each group names its rows; the shades are the round’s record.</p>
							</div>
						)}
						{rd.brief && (
							<div class="pr-round__brief">
								<p class="pgs__label">The brief</p>
								<ol>
									{rd.brief.map((b) => (
										<li>{b}</li>
									))}
								</ol>
							</div>
						)}
					</article>
				))}
			</div>
		</section>
