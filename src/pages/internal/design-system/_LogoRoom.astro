											</p>
											{g.plans.length > 0 && (
												<div class="pr-plans__ladder" style={`--n: ${g.plans.length}`}>
													{ladderOf(g).map((row) => (
														<div class:list={['pr-plans__row', row.dark && 'pr-plans__row--dark']}>
															{g.plans.map((pl) => (
																<span
																	class:list={['pr-plan__tile', row.dark && 'pr-plan__tile--dark']}
																	style={`background: ${row.bg(pl.shade)}`}
																	title={`${pl.name} · ${row.label} · shade ${pl.shade}`}
																>
																	<img src={markUri(row.ink)} alt="" />
																</span>
