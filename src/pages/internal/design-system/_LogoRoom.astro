												<span>{to?.note}</span>
												<span class="pr-comment">{pk.why}</span>
											</span>
											<button
												type="button"
												class="pr-open"
												data-pick={pk.mark}
												aria-controls="pg-sheet"
												aria-expanded="false"
											>
												Open sheet
											</button>
										</li>
									);
								})}
							</ul>
						)}
						{rd.reviews && (
							<ul class="pr-round__picks">
								{rd.reviews.map((id) => {
									const r = rowById(id);
									return (
										<li>
											<span class="pr-round__pair">
												{(r ? candidatesOf(r) : []).map((c) =>
													c.cell ? (
														<LogoCell cell={atSize(c.cell, 48, false)} />
