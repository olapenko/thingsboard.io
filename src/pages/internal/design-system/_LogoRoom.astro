	`linear-gradient(155deg, color-mix(in srgb, ${hue} ${100 - COLOUR_LIFT[s]}%, #fff) 0%, ${hue} 55%, color-mix(in srgb, ${hue} ${100 - COLOUR_DEPTH[s]}%, #000) 100%)`;
