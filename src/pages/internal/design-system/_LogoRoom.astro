															<LogoCell cell={v.cell} />
														</button>
													)}
													<span class:list={['pr-status', `pr-status--${v.status}`]}>{STATUS[v.status]}</span>
													<button
														type="button"
														class="pr-dl"
														data-dl={c.id === 'glyph' ? 'glyph' : 'tile'}
