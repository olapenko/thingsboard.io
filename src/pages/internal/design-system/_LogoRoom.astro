---
import { readFileSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import RoomTabs from '@root/pages/internal/design-system/_RoomTabs.astro';
import PageHero from '@root/pages/internal/design-system/_PageHero.astro';
import { roomPage, type RoomPageId } from '@root/pages/internal/design-system/_room';
import LogoCell from '@root/pages/internal/design-system/_LogoCell.astro';
import {
	sweepLogos,
	type Cell,
	type HueCycle,
	type MarkSize,
	type MarkSpec,
} from '@root/pages/internal/design-system/_logos';
import {
	NEW_SURFACES,
	ecosystemCell,
	glyphWord,
	matrixOf,
	rowOf,
	type Row,
} from '@root/pages/internal/design-system/_surfaces';
import { contrast, resolveHue, sameHue } from '@root/pages/internal/design-system/_hues';
import { MARKS, type MarkName } from '@data/marks';
import { homeProducts } from '@data/homeProducts';
import { homeEcosystem } from '@data/homeEcosystem';
import { FOOTER_ECOSYSTEM, FOOTER_PLATFORMS } from '@data/footer-map';
import { glyphOf } from '@data/product-badges';
import { AI_COLUMNS, AI_COPY, aiBadgeCycleFor } from '@data/ai-visual';
import { shippingComposition } from '@data/home-compositions';
import { CHAT_HUES, CHAT_HUE_LEG_S, CHAT_LAUNCHER, LAUNCHER_BOX } from '@data/chat-widget';
import { parse as parseYaml } from 'yaml';
import { logoMarkSchema, type LogoMark, type LogoMaterial, type LogoRound } from '@models/logo-room';
import { markPath } from '@util/logo-room-records';

/**
 * Design system › Logos: the brand system for the product marks, as a landing page (the public design
 * space, one day; Logos for now). The set,
 * current or to be, on a ground; a showcase of it in use; the logotype; the workbench,
 * where the set is a canvas and each mark opens as a sheet; the map of every mark in every treatment
 * with its status and red marks; the colours; how fills, lifts and lights are built and checked; what is
 * being explored; the legacy files; the actions and next steps; and, last, the vocabulary as a spec.
 *
 * Read from the data the new pages render; drafts and directions are drawn here only, and no shipping
 * page changes until the team agrees. The terms are the Vocabulary section's.
 *
 * What people decide is not edited here: statuses, guidelines, candidates, actions and rounds are the
 * records in `src/content/logo-room/`. This file draws them.
 */
/**
 * Which of the room's pages to draw: Overview, the Bench or the Spec; or `legacy`, the Legacy section
 * alone, which the Files page shows under its inventory.
 */
interface Props {
	page: Exclude<RoomPageId, 'files'> | 'legacy';
}
const { page } = Astro.props;
const HERE = page === 'legacy' ? undefined : roomPage(page);
const SPEC_HREF = roomPage('spec').href;
const BENCH_HREF = roomPage('bench').href;
const ROOT = process.cwd();
const read = (path: string) => readFileSync(join(ROOT, path.replace(/^\//, '')), 'utf8');

/**
 * Where a treatment stands: an idea or a draft, approved and waiting to be built, live on the new
 * pages, or old and to retire. Two more states mark the gaps: not defined (a baseline slot nobody has
 * drawn) and not applicable (an exception's agreed gap).
 */
type Status = 'exploring' | 'designed' | 'shipped' | 'legacy';
const STATUS: Record<Status, string> = {
	shipped: 'Shipped',
	designed: 'Designed',
	exploring: 'Exploring',
	legacy: 'Legacy',
};
const STATUS_NOTE: Record<Status, string> = {
	shipped: 'Live on the new pages',
	designed: 'Approved, waiting to be built',
	exploring: 'An idea or a draft',
	legacy: 'Old files, still in the repo',
};

// ── Cells ──
type MarkCell = Extract<Cell, { kind: 'mark' }>;
const tile = (name: string, mark: MarkSpec): MarkCell => ({ kind: 'mark', name, mark, caption: '' });
const atSize = (c: Cell, size: MarkSize, lift = size >= 64): Cell =>
	c.kind === 'mark'
		? { ...c, mark: { ...c.mark, size, lift: lift && c.mark.lift !== false } }
		: c.kind === 'draft'
			? { ...c, size, lift }
			: c.kind === 'glyph'
				? { ...c, size }
				: c;
const filledOf = (c: Cell, accent: string): Cell =>
	c.kind === 'mark'
		? { ...c, ink: undefined, mark: { ...c.mark, fill: 'solid', tone: undefined, accent } }
		: c.kind === 'draft'
			? { ...c, fill: 'solid', accent }
			: c;

const homeCard = (name: string) => {
	const item = homeEcosystem.find((e) => e.name === name);
	if (!item) throw new Error(`Logos: no homepage ecosystem card "${name}"`);
	return {
		cell: atSize(ecosystemCell(item), 88) as MarkCell,
		accent: item.accent,
		label: item.label,
		description: item.description,
	};
};
const homeProduct = (highlight: string) => {
	const item = homeProducts.find((p) => p.nameHighlight === highlight);
	if (!item) throw new Error(`Logos: no homepage product card "${highlight}"`);
	return {
		cell: atSize(ecosystemCell(item), 88) as MarkCell,
		fill: item.badgeFill,
		label: item.label,
		description: item.description,
	};
};

/**
 * Mark's knockout in one ink, cropped to the art: the darkest tone the ink, the others the ink at half,
 * currentColor the ink. White makes the glyph's mask; a product's accent, its favicon.
 */
function inkedSvg(raw: string, art: readonly number[], ink: string) {
	const half = /^#[0-9a-f]{6}$/i.test(ink) ? `${ink}80` : ink;
	const lum = (hex: string) => {
		const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
		return 0.2126 * r + 0.7152 * g + 0.0722 * b;
	};
	const tones = [...new Set((raw.match(/#[0-9a-fA-F]{6}\b/g) ?? []).map((t) => t.toLowerCase()))].sort(
		(a, b) => lum(a) - lum(b)
	);
	let svg = raw;
	tones.forEach((t, i) => (svg = svg.replace(new RegExp(t, 'gi'), i === 0 ? ink : half)));
	return svg
		.replace(/currentColor/gi, ink)
		.replace(
			/<svg\b([^>]*)>/,
			(_m, attrs: string) =>
				`<svg${attrs.replace(/\s*\b(width|height|viewBox)="[^"]*"/g, '')} viewBox="${art.join(' ')}">`
		);
}
const maskOf = (raw: string, art: readonly number[]) =>
	`data:image/svg+xml;charset=utf-8,${encodeURIComponent(inkedSvg(raw, art, '#ffffff'))}`;
const glyphCell = (mask?: string, icon?: string): Cell => ({
	kind: 'glyph',
	name: '',
	caption: '',
	size: 48,
	mask,
	icon,
});
const artGlyph = (name: MarkName) => glyphCell(maskOf(read(MARKS[name].src), MARKS[name].art));
const logoGlyph = artGlyph('thingsboard');

// ── Artwork not in marks.ts yet: the CE placeholder, the hub ──
/** The old CE icon, the menu's nav/thingsboard-cm-icon.svg until 136498eb79, restored to `_drafts/`. */
const CE_SVG = read('src/pages/internal/design-system/_drafts/thingsboard-ce-icon.svg');
const CE_ART = [0.29, 14, 53.58, 26] as const;
const CE_HUE = 'var(--brand-ce)';
/** The hub the IoT Hub product wears in the docs selector and the docs OG cards (Material's hub). */
const HUB_SVG = read('src/assets/images/docs/product-selector/iot-hub.svg');
const HUB_ART = [0, 0, 24, 23] as const;
const draft = (
	svg: string,
	art: readonly number[],
	fill: 'solid' | 'white' | 'dark' | 'darktint',
	accent: string,
	step: 'product' | 'wide' | 'icon',
	tint?: string
): Cell => ({
	kind: 'draft',
	name: '',
	caption: '',
	size: 88,
	svg,
	art: art as [number, number, number, number],
	step,
	fill,
	accent,
	tint,
	lift: true,
});

// ── The AI core's cycle, as the shipping homepage runs it ──
const SHIP = shippingComposition();
const AI_CYCLE: HueCycle = {
	hues: [
		AI_COPY.badge.color,
		...aiBadgeCycleFor(
			SHIP.sections.map((s) => s.id),
			SHIP.hues
		),
	],
	leg: 1.5,
	on: 'fill',
};
const aiCore = (size: MarkSize, lift = true): Cell => ({
	...tile('AI core', { size, icon: AI_COPY.badge.icon, accent: AI_COPY.badge.color, lift }),
	cycle: AI_CYCLE,
});

// ── The products ──
interface Version {
	cell: Cell;
	status: Status;
	/**
	 * The shipped version this one takes over from: what the pages draw until it lands. Used to match
	 * the pages and for the hero's current set; never drawn as a note.
	 */
	replaces?: Cell;
}
/** The treatments: what a mark is drawn on. `filled` is the Colour tile's key in the data. */
type Col = 'white' | 'filled' | 'tint' | 'black' | 'glyph';
const COLS: { id: Col; label: string; note: string }[] = [
	{ id: 'white', label: 'White tile', note: 'The mark in its own colours on white' },
	{ id: 'filled', label: 'Colour tile', note: 'The mark knocked out of the product’s colour' },
	{ id: 'tint', label: 'Tint tile', note: 'The mark on a light tint of its colour, in lists' },
	{ id: 'black', label: 'Dark tile', note: 'The mark on near-black, the dark style: blank until chosen' },
	{ id: 'glyph', label: 'Glyph', note: 'The mark alone in its colour, on light and on night' },
];
/** Somewhere a version is drawn now. `as` places it by hand; otherwise its look decides. */
interface Use {
	surface: string;
	size: string;
	cell?: Cell;
	as?: Col | 'other';
	tag?: string;
}
interface Product {
	id: string;
	label: string;
	group: 'Platform' | 'Ecosystem' | 'AI';
	white?: Version;
	filled?: Version;
	tint?: Version;
	black?: Version;
	glyph: Version;
	/** The version that represents it in a set: white or colour (`filled`). */
	face: 'white' | 'filled';
	hue?: string;
	role: string;
	/** What the product is, in a line: the sheet's lede. */
	about: string;
	/** Its kind, as its card's kicker says it. */
	kind?: string;
	list?: string;
	row?: Row;
	uses?: Use[];
	/** A declared departure from the baseline, with the still version it must provide. */
	exception?: { what: string; fallback: string };
	guideline: LogoMark['guideline'];
	/** What it waits for outside a round, from its record; `actionsOf` adds what its round asks. */
	asks: LogoMark['actions'];
	comment?: string;
}

// ── The records ──
/**
 * What people decide lives in `src/content/logo-room/`: a file per mark (statuses, guideline,
 * candidates, the next step; its notes as the body) and a file per round. The drawings stay here, built
 * from the site's data and keyed by the same ids; the two must agree, or the room does not build.
 */
const MARK_RECORDS = (await getCollection('logoMarks')).sort((a, b) => a.data.order - b.data.order);
const ROUND_RECORDS = (await getCollection('logoRounds')).sort((a, b) =>
	a.id.localeCompare(b.id, undefined, { numeric: true })
);
const disagree = (where: string, what: string) => {
	throw new Error(`Logo Room: src/content/logo-room/${where}: ${what}`);
};
/** The records' words for the treatments and materials, as this file keys them. */
const COL_OF = { white: 'white', colour: 'filled', tint: 'tint', dark: 'black', glyph: 'glyph' } as const;
const materialOf = (m: LogoMaterial) => (m === 'dark' ? 'black' : m);

const cloud = homeProduct('Cloud');
const onprem = homeProduct('On-premises');
/**
 * A product's Tint tile, as the lists draw it (product-badges.ts): the mark on a tint of the footer's
 * hue for it, at the map's 88. Wherever the footer or the menu lists the product.
 */
const tintOf = (name: string): Cell | undefined => {
	const f = FOOTER_ECOSYSTEM.find((p) => rowOf(p.name) === rowOf(name));
	return f ? tile(f.name, { size: 88, fill: 'wash', accent: f.hue, ...glyphOf(f) }) : undefined;
};
const footerHue = (name: string) =>
	[...FOOTER_PLATFORMS, ...FOOTER_ECOSYSTEM].find(
		(p) => rowOf(p.name) === rowOf(name) && p.name !== 'ThingsBoard Cloud'
	)?.hue;
const ECOSYSTEM: { name: string; mark: MarkName }[] = [
	{ name: 'Edge', mark: 'edge' },
	{ name: 'IoT Gateway', mark: 'gateway' },
	{ name: 'TBMQ', mark: 'tbmq' },
	{ name: 'Trendz', mark: 'trendz' },
];
const hub = homeCard('IoT Hub');
const mobile = homeCard('Mobile App');

/**
 * Each mark as drawn: a cell per treatment it has, and what the site's data says about it (its colour,
 * its list colour, its menu row, where it is placed). A record's status for a treatment needs a cell
 * here, and a cell here needs a status there.
 */
interface Drawing {
	white?: Cell;
	filled?: Cell;
	tint?: Cell;
	black?: Cell;
	glyph: Cell;
	/** The shipped cell a designed one takes over from, by treatment. */
	replaces?: Partial<Record<Col, Cell>>;
	hue?: string;
	list?: string;
	row?: Row;
	uses?: Use[];
	/** The homepage card's kicker, where the record gives no kind. */
	kind?: string;
}
const DRAWINGS: Record<string, Drawing> = {
	platform: {
		white: tile('ThingsBoard', { size: 88, fill: 'white', logo: 'thingsboard', lift: true }),
		glyph: logoGlyph,
		uses: [
			{ surface: 'Bookend', size: '80', as: 'white' },
			{ surface: 'Favicon', size: '16', as: 'other', tag: 'chip only, CE navy' },
		],
	},
	cloud: {
		filled: cloud.cell,
		glyph: logoGlyph,
		hue: cloud.fill,
		kind: cloud.label,
		list: FOOTER_PLATFORMS.find((p) => rowOf(p.name) === 'cloud')?.hue,
		row: 'cloud',
		uses: [
			{ surface: 'Hero', size: '88', as: 'filled' },
			{ surface: 'Bookend', size: '80', as: 'filled' },
			{ surface: 'Region dialog', size: '72', as: 'other', tag: 'own CSS' },
		],
	},
	onprem: {
		filled: onprem.cell,
		glyph: logoGlyph,
		hue: onprem.fill,
		kind: onprem.label,
		list: FOOTER_PLATFORMS.find((p) => rowOf(p.name) === 'platform')?.hue,
		row: 'platform',
		uses: [
			{ surface: 'Hero', size: '88', as: 'filled' },
			{ surface: 'Bookend', size: '80', as: 'filled' },
		],
	},
	community: {
		filled: draft(CE_SVG, CE_ART, 'solid', CE_HUE, 'wide'),
		glyph: glyphCell(maskOf(CE_SVG, CE_ART)),
		hue: CE_HUE,
	},
	mobile: {
		white: mobile.cell,
		filled: filledOf(mobile.cell, mobile.accent),
		tint: tintOf('Mobile Application'),
		glyph: logoGlyph,
		hue: mobile.accent,
		kind: mobile.label,
		list: footerHue('Mobile Application'),
		row: 'mobile',
	},
	...Object.fromEntries(
		ECOSYSTEM.map(({ name, mark }): [string, Drawing] => {
			const card = homeCard(name);
			return [
				name.toLowerCase().replace(/\s+/g, '-'),
				{
					white: card.cell,
					filled: filledOf(card.cell, card.accent),
					tint: tintOf(name),
					glyph: artGlyph(mark),
					hue: card.accent,
					kind: card.label,
					list: footerHue(name),
					row: rowOf(name),
				},
			];
		})
	),
	'iot-hub': {
		white: draft(HUB_SVG, HUB_ART, 'white', hub.accent, 'icon'),
		replaces: { white: hub.cell },
		filled: draft(HUB_SVG, HUB_ART, 'solid', hub.accent, 'icon'),
		tint: tintOf('IoT Hub'),
		glyph: glyphCell(maskOf(HUB_SVG, HUB_ART)),
		hue: hub.accent,
		kind: hub.label,
		list: footerHue('IoT Hub'),
		row: 'iot-hub',
	},
	'ai-core': {
		filled: aiCore(88),
		glyph: glyphCell(undefined, AI_COPY.badge.icon),
		hue: AI_COPY.badge.color,
		uses: [
			{ surface: 'AI section', size: '64', as: 'filled' },
			{
				surface: 'Chat launcher',
				size: `${LAUNCHER_BOX[CHAT_LAUNCHER.size ?? 'large'].tile}`,
				as: 'other',
				tag: CHAT_LAUNCHER.glyph === 'question' ? 'question mark' : 'sparkle',
			},
		],
	},
	cli: {
		filled: tile('CLI', { size: 88, icon: 'tabler:terminal-2', accent: AI_COLUMNS.cli.accent, lift: true }),
		glyph: glyphCell(undefined, 'tabler:terminal-2'),
		hue: AI_COLUMNS.cli.accent,
		uses: [
			{ surface: 'AI window', size: '72', as: 'filled' },
			{ surface: 'AI switch', size: '20', as: 'glyph' },
		],
	},
	assistant: {
		white: tile('AI Assistant', {
			size: 88,
			fill: 'white',
			icon: 'tabler:message-chatbot',
			accent: AI_COLUMNS.assistant.accent,
			lift: true,
		}),
		glyph: glyphCell(undefined, 'tabler:message-chatbot'),
		hue: AI_COLUMNS.assistant.accent,
		uses: [
			{ surface: 'AI window', size: '72', as: 'white' },
			{ surface: 'AI switch', size: '20', as: 'glyph' },
		],
	},
};

/** A record and its drawing, as one product. */
const PRODUCTS: Product[] = MARK_RECORDS.map(({ id, data, body }) => {
	const d = DRAWINGS[id] ?? disagree(`marks/${id}.md`, 'no drawing has this id');
	const version = (key: keyof typeof COL_OF): Version | undefined => {
		const col = COL_OF[key];
		const cell = d[col];
		const status = data.treatments[key];
		if (cell && !status) disagree(`marks/${id}.md`, `the ${key} treatment is drawn but has no status`);
		if (!cell && status) disagree(`marks/${id}.md`, `the ${key} treatment has a status but no drawing`);
		return cell && status ? { cell, status, replaces: d.replaces?.[col] } : undefined;
	};
	return {
		id,
		label: data.label,
		group: data.group,
		white: version('white'),
		filled: version('colour'),
		tint: version('tint'),
		black: version('dark'),
		glyph: version('glyph') ?? disagree(`marks/${id}.md`, 'every mark has a glyph'),
		face: data.signature === 'white' ? 'white' : 'filled',
		hue: d.hue,
		role: data.colourRole,
		about: data.about,
		kind: data.kind ?? d.kind,
		list: d.list,
		row: d.row,
		uses: d.uses,
		exception: data.exception,
		guideline: data.guideline,
		asks: data.actions.filter((a) => !a.done),
		comment: body?.trim() || undefined,
	};
});
for (const id of Object.keys(DRAWINGS))
	if (!MARK_RECORDS.some((r) => r.id === id)) disagree(`marks/${id}.md`, 'drawn here but has no record');

// ── Where each is drawn now: the red marks and the sizes ──
const SHORT: Record<string, string> = {
	menu: 'Menu',
	footer: 'Footer',
	home: 'Homepage',
	install: 'Installations',
	pricing: 'Pricing',
};
const matrix = matrixOf(NEW_SURFACES.filter((s) => !s.parked));
const lookOf = (c: Cell) => {
	if (c.kind === 'mark') {
		const fill = c.mark.fill ?? 'solid';
		const hue = fill === 'white' && !c.mark.icon && !c.ink ? undefined : (c.ink ?? c.mark.accent);
		return { fill, glyph: glyphWord(c.mark), hue };
	}
	if (c.kind === 'menu') {
		const glyph = c.glyph.match(/badge-([a-z-]+)\.svg$/)?.[1]?.replace('thingsboard', 'logo') ?? '';
		return { fill: c.fill, glyph, hue: c.hue };
	}
	return undefined;
};
const sizeOf = (c: Cell) => (c.kind === 'mark' ? `${c.mark.size}` : c.kind === 'menu' ? '32' : '');

/** Every use of a product, placed under the version it draws, or marked red where it draws none. */
function placed(p: Product) {
	const shipped = (v?: Version) => (v ? (v.replaces ?? v.cell) : undefined);
	const uses: Use[] = [
		...(p.uses ?? []),
		...(p.row
			? matrix.flatMap((s) =>
					(s.rows.get(p.row as Row) ?? []).map((cell) => ({
						surface: SHORT[s.id] ?? s.label,
						size: sizeOf(cell),
						cell,
					}))
				)
			: []),
	];
	return uses.map((u) => {
		if (u.as) return { ...u, col: u.as };
		const look = u.cell && lookOf(u.cell);
		for (const c of ['white', 'filled', 'tint'] as const) {
			const ref = shipped(p[c]);
			const v = ref && lookOf(ref);
			if (
				look &&
				v &&
				v.fill === look.fill &&
				v.glyph === look.glyph &&
				(!v.hue || !look.hue || sameHue(v.hue, look.hue))
			) {
				return { ...u, col: c };
			}
		}
		const ref = lookOf(shipped(p.white ?? p.filled) as Cell);
		return { ...u, col: 'other' as const, tag: look && ref && look.glyph !== ref.glyph ? look.glyph : look?.fill };
	});
}
const ROWS = PRODUCTS.map((p) => {
	const uses = placed(p);
	// An exploring version already drawn somewhere has shipped there.
	const filled =
		p.filled?.status === 'exploring' && uses.some((u) => u.col === 'filled')
			? { ...p.filled, status: 'shipped' as const }
			: p.filled;
	return { ...p, filled, uses, marks: uses.filter((u) => u.col === 'other') };
});
const GROUPS = (['Platform', 'Ecosystem', 'AI'] as const).map((g) => ({
	name: g,
	rows: ROWS.filter((r) => r.group === g),
}));

/** The size table: each product's uses, by what the step is for. */
const BANDS = [
	{ id: 'display', label: 'Display', sizes: ['88', '80', '72', '64'] },
	{ id: 'card', label: 'Cards and controls', sizes: ['48', '44'] },
	{ id: 'list', label: 'Lists', sizes: ['40', '36', '32'] },
	{ id: 'glyph', label: 'Glyph', sizes: ['24', '20', '16'] },
];
const bandOf = (size: string) => BANDS.find((b) => b.sizes.includes(size))?.id ?? 'display';

// ── The sets ──
const faceOf = (r: (typeof ROWS)[number], set: 'shipped' | 'designed') => {
	const v = r[r.face];
	if (!v) return undefined;
	if (set === 'shipped') return v.status === 'shipped' ? v.cell : v.replaces;
	return v.status === 'shipped' || v.status === 'designed' ? v.cell : v.replaces;
};

// ── Shots ──
const FOOTER_LIST = (matrix.find((s) => s.id === 'footer')?.cells ?? []).map((c) => {
	const line = [...FOOTER_PLATFORMS, ...FOOTER_ECOSYSTEM].find((p) => p.name === c.name)?.line;
	return { cell: c, name: c.name, line };
});
/** The ecosystem's spotlight: one product at a time, as its homepage card draws it, on its own accent. */
const SPOT = homeEcosystem.map((e) => ({
	name: e.name,
	label: e.label,
	accent: e.accent,
	cell: atSize(ecosystemCell(e), 88),
}));
/** A product's face once the designed changes land, at a size. */
const faceTile = (id: string, size: MarkSize) => {
	const r = ROWS.find((x) => x.id === id);
	const c = r && faceOf(r, 'designed');
	return c ? [atSize(c, size)] : [];
};
/** The stack: four distinct marks, bottom first — the platform under what runs on it. */
