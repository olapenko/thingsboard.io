																	data-surface={m === 'dark' ? 'dark' : undefined}
																	style={`color: ${glyphInk(r.hue)[m]}`}
																>
																	<LogoCell cell={atSize(v.cell, 40 as MarkSize)} />
																	<LogoCell cell={atSize(v.cell, 16 as MarkSize)} />
																</span>
															))}
														</span>
													) : (
														<button
															type="button"
															class="pr-map__art"
															data-pick={r.id}
															aria-controls="pg-sheet"
															aria-expanded="false"
															aria-label={`${r.label}: open its page`}
