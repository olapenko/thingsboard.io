											<p class="pr-plans__name">
												<b>{g.group}</b>
												{g.note && <span>{g.note}</span>}
												{g.plans.length > 0 && (
													<small>
														{ladderOf(g)
															.map((row) => row.label)
															.join(' · ')}
													</small>
