	)
).replace(/</g, '\\u003c');
/** The room's own next steps: what it does not do yet. The marks' actions are their records'. */
const NEXT_STEPS: (Action & { body: string })[] = [
	{
		kind: 'build',
		what: 'the pack',
		body: 'Every tile as SVG, built with the site, so Download pack has files to give.',
	},
	{
		kind: 'build',
		what: 'don’ts as drawings',
		body: 'Each don’t in a guideline drawn with the tile it is about, so a rule is seen as well as read.',
	},
];
---

<div class:list={['pr', `pr--${page}`]}>
	<script type="application/json" id="pr-records" set:html={RECORDS_JSON}></script>
	{HERE && (
		<nav class="pr-toc" aria-label="On this page">
			<RoomTabs current={HERE.id} />
			{HERE.sections.length > 0 && (
				<span class="pr-toc__local">
					{HERE.sections.map((s) => (
						<a href={`#${s.id}`}>{s.label}</a>
					))}
				</span>
			)}
		</nav>
	)}

	{/* ── Hero: a band at the start, the set on it, current or to be, on the ground picked ── */}
	{page === 'overview' && (
		<header class="pr-hero" data-set="next" data-ground="dark" data-surface="dark">
			<div class="pr-hero__inner">
				<div class="pr-hero__text">
					<div class="pr-hero__kicker">
						<p class="pr-hero__logotype">
							<img class="pr-hero__logotype--ink" src={wordmarkUri('#212529')} width="200" alt="ThingsBoard" />
							<img class="pr-hero__logotype--white" src={wordmarkUri('#ffffff')} width="200" alt="" />
						</p>
						<button type="button" class="pr-light" role="switch" aria-checked="false" aria-label="Day" data-hero-light>
							<span class="pr-light__track" aria-hidden="true">
								<span class="pr-light__knob">
									<Icon name="tabler:moon-filled" class="pr-light__off" />
									<Icon name="tabler:sun-filled" class="pr-light__on" />
								</span>
							</span>
						</button>
					</div>
					<h1>Logo Room</h1>
					<p class="pr-lede">
						Every ThingsBoard product, drawn as one family of app icons: the platform, its ecosystem and the AI. See the
						set as it ships today or where it’s heading, shape a direction on the workbench, and check each mark on
						every ground before it goes live.
					</p>
				</div>
				<div class="pr-hero__tools">
					<span class="pg__seg" role="group" aria-label="Set">
						<button type="button" data-hero-set="current" aria-pressed="false">
							Current
						</button>
						<button type="button" data-hero-set="next" aria-pressed="true">
							To be
						</button>
					</span>
					<span class="pr-hero__legend">
						<span data-for-set="current">
							<i class="pr-dot pr-dot--shipped" />
							{heroCount('current', 'shipped')} shipped
						</span>
						<span data-for-set="next">
							<i class="pr-dot pr-dot--shipped" />
							{heroCount('next', 'shipped')} shipped
							<i class="pr-dot pr-dot--designed" />
							{heroCount('next', 'designed')} designed
						</span>
					</span>
				</div>
				<div class="pr-hero__groups">
					{HERO.map((g) => (
						<div class="pr-hero__group">
							<p class="pr-hero__group-name">{g.name}</p>
							<ul>
								{g.items.map((x) => (
									<li data-in-current={x.current ? 'true' : 'false'} data-changed={x.changed ? 'true' : 'false'}>
										<a class="pr-hero__item" href={`${SPEC_HREF}#map-${x.r.id}`} data-pick={x.r.id}>
											<span class="pr-hero__tile">
												{x.current && (
													<span class="pr-hero__v" data-v="current">
														<LogoCell cell={x.current} />
													</span>
												)}
												{x.changed && x.next && (
													<span class="pr-hero__v" data-v="next">
														<LogoCell cell={x.next} />
													</span>
												)}
											</span>
											<span class="pr-hero__name">
												<i
													class="pr-dot"
													data-next={x.changed ? 'designed' : 'shipped'}
													title={x.changed ? 'Designed' : 'Shipped'}
												/>
												{x.r.label}
											</span>
										</a>
									</li>
								))}
							</ul>
						</div>
					))}
				</div>
			</div>
		</header>
	)}

	{/* ── Shots ── */}
	{page === 'overview' && (
		<section class="pr-sec" id="shots">
			<div class="pr-sec__head">
				<h2>
					Showcase
					<a class="pr-anchor" href="#shots" aria-label="Link to Showcase">
						#
					</a>
				</h2>
				<p>The set as the new pages draw it.</p>
			</div>
			<div class="pr-bento">
				<figure class="pr-shot pr-shot--bookend" data-surface="dark">
					<div class="pr-shot__art pr-shot__art--big">
						<LogoCell cell={atSize(cloud.cell, 72, false)} />
						<LogoCell cell={atSize(ROWS[0].white?.cell as Cell, 88)} />
						<LogoCell cell={atSize(onprem.cell, 72, false)} />
					</div>
					<figcaption>Bookend</figcaption>
				</figure>
				<figure class="pr-shot pr-shot--spot" data-slider aria-roledescription="carousel" aria-label="Homepage cards">
					{SPOT.map((s, i) => (
						<div
							class="pr-spot"
							style={`--accent: ${s.accent}`}
							data-active={i === 0 ? '' : undefined}
							aria-hidden={i === 0 ? 'false' : 'true'}
							aria-roledescription="slide"
							aria-label={`${i + 1} of ${SPOT.length}: ${s.name}`}
						>
							<span class="pr-spot__mark">
								<LogoCell cell={s.cell} />
							</span>
							<b>{s.name}</b>
							<span class="pr-spot__label">{s.label}</span>
						</div>
					))}
					<div class="pr-spot__nav">
						<button type="button" class="pr-spot__arrow" data-step="-1" aria-label="Previous card">
							<Icon name="tabler:chevron-left" aria-hidden="true" />
						</button>
						<span class="pr-spot__dots">
							{SPOT.map((s, i) => (
								<button type="button" data-go={i} aria-label={s.name} aria-current={i === 0 ? 'true' : 'false'} />
							))}
						</span>
						<button type="button" class="pr-spot__arrow" data-step="1" aria-label="Next card">
							<Icon name="tabler:chevron-right" aria-hidden="true" />
						</button>
					</div>
					<figcaption>Homepage</figcaption>
				</figure>
				<figure class="pr-shot pr-shot--stack">
					<div class="pr-stacks">
						{STACKS.map((s) => (
							<div class="pr-iso" aria-hidden="true" style={`--n: ${s.cells.length}`}>
								{s.cells.map((c, i) => (
									<span class:list={['pr-iso__layer', cycles(c) && 'pr-iso__layer--cycle']} style={layerStyle(c, i)}>
										<span class="pr-iso__plane">
											<LogoCell cell={c} />
										</span>
									</span>
								))}
							</div>
						))}
					</div>
					<figcaption>
						Stacked <span class="pr-status pr-status--exploring">Exploring</span>
					</figcaption>
				</figure>
				<figure class="pr-shot pr-shot--ai" data-surface="dark" style={GLOW_VARS}>
					<div class="pr-shot__art pr-shot__art--big">
						<LogoCell cell={atSize(ROWS.find((r) => r.id === 'assistant')?.white?.cell as Cell, 64)} />
						<LogoCell cell={aiCore(80)} />
						<LogoCell cell={atSize(ROWS.find((r) => r.id === 'cli')?.filled?.cell as Cell, 64)} />
					</div>
					<figcaption>AI section</figcaption>
				</figure>
				<figure class="pr-shot pr-shot--footer" data-surface="dark">
					<div class="pr-foot">
						{FOOTER_GROUPS.map((g) => (
							<div class:list={['pr-foot__group', g.items.length > 3 && 'pr-foot__group--wide']}>
								<p>{g.name}</p>
								<ul class="pr-list">
									{g.items.map((f) => (
										<li>
											<LogoCell cell={f.cell} />
											<span>
												<b>{f.name}</b>
												{f.line}
											</span>
										</li>
									))}
								</ul>
							</div>
						))}
					</div>
					<figcaption>Footer</figcaption>
				</figure>
				<figure class="pr-shot pr-shot--tabs" data-browser="light">
					<div class="pr-tabs-pair">
						{(['light', 'dark'] as const).map((g) => (
							<div class:list={['pr-browser', `pr-browser--${g}`]}>
								<div class="pr-browser__strip">
									{FAVBAR.map((tab, i) => (
										<span class:list={['pr-tab', i === 0 && 'pr-tab--on']}>
											{tab.icon ? (
												<Icon
													name={tab.icon.name}
													class="pr-tab__icon"
													style={`color:${tab.icon[g]}`}
													aria-hidden="true"
												/>
											) : (
												<img src={tab.fav?.[g]} width="16" height="16" alt="" />
											)}
											<span>{tab.title}</span>
										</span>
									))}
								</div>
								<div class="pr-browser__bar">
									<span class="pr-browser__url">thingsboard.io</span>
								</div>
							</div>
						))}
					</div>
					<figcaption>
						Browser tabs
						<button
							type="button"
							class="pr-light pr-light--sm"
							role="switch"
							aria-checked="true"
							aria-label="Light browser"
							data-browser-light
						>
							<span class="pr-light__track" aria-hidden="true">
								<span class="pr-light__knob">
									<Icon name="tabler:moon-filled" class="pr-light__off" />
									<Icon name="tabler:sun-filled" class="pr-light__on" />
								</span>
							</span>
						</button>
					</figcaption>
				</figure>
			</div>
		</section>
	)}

	{/* ── Spec's hero: the page opened as an article, its subject and what it holds ── */}
	{page === 'spec' && (
		<PageHero
			title="Specification"
			lede="What is agreed about the marks: the logotype and the logomark, every product in every treatment with its status, the colours, how a tile is built and lit, and the words for all of it. What is still being decided lives on the Bench."
			toc={HERE?.sections}
		/>
	)}

	{/* ── Logotype and logomark ── */}
	{page === 'spec' && (
		<section class="pr-sec" id="brand">
			<div class="pr-sec__head">
				<h2>
					Logotype and logomark
					<a class="pr-anchor" href="#brand" aria-label="Link to Logotype and logomark">
						#
					</a>
				</h2>
				<p>The wordmark, the mark every platform tile carries, and the favicon.</p>
			</div>
			<div class="pr-brand">
				<figure class="pr-brand__wide">
					<span class="pr-ground">
						<img src={wordmarkUri('#212529')} width="300" alt="ThingsBoard" />
					</span>
					<span class="pr-ground pr-ground--dark">
						<img src={wordmarkUri('#ffffff')} width="300" alt="" />
					</span>
					<figcaption class="pr-getfiles">
						<b>Logotype</b>
						<a href={wordmarkUri('#212529')} download="thingsboard-logotype.svg">
							<Icon name="tabler:download" aria-hidden="true" />
							SVG, ink
						</a>
						<a href={wordmarkUri('#ffffff')} download="thingsboard-logotype-white.svg">
							<Icon name="tabler:download" aria-hidden="true" />
							SVG, white
						</a>
					</figcaption>
				</figure>
				<figure class="pr-markc" data-markc data-svg={markSvg} data-ink={MARK_INK} data-night="#0b0d1f" data-min={MIN}>
					<span class="pr-ground">
						<img src={markUri(MARK_INK)} width="88" alt="" data-markc-light />
					</span>
					<span class="pr-ground pr-ground--dark">
						<img src={markUri('#ffffff')} width="88" alt="" data-markc-dark />
					</span>
					<figcaption class="pr-markc__cap">
						<span class="pr-getfiles">
							<b>Logomark</b>
							<a href={markUri(MARK_INK)} download="thingsboard-mark.svg">
								<Icon name="tabler:download" aria-hidden="true" />
								Ink
							</a>
							<a href={markUri('#ffffff')} download="thingsboard-mark-white.svg">
								<Icon name="tabler:download" aria-hidden="true" />
								White
							</a>
							<a href={markUri(MARK_INK)} download="thingsboard-mark-colour.svg" hidden data-markc-file>
								<Icon name="tabler:download" aria-hidden="true" />
								<span data-markc-name>Colour</span>
							</a>
						</span>
						<span class="pr-markc__pick" role="group" aria-label="Logomark colour">
							{PALETTE.map((c) => (
								<button
									type="button"
									class="pr-markc__dot"
									style={`--c: ${c.hex}`}
									aria-pressed={c.hex === MARK_INK ? 'true' : 'false'}
									aria-label={`${c.label}, ${c.hex}`}
									title={`${c.label} · ${c.hex}`}
									data-markc-hex={c.hex}
								/>
							))}
							<label class="pr-markc__dot pr-markc__dot--any" title="Any colour">
								<input type="color" value="#3d50f5" aria-label="Any colour" data-markc-custom />
							</label>
						</span>
						<span class="pr-markc__ratio" aria-live="polite" data-markc-ratio>
							As it ships: ink on light, white on dark
						</span>
					</figcaption>
				</figure>
				<figure>
					<span class="pr-ground">
						<img src={faviconUri(false)} width="40" alt="" />
						<img src={faviconUri(false)} width="16" alt="" />
					</span>
					<span class="pr-ground pr-ground--dark">
						<img src={faviconUri(true)} width="40" alt="" />
						<img src={faviconUri(true)} width="16" alt="" />
					</span>
					<figcaption class="pr-getfiles">
						<b>Favicon</b>
						<a href={faviconUri(false)} download="thingsboard-favicon.svg">
							<Icon name="tabler:download" aria-hidden="true" />
							SVG
						</a>
					</figcaption>
				</figure>
			</div>
			<ul class="pr-points">
				<li>
					<b>Logotype</b> #212529, white on dark. The bar 215 (160 from 1200 to 1599, 152 the smallest), the footer 168.
				</li>
				<li>
					<b>Logomark</b> on a tile or in the logotype, never bare.
				</li>
				<li>
					<b>Favicon</b> another drawing: the chip without the orbit, in {faviconHue}
					<span class="pr-red">CE navy, not {brandHex}</span>
				</li>
			</ul>
		</section>
	)}

	{/* ── Open rounds: the Overview's summary of what is being decided, each a way onto the Bench ── */}
	{page === 'overview' && (
		<section class="pr-sec" id="open-rounds">
			<div class="pr-sec__head">
				<h2>
					Open rounds
					<a class="pr-anchor" href="#open-rounds" aria-label="Link to Open rounds">
						#
					</a>
				</h2>
				<p>What is being decided now. Each opens on the Bench with its set loaded.</p>
			</div>
			<div class="pr-open-rounds">
				{ROUNDS.filter((rd) => rd.state === 'open').map((rd) => {
					const marks = [...rd.picks.map((pk) => pk.mark), ...(rd.reviews ?? [])];
					return (
						<a class="pr-open-round" href={`${BENCH_HREF}?start=${rd.id}#workbench`}>
							<span class="pr-open-round__head">
								<b>{rd.label}</b>
								<span class="pr-status pr-status--exploring">Open</span>
							</span>
							<span class="pr-open-round__title">{rd.title}</span>
							<span class="pr-open-round__marks">
								{marks.map((id) => {
									const r = rowById(id);
									const cell = r && (faceOf(r, 'designed') ?? r[r.face]?.cell);
									return cell ? <LogoCell cell={atSize(cell, 48, false)} /> : null;
								})}
							</span>
							<span class="pr-open-round__go">On the Bench →</span>
						</a>
					);
				})}
			</div>
		</section>
	)}

	{/* ── Workbench ── */}
	{page === 'bench' && (
		<section class="pr-sec" id="workbench">
			<PageHero
				title="Workbench"
				lede="The set as a canvas: start from a set, try a direction, and see it hold on every ground before it is proposed."
				pull={68}
			>
				<div class="pg__legend" aria-label="Legend">
					<span title="Live on the pages; a shipped tile has no dot">
						<i class="pr-dot pr-dot--shipped" aria-hidden="true" />
						<b>Shipped</b>
					</span>
					<span title="Approved, to build; a decided round">
						<i class="pr-dot pr-dot--designed" aria-hidden="true" />
						<b>Designed</b>
					</span>
					<span title="An idea or a draft; an open round">
						<i class="pr-dot pr-dot--exploring" aria-hidden="true" />
						<b>Exploring</b>
					</span>
					<span title="A stress test, never a candidate">
						<i class="pr-dot pr-dot--none" aria-hidden="true" />
						<b>Exploration</b>
					</span>
					<span title="Not in the records yet">
						<i class="pr-dot pr-dot--changed" aria-hidden="true" />
						<b>Proposed here</b>
					</span>
				</div>
			</PageHero>
			<div class="pg-layout" data-sets="on" data-guide="on">
				<aside class="pg__guide" id="pg-guide" aria-label="How to use the workbench">
					<p class="pg__side-label">How it works</p>
					<button type="button" class="pg__guide-close" aria-label="Hide how it works">
						<Icon name="tabler:x" aria-hidden="true" />
					</button>
					<ol class="pg__how">
						<li>
							<b>Pick a set</b>
							<span>from the list: as it ships, a round under review, or an exploration.</span>
						</li>
						<li>
							<b>Pick a ground</b>
							<span>on the canvas’s corner: white, grey, tint, dark, or light and dark side by side.</span>
						</li>
						<li>
							<b>Open a mark</b>
							<span>
								by clicking its tile. In its sheet, choose its treatment, propose a status, try a colour, leave a note.
							</span>
						</li>
						<li>
							<b>Share it</b>
							<span>from the bar: Share sends a link to the set; Propose turns your changes into a patch.</span>
						</li>
					</ol>
				</aside>
				<div class="pg__sidecol">
					<aside class="pg__side" id="pg-sets" aria-label="The workbench's sets">
						<section class="pg__side-part">
							<p class="pg__side-label">Sets</p>
							<div class="pg__sets" role="group" aria-label="The set to start from">
								<button type="button" class="pg__preset pg__preset--own" data-value="custom" aria-pressed="true" hidden>
									<i class="pr-dot pr-dot--changed" aria-hidden="true" />
									Your own set
								</button>
								{SET_MENU.map((g) => (
									<div class="pg__sets-group" role="group" aria-label={g.label || 'Shipped'}>
										{g.label && <p class="pg__sets-name">{g.label}</p>}
										{g.items.map((it) => (
											<button
												type="button"
												class="pg__preset"
												data-value={it.id}
												aria-pressed={it.id === 'shipped' ? 'true' : 'false'}
												title={it.note}
											>
												<i class:list={['pr-dot', `pr-dot--${it.dot}`]} aria-hidden="true" />
												{it.label}
											</button>
										))}
									</div>
								))}
							</div>
						</section>
					</aside>
				</div>
				<div class="pg" data-ground="split" data-size="m" data-layout="groups" data-names="on" data-glyph="chip-navy">
					<div class="pg__bar">
						{/* The set in force: the sidebar's list draws it. */}
						<select data-presets class="pg__hidden" tabindex="-1" aria-hidden="true">
							{PRESETS.map((s) => (
								<option value={s.id} data-m={JSON.stringify(s.m)} title={s.note}>
									{s.label}
								</option>
							))}
							<option value="custom" data-custom disabled>
								Your own set
							</option>
						</select>
						<span class="pg__panels">
							<button
								type="button"
								class="pg__panel-toggle"
								data-panel="sets"
								aria-controls="pg-sets"
								aria-expanded="true"
								title="Show or hide the sets"
							>
								<Icon name="tabler:list-details" aria-hidden="true" />
								Sets
							</button>
							<button
								type="button"
								class="pg__panel-toggle"
								data-panel="guide"
								aria-controls="pg-guide"
								aria-expanded="true"
								title="Show or hide how the workbench works"
							>
								<Icon name="tabler:help-circle" aria-hidden="true" />
								How it works
							</button>
						</span>
						<div class="pg__view">
							{PLAY_GLOBALS.filter((c) => !ON_CANVAS.has(c.key)).map((c) =>
								VIEW_SWITCHES[c.key] ? (
									<div class="pg__row" data-global={c.key}>
										<button
											type="button"
											class="pg__toggle"
											role="switch"
											data-on={VIEW_SWITCHES[c.key][0]}
											data-off={VIEW_SWITCHES[c.key][1]}
											aria-checked={c.default === VIEW_SWITCHES[c.key][0] ? 'true' : 'false'}
										>
											{c.label}
											<i aria-hidden="true" />
										</button>
									</div>
								) : (
									<div class="pg__row" data-global={c.key}>
										<span class:list={['pg__ctl-label', (c.key === 'layout' || c.key === 'size') && 'pg__hidden']}>
											{c.label}
										</span>
										<span class="pg__seg" role="group" aria-label={c.label}>
											{c.options.map(([v, l]) => (
												<button
													type="button"
													value={v}
													aria-pressed={c.default === v ? 'true' : 'false'}
