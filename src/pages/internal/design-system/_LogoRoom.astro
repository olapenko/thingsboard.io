	if (g.tile === 'colour' || g.tile === 'darktint') {
		const bg = (s: number) => (g.tile === 'colour' ? shadeColour(hue, s) : shadeDarkTint(hue, s));
		const name = g.tile === 'colour' ? 'Colour tile' : 'Dark tint tile';
		return [
			{ label: `${name}, on light`, dark: false, bg, ink: '#ffffff' },
			{ label: `${name}, on dark`, dark: true, bg, ink: '#ffffff' },
