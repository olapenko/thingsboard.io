	// ── Ecosystem ──
	.lr-matrix-wrap {
		overflow-x: auto;
		border: 1px solid $line;
		border-radius: 12px;
		background: #fff;

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 2px;
