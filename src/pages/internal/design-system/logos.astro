					</thead>
					<tbody>
						{GROUNDS.map((g) => (
							<tr>
								<th scope="row">
									<i class="pgs__ground" style={`background: ${g.hex}`} />
									{g.label}
								</th>
								<td>
									<code>{g.hex}</code>
								</td>
								<td>{g.stands}</td>
								<td>{g.tint ?? <span class="pr-open-slot">To assign</span>}</td>
								<td>{g.backdrop ?? <span class="pr-open-slot">To assign</span>}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>

			<h3 class="pr-h3">Backdrops</h3>
			<div class="pr-backdrops">
				{BACKDROPS.map((b) => (
					<figure class="pr-backdrop">
						<div
							class:list={[
								'pr-backdrop__ground',
								`pr-backdrop__ground--${b.at}`,
								b.style && 'pr-backdrop__ground--cycle',
							]}
							data-surface={b.dark ? 'dark' : undefined}
							style={[b.style, `--ground: ${b.bg}`].filter(Boolean).join('; ')}
						>
							<LogoCell cell={b.cell} />
						</div>
						<figcaption>
							<b>{b.label}</b>
							<span class="pr-backdrop__recipe">{b.recipe}</span>
