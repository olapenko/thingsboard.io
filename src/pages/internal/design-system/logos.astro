							<span class:list={['pr-status', `pr-status--${w.status}`]}>{STATUS[w.status]}</span>
						</header>
						<div class="pr-tint__grounds">
							{TINT_GROUNDS.map((g) => (
								<figure class="pr-tint__ground" data-surface={g.dark ? 'dark' : undefined} style={`--ground: ${g.hex}`}>
									<span
										class:list={['pr-tint__tile', `pr-tint__tile--${w.id}`]}
										style={[
											`--a: ${FILL_HUE}`,
											`--ink: ${g.dark ? TINT_INK.dark : TINT_INK.light}`,
											w.id === 'dynamic' && GLOW_VARS,
										]
											.filter(Boolean)
											.join('; ')}
									>
										{w.id === 'dynamic' ? (
											<Icon name={AI_COPY.badge.icon} class="pr-tint__icon" aria-hidden="true" />
										) : (
											<span class="pr-layer__mask" style={`--mask: url("${EDGE_MASK}")`} />
										)}
									</span>
									<figcaption>{g.label}</figcaption>
								</figure>
