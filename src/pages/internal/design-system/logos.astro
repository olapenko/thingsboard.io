/** A hue taken toward white in tenths until it holds 4.5:1 on the dark browser’s tab: the glyph’s half tone needs the headroom. */
const liftOn = (hex: string, ground = '#35363a') => {
	const mix = (k: number) =>
		`#${[1, 3, 5]
			.map((i) => parseInt(hex.slice(i, i + 2), 16))
			.map((v) =>
				Math.round(v + (255 - v) * k)
					.toString(16)
					.padStart(2, '0')
			)
			.join('')}`;
	for (let k = 0; k <= 1; k += 0.1) if ((contrast(mix(k), ground) ?? 0) >= 4.5) return mix(k);
	return '#ffffff';
