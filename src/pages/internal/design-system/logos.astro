					</figure>
				))}
			</div>
			<h3 class="pr-h3">Lift and light</h3>
			<p class="pr-sub">
				Every light with every edge, for the three opaque fills, on white and on night. Judged by the checks’ 3:1.
			</p>
			<div class="pr-combos">
				{COMBOS.map((c) => (
					<div class="pr-combo">
						<p class="pr-combo__fill">{c.f.label} tile</p>
						<div class="pr-combo__grid">
							<span />
							{LIGHTS.map((l) => (
								<span class="pr-combo__light">
									{c.f.id === 'white' ? (l.id === 'flat' ? 'Pure' : 'Shaded') : l.label}
								</span>
							))}
							<span />
							{LIGHTS.flatMap(() => EDGES.map((e) => <span class="pr-combo__col">{e.label}</span>))}
							{c.grounds.map((g) => (
								<Fragment>
									<span class="pr-combo__row">{g.g.label}</span>
									{g.cells.map((x) => (
										<figure
											class="pr-combo__cell"
											data-surface={g.g.dark ? 'dark' : undefined}
											style={`--ground: ${g.g.hex}`}
											title={x.why}
										>
											<span
												class:list={['pr-combo__tile', `pr-combo__tile--${x.e.id}`]}
												style={`--fill: ${c.f.fill}; --lit: ${x.l.id === 'lit' ? c.f.lit : 'none'}`}
											>
												{c.f.mark === 'knockout' ? (
													<span class="pr-layer__mask" style={`--mask: url("${EDGE_MASK}"); color: #fff`} />
												) : (
													<img src={EDGE_ORIGINAL} alt="" />
												)}
											</span>
											<figcaption class:list={['pr-verdict', `pr-verdict--${x.verdict}`]}>
												{VERDICT_LABEL[x.verdict]}
											</figcaption>
										</figure>
									))}
								</Fragment>
							))}
						</div>
					</div>
				))}
			</div>
			<ul class="pr-points">
				<li>
					<b>Lift on light, hairline on dark.</b> A shadow does nothing on night; a hairline on white doubles an edge
					already there.
				</li>
				<li>
					<b>White on white needs its lift; black on night needs its hairline.</b> Without them the tile is lost
					(1.0:1).
				</li>
				<li>
					<b>Lit at 48 and up.</b> Flat is the Tint tile’s, in lists, where a light reads as noise.
				</li>
				<li>
					<b>White: shaded on light, pure on dark.</b> The shade gives a white tile its volume on white; on night it
					reads as grey, and at 40 and under it is lost.
				</li>
			</ul>

			<h3 class="pr-h3">Contrast checks</h3>
			<p class="pr-sub">
				Measured at build for every mark: its signature tile’s edge on each ground (the lift carries it on a light one),
				each tile’s mark against its fill, and the glyph on light and on night. A new mark or colour is checked as it is
				added; the sheet’s picker checks a colour live.
			</p>
			<div class="pr-table-wrap" role="region" aria-label="Contrast checks" tabindex="0">
				<table class="pr-table pr-checks">
					<thead>
						<tr>
							<th scope="col">Mark</th>
							{GROUNDS.map((g) => (
								<th scope="col">
									<i class="pgs__ground" style={`background: ${g.hex}`} />
									{g.label}
								</th>
							))}
							<th scope="col">Mark on its tiles · W C T</th>
							<th scope="col">Glyph · Light, Dark</th>
						</tr>
					</thead>
					<tbody>
						{CHECKS.map((c) => (
							<tr>
								<th scope="row">
									{c.r.label}
									<small>{c.r.face === 'white' ? 'White' : 'Colour'}</small>
								</th>
								{c.edges.map((e) => (
									<td>
										<span class:list={['pr-check', `pr-check--${e.verdict}`]} title={e.why}>
											{e.ratio?.toFixed(1)}
										</span>
									</td>
								))}
								<td>
									{c.marks.map((m) => (
										<span class:list={['pr-check', `pr-check--${m.verdict}`]} title={`${m.col} · ${m.why}`}>
											<small>{m.col[0]}</small>
											{m.ratio?.toFixed(1)}
										</span>
									))}
								</td>
								<td>
									{c.glyph.map((m) => (
										<span class:list={['pr-check', `pr-check--${m.verdict}`]} title={`${m.g} · ${m.why}`}>
											<small>{m.g[0]}</small>
											{m.ratio?.toFixed(1)}
										</span>
									))}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<p class="pr-legend">
				<span>
					<span class="pr-check pr-check--pass">3.0</span> holds 3:1
				</span>
				<span>
					<span class="pr-check pr-check--lift">1.0</span> held by the lift
				</span>
				<span>
					<span class="pr-check pr-check--fail">1.4</span> a conflict: {CONFLICTS.length} in the set
				</span>
			</p>
			{CONFLICTS.length > 0 && (
				<ul class="pr-conflicts">
					{CONFLICTS.map((x) => (
						<li>
							<b>{x.r.label}</b>
							<span class="pr-red">{x.text}</span>
						</li>
					))}
				</ul>
			)}

			<h3 class="pr-h3">Principles</h3>
			<ul class="pr-points">
				<li>One light for every tile: from the top left, at 155°.</li>
				<li>
					A light is how a fill is lit, not a fill of its own; it is a <code>background-image</code>, so the AI can
					animate the colour under it.
				</li>
				<li>The colour is at full strength in the tile or in the glow around it, never both.</li>
				<li>A glow falls from where the mark sits and is gone before the edge.</li>
				<li>The Glyph has no fill: the mark alone in one ink, for favicons and bookmarks.</li>
			</ul>
		</section>

