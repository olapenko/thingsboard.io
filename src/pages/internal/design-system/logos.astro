});

// ── The products ──
interface Version {
	cell: Cell;
	status: Status;
	/**
	 * The shipped version this one takes over from: what the pages draw until it lands. Used to match
	 * the pages and for the hero's current set; never drawn as a note.
	 */
	replaces?: Cell;
}
/** The treatments: what a mark is drawn on. `filled` is the Colour tile's key in the data. */
type Col = 'white' | 'filled' | 'tint' | 'black' | 'glyph';
const COLS: { id: Col; label: string; note: string }[] = [
	{ id: 'white', label: 'White tile', note: 'The mark in its own colours on white' },
	{ id: 'filled', label: 'Colour tile', note: 'The mark knocked out of the product’s colour' },
	{ id: 'tint', label: 'Tint tile', note: 'The mark on a light tint of its colour, in lists' },
	{ id: 'black', label: 'Dark tile', note: 'The mark on near-black, the dark style: blank until chosen' },
	{ id: 'glyph', label: 'Glyph', note: 'The mark alone in its colour, on light and on night' },
];
/** Somewhere a version is drawn now. `as` places it by hand; otherwise its look decides. */
interface Use {
	surface: string;
	size: string;
	cell?: Cell;
	as?: Col | 'other';
	tag?: string;
}
interface Product {
	id: string;
	label: string;
	group: 'Platform' | 'Ecosystem' | 'AI';
	white?: Version;
	filled?: Version;
	tint?: Version;
	black?: Version;
	glyph: Version;
	/** The version that represents it in a set: white or colour (`filled`). */
	face: 'white' | 'filled';
	hue?: string;
	role: string;
	/** What the product is, in a line: the sheet's lede. The homepage card's own copy where it has one. */
	about: string;
	/** Its kind, as its card's kicker says it. */
	kind?: string;
	list?: string;
	row?: Row;
	uses?: Use[];
	/** A declared departure from the baseline, with the still version it must provide. */
	exception?: { what: string; fallback: string };
	action: string;
	comment?: string;
}

const cloud = homeProduct('Cloud');
const onprem = homeProduct('On-premises');
/**
 * A product's Tint tile, as the lists draw it (product-badges.ts): the mark on a tint of the footer's
 * hue for it, at the map's 88. Shipped wherever the footer or the menu lists the product.
 */
const tintOf = (name: string): Version | undefined => {
	const f = FOOTER_ECOSYSTEM.find((p) => rowOf(p.name) === rowOf(name));
	return f
		? { cell: tile(f.name, { size: 88, fill: 'wash', accent: f.hue, ...glyphOf(f) }), status: 'shipped' }
		: undefined;
};
