								<span class="pgs__meta">Edge</span>
								{s.checks.edges.map((e) => (
									<span class:list={['pr-check', `pr-check--${e.verdict}`]} title={e.why}>
										<i class="pgs__ground" style={`background: ${e.g.hex}`} />
										{e.ratio?.toFixed(1)}
									</span>
								))}
								<span class="pgs__meta">Mark</span>
								{s.checks.marks.map((m) => (
									<span class:list={['pr-check', `pr-check--${m.verdict}`]} title={`${m.col} · ${m.why}`}>
										{m.ratio?.toFixed(1)}
									</span>
								))}
								<span class="pgs__meta">Glyph</span>
								{s.checks.glyph.map((m) => (
									<span class:list={['pr-check', `pr-check--${m.verdict}`]} title={`${m.g} · ${m.why}`}>
										{m.ratio?.toFixed(1)}
									</span>
								))}
							</p>
						)}
						{s.r.uses.length > 0 && (
							<p class="pgs__uses">
								<span class="pgs__meta">Drawn on</span>
								{s.r.uses.map((u) => (
									<span class:list={['pr-use', u.col === 'other' && 'pr-use--red']}>
										{u.surface} <b>{u.size}</b>
									</span>
								))}
