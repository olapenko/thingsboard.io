};

/**
 * A mark's configurations, for its sheet: every treatment the system has, each marked in the guide (the
 * map has it, with its status), a draft (only the bench draws it) or missing (nobody has). The Glyph is
 * listed but is not a set material.
 */
type ConfigState = 'guide' | 'draft' | 'missing';
const CONFIG_ORDER: { m?: Material; col?: Col; label: string }[] = [
	{ m: 'white', col: 'white', label: 'White tile' },
	{ m: 'colour', col: 'filled', label: 'Colour tile' },
	{ m: 'tint', col: 'tint', label: 'Tint tile' },
	{ m: 'black', col: 'black', label: 'Dark tile' },
	{ m: 'darktint', label: 'Dark tint tile' },
	{ m: 'both', label: 'White + Dark' },
	{ col: 'glyph', label: 'Glyph' },
];
const STATE_LABEL: Record<ConfigState, string> = { guide: 'In the guide', draft: 'Draft', missing: 'Missing' };
const configsOf = (r: (typeof ROWS)[number], bench: PlayVariant[]) => {
	const pick = pickOf(r.id);
	const picked = pick && candidatesOf(r).find((c) => c.id === pick.candidate)?.m;
	return CONFIG_ORDER.flatMap((o) => {
		const v = o.col ? r[o.col] : undefined;
		const b = o.m ? bench.find((x) => x.m === o.m) : undefined;
		if (o.m === 'both' && !b) return [];
		const cell = o.col === 'glyph' ? r.glyph.cell : (v?.cell ?? b?.cells[0]);
		const state: ConfigState = v && o.m !== 'both' ? 'guide' : cell ? 'draft' : 'missing';
		const status: Status = v ? v.status : 'exploring';
		return [
			{
				...o,
				cell,
				state,
				status,
				stateLabel: [
					state === 'guide' ? `${STATUS[status]} · in the guide` : STATE_LABEL[state],
					o.m && o.m === picked && `${pick?.round.label}’s pick`,
				]
					.filter(Boolean)
					.join(' · '),
			},
		];
	});
};
const SHEETS = ROWS.map((r) => {
	const bench = playOf(r);
	const sig = faceOf(r, 'designed') ?? r[r.face]?.cell ?? r.glyph.cell;
	return {
		r,
		sig,
		/** The materials the set can use, each with its tiles and status: the sheet's stage and its picker. */
		variants: bench.filter((v) => v.m !== 'off'),
		hex: resolveHue(r.hue) ?? '#17181c',
		ink: glyphInk(r.hue),
		treatments: COLS.map((c) => {
			const v = r[c.id];
			const draftV = !v ? bench.find((b) => MATERIAL_COL[b.m] === c.id && b.cells.length > 0) : undefined;
			return { c, v, draft: draftV?.cells[0] };
		}),
		ladder: LADDER.map((s) => atSize(sig, s, false)),
		checks: CHECKS.find((x) => x.r.id === r.id),
		configs: configsOf(r, bench),
		spec: SPECS[r.id],
		candidates: candidatesOf(r),
		round: roundOf(r.id),
		pick: pickOf(r.id),
	};
});
/** The grounds a sheet's stage can take: the registry's. */
const SHEET_GROUNDS = GROUNDS;
/** The icon picker's first screen, before a search: the kinds of thing the products are. */
const ICON_START = [
	'cpu',
	'server',
	'cloud',
	'router',
	'antenna',
	'broadcast',
	'device-mobile',
	'topology-star',
	'topology-ring',
	'chart-bar',
	'chart-line',
	'database',
	'layout-dashboard',
	'plug-connected',
	'bolt',
	'hexagon',
	'cube',
	'puzzle',
	'building-store',
	'sparkles',
	'message-chatbot',
	'terminal-2',
	'shield-check',
	'world',
];
/** The colours already in the set, for a new colour to be measured against. */
const SET_COLOURS = PRODUCT_COLOURS.filter((c) => c.light).map((c) => ({ label: c.label, hex: c.light as string }));

// ── Vocabulary ──
/**
 * The spec: the system's terms as agreed on 2026-10-23, each with the key the data and the page use for
 * it, so a note, a direction or a rule says one thing and the code says the same.
 */
const VOCABULARY: { group: string; terms: { term: string; means: string; key?: string }[] }[] = [
	{
		group: 'What we name',
		terms: [
			{ term: 'Logo', means: 'The logotype and the mark together' },
			{ term: 'Logotype', means: 'The name set in type', key: 'thingsboard-logo.svg' },
			{ term: 'Mark', means: 'The drawing that identifies a product', key: 'MARKS · MarkName' },
			{ term: 'Set', means: 'All the marks, in three groups: Platform, Ecosystem, AI', key: "Product['group']" },
			{ term: 'App icon', means: 'A mark on a tile', key: 'ui/Mark' },
		],
	},
	{
		group: 'How a mark is shown',
		terms: [
			{
				term: 'Treatment',
				means: 'What the mark is drawn on: a White (pure or shaded), Colour, Tint or Dark tile, or the Glyph',
				key: 'Col: white · filled · tint · black · glyph',
			},
			{ term: 'Mode', means: 'Light or Dark: the ground it sits on, not the site’s theme', key: 'data-surface="dark"' },
			{
				term: 'Ground',
				means: 'The surface itself: White, Grey, Tint, Dark. Each will take a Tint and a backdrop of its own',
				key: 'GROUNDS',
			},
			{ term: 'Size', means: 'One scale: 88 · 72 · 48 · 40 · 32 · 24 · 16', key: 'MarkSize · SCALE' },
			{ term: 'Light', means: 'The 155° gradient that lights a fill; not a fill of its own', key: 'background-image' },
			{
				term: 'Shade',
				means: 'The White tile’s light: its accent toward the far corner. Pure white has none',
				key: 'data-light',
			},
			{ term: 'Lift', means: 'The shadow that seats a tile on a light ground', key: '--elev-mark' },
			{ term: 'Hairline', means: 'The 1px edge that seats a tile on a dark ground', key: '.pg__tile on dark' },
			{ term: 'Shape', means: 'The tile’s outline: the 32% squircle, or a circle', key: "shape: 'circle'" },
			{ term: 'Colour', means: 'Each product’s colour, with a dark and a list value', key: 'hue · list' },
		],
	},
	{
		group: 'What gets decided',
		terms: [
			{ term: 'Baseline', means: 'What every mark has: a treatment for each mode, and a Glyph' },
			{ term: 'Pairing', means: 'A mark’s chosen treatment for each mode' },
			{ term: 'Signature', means: 'The one way a mark is shown when it stands for itself', key: 'face' },
			{
				term: 'Round',
				means: 'A numbered proposal: one candidate picked per mark it touches, with the reason; open, then decided',
				key: 'ROUNDS',
			},
			{ term: 'Candidate', means: 'A version of a mark under review: Current, A, B…', key: 'CANDIDATES' },
			{
				term: 'Exploration',
				means: 'A whole-set stress test on the bench, never a candidate',
				key: "PRESETS · kind: 'exploration'",
			},
			{ term: 'Spec', means: 'What is in a mark, what it does and what it does not', key: 'SPECS' },
			{ term: 'Exception', means: 'A declared departure from the baseline, kept on its mark', key: 'exception.what' },
			{ term: 'Fallback', means: 'The still version an exception must provide', key: 'exception.fallback' },
			{ term: 'Rule', means: 'A do or a don’t, with the example it is about', key: 'ComboVerdict' },
			{ term: 'Check', means: 'A contrast measured at build: 3:1 for an edge or a mark', key: 'CHECKS · MIN' },
		],
	},
	{
		group: 'Where something stands',
		terms: [
			{ term: 'Exploring', means: 'An idea or a draft', key: "'exploring'" },
			{ term: 'Designed', means: 'Approved, waiting to be built', key: "'designed'" },
			{ term: 'Shipped', means: 'Live on the new pages', key: "'shipped'" },
			{ term: 'Legacy', means: 'Old files, to retire', key: "'legacy'" },
			{ term: 'Not defined', means: 'A baseline slot nobody has drawn', key: 'no version' },
			{ term: 'Not applicable', means: 'An exception’s agreed gap' },
		],
	},
];
/** What comes after this page, recorded with the team, not built yet: the workbench has the slots for them. */
const NEXT_STEPS = [
	{
		title: 'Round 2 artwork',
		body: 'TBMQ, Trendz and Community Edition candidates, drawn to the brief, into their A and B slots.',
	},
	{
		title: 'Don’ts as drawings',
		body: 'Each “does not” on a sheet with the tile it is about, so a rule is seen as well as read.',
	},
	{
		title: 'Where notes are saved',
		body: 'Rounds are data in the repo already. Comments and proposed statuses stay in this browser and export as JSON; to decide: a dev endpoint on the lab branch (recommended), or a shared artifact.',
	},
	{
		title: 'Adding a mark',
		body: 'The + tile opens an empty sheet with the colour picker; next it takes an existing mark, a tabler icon or a dropped-in SVG.',
	},
];
---

<PlaygroundLayout title={PAGE.label} description={PAGE.blurb} head={false}>
	<div class="pr">
		<nav class="pr-toc" aria-label="On this page">
			{PAGE.sections.map((s) => (
				<a href={`#${s.id}`}>{s.label}</a>
			))}
			<a class="pr-toc__out" href={designHref({ id: 'logo-files' })}>
				Logo files →
			</a>
		</nav>

		{/* ── Hero: a band at the start, the set on it, current or to be, on the ground picked ── */}
		<header class="pr-hero" data-set="next" data-ground="dark" data-surface="dark">
			<div class="pr-hero__inner">
				<div class="pr-hero__text">
					<p class="pr-kicker">Design system</p>
					<h1>Logos</h1>
					<p class="pr-lede">
						How ThingsBoard draws its products: the platform, its ecosystem and the AI as one family of app icons. See
						the set as it ships or as it will be, compose a direction on the workbench, and check a mark against every
						ground before it lands.
					</p>
				</div>
				<div class="pr-hero__tools">
					<span class="pg__seg" role="group" aria-label="Set">
						<button type="button" data-hero-set="current" aria-pressed="false">
							Current
						</button>
						<button type="button" data-hero-set="next" aria-pressed="true">
							To be
						</button>
					</span>
					<span class="pr-hero__legend">
						<span data-for-set="current">
							<i class="pr-dot pr-dot--shipped" />
							{heroCount('current', 'shipped')} shipped
						</span>
						<span data-for-set="next">
							<i class="pr-dot pr-dot--shipped" />
							{heroCount('next', 'shipped')} shipped
							<i class="pr-dot pr-dot--designed" />
							{heroCount('next', 'designed')} designed
						</span>
					</span>
					<span class="pg__seg" role="group" aria-label="Ground">
						{(
							[
								['white', 'Light'],
								['tint', 'Tint'],
								['dark', 'Dark'],
							] as const
						).map(([g, l]) => (
							<button type="button" data-hero-ground={g} aria-pressed={g === 'dark' ? 'true' : 'false'}>
								<i class="pg__swatch" data-g={g} />
								{l}
							</button>
						))}
					</span>
				</div>
				<div class="pr-hero__groups">
					{HERO.map((g) => (
						<div class="pr-hero__group">
							<p class="pr-hero__group-name">{g.name}</p>
							<ul>
								{g.items.map((x) => (
									<li data-in-current={x.current ? 'true' : 'false'} data-changed={x.changed ? 'true' : 'false'}>
										<a class="pr-hero__item" href={`#map-${x.r.id}`} data-pick={x.r.id}>
											<span class="pr-hero__tile">
												{x.current && (
													<span class="pr-hero__v" data-v="current">
														<LogoCell cell={x.current} />
													</span>
												)}
												{x.changed && x.next && (
													<span class="pr-hero__v" data-v="next">
														<LogoCell cell={x.next} />
													</span>
												)}
											</span>
											<span class="pr-hero__name">
												<i
													class="pr-dot"
													data-next={x.changed ? 'designed' : 'shipped'}
													title={x.changed ? 'Designed' : 'Shipped'}
												/>
												{x.r.label}
											</span>
										</a>
									</li>
								))}
							</ul>
						</div>
					))}
				</div>
			</div>
		</header>

		{/* ── Shots ── */}
		<section class="pr-sec" id="shots">
			<div class="pr-sec__head">
				<h2>
					Showcase
					<a class="pr-anchor" href="#shots" aria-label="Link to Showcase">
						#
					</a>
				</h2>
				<p>The set as the new pages draw it.</p>
			</div>
			<div class="pr-bento">
				<figure class="pr-shot pr-shot--bookend" data-surface="dark">
					<div class="pr-shot__art pr-shot__art--big">
						<LogoCell cell={atSize(cloud.cell, 72, false)} />
						<LogoCell cell={atSize(ROWS[0].white?.cell as Cell, 88)} />
						<LogoCell cell={atSize(onprem.cell, 72, false)} />
					</div>
					<figcaption>Platform · the bookend's trio</figcaption>
				</figure>
				<figure class="pr-shot pr-shot--spot" style={`--n: ${SPOT.length}; --pr-spot: pr-spot-${SPOT.length}`}>
					{SPOT.map((s, i) => (
						<div class="pr-spot" style={`--i: ${i}; --accent: ${s.accent}`}>
							<span class="pr-spot__mark">
								<LogoCell cell={s.cell} />
							</span>
							<b>{s.name}</b>
							<span class="pr-spot__label">{s.label}</span>
						</div>
					))}
					<span class="pr-spot__dots" aria-hidden="true">
						{SPOT.map((_s, i) => (
							<i style={`--i: ${i}`} />
						))}
					</span>
					<figcaption>Ecosystem · one at a time</figcaption>
				</figure>
				<figure class="pr-shot pr-shot--stack">
					<div class="pr-stacks">
						{STACKS.map((s) => (
							<div class="pr-iso" aria-hidden="true" style={`--n: ${s.cells.length}`}>
								{s.cells.map((c, i) => (
									<span class:list={['pr-iso__layer', cycles(c) && 'pr-iso__layer--cycle']} style={layerStyle(c, i)}>
										<span class="pr-iso__plane">
											<LogoCell cell={c} />
										</span>
									</span>
								))}
							</div>
						))}
					</div>
					<figcaption>
						{STACKS[0].label} <span class="pr-status pr-status--exploring">Exploring</span>
					</figcaption>
				</figure>
				<figure class="pr-shot pr-shot--ai" data-surface="dark" style={GLOW_VARS}>
					<div class="pr-shot__art pr-shot__art--big">
