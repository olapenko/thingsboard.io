					<span class="pgs__grounds" role="group" aria-label="Ground">
						{SHEET_GROUNDS.map((g) => (
							<button
								type="button"
								data-sheet-ground={g.id}
								aria-pressed={g.id === 'dark' ? 'true' : 'false'}
								aria-label={g.label}
								title={g.label}
							>
								<i class="pg__swatch" data-g={g.id} />
							</button>
						))}
					</span>
				</div>
				<div class="pgs__part">
					<p class="pgs__label">Colour</p>
					<div class="pgs__colour">
						<label class="pgs__chip" style="--c: #3d50f5" title="Pick a colour">
							<input type="color" value="#3d50f5" data-try-for="new" aria-label="Pick the new mark's colour" />
						</label>
						<input
							class="pgs__hexin"
							type="text"
							value="#3d50f5"
							maxlength="7"
							spellcheck="false"
							autocomplete="off"
							data-hex-for="new"
							aria-label="New mark: hex"
						/>
						<code class="pgs__token">not in the theme yet</code>
					</div>
					<div class="pgs__palette" role="group" aria-label="The set's colours">
						{SET_COLOURS.map((c) => (
							<button
								type="button"
								class="pgs__dotc"
								data-try-pick="new"
								data-hex={c.hex}
								style={`--c: ${c.hex}`}
								title={`${c.label} · ${c.hex}`}
								aria-label={`Start from ${c.label}'s ${c.hex}`}
							/>
						))}
					</div>
					<dl class="pgs__live" data-live-for="new" data-hex="#3d50f5">
						{LIVE.map((k) => (
							<Fragment>
								<dt>{k}</dt>
								<dd class="pr-check" />
							</Fragment>
						))}
					</dl>
					<p class="pgs__nearest" data-nearest data-set={JSON.stringify(SET_COLOURS)} />
				</div>
				<div class="pgs__part">
					<p class="pgs__label">Mark</p>
					<div class="pgs__icon-bar">
						<input
							type="search"
							class="pgs__icon-search"
							placeholder="Search Tabler icons"
							autocomplete="off"
							spellcheck="false"
							data-icon-search
							aria-label="Search Tabler icons"
						/>
						<code class="pgs__token" data-icon-picked>
							tabler:shape
						</code>
					</div>
					<div class="pgs__icons" data-icon-grid data-start={JSON.stringify(ICON_START)} aria-label="Tabler icons" />
					<p class="pgs__soon">An existing mark or a dropped-in SVG: next round.</p>
				</div>
			</article>
		</aside>
	</div>
</PlaygroundLayout>

<script>
	// ── Colour maths: WCAG 2 contrast, and CIE76 ΔE for "how close is this to a colour in the set" ──
	const rgb = (hex: string) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
	const lin = (c: number) => (c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
	const lum = (hex: string) => {
		const [r, g, b] = rgb(hex).map(lin);
		return 0.2126 * r + 0.7152 * g + 0.0722 * b;
	};
	const ratio = (a: string, b: string) => {
		const [x, y] = [lum(a), lum(b)].sort((m, n) => n - m);
		return (x + 0.05) / (y + 0.05);
	};
	const lab = (hex: string) => {
		const [r, g, b] = rgb(hex).map(lin);
		const f = (v: number) => (v > 0.008856 ? Math.cbrt(v) : 7.787 * v + 16 / 116);
		const [x, y, z] = [
			(r * 0.4124 + g * 0.3576 + b * 0.1805) / 0.95047,
			r * 0.2126 + g * 0.7152 + b * 0.0722,
			(r * 0.0193 + g * 0.1192 + b * 0.9505) / 1.08883,
		].map(f);
		return [116 * y - 16, 500 * (x - y), 200 * (y - z)];
	};
	const deltaE = (a: string, b: string) => {
		const [p, q] = [lab(a), lab(b)];
		return Math.hypot(p[0] - q[0], p[1] - q[1], p[2] - q[2]);
	};
	const MIN = 3;

	const press = (group: Element, match: (b: HTMLButtonElement) => boolean) =>
		group
			.querySelectorAll<HTMLButtonElement>('button')
			.forEach((b) => b.setAttribute('aria-pressed', String(match(b))));

	// ── The hero: which set, on which ground (the band's own) ──
	const hero = document.querySelector<HTMLElement>('.pr-hero');
	hero?.querySelectorAll<HTMLButtonElement>('[data-hero-set]').forEach((b) =>
		b.addEventListener('click', () => {
			hero.dataset.set = b.dataset.heroSet;
			press(b.parentElement as Element, (x) => x === b);
		})
	);
	hero?.querySelectorAll<HTMLButtonElement>('[data-hero-ground]').forEach((b) =>
		b.addEventListener('click', () => {
			hero.dataset.ground = b.dataset.heroGround;
			if (b.dataset.heroGround === 'dark') hero.dataset.surface = 'dark';
			else delete hero.dataset.surface;
			press(b.parentElement as Element, (x) => x === b);
		})
	);

	// ── The contents: the section in view is the current link ──
	const toc = [...document.querySelectorAll<HTMLAnchorElement>('.pr-toc a[href^="#"]')];
	const spy = new IntersectionObserver(
		(entries) => {
			const seen = entries
				.filter((e) => e.isIntersecting)
				.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
			if (!seen) return;
			toc.forEach((a) => {
				const on = a.hash === `#${seen.target.id}`;
				if (on) a.setAttribute('aria-current', 'true');
				else a.removeAttribute('aria-current');
				const bar = a.parentElement;
				if (
					on &&
					bar &&
					(a.offsetLeft < bar.scrollLeft || a.offsetLeft + a.offsetWidth > bar.scrollLeft + bar.clientWidth)
				)
					bar.scrollTo({ left: a.offsetLeft - 16 });
			});
		},
		{ rootMargin: '-120px 0px -60% 0px' }
	);
	toc.forEach((a) => {
		const target = document.getElementById(a.hash.slice(1));
		if (target) spy.observe(target);
	});

	// ── The workbench and the sheet ──
	// The set is data attributes the CSS reads: each mark's material on its canvas tiles, its bookmark and
	// its sheet; the view on the workbench's root. The set and the view live in the address
	// (?m=…&ground=…), so a combination can be shared. The sheet is page-level: the hero, the canvas and
	// the map all open it. What is said about a mark (a status proposed, a comment, a colour tried) stays
	// in this browser (`pr-bench-v1`) until the team picks where drafts are saved, and exports as JSON.
	const root = document.querySelector<HTMLElement>('.pg');
	const sheetBox = document.querySelector<HTMLElement>('.pr-sheet');
	if (root && sheetBox) {
		interface Note {
			text: string;
			at: string;
		}
		interface Bench {
			status: Record<string, string>;
			notes: Record<string, Note[]>;
			tries: Record<string, string>;
			/** The Tabler icon on the new mark's placeholders. */
			icon?: string;
		}
		const KEY = 'pr-bench-v1';
		const load = (): Bench => {
			try {
				const raw = JSON.parse(localStorage.getItem(KEY) ?? '{}') as Partial<Bench>;
				return { status: raw.status ?? {}, notes: raw.notes ?? {}, tries: raw.tries ?? {}, icon: raw.icon };
			} catch {
				return { status: {}, notes: {}, tries: {} };
			}
		};
		const bench = load();
		const save = () => {
			try {
				localStorage.setItem(KEY, JSON.stringify(bench));
			} catch {
				// Storage refused (a private window): the bench still works for this visit.
			}
		};

		const sheets = [...sheetBox.querySelectorAll<HTMLElement>('.pgs')];
		const picks = [...document.querySelectorAll<HTMLElement>('[data-pick]')];
		const materials = [...sheetBox.querySelectorAll<HTMLElement>('[data-material-for]')];
		const globals = [...root.querySelectorAll<HTMLElement>('.pg__row[data-global]')];
		/** A mark's tiles on the canvas and its bookmark. */
		const items = (id: string) => root.querySelectorAll<HTMLElement>(`[data-id="${id}"]`);
		const label = (el: Element) => el.querySelector('span')?.textContent?.trim() ?? '';
		const pressed = (el: Element) => el.querySelector<HTMLButtonElement>('button[aria-pressed="true"]');
		const sheetOf = (id: string) => sheets.find((s) => s.dataset.sheet === id);
		const nameOf = (id: string) => sheetOf(id)?.querySelector('h3')?.textContent?.trim() ?? id;

		// The set and the view.
		const setMaterial = (id: string, m: string) => {
			const seg = materials.find((s) => s.dataset.materialFor === id);
			if (!seg || !seg.querySelector(`button[value="${m}"]:not(:disabled)`)) return;
			press(seg, (b) => b.value === m);
			items(id).forEach((el) => (el.dataset.m = m));
			const sheet = sheetOf(id);
			if (sheet) sheet.dataset.m = m;
		};
		const setGlobal = (key: string, value: string) => {
			const row = globals.find((r) => r.dataset.global === key);
			if (!row || !row.querySelector(`button[value="${value}"]`)) return;
			press(row, (b) => b.value === value);
			root.dataset[key] = value;
			if (key === 'light') sheetBox.dataset.light = value;
		};
		const summary = root.querySelector<HTMLElement>('.pg__summary');
		const sync = (write = true) => {
			const params = new URLSearchParams(location.search);
			params.set('m', materials.map((s) => `${s.dataset.materialFor}:${pressed(s)?.value}`).join(','));
			globals.forEach((g) => params.set(g.dataset.global ?? '', pressed(g)?.value ?? ''));
			if (write) history.replaceState(null, '', `${location.pathname}?${params}${location.hash}`);
			if (summary) {
				const set = materials
					.filter((s) => pressed(s)?.value !== 'off')
					.map(
						(s) =>
							`${nameOf(s.dataset.materialFor ?? '')} ${pressed(s)?.querySelector('.pgs__conf-name b')?.textContent?.trim() ?? 'left out'}`
					);
				const view = globals.map((g) => `${label(g)} ${pressed(g)?.textContent?.trim()}`);
				summary.textContent = [...set, '|', ...view].join(' · ');
			}
		};
		materials.forEach((seg) =>
			seg.querySelectorAll<HTMLButtonElement>('button').forEach((b) =>
				b.addEventListener('click', () => {
					setMaterial(seg.dataset.materialFor ?? '', b.value);
					if (presets.some((x) => x.getAttribute('aria-pressed') === 'true')) showPreset();
					sync();
				})
			)
		);
		globals.forEach((row) =>
			row.querySelectorAll<HTMLButtonElement>('button').forEach((b) =>
				b.addEventListener('click', () => {
					setGlobal(row.dataset.global ?? '', b.value);
					sync();
				})
			)
		);
		const presets = [...root.querySelectorAll<HTMLButtonElement>('[data-preset]')];
		const hint = root.querySelector<HTMLElement>('.pg__hint');
		/** The preset in force, or none once a mark is changed by hand (then the hint says from which). */
		const showPreset = (b?: HTMLButtonElement) => {
			const was = presets.find((x) => x.getAttribute('aria-pressed') === 'true');
			presets.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
			if (hint)
				hint.textContent = b
					? (b.dataset.note ?? '')
					: `Your own set${was ? `, from ${was.textContent?.trim()}` : ''}.`;
		};
		presets.forEach((b) =>
			b.addEventListener('click', () => {
				Object.entries(JSON.parse(b.dataset.m ?? '{}') as Record<string, string>).forEach(([id, v]) =>
					setMaterial(id, v)
				);
				showPreset(b);
				sync();
			})
		);

		// The sheet: one open at a time, over the page; Escape or the close button puts focus back.
		let opener: HTMLElement | undefined;
		const open = (id: string, from: HTMLElement) => {
			opener = from;
			sheets.forEach((s) => (s.hidden = s.dataset.sheet !== id));
			sheetBox.hidden = false;
			sheetBox.dataset.open = id;
			picks.forEach((b) => b.setAttribute('aria-expanded', String(b === from)));
			root.querySelectorAll('.pg__item').forEach((el) => el.removeAttribute('data-selected'));
			if (id !== 'new')
				root.querySelectorAll(`.pg__item[data-id="${id}"]`).forEach((el) => el.setAttribute('data-selected', ''));
			const group = sheetOf('new')?.querySelector<HTMLElement>('[data-new-group]');
			if (id === 'new' && group) group.textContent = from.dataset.group ?? '';
			sheetBox.scrollTop = 0;
			sheetOf(id)?.querySelector<HTMLElement>('h3')?.focus({ preventScroll: true });
		};
		const close = () => {
			if (sheetBox.hidden) return;
			sheetBox.hidden = true;
			delete sheetBox.dataset.open;
			picks.forEach((b) => b.setAttribute('aria-expanded', 'false'));
			root.querySelectorAll('.pg__item').forEach((el) => el.removeAttribute('data-selected'));
			opener?.focus({ preventScroll: true });
		};
		picks.forEach((b) =>
			b.addEventListener('click', (e) => {
				// The hero's marks are links to the map: a modified click still follows the link.
				const ev = e as MouseEvent;
				if (b instanceof HTMLAnchorElement && (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.button !== 0)) return;
				e.preventDefault();
				if (sheetBox.dataset.open === b.dataset.pick && b.getAttribute('aria-expanded') === 'true') close();
				else open(b.dataset.pick ?? '', b);
			})
		);
		sheetBox.querySelectorAll('.pgs__close').forEach((b) => b.addEventListener('click', close));
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') close();
		});

		// A sheet's ground: its stage and every tile on it.
		sheets.forEach((s) =>
			s.querySelectorAll<HTMLButtonElement>('[data-sheet-ground]').forEach((b) =>
				b.addEventListener('click', () => {
					const g = b.dataset.sheetGround ?? 'white';
					const dark = g === 'dark';
					const stage = s.querySelector<HTMLElement>('.pgs__stage');
					if (stage) stage.dataset.ground = g;
					[stage, ...s.querySelectorAll<HTMLElement>('.pgs__ladder .pgs__cell')].forEach((c) => {
						if (!c) return;
						if (dark) c.dataset.surface = 'dark';
						else delete c.dataset.surface;
					});
					press(b.parentElement as Element, (x) => x === b);
				})
			)
		);

		// Statuses proposed here: in the sheet's details, and on the canvas tile's dot.
		const showStatus = (key: string) => {
			const v = bench.status[key] ?? '';
			const select = sheetBox.querySelector<HTMLSelectElement>(`.pgs__status[data-key="${key}"]`);
			if (select) {
				select.value = v;
				select.closest('tr')?.toggleAttribute('data-changed', !!v);
			}
			root.querySelectorAll<HTMLElement>(`.pg__dot[data-key="${key}"]`).forEach((dot) => {
				dot.dataset.base ??= dot.dataset.status;
				dot.dataset.status = v || dot.dataset.base;
				dot.toggleAttribute('data-changed', !!v);
			});
		};
		sheetBox.querySelectorAll<HTMLSelectElement>('.pgs__status').forEach((s) => {
			s.addEventListener('change', () => {
				if (s.value) bench.status[s.dataset.key ?? ''] = s.value;
				else delete bench.status[s.dataset.key ?? ''];
				save();
				showStatus(s.dataset.key ?? '');
			});
			showStatus(s.dataset.key ?? '');
		});

		// Comments: listed on the sheet, counted on the canvas tile.
		const showNotes = (id: string) => {
			const list = sheetBox.querySelector<HTMLElement>(`[data-notes-list="${id}"]`);
			const notes = bench.notes[id] ?? [];
			if (list) {
				list.replaceChildren(
					...notes.map((n, i) => {
						const li = document.createElement('li');
						const text = document.createElement('span');
						text.textContent = n.text;
						const meta = document.createElement('small');
						meta.textContent = new Date(n.at).toLocaleDateString();
						const remove = document.createElement('button');
						remove.type = 'button';
						remove.textContent = 'Remove';
						remove.addEventListener('click', () => {
							notes.splice(i, 1);
							save();
							showNotes(id);
						});
						li.append(text, meta, remove);
						return li;
					})
				);
			}
			root.querySelectorAll<HTMLElement>(`[data-count-for="${id}"]`).forEach((c) => {
				c.textContent = String(notes.length);
				c.hidden = notes.length === 0;
			});
		};
		sheetBox.querySelectorAll<HTMLButtonElement>('[data-note-add]').forEach((b) => {
			const id = b.dataset.noteAdd ?? '';
			const field = sheetBox.querySelector<HTMLTextAreaElement>(`[data-note-for="${id}"]`);
			b.addEventListener('click', () => {
				const text = field?.value.trim();
				if (!text || !field) return;
				(bench.notes[id] ??= []).push({ text, at: new Date().toISOString() });
				field.value = '';
				save();
				showNotes(id);
			});
			showNotes(id);
		});

		// A colour tried: from the picker, a hex typed in, or a dot of the set's palette. It paints the
		// sheet, the canvas tiles and the bookmark, and is measured live against the checks' 3:1.
		const live = (id: string, hex: string) => {
			const dds = sheetBox.querySelectorAll<HTMLElement>(`[data-live-for="${id}"] dd`);
			[ratio('#ffffff', hex), ratio(hex, '#ffffff'), ratio(hex, '#0b0d1f')].forEach((r, i) => {
				const dd = dds[i];
				if (!dd) return;
				dd.textContent = `${r.toFixed(1)}:1`;
				dd.classList.toggle('pr-check--pass', r >= MIN);
				dd.classList.toggle('pr-check--fail', r < MIN);
			});
		};
		const nearest = (hex: string) => {
			const out = sheetBox.querySelector<HTMLElement>('[data-nearest]');
			if (!out) return;
			const set = JSON.parse(out.dataset.set ?? '[]') as { label: string; hex: string }[];
			const best = set.map((c) => ({ ...c, d: deltaE(hex, c.hex) })).sort((a, b) => a.d - b.d)[0];
			if (!best) return;
			out.textContent = `Closest in the set: ${best.label} (${best.hex}), ΔE ${best.d.toFixed(0)}${best.d < 12 ? ' · too close to tell apart' : ''}`;
			out.toggleAttribute('data-clash', best.d < 12);
		};
		const baseOf = (id: string) =>
			sheetBox.querySelector<HTMLElement>(`[data-live-for="${id}"]`)?.dataset.hex ?? '#000000';
		const tryColour = (id: string, hex?: string) => {
			const sheet = sheetOf(id);
			const shown = hex ?? baseOf(id);
			const targets: HTMLElement[] = [...items(id)];
			if (sheet && id !== 'new') targets.push(sheet);
			targets.forEach((el) => {
				if (hex) {
					el.style.setProperty('--try', hex);
					el.dataset.try = '';
				} else {
					el.style.removeProperty('--try');
					delete el.dataset.try;
				}
			});
			if (id === 'new') sheet?.style.setProperty('--try', shown);
			const picker = sheetBox.querySelector<HTMLInputElement>(`[data-try-for="${id}"]`);
			if (picker) picker.value = shown;
			picker?.parentElement?.style.setProperty('--c', shown);
			const field = sheetBox.querySelector<HTMLInputElement>(`[data-hex-for="${id}"]`);
			if (field && document.activeElement !== field) field.value = shown;
			const reset = sheetBox.querySelector<HTMLElement>(`[data-try-reset="${id}"]`);
			if (reset) reset.hidden = !hex;
			sheet
				?.querySelectorAll<HTMLElement>('.pgs__dotc')
				.forEach((d) => d.toggleAttribute('data-on', d.dataset.hex === shown));
			if (id === 'new') nearest(shown);
			live(id, shown);
		};
		const remember = (id: string, hex: string) => {
			bench.tries[id] = hex;
			save();
			tryColour(id, hex);
		};
		/** #abc or #aabbcc, with or without the hash, as #aabbcc; anything else is not a colour yet. */
		const hexOf = (v: string) => {
			const m = v.trim().replace(/^#/, '').toLowerCase();
			if (/^[0-9a-f]{6}$/.test(m)) return `#${m}`;
			if (/^[0-9a-f]{3}$/.test(m)) return `#${[...m].map((c) => c + c).join('')}`;
			return undefined;
		};
		sheetBox.querySelectorAll<HTMLInputElement>('[data-try-for]').forEach((input) => {
			const id = input.dataset.tryFor ?? '';
			input.addEventListener('input', () => remember(id, input.value));
			tryColour(id, bench.tries[id]);
		});
		sheetBox.querySelectorAll<HTMLInputElement>('[data-hex-for]').forEach((field) => {
			const id = field.dataset.hexFor ?? '';
			field.addEventListener('input', () => {
				const hex = hexOf(field.value);
				field.toggleAttribute('data-invalid', !hex && field.value.trim() !== '');
				if (hex) remember(id, hex);
			});
			field.addEventListener('blur', () => {
				field.removeAttribute('data-invalid');
				field.value = bench.tries[id] ?? baseOf(id);
			});
			field.addEventListener('keydown', (e) => {
				if (e.key === 'Enter') field.blur();
			});
		});
		sheetBox
			.querySelectorAll<HTMLButtonElement>('[data-try-pick]')
			.forEach((b) => b.addEventListener('click', () => remember(b.dataset.tryPick ?? '', b.dataset.hex ?? '#000000')));
		sheetBox.querySelectorAll<HTMLButtonElement>('[data-try-reset]').forEach((b) =>
			b.addEventListener('click', () => {
				const id = b.dataset.tryReset ?? '';
				delete bench.tries[id];
				save();
				tryColour(id);
			})
		);

		// The icon picker: every Tabler icon, fetched once when the picker is first used (a static route,
		// so the dev server serves it without the trailing slash, as the built site does).
		const grid = sheetBox.querySelector<HTMLElement>('[data-icon-grid]');
		const search = sheetBox.querySelector<HTMLInputElement>('[data-icon-search]');
		const pickedLabel = sheetBox.querySelector<HTMLElement>('[data-icon-picked]');
		let icons: Record<string, string> | undefined;
		const loadIcons = async () => {
			if (icons) return icons;
			icons = (await (await fetch('/internal/design-system/tabler-icons.json')).json()) as Record<string, string>;
			return icons;
		};
		const svgOf = (body: string) =>
			`<svg viewBox="0 0 24 24" width="1em" height="1em" aria-hidden="true" focusable="false">${body}</svg>`;
		const applyIcon = (name: string) => {
			if (!icons?.[name]) return;
			sheetOf('new')
				?.querySelectorAll<HTMLElement>('.pgs__new-tile')
				.forEach((tile) => (tile.innerHTML = svgOf(icons?.[name] ?? '')));
			if (pickedLabel) pickedLabel.textContent = `tabler:${name}`;
			grid?.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.icon === name)));
		};
		const showIcons = async (query: string) => {
			if (!grid) return;
			const set = await loadIcons();
			const terms = query.toLowerCase().trim().split(/\s+/).filter(Boolean);
			const names = terms.length
				? Object.keys(set)
						.filter((n) => terms.every((q) => n.includes(q)))
						.slice(0, 72)
				: (JSON.parse(grid.dataset.start ?? '[]') as string[]).filter((n) => set[n]);
			grid.replaceChildren(
				...names.map((n) => {
					const b = document.createElement('button');
					b.type = 'button';
					b.dataset.icon = n;
					b.title = n;
					b.setAttribute('aria-label', n);
					b.setAttribute('aria-pressed', String(bench.icon === n));
					b.innerHTML = svgOf(set[n]);
					b.addEventListener('click', () => {
						bench.icon = n;
						save();
						applyIcon(n);
					});
					return b;
				})
			);
			if (!names.length) grid.textContent = 'No icon by that name.';
		};
		let searchTimer: ReturnType<typeof setTimeout> | undefined;
		search?.addEventListener('input', () => {
			clearTimeout(searchTimer);
			searchTimer = setTimeout(() => showIcons(search.value), 120);
		});
		picks
			.filter((b) => b.dataset.pick === 'new')
			.forEach((b) =>
				b.addEventListener('click', async () => {
					await showIcons(search?.value ?? '');
					if (bench.icon) applyIcon(bench.icon);
				})
			);

		const flash = (b: HTMLButtonElement, text: string) => {
			const was = b.textContent;
			b.textContent = text;
			setTimeout(() => (b.textContent = was), 1600);
		};
		root.querySelector<HTMLButtonElement>('.pg__copy')?.addEventListener('click', async (e) => {
			const b = e.currentTarget as HTMLButtonElement;
			try {
				await navigator.clipboard.writeText(`${summary?.textContent ?? ''}\n${location.href}`);
				flash(b, 'Copied');
			} catch {
				flash(b, 'Copy failed');
			}
		});
		root.querySelector<HTMLButtonElement>('.pg__export')?.addEventListener('click', async (e) => {
			const b = e.currentTarget as HTMLButtonElement;
			try {
				await navigator.clipboard.writeText(JSON.stringify({ set: location.search, ...bench }, null, 2));
				flash(b, 'Copied as JSON');
			} catch {
				flash(b, 'Copy failed');
			}
		});

		// A round's "Try on the bench": its preset, pressed; the link scrolls to the bench.
		document
			.querySelectorAll<HTMLAnchorElement>('[data-round]')
			.forEach((a) =>
				a.addEventListener('click', () => presets.find((b) => b.dataset.preset === a.dataset.round)?.click())
			);

		// The bookmarks: the tab clicked is the active one, the mark's address in the bar.
		root.querySelectorAll<HTMLElement>('.pg__browser').forEach((b) =>
			b.querySelectorAll<HTMLButtonElement>('.pg__fav').forEach((tab) =>
				tab.addEventListener('click', () => {
					b.querySelectorAll('.pg__fav').forEach((x) => x.classList.toggle('pg__fav--on', x === tab));
					const path = b.querySelector<HTMLElement>('[data-url-path]');
					if (path) path.textContent = tab === b.querySelector('.pg__fav') ? '/' : `/${tab.dataset.url}/`;
				})
			)
		);

		// From the address, if it carries a set and a view.
		const params = new URLSearchParams(location.search);
		params
			.get('m')
			?.split(',')
			.forEach((pair) => {
				const [id, v] = pair.split(':');
				if (id && v) setMaterial(id, v);
			});
		globals.forEach((g) => {
			const v = params.get(g.dataset.global ?? '');
			if (v) setGlobal(g.dataset.global ?? '', v);
		});
		if (params.get('m')) {
			const now = materials.map((s) => `${s.dataset.materialFor}:${pressed(s)?.value}`).join(',');
			const same = presets.find((b) =>
				Object.entries(JSON.parse(b.dataset.m ?? '{}') as Record<string, string>).every(([id, v]) =>
					now.includes(`${id}:${v}`)
				)
			);
			showPreset(same);
		}
		sync(false);
	}
</script>

<style lang="scss">
	@use 'sass:map';
	@use 'sass:math';
	@use '../../../styles/variables' as *;

	$line: rgba(23, 24, 28, 0.08);
	$night: #0b0d1f;

	.pr {
		display: grid;
		gap: 96px;
		max-width: 1240px;
		margin: 0 auto;
		padding: 32px 24px 160px;

		@include media-down(md) {
			gap: 64px;
			padding-inline: 16px;
		}

		code {
			font-family: $font-family-mono;
			font-size: 0.92em;
		}
	}

	// ── Shared ──
	// Clear of the area bar (48) and the sticky contents row under it.
	.pr-sec {
		display: grid;
		gap: 24px;
		scroll-margin-top: 112px;
	}

	.pr-sec__head {
		display: grid;
		gap: 6px;

		h2 {
			@include type-section;

			margin: 0;
		}

		p {
			@include type-body;

			margin: 0;
			color: var(--color-text-secondary);
		}
	}

	.pr-h3 {
		@include type-small-strong;

		margin: 16px 0 -8px;
		font-size: 16px;
	}

	.pr-points {
		display: grid;
		gap: 4px;
		margin: 0;
		padding-left: 18px;

		li {
			@include type-small;

			color: var(--color-text-secondary);
		}

		b {
			color: var(--color-text);
			font-weight: $font-weight-medium;
		}
	}

	.pr-red {
		display: inline-block;
		margin-left: 6px;
		padding: 0 7px;
		border-radius: 6px;
		background: rgba(200, 50, 20, 0.1);
		color: #b42318;
		font-size: 12px;
		font-weight: $font-weight-medium;
		line-height: 18px;
	}

	// An exception is declared, not a fault: neutral, where the red marks are deviations.
	.pr-exception {
		display: inline-block;
		margin-right: 6px;
		padding: 0 7px;
		border-radius: 6px;
		background: #eef0f3;
		color: #3f4654;
		font-size: 12px;
		font-weight: $font-weight-medium;
		line-height: 18px;
	}

	.pr-red--block {
		display: block;
		margin: 6px 0 0;
	}

	.pr-status {
		display: inline-flex;
		align-items: center;
		padding: 1px 8px;
		border-radius: 100px;
		font-size: 12px;
		font-weight: $font-weight-medium;
		line-height: 18px;
		white-space: nowrap;
		vertical-align: middle;
	}

	.pr-status--shipped {
		background: #e3f4ea;
		color: #00692f;
	}

	.pr-status--designed {
		background: #e4e8ff;
		color: #2c3bc4;
	}

	.pr-status--exploring {
		background: #efe9ff;
		color: #5536c4;
	}

	.pr-status--legacy {
		background: #eef0f3;
		color: #4a5261;
	}

	.pr-status--blank {
		background: none;
		box-shadow: inset 0 0 0 1px rgba(23, 24, 28, 0.25);
		color: var(--color-text-secondary);
	}

	// A status as a dot, in the chips' hues: the hero's set and the workbench's tiles.
	$dot: (
		shipped: #12a150,
		designed: #4458f0,
		exploring: #7a5af8,
		legacy: #8a90a0,
	);

	.pr-dot {
		--dot: #{map.get($dot, shipped)};

		display: inline-block;
		flex: none;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--dot);
	}

	@each $s, $c in $dot {
		.pr-dot--#{$s} {
			--dot: #{$c};
		}
	}

	// A heading's own link: shown on hover and on focus, beside the title.
	.pr-anchor {
		margin-left: 10px;
		padding: 0 6px;
		border-radius: 8px;
		color: var(--color-text-light);
		font-size: 0.66em;
		font-weight: $font-weight-medium;
		text-decoration: none;
		vertical-align: middle;
		opacity: 0;
		transition:
			opacity 0.15s,
			background-color 0.15s,
			color 0.15s;

		h2:hover &,
		&:focus-visible {
			opacity: 1;
		}

		&:hover {
			background: rgba(23, 24, 28, 0.06);
			color: var(--color-brand);
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 1px;
		}
	}

	.pr-sub {
		@include type-small;

		max-width: 72ch;
		margin: 0;
		color: var(--color-text-secondary);
	}

	// A measured ratio: holds 3:1, held by the lift, or a conflict.
	.pr-check {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		padding: 0 6px;
		border-radius: 6px;
		font-size: 12px;
		font-variant-numeric: tabular-nums;
		line-height: 20px;
		white-space: nowrap;

		b {
			font-weight: $font-weight-medium;
		}

		small {
			font-size: 11px;
			opacity: 0.7;
		}
	}

	.pr-check--pass {
		background: #e3f4ea;
		color: #00692f;
	}

	.pr-check--lift {
		background: #eef0f3;
		color: #4a5261;
	}

	.pr-check--fail {
		background: rgba(200, 50, 20, 0.1);
		color: #b42318;
	}

	// A ground's swatch, in the ground switchers and the checks.
	.pg__swatch,
	.pgs__ground {
		display: inline-block;
		flex: none;
		width: 12px;
		height: 12px;
		margin-right: 6px;
		border-radius: 4px;
		box-shadow: inset 0 0 0 1px rgba(23, 24, 28, 0.28);
		vertical-align: -1px;
	}

	.pg__swatch[data-g='white'] {
		background: #fff;
	}

	.pg__swatch[data-g='grey'] {
		background: #f6f7fb;
	}

	.pg__swatch[data-g='tint'] {
		background: var(--band-tint);
	}

	.pg__swatch[data-g='split'] {
		background: linear-gradient(90deg, #f6f7fb 50%, $night 50%);
	}

	.pg__swatch[data-g='dark'] {
		background: $night;
	}

	// ── Hero ──
	// A band the width of the window at the top of the page, not a card: the set on it, current or to be,
	// on the ground the reader picks (dark by default). A dot grid fades out from the set, and one indigo
	// glow lights it from above; neither appears anywhere else on the page.
	:global(body) {
		overflow-x: clip;
	}

	.pr-hero {
		--band: #fff;
		--band-ink: var(--color-text);
		--band-soft: var(--color-text-secondary);
		--glow: 14%;

		position: relative;
		isolation: isolate;
		// The width of the window, straight under the section bar (see `.pr-toc`).
		margin: -118px calc(50% - 50vw) 0;
		padding: 88px 24px 72px;
		overflow: hidden;
		background: var(--band);
		color: var(--band-ink);

		@include media-down(md) {
			padding: 56px 16px 48px;
		}

		&::before {
			content: '';
			position: absolute;
			z-index: -1;
			inset: 0;
			background-image: radial-gradient(color-mix(in srgb, var(--band-ink) 16%, transparent) 1px, transparent 1.6px);
			background-size: 22px 22px;
			-webkit-mask-image: radial-gradient(70% 80% at 50% 45%, #000, transparent 75%);
			mask-image: radial-gradient(70% 80% at 50% 45%, #000, transparent 75%);
		}

		&::after {
			content: '';
			position: absolute;
			z-index: -1;
			top: -45%;
			right: 15%;
			width: 70%;
			height: 130%;
			background: radial-gradient(closest-side, color-mix(in srgb, #3d50f5 var(--glow), transparent), transparent);
		}

		&[data-ground='tint'] {
			--band: var(--band-tint);
		}

		&[data-ground='dark'] {
			--band: #{$night};
			--band-ink: #fff;
			--band-soft: rgba(255, 255, 255, 0.64);
			--glow: 30%;
		}
	}

	.pr-hero__inner {
		display: grid;
		gap: 40px;
		max-width: 1192px;
		margin: 0 auto;
	}

	// Wide screens: the composition on one centre line — the title and lede, the tools, the set.
	@include media-up(lg) {
		.pr-hero__inner {
			justify-items: center;
			text-align: center;
		}

		.pr-hero__text {
			justify-items: center;
		}

		.pr-hero__tools {
			justify-content: center;
		}

		.pr-hero__legend {
			margin-right: 0;
		}

		.pr-hero__groups {
			justify-content: center;
		}

		.pr-hero__group {
			justify-items: center;

			ul {
				justify-content: center;
			}
		}
	}

	.pr-hero__text {
		display: grid;
		gap: 14px;
		max-width: 720px;

		h1 {
			@include type-title;

			margin: 0;
		}
	}

	.pr-kicker {
		@include type-eyebrow;

		margin: 0;
		color: var(--band-soft, var(--color-text-secondary));
	}

	.pr-lede {
		@include type-lede;

		margin: 0;
		color: var(--band-soft, var(--color-text-secondary));
		text-wrap: pretty;
	}

	.pr-hero__tools {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px 16px;
	}

	.pr-hero[data-surface='dark'] .pg__seg {
		background: rgba(255, 255, 255, 0.1);

		button {
			color: rgba(255, 255, 255, 0.7);

			&:hover {
				color: #fff;
			}

			&[aria-pressed='true'] {
				background: rgba(255, 255, 255, 0.94);
				color: #17181c;
			}
		}
	}

	.pr-hero__legend {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-right: auto;
		font-size: 13px;
		color: var(--band-soft);

		> span {
			display: inline-flex;
			align-items: center;
			gap: 6px;
		}

		.pr-dot:not(:first-child) {
			margin-left: 8px;
		}
	}

	.pr-hero[data-set='current'] [data-for-set='next'],
	.pr-hero[data-set='next'] [data-for-set='current'] {
		display: none !important;
	}

	.pr-hero__groups {
		display: flex;
		flex-wrap: wrap;
		gap: 32px 56px;
	}

	.pr-hero__group {
		display: grid;
		align-content: start;
		gap: 12px;

		ul {
			display: flex;
			flex-wrap: wrap;
			gap: 8px;
			margin: 0;
			padding: 0;
			list-style: none;
		}
	}

	.pr-hero__group-name {
		@include type-eyebrow;

		margin: 0;
		color: var(--band-soft);
	}

	// Each mark opens its sheet (and links to its row in the map without script): a soft plate on hover,
	// the tile lifting toward the reader.
	.pr-hero__item {
		display: grid;
		justify-items: center;
		gap: 10px;
		width: 108px;
		padding: 10px 4px 12px;
		border-radius: 18px;
		color: var(--band-ink);
		font-size: 14px;
		text-align: center;
		text-decoration: none;
		transition: background-color 0.2s;

		&:hover,
		&[aria-expanded='true'] {
			background: color-mix(in srgb, var(--band-ink) 7%, transparent);
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 2px;
		}
	}

	.pr-hero__tile {
		display: grid;
		transition: transform 0.2s ease;

		.pr-hero__item:hover & {
			transform: translateY(-3px);
		}

		@media (prefers-reduced-motion: reduce) {
			transition: none;

			.pr-hero__item:hover & {
				transform: none;
			}
		}
	}

	.pr-hero__name {
		display: inline-flex;
		align-items: center;
		gap: 6px;
	}

	.pr-hero[data-set='current'] {
		[data-v='next'],
		li[data-in-current='false'] {
			display: none;
		}
	}

	.pr-hero[data-set='next'] {
		li[data-changed='true'] [data-v='current'] {
			display: none;
		}

		.pr-dot[data-next='designed'] {
			--dot: #{map.get($dot, designed)};
		}
	}

	// A white tile's edge on night: the hairline, since the lift is lost there.
	.pr-hero[data-surface='dark'] :global(.ui-mark--white),
	.pr-hero[data-surface='dark'] :global(.lc-draft--white) {
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.16);
	}

	// The section bar comes first, the width of the window under the area bar, before the hero: up past
	// the layout's top padding (40) and this page's (32), its links on the page's column. 50 tall, its
	// margins sum to that, so its grid row is exactly zero (a row cannot go below it); the hero then
	// pulls up over the grid's gap (96) and the 22 the bar rose above its row.
	.pr-toc {
		position: sticky;
		top: 48px;
		z-index: 3;
		align-self: start;
		display: flex;
		align-items: center;
		gap: 4px;
		height: 50px;
		margin: -72px calc(50% - 50vw) -22px;
		padding: 10px calc(50vw - 50%);
		border-bottom: 1px solid $line;
		overflow-x: auto;
		background: color-mix(in srgb, #fff 92%, transparent);
		backdrop-filter: blur(6px);
		scrollbar-width: none;

		// One line, scrolling sideways where the links outgrow it, so the sticky bar keeps its height.
		// Hover is a soft plate; the section in view is the ink pill, as the area bar marks its page.
		a {
			flex: none;
			padding: 4px 12px;
			white-space: nowrap;
			border-radius: 100px;
			color: var(--color-text-secondary);
			font-size: 14px;
			text-decoration: none;
			transition:
				background-color 0.15s,
				color 0.15s;

			&:hover {
				background: rgba(23, 24, 28, 0.06);
				color: var(--color-text);
			}

			&[aria-current='true'] {
				background: var(--color-text);
				color: #fff;
			}

			&:focus-visible {
				outline: 2px solid var(--focus-ring);
				outline-offset: -2px;
			}
		}
	}

	.pr-toc__out {
		margin-left: auto;

		&:hover {
			color: var(--color-brand) !important;
		}
	}

	// ── Shots ──
	// Twelve columns in thirds, packed in DOM order: the platform's trio, the ecosystem's spotlight and the
	// stack along the top (those two two rows tall), the AI under the trio; then the footer and the favbar
	// the width of the grid. At two columns the same order checkers: trio and spotlight, stack and AI.
	.pr-bento {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		grid-auto-rows: minmax(230px, auto);
		grid-auto-flow: dense;
		gap: 16px;

		@include media-down(lg) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		@include media-down(sm) {
			grid-template-columns: minmax(0, 1fr);
			grid-auto-rows: auto;
		}
	}

	.pr-shot {
		display: grid;
		grid-template-rows: 1fr auto;
		grid-column: span 4;
		gap: 16px;
		margin: 0;
		padding: 24px 28px;
		border-radius: 24px;
		overflow: hidden;

		@include media-down(lg) {
			grid-column: span 1;
		}

		figcaption {
			display: flex;
			align-items: center;
			gap: 8px;
			font-size: 14px;
			color: var(--color-text-secondary);
		}

		&[data-surface='dark'] figcaption {
			color: rgba(255, 255, 255, 0.64);
		}
	}

	// Platform: the bookend's trio on the indigo band, lit from below.
	.pr-shot--bookend {
		background: radial-gradient(80% 70% at 50% 110%, rgba(110, 125, 255, 0.35), transparent 70%), var(--band-indigo);
	}

	// Ecosystem: one product at a time on white, the card taking that product's accent.
	.pr-shot--spot {
		--leg: 3s;

		position: relative;
		isolation: isolate;
		grid-row: span 2;
		background: #fff;
		box-shadow: inset 0 0 0 1px $line;

		@include media-down(sm) {
			min-height: 380px;
		}

		figcaption {
			position: relative;
			z-index: 1;
		}
	}

	// AI: night, its glow cycling the core's hues on the core's clock (GLOW_VARS); only the accent moves.
	// The glow is a registered colour, so the gradient can interpolate it.
	.pr-shot--ai {
		--pr-glow: var(--pr-hue-0, #3d50f5);

		background:
			radial-gradient(90% 80% at 50% 0%, color-mix(in srgb, var(--pr-glow) 42%, transparent), transparent 70%),
			radial-gradient(60% 50% at 50% 120%, color-mix(in srgb, var(--pr-glow) 18%, transparent), transparent 70%), $night;
		animation: var(--pr-anim, none) var(--pr-lap, 9s) linear infinite;

		@media (prefers-reduced-motion: reduce) {
			animation: none;
		}
	}

	// The stack: the four marks laid in iso on a cool white.
	.pr-shot--stack {
		grid-row: span 2;
		background: linear-gradient(160deg, #f4f6fb, #fff 70%);
		box-shadow: inset 0 0 0 1px $line;
	}

	// A list: the footer's black, the width of the grid.
	.pr-shot--footer {
		grid-column: 1 / -1;
		background: #000;
	}

	// The favbar: the products' tabs in a light and a dark browser, the width of the grid.
	.pr-shot--tabs {
		grid-column: 1 / -1;
		background: #f4f5f9;
	}

	@include media-down(sm) {
		.pr-shot {
			grid-column: auto !important;
			grid-row: auto !important;
		}
	}

	.pr-shot__art {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 24px;
	}

	// The primary visual larger than the page draws it, for the shot.
	.pr-shot__art--big {
		gap: 20px;
		zoom: 1.15;
	}

	// A slide per product, all in the card, one shown a leg at a time. EcosystemCard's glow under the
	// mark: the accent at 17%, 7% by 42%, gone by 84%; the name, and the line in the accent.
	.pr-spot {
		position: absolute;
		z-index: 0;
		inset: 0;
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 4px;
		padding-bottom: 48px;
		background: radial-gradient(
			85% 65% at 50% 34%,
			color-mix(in srgb, var(--accent) 17%, transparent),
			color-mix(in srgb, var(--accent) 7%, transparent) 42%,
			transparent 84%
		);
		text-align: center;
		opacity: 0;
		animation: var(--pr-spot) calc(var(--n) * var(--leg)) ease-in-out infinite;
		animation-delay: calc((var(--i) - var(--n)) * var(--leg));

		b {
			@include type-small-strong;

			font-size: 18px;
		}
	}

	.pr-spot__mark {
		margin-bottom: 16px;
		zoom: 1.25;
	}

	.pr-spot__label {
		font-size: 13px;
		font-weight: $font-weight-medium;
		color: var(--accent);
	}

	// Where the cycle is: a dot per product, the current one inked, on the slides' clock.
	.pr-spot__dots {
		position: relative;
		z-index: 1;
		display: flex;
		align-self: end;
		justify-content: center;
		gap: 6px;

		i {
			position: relative;
			width: 6px;
			height: 6px;
			border-radius: 50%;
			background: rgba(23, 24, 28, 0.14);

			&::after {
				content: '';
				position: absolute;
				inset: 0;
				border-radius: inherit;
				background: var(--color-text);
				opacity: 0;
				animation: var(--pr-spot) calc(var(--n) * var(--leg)) ease-in-out infinite;
				animation-delay: calc((var(--i) - var(--n)) * var(--leg));
			}
		}
	}

	.pr-shot--spot:hover :is(.pr-spot, .pr-spot__dots i::after) {
		animation-play-state: paused;
	}

	// A slide's lap, for two to eight (the card names its own, `--pr-spot`): shown for its leg, out over the leg's last tenth, in over the
	// lap's last tenth of a leg — the next slide's, so one leaves before the other arrives.
	@for $n from 2 through 8 {
		$w: math.div(100%, $n);
		$f: $w * 0.1;

		@keyframes pr-spot-#{$n} {
			0%,
			#{$w - $f} {
				opacity: 1;
				transform: none;
			}
			#{$w - math.div($f, 2)},
			#{100% - math.div($f, 2)} {
				opacity: 0;
				transform: translateY(6px);
			}
			100% {
				opacity: 1;
				transform: none;
			}
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pr-spot,
		.pr-spot__dots i::after {
			animation: none;
		}

		.pr-spot:first-child,
		.pr-spot__dots i:first-child::after {
			opacity: 1;
		}
	}

	.pr-list {
		display: grid;
		align-content: center;
		gap: 16px;
		margin: 0;
		padding: 0;
		list-style: none;

		li {
			display: flex;
			align-items: center;
			gap: 12px;
		}

		span {
			display: grid;
			color: rgba(255, 255, 255, 0.6);
			font-size: 12px;
			line-height: 16px;
		}

		b {
			color: #fff;
			font-size: 14px;
			font-weight: $font-weight-medium;
		}
	}

	.pr-list--compact {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px 16px;

		b {
			font-size: 13px;
		}
	}

	// ── The stacks ──
	// True isometric, no perspective: each tile laid on one plane (55° then 45°), a layer up per tile,
	// with the spread wide enough that every tile's face shows.
	.pr-stacks {
		display: grid;
		align-self: center;
		zoom: 1.3;
	}

	// The footer's layout: the platforms in one column, the ecosystem across three, under their kickers.
	.pr-foot {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
		align-content: center;
		gap: 24px 32px;

		@include media-down(sm) {
			grid-template-columns: minmax(0, 1fr);
		}

		p {
			@include type-eyebrow;

			margin: 0 0 14px;
			color: rgba(255, 255, 255, 0.5);
		}
	}

	.pr-foot__group--wide .pr-list {
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px 24px;

		@include media-down(md) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	// 48 a layer against a face about 72 tall once laid flat: the layers sit close, each face still read.
	.pr-iso {
		--gap: 48px;

		position: relative;
		isolation: isolate;
		width: 100%;
		height: calc(150px + (var(--n) - 1) * var(--gap));
	}

	// The layer in screen space, so its filters fall straight down. The slab's side: three 1px steps in
	// the edge colour, three in it taken deeper, so the side shades toward its foot. Then the light, from
	// the top left: a soft contact shadow that seats the slab, and a wider cast shadow down and to the
	// right, light enough that the layer under it stays its own colour.
	.pr-iso__layer {
		--edge-deep: color-mix(in srgb, var(--edge) 78%, #0b0d1f);

		position: absolute;
		z-index: 1;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%) translateY(calc(((var(--n) - 1) / 2 - var(--i)) * var(--gap)));
		filter: drop-shadow(0 1px 0 var(--edge)) drop-shadow(0 1px 0 var(--edge)) drop-shadow(0 1px 0 var(--edge))
			drop-shadow(0 1px 0 var(--edge-deep)) drop-shadow(0 1px 0 var(--edge-deep)) drop-shadow(0 1px 0 var(--edge-deep))
			drop-shadow(1px 3px 3px rgba(11, 13, 31, 0.1)) drop-shadow(8px 16px 22px rgba(11, 13, 31, 0.09));
	}

	// The AI core's layer runs the core's cycle, so its side (`--edge` reads `--pr-glow`) moves with its top.
	.pr-iso__layer--cycle {
		animation: var(--pr-anim, none) var(--pr-lap, 9s) linear infinite;

		@media (prefers-reduced-motion: reduce) {
			animation: none;
		}
	}

	// The tile laid on the iso plane; no lift of its own, the slot casts the shadows. Flat tops: the
	// tiles' sheen off, so the slab reads by its colour and its edge alone.
	.pr-iso__plane {
		display: block;
		transform: rotateX(55deg) rotateZ(-45deg);

		:global(.ui-mark),
		:global(.lc-draft) {
			background-image: none;
		}
	}

	// The floor shadow under the stack, nudged right with the light: a tight core under the base slab,
	// and a wide, faint penumbra around it.
	.pr-iso::before,
	.pr-iso::after {
		content: '';
		position: absolute;
		z-index: 0;
		top: calc(50% + (var(--n) - 1) / 2 * var(--gap) + 34px);
		left: calc(50% + 10px);
		transform: translate(-50%, -50%);
		border-radius: 50%;
	}

	.pr-iso::before {
		width: 240px;
		height: 72px;
		background: radial-gradient(closest-side, rgba(11, 13, 31, 0.08), transparent);
		filter: blur(12px);
	}

	.pr-iso::after {
		width: 130px;
		height: 30px;
		background: radial-gradient(closest-side, rgba(11, 13, 31, 0.16), transparent);
		filter: blur(6px);
	}

	.pr-iso--small {
		--gap: 46px;

		height: calc(120px + (var(--n) - 1) * var(--gap));
	}

	// ── Logotype and logomark ──
	.pr-brand {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
		gap: 16px;

		@include media-down(md) {
			grid-template-columns: minmax(0, 1fr);
		}

		figure {
			display: grid;
			gap: 8px;
			margin: 0;
		}
	}

	.pr-ground {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 20px;
		min-height: 136px;
		padding: 24px;
		border-radius: 18px;
		background: #fff;
		box-shadow: inset 0 0 0 1px $line;

		img {
			max-width: 100%;
			height: auto;
		}
	}

	.pr-ground--dark {
		background: $night;
		box-shadow: none;
	}

	// ── Workbench ──
	// The bar (presets, then the view), the canvas, and the sheet beside it once a tile is opened.
	.pg {
		--pg-zoom: 1;

		display: grid;
		gap: 16px;
		padding: 20px;
		border-radius: 24px;
		background: #fff;
		box-shadow: inset 0 0 0 1px $line;
	}

	.pg[data-size='s'] {
		--pg-zoom: 0.7273;
	}

	.pg[data-size='l'] {
		--pg-zoom: 1.2727;
	}

	// Two tight rows: where to start (with what the choice is), then the view.
	.pg__bar {
		display: grid;
		gap: 10px;
		padding-bottom: 14px;
		border-bottom: 1px solid $line;
	}

	.pg__ctl-label {
		flex: none;
		margin-right: 2px;
		color: var(--color-text-secondary);
		font-size: 12px;
	}

	// What the start picked does, one line under the row.
	.pg__hint {
		margin: -2px 0 2px;
		color: var(--color-text-secondary);
		font-size: 12px;
	}

	// The three steps, quiet, under the section's heading.
	.pg__how {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 8px 24px;
		margin: -8px 0 0;
		padding: 0;
		list-style: none;
		counter-reset: how;

		@include media-down(md) {
			grid-template-columns: minmax(0, 1fr);
		}

		li {
			position: relative;
			padding-left: 30px;
			color: var(--color-text-secondary);
			font-size: 13px;
			line-height: 19px;
			counter-increment: how;

			&::before {
				content: counter(how);
				position: absolute;
				top: 0;
				left: 0;
				display: grid;
				place-items: center;
				width: 20px;
				height: 20px;
				border-radius: 50%;
				background: var(--color-text);
				color: #fff;
				font-size: 11px;
				font-weight: $font-weight-medium;
			}
		}

		b {
			color: var(--color-text);
			font-weight: $font-weight-medium;
		}
	}

	// Where to start: three groups in a row, each a segmented control like the view's, one label style.
	.pg__presets {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px 18px;
	}

	.pg__view {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px 18px;
	}

	.pg__row {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	// The grounds as swatches alone, their names in the tooltip.
	.pg__seg--swatches button {
		padding: 3px 5px;

		.pg__swatch {
			width: 14px;
			height: 14px;
			margin: 0;
			border-radius: 50%;
		}
	}

	.pg__seg {
		display: inline-flex;
		flex-wrap: wrap;
		padding: 2px;
		border-radius: 100px;
		background: rgba(23, 24, 28, 0.06);

		button {
			display: inline-flex;
			align-items: center;
			padding: 3px 10px;
			border: 0;
			border-radius: 100px;
			background: none;
			color: var(--color-text-secondary);
			font: inherit;
			font-size: 12px;
			line-height: 18px;
			cursor: pointer;
			transition:
				background-color 0.15s,
				color 0.15s;

			&:hover {
				color: var(--color-text);
			}

			&[aria-pressed='true'] {
				background: #fff;
				color: var(--color-text);
				box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
			}

			&:focus-visible {
				outline: 2px solid var(--focus-ring);
				outline-offset: 1px;
			}
		}
	}

	.pg__body {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: start;
		gap: 16px;
	}

	.pg__canvas {
		display: grid;
		gap: 10px;
	}

	// The grounds: a light stage, a dark stage, or the two side by side.
	.pg__stage {
		--stage: #f6f7fb;

		display: grid;
		gap: 20px;
		padding: 28px 24px 20px;
		border-radius: 20px;
		background: var(--stage);
		color: var(--color-text);
	}

	.pg__stage--dark {
		--stage: #{$night};

		color: #fff;
	}

	.pg:not([data-ground='white'], [data-ground='grey'], [data-ground='tint'], [data-ground='split']) .pg__stage--light,
	.pg:not([data-ground='dark'], [data-ground='split']) .pg__stage--dark {
		display: none;
	}

	.pg[data-ground='white'] .pg__stage--light {
		--stage: #fff;

		box-shadow: inset 0 0 0 1px $line;
	}

	.pg[data-ground='tint'] .pg__stage--light {
		--stage: var(--band-tint);
	}

	.pg[data-ground='grey'] .pg__stage--light,
	.pg[data-ground='split'] .pg__stage--light {
		--stage: #f6f7fb;
	}

	.pg__set {
		display: flex;
		flex-wrap: wrap;
		gap: 24px 36px;
	}

	.pg__set-group {
		display: grid;
		align-content: start;
		gap: 10px;

		ul {
			display: flex;
			flex-wrap: wrap;
			gap: 4px;
			margin: 0;
			padding: 0;
			list-style: none;
		}
	}

	.pg__set-name {
		@include type-eyebrow;

		margin: 0;
		opacity: 0.6;
	}

	.pg[data-layout='row'] {
		.pg__set-group,
		.pg__set-group ul {
			display: contents;
		}

		.pg__set-name {
			display: none;
		}

		.pg__set {
			gap: 4px;
		}
	}

	.pg[data-layout='row'] .pg__set-group:not(:last-child) .pg__item--add {
		display: none;
	}

	.pg__item[data-m='off'] {
		display: none;
	}

	// A tile is the way into its sheet: a soft plate on hover, a ring once its sheet is open.
	.pg__pick {
		display: grid;
		justify-items: center;
		padding: 8px 6px 10px;
		border: 0;
		border-radius: 18px;
		background: none;
		color: inherit;
		font: inherit;
		cursor: pointer;
		transition: background-color 0.15s;

		&:hover {
			background: color-mix(in srgb, currentColor 6%, transparent);
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 0;
		}

		&[aria-expanded='true'] {
			background: color-mix(in srgb, currentColor 8%, transparent);
			box-shadow: inset 0 0 0 1.5px color-mix(in srgb, currentColor 40%, transparent);
		}
	}

	.pg__item[data-selected] .pg__pick:not([aria-expanded='true']) {
		box-shadow: inset 0 0 0 1.5px color-mix(in srgb, currentColor 18%, transparent);
	}

	.pg__v {
		display: none;
		justify-items: center;
		gap: 8px;
	}

	@each $m in white, colour, tint, black, darktint, both {
		.pg__item[data-m='#{$m}'] .pg__v[data-m='#{$m}'] {
			display: grid;
		}
	}

	.pg__tiles {
		position: relative;
		display: flex;
		gap: 8px;
	}

	.pg__tile {
		display: grid;
		place-items: center;
		width: 88px;
		height: 88px;
		zoom: var(--pg-zoom);
	}

	// On a dark ground a white or black tile shows its edge with the hairline: the lift is lost there.
	.pg__stage--dark .pg__tile :global(.ui-mark--white),
	.pg__stage--dark .pg__tile :global(.lc-draft--white),
	.pg__stage--dark .pg__tile :global(.lc-draft--dark) {
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.16);
	}

	.pg__stage--dark .pr-blank {
		border-color: rgba(255, 255, 255, 0.2);
	}

	// The + slot: where a group takes a new mark.
	.pg__add-tile {
		display: grid;
		place-items: center;
		width: 72px;
		height: 72px;
		border: 1.5px dashed color-mix(in srgb, currentColor 28%, transparent);
		border-radius: 32%;
		color: color-mix(in srgb, currentColor 55%, transparent);
		transition:
			border-color 0.15s,
			color 0.15s;

		:global(svg) {
			width: 24px;
			height: 24px;
		}

		.pg__add:hover & {
			border-color: color-mix(in srgb, currentColor 60%, transparent);
			color: inherit;
		}
	}

	// Status on the tile's corner; shipped carries none. A status proposed here gets an amber ring.
	.pg__dot {
		position: absolute;
		top: -3px;
		right: -3px;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--dot, #{map.get($dot, exploring)});
		box-shadow: 0 0 0 2px var(--stage, #fff);
	}

	@each $s, $c in $dot {
		.pg__dot[data-status='#{$s}'] {
			--dot: #{$c};
		}
	}

	.pg__tiles .pg__dot[data-status='shipped']:not([data-changed]) {
		display: none;
	}

	.pg__dot[data-changed] {
		box-shadow:
			0 0 0 2px var(--stage, #fff),
			0 0 0 4px #f79009;
	}

	.pg__dot--inline {
		position: relative;
		top: 1px;
		right: auto;
		display: inline-block;
		margin: 0 2px 0 6px;
		box-shadow: none;
	}

	// Comments on the mark, counted on its tile.
	.pg__count {
		position: absolute;
		right: -4px;
		bottom: -4px;
		min-width: 18px;
		padding: 0 5px;
		border-radius: 100px;
		background: var(--color-text);
		box-shadow: 0 0 0 2px var(--stage, #fff);
		color: #fff;
		font-size: 11px;
		font-weight: $font-weight-medium;
		line-height: 18px;
		text-align: center;

		.pg__stage--dark & {
			background: #fff;
			color: #17181c;
		}
	}

	.pg__name {
		max-width: 96px;
		margin-top: 8px;
		font-size: 12px;
		text-align: center;
		opacity: 0.8;
	}

	.pg[data-names='off'] .pg__name {
		display: none;
	}

	// The bookmarks: a browser window drawn in its stage's ground — the strip the ground a step toward
	// the ink, the active tab and the toolbar the window's own surface — with pinned, favicon-only tabs.
	// A Colour or Tint mark keeps its colour (its dark value on dark); White and Dark take the ink.
	.pg__browser {
		--win-ink: #17181c;
		--win: #fff;
		--strip: color-mix(in srgb, var(--stage) 88%, var(--win-ink) 12%);

		margin-top: 4px;
		overflow: hidden;
		border-radius: 12px;
		background: var(--strip);
		box-shadow:
			0 0 0 1px color-mix(in srgb, var(--win-ink) 8%, transparent),
			0 12px 32px -18px rgba(11, 13, 31, 0.35);

		.pg__stage--dark & {
			--win-ink: #fff;
			--win: color-mix(in srgb, var(--stage) 78%, #fff 10%);
			--strip: color-mix(in srgb, var(--stage) 86%, #fff 6%);
		}
	}

	.pg__chrome {
		display: flex;
		align-items: flex-end;
		gap: 2px;
		padding: 8px 10px 0 14px;
	}

	.pg__lights {
		display: flex;
		flex: none;
		gap: 6px;
		align-self: center;
		margin: 0 12px 4px 0;

		i {
			width: 10px;
			height: 10px;
			border-radius: 50%;
			background: color-mix(in srgb, var(--win-ink) 22%, transparent);
		}
	}

	.pg__favs {
		display: flex;
		gap: 2px;
		min-width: 0;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.pg__fav {
		--ink: var(--win-ink);

		position: relative;
		display: grid;
		flex: none;
		place-items: center;
		width: 40px;
		height: 32px;
		padding: 0;
		border: 0;
		border-radius: 10px 10px 0 0;
		background: none;
		color: var(--ink);
		cursor: pointer;
		transition: background-color 0.15s;

		// The divider between two tabs at rest, as a browser draws it.
		& + &::before {
			content: '';
			position: absolute;
			left: -1px;
			top: 9px;
			bottom: 9px;
			width: 1px;
			background: color-mix(in srgb, var(--win-ink) 16%, transparent);
		}

		&:hover {
			background: color-mix(in srgb, var(--win) 50%, transparent);
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: -2px;
		}

		&[data-m='colour'],
		&[data-m='tint'] {
			--ink: var(--fav);

			.pg__stage--dark & {
				--ink: var(--fav-dark);
			}
		}

		&[data-try]:is([data-m='colour'], [data-m='tint']) {
			--ink: var(--try) !important;
		}

		&[data-m='off'] {
			display: none;
		}
	}

	.pg__fav--on {
		background: var(--win) !important;

		&::before,
		& + .pg__fav::before {
			display: none;
		}
	}

	.pg__newtab {
		flex: none;
		align-self: center;
		margin: 0 0 4px 8px;
		color: color-mix(in srgb, var(--win-ink) 50%, transparent);
		font-size: 18px;
		line-height: 1;
	}

	// The toolbar: back, forward, reload; the address in a pill that takes the rest; the menu. One 28
	// line, the controls in the strip's ink at half, the address at full with its path quieter.
	.pg__toolbar {
		display: flex;
		align-items: center;
		gap: 10px;
		height: 40px;
		padding: 0 10px;
		background: var(--win);
		color: color-mix(in srgb, var(--win-ink) 50%, transparent);

		:global(svg) {
			flex: none;
			width: 16px;
			height: 16px;
		}
	}

	.pg__nav {
		display: flex;
		flex: none;
		gap: 10px;
	}

	.pg__url {
		display: flex;
		flex: 1;
		align-items: center;
		gap: 6px;
		min-width: 0;
		height: 28px;
		padding: 0 12px;
		border-radius: 14px;
		background: color-mix(in srgb, var(--win-ink) 6%, transparent);
		font-size: 12px;
		line-height: 1;
		white-space: nowrap;

		:global(svg) {
			width: 12px;
			height: 12px;
		}
	}

	.pg__host {
		color: color-mix(in srgb, var(--win-ink) 86%, transparent);
	}

	.pg__path {
		overflow: hidden;
		margin-left: -6px;
		color: color-mix(in srgb, var(--win-ink) 50%, transparent);
		text-overflow: ellipsis;
	}

	// White on light: shaded as it ships (the accent at 5% in the far corner) or pure, to compare. On any
	// dark ground a white tile is pure, as the rule says: a shade there reads as grey.
	:is(.pg, .pr-sheet)[data-light='pure'] :is(:global(.ui-mark--white), :global(.lc-draft--white)),
	[data-surface='dark'] :is(:global(.ui-mark--white), :global(.lc-draft--white)) {
		background-image: none !important;
	}

	// ── The sheet ──
	// Over the page, on the right, from the top: a mark's own page. The stage first (the mark as the set
	// uses it, on a ground), then the set picker, the colour, the sizes and the notes; the details last,
	// quieter.
	.pr-sheet {
		position: fixed;
		z-index: 40;
		top: 0;
		right: 0;
		bottom: 0;
		width: min(680px, 100vw);
		overflow: auto;
		background: #fff;
		box-shadow:
			-1px 0 0 $line,
			-32px 0 72px -32px rgba(23, 24, 28, 0.3);
		overscroll-behavior: contain;
		animation: pr-sheet-in 0.22s ease-out;

		@media (prefers-reduced-motion: reduce) {
			animation: none;
		}
	}

	@keyframes pr-sheet-in {
		from {
			opacity: 0;
			transform: translateX(24px);
		}
	}

	.pgs {
		--pgs-ground: #f6f7fb;

		display: grid;

		&[hidden] {
			display: none;
		}
	}

	.pgs__head {
		position: sticky;
		z-index: 2;
		top: 0;
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 18px 16px 14px 24px;
		background: color-mix(in srgb, #fff 92%, transparent);
		backdrop-filter: blur(8px);

		h3 {
			@include type-section;

			margin: 0;
			font-size: 26px;
			line-height: 32px;
			outline: none;
		}
	}

	// What the mark stands for, under its name.
	.pgs__about {
		@include type-small;

		margin: -6px 24px 16px;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}

	.pgs__title {
		display: grid;
		flex: 1;
		gap: 2px;
	}

	.pgs__group {
		@include type-eyebrow;

		margin: 0;
		color: var(--color-text-secondary);
	}

	.pgs__close {
		display: grid;
		flex: none;
		place-items: center;
		width: 36px;
		height: 36px;
		border: 0;
		border-radius: 12px;
		background: none;
		color: var(--color-text-secondary);
		cursor: pointer;

		:global(svg) {
			width: 20px;
			height: 20px;
		}

		&:hover {
			background: rgba(23, 24, 28, 0.06);
			color: var(--color-text);
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
		}
	}

	// The stage: the mark at 88 as the set uses it, on the ground picked from its corner.
	.pgs__stage {
		--stage: #fff;

		position: relative;
		display: grid;
		place-items: center;
		min-height: 320px;
		margin: 0 24px 8px;
		border-radius: 24px;
		background: var(--stage);
		box-shadow: inset 0 0 0 1px $line;
		transition: background-color 0.2s;

		&[data-ground='tint'] {
			--stage: var(--band-tint);
		}

		&[data-ground='grey'] {
			--stage: #f6f7fb;
		}

		&[data-ground='dark'] {
			--stage: #{$night};

			box-shadow: none;
			color: #fff;
		}
	}

	.pgs__v {
		display: none;
		align-items: center;
		gap: 16px;
	}

	@each $m in white, colour, tint, black, darktint, both, off {
		.pgs[data-m='#{$m}'] .pgs__v[data-m='#{$m}'] {
			display: flex;
		}
	}

	.pgs__v--new {
		display: flex;
		gap: 10px;
	}

	// The preview: the 88 tile drawn at twice, so its drawing, edge and light can be read; two tiles
	// (White + Dark) and the new mark's four placeholders a step smaller to fit.
	.pgs__cell--big {
		zoom: 2;

		.pgs__v[data-m='both'] & {
			zoom: 1.5;
		}

		.pgs__v--new & {
			zoom: 1.1;
		}
	}

	.pgs__off {
		font-size: 13px;
		opacity: 0.6;
	}

	.pgs__stage[data-surface='dark'] :global(.ui-mark--white),
	.pgs__stage[data-surface='dark'] :global(.lc-draft--white),
	.pgs__stage[data-surface='dark'] :global(.lc-draft--dark) {
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.16);
	}

	.pgs__grounds {
		position: absolute;
		top: 10px;
		right: 10px;
		display: flex;
		gap: 2px;
		padding: 3px;
		border-radius: 100px;
		background: color-mix(in srgb, #fff 82%, transparent);
		box-shadow: 0 1px 2px rgba(23, 24, 28, 0.12);
		backdrop-filter: blur(6px);

		button {
			display: grid;
			place-items: center;
			width: 26px;
			height: 26px;
			padding: 0;
			border: 0;
			border-radius: 50%;
			background: none;
			cursor: pointer;

			&[aria-pressed='true'] {
				box-shadow: inset 0 0 0 1.5px #17181c;
			}

			&:focus-visible {
				outline: 2px solid var(--focus-ring);
			}
		}

		.pg__swatch {
			width: 16px;
			height: 16px;
			margin: 0;
			border-radius: 50%;
		}
	}

	.pgs__part {
		display: grid;
		gap: 12px;
		padding: 20px 24px;
		border-top: 1px solid $line;

		.pr-action,
		.pr-comment {
			margin: 0;
		}
	}

	// A sheet part's heading: sentence case and the small strong step, not a kicker.
	.pgs__label {
		@include type-small-strong;

		margin: 0;
		color: var(--color-text);
	}

	// A tile in the sheet, on the sheet's light grey; the ladder's take the stage's ground.
	.pgs__cell {
		display: grid;
		place-items: center;
		color: var(--pgs-ink, var(--color-text));

		&[data-surface='dark'] {
			color: var(--pgs-ink-dark, #fff);
		}
	}

	.pgs[data-try] .pgs__cell--glyph {
		color: var(--try);
	}

	// The configurations: a row per treatment, its state, the tile on light and on dark. The row the set
	// uses is ringed in the ink; a missing one is greyed and cannot be picked; the Glyph is listed only.
	.pgs__confs {
		display: grid;
		gap: 4px;
	}

	.pgs__conf {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 72px 72px;
		align-items: center;
		gap: 6px;
		padding: 4px 4px 4px 12px;
		border: 0;
		border-radius: 14px;
		background: #f6f7fb;
		color: var(--color-text);
		font: inherit;
		text-align: left;
		cursor: pointer;
		transition:
			background-color 0.15s,
			box-shadow 0.15s;

		&:hover:not(:disabled, .pgs__conf--static) {
			background: #eef0f6;
		}

		&[aria-pressed='true'] {
			background: #fff;
			box-shadow: inset 0 0 0 2px var(--color-text);
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 2px;
		}

		.pgs__cell {
			height: 72px;
			border-radius: 12px;
			background: #fff;

			&[data-surface='dark'] {
				background: $night;
			}
		}
	}

	.pgs__conf--static {
		cursor: default;
	}

	.pgs__conf--missing {
		cursor: default;

		.pgs__conf-name b {
			color: var(--color-text-secondary);
		}
	}

	.pgs__conf--off {
		grid-template-columns: 1fr;
		padding: 8px 12px;
		background: none;
		box-shadow: inset 0 0 0 1px $line;
		color: var(--color-text-secondary);
		font-size: 12px;
		text-align: center;
	}

	.pgs__conf-name {
		display: grid;
		gap: 2px;

		b {
			font-size: 13px;
			font-weight: $font-weight-medium;
		}
	}

	.pgs__conf-state {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 11px;
		color: var(--color-text-secondary);
	}

	.pr-dot--none {
		background: none;
		box-shadow: inset 0 0 0 1.5px rgba(23, 24, 28, 0.3);
	}

	.pr-blank--xs {
		width: 36px;
		height: 36px;
		border-width: 1.5px;
	}

	.pgs__hint {
		margin: -6px 0 0;
		font-size: 12px;
		color: var(--color-text-secondary);
	}

	// The colour: the swatch is the picker; the hex beside it, typed in; the set's colours under it.
	.pgs__colour {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px;
	}

	.pgs__chip {
		position: relative;
		flex: none;
		width: 44px;
		height: 44px;
		overflow: hidden;
		border-radius: 32%;
		background: var(--c);
		box-shadow: inset 0 0 0 1px rgba(23, 24, 28, 0.1);
		cursor: pointer;

		input {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			opacity: 0;
			cursor: pointer;
		}

		&:focus-within {
			outline: 2px solid var(--focus-ring);
			outline-offset: 2px;
		}
	}

	.pgs__hexin {
		width: 112px;
		padding: 9px 12px;
		border: 1px solid rgba(23, 24, 28, 0.14);
		border-radius: 12px;
		background: #fff;
		color: var(--color-text);
		font-family: $font-family-mono;
		font-size: 15px;
		text-transform: lowercase;

		&:focus-visible {
			border-color: transparent;
			outline: 2px solid var(--focus-ring);
		}

		&[data-invalid] {
			border-color: #d92d20;
		}
	}

	.pgs__token {
		margin-right: auto;
		font-size: 12px;
		color: var(--color-text-secondary);
	}

	.pgs__reset,
	.pgs__compose button,
	.pgs__notes button {
		padding: 5px 12px;
		border: 0;
		border-radius: 100px;
		background: #f1f2f6;
		color: var(--color-text);
		font: inherit;
		font-size: 12px;
		cursor: pointer;

		&:hover {
			background: #e7e9f2;
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 1px;
		}
	}

	.pgs__palette {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.pgs__dotc {
		width: 22px;
		height: 22px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: var(--c);
		box-shadow: inset 0 0 0 1px rgba(23, 24, 28, 0.1);
		cursor: pointer;
		transition: transform 0.15s;

		&:hover {
			transform: scale(1.15);
		}

		&[data-on] {
			box-shadow:
				0 0 0 2px #fff,
				0 0 0 3.5px var(--c);
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 3px;
		}
	}

	// The live contrast: quiet, three pairs on one line.
	.pgs__live {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px 6px;
		margin: 0;
		font-size: 11px;
		color: var(--color-text-secondary);

		dd {
			margin: 0 10px 0 0;
		}
	}

	.pgs__nearest {
		margin: 0;
		font-size: 12px;
		color: var(--color-text-secondary);

		&[data-clash] {
			color: #b42318;
		}
	}

	.pgs__ladder {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		gap: 8px;

		figure {
			display: grid;
			justify-items: center;
			gap: 4px;
			margin: 0;
		}

		.pgs__cell {
			min-width: 40px;
			min-height: 40px;
			padding: 8px;
			border-radius: 14px;
			background: var(--pgs-ground);

			&[data-surface='dark'] {
				background: $night;
			}
		}

		figcaption {
			font-size: 11px;
			color: var(--color-text-secondary);
		}
	}

	.pgs__notes {
		display: grid;
		gap: 6px;
		margin: 0;
		padding: 0;
		list-style: none;

		&:empty {
			display: none;
		}

		:global(li) {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 2px 8px;
			padding: 8px 10px;
			border-radius: 10px;
			background: #f6f7fb;
			font-size: 13px;
		}

		:global(small) {
			grid-row: 2;
			font-size: 11px;
			color: var(--color-text-secondary);
		}

		:global(button) {
			grid-row: 1 / span 2;
			align-self: center;
		}
	}

	.pgs__compose {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: 8px;

		textarea {
			padding: 8px 10px;
			border: 1px solid rgba(23, 24, 28, 0.14);
			border-radius: 12px;
			font: inherit;
			font-size: 13px;
			resize: vertical;

			&:focus-visible {
				border-color: transparent;
				outline: 2px solid var(--focus-ring);
			}
		}

		button {
			background: var(--color-text);
			color: #fff;

			&:hover {
				background: #000;
			}
		}
	}

	// The details: the statuses, the checks, where it is drawn. Small and grey; only a conflict or a
	// proposed status takes colour.
	.pgs__details {
		gap: 10px;
		background: #fafbfc;

		.pgs__label {
			color: var(--color-text-light);
		}

		.pr-check--pass,
		.pr-check--lift {
			background: none;
			box-shadow: inset 0 0 0 1px $line;
			color: var(--color-text-secondary);
		}

		.pr-use {
			font-size: 11px;
		}
	}

	.pgs__spec {
		width: 100%;
		border-collapse: collapse;
		font-size: 12px;
		color: var(--color-text-secondary);

		th,
		td {
			padding: 3px 8px 3px 0;
			font-weight: 400;
			text-align: left;
		}

		th {
			color: var(--color-text);
		}

		td:last-child {
			text-align: right;
		}
	}

	.pgs__status {
		padding: 2px 6px;
		border: 0;
		border-radius: 6px;
		background: none;
		color: var(--color-text-light);
		font: inherit;
		font-size: 12px;
		cursor: pointer;

		&:hover {
			background: rgba(23, 24, 28, 0.05);
			color: var(--color-text);
		}

		tr[data-changed] & {
			background: #fdf0d9;
			color: #93370d;
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
		}
	}

	.pgs__checks,
	.pgs__uses {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px;
		margin: 0;
	}

	.pgs__meta {
		margin: 0 2px 0 8px;
		font-size: 11px;
		color: var(--color-text-light);

		&:first-child {
			margin-left: 0;
		}
	}

	.pgs__icon-bar {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.pgs__icon-search {
		flex: 1;
		min-width: 0;
		padding: 8px 12px;
		border: 1px solid rgba(23, 24, 28, 0.14);
		border-radius: 12px;
		font: inherit;
		font-size: 13px;

		&:focus-visible {
			border-color: transparent;
			outline: 2px solid var(--focus-ring);
		}
	}

	// The results, built by the script, so their rules are global under the grid.
	.pgs__icons {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(40px, 1fr));
		gap: 4px;
		max-height: 220px;
		overflow: auto;
		color: var(--color-text-secondary);
		font-size: 12px;

		:global(button) {
			display: grid;
			place-items: center;
			height: 40px;
			padding: 0;
			border: 0;
			border-radius: 10px;
			background: #f6f7fb;
			color: var(--color-text);
			cursor: pointer;

			&:hover {
				background: #eceef4;
			}

			&[aria-pressed='true'] {
				background: var(--color-text);
				color: #fff;
			}

			&:focus-visible {
				outline: 2px solid var(--focus-ring);
				outline-offset: 1px;
			}
		}

		:global(svg) {
			width: 20px;
			height: 20px;
		}
	}

	.pgs__soon {
		margin: 0;
		font-size: 13px;
		color: var(--color-text-secondary);
	}

	// The new mark's placeholders: the picked colour in each treatment, on a stand-in glyph.
	.pgs--new {
		--try: #3d50f5;
	}

	.pgs__new-tile {
		display: grid;
		place-items: center;
		width: 72px;
		height: 72px;
		border-radius: 32%;
		color: var(--try);

		:global(svg) {
			width: 55%;
			height: 55%;
		}

		&[data-new-fill='white'] {
			background: #fff;
			box-shadow: var(--elev-mark);
		}

		&[data-new-fill='colour'] {
			background-color: var(--try);
			background-image: linear-gradient(
				155deg,
				rgba(255, 255, 255, 0.22) 0%,
				rgba(255, 255, 255, 0) 55%,
				rgba(0, 0, 0, 0.06) 100%
			);
			box-shadow: var(--elev-mark);
			color: #fff;
		}

		&[data-new-fill='tint'] {
			background: color-mix(in srgb, var(--try) 14%, transparent);
		}

		&[data-new-fill='black'] {
			background: #17181c;
		}
	}

	// The profile: what is in the mark, what it does, what it does not — three short lists, read at a
	// glance. The does take a tick, the does-nots a cross, both in the ink at half.
	.pgs__profile {
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
		grid-template-rows: auto auto;
		gap: 14px 24px;

		@media (max-width: 560px) {
			grid-template-columns: minmax(0, 1fr);
		}

		> div {
			display: grid;
			align-content: start;
			gap: 6px;
		}

		// What is in it spans both rows on the left; does and does not stack on the right.
		> div:first-child {
			grid-row: span 2;
		}
	}

	.pgs__list {
		display: grid;
		gap: 6px;
		margin: 0;
		padding: 0;
		list-style: none;

		li {
			position: relative;
			padding-left: 14px;
			font-size: 13px;
			line-height: 17px;

			&::before {
				content: '·';
				position: absolute;
				left: 2px;
				color: var(--color-text-light);
			}
		}
	}

	.pgs__list--does li::before {
		content: '✓';
		left: 0;
		color: #12a150;
		font-size: 11px;
	}

	.pgs__list--not li {
		color: var(--color-text-secondary);

		&::before {
			content: '✕';
			left: 0;
			color: #b42318;
			font-size: 11px;
		}
	}

	// The candidates: each on light and on dark, side by side, the round's pick ringed.
	.pgs__round {
		margin-left: 8px;
		padding: 0 7px;
		border-radius: 6px;
		background: #efe9ff;
		color: #5536c4;
		font-size: 11px;
		font-weight: $font-weight-medium;
	}

	.pgs__cands {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
		gap: 8px;
	}

	.pgs__cand {
		display: grid;
		gap: 8px;
		margin: 0;
		padding: 8px 8px 10px;
		border-radius: 16px;
		background: #f6f7fb;

		figcaption {
			display: grid;
			gap: 2px;
			padding: 0 4px;
			font-size: 12px;
			color: var(--color-text-secondary);
		}

		b {
			display: flex;
			align-items: center;
			gap: 6px;
			color: var(--color-text);
			font-size: 13px;
			font-weight: $font-weight-medium;
		}
	}

	.pgs__cand--pick {
		background: #fff;
		box-shadow: inset 0 0 0 2px var(--color-text);
	}

	.pgs__cand-art {
		display: grid;
		grid-template-columns: 1fr 1fr;
		overflow: hidden;
		border-radius: 10px;

		.pgs__cell {
			height: 72px;
			background: #fff;

			&[data-surface='dark'] {
				background: $night;
			}
		}
	}

	.pgs__cand-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px;
		margin-top: 4px;
		font-size: 11px;
	}

	.pgs__picked {
		padding: 0 6px;
		border-radius: 6px;
		background: var(--color-text);
		color: #fff;
		font-size: 11px;
		line-height: 16px;
	}

	.pgs__why {
		margin: 0;
		font-size: 13px;
		color: var(--color-text-secondary);
	}

	// ── Rounds ──
	.pr-rounds {
		display: grid;
		gap: 12px;
	}

	.pr-round {
		display: grid;
		gap: 14px;
		padding: 18px 22px;
		border-radius: 20px;
		box-shadow: inset 0 0 0 1px $line;
	}

	.pr-round__head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 10px;

		b {
			@include type-small-strong;

			font-size: 16px;
		}
	}

	.pr-round__title {
		margin-right: auto;
		font-size: 14px;
		color: var(--color-text-secondary);
	}

	.pr-round__try {
		padding: 4px 12px;
		border-radius: 100px;
		background: var(--color-text);
		color: #fff;
		font-size: 12px;
		text-decoration: none;

		&:hover {
			background: #000;
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 2px;
		}
	}

	.pr-round__picks {
		display: grid;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;

		li {
			display: grid;
			grid-template-columns: auto minmax(0, 1fr) auto;
			align-items: center;
			gap: 16px;
			padding: 10px 12px;
			border-radius: 14px;
			background: #f6f7fb;

			@include media-down(md) {
				grid-template-columns: minmax(0, 1fr);
			}
		}

		.pr-open {
			margin-top: 0;
		}
	}

	.pr-round__pair {
		display: flex;
		align-items: center;
		gap: 10px;
		color: var(--color-text-light);
	}

	.pr-round__text {
		display: grid;
		gap: 2px;
		font-size: 13px;
		color: var(--color-text-secondary);

		b {
			color: var(--color-text);
			font-weight: $font-weight-medium;
		}

		.pr-comment {
			margin: 0;
		}
	}

	.pr-round__brief {
		display: grid;
		gap: 8px;

		ol {
			display: grid;
			gap: 4px;
			margin: 0;
			padding-left: 18px;
			font-size: 13px;
			color: var(--color-text-secondary);
		}
	}

	// A value still to be decided: a dashed slot, not a blank.
	.pr-open-slot {
		display: inline-block;
		padding: 0 8px;
		border-radius: 6px;
		box-shadow: inset 0 0 0 1px rgba(23, 24, 28, 0.18);
		color: var(--color-text-light);
		font-size: 12px;
		line-height: 20px;
	}

	// The map's way into a sheet.
	.pr-open {
		margin-top: 4px;
		padding: 2px 10px;
		border: 0;
		border-radius: 100px;
		background: rgba(23, 24, 28, 0.05);
		color: var(--color-text-secondary);
		font: inherit;
		font-size: 12px;
		cursor: pointer;

		&:hover,
		&[aria-expanded='true'] {
			background: var(--color-text);
			color: #fff;
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
		}
	}

	// ── Tints ──
	.pr-tints {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
		gap: 12px;
	}

	.pr-tint {
		display: grid;
		align-content: start;
		gap: 10px;
		padding: 16px 18px;
		border-radius: 20px;
		box-shadow: inset 0 0 0 1px $line;

		.pr-comment {
			margin: 0;
		}
	}

	.pr-tint__grounds {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 6px;
	}

	.pr-tint__ground {
		display: grid;
		justify-items: center;
		gap: 6px;
		margin: 0;
		padding: 12px 2px 8px;
		border-radius: 12px;
		background: var(--ground);
		box-shadow: inset 0 0 0 1px $line;

		figcaption {
			font-size: 11px;
			color: var(--color-text-secondary);
			white-space: nowrap;
		}

		&[data-surface='dark'] figcaption {
			color: rgba(255, 255, 255, 0.6);
		}
	}

	.pr-tint__tile {
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		border-radius: 32%;
		color: var(--ink);

		.pr-layer__mask {
			width: 32px;
			height: 32px;
		}
	}

	.pr-tint__tile--opaque {
		background: color-mix(in srgb, var(--a) 12%, #fff);
	}

	.pr-tint__tile--inherit {
		background: color-mix(in srgb, var(--a) 14%, transparent);
	}

	.pr-tint__tile--dynamic {
		--pr-glow: var(--pr-hue-0, #3d50f5);

		background: color-mix(in srgb, var(--pr-glow) 14%, transparent);
		color: var(--pr-glow);
		animation: var(--pr-anim, none) var(--pr-lap, 9s) linear infinite;

		@media (prefers-reduced-motion: reduce) {
			animation: none;
		}
	}

	.pr-tint__tile--gradient {
		background: linear-gradient(
			155deg,
			color-mix(in srgb, var(--a) 20%, transparent),
			color-mix(in srgb, var(--a) 6%, transparent)
		);
	}

	.pr-tint__icon {
		width: 26px;
		height: 26px;
	}

	.pr-tint__recipe {
		margin: 0;
		font-size: 13px;
	}

	.pr-tint__source {
		font-size: 11px;
		color: var(--color-text-light);
	}

	.pg__out {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 10px;
		padding: 4px 4px 0;
	}

	.pg__summary {
		flex: 1 1 320px;
		margin: 0;
		font-size: 13px;
		color: var(--color-text-secondary);
	}

	.pg__copy,
	.pg__export {
		padding: 5px 14px;
		border: 0;
		border-radius: 100px;
		background: var(--color-text);
		color: #fff;
		font: inherit;
		font-size: 13px;
		cursor: pointer;

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 2px;
		}
	}

	.pg__export {
		background: #f1f2f6;
		color: var(--color-text);

		&:hover {
			background: #e7e9f2;
		}
	}

	.pg__note {
		flex-basis: 100%;
		font-size: 12px;
		color: var(--color-text-secondary);
	}

	// ── Browser tabs ──
	.pr-tabs-pair {
		display: grid;
		gap: 12px;
		align-content: center;
	}

	.pr-browser {
		overflow: hidden;
		border-radius: 12px;
		background: #dee1e8;
		box-shadow: 0 1px 2px rgba(23, 24, 28, 0.06);
	}

	.pr-browser--dark {
		background: #202124;
	}

	.pr-browser__strip {
		display: flex;
		gap: 2px;
		padding: 8px 8px 0;
		overflow: hidden;
	}

	.pr-tab {
		display: flex;
		flex: 0 1 220px;
		align-items: center;
		gap: 8px;
		min-width: 0;
		padding: 8px 12px;
		border-radius: 10px 10px 0 0;
		color: #3c4043;
		font-size: 12px;

		span {
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		img,
		.pr-tab__icon {
			flex: none;
			width: 16px;
			height: 16px;
		}

		.pr-browser--dark & {
			color: #bdc1c6;
		}
	}

	.pr-tab--on {
		background: #fff;
		color: #202124;

		.pr-browser--dark & {
			background: #35363a;
			color: #e8eaed;
		}
	}

	.pr-browser__bar {
		padding: 8px 12px 10px;
		background: #fff;

		.pr-browser--dark & {
			background: #35363a;
		}
	}

	.pr-browser__url {
		display: block;
		padding: 5px 12px;
		border-radius: 100px;
		background: #f1f3f4;
		color: #5f6368;
		font-size: 12px;

		.pr-browser--dark & {
			background: #202124;
			color: #9aa0a6;
		}
	}

	// ── Fills ──
	// A recipe a row: the layers as small tiles with + between, = the tile Mark draws from them.
	.pr-fills {
		display: grid;
		gap: 12px;
	}

	.pr-fill {
		display: grid;
		gap: 16px;
		padding: 20px 24px;
		border-radius: 20px;
		box-shadow: inset 0 0 0 1px $line;
	}

	.pr-fill__head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px 10px;

		b {
			@include type-small-strong;

			font-size: 16px;
		}
	}

	.pr-fill__where {
		margin-left: auto;
		font-size: 13px;
		color: var(--color-text-secondary);
	}

	.pr-fill__build {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr) auto) 96px;
		align-items: start;
		gap: 12px;

		@include media-down(md) {
			grid-template-columns: repeat(2, minmax(0, 1fr));

			.pr-fill__op {
				display: none;
			}
		}
	}

	.pr-fill__op {
		padding-top: 18px;
		font-size: 18px;
		color: var(--color-text-light);
	}

	.pr-fill__result {
		display: grid;
		place-items: center;
		height: 80px;
	}

	.pr-layer {
		display: grid;
		justify-items: start;
		gap: 8px;
		margin: 0;

		figcaption {
			display: grid;
			gap: 2px;
			font-size: 12px;
			line-height: 16px;
			color: var(--color-text-secondary);
		}

		b {
			color: var(--color-text);
			font-weight: $font-weight-medium;
		}
	}

	// A layer at 56, Mark's 32% corner; the hairline only shows where the layer is white on white.
	.pr-layer__tile {
		display: grid;
		place-items: center;
		width: 56px;
		height: 56px;
		border-radius: 32%;
		background: var(--layer, transparent);
		box-shadow: inset 0 0 0 1px rgba(23, 24, 28, 0.08);

		img {
			width: 40px;
			height: auto;
		}
	}

	// A light alone: over the transparency grid, so what it adds and takes away both show.
	.pr-layer__tile--clear {
		background:
			var(--layer),
			repeating-conic-gradient(#dfe2ea 0 25%, #fff 0 50%) 0 0 / 10px 10px;
	}

	.pr-layer__tile--none {
		background: none;
		box-shadow: inset 0 0 0 1px rgba(23, 24, 28, 0.14);
		outline: 1px dashed rgba(23, 24, 28, 0.2);
		outline-offset: -1px;
	}

	.pr-layer__tile--lift {
		box-shadow:
			inset 0 0 0 1px rgba(23, 24, 28, 0.04),
			var(--elev-mark);
	}

	.pr-layer__mask {
		width: 40px;
		height: 40px;
		background-color: currentColor;
		-webkit-mask: var(--mask) center / contain no-repeat;
		mask: var(--mask) center / contain no-repeat;
	}

	.pr-fill__dark {
		margin: 0;
		font-size: 13px;
		color: var(--color-text-secondary);

		b {
			margin-right: 4px;
			color: var(--color-text);
			font-weight: $font-weight-medium;
		}
	}

	// The grounds: a panel each, the tile placed where its component places it.
	.pr-backdrops {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 16px;
	}

	.pr-backdrop {
		display: grid;
		align-content: start;
		gap: 12px;
		margin: 0;

		figcaption {
			display: grid;
			gap: 4px;
			font-size: 12px;
			line-height: 16px;
			color: var(--color-text-secondary);
		}

		b {
			@include type-small-strong;
		}

		code {
			font-size: 11px;
			color: var(--color-text-light);
		}
	}

	.pr-backdrop__recipe {
		color: var(--color-text);
	}

	.pr-backdrop__ground {
		display: grid;
		justify-items: center;
		align-items: center;
		height: 160px;
		border-radius: 16px;
		background: var(--ground);
		box-shadow: inset 0 0 0 1px $line;

		&[data-surface='dark'] {
			box-shadow: none;
		}
	}

	// The card glow's mark at the top, where the glow starts: EcosystemCard seats it across the edge.
	.pr-backdrop__ground--top {
		align-items: start;
		padding-top: 16px;
	}

	// The AI glow runs the core's cycle: the registered colour, so the gradient interpolates it.
	.pr-backdrop__ground--cycle {
		--pr-glow: var(--pr-hue-0, #3d50f5);

		animation: var(--pr-anim, none) var(--pr-lap, 9s) linear infinite;

		@media (prefers-reduced-motion: reduce) {
			animation: none;
		}
	}

	// The lift × light study: a card per fill, the combinations across, a ground a row.
	.pr-combos {
		display: grid;
		gap: 12px;
	}

	.pr-combo {
		display: grid;
		grid-template-columns: 120px minmax(0, 1fr);
		align-items: center;
		gap: 16px;
		padding: 16px 20px;
		border-radius: 20px;
		box-shadow: inset 0 0 0 1px $line;

		@include media-down(md) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.pr-combo__fill {
		@include type-small-strong;

		margin: 0;
	}

	.pr-combo__grid {
		display: grid;
		grid-template-columns: 72px repeat(6, minmax(0, 1fr));
		align-items: center;
		gap: 6px;
		overflow-x: auto;
	}

	// Flat and Lit once each, over their three edges.
	.pr-combo__light {
		grid-column: span 3;
		padding-bottom: 4px;
		border-bottom: 1px solid $line;
		font-size: 12px;
		font-weight: $font-weight-medium;
		text-align: center;
	}

	.pr-combo__col {
		font-size: 11px;
		color: var(--color-text-secondary);
		text-align: center;
	}

	.pr-combo__row {
		font-size: 12px;
		color: var(--color-text-secondary);
	}

	.pr-combo__cell {
		display: grid;
		justify-items: center;
		gap: 6px;
		min-width: 64px;
		margin: 0;
		padding: 12px 4px 8px;
		border-radius: 12px;
		background: var(--ground);
		box-shadow: inset 0 0 0 1px $line;
	}

	.pr-combo__tile {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 32%;
		background: var(--lit), var(--fill);

		img,
		.pr-layer__mask {
			width: 30px;
			height: 30px;
		}
	}

	.pr-combo__tile--lift {
		box-shadow: var(--elev-mark);
	}

	.pr-combo__tile--hairline {
		box-shadow: inset 0 0 0 1px rgba(23, 24, 28, 0.14);

		[data-surface='dark'] & {
			box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.18);
		}
	}

	.pr-verdict {
		padding: 0 6px;
		border-radius: 6px;
		font-size: 11px;
		font-weight: $font-weight-medium;
		line-height: 18px;
	}

	.pr-verdict--do {
		background: #e3f4ea;
		color: #00692f;
	}

	.pr-verdict--avoid {
		background: #fdf0d9;
		color: #93370d;
	}

	.pr-verdict--dont {
		background: #fde7e4;
		color: #b42318;
	}

	.pr-checks {
		th small {
			display: block;
			font-size: 11px;
			font-weight: 400;
			color: var(--color-text-secondary);
		}

		td {
			white-space: nowrap;
		}

		td .pr-check + .pr-check {
			margin-left: 4px;
		}
	}

	.pr-conflicts {
		display: grid;
		gap: 6px;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 13px;

		.pr-red {
			margin-left: 8px;
		}
	}

	// ── Vocabulary: the spec ──
	// Last on the page and set small: a reference, not a read.
	.pr-spec {
		width: 100%;
		border-collapse: collapse;
		font-size: 13px;

		th,
		td {
			padding: 7px 12px 7px 0;
			border-bottom: 1px solid $line;
			text-align: left;
			vertical-align: baseline;
		}

		thead th {
			@include type-eyebrow;

			color: var(--color-text-secondary);
		}

		tbody th {
			width: 140px;
			font-weight: $font-weight-medium;
		}

		td {
			color: var(--color-text-secondary);
		}

		td:last-child {
			width: 34%;
		}

		code {
			color: var(--color-text);
			font-size: 12px;
		}

		@include media-down(md) {
			td:last-child {
				display: none;
			}
		}
	}

	.pr-spec__group th {
		padding-top: 18px;
		color: var(--color-text);
		font-size: 13px;
	}

	// ── Next steps ──
	.pr-steps {
		padding: 18px 22px;
		border-radius: 18px;
		background: #f6f7fb;

		ol {
			display: grid;
			gap: 8px;
			margin: 0;
			padding-left: 20px;
		}

		li {
			font-size: 14px;
			line-height: 20px;
			color: var(--color-text-secondary);
		}

		b {
			margin-right: 6px;
			font-weight: $font-weight-medium;
			color: var(--color-text);
		}
	}

	.pr-steps__title {
		@include type-eyebrow;

		margin: 0 0 10px;
		color: var(--color-text-secondary);
	}

	// ── The map ──
	.pr-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
		margin: 0;
		font-size: 13px;
		color: var(--color-text-secondary);

		> span {
			display: inline-flex;
			align-items: center;
			gap: 6px;
		}
	}

	.pr-map {
		display: grid;
		overflow: hidden;
		border-radius: 24px;
		background: #fff;
		box-shadow: inset 0 0 0 1px $line;
	}

	.pr-map__head,
	.pr-map__row {
		display: grid;
		grid-template-columns: minmax(150px, 1fr) repeat(5, minmax(0, 1fr));
	}

	.pr-map__head span {
		display: grid;
		gap: 2px;
		padding: 18px 20px 10px;
		@include type-eyebrow;

		color: var(--color-text-secondary);
		text-align: center;

		small {
			font-size: 11px;
			font-weight: $font-weight-normal;
			letter-spacing: 0;
			text-transform: none;
			color: var(--color-text-light);
		}

		&:first-child {
			text-align: left;
		}
	}

	.pr-map__group {
		@include type-eyebrow;

		margin: 0;
		padding: 18px 20px 4px;
		border-top: 1px solid $line;
		color: var(--color-text-secondary);
	}

	.pr-map__row {
		scroll-margin-top: 100px;
	}

	.pr-map__name {
		display: flex;
		flex-wrap: wrap;
		align-content: center;
		align-items: center;
		gap: 6px 0;
		padding: 16px 20px;

		b {
			@include type-card;

			width: 100%;
		}

		.pr-red {
			margin-left: 0;
			margin-right: 6px;
		}
	}

	.pr-map__cell {
		display: grid;
		justify-items: center;
		align-content: center;
		gap: 10px;
		min-height: 184px;
		padding: 18px 12px;
		border-left: 1px solid $line;
	}

	.pr-map__art {
		display: grid;
		place-items: center;
		gap: 12px;
	}

	// The glyph in its colour on a light and on a night ground: the dark half takes the dark value,
	// lifted to hold its contrast (glyphInk).
	.pr-glyphs {
		display: flex;
		overflow: hidden;
		border-radius: 14px;
		box-shadow: inset 0 0 0 1px $line;
	}

	.pr-glyphs__half {
		display: grid;
		justify-items: center;
		gap: 10px;
		padding: 12px;
		background: #fff;
	}

	.pr-glyphs__half--dark {
		background: $night;
	}

	.pr-blank {
		width: 88px;
		height: 88px;
		border: 1.5px dashed rgba(23, 24, 28, 0.2);
		border-radius: 32%;

		[data-surface='dark'] & {
			border-color: rgba(255, 255, 255, 0.2);
		}
	}

	.pr-blank--s {
		width: 48px;
		height: 48px;
	}

	@include media-down(md) {
		.pr-map__head,
		.pr-map__row {
			grid-template-columns: repeat(5, minmax(0, 1fr));
		}

		.pr-map__head span:first-child {
			display: none;
		}

		.pr-map__name {
			grid-column: 1 / -1;
			padding-bottom: 0;
		}

		.pr-map__cell {
			min-height: 0;
			padding-inline: 4px;
		}

		.pr-map__art {
			zoom: 0.6;
		}
	}

	.pr-table-wrap {
		overflow-x: auto;
		border-radius: 18px;
		box-shadow: inset 0 0 0 1px $line;

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
		}
	}

	.pr-table {
		width: 100%;
		min-width: 760px;
		border-collapse: collapse;

		th,
		td {
			padding: 10px 14px;
			border-bottom: 1px solid $line;
			text-align: left;
			vertical-align: top;
			font-size: 13px;
		}

		thead th {
			color: var(--color-text-secondary);
			font-weight: $font-weight-medium;
		}

		tbody th {
			font-weight: $font-weight-medium;
			white-space: nowrap;
		}

		tr:last-child > * {
			border-bottom: 0;
		}

		td {
			color: var(--color-text-light);
		}
	}

	.pr-use {
		display: inline-block;
		margin: 0 4px 4px 0;
		padding: 1px 7px;
		border-radius: 6px;
		background: rgba(23, 24, 28, 0.05);
		color: var(--color-text);
		white-space: nowrap;

		b {
			font-variant-numeric: tabular-nums;
		}

		em {
			margin-left: 4px;
			font-style: normal;
		}
	}

	.pr-use--red {
		background: rgba(200, 50, 20, 0.1);
		color: #b42318;
	}

	.pr-scale {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px;
		margin: 0;
		font-size: 13px;
		color: var(--color-text-secondary);

		> span:not(.pr-step) {
			margin: 0 4px 0 8px;

			&:first-child {
				margin-left: 0;
			}
		}
	}

	.pr-step {
		padding: 1px 8px;
		border-radius: 6px;
		background: rgba(23, 24, 28, 0.05);
		color: var(--color-text);
		font-variant-numeric: tabular-nums;

		small {
			color: var(--color-text-secondary);
		}
	}

	.pr-step--out {
		text-decoration: line-through;
		background: rgba(200, 50, 20, 0.08);
		color: #b42318;
	}

	.pr-step--on {
		background: #e4e8ff;
	}

	// ── Colour ──
	.pr-colours {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr));
		gap: 12px;
	}

	.pr-colour {
		overflow: hidden;
		border-radius: 18px;
		background: #fff;
		box-shadow: inset 0 0 0 1px $line;
	}

	.pr-colour__swatches {
		display: flex;
		height: 76px;

		span {
			display: flex;
			flex: 1;
			align-items: flex-end;
			padding: 8px 10px;
			color: #fff;
			font-family: $font-family-mono;
			font-size: 11px;

			&:first-child {
				flex: 2;
			}
		}
	}

	.pr-colour__body {
		display: grid;
		gap: 2px;
		padding: 14px 16px 16px;

		dl {
			display: grid;
			grid-template-columns: 78px minmax(0, 1fr);
			gap: 3px 8px;
			margin: 10px 0 0;
		}

		dt,
		dd {
			margin: 0;
			font-size: 13px;
			line-height: 18px;
		}

		dt {
			color: var(--color-text-secondary);
		}

		dd {
			font-variant-numeric: tabular-nums;
		}
	}

	.pr-colour__name {
		margin: 0;
		font-size: 16px;
		font-weight: $font-weight-medium;
	}

	.pr-colour__role,
	.pr-colour__token {
		margin: 0;
		font-size: 13px;
		color: var(--color-text-secondary);
	}

	.pr-grade {
		padding: 0 6px;
		border-radius: 4px;
		font-size: 11px;
		line-height: 16px;
	}

	.pr-grade--aa {
		background: #e3f4ea;
		color: #00692f;
	}

	.pr-grade--aa-large {
		background: #fff1db;
		color: #8a4b00;
	}

	.pr-grade--low {
		background: rgba(200, 50, 20, 0.1);
		color: #b42318;
	}

	// ── Experiments and legacy ──
	.pr-experiments,
	.pr-legacy {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
		gap: 16px;
	}

	.pr-exp,
	.pr-leg {
		display: grid;
		grid-template-rows: auto 1fr;
		overflow: hidden;
		border-radius: 20px;
		background: #fff;
		box-shadow: inset 0 0 0 1px $line;
	}

	// The texture vector: five surfaces for a White tile on white, and for a Dark tile on night.
	.pr-mat {
		display: grid;
		gap: 10px;
		width: 100%;
	}

	.pr-mat__row {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 14px;
		padding: 18px 12px 12px;
		border-radius: 14px;
		background: #fff;
		box-shadow: inset 0 0 0 1px $line;
	}

	.pr-mat__row--dark {
		background: $night;
		box-shadow: none;
		color: #fff;
	}

	.pr-mat__try {
		display: grid;
		justify-items: center;
		gap: 8px;
		margin: 0;

		figcaption {
			font-size: 11px;
			opacity: 0.7;
		}
	}

	.pr-mat__tile {
		display: grid;
		place-items: center;
		width: 56px;
		height: 56px;
		border-radius: 32%;
		background: #fff;

		img {
			width: 38px;
			height: auto;
		}
	}

	.pr-mat__tile--shipped {
		background: linear-gradient(155deg, #fff 35%, color-mix(in srgb, var(--a) 5%, #fff) 100%);
		box-shadow: var(--elev-mark);
	}

	.pr-mat__tile--rim {
		box-shadow:
			inset 0 0 0 1px rgba(23, 24, 28, 0.07),
			inset 0 1px 0 #fff,
			var(--elev-mark);
	}

	.pr-mat__tile--bevel {
		background: linear-gradient(180deg, #fff 0%, #f1f2f6 100%);
		box-shadow:
			inset 0 1px 0 #fff,
			inset 0 -2px 0 rgba(23, 24, 28, 0.05),
			0 1px 2px rgba(23, 24, 28, 0.08),
			var(--elev-mark);
	}

