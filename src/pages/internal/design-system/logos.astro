					How a tile is built, layer by layer, and the grounds it sits on. One product through every treatment, so only
					the recipe changes.
				</p>
			</div>
			<h3 class="pr-h3">Tiles</h3>
			<div class="pr-fills">
				{FILLS.map((f) => (
					<article class="pr-fill">
						<header class="pr-fill__head">
							<b>{f.label}</b>
							<span class:list={['pr-status', `pr-status--${f.status}`]}>{STATUS[f.status]}</span>
							<span class="pr-fill__where">{f.where}</span>
						</header>
						<div class="pr-fill__build">
							{f.layers.map((l, i) => (
								<Fragment>
									{i > 0 && (
										<span class="pr-fill__op" aria-hidden="true">
											+
										</span>
									)}
									<figure class="pr-layer">
										<span
											class:list={[
												'pr-layer__tile',
												l.clear && 'pr-layer__tile--clear',
												!l.bg && !l.mark && 'pr-layer__tile--none',
												l.lift && 'pr-layer__tile--lift',
											]}
											style={
												[l.bg && `--layer: ${l.bg}`, l.mark?.ground && `background: ${l.mark.ground}`]
													.filter(Boolean)
													.join('; ') || undefined
