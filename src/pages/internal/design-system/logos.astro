							<span class="pr-exception" title={`Fallback: ${s.r.exception.fallback}`}>
								Exception · {s.r.exception.what.split(':')[0].toLowerCase()}
							</span>
						)}
						<button type="button" class="pgs__close" aria-label="Close the sheet">
							<Icon name="tabler:x" aria-hidden="true" />
						</button>
					</header>

					<p class="pgs__about">{s.r.about}</p>
					<div class="pgs__stage" data-ground="dark" data-surface="dark">
						{s.variants.map((v) => (
							<span class="pgs__v" data-m={v.m}>
								{v.cells.length > 0 ? (
									v.cells.map((c) => (
										<span class="pgs__cell pgs__cell--big">
											<LogoCell cell={atSize(c, 88)} />
										</span>
									))
