// ── Grounds and contrast ──
/**
 * THE GROUNDS: the surfaces a mark is drawn and checked on, one list for the hero, the workbench, the
 * sheet and the checks. Each stands for the pages that paint it, and each will take a Tint and a
 * backdrop of its own; until those are assigned the two are open, and one Dark approximates every dark
 * surface the pages use (the bookend's indigo, the dark sections' night, the footer's black). The
 * non-text minimum the checks hold them to is WCAG 2's 3:1 (1.4.11): a tile's edge against its
 * ground, and the mark against its tile.
 */
interface Ground {
	id: 'white' | 'grey' | 'tint' | 'dark';
	label: string;
	hex: string;
	dark: boolean;
	/** The surfaces it stands for, on the pages. */
	stands: string;
	/** The Tint tile on this ground: to assign. */
	tint?: string;
	/** The backdrop (a glow or a band) a mark takes on this ground: to assign. */
	backdrop?: string;
}
const GROUNDS: Ground[] = [
	{ id: 'white', label: 'White', hex: '#ffffff', dark: false, stands: 'The page' },
	{ id: 'grey', label: 'Grey', hex: '#f6f7fb', dark: false, stands: 'Panels and cards on the page' },
	{
		id: 'tint',
		label: 'Tint',
		hex: resolveHue('var(--band-tint)') ?? '#f5f6ff',
		dark: false,
		stands: 'The light bands (--band-tint)',
	},
	{
		id: 'dark',
		label: 'Dark',
		hex: '#0b0d1f',
		dark: true,
		stands: `The bookend (${resolveHue('var(--band-indigo)') ?? '#121425'}), the AI and dark sections (#0b0d1f), the footer (#000)`,
	},
];
const MIN = 3;
/** Two hex colours mixed, `k` of the second: a Tint tile's fill is the accent 12% into white. */
const mixHex = (a: string, b: string, k: number) =>
	`#${[1, 3, 5]
		.map((i) => [parseInt(a.slice(i, i + 2), 16), parseInt(b.slice(i, i + 2), 16)])
		.map(([x, y]) =>
			Math.round(x + (y - x) * k)
				.toString(16)
				.padStart(2, '0')
		)
		.join('')}`;
/** A product's glyph ink: its colour on light grounds; on dark its dark value, lifted to hold 4.5:1 on night. */
const glyphInk = (hue?: string) => {
	const light = resolveHue(hue) ?? '#17181c';
	return { light, dark: hue ? liftOn(darkOf(hue), '#0b0d1f') : '#ffffff' };
};
type Verdict = 'pass' | 'lift' | 'fail';
interface Check {
	ratio?: number;
	verdict: Verdict;
	why: string;
}
const judge = (ratio: number | undefined, compensated: boolean, how: string): Check =>
	ratio === undefined
		? { verdict: 'pass', why: 'Not measured' }
		: ratio >= MIN
			? { ratio, verdict: 'pass', why: `${ratio.toFixed(1)}:1` }
			: compensated
				? { ratio, verdict: 'lift', why: `${ratio.toFixed(1)}:1, the edge from the ${how}` }
				: { ratio, verdict: 'fail', why: `${ratio.toFixed(1)}:1, lost on the ground` };
/** A tile's colours: its fill, and the ink its mark is drawn in (a product's own art approximated by its colour). */
const tileColours = (r: (typeof ROWS)[number], col: 'white' | 'filled' | 'tint') => {
	const hue = resolveHue(r.hue) ?? '#17181c';
	if (col === 'filled') return { fill: hue, ink: '#ffffff' };
	if (col === 'tint') return { fill: mixHex(hue, '#ffffff', 0.88), ink: hue };
	return { fill: '#ffffff', ink: r.hue ? hue : '#17181c' };
};
/**
 * The contrast checks for one product: its signature tile's edge on every ground (a light ground lets the
 * lift carry it, a dark one does not), each defined tile's mark against its fill, its glyph on light and
 * on night. Built from the data, so a new mark or colour is checked the moment it is added.
 */
const checksOf = (r: (typeof ROWS)[number]) => {
	const face = tileColours(r, r.face);
	const ink = glyphInk(r.hue);
	return {
		edges: GROUNDS.map((g) => ({ g, ...judge(contrast(face.fill, g.hex), !g.dark, 'lift') })),
		marks: (['white', 'filled', 'tint'] as const)
			.filter((c) => r[c])
			.map((c) => {
				const { fill, ink: on } = tileColours(r, c);
				return { col: COLS.find((x) => x.id === c)?.label ?? c, ...judge(contrast(on, fill), false, '') };
			}),
		glyph: [
			{ g: 'Light', ...judge(contrast(ink.light, '#ffffff'), false, '') },
			{ g: 'Dark', ...judge(contrast(ink.dark, '#0b0d1f'), false, '') },
		],
	};
};
const CHECKS = ROWS.map((r) => ({ r, ...checksOf(r) }));
const faceLabel = (r: (typeof ROWS)[number]) => (r.face === 'white' ? 'The White tile' : 'The Colour tile');
const failsOf = (c: (typeof CHECKS)[number]) => [
	...c.edges.filter((e) => e.verdict === 'fail').map((e) => `${faceLabel(c.r)} on ${e.g.label} · ${e.why}`),
	...c.marks.filter((m) => m.verdict === 'fail').map((m) => `The mark on its ${m.col} · ${m.why}`),
	...c.glyph.filter((m) => m.verdict === 'fail').map((m) => `The glyph on ${m.g} · ${m.why}`),
];
const CONFLICTS = CHECKS.flatMap((c) => failsOf(c).map((text) => ({ r: c.r, text })));

// ── Lift and light ──
/**
 * Every light with every edge, on a light and a dark ground, for the three opaque fills: where each
 * combination holds, where it is redundant, and where it fails. Judged by the same 3:1 as the checks.
 */
const COMBO_FILLS = [
	{
		id: 'white',
		label: 'White',
		fill: '#ffffff',
		lit: `linear-gradient(155deg, #fff 35%, color-mix(in srgb, ${FILL_HUE} 5%, #fff) 100%)`,
		mark: 'art',
	},
	{ id: 'colour', label: 'Colour', fill: FILL_HUE, lit: SHEEN_SOLID, mark: 'knockout' },
	{ id: 'black', label: 'Dark', fill: '#17181c', lit: SHEEN_BLACK, mark: 'art' },
] as const;
const LIGHTS = [
	{ id: 'flat', label: 'Flat' },
	{ id: 'lit', label: 'Lit' },
] as const;
const EDGES = [
	{ id: 'none', label: 'No edge' },
	{ id: 'lift', label: 'Lift' },
	{ id: 'hairline', label: 'Hairline' },
] as const;
const COMBO_GROUNDS = [
	{ id: 'light', label: 'On white', hex: '#ffffff', dark: false },
	{ id: 'dark', label: 'On dark', hex: '#0b0d1f', dark: true },
] as const;
type ComboVerdict = 'do' | 'avoid' | 'dont';
const comboOf = (
	f: (typeof COMBO_FILLS)[number],
	light: (typeof LIGHTS)[number]['id'],
	edge: (typeof EDGES)[number]['id'],
	g: (typeof COMBO_GROUNDS)[number]
): { verdict: ComboVerdict; why: string } => {
	const ratio = contrast(f.fill, g.hex) ?? 21;
	if (edge === 'lift' && g.dark) return { verdict: 'avoid', why: 'The lift is lost on dark: use the hairline' };
	if (edge === 'hairline' && ratio >= MIN) return { verdict: 'avoid', why: 'The edge is already there' };
	if (ratio < MIN && edge === 'none') return { verdict: 'dont', why: `${ratio.toFixed(1)}:1 · the tile is lost` };
	if (f.id === 'white' && g.dark) {
		if (light === 'lit') return { verdict: 'avoid', why: 'A shade reads as grey on dark: pure white' };
		return { verdict: 'do', why: 'Pure white on dark' };
	}
	if (f.id === 'white' && light === 'flat') return { verdict: 'avoid', why: 'Pure white: lists, and 40 and under' };
	if (light === 'flat') return { verdict: 'avoid', why: 'Flat reads as a sticker: lists only' };
	return { verdict: 'do', why: ratio < MIN ? `The ${edge} draws the edge` : `${ratio.toFixed(1)}:1 on its own` };
};
const COMBOS = COMBO_FILLS.map((f) => ({
	f,
	grounds: COMBO_GROUNDS.map((g) => ({
		g,
		cells: LIGHTS.flatMap((l) => EDGES.map((e) => ({ l, e, ...comboOf(f, l.id, e.id, g) }))),
	})),
}));
const VERDICT_LABEL: Record<ComboVerdict, string> = { do: 'Do', avoid: 'Avoid', dont: 'Don’t' };

// ── The hero ──
/** The two sets the hero switches between: as it ships, and with the designed marks in. */
const HERO = GROUPS.map((g) => ({
	name: g.name,
	items: g.rows.flatMap((r) => {
		const current = faceOf(r, 'shipped');
		const next = faceOf(r, 'designed');
		if (!current && !next) return [];
		const status = r[r.face]?.status ?? 'exploring';
		return [{ r, current, next, changed: !!next && next !== current, status }];
	}),
}));
const heroCount = (set: 'current' | 'next', s: Status) =>
	HERO.flatMap((g) => g.items).filter((x) =>
		set === 'current' ? x.current && s === 'shipped' : x.next && (x.changed ? 'designed' : 'shipped') === s
	).length;

