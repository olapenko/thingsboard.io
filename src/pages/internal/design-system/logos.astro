						<Icon name="tabler:x" aria-hidden="true" />
					</button>
				</header>
				<div class="pgs__stage" data-ground="dark" data-surface="dark">
					<span class="pgs__v pgs__v--new">
						{(['white', 'colour', 'tint', 'black'] as const).map((f) => (
							<span class="pgs__cell pgs__cell--big">
								<span class="pgs__new-tile" data-new-fill={f}>
									<Icon name="tabler:shape" aria-hidden="true" />
