			'Under review: redrawn in Round 2',
		],
	},
	trendz: {
		anatomy: ['The bars of a chart, pale blue', 'The chip over them, in blue'],
		does: ['Stands for analytics and AI on the platform’s data', 'A White tile, in its own colours'],
		doesNot: ['Its pale bars vanish on a light tab at 16', 'Under review: redrawn in Round 2'],
	},
	'iot-hub': {
		anatomy: ['A centre joined to the nodes around it'],
		does: ['Stands for the free marketplace', 'A White tile, the hub in its amber', 'The icon the product itself uses'],
		doesNot: ['Is not the store: building-store is retired in Round 1'],
	},
	'ai-core': {
		anatomy: ['The sparkles'],
		does: [
			'Stands for the AI across the platform',
			'A Colour tile that cycles the page’s section colours, on the section’s clock',
