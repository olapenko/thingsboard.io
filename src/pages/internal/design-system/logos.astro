			m: 'black',
		},
		{
			id: 'b',
			label: 'B',
			cell: logoOn('dark', mobileGreen),
			status: 'exploring',
			note: 'Dark tile, the logo in its green',
		},
	],
	'iot-hub': [
		{ id: 'current', label: 'Current', cell: hub.cell, status: 'shipped', note: 'White tile, the store' },
		{
			id: 'a',
			label: 'A',
			cell: rowById('iot-hub')?.white?.cell,
			status: 'designed',
			note: 'White tile, the hub the product uses',
			m: 'white',
		},
	],
	community: [
		{
			id: 'a',
			label: 'A',
			cell: draft(CE_SVG, CE_ART, 'solid', CE_HUE, 'wide'),
			status: 'exploring',
			note: 'The old CE icon on CE navy: the placeholder',
		},
		{
