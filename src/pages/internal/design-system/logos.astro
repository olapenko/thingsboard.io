	],
	trendz: [
		{
			id: 'current',
			label: 'Current',
			cell: rowById('trendz')?.white?.cell,
			status: 'shipped',
			note: 'White tile, its own colours',
		},
		toDraw('a'),
		toDraw('b'),
	],
};
const candidatesOf = (r: (typeof ROWS)[number]): Candidate[] =>
	CANDIDATES[r.id] ?? [
		{
			id: 'current',
			label: 'Current',
			cell: r[r.face]?.cell,
			status: r[r.face]?.status ?? 'shipped',
			note: 'Settled',
		},
	];
const roundOf = (id: string) => ROUNDS.find((rd) => rd.picks.some((p) => p.mark === id) || rd.reviews?.includes(id));
const pickOf = (id: string) =>
	ROUNDS.flatMap((rd) => rd.picks.map((p) => ({ ...p, round: rd }))).find((p) => p.mark === id);
/** A candidate tile's fill, for its edge on White and on Dark. */
const fillOf = (c?: Cell) => {
	if (!c) return undefined;
	if (c.kind === 'mark') {
		const fill = c.mark.fill ?? 'solid';
		const hue = resolveHue(c.mark.accent) ?? '#17181c';
		return fill === 'white' ? '#ffffff' : fill === 'wash' ? mixHex(hue, '#ffffff', 0.88) : hue;
	}
	if (c.kind === 'draft') return c.fill === 'white' ? '#ffffff' : c.fill === 'dark' ? '#17181c' : resolveHue(c.accent);
	return undefined;
};
const candidateChecks = (c: Candidate) => {
	const fill = fillOf(c.cell);
	return fill
		? (['white', 'dark'] as const).map((id) => {
				const g = GROUNDS.find((x) => x.id === id) as Ground;
				// On a light ground the lift draws the edge; on a dark one a Dark tile takes the hairline.
				const held = !g.dark || fill === '#17181c';
				return { g, ...judge(contrast(fill, g.hex), held, g.dark ? 'hairline' : 'lift') };
			})
		: [];
};

/**
 * A mark's spec, as its sheet reads it: what is in the drawing, what the mark does (what it stands for,
 * how and where it is shown) and what it does not. Written from the drawings and the pages; a mark
 * under review says so.
 */
interface Spec {
	anatomy: string[];
	does: string[];
	doesNot: string[];
}
const SPECS: Record<string, Spec> = {
	platform: {
		anatomy: ['The chip, the bolt at its heart', 'The orbit around it', 'A node at each end of the orbit'],
		does: [
