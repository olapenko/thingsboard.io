						<span class="pgs__grounds" role="group" aria-label="Ground">
							{SHEET_GROUNDS.map((g) => (
								<button
									type="button"
									data-sheet-ground={g.id}
									aria-pressed={g.id === 'dark' ? 'true' : 'false'}
									aria-label={g.label}
									title={g.label}
								>
									<i class="pg__swatch" data-g={g.id} />
								</button>
							))}
