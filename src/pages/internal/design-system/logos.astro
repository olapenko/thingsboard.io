			font-size: 12px;
			color: var(--color-text-secondary);
			overflow-wrap: anywhere;
		}
	}

	.lr-tiles__dark {
		padding: 12px 0;
		border-radius: 8px;
		background: var(--band-indigo);
	}

	.lr-ladder {
		gap: 16px 20px;
	}

	.lr-ladder__step {
		display: grid;
		justify-items: center;
		gap: 6px;
		margin: 0;
