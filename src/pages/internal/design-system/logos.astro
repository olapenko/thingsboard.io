										</span>
										{(['light', 'dark'] as const).map((g) => (
											<span class="pgs__cell" data-surface={g === 'dark' ? 'dark' : undefined}>
												{c.cell ? (
													<LogoCell cell={atSize(c.cell, 48, false)} />
