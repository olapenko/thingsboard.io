 * current or to be, on a ground; a showcase of it in use; the logotype; the workbench,
 * where the set is a canvas and each mark opens as a sheet; the map of every mark in every treatment
 * with its status and red marks; the colours; how fills, lifts and lights are built and checked; what is
 * being explored; the legacy files; the actions and next steps; and, last, the vocabulary as a spec.
 *
 * Read from the data the new pages render; drafts and directions are drawn here only, and no shipping
 * page changes until the team agrees. The terms are the Vocabulary section's.
 *
 * STATUS is the one thing to edit as decisions land: a treatment's `status`, a product's `action`.
 */
const PAGE = designPage('logos');
const ROOT = process.cwd();
const read = (path: string) => readFileSync(join(ROOT, path.replace(/^\//, '')), 'utf8');

/**
 * Where a treatment stands: an idea or a draft, approved and waiting to be built, live on the new
 * pages, or old and to retire. Two more states mark the gaps: not defined (a baseline slot nobody has
 * drawn) and not applicable (an exception's agreed gap).
 */
type Status = 'exploring' | 'designed' | 'shipped' | 'legacy';
const STATUS: Record<Status, string> = {
	shipped: 'Shipped',
	designed: 'Designed',
	exploring: 'Exploring',
	legacy: 'Legacy',
};
const STATUS_NOTE: Record<Status, string> = {
	shipped: 'Live on the new pages',
	designed: 'Approved, waiting to be built',
	exploring: 'An idea or a draft',
	legacy: 'Old files, still in the repo',
};

// ── Cells ──
type MarkCell = Extract<Cell, { kind: 'mark' }>;
const tile = (name: string, mark: MarkSpec): MarkCell => ({ kind: 'mark', name, mark, caption: '' });
const atSize = (c: Cell, size: MarkSize, lift = size >= 64): Cell =>
	c.kind === 'mark'
		? { ...c, mark: { ...c.mark, size, lift: lift && c.mark.lift !== false } }
		: c.kind === 'draft'
			? { ...c, size, lift }
			: c.kind === 'glyph'
				? { ...c, size }
				: c;
const filledOf = (c: Cell, accent: string): Cell =>
	c.kind === 'mark'
		? { ...c, ink: undefined, mark: { ...c.mark, fill: 'solid', tone: undefined, accent } }
		: c.kind === 'draft'
			? { ...c, fill: 'solid', accent }
			: c;

const homeCard = (name: string) => {
	const item = homeEcosystem.find((e) => e.name === name);
	if (!item) throw new Error(`Logos: no homepage ecosystem card "${name}"`);
	return {
		cell: atSize(ecosystemCell(item), 88) as MarkCell,
		accent: item.accent,
		label: item.label,
		description: item.description,
	};
};
const homeProduct = (highlight: string) => {
	const item = homeProducts.find((p) => p.nameHighlight === highlight);
	if (!item) throw new Error(`Logos: no homepage product card "${highlight}"`);
	return {
		cell: atSize(ecosystemCell(item), 88) as MarkCell,
		fill: item.badgeFill,
		label: item.label,
		description: item.description,
	};
};

/**
 * Mark's knockout in one ink, cropped to the art: the darkest tone the ink, the others the ink at half,
 * currentColor the ink. White makes the glyph's mask; a product's accent, its favicon.
 */
function inkedSvg(raw: string, art: readonly number[], ink: string) {
	const half = /^#[0-9a-f]{6}$/i.test(ink) ? `${ink}80` : ink;
	const lum = (hex: string) => {
		const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
		return 0.2126 * r + 0.7152 * g + 0.0722 * b;
	};
	const tones = [...new Set((raw.match(/#[0-9a-fA-F]{6}\b/g) ?? []).map((t) => t.toLowerCase()))].sort(
		(a, b) => lum(a) - lum(b)
	);
	let svg = raw;
	tones.forEach((t, i) => (svg = svg.replace(new RegExp(t, 'gi'), i === 0 ? ink : half)));
	return svg
		.replace(/currentColor/gi, ink)
		.replace(
			/<svg\b([^>]*)>/,
			(_m, attrs: string) =>
				`<svg${attrs.replace(/\s*\b(width|height|viewBox)="[^"]*"/g, '')} viewBox="${art.join(' ')}">`
		);
}
const maskOf = (raw: string, art: readonly number[]) =>
	`data:image/svg+xml;charset=utf-8,${encodeURIComponent(inkedSvg(raw, art, '#ffffff'))}`;
const glyphCell = (mask?: string, icon?: string): Cell => ({
	kind: 'glyph',
	name: '',
	caption: '',
