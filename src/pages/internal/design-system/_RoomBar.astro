---
import RoomTabs from '@root/pages/internal/design-system/_RoomTabs.astro';
import type { RoomPageId } from '@root/pages/internal/design-system/_room';

/**
 * The room's bar for a page drawn outside the room component (Files, About): the room's tabs in the
 * area bar's lower row (`slot="below"`), 60px tall with an edge on top, in the kit's box so the room's
 * mark starts where the page's content does (1280px, 24px in, inside the body's 24px).
 */
interface Props {
	current: RoomPageId;
}

const { current } = Astro.props;
---

<div class="rbar">
	<div class="rbar__in">
		<RoomTabs current={current} />
	</div>
</div>

<style>
	.rbar {
		height: 60px;
		padding-inline: 24px;
		border-top: 1px solid var(--color-border, #ebebeb);
	}

	.rbar__in {
		display: flex;
		height: 100%;
		max-width: 1280px;
		margin-inline: auto;
		padding-inline: 24px;
	}
</style>
