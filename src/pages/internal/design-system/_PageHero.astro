---
/**
 * A Logo Room page's hero, under the room's bar: a light band the width of the window, a dot grid
 * fading out from its left, then the page's title, its lede and its contents. The Overview's
 * dark hero, made quiet. Guidelines, the Studio, Files and About open with it; what a page adds under it goes in the slot.
 *
 * `pull` lifts the band by that many pixels, so it starts flush under the bar wherever the page puts it.
 * `kit` lines the text up with the lab's kit layout (the Files page): a 1280px box, centred, 24px in.
 * `colours` washes the band's right side in those colours, a soft glow each, fading before the text:
 * the set's own colours, for a page about the set as a whole.
 * `ribbon` lays a thin striped band along the band's top, flush under the bar: the back office's sign,
 * for a page that is the room's workings rather than its guidance (Files).
 * `toc` lists the page's sections as a row of chips under the lede, below 1280; from there up the room's
 * floating chips (_RoomToc) take over, so a page never shows both.
 */
interface Props {
	title: string;
	lede?: string;
	pull?: number;
	kit?: boolean;
	toc?: { id: string; label: string }[];
	colours?: string[];
	ribbon?: boolean;
}

const { title, lede, pull = 108, kit = false, toc = [], colours = [], ribbon = false } = Astro.props;
/** A glow per colour, spread over the band's right half, alternating high and low. */
const wash = colours
	.map((c, i) => {
		const x = 52 + (i * 44) / Math.max(colours.length - 1, 1);
		const y = i % 2 === 0 ? 28 : 78;
		return `radial-gradient(34% 70% at ${x.toFixed(0)}% ${y}%, color-mix(in srgb, ${c} 26%, transparent), transparent 72%)`;
	})
	.join(', ');
---

<header class:list={['ph', kit && 'ph--kit']} style={`--ph-pull: ${pull}px`}>
	{wash && <span class="ph__wash" style={`background-image: ${wash}`} aria-hidden="true" />}
	{ribbon && <span class="ph__ribbon" aria-hidden="true" />}
	<div class="ph__in">
		<h1>{title}</h1>
		{lede && <p class="ph__lede">{lede}</p>}
		{toc.length > 0 && (
			<nav class="ph__toc" aria-label="On this page">
				{toc.map((s) => (
					<a href={`#${s.id}`}>{s.label}</a>
				))}
			</nav>
		)}
		<slot />
	</div>
</header>

<script>
	import { trackScrollbar } from '@root/pages/internal/design-system/_bleed';

	trackScrollbar();
</script>

<style lang="scss">
	@use '../../../styles/variables' as *;

	.ph {
		position: relative;
		isolation: isolate;
		// The width of the window less its scrollbar (`--sbw`, _bleed.ts), so it never scrolls the page sideways.
		margin: calc(-1 * var(--ph-pull)) calc(50% - 50vw + var(--sbw, 0px) / 2) 8px;
		padding: 72px calc(50vw - 50% - var(--sbw, 0px) / 2) 44px;
		background: linear-gradient(180deg, #f4f5f7 0%, #fff 100%);

		@include media-down(md) {
			padding: 40px 16px 32px;
		}

		&::before {
			content: '';
			position: absolute;
			z-index: -1;
			inset: 0;
			background-image: radial-gradient(rgba(23, 24, 28, 0.1) 1px, transparent 1.6px);
			background-size: 22px 22px;
			mask-image: radial-gradient(60% 90% at 18% 30%, #000, transparent 75%);
		}

		h1 {
			@include type-title;

			margin: 0;
		}
	}

	// The colour wash: under the dot grid, faded out toward the text on the left.
	.ph__wash {
		position: absolute;
		z-index: -2;
		inset: 0;
		-webkit-mask-image: linear-gradient(90deg, transparent 30%, #000 70%);
		mask-image: linear-gradient(90deg, transparent 30%, #000 70%);
	}

	// The back office's ribbon: diagonal white and grey, as on a works barrier but uncoloured, so it sits
	// in the band; the window's full width, and short.
	.ph__ribbon {
		position: absolute;
		top: 0;
		right: 0;
		left: 0;
		height: 8px;
		background: repeating-linear-gradient(-45deg, #fff 0 10px, color-mix(in srgb, #17181c 12%, #fff) 10px 20px);
		box-shadow: inset 0 -1px 0 rgba(23, 24, 28, 0.06);
	}

	.ph__in {
		display: grid;
		justify-items: start;
		gap: 12px;
	}

	// On the kit layout: the body's 24px, then the kit's box, 1280px centred with its own 24px.
	.ph--kit {
		padding-inline: 24px;

		.ph__in {
			max-width: 1280px;
			margin-inline: auto;
			padding-inline: 24px;
		}
	}

	.ph__lede {
		@include type-lede;

		max-width: 720px;
		margin: 0;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}

	// The contents: each section as a chip, a faint fill that deepens on hover.
	.ph__toc {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 12px;

		a {
			padding: 8px 16px;
			border-radius: 100px;
			background: rgba(23, 24, 28, 0.05);
			color: var(--color-text);
			font-size: 15px;
			font-weight: $font-weight-medium;
			text-decoration: none;
			transition: background-color 0.15s;

			&:hover {
				background: rgba(23, 24, 28, 0.1);
			}

			&:focus-visible {
				outline: 2px solid var(--focus-ring);
				outline-offset: 2px;
			}
		}

		@include media-up(xl) {
			display: none;
		}
	}
</style>
