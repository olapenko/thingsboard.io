---
import { ROOM_MARK } from '@root/pages/internal/design-system/_room';

/**
 * The Logo Room's mark: four cards fanned in the set's colours (ROOM_MARK), the front one, the
 * platform's shaded White, carrying a plus. The room's bar draws it beside its name; About's hero draws
 * it large. `id` keeps its gradient's id apart where a page draws it twice.
 */
interface Props {
	/** Its width in px; the height follows (3:2). */
	size?: number;
	id?: string;
	class?: string;
}

const { size = 48, id = 'room-mark', class: className } = Astro.props;
const fills = [...ROOM_MARK.slice(0, -1), `url(#${id}-white)`];
---

<svg class:list={['rmark', className]} viewBox="-4 0 48 32" width={size} height={(size * 2) / 3} aria-hidden="true">
	<defs>
		<linearGradient id={`${id}-white`} x1="0.29" y1="0.05" x2="0.71" y2="0.95">
			<stop offset="0.35" stop-color="#fff" />
			<stop offset="1" stop-color="#f0f1fe" />
		</linearGradient>
	</defs>
	{fills.map((c, k) => (
		<g style={`--turn: ${(fills.length - 1 - k) * -11}deg`}>
			<rect x="18" y="4" width="24" height="24" rx="7.7" fill={c} />
		</g>
	))}
	<rect class="rmark__plus" x="23.5" y="14.5" width="13" height="3" rx="1" />
	<rect class="rmark__plus" x="28.5" y="9.5" width="3" height="13" rx="1" />
</svg>

<style>
	.rmark {
		flex: none;
		overflow: visible;
	}

	.rmark g {
		transform: rotate(var(--turn));
		transform-box: view-box;
		transform-origin: 30px 44px;
		transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}

	@media (prefers-reduced-motion: reduce) {
		.rmark g {
			transition: none;
		}
	}

	/* The plus on the front card: the room is where a mark is added. */
	.rmark__plus {
		fill: #17181c;
	}
</style>
