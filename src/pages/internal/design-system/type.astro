</style>

<script>
	/**
	 * Measure the specimens, then read the chosen page through the frame and count what it paints.
	 *
	 * Both halves are measured rather than parsed: computed style is the only thing that knows what
	 * a media query, a container query and four competing selectors actually settled on.
	 */
	interface HarvestPage {
		key: string;
		label: string;
		src: string;
	}

	const fmt = (px: string) => (px.endsWith('px') ? `${Math.round(parseFloat(px) * 100) / 100}` : px);

	// --- declared -----------------------------------------------------------------------------
	const declared = new Set<string>();

	const measureDeclared = () => {
		declared.clear();
		document.querySelectorAll<HTMLElement>('[data-spec]').forEach((row) => {
			const sample = row.querySelector<HTMLElement>('.ty__sample');
			const out = row.querySelector<HTMLElement>('[data-nums]');
			if (!sample || !out) return;
			const cs = getComputedStyle(sample);
			const size = fmt(cs.fontSize);
			const line = fmt(cs.lineHeight);
			const ratio = (parseFloat(cs.lineHeight) / parseFloat(cs.fontSize)).toFixed(2);
			out.textContent = `${size} / ${line}  ·  ${ratio}  ·  ${cs.fontWeight}`;
			// Only the ladder defines "on scale".
			if (row.hasAttribute('data-scale')) declared.add(`${size}|${cs.fontWeight}|${line}`);
		});
	};
	measureDeclared();

	// --- as used ------------------------------------------------------------------------------
	const frame = document.querySelector<HTMLIFrameElement>('[data-probe]')!;
	const pages: HarvestPage[] = JSON.parse(frame.dataset.pages ?? '[]');
	const pick = document.querySelector<HTMLSelectElement>('[data-page-pick]')!;
	const open = document.querySelector<HTMLAnchorElement>('[data-page-open]')!;
	const status = document.querySelector<HTMLElement>('[data-status]')!;

	// Not the page: the internal island, the cookie notice, the chat.
	const EXCLUDE = '[data-internal-nav], [data-cc-root], #yourgpt_root';

	/**
	 * Is this node inside a key visual?
	 *
	 * The test is the design unit itself. Every visual declares `--<name>-u` on its root — `--plat-u`,
	 * `--hub-u`, `--flow-u`, `--norm-u`, `--tc-u`, `--sd-u` and the rest — and custom properties
	 * inherit, so any descendant resolves one and nothing outside does. That beats a list of component
	 * class names, which would need editing every time a visual is added or renamed.
	 */
	const inVisual = (el: Element) => Array.from(getComputedStyle(el)).some((p) => /^--[a-z0-9]+-u$/.test(p));

	type Row = { size: string; weight: string; line: string; family: string; n: number; eg: string };

	const esc = (s: string) => s.replace(/[<&]/g, (c) => (c === '<' ? '&lt;' : '&amp;'));
	const fam = (r: Row) => (/Ubuntu Mono/.test(r.family) ? ' mono' : /Ubuntu/.test(r.family) ? '' : ` ${r.family}`);
	const onScale = (r: Row) => declared.has(`${r.size}|${r.weight}|${r.line}`);

	/** `scale: false` drops the on-scale column — it is a question the visuals are not answering. */
	const paint = (body: Element | null, list: Row[], scale = true) => {
		if (!body) return;
		const cols = scale ? 6 : 5;
		if (!list.length) {
			body.innerHTML = `<tr><td colspan="${cols}" class="ty__pending">Nothing here.</td></tr>`;
			return;
		}
		body.innerHTML = list
			.map((r) => {
				const mark = scale ? `<td>${onScale(r) ? '✓' : '·'}</td>` : '';
				return `<tr><td>${r.size}${fam(r)}</td><td>${r.weight}</td><td>${r.line}</td><td>${r.n}</td>${mark}<td>${esc(r.eg)}</td></tr>`;
			})
			.join('');
	};

	const pending = (text: string) => {
		const row = (cols: number) => `<tr><td colspan="${cols}" class="ty__pending">${esc(text)}</td></tr>`;
		document.querySelectorAll('[data-used-body], [data-small-body]').forEach((b) => (b.innerHTML = row(6)));
		const visual = document.querySelector('[data-visual-body]');
		if (visual) visual.innerHTML = row(5);
		document.querySelectorAll('[data-onscale-count], [data-visual-count]').forEach((b) => (b.textContent = '—'));
		const block = document.querySelector<HTMLElement>('[data-leading-block]');
		if (block) block.hidden = true;
	};

	const harvest = (doc: Document) => {
		const seen = new Map<string, Row>();
		const seenVisual = new Map<string, Row>();

		doc.querySelectorAll<HTMLElement>('.page *').forEach((el) => {
			if (el.closest(EXCLUDE)) return;
			// Only elements that paint text of their own — a wrapper inherits its child's numbers and
			// would count the same decision twice.
			const own = Array.from(el.childNodes)
				.filter((n) => n.nodeType === 3)
				.map((n) => n.textContent?.trim() ?? '')
				.join(' ')
				.trim();
			if (!own) return;
			const r = el.getBoundingClientRect();
			// `> 1`, not `truthy`: the visually-hidden pattern clips to a 1px box rather than hiding the
			// element, so screen-reader text is laid out and has a computed font size. Counted, it put
			// text nobody will ever see set in among the page's commonest type.
			if (r.width <= 1 || r.height <= 1) return;

			const cs = getComputedStyle(el);
			const size = fmt(cs.fontSize);
			const line = fmt(cs.lineHeight);
			const family = cs.fontFamily.split(',')[0].replace(/["']/g, '');
			const key = `${size}|${cs.fontWeight}|${line}|${family}`;
			const bucket = inVisual(el) ? seenVisual : seen;
			const hit = bucket.get(key);
			if (hit) {
				hit.n += 1;
			} else {
				bucket.set(key, { size, weight: cs.fontWeight, line, family, n: 1, eg: own.slice(0, 34) });
			}
		});

		const byUse = (a: Row, b: Row) => b.n - a.n || parseFloat(b.size) - parseFloat(a.size);
		const rows = [...seen.values()].sort(byUse);
		const visualRows = [...seenVisual.values()].sort(byUse);

		paint(document.querySelector('[data-used-body]'), rows);
		paint(
			document.querySelector('[data-small-body]'),
			rows.filter((r) => parseFloat(r.size) < 16)
		);
		paint(document.querySelector('[data-visual-body]'), visualRows, false);

		const hits = rows.filter(onScale).length;
		const tally = document.querySelector('[data-onscale-count]');
		if (tally) tally.textContent = `${hits} of ${rows.length}`;

		const vTally = document.querySelector('[data-visual-count]');
		const vNodes = visualRows.reduce((sum, r) => sum + r.n, 0);
		if (vTally) vTally.textContent = `${visualRows.length} combinations across ${vNodes} elements`;

		// One size at several leadings. Sorted by how many leadings it carries, because that is the
		// order they are worth settling in.
		const leadings = new Map<string, Map<string, number>>();
		rows.forEach((r) => {
			const at = leadings.get(r.size) ?? new Map<string, number>();
			at.set(r.line, (at.get(r.line) ?? 0) + r.n);
			leadings.set(r.size, at);
		});
		const split = [...leadings.entries()]
			.filter(([, at]) => at.size > 1)
			.sort((a, b) => b[1].size - a[1].size || parseFloat(a[0]) - parseFloat(b[0]));

		const list = document.querySelector('[data-leading]');
		const block = document.querySelector<HTMLElement>('[data-leading-block]');
		if (list && block) {
			list.innerHTML = split
				.map(([size, at]) => {
					const parts = [...at.entries()]
						.sort((a, b) => b[1] - a[1])
						.map(([line, n]) => `<span class="ty__lead">${line}<i>×${n}</i></span>`)
						.join('');
					return `<li><b>${size}px</b> <em>${at.size} leadings</em> ${parts}</li>`;
				})
				.join('');
			block.hidden = split.length === 0;
		}
		return rows.length;
	};

	/**
	 * A fresh iframe already has a document — `about:blank`, `readyState: "complete"` — so a bare
	 * readiness check passes instantly and harvests nothing. And after a switch, the page being left
	 * is still complete until the next one replaces it. So readiness is asked about the document that
	 * matters — the page asked for, complete, with the page root present — and asked repeatedly.
	 */
	const normal = (path: string) => path.replace(/\/?$/, '/');
	const ready = (want: string) => {
		const d = frame.contentDocument;
		return (
			!!d && d.readyState === 'complete' && normal(d.location.pathname) === normal(want) && !!d.querySelector('.page')
		);
	};

	let run = 0;
	let current: HarvestPage | undefined;
	const read = (page: HarvestPage) => {
		const mine = ++run;
		current = page;
		open.href = page.src;
		pending(`Reading ${page.label}…`);
		status.textContent = `Reading ${page.label}…`;
		if (normal(frame.contentDocument?.location.pathname ?? '') !== normal(page.src)) frame.src = page.src;
		const started = performance.now();
		const poll = window.setInterval(async () => {
			if (mine !== run) return window.clearInterval(poll);
			if (ready(page.src)) {
				window.clearInterval(poll);
				await frame.contentDocument!.fonts.ready;
				if (mine !== run) return;
				const n = harvest(frame.contentDocument!);
				status.textContent = `${page.label}: ${n} combinations.`;
			} else if (performance.now() - started > 30000) {
				// Leave the tables saying what they are waiting for, which is the honest state.
				window.clearInterval(poll);
				status.textContent = `${page.label} did not load. Is the dev server running?`;
			}
		}, 250);
	};

	// The page to read rides on the query, so a reading can be linked: `?page=cloud`.
	const byKey = (key: string | null) => pages.find((p) => p.key === key);
	const first = byKey(new URLSearchParams(location.search).get('page')) ?? pages[0];
	pick.value = first.key;
	read(first);

	pick.addEventListener('change', () => {
		const page = byKey(pick.value);
		if (!page) return;
		const url = new URL(location.href);
		url.searchParams.set('page', page.key);
		history.replaceState(null, '', url);
		read(page);
	});

	// The ladder's steps move with the window, and with them what counts as on the scale; the page in
	// the frame does not, so it is counted again against the new steps rather than read again.
	let resize = 0;
	addEventListener('resize', () => {
		clearTimeout(resize);
		resize = window.setTimeout(() => {
			measureDeclared();
			if (current && ready(current.src)) harvest(frame.contentDocument!);
		}, 150);
	});
</script>
