	}
	.m-type-tile-lg {
		@include type-tile-lg;
	}
	.m-type-tile {
		@include type-tile;
	}
	.m-type-lede {
		@include type-lede;
	}
	.m-type-body {
		@include type-body;
	}
	.m-type-link {
		@include type-link;
	}
	.m-type-action {
		@include type-action;
	}
	.m-type-button {
		@include type-button;
	}
	.m-type-small {
		@include type-small;
	}
	.m-type-small-strong {
		@include type-small-strong;
	}
	.m-type-eyebrow {
		@include type-eyebrow;
	}

	.m-hero-title {
		@include hero-title;
	}
