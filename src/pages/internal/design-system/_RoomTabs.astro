---
import { Icon } from 'astro-icon/components';
import RoomMark from '@root/pages/internal/design-system/_RoomMark.astro';
import { ROOM, type RoomPageId } from '@root/pages/internal/design-system/_room';

/**
 * The Logo Room's navigation: its name with a mark of its own — four cards fanned in the set's
 * colours, the front one carrying a plus — then
 * Overview, Guidelines, Studio, Files and About as tabs, the current one underlined at the bar's foot. Each
 * link carries the address's query to the next page, so the set built in the Studio travels with you.
 */
interface Props {
	current: RoomPageId;
}

const { current } = Astro.props;
---

<div class="room" role="navigation" aria-label="Logo Room">
	<a class="room__brand" href={ROOM[0].href} data-room-link>
		<RoomMark class="room__mark" />
		<span class="room__name">Logo Room</span>
	</a>
	<span class="room__tabs">
		{ROOM.map((p) => (
			<a href={p.href} data-room-link aria-current={p.id === current ? 'page' : undefined}>
				{p.icon && <Icon name={p.icon} aria-hidden="true" />}
				{p.label}
			</a>
		))}
	</span>
</div>

<script>
	// The set and the view live in the query; a link takes them along — but not the mark open in the
	// sheet, which belongs to the page it was opened on.
	document.querySelectorAll<HTMLAnchorElement>('a[data-room-link]').forEach((a) =>
		a.addEventListener('click', () => {
			const q = new URLSearchParams(location.search);
			q.delete('mark');
			a.search = q.toString();
		})
	);
</script>

<style lang="scss">
	@use '../../../styles/variables' as *;

	// On a narrow screen the tabs scroll sideways inside the bar rather than widen the page, and the
	// room's name gives way to its mark.
	.room {
		display: flex;
		flex: 0 1 auto;
		align-self: stretch;
		align-items: stretch;
		gap: 28px;
		min-width: 0;

		@include media-down(sm) {
			gap: 16px;

			.room__name {
				display: none;
			}
		}
	}

	.room__brand {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		color: var(--color-text);
		text-decoration: none;

		&:focus-visible {
			border-radius: 8px;
			outline: 2px solid var(--focus-ring);
			outline-offset: 2px;
		}
	}

	// The room's mark, drawn as one SVG: four cards fanned like a hand, each turned 11° from the next
	// about one point just under the stack, so their tops run on one arc and each colour shows as a band.
	// Flat fills, no edges. On hover the fan opens a little wider.
	// The mark (_RoomMark.astro) fans a little wider on hover.
	.room__brand:hover :global(.room__mark g:not(:last-of-type)) {
		transform: rotate(calc(var(--turn) * 1.3));
	}

	.room__name {
		font-size: 16px;
		font-weight: $font-weight-bold;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	// The tabs: text, the current one in the ink with a bar at the foot.
	.room__tabs {
		display: flex;
		align-items: stretch;
		gap: 20px;
		min-width: 0;
		overflow-x: auto;
		scrollbar-width: none;

		a {
			position: relative;
			display: flex;
			align-items: center;
			gap: 6px;
			color: var(--color-text-secondary);
			font-size: 15px;
			font-weight: $font-weight-medium;
			text-decoration: none;
			white-space: nowrap;
			transition: color 0.15s;

			:global(svg) {
				width: 17px;
				height: 17px;
				opacity: 0.8;
			}

			&::after {
				content: '';
				position: absolute;
				right: 0;
				bottom: 0;
				left: 0;
				height: 2px;
				border-radius: 2px 2px 0 0;
				background: transparent;
				transition: background-color 0.15s;
			}

			&:hover {
				color: var(--color-text);

				&::after {
					background: rgba(23, 24, 28, 0.16);
				}
			}

			&[aria-current='page'] {
				color: var(--color-text);

				&::after {
					background: var(--color-text);
				}
			}

			&:focus-visible {
				border-radius: 6px;
				outline: 2px solid var(--focus-ring);
				outline-offset: 2px;
			}
		}
	}
</style>
