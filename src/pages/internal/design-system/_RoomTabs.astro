---
import { ROOM, type RoomPageId } from '@root/pages/internal/design-system/_room';

/**
 * The Logo Room's navigation: its name with a mark of its own — four cards fanned in the set's
 * colours, the front one carrying a plus — then
 * Overview, Bench, Spec and Files as tabs, the current one underlined at the bar's foot. Each link
 * carries the address's query to the next page, so the set built on the bench travels with you.
 */
interface Props {
	current: RoomPageId;
}

const { current } = Astro.props;

/**
 * The mark's cards, back to front, in the set's own colours: IoT Hub's amber, On-premises' green,
 * Cloud's indigo, then the platform's White, shaded, with the plus.
 */
const ROOM_MARK = ['#b45309', '#178649', '#3d50f5', 'url(#room-mark-white)'];
---

<div class="room" role="navigation" aria-label="Logo Room">
	<a class="room__brand" href={ROOM[0].href} data-room-link>
		<svg class="room__mark" viewBox="-4 0 48 32" aria-hidden="true">
			<defs>
				<linearGradient id="room-mark-white" x1="0.29" y1="0.05" x2="0.71" y2="0.95">
					<stop offset="0.35" stop-color="#fff" />
					<stop offset="1" stop-color="#f0f1fe" />
				</linearGradient>
			</defs>
			{ROOM_MARK.map((c, k) => (
				<g style={`--turn: ${(ROOM_MARK.length - 1 - k) * -11}deg`}>
					<rect x="18" y="4" width="24" height="24" rx="7.7" fill={c} />
				</g>
			))}
			<rect class="room__plus" x="23.5" y="14.5" width="13" height="3" rx="1" />
			<rect class="room__plus" x="28.5" y="9.5" width="3" height="13" rx="1" />
		</svg>
		<span class="room__name">Logo Room</span>
	</a>
	<span class="room__tabs">
		{ROOM.map((p) => (
			<a href={p.href} data-room-link aria-current={p.id === current ? 'page' : undefined}>
				{p.label}
			</a>
		))}
	</span>
</div>

<script>
	// The set and the view live in the query; a link takes them along — but not the mark open in the
	// sheet, which belongs to the page it was opened on.
	document.querySelectorAll<HTMLAnchorElement>('a[data-room-link]').forEach((a) =>
		a.addEventListener('click', () => {
			const q = new URLSearchParams(location.search);
			q.delete('mark');
			a.search = q.toString();
		})
	);
</script>

<style lang="scss">
	@use '../../../styles/variables' as *;

	.room {
		display: flex;
		flex: none;
		align-self: stretch;
		align-items: stretch;
		gap: 28px;
	}

	.room__brand {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		color: var(--color-text);
		text-decoration: none;

		&:focus-visible {
			border-radius: 8px;
			outline: 2px solid var(--focus-ring);
			outline-offset: 2px;
		}
	}

	// The room's mark, drawn as one SVG: four cards fanned like a hand, each turned 11° from the next
	// about one point just under the stack, so their tops run on one arc and each colour shows as a band.
	// Flat fills, no edges. On hover the fan opens a little wider.
	.room__mark {
		flex: none;
		width: 48px;
		height: 32px;
		overflow: visible;

		g {
			transform: rotate(var(--turn));
			transform-box: view-box;
			transform-origin: 30px 44px;
			transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
		}

		.room__brand:hover & g:not(:last-of-type) {
			transform: rotate(calc(var(--turn) * 1.3));
		}

		@media (prefers-reduced-motion: reduce) {
			g {
				transition: none;
			}
		}
	}

	// The plus on the front card: the room is where a mark is added.
	.room__plus {
		fill: #17181c;
	}

	.room__name {
		font-size: 16px;
		font-weight: $font-weight-bold;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	// The tabs: text, the current one in the ink with a bar at the foot.
	.room__tabs {
		display: flex;
		align-items: stretch;
		gap: 20px;

		a {
			position: relative;
			display: flex;
			align-items: center;
			color: var(--color-text-secondary);
			font-size: 15px;
			font-weight: $font-weight-medium;
			text-decoration: none;
			white-space: nowrap;
			transition: color 0.15s;

			&::after {
				content: '';
				position: absolute;
				right: 0;
				bottom: 0;
				left: 0;
				height: 2px;
				border-radius: 2px 2px 0 0;
				background: transparent;
				transition: background-color 0.15s;
			}

			&:hover {
				color: var(--color-text);

				&::after {
					background: rgba(23, 24, 28, 0.16);
				}
			}

			&[aria-current='page'] {
				color: var(--color-text);

				&::after {
					background: var(--color-text);
				}
			}

			&:focus-visible {
				border-radius: 6px;
				outline: 2px solid var(--focus-ring);
				outline-offset: 2px;
			}
		}
	}
</style>
