---
import PlaygroundLayout from '@layouts/PlaygroundLayout.astro';
import HubGrid, { type HubItem } from '@root/pages/internal/_HubGrid.astro';

/**
 * Design system › Overview: what every page is built from, one tile per page. The pages keep their
 * `/internal/library/` addresses; the area is the structure, the paths are only addresses. Color
 * joins Type and UI here when it is drawn.
 */
const PAGES: HubItem[] = [
	{
		id: 'type',
		label: 'Type',
		title: 'The type scale, declared and as used',
		href: '/internal/library/type/',
		badge: { icon: 'tabler:typography', color: '#3d50f5' },
	},
	{
		id: 'ui',
		label: 'UI',
		title: 'Every button, link and reused piece on Home, Cloud and On-premises',
		href: '/internal/library/ui/',
		badge: { icon: 'tabler:components', color: '#7b3fe4' },
	},
];
---

<PlaygroundLayout title="Design system">
	<HubGrid groups={[{ key: 'design', title: 'Design system', items: PAGES }]} />
</PlaygroundLayout>
