---
import PlaygroundLayout from '@layouts/PlaygroundLayout.astro';
import Tiles from '@root/pages/internal/_Tiles.astro';
import { DESIGN, designHref } from '@root/pages/internal/_design';

/**
 * Design system › Overview: one tile per page, in the order the system builds up.
 *
 *   FOUNDATIONS — the values: colour, grounds and focus, elevation, radius, spacing, icons, motion.
 *   TYPE        — the role ladder drawn with them, and a redesigned page read live against it.
 *   COMPONENTS  — the `ui/` kit drawn with both, live, and the two Landing pieces built on it.
 *   INVENTORY   — what the redesigned pages actually draw, harvested from them, kit or not.
 *
 * The first three say what the system is; the last says how far the pages are on it. Their numbers
 * are measured from what rendered, so they cannot drift from the code; the hand-written notes beside
 * them (where a value is used, what a role is for) can, and their headers say which is which.
 *
 * ADD a page: an entry in `_design.ts` and a file in `design-system/`; the tile, the top bar's tab
 * and the island follow with no other edit.
 */
---

<PlaygroundLayout
	title="Design system"
	description="What the redesigned pages are built from, in the order it builds up: the values, the type roles drawn with them, the components drawn with both, and where the pages use each piece."
>
	<Tiles
		tiles={DESIGN.map((p) => ({ href: designHref(p), label: p.label, blurb: p.blurb, icon: p.icon, source: p.source }))}
	/>
</PlaygroundLayout>
