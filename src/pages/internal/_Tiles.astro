---
import { Icon } from 'astro-icon/components';

/**
 * An overview: one tile per page of an area, or per area on the hub. A tile is a link with an icon,
 * a name, one line, and a footnote in mono for where the thing lives.
 */
export interface Tile {
	href: string;
	label: string;
	blurb?: string;
	icon?: string;
	source?: string;
}

interface Props {
	tiles: Tile[];
}

const { tiles } = Astro.props;
---

<ul class="tiles">
	{tiles.map((t) => (
		<li>
			<a class="tile" href={t.href}>
				{t.icon && (
					<span class="tile__icon" aria-hidden="true">
						<Icon name={t.icon} />
					</span>
				)}
				<span class="tile__name">{t.label}</span>
				{t.blurb && <span class="tile__blurb">{t.blurb}</span>}
				{t.source && <span class="tile__source">{t.source}</span>}
			</a>
		</li>
	))}
</ul>

<style lang="scss">
	@use '../../styles/variables' as *;

	.tiles {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: $spacing-5;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0;
		list-style: none;
	}

	// A column rather than a grid: a grid hands a tall tile's spare height to every row, which set the
	// names of two tiles side by side at different heights once one blurb ran longer. In a column the
	// spare height goes where `margin-top: auto` puts it, above the footnote.
	.tile {
		display: flex;
		flex-direction: column;
		gap: $spacing-2;
		height: 100%;
		padding: $spacing-5;
		border: 1px solid var(--color-border, #ebebeb);
		border-radius: $radius-lg;
		background: #fff;
		color: var(--color-text, #17181c);
		text-decoration: none;
		box-shadow: var(--elev-tile);
		transition:
			box-shadow 0.15s ease,
			transform 0.15s ease;

		&:hover {
			box-shadow: var(--elev-tile-hover);
			transform: translateY(-2px);
		}

		&:focus-visible {
			outline: 2px solid $color-brand;
			outline-offset: 2px;
		}
	}

	.tile__icon {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 32%;
		background: var(--band-tint, #f5f6ff);
		color: $color-brand;

		:global(svg) {
			width: 22px;
			height: 22px;
		}
	}

	.tile__name {
		@include type-card;
	}

	.tile__blurb {
		@include type-small;
		color: var(--color-text-secondary, #5b616e);
		text-wrap: pretty;
	}

	.tile__source {
		@include type-small;
		margin-top: auto;
		padding-top: $spacing-2;
		font-family: $font-family-mono;
		color: var(--color-text-muted, #868d9a);
	}
</style>
