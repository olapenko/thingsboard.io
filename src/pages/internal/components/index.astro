---
import PlaygroundLayout from '@layouts/PlaygroundLayout.astro';
import HubGrid from '@root/pages/internal/_HubGrid.astro';
import { areaGroups } from '@root/pages/internal/_key-visuals';

/**
 * Components › Overview: one tile per section, each linking to its own page, grouped by where it
 * ships: on the homepage (numbered, in page order), on the product pages, or waiting for a section.
 * The ecosystem cards are a homepage section like the rest; their tile opens their gallery.
 *
 * This took over from the separate Sections hub, so every area has the same shape: an overview,
 * then its pages. ADD a section: an entry in `_key-visuals.ts` and a page in `sections/`. It appears
 * here and in the top bar's picker with no other edit. REMOVE one: delete both.
 */
---

<PlaygroundLayout title="Components">
	<HubGrid groups={areaGroups('sections')} />
</PlaygroundLayout>
