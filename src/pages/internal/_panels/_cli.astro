---
import CliTerminal from '@components/Landing/CliTerminal.astro';

/**
 * The CLI terminal. No feature row: it has no marketing copy of its own yet.
 *
 * One panel of the launch-visuals sandbox. Split one file per key visual so that two people —
 * or two sessions — working on different visuals never touch the same file; before the split
 * every one of them edited the same 1300-line page.
 *
 * Stage chrome (`.stage`, `.stage__cap`, `.probe`, `.page-ctl`, `.unit-row`) is declared in the
 * page's `is:global` block, because a scoped rule there cannot reach markup that lives here.
 */
---

{/* --- CLI ------------------------------------------------------------------------------- */}
<section id="page-panel-cli" role="tabpanel" aria-labelledby="page-tab-cli" data-page-panel="cli">
	{
		/* Checks the token wiring as much as the component: CliTerminal reads --sl-color-* and
	    --color-* directly, so if it renders correctly here the layout is loading both sheets. */
	}
	<figure class="stage" data-w="half">
		<figcaption class="stage__cap">
			<span class="stage__name">CliTerminal</span>
			<span class="stage__note">existing · token-wiring check</span>
		</figcaption>
		<div class="stage__frame">
			<CliTerminal />
		</div>
	</figure>
</section>
