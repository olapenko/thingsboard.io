---
import FeatureRow from '@root/pages/internal/_FeatureRow.astro';
import ConnectCompact from '@components/Landing/ConnectCompact.astro';
import NormalizeCompact from '@components/Landing/NormalizeCompact.astro';
import ScaleCompact from '@components/Landing/ScaleCompact.astro';
import SolutionCompact from '@components/Landing/SolutionCompact.astro';
import TwinCompact from '@components/Landing/TwinCompact.astro';
import { CONNECT_COPY } from '@data/connect-visual';
import { DIGITAL_TWIN_COPY } from '@data/digital-twin-visual';
import { NORMALIZE_COPY } from '@data/normalize-visual';
import { SCALE_COPY } from '@data/scale-visual';
import { SOLUTION_COPY } from '@data/solution-flow';

/**
 * The compact family, parked.
 *
 * One panel of the launch-visuals sandbox. Split one file per key visual so that two people —
 * or two sessions — working on different visuals never touch the same file; before the split
 * every one of them edited the same 1300-line page.
 *
 * Stage chrome (`.stage`, `.stage__cap`, `.probe`, `.page-ctl`, `.unit-row`) is declared in the
 * page's `is:global` block, because a scoped rule there cannot reach markup that lives here.
 */

/**
 * The five home-preview visuals, redrawn to one scale.
 *
 * Every one is a new component beside the shipped one rather than a change to it: the home preview
 * still renders the originals, so nothing on that page can move because of anything in this tab.
 *
 * Parked. The scale was right and the drawings were not; kept as the record of what 448u and a 16u
 * floor actually look like, which is the one thing the arithmetic cannot tell you.
 */
const COMPACT_ROWS = [
	{ Visual: ConnectCompact, copy: CONNECT_COPY, was: 'ConnectFlow · 630u, 14u floor · 7.4px' },
	{ Visual: SolutionCompact, copy: SOLUTION_COPY, was: 'SolutionFlow · 630u, 11u floor · 5.8px' },
	{ Visual: TwinCompact, copy: DIGITAL_TWIN_COPY, was: 'DigitalTwin · 630u, 12u floor · 6.4px' },
	{ Visual: NormalizeCompact, copy: NORMALIZE_COPY, was: 'NormalizeFlow · 630u, 14u floor · 7.4px' },
	{ Visual: ScaleCompact, copy: SCALE_COPY, was: 'ScaleGrowth · 448u, 14u floor · 10.5px' },
];
---

{/* --- Compact, 448 units ------------------------------------------------------------------ */}
<section id="page-panel-compact" role="tabpanel" aria-labelledby="page-tab-compact" data-page-panel="compact" hidden>
	<p class="compact-note">
		The five home-preview visuals redrawn to one scale: <strong>448 units wide, nothing smaller than 16u</strong>, with
		the design unit capped at 1px so a unit is a pixel in the home row. That ratio — 448 / 16 = 28 — is what sets the
		smallest type at <strong>12px on a 375px phone</strong> and 16px on a desktop. The shipped versions run 45 to 57 by the
		same measure, which is 5.8 to 7.4px on that phone. Each stage below names what it replaces and what that one measured.
	</p>
	<p class="compact-note">
		Candidates only. Nothing here is wired into the home preview, and none of the five original components was touched —
		both cuts of each visual are on this page to be compared, not swapped.
	</p>

	{
		COMPACT_ROWS.map(({ Visual, copy, was }) => (
			<>
				<FeatureRow visual={{ id: 'compact', title: copy.title, body: copy.body, link: copy.link }}>
					<Visual />
				</FeatureRow>
				<figure class="stage" data-w="full">
					<figcaption class="stage__cap">
						<span class="stage__name">525px · the home row at 1440</span>
						<span class="stage__note">replaces {was} · smallest type here: 16px</span>
					</figcaption>
					<div class="stage__frame stage__frame--plain">
						<div class="probe" style="--probe: 525px">
							<Visual />
						</div>
					</div>
				</figure>

				<figure class="stage" data-w="full">
					<figcaption class="stage__cap">
						<span class="stage__name">335px · a 375px phone</span>
						<span class="stage__note">the width that decides it · smallest type here: 12px</span>
					</figcaption>
					<div class="stage__frame stage__frame--plain">
						<div class="probe" style="--probe: 335px">
							<Visual />
						</div>
					</div>
				</figure>
			</>
		))
	}
</section>
