		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border-radius: 50%;
		color: var(--ink-2);

		.material-icons {
			font-size: 20px;
		}

		&:hover {
			background: rgba(0, 0, 0, 0.06);
			color: var(--ink);
		}
	}

	// A hover tip naming what the glyph opens, on a pointer that can hover. On touch, a tap opens
	// the dialog straight away, and a tip would flash on that same tap. Keyboard focus shows it too.
	.region__help {
		position: relative;
	}

	.region__tip {
