		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 16px;
	}

	.rd__title {
		font-size: 22px;
		line-height: 28px;
		font-weight: 700;
		letter-spacing: -0.2px;
	}

	.rd__close {
		flex: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		margin: -6px -8px 0 0;
		border-radius: 50%;
		color: var(--ink-2);

		&:hover {
			background: rgba(0, 0, 0, 0.06);
			color: var(--ink);
		}
	}

	.rd__lead {
		margin-top: 8px;
		padding-bottom: 20px;
		border-bottom: 1px solid var(--rule);
		font-size: 15px;
		line-height: 22px;
		color: var(--ink-2);
	}

