---
import '@fontsource/material-icons';
import { CLOUD_REGIONS, SOCIAL } from '@root/pages/internal/_cloud-auth';

/**
 * A CANDIDATE for the Cloud auth card, `thingsboard.cloud/signup` and `/login`: the live form, form
 * only, inverted to white and given a data-region switch. One component for both, by `mode`,
 * because the two live pages are one card with different words. The live card is teal (`#00695c`,
 * 528 wide, Material outline fields, the `#ff5722` submit); the pages themselves are the reference.
 *
 * What changed from the live card, and why:
 * - A white card with a soft two-layer shadow on the live page's `#eee` ground; the logo drawn
 *   black. The static host has only the white logo, so the draft blacks it out with a filter. The
 *   product would ship a dark asset.
 * - One accent, the card's old ground `#00695c`: focus rings, the focused field's outline, links,
 *   and the "Last used" and "Current" marks. It is 6.6:1 on white.
 * - Errors in `#c62828`, 5.6:1 on white, each with a glyph so color is not the only signal. The
 *   live `#f44336` sits at 1.8:1 on the teal and all but disappears. Each field points
 *   `aria-describedby` at its message only while the message shows, so a valid field is never
 *   read as an error.
 * - Field outlines at 46% black, so they reach the 3:1 a control's edge needs; Material's 38% is
 *   2.7:1 on white.
 * - Labels without the `*`, sitting in the field like placeholders and hidden, not removed, once
 *   it is filled, so they never jump. `required` tells assistive tech, and the error says what to do.
 * - A bigger, bolder title, a 48px submit with 16px type, and a "Sign in" that is a padded text
 *   button in a centred row.
 * - On a phone the card fills the screen edge to edge and the three providers stay in one row.
 * - Nothing under 14px, a 440px measure instead of the live 528, and white provider buttons.
 *
 * WHERE THE SWITCH SITS is a prop. `beside` puts it on the title's row, the heading on the left and
 * the help glyph and switch balancing it on the right, with the "Data region" label kept for screen
 * readers only: it arrives preselected, so it should read as secondary. `above` puts it, labelled,
 * between the logo and the title, which can then stay "Sign up with" and lead straight into the
 * providers. Both keep the region above the providers. Google, GitHub and Apple each hand off and
 * come back to whichever host started it, so the region has to be settled before any of them is
 * pressed: below the divider it would only govern the email path.
 *
 * PRESELECTION has no UI, by design. In the product the current region is the HOST the form is
 * served on: `thingsboard.cloud` is North America, `eu.thingsboard.cloud` is Europe. The host is
 * what the website's CTA chose by geography (edge: `CF-IPCountry`; client fallback: an `Intl`
 * timezone under `Europe/`), so for most people the switch arrives right and is never touched.
 * Choosing the other region loads the other host's page with the query string carried, so `utm_*`
 * survive the hop, and that form arrives with ITS region current.
 *
 * SIGN IN differs where the job does. The password is `current-password` and only required: a
 * sign-in form checks the account, not the rule it was made under. "Forgot your password?" sits
 * under the password, where the live page's bottom corner was far from the field it is about. No
 * terms line. And a "Last used" badge on the method this browser last signed in with, so a returning
 * user goes straight back to Google or to the email form instead of guessing and landing on a
 * second account. It is kept as the method name only, never the email: an address in storage is
 * personal data sitting unencrypted on a shared machine. Storage is per origin, so each region's
 * host remembers its own. Sign-up records the method too, so the first sign-in after an account is
 * made is already marked. See `_last-used.ts`.
 *
 * The help glyph opens a native `<dialog>` in the spirit of PostHog's region dialog: which region
 * to choose when signing up, which region the account is in when signing in, with a switch to it.
 * Its copy says only what our own docs say, the Cloud FAQ on `/pricing/` and `/products/paas/`:
 * the region (North America or the EU), not a datacentre city, and moving from one region to the
 * other is a manual migration rather than a switch.
 */
interface Props {
	/** Which live page this is: `/signup` or `/login`. */
	mode?: 'signup' | 'signin';
	/**
	 * Draft only: the method the "Last used" badge shows while this browser has none stored, so the
	 * sign-in card can be judged without first clicking a provider. The product shows no badge until
	 * a method has been used.
	 */
	demoLastUsed?: 'google' | 'github' | 'apple' | 'email';
	/** The segment that arrives current. Stands in for the host; see PRESELECTION above. */
	region?: 'us' | 'eu';
	/** The region switch on the title's row, or above the title. See WHERE THE SWITCH SITS. */
	switchAt?: 'beside' | 'above';
	/** Prefix for the ids the labelling needs. Distinct per instance, because the sandbox stacks directions. */
	id?: string;
	/**
	 * A mock address bar over the page, so switching region can be seen doing what it would in the
	 * product: reload the form from the other host. Draft-only chrome, hidden from assistive tech.
	 */
	browser?: boolean;
}

const { mode = 'signup', demoLastUsed, region = 'us', switchAt = 'beside', id = 'csl', browser = false } = Astro.props;

const signin = mode === 'signin';
const verb = signin ? 'Sign in' : 'Sign up';
const path = signin ? '/login' : '/signup';
const title = switchAt === 'above' ? `${verb} with` : verb;

// The help glyph asks a different question per mode. Signing up, it is which region to pick.
// Signing in, it is which region the account is already in, and the dialog can switch to it.
const helpLabel = signin ? 'Which region is my account in?' : 'Which region should I choose?';

// The sign-up dialog's facts per region. Latency is plain distance. The storage lines are the FAQ's
// "stored in either North America or the EU". The hosts are the ones devices are pointed at.
const FACTS: Record<string, string[]> = {
	us: [
		'Lower latency for devices and users in North America',
		'Stores your data in North America',
		'Devices connect to thingsboard.cloud',
	],
	eu: [
		'Lower latency for devices and users in Europe',
		'Stores your data in the European Union, for EU data-residency needs',
		'Devices connect to eu.thingsboard.cloud',
	],
};

// Hosts are set semibold wherever the dialog names them: the address is what a returning user
// recognises, so it is the part of the line to find at a glance. `<b>`, not `<strong>`: it is set
// apart for the eye, not stressed. Split out of the fact strings rather than written into them, so
// the copy stays plain text.
const HOST_RE = /((?:eu\.)?thingsboard\.cloud)/;

const hostOf = (r: string) => CLOUD_REGIONS.find((c) => c.id === r)!.host;
const ids = {
	title: `${id}-title`,
	dlgTitle: `${id}-dlg-title`,
	email: `${id}-email`,
	emailErr: `${id}-email-err`,
	password: `${id}-password`,
	passwordErr: `${id}-password-err`,
};
---

<div class="csl" data-csl data-region={region} data-mode={mode} data-demo-last={demoLastUsed}>
	{
		browser && (
			<div class="bar" aria-hidden="true" data-csl-bar>
				<span class="bar__nav">
					<span class="material-icons">arrow_back</span>
					<span class="material-icons">arrow_forward</span>
					<span class="material-icons" data-csl-reload>
						refresh
					</span>
				</span>
				<span class="bar__url">
					<span class="material-icons">lock</span>
					<span class="bar__addr">
						<span class="bar__host" data-csl-host set:text={hostOf(region)} />
						<span class="bar__path">{path}</span>
					</span>
				</span>
				<span class="bar__progress" />
			</div>
		)
	}
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&display=swap" />

	<form
		class="csl__card"
		novalidate
		aria-label={signin ? 'Sign in to ThingsBoard Cloud' : 'Sign up for ThingsBoard Cloud'}
		data-csl-form
	>
		{
			/* Which instance this page is: the EU flag as a tab docked to the card's right edge,
			   flush with it, while it is the EU one. Flag only. It repeats the switch, so it is
			   hidden from assistive tech; the switch is the one they read. The stars follow the
			   flag's construction: twelve five-point stars on a ring two thirds of its height. */
		}
		<svg class="eu" viewBox="0 0 27 18" aria-hidden="true">
			<path d="M3 0H27V18H3A3 3 0 0 1 0 15V3A3 3 0 0 1 3 0Z" fill="#003399"></path>
			{
				Array.from({ length: 12 }, (_, i) => {
					const a = (i * Math.PI) / 6;
					const cx = 13.5 + 6 * Math.sin(a);
					const cy = 9 - 6 * Math.cos(a);
					const pts = Array.from({ length: 10 }, (_, k) => {
						const r = k % 2 ? 0.4 : 1;
						const t = (k * Math.PI) / 5;
						return `${(cx + r * Math.sin(t)).toFixed(2)},${(cy - r * Math.cos(t)).toFixed(2)}`;
					}).join(' ');
					return <polygon points={pts} fill="#ffcc00" />;
				})
			}
		</svg>
		<img
			class="csl__logo"
			src="https://static.thingsboard.cloud/assets/logo_title_white_cloud.svg"
			alt="ThingsBoard Cloud"
			width="363"
			height="80"
		/>

		<div class={`csl__head csl__head--${switchAt}`}>
			{
				/* The title and the switch in the order the prop asks for, from one copy of each: the
			   loop only decides where the switch lands. DOM order is reading and tab order, so
			   this is done in markup, never with CSS `order`. The product would ship an h1. */
				(switchAt === 'above' ? (['region', 'title'] as const) : (['title', 'region'] as const)).map((slot) =>
					slot === 'title' ? (
						<h1 class="csl__title" id={ids.title}>
							{title}
						</h1>
					) : (
						<nav class={`region region--${switchAt}`} aria-labelledby={`${id}-region-label`}>
							<span class="region__legend" id={`${id}-region-label`}>
								Data region
							</span>
							<button type="button" class="region__help" aria-label={helpLabel} aria-haspopup="dialog" data-csl-help>
								<span class="material-icons" aria-hidden="true">
									help_outline
								</span>
								{/* The aria-label already names the button, so the tip is for the eye only. */}
								<span class="region__tip" aria-hidden="true">
									{helpLabel}
								</span>
							</button>
							{/* Links, not radios: choosing a region LOADS the other host's page, so it is
							    navigation, and a link is what lets it be opened in a new tab. The current
							    host is `aria-current="page"`. The product would append `location.search`
							    to each href so `utm_*` survive the hop. */}
							<div class="region__switch">
								{CLOUD_REGIONS.map((r) => (
									<a
										class="region__opt"
										href={`https://${r.host}${path}`}
										aria-current={r.id === region ? 'page' : undefined}
										data-region={r.id}
										data-host={r.host}
									>
										{r.name}
									</a>
								))}
							</div>
						</nav>
					)
				)
			}
		</div>

		<div class="csl__social">
			{
				SOCIAL.map((s) => (
					<a
						class="csl__provider"
						href="#"
						onclick="return false"
						aria-label={`${verb} with ${s.name}`}
						data-label={`${verb} with ${s.name}`}
						data-method={s.name.toLowerCase()}
					>
						<span class="csl__mark" set:html={s.svg} />
						<span>{s.name}</span>
						{signin && (
							<span class="csl__last" aria-hidden="true" hidden>
								Last used
							</span>
						)}
					</a>
				))
			}
		</div>

		<div class="csl__or" role="separator" aria-label="or"><span>OR</span></div>

		<div class="csl__f">
			<div class="csl__box" data-method="email">
				<span class="material-icons csl__icon" aria-hidden="true">email</span>
				<label for={ids.email}>
					Email
					{/* The badge is for the eye; this is what a screen reader hears in its place. */}
					{
						signin && (
							<span class="csl__sr" data-csl-last-sr hidden>
								(last used)
							</span>
						)
					}
				</label>
				{
					signin && (
						<span class="csl__last" aria-hidden="true" hidden>
							Last used
						</span>
					)
				}
				<input
					id={ids.email}
					type="email"
					name="email"
					placeholder=" "
					autocomplete="email"
					required
					data-csl-input
					data-err={ids.emailErr}
				/>
			</div>
			<p class="csl__sub">
				<span class="csl__err" id={ids.emailErr} hidden>
					<span class="material-icons" aria-hidden="true">error</span><span data-csl-msg></span>
				</span>
			</p>
		</div>

		<div class="csl__f">
			<div class="csl__box">
				<span class="material-icons csl__icon" aria-hidden="true">lock</span>
				<label for={ids.password}>{signin ? 'Password' : 'Create a password'}</label>
				<input
					id={ids.password}
					type="password"
					name="password"
					placeholder=" "
					autocomplete={signin ? 'current-password' : 'new-password'}
					required
					minlength={signin ? undefined : 6}
					maxlength={signin ? undefined : 72}
					data-csl-input
					data-err={ids.passwordErr}
				/>
				<button type="button" class="csl__eye" aria-label="Show password" aria-pressed="false" data-csl-eye>
					<span class="material-icons" aria-hidden="true">visibility_off</span>
				</button>
			</div>
			<p class="csl__sub">
				<span class="csl__err" id={ids.passwordErr} hidden>
					<span class="material-icons" aria-hidden="true">error</span><span data-csl-msg></span>
				</span>
				{
					signin && (
						<a class="csl__forgot" href="#" onclick="return false">
							Forgot your password?
						</a>
					)
				}
			</p>
		</div>

		{
			!signin && (
				<p class="csl__terms">
					By selecting Sign up, I agree to the{' '}
					<a href="#" onclick="return false">
						Terms of Use
					</a>{' '}
					and acknowledge the{' '}
					<a href="#" onclick="return false">
						Privacy Policy
					</a>
				</p>
			)
		}

		<button type="submit" class="csl__submit">{verb}</button>

		<p class="csl__already">
			{signin ? 'Don’t have an account?' : 'Already have an account?'}
			<a class="csl__signin" href="#" onclick="return false">{signin ? 'Sign up' : 'Sign in'}</a>
		</p>
	</form>

	{/* Outside the form: its buttons are not the form's, and a dialog is not a field. */}
	<dialog class="rd" aria-labelledby={ids.dlgTitle} data-csl-dlg>
		<div class="rd__panel">
			<div class="rd__head">
				<h2 class="rd__title" id={ids.dlgTitle}>{helpLabel}</h2>
				<button type="button" class="rd__close" aria-label="Close" data-csl-close>
					<span class="material-icons" aria-hidden="true">close</span>
				</button>
			</div>
			{
				signin ? (
					<>
						<p class="rd__lead">
							Your account is in the region you signed up in. Each region is its own site, so an account in one can’t
							sign in to the other.
						</p>
						{CLOUD_REGIONS.map((r) => (
							<section class="rd__row" aria-labelledby={`${id}-ra-${r.id}`}>
								<div>
									<h3 class="rd__name" id={`${id}-ra-${r.id}`}>
										{r.name}
									</h3>
									<p class="rd__host">
										If you sign in at <b class="rd__url">{r.host}</b>
									</p>
								</div>
								<button
									type="button"
									class="rd__go"
									data-csl-go={r.id}
									data-name={r.name}
									aria-label={`Switch to ${r.name}`}
								>
									Switch
								</button>
							</section>
						))}
						<p class="rd__foot">
							Moving an account to the other region is a manual migration. Contact us if you need a hand.
						</p>
					</>
				) : (
					<>
						<p class="rd__lead">
							You can move to the other region later, but it’s a manual migration, so it’s worth choosing now.
						</p>
						{CLOUD_REGIONS.map((r) => (
							<section class="rd__region" aria-labelledby={`${id}-rd-${r.id}`}>
								<h3 class="rd__name" id={`${id}-rd-${r.id}`}>
									{r.name}
								</h3>
								<ul class="rd__points">
									{FACTS[r.id].map((p) => (
										<li>
											<span class="material-icons" aria-hidden="true">
												check
											</span>
											<span>{p.split(HOST_RE).map((part, i) => (i % 2 ? <b class="rd__url">{part}</b> : part))}</span>
										</li>
									))}
								</ul>
							</section>
						))}
						<p class="rd__foot">Both regions run on SOC 2- and ISO 27001-compliant infrastructure.</p>
					</>
				)
			}
		</div>
	</dialog>
</div>

<script>
	import { onLastUsed, readLastUsed, writeLastUsed } from '@root/pages/internal/_last-used';

	// Per instance, found by the root rather than by id, as `_RegionDialog` does: the sandbox stacks
	// directions, and the phone frame MOVES a direction into an empty body, so listeners on the
	// nodes survive it.

	// Each field's message, keyed by its `autocomplete`: the one attribute that already says which of
	// the three fields it is, sign-up's password and sign-in's being the same `name`.
	const MESSAGES: Record<string, (v: ValidityState) => string> = {
		email: (v) => (v.valueMissing ? 'Enter your email' : 'Enter a valid email, like name@example.com'),
		'new-password': (v) => (v.valueMissing ? 'Create a password' : 'Use at least 6 characters'),
		'current-password': () => 'Enter your password',
	};

	document.querySelectorAll<HTMLElement>('[data-csl]').forEach((root) => {
		const dlg = root.querySelector<HTMLDialogElement>('[data-csl-dlg]');
		// Sign-in's rows each switch the region. The current one says so and does nothing; it is
		// worked out as the dialog opens, because a switch may have happened since the page loaded.
		const goes = [...root.querySelectorAll<HTMLButtonElement>('[data-csl-go]')];
		const markCurrent = () =>
			goes.forEach((g) => {
				const here = g.dataset.cslGo === root.dataset.region;
				g.disabled = here;
				g.textContent = here ? 'Current' : 'Switch';
				g.setAttribute('aria-label', here ? `${g.dataset.name}, current region` : `Switch to ${g.dataset.name}`);
			});
		root.querySelector('[data-csl-help]')?.addEventListener('click', () => {
			markCurrent();
			dlg?.showModal();
		});
		goes.forEach((g) =>
			g.addEventListener('click', () => {
				dlg?.close();
				// The same path as choosing the segment, reload and all.
				root.querySelector<HTMLAnchorElement>(`.region__opt[data-region="${g.dataset.cslGo}"]`)?.click();
			})
		);
		root.querySelector('[data-csl-close]')?.addEventListener('click', () => dlg?.close());
		// The panel fills the dialog box, so a click on the dialog element itself is on the backdrop.
		dlg?.addEventListener('click', (e) => {
			if (e.target === dlg) dlg.close();
		});

		const eye = root.querySelector<HTMLButtonElement>('[data-csl-eye]');
		eye?.addEventListener('click', () => {
			const input = eye.parentElement?.querySelector('input');
			if (!input) return;
			// The name stays "Show password" and `aria-pressed` carries the state. Flipping both would
			// announce "Hide password, pressed".
			const show = input.type === 'password';
			input.type = show ? 'text' : 'password';
			eye.setAttribute('aria-pressed', String(show));
			eye.querySelector('.material-icons')!.textContent = show ? 'visibility' : 'visibility_off';
		});

		// The mock reload. In the product each segment is a plain link to the other host's `/signup`
		// with `location.search` appended; here the address bar shows that hop: the progress line
		// runs, the form dims as a page being replaced does, and the host swaps when it "arrives".
		const bar = root.querySelector<HTMLElement>('[data-csl-bar]');
		const opts = [...root.querySelectorAll<HTMLAnchorElement>('.region__opt')];
		let timer = 0;

		// `data-region` on the root is the page's host as far as the draft is concerned: the EU tab
		// reads it, so the tab arrives with the reload rather than on the click.
		const arrive = (opt: HTMLAnchorElement) => {
			opts.forEach((o) => (o === opt ? o.setAttribute('aria-current', 'page') : o.removeAttribute('aria-current')));
			root.dataset.region = opt.dataset.region;
			if (bar) bar.querySelector('[data-csl-host]')!.textContent = opt.dataset.host!;
		};

		opts.forEach((opt) =>
			opt.addEventListener('click', (e) => {
				// A modified or middle click is the visitor asking for a new tab or window: let the
				// browser have it, to the real host. Only a plain click is the draft's to fake.
				if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
				e.preventDefault();
				if (opt.hasAttribute('aria-current')) return;
				if (!bar) return arrive(opt);

				// The mock reload: the progress line runs, the form dims as a page being replaced
				// does, and the host swaps when it "arrives".
				clearTimeout(timer);
				root.classList.remove('is-loading');
				void root.offsetWidth; // restart the progress animation on a quick second switch
				root.classList.add('is-loading');
				bar.querySelector('[data-csl-reload]')!.textContent = 'close';
				timer = window.setTimeout(() => {
					arrive(opt);
					bar.querySelector('[data-csl-reload]')!.textContent = 'refresh';
					root.classList.remove('is-loading');
				}, 700);
			})
		);

		// The "Last used" badge, sign-in only. Each method's element carries `data-method`; the badge
		// inside it shows for the stored one. The provider's accessible name gains "(last used)", and
		// the email field's label gains it through a span the badge stands in for.
		const methods = [...root.querySelectorAll<HTMLElement>('[data-method]')];
		const paint = (last: string | null) => {
			if (root.dataset.mode !== 'signin') return;
			methods.forEach((el) => {
				const on = el.dataset.method === last;
				el.querySelector<HTMLElement>('.csl__last')!.hidden = !on;
				if (el.dataset.label) el.setAttribute('aria-label', el.dataset.label + (on ? ' (last used)' : ''));
			});
			root.querySelector<HTMLElement>('[data-csl-last-sr]')!.hidden = last !== 'email';
		};
		paint(readLastUsed('method') ?? root.dataset.demoLast ?? null);
		// The page's draft controls, and a card in another frame, write the same store: follow them.
		onLastUsed('method', paint);

		// Choosing a provider records it in either mode: a Google sign-up makes Google the method to
		// mark on the first sign-in. In the product this is written as the hand-off leaves.
		root
			.querySelectorAll<HTMLElement>('.csl__provider')
			.forEach((a) => a.addEventListener('click', () => writeLastUsed('method', a.dataset.method!)));

		const inputs = [...root.querySelectorAll<HTMLInputElement>('[data-csl-input]')];

		// Shows or clears one field's error. `aria-describedby` is set only while the message shows:
		// a description pointing at a hidden node is still read, and a valid field would sound broken.
		const check = (input: HTMLInputElement) => {
			const err = root.querySelector<HTMLElement>(`#${input.dataset.err}`);
			const bad = !input.validity.valid;
			input.setAttribute('aria-invalid', String(bad));
			if (err) {
				err.hidden = !bad;
				err.querySelector('[data-csl-msg]')!.textContent = bad ? MESSAGES[input.autocomplete](input.validity) : '';
			}
			if (bad) input.setAttribute('aria-describedby', input.dataset.err!);
			else input.removeAttribute('aria-describedby');
			return !bad;
		};

		inputs.forEach((input) => {
			// Not on the first pass through an empty field: tabbing past it is not a mistake yet.
			input.addEventListener('blur', () => {
				if (input.value || input.getAttribute('aria-invalid') === 'true') check(input);
			});
			// Once flagged, clear the moment it is fixed rather than on the next blur.
			input.addEventListener('input', () => {
				if (input.getAttribute('aria-invalid') === 'true') check(input);
			});
		});

		root.querySelector<HTMLFormElement>('[data-csl-form]')?.addEventListener('submit', (e) => {
			e.preventDefault();
			const results = inputs.map(check);
			if (results.every(Boolean)) writeLastUsed('method', 'email');
			else inputs[results.indexOf(false)]?.focus();
		});
	});
</script>

<style lang="scss">
	// The product's ground and type, not this site's, so nothing here reads the site tokens. The
