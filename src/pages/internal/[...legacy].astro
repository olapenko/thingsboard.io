---
/**
 * Where the internal pages used to live, sent to where they live now.
 *
 * On FE-handoff the chrome was spread over three menus: the header under Flows ("main menu"), the
 * footer under Sections, the cookie notice and the chat under Flows. They are one area here,
 * `/internal/chrome/`. The homepage areas — Homepages, Components, Flows — and the Type and UI
 * library pages return with the Home layer; their old addresses land on the hub until then.
 *
 * Kept here rather than in the site's redirect table because none of this is production: the whole
 * file can go once nobody has the old links bookmarked. Static routes win over a rest route, so
 * this never shadows a real page.
 */
export function getStaticPaths() {
	const to = (legacy: string, target: string) => ({ params: { legacy }, props: { target } });
	return [
		// The chrome, gathered
		to('flows/main-menu', '/internal/chrome/header/'),
		to('sections/footer', '/internal/chrome/footer/'),
		to('flows/cookie-notice', '/internal/chrome/cookie-notice/'),
		to('flows/chat-widget', '/internal/chrome/chat/'),
		// The homepage areas, until the Home layer
		to('homepages', '/internal/'),
		to('components', '/internal/'),
		to('sections', '/internal/'),
		to('flows', '/internal/'),
		to('launch-visuals', '/internal/'),
		to('library', '/internal/design-system/'),
		to('library/type', '/internal/design-system/'),
		to('library/ui', '/internal/design-system/'),
		to('library/cards', '/internal/design-system/'),
	];
}

const { target } = Astro.props;
return Astro.redirect(target, 301);
---
