---
/**
 * Where the internal pages used to live, sent to where they live now.
 *
 * On FE-handoff the chrome was spread over three menus: the header under Flows ("main menu"), the
 * footer under Sections, the cookie notice and the chat under Flows. They are one area here,
 * `/internal/chrome/`. Homepages is back at its own address. Components and Flows are still to be
 * rebuilt; their old addresses land on the hub until then.
 *
 * The library pages are the Design system's now, under its own address: the kit page split into
 * Foundations and Components (an old `#colour`-style anchor is sent on by the Components page, which
 * the kit's address lands on), Type and the UI inventory back as Type and Inventory. The ecosystem
 * cards page was the homepage's ecosystem section in a gallery, not part of the system, and was not
 * brought back: its address lands on the inventory's cards, where the ecosystem cards are, as they
 * ship.
 *
 * Kept here rather than in the site's redirect table because none of this is production: the whole
 * file can go once nobody has the old links bookmarked. Static routes win over a rest route, so
 * this never shadows a real page.
 */
export function getStaticPaths() {
	const to = (legacy: string, target: string) => ({ params: { legacy }, props: { target } });
	return [
		// The chrome, gathered
		to('flows/main-menu', '/internal/chrome/header/'),
		to('sections/footer', '/internal/chrome/footer/'),
		to('flows/cookie-notice', '/internal/chrome/cookie-notice/'),
		to('flows/chat-widget', '/internal/chrome/chat/'),
		// The homepage areas still to be rebuilt
		to('components', '/internal/'),
		to('sections', '/internal/'),
		to('flows', '/internal/'),
		to('launch-visuals', '/internal/'),
		// The library, now the Design system
		to('library', '/internal/design-system/'),
		to('library/kit', '/internal/design-system/components/'),
		to('library/type', '/internal/design-system/type/'),
		to('library/ui', '/internal/design-system/inventory/'),
		to('library/cards', '/internal/design-system/inventory/#kind-card'),
	];
}

const { target } = Astro.props;
return Astro.redirect(target, 301);
---
