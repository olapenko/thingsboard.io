---
import { KEY_VISUALS, visualHref } from '@root/pages/internal/_key-visuals';

/**
 * Where the internal pages used to live, sent to where they live now.
 *
 * `/internal/launch-visuals/` became `/internal/sections/`, and the two pages about pieces rather
 * than the page — the ecosystem cards and the type scale — moved under `/internal/library/`.
 * `/internal/` itself had no page and now opens the hub. Kept here rather than in the site's
 * redirect table because none of this is production: the whole file can go once nobody has the
 * old links bookmarked.
 *
 * The flows moved out of Sections into their own menu, `/internal/flows/`, and the CLI check was
 * retired; their old addresses land on the new page or the hub. `try-for-free` and `cloud-auth` were
 * earlier names for the flows.
 *
 * Static routes win over a rest route, so this never shadows a real page.
 */
export function getStaticPaths() {
	const to = (legacy: string | undefined, target: string) => ({ params: { legacy }, props: { target } });
	return [
		to(undefined, '/internal/components/'),
		to('launch-visuals', '/internal/sections/'),
		...KEY_VISUALS.map((v) => to(`launch-visuals/${v.id}`, visualHref(v))),
		...KEY_VISUALS.filter((v) => v.area === 'flows').map((v) => to(`sections/${v.id}`, visualHref(v))),
		// The Sections hub became Components › Overview; section pages kept their addresses.
		to('sections', '/internal/components/'),
		to('sections/cli', '/internal/components/'),
		to('sections/try-for-free', '/internal/flows/sign-up/'),
		to('sections/cloud-auth', '/internal/flows/sign-up/'),
		to('ecosystem-cards', '/internal/library/cards/'),
		to('typography', '/internal/library/type/'),
	];
}

const { target } = Astro.props;
return Astro.redirect(target, 301);
---
