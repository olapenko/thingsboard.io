---
/**
 * Cloud's top-ups for the conservative pricing draft (`./pricing.astro`): main's two columns of
 * packs, each one a row that opens on what it adds. Native `<details>`, so it needs no script.
 * Markup only; the rules are the page's.
 *
 * Underscore-prefixed so Astro does not make it a route.
 */
import { Icon } from 'astro-icon/components';
import type { TopUpGroup } from '@data/pricing-live/types';

interface Props {
	groups: TopUpGroup[];
}

const { groups } = Astro.props;
---

<div class="topup-cols">
	{
		groups.map((group) => (
			<div class="topup-col">
				<h3 class="topup-col__title">{group.title}</h3>
				<div class="topup-col__list">
					{group.items.map((item) => (
						<details class="topup">
							<summary>
								<span class="topup__name">{item.name}</span>
								<span class="topup__price">
									<strong>{typeof item.priceUsd === 'string' ? item.priceUsd : `$${item.priceUsd}`}</strong>
									{item.period && <span> {item.period}</span>}
								</span>
								<Icon name="tabler:chevron-down" class="topup__chevron" aria-hidden="true" />
							</summary>
							{item.details && (
								<dl class="topup__details">
									{item.details.map((d) => (
										<div>
											<dt>{d.label}</dt>
											<dd>{d.value}</dd>
										</div>
									))}
								</dl>
							)}
						</details>
					))}
				</div>
			</div>
		))
	}
</div>
