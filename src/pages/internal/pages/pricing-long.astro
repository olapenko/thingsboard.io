			margin-top: 2px;
			color: $color-brand;
		}
	}

	// The product pages' benefit tiles, four across under the card: a rule over each, no box.
	.benefit-grid--four {
		grid-template-columns: repeat(4, minmax(0, 1fr));
		margin-top: $spacing-12;

		@include media-down(lg) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		@include media-down(md) {
			grid-template-columns: minmax(0, 1fr);
		}

		.benefit-card__icon {
			color: $color-brand;
		}
	}

	// ---------------------------------------------------------------------------------------------
	// ADD-ONS AND TOP-UPS, on the tint the product pages give their shared-features band.
	// ---------------------------------------------------------------------------------------------
	.addons {
		padding-top: $spacing-16;
		padding-bottom: $spacing-20;
		background-color: #f5f6ff;

		@include media-down(md) {
			padding-top: $spacing-10;
			padding-bottom: $spacing-12;
		}

		.section-header {
			margin-bottom: $spacing-10;
		}
	}

	.addons__topups {
		margin-top: $spacing-16;
	}

	.addon-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: $spacing-5;
		max-width: 960px;
		margin: 0 auto;
		padding: 0;
		list-style: none;

		@include media-down(lg) {
			grid-template-columns: minmax(0, 1fr);
			max-width: 560px;
		}
	}

	.addon-tile {
		display: flex;
		align-items: flex-start;
		gap: $spacing-4;
		margin: 0;
		padding: $spacing-6 $spacing-5;
		border-radius: 16px;
		background-color: #fff;
		box-shadow:
			0 1px 2px rgba(var(--color-shadow-ui-rgb, 16, 24, 40), 0.06),
			0 6px 14px -6px rgba(var(--color-shadow-ui-rgb, 16, 24, 40), 0.18);

		// The ecosystem card's filled badge, to its numbers: 32% radius, the product's accent under
		// the cards' static sheen, the mark at 82% of the tile.
		&__mark {
			display: grid;
			flex: none;
			place-items: center;
			width: 48px;
			height: 48px;
			border-radius: 32%;
			background-color: var(--addon-accent);
			background-image: linear-gradient(150deg, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0) 62%);
			color: #fff;
		}

		&__glyph {
			width: 82%;
			height: auto;
		}

		&__icon {
			width: 26px;
			height: 26px;
		}

		&__body {
			min-width: 0;
		}

		&__name {
			@include type-tile;
			margin: 2px 0 0;
			color: var(--color-text);
		}

		&__desc {
			@include type-small;
			margin: $spacing-1 0 0;
			color: var(--color-text-secondary);
		}

		&__price {
			@include type-small-strong;
			display: flex;
			flex-direction: column;
			margin: $spacing-3 0 0;
			color: var(--color-text);

			a {
				color: $color-brand;
				text-decoration: underline;
				text-underline-offset: 3px;
			}
		}

		&__fee {
			@include type-small;
			color: var(--color-text-secondary);
		}
	}

	.topup-groups {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: $spacing-10 $spacing-12;
		max-width: 960px;
		margin: 0 auto;

		@include media-down(lg) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.topup-list {
		margin: 0;
	}

	// The product pages' term-and-value row, with the price held to its own right-hand column.
	.topup-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		grid-template-areas:
			'name price'
			'adds price';
		column-gap: $spacing-4;
		padding: $spacing-3 0;
		border-bottom: 1px solid rgba(15, 23, 42, 0.08);

		dt {
			@include type-body;
			grid-area: name;
			font-weight: $font-weight-medium;
			color: var(--color-text);
		}

		&__adds {
			@include type-small;
			grid-area: adds;
			margin: 0;
			color: var(--color-text-secondary);
		}

		&__price {
			@include type-body;
			grid-area: price;
			align-self: center;
			margin: 0;
			font-weight: $font-weight-bold;
			color: var(--color-text);
			white-space: nowrap;
			text-align: right;

			span {
				@include type-small;
				font-weight: $font-weight-normal;
				color: var(--color-text-secondary);
			}
		}
	}

	// ---------------------------------------------------------------------------------------------
	// PRIVATE CLOUD, PLAN BY PLAN: the product pages' matrix, four plan columns in place of two.
	// ---------------------------------------------------------------------------------------------
	#matrix {
		--matrix-band: #fff;
	}

	// Four value columns share what two had, so the label column gives some back.
	.matrix--plans {
		tbody th[scope='row'] {
			width: 32%;
		}

		td {
			text-align: center;
		}

		thead th:not(:first-child) .matrix__col {
			justify-content: center;
		}

		@media (max-width: 879px) {
			td {
				text-align: left;
			}
		}
	}

	.matrix__yes {
		display: inline-flex;

		svg {
			width: 20px;
			height: 20px;
			color: $color-brand;
		}
	}

	// ---------------------------------------------------------------------------------------------
	// THE DECISION BAND, three cards where the product pages have two.
	// ---------------------------------------------------------------------------------------------
	.choice-grid--three {
		grid-template-columns: repeat(3, minmax(0, 1fr));

		@include media-down(lg) {
			grid-template-columns: minmax(0, 1fr);
			max-width: 560px;
		}

		.choice-card {
			padding: $spacing-6;
		}

		// A card's title at the card step: at the two-card band's 32, "Private Cloud" and its mark
		// overrun a third of the measure.
		.choice-card__name {
			@include type-card;
		}

		// Stacked in all three. Side by side, a third of the measure fits "Contact us" and "See plans"
		// on one line but not "Start for free" or "Install for free", so the three cards ended on
		// three different shapes.
		.choice-card__actions {
			flex-direction: column;
			align-items: stretch;
			gap: $spacing-3;
		}

		.choice-card__cta {
			justify-content: center;
		}

		.choice-card__plans {
			align-self: center;
		}
	}

	// ---------------------------------------------------------------------------------------------
	// FAQ: one block per deployment, only the one on screen shown.
	// ---------------------------------------------------------------------------------------------
	.faq-block .section-header {
		margin-bottom: $spacing-10;
	}

	// The bookend's note is a caption and a link, as the footer has it.
	.page-closing__note a {
		margin-left: $spacing-1;
	}
</style>
