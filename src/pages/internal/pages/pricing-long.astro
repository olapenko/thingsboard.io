	}

	.plans__controls {
		display: flex;
		justify-content: center;
		margin-bottom: $spacing-10;
	}

	// THE SEGMENTED PILL. One control for region, billing period and licence model, where main has a
	// different toggle for each. A group of pressed buttons rather than radios: each sets a view, and
	// nothing is submitted.
	.seg {
		display: inline-flex;
		gap: $spacing-1;
		padding: $spacing-1;
		border-radius: $radius-full;
		background-color: rgba(15, 23, 42, 0.06);
	}

	.seg__opt {
		@include type-small-strong;
		display: inline-flex;
		align-items: center;
		gap: $spacing-2;
		height: 36px;
		padding: 0 $spacing-4;
		border: 0;
		border-radius: $radius-full;
		background: none;
		color: var(--color-text-secondary);
		white-space: nowrap;
		cursor: pointer;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;

		&:hover {
			color: var(--color-text);
		}

		&:focus-visible {
			outline: 2px solid $color-brand;
