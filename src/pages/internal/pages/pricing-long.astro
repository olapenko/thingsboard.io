				<a class="page-closing__primary" href={pricingClosing.primary.href} {...pricingClosing.primary.attrs}>
					<Icon name="tabler:cloud-filled" aria-hidden="true" />
					{pricingClosing.primary.text}
				</a>
				<a class="page-closing__secondary" href={pricingClosing.secondary.href}>
					<Icon name="tabler:message-circle" aria-hidden="true" />
					{pricingClosing.secondary.text}
				</a>
			</div>
			<p class="page-closing__note">
				{FOOTER_LICENSE_PORTAL.caption}
				<a href={FOOTER_LICENSE_PORTAL.href}>{FOOTER_LICENSE_PORTAL.label}</a>
			</p>
		</div>
	</section>
	{
		/* TEMP-INTERNAL-NAV — remove before this branch reaches main, with the homepage's.
	    The internal switcher, so this page can be reached from the sandbox and back. It is NOT
	    production chrome: the page is shown as it ships, with only the island over it.

	    To remove: `grep -rln TEMP-INTERNAL-NAV src/pages` and delete both hits in each file. */
	}
	<InternalNav />
</BaseLayout>

<script>
	// The FAQ tab sets, one per deployment — see `util/faq-tabs.ts`.
	import { mountFaqTabs } from '@util/faq-tabs';

	mountFaqTabs();

	const root = document.documentElement;
	const onPage = () => !!document.querySelector('[data-pricing-draft]');
	const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	/** Under the fixed bar, with the same air the FAQ sidebar keeps from it. */
	function scrollToElement(el: Element) {
		const bar = parseFloat(getComputedStyle(root).getPropertyValue('--home-header-h')) || 64;
		const top = el.getBoundingClientRect().top + window.scrollY - bar - 24;
		window.scrollTo({ top, behavior: reducedMotion() ? 'auto' : 'smooth' });
	}

	/** The address follows the view, so a link copied from here opens on what you were reading. */
	function updateUrl(edit: (params: URLSearchParams) => void) {
		const url = new URL(location.href);
		edit(url.searchParams);
		history.replaceState(history.state, '', url);
	}

	/** Every segmented control's pressed state, from the <html> attribute it writes. */
	function syncSegments() {
		document.querySelectorAll<HTMLElement>('[data-seg]').forEach((group) => {
			const value = root.dataset[group.dataset.seg!];
			group.querySelectorAll<HTMLButtonElement>('.seg__opt').forEach((opt) => {
				opt.setAttribute('aria-pressed', String(opt.dataset.value === value));
			});
		});
	}

	function selectDeploy(id: string, { focus = false, scroll = false } = {}) {
		root.dataset.deploy = id;
		const caption = document.querySelector<HTMLElement>('[data-deploy-caption]');
		document.querySelectorAll<HTMLButtonElement>('[data-deploy-tab]').forEach((tab) => {
			const on = tab.dataset.deployTab === id;
			tab.classList.toggle('is-active', on);
			tab.setAttribute('aria-selected', String(on));
			tab.tabIndex = on ? 0 : -1;
			if (!on) return;
			if (caption) caption.textContent = tab.dataset.caption ?? '';
			if (focus) tab.focus();
		});

		// Main's `?section=` is dropped once read; `?solution=` only means anything on-prem.
		updateUrl((params) => {
			params.set('product', id);
			params.delete('section');
			if (id !== 'thingsboard-pe') params.delete('solution');
		});

		if (scroll) {
			const plans = document.getElementById('plans');
			if (plans) scrollToElement(plans);
		}
	}

	// Delegated once, on the document: the site swaps the body between pages, and these keep working
	// on whatever body is in.
	document.addEventListener('click', (event) => {
		const target = event.target as Element | null;
		if (!target || !onPage()) return;

		const tab = target.closest<HTMLButtonElement>('[data-deploy-tab]');
		if (tab) {
			selectDeploy(tab.dataset.deployTab!);
			return;
		}

		const go = target.closest<HTMLAnchorElement>('[data-deploy-go]');
		if (go) {
			event.preventDefault();
			selectDeploy(go.dataset.deployGo!, { scroll: true });
			return;
		}

		const opt = target.closest<HTMLButtonElement>('[data-seg] .seg__opt');
		if (opt) {
			const key = opt.closest<HTMLElement>('[data-seg]')!.dataset.seg!;
			root.dataset[key] = opt.dataset.value;
			syncSegments();
			if (key === 'onpremBilling') {
				updateUrl((params) => {
					if (opt.dataset.value === 'perpetual') params.set('solution', 'pe-perpetual');
					else params.delete('solution');
				});
			}
			return;
		}

		// A plan line that quotes an answer opens it: its topic selected, "More questions" opened
		// if it is past the first six, the answer itself expanded, and scrolled to under the bar.
		const term = target.closest<HTMLAnchorElement>('[data-faq-link]');
		if (term) {
			const answer = document.getElementById(term.hash.slice(1)) as HTMLDetailsElement | null;
			if (!answer) return;
			event.preventDefault();
			const panel = answer.closest<HTMLElement>('.faq-panel');
			if (panel?.hidden) document.getElementById(panel.getAttribute('aria-labelledby') ?? '')?.click();
			if (panel && answer.classList.contains('faq-item--extra') && !panel.classList.contains('is-expanded')) {
				panel.querySelector<HTMLButtonElement>('.faq-more')?.click();
			}
			answer.open = true;
			scrollToElement(answer);
			answer.querySelector('summary')?.focus({ preventScroll: true });
		}
	});

	// The deployment switch is a tab set: arrows move along it, Home and End to its ends.
	document.addEventListener('keydown', (event) => {
		const tab = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-deploy-tab]');
		if (!tab) return;
		const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-deploy-tab]'));
		const i = tabs.indexOf(tab);
		const moves: Record<string, number> = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 };
		let next = -1;
		if (event.key === 'Home') next = 0;
		else if (event.key === 'End') next = tabs.length - 1;
		else if (moves[event.key]) next = (i + moves[event.key] + tabs.length) % tabs.length;
		if (next < 0) return;
		event.preventDefault();
		selectDeploy(tabs[next].dataset.deployTab!, { focus: true });
	});

	// The controls are rendered on their defaults; the pre-paint script may have chosen otherwise.
	function init() {
		if (onPage()) syncSegments();
	}

	init();
	document.addEventListener('astro:page-load', init);
</script>

<style is:global lang="scss">
	@use '../../../styles/variables' as *;
	// The Cloud and On-premises pages' every rule: the hero, the bands' rhythm, the comparison table,
	// the decision band, the FAQ and the bookend. What follows is only what pricing adds to them.
	@use '../../../styles/product-page';

	// ---------------------------------------------------------------------------------------------
	// WHICH BLOCKS SHOW. The state is on <html>, written before paint (see the hero's script); with
	// no script at all the attributes never arrive and the defaults below hold: Cloud, North America,
	// monthly, subscription.
	// ---------------------------------------------------------------------------------------------
	$deployments: thingsboard-cloud, thingsboard-private-cloud, thingsboard-pe;

	[data-deploy-panel]:not([data-deploy-panel='thingsboard-cloud']),
	[data-region-show='eu'],
	[data-billing-show='annual'],
	[data-onprem-show='perpetual'] {
		display: none;
	}

	html[data-deploy] [data-deploy-panel] {
		display: none;
	}

	@each $id in $deployments {
		html[data-deploy='#{$id}'] [data-deploy-panel='#{$id}'] {
			display: block;
		}
	}

	html[data-cloud-region='eu'] {
		[data-region-show='us'] {
			display: none;
		}

		[data-region-show='eu'] {
			display: block;
		}
	}

	html[data-pc-billing='annual'] {
		[data-billing-show='monthly'] {
			display: none;
		}

		[data-billing-show='annual'] {
			display: inline;
		}
	}

	html[data-onprem-billing='perpetual'] {
		[data-onprem-show='payg'] {
			display: none;
		}

		[data-onprem-show='perpetual'] {
			display: block;
		}
	}

	// ---------------------------------------------------------------------------------------------
	// THE HERO: the page's mark, and the deployment switch where the product pages put two buttons.
	// ---------------------------------------------------------------------------------------------
	// A Tabler outline in the squircle rather than a product mark: Pricing is no product, and the
	// tag is the glyph the footer and the menus already give it. 55% of the tile — the outline's
	// own padding reads larger than the filled marks do at 82%.
	.hero-mark__icon {
		width: 55%;
		height: 55%;
		color: #fff;
	}

	// The switch: the segmented pill the plans' controls use below, in its dark dress. Slotted, so
	// Hero's reveal never reaches it — restated after the subtitle, as `.hero-caption` does it.
	.deploy-switch,
	.deploy-caption {
		opacity: 0;
		transform: translate3d(0, 45px, 0);
		animation: slideup-in 600ms cubic-bezier(0.25, 0.46, 0.45, 0.94) 900ms forwards;

		@media (prefers-reduced-motion: reduce) {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}

	.deploy-switch {
		display: inline-flex;
		gap: $spacing-1;
		margin-top: $spacing-8;
		padding: $spacing-1;
		border-radius: $radius-full;
		background-color: rgba(255, 255, 255, 0.08);

		@include media-down(md) {
			display: flex;
			align-self: stretch;
			width: 100%;
			max-width: 480px;
			margin-inline: auto;
		}
	}

	.deploy-switch__tab {
		@include type-button;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: $spacing-2;
		height: 44px;
		padding: 0 $spacing-5;
		border: 0;
		border-radius: $radius-full;
		background: none;
		color: rgba(255, 255, 255, 0.72);
		white-space: nowrap;
		cursor: pointer;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;

		svg {
			flex: none;
			width: 20px;
			height: 20px;
		}

		&:hover {
			background-color: rgba(255, 255, 255, 0.08);
			color: #fff;
		}

		&:focus-visible {
			outline: 2px solid #fff;
			outline-offset: 2px;
		}

		// The selected one turns over to white, its glyph in the primary: the one solid thing on the
		// ground, which is what a selection on a dark field has to be.
		&.is-active {
			background-color: #fff;
			color: var(--color-text, #17181c);

			svg {
				color: $color-brand;
			}
		}

		// Three across a phone: the glyphs go, and the names share the width evenly.
		@include media-down(md) {
			flex: 1 1 0;
			min-width: 0;
			padding: 0 $spacing-2;
			font-size: $font-size-sm;

			svg {
				display: none;
			}
		}
	}

	.deploy-caption {
		@include type-small;
		max-width: 52ch;
		min-height: 44px;
		margin: $spacing-4 auto 0;
		color: rgba(255, 255, 255, 0.72);
