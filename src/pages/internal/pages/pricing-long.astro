---
// TEMP-INTERNAL-NAV
import InternalNav from '@root/pages/internal/_InternalNav.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import Band from '@components/ui/Band.astro';
import Button from '@components/ui/Button.astro';
import Card from '@components/ui/Card.astro';
import Link from '@components/ui/Link.astro';
import Mark from '@components/ui/Mark.astro';
import Segmented from '@components/ui/Segmented.astro';
import Tabs from '@components/ui/Tabs.astro';
import BenefitGrid from '@components/Landing/BenefitGrid.astro';
import Bookend from '@components/Landing/Bookend.astro';
import ChoiceBand from '@components/Landing/ChoiceBand.astro';
import ProductMatrix from '@components/Landing/ProductMatrix.astro';
import ProductFaq from '@components/Landing/ProductFaq.astro';

import Hero from '@components/Landing/Hero.astro';
import SectionHeader from '@components/Landing/SectionHeader.astro';
import { buildFaqPageSchema } from '@util/faq-schema';
import { CLOUD_REGIONS, LAST_REGION } from '@util/cloud-regions';

import PricingPlans from './_PricingPlans.astro';
import PricingAddOns from './_PricingAddOns.astro';
import PricingTopUps from './_PricingTopUps.astro';

import { tbCloudData, tbCloudTopUps } from '@data/pricing-live/tb-cloud';
import { tbPrivateCloudData, tbPrivateCloudAddOns } from '@data/pricing-live/tb-private-cloud';
import {
	tbPerpetualAddOns,
	tbPerpetualHero,
	tbSelfManagedAddOns,
	tbSelfManagedData,
} from '@data/pricing-live/tb-self-managed';
import { cloudAddOns } from '@data/pricing-live/add-ons';
import { pcFeatureHeaders, pcFeatureRows } from '@data/pricing-live/tb-private-cloud-features';
import { pricingFaqData } from '@data/pricing-live/faq';
import {
	DEFAULT_DEPLOYMENT,
	DEPLOYMENTS,
	onPremPerpetual,
	pricingChoice,
	pricingClosing,
	pricingHero,
	type DeploymentId,
} from '@data/pricingPage';

/**
 * THE LONG VERSION, kept for comparison: the first pricing draft, which reshaped the page as well
 * as restyling it. Judged too long and too designed on 2026-10-01; the draft that carries on is
 * `./pricing.astro`, main's structure in the new styles. Listed under it in the island's Pages menu.
 *
 * PRICING, DRAFTED IN THE PRODUCT PAGES' LANGUAGE. Not a route that ships: `/pricing/` keeps the
 * page it has until this replaces it.
 *
 * The frame is the Cloud and On-premises pages', piece for piece, on the UI kit: the dark centred
 * hero with its `Mark` (`_product-page.scss`), white and tinted `Band`s under `SectionHeader`, the
 * comparison (`ProductMatrix`), the dark decision band (`ChoiceBand`), the FAQ (`ProductFaq`), the
 * light bookend (`Bookend id="pricing"`), and the footer that maps the platform. The deployment
 * switch is `ui/Tabs`, every other choice a `ui/Segmented`.
 *
 * What is the pricing page's own:
 *
 *   - THE DEPLOYMENT SWITCH IS THE HERO'S ACTION. A pricing page asks one thing first — which way
 *     you run it — so the hero carries that choice where the product pages carry their two buttons,
 *     and everything under it (plans, add-ons, comparison, FAQ) follows it. Main's sub-tabs did the
 *     same job from a row of their own under the title.
 *   - ONE CONTROL FOR EVERY OTHER CHOICE. Region, monthly or annual, subscription or perpetual: the
 *     same segmented pill, on the light ground, centred under the plans' heading. Main has a
 *     different toggle for each.
 *   - THE PLANS ARE CARDS ON WHITE, lifted on the homepage's UI shadow with no stroke, as the
 *     contact page's cards are. The popular one is ringed in the primary and is the only filled
 *     button in its row. Five across wants more than the 960 measure, so Cloud's plans take the
 *     1200 the homepage keeps for its two-column rows; everything else stays on 960.
 *   - TERMS LINK TO THEIR ANSWER. Main explains "1M data points/mo" in a hover tooltip; here the
 *     line links to the FAQ answer it was quoting, which a phone and a keyboard can reach.
 *   - THE DECISION BAND COMPARES ALL THREE DEPLOYMENTS, with an entry price, three reasons and a way
 *     in each. Its "See plans" switches the page and returns to the plans.
 *
 * Not ported, on purpose for a draft: the two calculators (Private Cloud's and On-premises' open
 * from "Not sure which plan fits?", which here goes to a person), the GTM ids on every CTA (an
 * internal page would only add noise to the funnel), and `getLicense()`'s UTM and referral
 * parameters (`licenseSignup` in the data file states the plain address).
 */

// Answers shown per topic before "More questions", as the product pages show six.
const FAQ_VISIBLE = 6;

const faqFor = (id: DeploymentId) => {
	const faq = pricingFaqData.find((f) => f.contextId === id);
	if (!faq) throw new Error(`pricing draft: main's FAQ has no "${id}" context`);
	return faq;
};

/** Every answer id per deployment, so a plan line can link to its own FAQ and to no other. */
const answerIds = new Map<DeploymentId, Set<string>>(
	DEPLOYMENTS.map((d) => [d.id, new Set(faqFor(d.id).categories.flatMap((c) => c.items.map((i) => i.id)))])
);

const faqPrefix = (id: DeploymentId) => `faq-${id}-`;

// Main's one-FAQPage-per-page rule, kept: the default deployment's answers, all of them.
const faqPageSchema = buildFaqPageSchema(faqFor(DEFAULT_DEPLOYMENT).categories);

// The data says `na`, the region module says `us`; the switch speaks the module's.
const cloudPlans = { us: tbCloudData.na.plans, eu: tbCloudData.eu.plans };
const cloudExtras = {
	us: { addOns: cloudAddOns.na, topUps: tbCloudTopUps.na },
	eu: { addOns: cloudAddOns.eu, topUps: tbCloudTopUps.eu },
};

const [cloud, privateCloud, onPrem] = DEPLOYMENTS;
const CONTACT_PRIVATE_CLOUD = privateCloud.choice.cta.href;
const CONTACT_ON_PREM =
	'/contact-us/?subject=ThingsBoard%20Products&message=I%20have%20a%20question%20about%20ThingsBoard%20On-premises';

/** What the pre-paint script needs, and nothing else. */
const prepaint = {
	ids: DEPLOYMENTS.map((d) => d.id),
	fallback: DEFAULT_DEPLOYMENT,
	regionKey: LAST_REGION.key,
};

const addOnsSubtitle = 'Customize your deployment with optional features to suit your business needs.';
---

<BaseLayout
	headerVariant="transparent"
	forceLightTheme
	footer="map"
	noIndex
	noCanonical
	title="Pricing (long draft)"
	description="ThingsBoard IoT Platform pricing — compare On-premises, ThingsBoard Cloud and Private Cloud plans with transparent subscription and perpetual licensing."
	jsonLd={faqPageSchema}
>
	<Hero
		title={pricingHero.title}
		subtitle={pricingHero.subtitle}
		achievement={null}
		buttons={[]}
		layout="split"
		panel={false}
		showArrow={false}
	>
		{/* The page's mark: the tag the footer and the menus give Pricing, on the primary's squircle. */}
		<Mark slot="kicker" size={{ base: 64, md: 88 }} icon="tabler:tag" class="hero-mark" />

		<Tabs
			label="How you run ThingsBoard"
			class="deploy-switch"
			size={{ base: 'sm', sm: 'md' }}
			selected={DEPLOYMENTS.findIndex((d) => d.id === DEFAULT_DEPLOYMENT)}
			items={DEPLOYMENTS.map((d) => ({ label: d.name, icon: d.icon, panel: `plans-${d.id}` }))}
		/>
		<p
			class="deploy-caption"
			data-deploy-caption
			data-captions={JSON.stringify(Object.fromEntries(DEPLOYMENTS.map((d) => [d.id, d.caption])))}
		>
			{DEPLOYMENTS.find((d) => d.id === DEFAULT_DEPLOYMENT)!.caption}
		</p>

		{
			/* Before paint: the deployment from `?product=` (main's ids, and its legacy `?section=`),
		    On-premises' billing from `?solution=`, and Cloud's region from the one the visitor last
		    signed up or in with, else the nearest by timezone — `util/cloud-regions`, restated, since an
		    inline script cannot import it. The state lives on <html>, and the CSS shows the matching
		    blocks, so the page never paints Cloud first and then swaps. */
		}
		<script is:inline define:vars={{ prepaint }}>
			(function () {
				var root = document.documentElement;
				var p = new URLSearchParams(location.search);
				var deploy = p.get('product');
				if (prepaint.ids.indexOf(deploy) === -1) {
					deploy = p.get('section') === 'thingsboard-pe-options' ? 'thingsboard-pe' : prepaint.fallback;
				}
				var solution = (p.get('solution') || '').replace(/^pe-/, '');
				var region = null;
				try {
					region = localStorage.getItem(prepaint.regionKey);
				} catch (e) {
					// No storage: fall through to the timezone.
				}
				if (region !== 'us' && region !== 'eu') {
					var tz = '';
					try {
						tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
					} catch (e) {
						// No Intl: North America, where the site sent everyone before it asked.
					}
					region = /^(Europe|Africa|Atlantic)\//.test(tz) ? 'eu' : 'us';
				}
				root.dataset.deploy = deploy;
				root.dataset.cloudRegion = region;
				root.dataset.pcBilling = 'monthly';
				root.dataset.onpremBilling = solution === 'perpetual' ? 'perpetual' : 'payg';

				// The tab set (`ui/Tabs`): the chosen tab, its tab stop and the thumb; and its caption.
				var here = document.currentScript.parentElement;
				var list = here.querySelector('.deploy-switch');
				var caption = here.querySelector('[data-deploy-caption]');
				list.querySelectorAll('[role="tab"]').forEach(function (tab, i) {
					var on = tab.id === 'plans-' + deploy + '-tab';
					tab.setAttribute('aria-selected', on ? 'true' : 'false');
					tab.tabIndex = on ? 0 : -1;
					if (on) list.style.setProperty('--seg-index', i);
				});
				if (caption) caption.textContent = JSON.parse(caption.dataset.captions)[deploy];
			})();
		</script>
	</Hero>

	<div class="pricing-draft" data-pricing-draft>
		{/* ─── Plans ─────────────────────────────────────────────────────────────────────────── */}
		<Band id="plans" pad={{ top: 'md', bottom: 'lg' }} measure="full" class="plans" innerClass="plans__inner">
			{/* Cloud */}
			<div
				id="plans-thingsboard-cloud"
				role="tabpanel"
				aria-labelledby="plans-thingsboard-cloud-tab"
				data-deploy-panel="thingsboard-cloud"
			>
				<SectionHeader
					title={cloud.title}
					subtitle={cloud.subtitle}
					titleSize="title"
					subtitleMeasure="copy"
					spacing="sm"
				/>
				<div class="plans__controls">
					<Segmented
						size="sm"
						label="Cloud region"
						name="cloudRegion"
						options={CLOUD_REGIONS.map((r) => ({ label: r.name, value: r.id }))}
					/>
				</div>
				{
					CLOUD_REGIONS.map((r) => (
						<div data-region-show={r.id}>
							<PricingPlans
								plans={cloudPlans[r.id]}
								answers={answerIds.get('thingsboard-cloud')}
								faqPrefix={faqPrefix('thingsboard-cloud')}
							/>
						</div>
					))
				}
				<p class="plans__note">
					<Icon name="tabler:cloud-lock" class="plans__note-mark" aria-hidden="true" />
					Require dedicated infrastructure for unique enterprise needs?
					<Link
						variant="inline"
						href="?product=thingsboard-private-cloud#plans"
						attrs={{ 'data-deploy-go': 'thingsboard-private-cloud' }}
					>
						See Private Cloud plans
					</Link>
				</p>
			</div>

			{/* Private Cloud */}
			<div
				id="plans-thingsboard-private-cloud"
				role="tabpanel"
				aria-labelledby="plans-thingsboard-private-cloud-tab"
				data-deploy-panel="thingsboard-private-cloud"
			>
				<SectionHeader
					title={privateCloud.title}
					subtitle={privateCloud.subtitle}
					titleSize="title"
					subtitleMeasure="copy"
					spacing="sm"
				/>
				<div class="plans__controls">
					<Segmented
						size="sm"
						label="Billing period"
						name="pcBilling"
						options={[
							{ label: tbPrivateCloudData.billingOptions.monthly, value: 'monthly' },
							{
								label: tbPrivateCloudData.billingOptions.annual,
								value: 'annual',
								badge: tbPrivateCloudData.billingOptions.discount,
							},
						]}
					/>
				</div>
				<PricingPlans
					plans={tbPrivateCloudData.plans}
					answers={answerIds.get('thingsboard-private-cloud')}
					faqPrefix={faqPrefix('thingsboard-private-cloud')}
				/>
				<p class="plans__note">
					<Icon name="tabler:message-circle" class="plans__note-mark" aria-hidden="true" />
					Not sure which plan fits?
					<Link variant="inline" href={CONTACT_PRIVATE_CLOUD}>Talk to our team</Link>
				</p>
			</div>

			{/* On-premises */}
			<div
				id="plans-thingsboard-pe"
				role="tabpanel"
				aria-labelledby="plans-thingsboard-pe-tab"
				data-deploy-panel="thingsboard-pe"
				data-accent="onprem"
			>
				<div data-onprem-show="payg">
					<SectionHeader
						title={onPrem.title}
						subtitle={onPrem.subtitle}
						titleSize="title"
						subtitleMeasure="copy"
						spacing="sm"
					/>
				</div>
				<div data-onprem-show="perpetual">
					<SectionHeader
						title={onPremPerpetual.title}
						subtitle={onPremPerpetual.subtitle}
						titleSize="title"
						subtitleMeasure="copy"
						spacing="sm"
					/>
				</div>
				<div class="plans__controls">
					<Segmented
						size="sm"
						label="Licensing"
						name="onpremBilling"
						options={[
							{ label: 'Subscription', value: 'payg' },
							{ label: 'Perpetual', value: 'perpetual' },
						]}
					/>
				</div>

				<div data-onprem-show="payg">
					<PricingPlans
						plans={tbSelfManagedData.payg.plans}
						answers={answerIds.get('thingsboard-pe')}
						faqPrefix={faqPrefix('thingsboard-pe')}
					/>
					<p class="plans__note">
						<Icon name="tabler:message-circle" class="plans__note-mark" aria-hidden="true" />
						Not sure which plan fits?
						<Link variant="inline" href={CONTACT_ON_PREM}>Talk to an expert</Link>
					</p>
				</div>

				<div data-onprem-show="perpetual" class="perpetual">
					<Card role="panel">
						<div class="perpetual__card">
							<div class="perpetual__lead">
								<h3 class="perpetual__title">{tbPerpetualHero.title}</h3>
								{tbPerpetualHero.subtitle && <p class="perpetual__sub">{tbPerpetualHero.subtitle}</p>}
								<p class="price-card__price">
									<span class="price-card__amount">
										{tbPerpetualHero.priceLabel?.replace(/^Starting from /, 'From ')}
									</span>
									<span class="price-card__period">one-time payment</span>
								</p>
								<Button icon="tabler:message-circle" href={tbPerpetualHero.ctaHref} class="perpetual__cta">
									Talk to sales
								</Button>
							</div>
							<div class="perpetual__fit">
								<p class="perpetual__fit-title">A perpetual license fits when</p>
								<ul class="perpetual__points">
									{
										tbPerpetualHero.features.map((point) => (
											<li>
												<Icon name="tabler:check" aria-hidden="true" />
												{point}
											</li>
										))
									}
								</ul>
							</div>
						</div>
					</Card>
					{tbSelfManagedData.perpetual.benefits && <BenefitGrid items={tbSelfManagedData.perpetual.benefits} />}
				</div>
			</div>
		</Band>

		{/* ─── Add-ons, and Cloud's top-ups ───────────────────────────────────────────────────── */}
		<Band id="addons" ground="tint" pad="lg" class="addons">
			<SectionHeader title="Add-ons" subtitle={addOnsSubtitle} titleSize="title" subtitleMeasure="copy" spacing="sm" />

			<div data-deploy-panel="thingsboard-cloud">
				{
					CLOUD_REGIONS.map((r) => (
						<div data-region-show={r.id}>
							<PricingAddOns addOns={cloudExtras[r.id].addOns} contactHref={pricingClosing.secondary.href} />
						</div>
					))
				}
				<div class="addons__topups">
					<SectionHeader
						title="Top-ups"
						subtitle="Packs that add to a plan's limits, billed monthly with it."
						titleSize="section"
						subtitleMeasure="copy"
						spacing="sm"
					/>
					{
						CLOUD_REGIONS.map((r) => (
							<div data-region-show={r.id}>
								<PricingTopUps groups={cloudExtras[r.id].topUps} />
							</div>
						))
					}
				</div>
			</div>

			<div data-deploy-panel="thingsboard-private-cloud">
				<PricingAddOns addOns={tbPrivateCloudAddOns} contactHref={CONTACT_PRIVATE_CLOUD} />
			</div>

			<div data-deploy-panel="thingsboard-pe">
				<div data-onprem-show="payg">
					<PricingAddOns addOns={tbSelfManagedAddOns} contactHref={CONTACT_ON_PREM} />
				</div>
				<div data-onprem-show="perpetual">
					<PricingAddOns addOns={tbPerpetualAddOns} contactHref={tbPerpetualHero.ctaHref} />
				</div>
			</div>
		</Band>

		{/* ─── Private Cloud, plan by plan ────────────────────────────────────────────────────── */}
		<Band id="matrix" pad="lg" class="compare" attrs={{ 'data-deploy-panel': 'thingsboard-private-cloud' }}>
			<SectionHeader
				title="Private Cloud, plan by plan"
				subtitle="Every plan runs on a dedicated cluster. These are the features that grow with it."
				titleSize="title"
				subtitleMeasure="copy"
				spacing="md"
			/>
			<ProductMatrix
				caption="ThingsBoard Private Cloud: additional features by plan"
				firstLabel="Feature"
				columns={pcFeatureHeaders.map((name) => ({ name }))}
				rows={pcFeatureRows.map((row) => ({ label: row.feature, values: row.values }))}
				align="center"
			/>
		</Band>

		{/* ─── The three, side by side ───────────────────────────────────────────────────────── */}
		<ChoiceBand
			title={pricingChoice.title}
			lead={pricingChoice.lead}
			options={DEPLOYMENTS.map((d) => ({
				name: d.name,
				icon: d.icon,
				price: d.choice.price,
				priceNote: d.choice.priceNote,
				summary: d.choice.summary,
				points: d.choice.points,
				cta: d.choice.cta,
				plansHref: `?product=${d.id}#plans`,
				plansAttrs: { 'data-deploy-go': d.id },
			}))}
		/>

		{/* ─── FAQ, for the deployment on screen ─────────────────────────────────────────────── */}
		<Band id="faq" pad="lg">
			{
				DEPLOYMENTS.map((d) => {
					const faq = faqFor(d.id);
					const prefix = faqPrefix(d.id);
					return (
						<div
							class="faq-block"
							data-deploy-panel={d.id}
							data-accent={d.id === 'thingsboard-pe' ? 'onprem' : undefined}
						>
							<SectionHeader title={d.faqTitle} titleSize="title" />
							<ProductFaq
								categories={faq.categories}
								visibleCount={FAQ_VISIBLE}
								idPrefix={`faq-${d.id}`}
								itemIdPrefix={prefix}
								label={`${d.name} FAQ topics`}
							/>
						</div>
					);
				})
			}
		</Band>
	</div>

	{/* The bookend: the product pages', with the hero's tag closing the page as it opened. */}
	<Bookend id="pricing" />
	{
		/* TEMP-INTERNAL-NAV — remove before this branch reaches main, with the homepage's.
	    The internal switcher, so this page can be reached from the sandbox and back. It is NOT
	    production chrome: the page is shown as it ships, with only the island over it.

	    To remove: `grep -rln TEMP-INTERNAL-NAV src/pages` and delete both hits in each file. */
	}
	<InternalNav />
</BaseLayout>

<script>
	import { setSegmented, type SegmentedSelect } from '@util/segmented';

	const root = document.documentElement;
	const onPage = () => !!document.querySelector('[data-pricing-draft]');
	const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	/** Under the fixed bar, with the same air the FAQ sidebar keeps from it. */
	function scrollToElement(el: Element) {
		const bar = parseFloat(getComputedStyle(root).getPropertyValue('--home-header-h')) || 64;
		const top = el.getBoundingClientRect().top + window.scrollY - bar - 24;
		window.scrollTo({ top, behavior: reducedMotion() ? 'auto' : 'smooth' });
	}

	/** The address follows the view, so a link copied from here opens on what you were reading. */
	function updateUrl(edit: (params: URLSearchParams) => void) {
		const url = new URL(location.href);
		edit(url.searchParams);
		history.replaceState(history.state, '', url);
	}

	/** Every toggle's pressed state, from the <html> attribute it writes. */
	function syncSegments() {
		document.querySelectorAll<HTMLElement>('[data-segmented-name]').forEach((group) => {
			const value = root.dataset[group.dataset.segmentedName!];
			if (value) setSegmented(group, value);
		});
	}

	function selectDeploy(id: string) {
		root.dataset.deploy = id;
		const caption = document.querySelector<HTMLElement>('[data-deploy-caption]');
		if (caption) caption.textContent = JSON.parse(caption.dataset.captions ?? '{}')[id] ?? '';
		// Main's `?section=` is dropped once read; `?solution=` only means anything on-prem.
		updateUrl((params) => {
			params.set('product', id);
			params.delete('section');
			if (id !== 'thingsboard-pe') params.delete('solution');
		});
	}

	// The deployment switch is `ui/Tabs`: it moves the selection, the focus and the thumb, and asks
	// first. The page shows its blocks from <html> rather than through `hidden`, so it takes over.
	document.addEventListener('tabs:change', (event) => {
		const list = event.target as Element;
		if (!list.classList?.contains('deploy-switch')) return;
		event.preventDefault();
		const panel = (event as CustomEvent<{ panel: HTMLElement | null }>).detail.panel;
		if (panel) selectDeploy(panel.id.replace(/^plans-/, ''));
	});

	// Every other choice is a `ui/Segmented` toggle: its value goes to <html>, where the CSS reads it.
	document.addEventListener('segmented:select', (event) => {
		if (!onPage()) return;
		const { name, value } = (event as CustomEvent<SegmentedSelect>).detail;
		if (!name) return;
		root.dataset[name] = value;
		syncSegments();
		if (name === 'onpremBilling') {
			updateUrl((params) => {
				if (value === 'perpetual') params.set('solution', 'pe-perpetual');
				else params.delete('solution');
			});
		}
	});

	// Delegated once, on the document: the site swaps the body between pages, and these keep working
	// on whatever body is in.
	document.addEventListener('click', (event) => {
		const target = event.target as Element | null;
		if (!target || !onPage()) return;

		// "See plans" and "See Private Cloud plans": the deployment's tab, and back up to the plans.
		const go = target.closest<HTMLAnchorElement>('[data-deploy-go]');
		if (go) {
			event.preventDefault();
			document.getElementById(`plans-${go.dataset.deployGo}-tab`)?.click();
			const plans = document.getElementById('plans');
			if (plans) scrollToElement(plans);
			return;
		}

		// A plan line that quotes an answer opens it: its topic selected, "More questions" opened
		// if it is past the first six, the answer itself expanded, and scrolled to under the bar.
		const term = target.closest<HTMLAnchorElement>('[data-faq-link]');
		if (term) {
			const answer = document.getElementById(term.hash.slice(1)) as HTMLDetailsElement | null;
			if (!answer) return;
			event.preventDefault();
			const panel = answer.closest<HTMLElement>('[role="tabpanel"]');
			if (panel?.hidden) document.getElementById(panel.getAttribute('aria-labelledby') ?? '')?.click();
			// Past the first six: held back until "More questions" opens them.
			if (panel && answer.hidden) panel.querySelector<HTMLButtonElement>('[data-faq-more]')?.click();
			answer.open = true;
			scrollToElement(answer);
			answer.querySelector('summary')?.focus({ preventScroll: true });
		}
	});

	// The controls are rendered on their defaults; the pre-paint script may have chosen otherwise.
	function init() {
		if (onPage()) syncSegments();
	}

	init();
	document.addEventListener('astro:page-load', init);
</script>

<style is:global lang="scss">
	@use '../../../styles/variables' as *;
	@use '../../../styles/surface' as *;
	// The product pages' hero (centred, on the dark ground, the `Mark` over the title) and the bar.
	// Every band, header, table, card and button below is a kit component; what follows is only
	// what this page adds.
	@use '../../../styles/product-page';

	// ---------------------------------------------------------------------------------------------
	// WHICH BLOCKS SHOW. The state is on <html>, written before paint (see the hero's script); with
	// no script at all the attributes never arrive and the defaults below hold: Cloud, North America,
	// monthly, subscription.
	// ---------------------------------------------------------------------------------------------
	$deployments: thingsboard-cloud, thingsboard-private-cloud, thingsboard-pe;

	[data-deploy-panel]:not([data-deploy-panel='thingsboard-cloud']),
	[data-region-show='eu'],
	[data-billing-show='annual'],
	[data-onprem-show='perpetual'] {
		display: none;
	}

	html[data-deploy] [data-deploy-panel] {
		display: none;
	}

	@each $id in $deployments {
		html[data-deploy='#{$id}'] [data-deploy-panel='#{$id}'] {
			display: block;
		}
	}

	html[data-cloud-region='eu'] {
		[data-region-show='us'] {
			display: none;
		}

		[data-region-show='eu'] {
			display: block;
		}
	}

	html[data-pc-billing='annual'] {
		[data-billing-show='monthly'] {
			display: none;
		}

		[data-billing-show='annual'] {
			display: inline;
		}
	}

	html[data-onprem-billing='perpetual'] {
		[data-onprem-show='payg'] {
			display: none;
		}

		[data-onprem-show='perpetual'] {
			display: block;
		}
	}

	// The switch: the segmented pill the plans' controls use below, in its dark dress. Slotted, so
	// Hero's reveal never reaches it — restated after the subtitle, as `.hero-caption` does it.
	.deploy-switch,
	.deploy-caption {
		opacity: 0;
		transform: translate3d(0, 45px, 0);
		animation: slideup-in 600ms cubic-bezier(0.25, 0.46, 0.45, 0.94) 900ms forwards;

		@media (prefers-reduced-motion: reduce) {
			animation: none;
			opacity: 1;
			transform: none;
		}
	}

	.deploy-switch {
		margin-top: $spacing-8;
	}

	.deploy-caption {
		@include type-small;
		max-width: 52ch;
		min-height: 44px;
		margin: $spacing-4 auto 0;
		color: rgba(255, 255, 255, 0.72);
		text-wrap: balance;
	}

	// ---------------------------------------------------------------------------------------------
	// THE PLANS
	// ---------------------------------------------------------------------------------------------
	// The one band past the 960 measure: five plans across need the 1200 the homepage keeps for its
	// two-column rows. The heading and the controls stay centred on it.
	.plans__inner {
		max-width: calc(1200px + #{$spacing-5} * 2);
		margin-inline: auto;
		padding-inline: $spacing-5;
	}

	.plans__controls {
		display: flex;
		justify-content: center;
		margin-bottom: $spacing-10;
	}

	// Each card spans five of the grid's rows and takes them as a SUBGRID, so the name, the
	// description, the price, the button and the list sit on one line across a row of cards whatever
	// the copy: Private Cloud's Growth describes itself in three lines where the others take two.
	// Main's cards are subgridded for the same reason. No row gap: the cards' own margins space
	// the rows inside them, and a card's bottom margin spaces one row of cards from the next.
	.price-grid {
		display: grid;
		grid-template-columns: repeat(var(--price-cols, 4), minmax(0, 1fr));
		column-gap: $spacing-5;
		row-gap: 0;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0;
		list-style: none;

		// Four plans stay near the measure the rest of the page reads on; only Cloud's five use the band.
		&--4 {
			max-width: 1040px;
		}

		@media (max-width: 1099px) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			max-width: 720px;

			&--5 {
				grid-template-columns: repeat(3, minmax(0, 1fr));
				max-width: none;
			}
		}

		@include media-down(md) {
			grid-template-columns: minmax(0, 1fr);
			max-width: 480px;

			&--5 {
				grid-template-columns: minmax(0, 1fr);
				max-width: 480px;
			}
		}
	}

	// A card on the white, lifted on the homepage's UI shadow and no stroke — the contact page's cards.
	.price-card {
		@include surface(panel);

		position: relative;
		display: grid;
		grid-row: span 5;
		grid-template-rows: subgrid;
		row-gap: 0;
		align-content: start;
		margin: 0 0 $spacing-5;
		padding: $spacing-6 $spacing-5;

		// The ring, not a raised card: a taller popular card pushes its row's prices out of line.
		&--popular {
			box-shadow:
				0 0 0 2px var(--accent-fill),
				var(--elev-panel);
		}

		&__head {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: $spacing-2;
		}

		&__name {
			font-size: $font-size-xl;
			font-weight: $font-weight-bold;
			line-height: 1.3;
			margin: 0;
			color: var(--color-text);
		}

		&__desc {
			@include type-small;
			margin: $spacing-1 0 0;
			color: var(--color-text-secondary);
			text-wrap: pretty;
		}

		&__price {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			gap: 0 $spacing-2;
			margin: $spacing-5 0 0;
		}

		&__amount {
			font-size: 36px;
			font-weight: $font-weight-bold;
			line-height: 1.1;
			letter-spacing: -0.01em;
			color: var(--color-text);
			font-variant-numeric: tabular-nums;
		}

		&__period {
			@include type-small;
			color: var(--color-text-secondary);
		}

		.price-card__cta {
			margin-top: $spacing-5;
		}

		&__features {
			@include type-small;
			display: flex;
			flex-direction: column;
			gap: $spacing-2;
			margin: $spacing-6 0 0;
			padding: 0;
			list-style: none;
			color: var(--color-text-secondary);

			li {
				display: flex;
				align-items: flex-start;
				gap: $spacing-2;
				margin: 0;
			}

			svg {
				flex: none;
				width: 18px;
				height: 18px;
				margin-top: 2px;
				color: var(--accent-fill);
			}

			// White labeling and the per-device overage: what a plan ADDS, in the ink, not the grey.
			.is-highlight {
				color: var(--color-text);
				font-weight: $font-weight-medium;
			}
		}

		// A term with an answer: dotted, the convention for "defined elsewhere", and the primary on hover.
		&__term {
			color: inherit;
			text-decoration: underline dotted rgba(15, 23, 42, 0.35);
			text-underline-offset: 3px;

			&:hover,
			&:focus-visible {
				color: var(--accent-fill);
				text-decoration-color: currentColor;
			}

			&:focus-visible {
				outline: 2px solid var(--focus-ring);
				outline-offset: 2px;
				border-radius: 2px;
			}
		}
	}

	// The light-ground twin of the decision band's `.choice-note`: one line, a glyph, a link out.
	.plans__note {
		@include type-body;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: $spacing-2;
		margin: $spacing-10 0 0;
		color: var(--color-text-secondary);
		text-align: center;

		&-mark {
			flex: none;
			width: 22px;
			height: 22px;
			color: var(--color-text);
		}

		a {
			@include type-link;
			color: var(--accent-fill);
			text-decoration: underline;
			text-underline-offset: 3px;

			&:focus-visible {
				outline: 2px solid var(--focus-ring);
				outline-offset: 3px;
			}
		}
	}

	// ── Perpetual ────────────────────────────────────────────────────────────────────────────────
	.perpetual__card {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		gap: $spacing-10;
		max-width: 960px;
		margin: 0 auto;
		padding: $spacing-10;
		border-radius: 16px;
		background-color: #fff;
		box-shadow:
			0 0 0 2px $color-brand,
			0 18px 40px -18px rgba(61, 80, 245, 0.35);

		@include media-down(md) {
			grid-template-columns: minmax(0, 1fr);
			gap: $spacing-8;
			padding: $spacing-6 $spacing-5;
		}

		.price-card__cta {
			align-self: flex-start;
			padding: 0 $spacing-5;
		}
	}

	.perpetual__lead {
		display: flex;
		flex-direction: column;
	}

	.perpetual__title {
		@include type-card;
		margin: 0;
		color: var(--color-text);
	}

	.perpetual__sub {
		@include type-body;
		margin: $spacing-3 0 0;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}

	.perpetual__fit-title {
		@include type-eyebrow;
		margin: 0 0 $spacing-4;
		color: var(--color-text-secondary);
	}

	.perpetual__points {
		@include type-body;
		display: flex;
		flex-direction: column;
		gap: $spacing-3;
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--color-text);

		li {
			display: flex;
			align-items: flex-start;
			gap: $spacing-2;
			margin: 0;
		}

		svg {
			flex: none;
			width: 20px;
			height: 20px;
			margin-top: 2px;
			color: var(--accent-fill);
		}
	}

	// ---------------------------------------------------------------------------------------------
	// ADD-ONS AND TOP-UPS, on the tint the product pages give their shared-features band.
	// ---------------------------------------------------------------------------------------------
	.addons__topups {
		margin-top: $spacing-16;
	}

	.addon-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: $spacing-5;
		max-width: 960px;
		margin: 0 auto;
		padding: 0;
		list-style: none;

		@include media-down(lg) {
			grid-template-columns: minmax(0, 1fr);
			max-width: 560px;
		}
	}

	.addon-tile {
		@include surface(tile);

		display: flex;
		align-items: flex-start;
		gap: $spacing-4;
		margin: 0;
		padding: $spacing-6 $spacing-5;

		&__body {
			min-width: 0;
		}

		&__name {
			@include type-tile;
			margin: 2px 0 0;
			color: var(--color-text);
		}

		&__desc {
			@include type-small;
			margin: $spacing-1 0 0;
			color: var(--color-text-secondary);
		}

		&__price {
			@include type-small-strong;
			display: flex;
			flex-direction: column;
			margin: $spacing-3 0 0;
			color: var(--color-text);

			a {
				color: var(--accent-fill);
				text-decoration: underline;
				text-underline-offset: 3px;
			}
		}

		&__fee {
			@include type-small;
			color: var(--color-text-secondary);
		}
	}

	.topup-groups {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: $spacing-10 $spacing-12;
		max-width: 960px;
		margin: 0 auto;

		@include media-down(lg) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.topup-list {
		margin: 0;
	}

	// The product pages' term-and-value row, with the price held to its own right-hand column.
	.topup-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		grid-template-areas:
			'name price'
			'adds price';
		column-gap: $spacing-4;
		padding: $spacing-3 0;
		border-bottom: 1px solid rgba(15, 23, 42, 0.08);

		dt {
			@include type-body;
			grid-area: name;
			font-weight: $font-weight-medium;
			color: var(--color-text);
		}

		&__adds {
			@include type-small;
			grid-area: adds;
			margin: 0;
			color: var(--color-text-secondary);
		}

		&__price {
			@include type-body;
			grid-area: price;
			align-self: center;
			margin: 0;
			font-weight: $font-weight-bold;
			color: var(--color-text);
			white-space: nowrap;
			text-align: right;

			span {
				@include type-small;
				font-weight: $font-weight-normal;
				color: var(--color-text-secondary);
			}
		}
	}
</style>
