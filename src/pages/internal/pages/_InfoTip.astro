---
/**
 * Main's ⓘ beside a plan line or an add-on: a small button that shows its explanation on hover and
 * on focus, so a keyboard reaches it too. CSS only; the rules are the page's (`.tip`).
 *
 * Underscore-prefixed so Astro does not make it a route.
 */
import { Icon } from 'astro-icon/components';

interface Props {
	/** The explanation, as HTML: main's tooltips carry links. */
	html: string;
	/** What it explains, for the button's accessible name. */
	label: string;
	/** The FAQ answer it was cut from, when that answer is on the page. */
	more?: string;
}

const { html, label, more } = Astro.props;
const id = `tip-${Math.random().toString(36).slice(2, 10)}`;
---

<span class="tip">
	<button type="button" class="tip__btn" aria-label={`About ${label}`} aria-describedby={id}>
		<Icon name="tabler:info-circle" aria-hidden="true" />
	</button>
	<span class="tip__body" role="tooltip" id={id}>
		<span set:html={html} />
		{
			more && (
				<a class="tip__more" href={more} data-faq-link>
					Read more
				</a>
			)
		}
	</span>
</span>
