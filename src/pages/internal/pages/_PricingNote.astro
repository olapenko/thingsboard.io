---
/**
 * Main's upsell for the conservative pricing draft (`./pricing.astro`), as one centred line: a glyph,
 * the question, and a link out of it. Main draws each as a card with a button; under a row of plan
 * cards that weighed as much as a plan. The link is `ui/Link`; the line's rules are the page's
 * (`.p2-note`).
 *
 * Underscore-prefixed so Astro does not make it a route.
 */
import { Icon } from 'astro-icon/components';
import Link from '@components/ui/Link.astro';

interface Props {
	icon: string;
	text: string;
	link: { text: string; href: string };
	/** A deployment id: the link switches the page's tab rather than leaving it. */
	go?: string;
	/** Set apart from what is above it, where it closes a block rather than following a row of cards. */
	spaced?: boolean;
}

const { icon, text, link, go, spaced = false } = Astro.props;
---

<p class:list={['p2-note', spaced && 'p2-note--spaced']}>
	<Icon name={icon} class="p2-note__mark" aria-hidden="true" />
	<span class="p2-note__text">{text}</span>
	<Link href={link.href} attrs={{ 'data-deploy-go': go }}>{link.text}</Link>
</p>
