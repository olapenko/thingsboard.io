---
/**
 * Cloud's top-ups, for the pricing draft (`./pricing.astro`), as the product pages set their
 * feature lists: a heading with its group mark over term-and-value rows. Main draws them as
 * accordions, one click per pack to read what it adds; at two lines a pack, the rows say it outright.
 *
 * Underscore-prefixed so Astro does not make it a route.
 */
import { Icon } from 'astro-icon/components';
import type { TopUpGroup } from '@data/pricing-live/types';

interface Props {
	groups: TopUpGroup[];
}

const { groups } = Astro.props;

// One mark per group, in the page's own hue: the groups are two halves of one list, not two kinds.
const GROUP_ICONS: Record<string, string> = { Entities: 'tabler:stack-2', 'API calls': 'tabler:arrows-exchange' };
---

<div class="topup-groups">
	{
		groups.map((group) => (
			<div class="topup-group">
				<h3 class="shared-group__title">
					<span class="group-mark" aria-hidden="true">
						<Icon name={GROUP_ICONS[group.title] ?? 'tabler:plus'} />
					</span>
					{group.title}
				</h3>
				<dl class="topup-list">
					{group.items.map((item) => (
						<div class="topup-row">
							<dt>{item.name}</dt>
							<dd class="topup-row__adds">{item.details?.map((d) => d.value).join(', ')}</dd>
							<dd class="topup-row__price">
								{typeof item.priceUsd === 'string' ? item.priceUsd : `$${item.priceUsd}`}
								{item.period && <span> {item.period.replace(/^\//, 'per ')}</span>}
							</dd>
						</div>
					))}
				</dl>
			</div>
		))
	}
</div>
