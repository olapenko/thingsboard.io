---
import EcosystemCard from '@components/Landing/EcosystemCard.astro';
import SectionHeader from '@components/Landing/SectionHeader.astro';
import { homeProducts } from '@data/homeProducts';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * The homepage's Products section, restated for the sandbox: the deployment pair on the dark band.
 *
 * Ground and geometry are `index.astro`'s — the #121425 fill (the light band's recipe inverted),
 * a 960 measure, two tracks $spacing-5 apart, stacking below `md`. The wave field that animates
 * behind the cards on the page is 3.5–5.5% ink and stays there: the cards, not the weather, are
 * what the sandbox reviews. The header's copy comes from the section's `_key-visuals` entry, which
 * restates the words `index.astro` carries inline — one place to keep in step, not two.
 *
 * If the Products section ever grows a shared component, this file is the first thing it replaces.
 */
interface Props {
	/** The glass-panel direction: the pair as the product pages' own choice cards. */
	dark?: boolean;
}

const { dark = false } = Astro.props;

const me = kv('products');
---

<section class="pband">
	<div class="pband__inner">
		<SectionHeader
			title={me.title ?? me.label}
			subtitle={me.body}
			theme="dark"
			titleSize="title"
			subtitleMeasure="copy"
		/>
		<div class="pband__list">
			{homeProducts.map((product) => <EcosystemCard {...(product as any)} dark={dark} />)}
		</div>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	.pband {
		padding: $spacing-16 $spacing-5;
		background: #121425;
	}

	.pband__inner {
		max-width: 960px;
		margin: 0 auto;

		// The homepage gives the section header this same clearance over the pair.
		:global(.section-header) {
			margin-bottom: $spacing-12;
		}
	}

	.pband__list {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: $spacing-5;

		@include media-down(md) {
			grid-template-columns: 1fr;
		}
	}
</style>
