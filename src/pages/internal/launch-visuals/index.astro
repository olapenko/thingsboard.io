---
import PlaygroundLayout from '@layouts/PlaygroundLayout.astro';
import { KEY_VISUALS } from '@root/pages/internal/_key-visuals';

/**
 * The sandbox's front door: one card per key visual, each linking to its own page.
 *
 * This page used to BE the sandbox — nine visuals as tab panels in one 1346-line file. Opening it
 * compiled and rendered all fifty-eight stages to look at six of them, and the tab strip was
 * machinery that existed only because they shared a page.
 *
 * Now each visual is a route: `/internal/launch-visuals/<id>/`, one file, compiled on its own. The
 * index is the only thing that knows they are a set.
 *
 * ADD a visual: an entry in `_key-visuals.ts` and a page beside this one. It appears here, and in
 * the strip on every other visual's page, with no other edit. REMOVE one: delete those two things.
 */
---

<PlaygroundLayout
	title="Launch visuals"
	description="Each visual on its own page, at the widths it gets in the page it is headed for."
>
	<ul class="vlist">
		{
			KEY_VISUALS.map((v) => (
				<li class="vlist__item">
					<a class="vlist__link" href={`/internal/launch-visuals/${v.id}/`}>
						<span class="vlist__label">{v.label}</span>
						{v.title && <span class="vlist__title">{v.title}</span>}
					</a>
				</li>
			))
		}
	</ul>

	<p class="vnote">
		Every visual in its real row, in order, is on the <a href="/">homepage</a> — which is where they run now. The separate
		preview copy of it is gone.
	</p>
</PlaygroundLayout>

<style lang="scss">
	@use '../../../styles/variables' as *;

	.vlist {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: $spacing-3;
		max-width: 1200px;
		margin: 0 auto $spacing-10;
		padding: 0;
		list-style: none;
	}

	.vlist__link {
		display: grid;
		gap: $spacing-1;
		height: 100%;
		padding: $spacing-4 $spacing-5;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: $radius-lg;
		text-decoration: none;

		&:hover {
			border-color: var(--color-text, #17181c);
		}
	}

	.vlist__label {
		@include text-xs;
		font-family: $font-family-mono;
		color: var(--color-text-secondary, #5b616e);
	}

	.vlist__title {
		@include card-title-sm;
		color: var(--color-text, #17181c);
		text-wrap: pretty;
	}

	.vnote {
		@include text-s;
		max-width: 1200px;
		margin: 0 auto;
		color: var(--color-text-secondary, #5b616e);
	}
</style>
