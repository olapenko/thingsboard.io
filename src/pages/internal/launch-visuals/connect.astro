---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import FeatureRow from '@root/pages/internal/_FeatureRow.astro';
import ConnectCloud from '@components/Landing/ConnectCloud.astro';
import ConnectFlow from '@components/Landing/ConnectFlow.astro';
import { CONNECT_BODY_HTML, CONNECT_ROUTES } from '@data/connect-visual';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * Connect devices — the cloud, which is the launch candidate, and the routes version it replaced.
 *
 * Its own route, so opening it compiles and renders this visual and nothing else. `_VisualPage`
 * carries what every visual's page shares: the strip of links between them, the retire control
 * and the stage chrome.
 */
---

<VisualPage visual="connect">
	{
		/* Replaces the section's grid of protocol logos. The names are set as the subject and the
	    route — devices, gateways, networks — is demoted to the caption over them, which is the
	    swap the draft asked for. */
	}
	{
		/* The cloud drops its group captions, so its four accents are the only thing saying which
	    route a chip belongs to — and how loudly they say it is the open question.

	    "Tinted · light" is the same coding at 10% rather than 18%, and it is worth checking what
	    that costs as well as what it buys: the four hues get harder to tell from each other the
	    paler they are, and telling them apart is the entire job.

	    A coloured stripe down each chip was tried and dropped: too noisy at twenty-four of them. */
	}
	{
		/* How the copy keys the cloud's colours. The squircle is the candidate; the highlight is
	    kept beside it because it marks the term more strongly, at the cost of a paragraph that
	    reads as a set of labels rather than a sentence. */
	}
	<div class="page-ctl" role="group" aria-label="Legend style" data-legend-switch>
		<span class="page-ctl__name">Copy legend</span>
		<button type="button" data-legend-pick="swatch" aria-pressed="true">Inline squircle</button>
		<button type="button" data-legend-pick="highlight" aria-pressed="false">Tint highlight</button>
	</div>

	<div class="page-ctl" role="group" aria-label="Cloud chip style" data-chip-switch>
		<span class="page-ctl__name">Cloud chips</span>
		<button type="button" data-chip-pick="tint" aria-pressed="true">Tinted</button>
		<button type="button" data-chip-pick="tint-light" aria-pressed="false">Tinted · light</button>
		<button type="button" data-chip-pick="text" aria-pressed="false">White + colour text</button>
	</div>

	{
		/* --- the cloud, which is the launch candidate -----------------------------------------
	    First in the panel because it is the one that ships: the routes version below is the
	    fallback, and putting the thing under review second is how a fallback quietly becomes the
	    default again.

	    A different argument from the same parts: not "four ways in" but "whatever you have is
	    already in here". Names and accents come from CONNECT_ROUTES, so the two cuts cannot
	    disagree about what is supported or what colour a route is.

	    Its row is the only one on this page that passes bodyHtml — the cloud has no legend, so
	    the marked terms in that paragraph are the only thing saying what its colours mean. */
	}
	<FeatureRow visual={{ ...kv('connect'), bodyHtml: CONNECT_BODY_HTML }} note="the cloud — its copy IS its legend">
		<ConnectCloud />
	</FeatureRow>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ConnectCloud · 525px</span>
			<span class="stage__note">variant · the home row at 1440</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 525px">
				<ConnectCloud />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ConnectCloud · 673px</span>
			<span class="stage__note">the width the sandbox row gives it</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ConnectCloud />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ConnectCloud · 367px</span>
			<span class="stage__note">phone · the width that decides it</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 367px">
				<ConnectCloud />
			</div>
		</div>
	</figure>

	{/* --- the routes, the version it replaces --------------------------------------------- */}
	<FeatureRow visual={kv('connect')}>
		<ConnectFlow />
	</FeatureRow>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ConnectFlow · 673px</span>
			<span class="stage__note">draft · the width the feature row gives it</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ConnectFlow />
			</div>
		</div>
	</figure>

	{
		/* The alternative grouping: the four routes the connectivity guide defines, rather than
	    three that merge LPWAN networks into "networks & clouds". Kept beside the three-group
	    version rather than replacing it — the simpler read and the accurate one are a real
	    trade, and the fourth card costs height the phone width can least afford. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ConnectFlow · 4 routes</span>
			<span class="stage__note">variant · as the connectivity guide groups them · surface: shadow (default)</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ConnectFlow groups={CONNECT_ROUTES} />
			</div>
		</div>
	</figure>

	{
		/* The same composition with the other two surfaces, at the same width, so the only thing
	    changing between the three is how a card separates itself from the page. All three reserve
	    the same border box, so nothing else moves. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ConnectFlow · surface: outline</span>
			<span class="stage__note">hairline, no shadow · what these cards started as</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ConnectFlow groups={CONNECT_ROUTES} surface="outline" />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ConnectFlow · surface: both</span>
			<span class="stage__note">shadow and hairline · for grounds close to the card fill</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ConnectFlow groups={CONNECT_ROUTES} surface="both" />
			</div>
		</div>
	</figure>

	{
		/* Two routes each side of the node, which trades width for height: the same four routes are
	    412 units tall stacked and 196 split. For a full-bleed band rather than a column. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ConnectFlow · split · 1120px</span>
			<span class="stage__note">variant · 2 routes → app ← 2 routes</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 1120px">
				<ConnectFlow groups={CONNECT_ROUTES} layout="split" />
			</div>
		</div>
	</figure>

	{
		/* The last width that still gets the wide arrangement. One pixel narrower and the next two
	    stages are what shows instead, so this pair is where the handover gets judged. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ConnectFlow · split · 1000px</span>
			<span class="stage__note">variant · the threshold, still wide</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 1000px">
				<ConnectFlow groups={CONNECT_ROUTES} layout="split" />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ConnectFlow · split · 999px</span>
			<span class="stage__note">variant · one pixel under, regrouped into one column</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 999px">
				<ConnectFlow groups={CONNECT_ROUTES} layout="split" />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ConnectFlow · split · 335px</span>
			<span class="stage__note">variant · phone, so the stacked arrangement</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ConnectFlow groups={CONNECT_ROUTES} layout="split" />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ConnectFlow · 4 routes · 335px</span>
			<span class="stage__note">variant · phone</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ConnectFlow groups={CONNECT_ROUTES} />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ConnectFlow · 335px</span>
			<span class="stage__note">phone</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ConnectFlow />
			</div>
		</div>
	</figure>
</VisualPage>

<script>
	// The cloud's chip coding. Drives `data-chip` on every ConnectCloud in the panel, which is the
	// same attribute the component's own prop sets — so the sandbox and a real page cannot disagree
	// about what a value means.
	const CHIP_KEY = 'launch-visuals:chip';
	document.querySelectorAll<HTMLElement>('[data-chip-switch]').forEach((group) => {
		const picks = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-chip-pick]'));
		// Every cloud on the page. It used to be scoped to `[data-page-panel="connect"]`, back when
		// nine visuals shared one page and the selector had to say which panel it meant; this page
		// holds nothing but Connect, and that wrapper no longer exists.
		const clouds = Array.from(document.querySelectorAll<HTMLElement>('.cl'));
		// Two things from one pick: `data-chip` chooses the coding, `--connect-tint` its strength. The
		// property goes on :root rather than on the clouds because the section's copy reads it too,
		// and that copy is not inside any of them.
		const apply = (value: string) => {
			clouds.forEach((c) => c.setAttribute('data-chip', value === 'tint-light' ? 'tint' : value));
			if (value === 'tint-light') document.documentElement.style.setProperty('--connect-tint', '10%');
			else document.documentElement.style.removeProperty('--connect-tint');
			picks.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.chipPick === value)));
		};
		let saved: string | null = null;
		try {
			saved = localStorage.getItem(CHIP_KEY);
		} catch {
			/* private mode; fine */
		}
		if (saved) apply(saved);
		picks.forEach((b) =>
			b.addEventListener('click', () => {
				const value = b.dataset.chipPick ?? 'tint';
				apply(value);
				try {
					localStorage.setItem(CHIP_KEY, value);
				} catch {
					/* ignore */
				}
			})
		);
	});

	// How the section's copy keys the cloud. One attribute on <html>; `_connect-terms.scss` turns it
	// into either a tint behind the four terms or a squircle before them.
	const LEGEND_KEY = 'launch-visuals:legend';
	document.querySelectorAll<HTMLElement>('[data-legend-switch]').forEach((group) => {
		const picks = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-legend-pick]'));
		// Swatch is the default, so it is the ABSENCE of the attribute — the sandbox can only ever
		// add the opt-in, which keeps a real page rendering the candidate with no script at all.
		const apply = (value: string) => {
			if (value === 'highlight') document.documentElement.dataset.legend = 'highlight';
			else delete document.documentElement.dataset.legend;
			picks.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.legendPick === value)));
		};
		let saved: string | null = null;
		try {
			saved = localStorage.getItem(LEGEND_KEY);
		} catch {
			/* private mode; fine */
		}
		if (saved) apply(saved);
		picks.forEach((b) =>
			b.addEventListener('click', () => {
				const value = b.dataset.legendPick ?? 'swatch';
				apply(value);
				try {
					localStorage.setItem(LEGEND_KEY, value);
				} catch {
					/* ignore */
				}
			})
		);
	});
</script>
