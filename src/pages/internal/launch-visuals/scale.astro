---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import FeatureRow from '@root/pages/internal/_FeatureRow.astro';
import ScaleChart from '@components/Landing/ScaleChart.astro';
import ScaleGrowth from '@components/Landing/ScaleGrowth.astro';
import ScaleMachines from '@components/Landing/ScaleMachines.astro';
import ScaleTiers from '@components/Landing/ScaleTiers.astro';
import { SCALE_TIERS_PAIR } from '@data/scale-visual';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * Scale — the growth chart and the alternatives it was chosen over.
 *
 * Its own route, so opening it compiles and renders this visual and nothing else. `_VisualPage`
 * carries what every visual's page shares: the strip of links between them, the retire control
 * and the stage chrome.
 */
---

<VisualPage visual="scale">
	{
		/* The scale half of "Deploy anywhere, scale without surprises", split off from the
	    deployment half. Every figure is from the repo's own 24h benchmarks rather than an
	    estimate — see src/data/scale-visual.ts for which scenario each one comes from. */
	}
	<FeatureRow visual={kv('scale')}>
		<ScaleGrowth />
	</FeatureRow>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleChart · 673px</span>
			<span class="stage__note">draft · the width the feature row gives it</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleChart />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleChart · 440px</span>
			<span class="stage__note">the container a real 2-column section gives it at 1440</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 440px">
				<ScaleChart />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleChart · 335px</span>
			<span class="stage__note">phone · scales rather than reflows, as the family does</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ScaleChart />
			</div>
		</div>
	</figure>

	{
		/* --- second cut ---------------------------------------------------------------------
	    Kept beside the first rather than replacing it. The chart counts machines instead of CPU,
	    and carries three facts per tier instead of six — see src/data/scale-visual.ts for why
	    each machine count is a sum of a table in the docs and not an estimate. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleMachines · 2 tiers · 673px</span>
			<span class="stage__note">second cut · both counts are sums of a docs table</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleMachines tiers={SCALE_TIERS_PAIR} />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleMachines · 3 tiers · 673px</span>
			<span class="stage__note">second cut · the middle tier's count is a shape, not a sum</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleMachines />
			</div>
		</div>
	</figure>

	{
		/* The pair the whole trade turns on. Two tiers are 420 units wide and three are 640, so the
	    same phone hands them different units — this is where that stops being arithmetic. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleMachines · 2 tiers · 335px</span>
			<span class="stage__note">phone · 420 units native</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ScaleMachines tiers={SCALE_TIERS_PAIR} />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleMachines · 3 tiers · 335px</span>
			<span class="stage__note">phone · 640 units native, so the same type lands smaller</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ScaleMachines />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleMachines · 2 tiers · 440px</span>
			<span class="stage__note">the container a real 2-column section gives it at 1440</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 440px">
				<ScaleMachines tiers={SCALE_TIERS_PAIR} />
			</div>
		</div>
	</figure>

	{
		/* --- third cut ----------------------------------------------------------------------
	    Two quantities drawn as themselves — a bar to scale for the fleet, one glyph per machine —
	    and everything else a value or a tag. The sentences have gone to the section copy. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleTiers · 673px</span>
			<span class="stage__note">third cut · bar for the fleet, one icon per machine</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleTiers />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleTiers · 440px</span>
			<span class="stage__note">third cut · the container a real 2-column section gives it</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 440px">
				<ScaleTiers />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleTiers · 335px</span>
			<span class="stage__note">third cut · phone</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ScaleTiers />
			</div>
		</div>
	</figure>

	{
		/* --- fourth cut ---------------------------------------------------------------------
	    The one thing the other three leave out: growth. A single unbroken curve through the three
	    benchmarked device counts, split into one area per phase, with the shopping list for each
	    phase in the same three columns underneath. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrowth · 673px</span>
			<span class="stage__note">fourth cut · one curve, three areas, three phases</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleGrowth />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrowth · 440px</span>
			<span class="stage__note">fourth cut · the container a real 2-column section gives it</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 440px">
				<ScaleGrowth />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrowth · 335px</span>
			<span class="stage__note">fourth cut · phone · three columns is the tight case</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ScaleGrowth />
			</div>
		</div>
	</figure>
</VisualPage>
