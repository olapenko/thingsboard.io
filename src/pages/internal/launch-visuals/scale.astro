---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import FeatureRow from '@root/pages/internal/_FeatureRow.astro';
import ScaleGrowth from '@components/Landing/ScaleGrowth.astro';
import ScaleDuo from '@components/Landing/ScaleDuo.astro';
import ScaleGrid from '@components/Landing/ScaleGrid.astro';
import ScalePair from '@components/Landing/ScalePair.astro';
import ScaleSetup from '@components/Landing/ScaleSetup.astro';
import { SCALE_CANDIDATE_COPY, SCALE_MODES_ALT } from '@data/scale-visual';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * Scale — the growth chart and the alternatives it was chosen over.
 *
 * Its own route, so opening it compiles and renders this visual and nothing else. `_VisualPage`
 * carries what every visual's page shares: the strip of links between them, the retire control
 * and the stage chrome.
 */
---

<VisualPage visual="scale">
	{
		/* The scale half of "Deploy anywhere, scale without surprises", split off from the
	    deployment half. Every figure is from the repo's own 24h benchmarks rather than an
	    estimate — see src/data/scale-visual.ts for which scenario each one comes from. */
	}
	{
		/* PRIMARY CANDIDATE. First in the panel, because in this sandbox position IS the proposal —
	    whatever sits at the top beside the copy is what is being put forward, and anything below it
	    is kept for comparison. The three earlier feature rows follow in the order they were made. */
	}
	<FeatureRow
		visual={kv('scale')}
		note="primary candidate · two modes, one colour, the section's own copy, ingest ripple"
	>
		<ScaleDuo animate />
	</FeatureRow>

	{
		/* Held for comparison. Its copy was rewritten because the original contradicted it; this one
	    puts the million back on the single-server card, so the original stands again. */
	}
	<FeatureRow visual={SCALE_CANDIDATE_COPY} note="previous candidate · abstract field, three modes, marks only">
		<ScaleGrid equalHeight thirdRole logos />
	</FeatureRow>

	{/* Held for comparison, not proposed. */}
	<FeatureRow visual={kv('scale')} note="fifth cut · mode, fleet, machines, stack">
		<ScaleSetup />
	</FeatureRow>

	{/* The incumbent, kept rendering below the candidates rather than replaced. */}
	<FeatureRow visual={kv('scale')}>
		<ScaleGrowth />
	</FeatureRow>

	{
		/* --- seventh cut ---------------------------------------------------------------------
	    Two deployment modes and nothing else. Hybrid storage leaves the drawing and joins the chip
	    list, where it always belonged: it is a choice of database, not a topology. The field is five
	    by three in one colour — the chips carry the kinds, so all it has left to say is one against
	    many, which is all it was ever good at. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleDuo · copy B · 673px</span>
			<span class="stage__note">card copy draft 2 · what you operate, and what happens on the bad day</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleDuo modes={SCALE_MODES_ALT} />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleDuo · animated · 673px</span>
			<span class="stage__note">ingest ripple · one pulse on the monolith, two hops across the stack</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleDuo modes={SCALE_MODES_ALT} animate />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleDuo · 673px</span>
			<span class="stage__note">primary candidate · two modes, one colour, words not marks</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleDuo />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleDuo · 440px</span>
			<span class="stage__note">the container a real 2-column section gives it</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 440px">
				<ScaleDuo />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleDuo · 335px</span>
			<span class="stage__note">phone · two cards and a five-wide field is the roomiest this has been</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ScaleDuo />
			</div>
		</div>
	</figure>

	{
		/* --- sixth cut -----------------------------------------------------------------------
	    Two topologies as peers, with hybrid storage drawn as the thing that joins them rather
	    than a step between them. The docs list TWO deployment architectures and put storage in a
	    separate table; all four combinations exist, so the three-card row was one axis pretending
	    to be another. Each card now states both of its ceilings, and the step between them is the
	    join's doing. */
	}

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScalePair · 673px</span>
			<span class="stage__note">sixth cut · two topologies, storage as the option across both</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScalePair />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScalePair · 440px</span>
			<span class="stage__note">the container a real 2-column section gives it</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 440px">
				<ScalePair />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScalePair · 335px</span>
			<span class="stage__note">phone · two cards have more room here than three ever did</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ScalePair />
			</div>
		</div>
	</figure>

	{
		/* Grouping: what STORES the telemetry on one line, what MOVES it on the next, rather than one
	    arbitrary run. It also makes the Hybrid-to-Cluster step read as "a second group appears". */
	}

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrid · grouped · 673px</span>
			<span class="stage__note">storage on one line, transport and coordination on the next</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleGrid equalHeight thirdRole grouped />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrid · logos grouped · 673px</span>
			<span class="stage__note">both at once · marks only, split into storage and transport</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleGrid equalHeight thirdRole logos grouped />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrid · logos grouped · 335px</span>
			<span class="stage__note">phone · a 12-unit silhouette with no word beside it</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ScaleGrid equalHeight thirdRole logos grouped />
			</div>
		</div>
	</figure>

	{
		/* The levelled cut with each technology's own mark in place of its chip, drawn monochrome so
	    four brand palettes do not land on a card built on one. This is the PRIMARY CANDIDATE, and
	    it renders in the first feature row above; these probes are the same thing at fixed widths. */
	}

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrid · logos · 673px</span>
			<span class="stage__note">primary candidate · marks only, no words, no chips</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleGrid equalHeight thirdRole logos />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrid · logos · 335px</span>
			<span class="stage__note">phone · a 28-unit mark with no word beside it</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ScaleGrid equalHeight thirdRole logos />
			</div>
		</div>
	</figure>

	{
		/* The abstract cut levelled: three cards of one height, so the growth is said only by what is
	    inside them. Carries the third colour in the cluster. A full-bleed field was tried alongside
	    this and removed — the card is 10 units wider than its content, so the cells met the card's
	    border and its rounded corners with nothing between them. */
	}

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrid · equal height · 673px</span>
			<span class="stage__note">abstract · one height for all three · third colour in the cluster</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleGrid equalHeight thirdRole />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrid · equal height · 440px</span>
			<span class="stage__note">the container a real 2-column section gives it</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 440px">
				<ScaleGrid equalHeight thirdRole />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrid · equal height · 335px</span>
			<span class="stage__note">phone · the levelled row is the one with least to go wrong here</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ScaleGrid equalHeight thirdRole />
			</div>
		</div>
	</figure>

	{
		/* --- abstract cut -------------------------------------------------------------------
	    A footprint rather than an inventory: a quiet field of squircles for capacity not yet
	    taken, and the few lit cells are what a deployment occupies. No legend, because two lit
	    colours joined by a bridge need no key. Nothing here is countable against a docs table —
	    which is both why it cannot be wrong and why it carries no fact a reader can act on. */
	}

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrid · 673px</span>
			<span class="stage__note">abstract · one cell, two joined, a connected patch</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleGrid />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrid · 440px</span>
			<span class="stage__note">abstract · the container a real 2-column section gives it</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 440px">
				<ScaleGrid />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrid · 335px</span>
			<span class="stage__note">abstract · phone · does the field survive as texture</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ScaleGrid />
			</div>
		</div>
	</figure>
</VisualPage>
