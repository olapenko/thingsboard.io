---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import FeatureRow from '@root/pages/internal/_FeatureRow.astro';
import ScaleChart from '@components/Landing/ScaleChart.astro';
import ScaleGrowth from '@components/Landing/ScaleGrowth.astro';
import ScaleMachines from '@components/Landing/ScaleMachines.astro';
import ScaleGrid from '@components/Landing/ScaleGrid.astro';
import ScaleSetup from '@components/Landing/ScaleSetup.astro';
import ScaleTiers from '@components/Landing/ScaleTiers.astro';
import { SCALE_TIERS_PAIR } from '@data/scale-visual';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * Scale — the growth chart and the alternatives it was chosen over.
 *
 * Its own route, so opening it compiles and renders this visual and nothing else. `_VisualPage`
 * carries what every visual's page shares: the strip of links between them, the retire control
 * and the stage chrome.
 */
---

<VisualPage visual="scale">
	{
		/* The scale half of "Deploy anywhere, scale without surprises", split off from the
	    deployment half. Every figure is from the repo's own 24h benchmarks rather than an
	    estimate — see src/data/scale-visual.ts for which scenario each one comes from. */
	}
	<FeatureRow visual={kv('scale')} note="fifth cut · candidate · mode, fleet, machines, stack">
		<ScaleSetup />
	</FeatureRow>

	{/* The incumbent, kept rendering below the candidate rather than replaced. */}
	<FeatureRow visual={kv('scale')}>
		<ScaleGrowth />
	</FeatureRow>

	{
		/* --- fifth cut ----------------------------------------------------------------------
	    Drawn from the slider proposal rather than from the benchmark tables. The machine count is
	    the story — one, three, twelve — and every tier is a range rather than a point, because a
	    point promises a number the workload decides whether to keep. See SCALE_SETUP in
	    src/data/scale-visual.ts for the arithmetic and for what the first drafts had wrong. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleSetup · 673px</span>
			<span class="stage__note">fifth cut · candidate · one machine, three, a cluster</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleSetup />
			</div>
		</div>
	</figure>

	{
		/* --- abstract cut -------------------------------------------------------------------
	    A footprint rather than an inventory: a quiet field of squircles for capacity not yet
	    taken, and the few lit cells are what a deployment occupies. No legend, because two lit
	    colours joined by a bridge need no key. Nothing here is countable against a docs table —
	    which is both why it cannot be wrong and why it carries no fact a reader can act on. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrid · 673px</span>
			<span class="stage__note">abstract · one cell, two joined, a connected patch</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleGrid />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrid · 440px</span>
			<span class="stage__note">abstract · the container a real 2-column section gives it</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 440px">
				<ScaleGrid />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrid · 335px</span>
			<span class="stage__note">abstract · phone · does the field survive as texture</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ScaleGrid />
			</div>
		</div>
	</figure>

	{
		/* The abstract cut levelled: three cards of one height, so the growth is said only by what is
	    inside them. Carries the third colour in the cluster. A full-bleed field was tried alongside
	    this and removed — the card is 10 units wider than its content, so the cells met the card's
	    border and its rounded corners with nothing between them. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrid · equal height · 673px</span>
			<span class="stage__note">abstract · one height for all three · third colour in the cluster</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleGrid equalHeight thirdRole />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrid · equal height · 440px</span>
			<span class="stage__note">the container a real 2-column section gives it</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 440px">
				<ScaleGrid equalHeight thirdRole />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrid · equal height · 335px</span>
			<span class="stage__note">phone · the levelled row is the one with least to go wrong here</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ScaleGrid equalHeight thirdRole />
			</div>
		</div>
	</figure>

	{
		/* The levelled cut with each technology's own mark in its chip, drawn monochrome so four
	    brand palettes do not land on a card built on one. Zookeeper has no Simple Icons mark and
	    falls back to the generic Apache feather — the one thing to check before this ships. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrid · logos · 673px</span>
			<span class="stage__note">abstract · marks only, no words · Zookeeper is a stand-in</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleGrid equalHeight thirdRole logos />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrid · logos · 335px</span>
			<span class="stage__note">phone · a 12-unit silhouette is the question here</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ScaleGrid equalHeight thirdRole logos />
			</div>
		</div>
	</figure>

	{
		/* Grouping: what STORES the telemetry on one line, what MOVES it on the next, rather than one
	    arbitrary run. It also makes the Hybrid-to-Cluster step read as "a second group appears". */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrid · grouped · 673px</span>
			<span class="stage__note">storage on one line, transport and coordination on the next</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleGrid equalHeight thirdRole grouped />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrid · logos grouped · 673px</span>
			<span class="stage__note">both at once · marks only, split into storage and transport</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleGrid equalHeight thirdRole logos grouped />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrid · logos grouped · 335px</span>
			<span class="stage__note">phone · a 12-unit silhouette with no word beside it</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ScaleGrid equalHeight thirdRole logos grouped />
			</div>
		</div>
	</figure>

	{
		/* The same cut with named machines instead of tiles. A `glyph` prop rather than a second
	    component, so the two share the layout and the data and differ only in what is stamped at
	    each position — the comparison is the drawing, not the arithmetic around it. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleSetup · icons · 673px</span>
			<span class="stage__note">fifth cut · variant · server, database, queue named rather than tiled</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleSetup glyph="icon" />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleSetup · icons · 335px</span>
			<span class="stage__note">variant · phone · where an icon's interior detail is the question</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ScaleSetup glyph="icon" />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleSetup · 440px</span>
			<span class="stage__note">fifth cut · the container a real 2-column section gives it</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 440px">
				<ScaleSetup />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleSetup · 335px</span>
			<span class="stage__note">fifth cut · phone · the cluster grid is the tight case</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ScaleSetup />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleChart · 673px</span>
			<span class="stage__note">draft · the width the feature row gives it</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleChart />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleChart · 440px</span>
			<span class="stage__note">the container a real 2-column section gives it at 1440</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 440px">
				<ScaleChart />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleChart · 335px</span>
			<span class="stage__note">phone · scales rather than reflows, as the family does</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ScaleChart />
			</div>
		</div>
	</figure>

	{
		/* --- second cut ---------------------------------------------------------------------
	    Kept beside the first rather than replacing it. The chart counts machines instead of CPU,
	    and carries three facts per tier instead of six — see src/data/scale-visual.ts for why
	    each machine count is a sum of a table in the docs and not an estimate. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleMachines · 2 tiers · 673px</span>
			<span class="stage__note">second cut · both counts are sums of a docs table</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleMachines tiers={SCALE_TIERS_PAIR} />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleMachines · 3 tiers · 673px</span>
			<span class="stage__note">second cut · the middle tier's count is a shape, not a sum</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleMachines />
			</div>
		</div>
	</figure>

	{
		/* The pair the whole trade turns on. Two tiers are 420 units wide and three are 640, so the
	    same phone hands them different units — this is where that stops being arithmetic. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleMachines · 2 tiers · 335px</span>
			<span class="stage__note">phone · 420 units native</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ScaleMachines tiers={SCALE_TIERS_PAIR} />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleMachines · 3 tiers · 335px</span>
			<span class="stage__note">phone · 640 units native, so the same type lands smaller</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ScaleMachines />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleMachines · 2 tiers · 440px</span>
			<span class="stage__note">the container a real 2-column section gives it at 1440</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 440px">
				<ScaleMachines tiers={SCALE_TIERS_PAIR} />
			</div>
		</div>
	</figure>

	{
		/* --- third cut ----------------------------------------------------------------------
	    Two quantities drawn as themselves — a bar to scale for the fleet, one glyph per machine —
	    and everything else a value or a tag. The sentences have gone to the section copy. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleTiers · 673px</span>
			<span class="stage__note">third cut · bar for the fleet, one icon per machine</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleTiers />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleTiers · 440px</span>
			<span class="stage__note">third cut · the container a real 2-column section gives it</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 440px">
				<ScaleTiers />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleTiers · 335px</span>
			<span class="stage__note">third cut · phone</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ScaleTiers />
			</div>
		</div>
	</figure>

	{
		/* --- fourth cut ---------------------------------------------------------------------
	    The one thing the other three leave out: growth. A single unbroken curve through the three
	    benchmarked device counts, split into one area per phase, with the shopping list for each
	    phase in the same three columns underneath. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrowth · 673px</span>
			<span class="stage__note">fourth cut · one curve, three areas, three phases</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<ScaleGrowth />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrowth · 440px</span>
			<span class="stage__note">fourth cut · the container a real 2-column section gives it</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 440px">
				<ScaleGrowth />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">ScaleGrowth · 335px</span>
			<span class="stage__note">fourth cut · phone · three columns is the tight case</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<ScaleGrowth />
			</div>
		</div>
	</figure>
</VisualPage>
