---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import Variant from '@root/pages/internal/_Variant.astro';
import PlatformRaised from '@components/Landing/PlatformRaised.astro';
import PlatformLoop from '@components/Landing/PlatformLoop.astro';
import { PLATFORM_COPY } from '@data/platform-visual';
import { kv } from '@root/pages/internal/_key-visuals';
import { HOME_INTRO } from '@data/home-intro';

/**
 * The platform overview — equipment, people, and the loop between them.
 *
 * NO FEATURE ROW on this page, unlike every other visual here. This one is a full-width section
 * diagram, not a media slot: a row hands its media 525px, and at 525 this composition is already in
 * its stacked form. Judging it in a row would be judging a different picture.
 *
 * The candidate is shown in the CENTRED section instead — the homepage's own statement block, with
 * the real copy, and the visual under it rather than beside it. That is where this one is headed:
 * first thing below the hero, above the five rows. The incumbent keeps `deskWidth`, a bare probe at
 * its native 1160, so the pair still says what the drawing does at its own size.
 *
 * `PlatformRaised` is the candidate and goes FIRST, with `PlatformLoop` under it as the incumbent.
 * That order is not cosmetic: put the candidate second and the incumbent quietly stays the
 * incumbent, because it is the one that got looked at first.
 *
 * The stacking threshold sits between the two views — 1160 is above it and 335 below — so the pair
 * inside each section brackets it. The intermediate widths that used to be here (1200, 1040, 960)
 * placed the threshold and are not worth carrying now that it is placed; the commit holds them.
 */
---

<VisualPage visual="platform">
	<p class="lede">{PLATFORM_COPY.body}</p>

	{
		/* The foundations strip is off in both components. It is three more things to read in the
	    densest part of the picture and it carries none of the argument, but it is the only claim
	    about what sits under the four stages — so it is switchable here rather than deleted, and the
	    switch covers every probe on the page at once so the two states are compared like for like. */
	}
	<div class="page-ctl">
		<span class="page-ctl__name">Foundations strip</span>
		<button type="button" data-found-toggle aria-pressed="false">Off</button>
	</div>

	<Variant
		visual={kv('platform')}
		component={PlatformRaised}
		intro={HOME_INTRO}
		name="PlatformRaised · centred section"
		note="candidate · the homepage statement over the visual, as the section it is headed for"
	/>

	<Variant
		visual={kv('platform')}
		component={PlatformRaised}
		deskWidth={1160}
		name="PlatformRaised"
		note="the same drawing on its own at native 1160, floor 13.5px — no section around it"
	/>

	<Variant
		visual={kv('platform')}
		component={PlatformLoop}
		deskWidth={1160}
		name="PlatformLoop"
		note="incumbent · flat platform, stage rail, verbs in indigo — the tighter cut"
	/>
</VisualPage>

<script>
	// The foundations switch. Sets the attribute both components' own CSS reads, on every view on the
	// page at once, and remembers the choice so a reload does not reset it mid-comparison. Both
	// components name their root `.plat`, scoped separately, so one selector reaches the candidate
	// and the incumbent alike.
	const KEY = 'launch-visuals:platform-foundations';
	const btn = document.querySelector<HTMLButtonElement>('[data-found-toggle]');
	const targets = Array.from(document.querySelectorAll<HTMLElement>('.plat'));

	const apply = (on: boolean) => {
		targets.forEach((t) => t.toggleAttribute('data-found', on));
		if (!btn) return;
		btn.setAttribute('aria-pressed', String(on));
		btn.textContent = on ? 'On' : 'Off';
	};

	let saved = false;
	try {
		saved = localStorage.getItem(KEY) === 'on';
	} catch {
		/* private window; the default is fine */
	}
	apply(saved);

	btn?.addEventListener('click', () => {
		const on = btn.getAttribute('aria-pressed') !== 'true';
		apply(on);
		try {
			localStorage.setItem(KEY, on ? 'on' : 'off');
		} catch {
			/* ignore */
		}
	});
</script>

<style lang="scss">
	@use '../../../styles/variables' as *;

	.lede {
		@include text-s;
		max-width: 1200px;
		margin: 0 auto $spacing-6;
		color: var(--color-text-secondary, #5b616e);
	}
</style>
