---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import PlatformLoop from '@components/Landing/PlatformLoop.astro';
import { PLATFORM_COPY } from '@data/platform-visual';

/**
 * The platform overview — equipment, people, and the loop between them.
 *
 * NO FEATURE ROW on this page, unlike every other visual here. This one is a full-width section
 * diagram, not a media slot: a feature row gives its media about 673px, and at 673 this
 * composition is already in its stacked form. Judging it in a row would be judging a different
 * picture. The widths below are the ones a full-bleed section actually gets.
 *
 * The probes bracket the stacking threshold deliberately — 1040 and 960 are the same visual either
 * side of the switch, and putting them next to each other is the only way to see whether the
 * threshold is in the right place.
 */
---

<VisualPage visual="platform">
	<p class="lede">{PLATFORM_COPY.body}</p>

	{
		[
			{ w: 1200, note: 'full-bleed section at a 1440 viewport · floor 14.0px' },
			{ w: 1160, note: 'native · floor 13.5px (the 1.15x cap starts at 1334)' },
			{ w: 1040, note: 'wide, last comfortable width · floor 12.1px' },
			{ w: 960, note: 'stacked · first width below the threshold, capped at 600' },
			{ w: 673, note: 'stacked · what a feature row would hand it' },
			{ w: 335, note: 'phone · floor 9.4px' },
		].map((probe) => (
			<figure class="stage" data-w="full">
				<figcaption class="stage__cap">
					<span class="stage__name">PlatformLoop · {probe.w}px</span>
					<span class="stage__note">{probe.note}</span>
				</figcaption>
				<div class="stage__frame stage__frame--plain">
					<div class="probe" style={`--probe: ${probe.w}px`}>
						<PlatformLoop />
					</div>
				</div>
			</figure>
		))
	}
</VisualPage>

<style lang="scss">
	@use '../../../styles/variables' as *;

	.lede {
		@include text-s;
		max-width: 1200px;
		margin: 0 auto $spacing-8;
		color: var(--color-text-secondary, #5b616e);
	}
</style>
