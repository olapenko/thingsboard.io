---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import FeatureRow from '@root/pages/internal/_FeatureRow.astro';
import DigitalTwin from '@components/Landing/DigitalTwin.astro';
import TwinCorridor from '@components/Landing/TwinCorridor.astro';
import TwinPlan from '@components/Landing/TwinPlan.astro';
import TwinUnit from '@components/Landing/TwinUnit.astro';
import { UNIT_GALLERY } from '@data/digital-twin-visual';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * Model your real world — the twin composition and its candidates.
 *
 * Its own route, so opening it compiles and renders this visual and nothing else. `_VisualPage`
 * carries what every visual's page shares: the strip of links between them, the retire control
 * and the stage chrome.
 */
---

<VisualPage visual="twin">
	{
		/* --- the label knob -------------------------------------------------------------------
	    Both pairs of captions in `TwinCorridor` — the stage names and the connector names — read one
	    inherited property, so setting it here turns every instance in this panel at once: the two
	    feature rows and all four probes, which is the point. A size is easy to argue about from a
	    screenshot and easy to settle by turning it in the row it ships in.

	    It writes to `localStorage` like the retire marks do, so a reload does not lose where you got
	    to. The number it lands on still has to be written into the component; this only finds it. */
	}
	<div class="page-ctl" data-label-ctl>
		<span class="page-ctl__name">Caption size</span>
		<input
			type="range"
			min="12"
			max="22"
			step="1"
			value="16"
			data-label-range
			aria-label="Caption size in design units"
		/>
		<span class="page-ctl__count" data-label-out>16u</span>
		<button type="button" data-label-reset>Reset to 16</button>
	</div>

	{
		/* --- the candidate ----------------------------------------------------------------------
	    This is the one the home preview shows, and the reason it is first: the zone on BOTH sides —
	    the unit nested in a Zone B frame inside the site on the left, and Zone B as the path's last
	    step on the right. The same containment twice, once as geometry and once as an address.

	    Everything under it is what it was judged against. The row below is the same routing without
	    the zone, the two plans are a different direction for the physical half, and `DigitalTwin` at
	    the foot is what it replaced. */
	}
	<FeatureRow
		visual={kv('twin')}
		note="THE CANDIDATE — on the home preview · zone on both sides, nested left and in the path right"
	>
		<TwinCorridor zone />
	</FeatureRow>

	{
		/* --- the same routing, one level shallower ----------------------------------------------
	    The site on both sides and no zone: the shorter reading, kept so the candidate above can be
	    judged against what it costs. The nesting buys each corridor about 19u.

	    What the routing does, in either version: the connectors leave the unit vertically and cross
	    overhead, which lets the gutter fall from 96u to 18u; three devices face three attributes in
	    the same order down both cards; and the twin carries the hierarchy the unit sits in rather
	    than a flat list. Each attribute's history takes the form of its kind — a line for a
	    measurement, a segment band for a state, which is how the platform's own State chart draws
	    one. 558 x 338. */
	}
	<FeatureRow visual={kv('twin')} note="the same routing without the zone — site on both sides">
		<TwinCorridor />
	</FeatureRow>

	{
		/* Both versions at both widths, in the same order each time, so the pair can be compared
	    down the page rather than across it. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">TwinCorridor · 525px</span>
			<span class="stage__note">the home row at 1440</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 525px">
				<TwinCorridor />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">TwinCorridor · zone · 525px</span>
			<span class="stage__note">the home row at 1440</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 525px">
				<TwinCorridor zone />
			</div>
		</div>
	</figure>

	{/* The scale-down, watched but not yet solved for: desktop and tablet first, phone after. */}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">TwinCorridor · 335px</span>
			<span class="stage__note">phone · beside DigitalTwin at the same width below</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<TwinCorridor />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">TwinCorridor · zone · 335px</span>
			<span class="stage__note">phone</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<TwinCorridor zone />
			</div>
		</div>
	</figure>

	{
		/* --- the plan, a third direction -------------------------------------------------------
	    The physical half drawn from above instead of as cards: the warehouse as a plan, the zone as
	    an area marked on its floor, the unit as a rectangle standing in it with its door drawn. No
	    device rows and no status light.

	    What to judge against the two rows above. Does containment read better as a place than as
	    nested rectangles — the twin says `Acme Inc > Warehouse 3 > Zone B` in words and this says it
	    in plan. And what does losing the device list cost, given the copy beside the visual promises
	    "devices" and only the twin's three rows imply them now. */
	}
	<FeatureRow visual={kv('twin')} note="draft — the physical half as a floor plan, seen from above">
		<TwinPlan />
	</FeatureRow>

	{
		/* --- the plan, among peers --------------------------------------------------------------
	    The same plan with three more cold rooms on it, faded and unnamed, and no door on any of
	    them. It changes what the picture is about: alone, the unit is THE cold storage unit and the
	    plan is its address; among others it is one of several, which is the truer thing for a
	    platform that models a whole estate. That is also why the subject is named `Cold storage 02`
	    here rather than by its type — every rectangle on that floor is a cold storage unit. */
	}
	<FeatureRow visual={kv('twin')} note="draft — the plan among its peers, no door, the subject named">
		<TwinPlan peers />
	</FeatureRow>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">TwinPlan · peers · 525px</span>
			<span class="stage__note">draft · the home row at 1440</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 525px">
				<TwinPlan peers />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">TwinPlan · 525px</span>
			<span class="stage__note">draft · the home row at 1440</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 525px">
				<TwinPlan />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">TwinPlan · 335px</span>
			<span class="stage__note">draft · phone</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<TwinPlan />
			</div>
		</div>
	</figure>

	{/* --- what it replaced, kept for comparison --------------------------------------------- */}
	<FeatureRow visual={kv('twin')} note="what TwinCorridor replaced — 630u, 12u floor">
		<DigitalTwin />
	</FeatureRow>

	{
		/* The arrangement nesting replaced: the unit on its own, with its site named nowhere. Kept
	    so the choice can still be judged, now that nesting is what the row above shows. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">DigitalTwin · flat</span>
			<span class="stage__note">superseded · the unit without its site</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<DigitalTwin nested={false} />
			</div>
		</div>
	</figure>

	{
		/* Other units the composition could hold, each at the width the unit has in the visual and
	    without a twin: the point is to judge the unit's card across subjects, not the mirror. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">TwinUnit · gallery</span>
			<span class="stage__note">other units the composition could hold · no twin</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="unit-row">{UNIT_GALLERY.map((u) => <TwinUnit unit={u} />)}</div>
		</div>
	</figure>

	{/* The same composition at the phone width, to check it survives the scale-down. */}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">DigitalTwin · 335px</span>
			<span class="stage__note">phone</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<DigitalTwin />
			</div>
		</div>
	</figure>
</VisualPage>

<style is:global>
	/* The stage chrome lives in `_VisualPage`'s own `is:global` block; this control belongs to this
	   route, so it sits here — but it still has to be global, because a scoped rule cannot reach
	   markup the page renders. It borrows `.page-ctl` for everything but the slider. */
	[data-label-ctl] input[type='range'] {
		width: 180px;
		accent-color: var(--color-primary, #3d50f5);
	}
</style>

<script>
	/**
	 * Turns `--kv-label`, which every `TwinCorridor` and `TwinPlan` on the page inherits.
	 *
	 * Set on the document rather than on a wrapper: the sandbox used to be one page of panels and
	 * this hung off the twin panel's own element, which the split into a route per visual removed.
	 * The page holds nothing but this visual now, so the root is the right place and there is no
	 * wrapper left to depend on.
	 *
	 * Sandbox-only: nothing outside this page sets the property, so the components fall back to their
	 * own default everywhere else. Whatever this settles on has to be typed into the component — the
	 * knob finds the number, it does not store it.
	 */
	const KEY = 'launch-visuals:twin-label';

	const root = document.documentElement;
	const range = document.querySelector<HTMLInputElement>('[data-label-range]');
	const out = document.querySelector<HTMLElement>('[data-label-out]');
	const reset = document.querySelector<HTMLButtonElement>('[data-label-reset]');

	if (range && out && reset) {
		const DEFAULT = range.value;

		const apply = (value: string, remember = true) => {
			range.value = value;
			out.textContent = `${value}u`;
			root.style.setProperty('--kv-label', value);
			if (!remember) return;
			try {
				localStorage.setItem(KEY, value);
			} catch {
				/* private window, cleared site data — the knob still works, it just will not persist */
			}
		};

		let saved: string | null = null;
		try {
			saved = localStorage.getItem(KEY);
		} catch {
			/* as above */
		}
		apply(saved ?? DEFAULT, false);

		range.addEventListener('input', () => apply(range.value));
		reset.addEventListener('click', () => {
			try {
				localStorage.removeItem(KEY);
			} catch {
				/* as above */
			}
			apply(DEFAULT, false);
		});
	}
</script>
