---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import FeatureRow from '@root/pages/internal/_FeatureRow.astro';
import WhiteLabelApp from '@components/Landing/WhiteLabelApp.astro';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * White-labeling — the branded app.
 *
 * Its own route, so opening it compiles and renders this visual and nothing else. `_VisualPage`
 * carries what every visual's page shares: the strip of links between them, the retire control
 * and the stage chrome.
 */
---

<VisualPage visual="whitelabel">
	{
		/* The published section shows a screenshot of the White Labeling settings form. This shows
	    the result instead: one app, three customers, and a control that swaps between them. */
	}
	<FeatureRow visual={kv('whitelabel')}>
		<WhiteLabelApp />
	</FeatureRow>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">WhiteLabelApp · 673px</span>
			<span class="stage__note">draft · rotates on its own, a click takes over</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<WhiteLabelApp />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">WhiteLabelApp · 440px</span>
			<span class="stage__note">the container a real 2-column section gives it at 1440</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 440px">
				<WhiteLabelApp />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">WhiteLabelApp · 335px · static</span>
			<span class="stage__note">phone, rotation off — the control is the only way through</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<WhiteLabelApp autoRotate={false} />
			</div>
		</div>
	</figure>
</VisualPage>
