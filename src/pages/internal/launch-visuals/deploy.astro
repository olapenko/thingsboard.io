---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import Variant from '@root/pages/internal/_Variant.astro';
import DeployFork from '@components/Landing/DeployFork.astro';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * Deploy anywhere — the fork.
 *
 * Its own route, so opening it compiles and renders this visual and nothing else. `_VisualPage`
 * carries what every visual's page shares: the strip of links between them and the promote/retire
 * control.
 */
---

<VisualPage visual="deploy">
	<Variant
		visual={kv('deploy')}
		component={DeployFork}
		name="DeployFork"
		note="one fork rather than three cards — private cloud is not a third tier, it is your own AWS account"
	/>
</VisualPage>
