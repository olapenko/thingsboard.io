---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import FeatureRow from '@root/pages/internal/_FeatureRow.astro';
import NormalizeSeries from '@components/Landing/NormalizeSeries.astro';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * Normalize — the transform flow.
 *
 * Its own route, so opening it compiles and renders this visual and nothing else. `_VisualPage`
 * carries what every visual's page shares: the strip of links between them, the retire control
 * and the stage chrome.
 */
---

<VisualPage visual="normalize">
	{
		/* First half of the design's "Turn IoT data into action" section. The second half — a rule
	    chain raising an alarm and notifying — is a separate argument and will be its own visual,
	    so the copy in this row still covers both and will need splitting with it. */
	}
	<FeatureRow visual={kv('normalize')}>
		<NormalizeSeries motion="pulse" />
	</FeatureRow>

	{
		/* `NormalizeFlow`'s stages were retired from this page and the home preview now renders this
	    component instead, so nothing renders the old one any more. It is still on disk, awaiting a
	    deletion commit of its own.

	    What is left here is the two motions at each width, adjacent, because the question this page
	    now answers is whether the movement adds anything — and that is only answerable against the
	    same drawing holding still. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">NormalizeSeries · 673px · pulse</span>
			<span class="stage__note">one pip per device, in and out a transit later</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<NormalizeSeries motion="pulse" />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">NormalizeSeries · 673px · still</span>
			<span class="stage__note">candidate as committed</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 673px">
				<NormalizeSeries />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">NormalizeSeries · 335px · pulse</span>
			<span class="stage__note">phone · where the pip is barely over a pixel</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<NormalizeSeries motion="pulse" />
			</div>
		</div>
	</figure>

	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">NormalizeSeries · 335px · still</span>
			<span class="stage__note">phone · candidate as committed</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="probe" style="--probe: 335px">
				<NormalizeSeries />
			</div>
		</div>
	</figure>
</VisualPage>
