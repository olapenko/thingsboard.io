---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import Variant from '@root/pages/internal/_Variant.astro';
import SolutionAppShell from '@components/Landing/SolutionAppShell.astro';
import SolutionFlow from '@components/Landing/SolutionFlow.astro';
import { SOLUTION_CASES, SOLUTION_RAIL } from '@data/solution-flow';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * Device to end-user — the flow, and the app shell it ends in.
 *
 * Its own route, so opening it compiles and renders this visual and nothing else. `_VisualPage`
 * carries what every visual's page shares: the strip of links between them and the promote/retire
 * control.
 */
---

<VisualPage visual="solution">
	<Variant
		visual={kv('solution')}
		component={SolutionFlow}
		imageFirst
		name="SolutionFlow"
		note="candidate · scales as a whole rather than reflowing, so it is the same picture at every width"
	/>

	{
		/* An EXHIBIT, not a direction: three use cases side by side in the same shell, which is the
	    claim the visual makes taken apart so it can be checked. Nothing here is promoted or retired —
	    the way to be rid of it is to delete it.

	    Wording and metrics come from the published pages in `src/data/use-cases/` rather than being
	    invented, so the copy can move to a marketing page without being re-checked. Deliberately
	    three DIFFERENT industries with the same panel shape: that similarity is what shows the app
	    is configuration. */
	}
	<figure class="stage" data-w="full">
		<figcaption class="stage__cap">
			<span class="stage__name">SolutionAppShell · 3 use cases</span>
			<span class="stage__note">exhibit · static, for comparison</span>
		</figcaption>
		<div class="stage__frame stage__frame--plain">
			<div class="dash-row">
				{
					SOLUTION_CASES.map((c) => (
						<div class="dash-row__item">
							<SolutionAppShell rail={SOLUTION_RAIL} cases={[c]} animate />
							<p class="dash-row__cap">{c.source}</p>
						</div>
					))
				}
			</div>
		</div>
	</figure>
</VisualPage>
