---
import PlaygroundLayout from '@layouts/PlaygroundLayout.astro';
import Tiles from '@root/pages/internal/_Tiles.astro';
import { AREAS } from '@root/pages/internal/_areas';

/**
 * THE HUB: `/internal/`, the sandbox's front page on the `lab` branch. One tile per area, each
 * opening on its overview; the floating island at the bottom-left does the same from any page.
 *
 * `lab` is `handoff` plus this sandbox: everything under `/internal/` is review tooling, `noindex`,
 * and never merges back. What a review decides is rebuilt as a `feat/` branch off `handoff`.
 */
const BLURBS: Record<string, { blurb: string; icon: string; source: string }> = {
	homepages: {
		blurb:
			'The running orders the homepage can take, side by side; each opens as the real page, and the island switches between them without losing your place.',
		icon: 'tabler:layout-list',
		source: 'src/data/home-compositions.ts',
	},
	chrome: {
		blurb: 'Header, footer, cookie notice and chat: every variation the site supports, as the real page in frames.',
		icon: 'tabler:app-window',
		source: 'src/pages/internal/chrome/',
	},
	design: {
		blurb:
			'What the redesigned pages are built from: the foundations, the type roles, the ui/ components live, and an inventory of where the pages use each piece. Measured from what rendered.',
		icon: 'tabler:components',
		source: 'src/pages/internal/_design.ts',
	},
};
---

<PlaygroundLayout
	title="Internal"
	description="Review pages for the site's redesign. The real pages are the reference; these are where the pieces are judged one at a time."
>
	<Tiles tiles={AREAS.map((a) => ({ href: a.pages[0].href, label: a.label, ...BLURBS[a.id] }))} />
</PlaygroundLayout>
