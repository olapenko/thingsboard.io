---
import { Icon } from 'astro-icon/components';
import PlaygroundLayout from '@layouts/PlaygroundLayout.astro';
import { KEY_VISUALS, kv } from '@root/pages/internal/_key-visuals';

/**
 * One visual's page in the sandbox: the shell every one of them shares.
 *
 * The sandbox used to be a single page holding all nine visuals as tab panels. Looking at six
 * stages meant compiling and rendering fifty-eight, and the tab strip was machinery that existed
 * only because they were on one page. Now each visual is its own route and its own file, and this
 * carries what they have in common — the strip of links between them, the promote/retire control,
 * and the chrome the exhibits use.
 *
 * The chrome is `is:global` on purpose, not scoped: the exhibits are written in the PAGE that uses
 * this component, and an Astro scoped rule only matches markup in its own file. Scoped here, every
 * probe in the sandbox would silently lose its width.
 */

interface Props {
	/** The key-visual id this page shows. Names the page, and keys its marks. */
	visual: string;
}

const { visual } = Astro.props;
const me = kv(visual);

/**
 * Where the strip's divider goes: after the last visual that is on the homepage — a row, or (for
 * `ai`) a section of its own.
 *
 * Counted from the array rather than typed, so putting a sixth row on the page moves the rule by
 * moving the entry — the order and the seam cannot disagree.
 */
const ON_HOME = ['platform', 'connect', 'solution', 'twin', 'ai', 'normalize', 'scale'];
const HOME_COUNT = KEY_VISUALS.filter((v) => ON_HOME.includes(v.id)).length;

/**
 * FRAME MODE. `?frame=<visual/name>` turns this page into one direction's row and nothing else, so a
 * phone preview can load it in a 375px iframe and have the row's own media queries fire against a
 * real phone viewport. It is the same route rather than one of its own, which is the point: the
 * components and their props are already here, and a separate page would have needed a registry
 * mapping keys back to components — a second place for the truth to live.
 *
 * It is done in the BROWSER, not here. These routes are prerendered (static output, no adapter), so
 * `Astro.url.searchParams` is empty at build time and the server cannot see which frame was asked
 * for. The script below reads the query, lifts that section's row out, and drops everything else.
 * The cost is that the server still renders the whole page per frame; `loading="lazy"` keeps that
 * off the critical path. What stops a frame loading frames of its own is NOT this trim — the phone
 * iframes ship `data-src`, and only the top-level page gives them a `src` (see `_Variant`).
 */
---

<PlaygroundLayout title={me.label} description={me.title ?? 'Directions for one key visual.'}>
	{
		/* Every visual one click away, the current one marked rather than linked, in the order the
	    homepage runs them.

	    The rule after `scale` is the seam in that order: everything before it is a row on the
	    homepage, everything after is drawn and waiting for a section. It was implied by the order
	    and invisible, which is the kind of thing that gets forgotten between sessions.

	    The way back to the index is the icon, not a word. It was the word "Sandbox" in grey mono,
	    sitting at the head of a row of pills and reading as a label for them rather than as a link
	    out — and `InternalNav`, fixed in the corner of every one of these pages, already carries a
	    "Sandbox" link. One of the two had to stop being a word. */
	}
	<nav class="vnav" slot="nav" aria-label="Key visual">
		<a class="vnav__up" href="/internal/launch-visuals/" title="All visuals" aria-label="All visuals">
			<Icon name="tabler:layout-grid" aria-hidden="true" />
		</a>
		{
			KEY_VISUALS.map((v, i) => (
				<Fragment>
					{i === HOME_COUNT && <span class="vnav__seam" aria-hidden="true" />}
					{v.id === visual ? (
						<span class="vnav__here" aria-current="page">
							{v.label}
						</span>
					) : (
						<a class="vnav__link" href={`/internal/launch-visuals/${v.id}/`}>
							{v.label}
						</a>
					)}
				</Fragment>
			))
		}
	</nav>

	{
		/* Two commands, and the unit both of them act on is the DIRECTION.
	    The judgement about a direction is only good while you are looking at it — so it is made
	    there, in the section's own header, and collected here.

	    Promote and retire are not opposites of different weight: one says this is the one, the other
	    says this one is done. Having only retire meant the good news had nowhere to go, so the way
	    to record a winner was to retire everything else, which reads identically to abandoning the
	    whole visual.

	    Marking is not doing. It records a decision in localStorage; the promotion is carried out by
	    putting the component on the homepage and the retirement by deleting files, both of which are
	    separate commits and a revert if they turn out to be wrong. The store is shared across every
	    visual's page, so the counts and the copied list are the whole sandbox, not just this page.
	    Copy it before clearing site data — this is the only place it lives. */
	}
	{
		/* The ground under every desktop row on the page.

	    The homepage alternates its rows, so which one a visual gets is decided by where its row
	    happens to fall — and the two grounds are not equally kind to a pale diagram. A visual that
	    reads on #f5f6ff can lose its lightest strokes on white, and one drawn on white can look like
	    a card sitting on the tint. Neither is the ground: both are, for three rows and two.

	    Always visible, unlike the marks bar, because it applies whether or not anything is marked.
	    Sandbox-only — nothing sets `data-ground` on the homepage, so the rule below stays inert
	    there. */
	}
	{
		(
			<>
				<div class="page-ctl" role="group" aria-label="Row ground" data-ground-switch>
					<span class="page-ctl__name">Row ground</span>
					<button type="button" data-ground-pick="tint" aria-pressed="true">
						Tint
					</button>
					<button type="button" data-ground-pick="white" aria-pressed="false">
						White
					</button>
				</div>

				<div class="page-ctl" data-mark-bar hidden>
					<span class="page-ctl__name">Marked</span>
					<span class="page-ctl__count page-ctl__count--up" data-mark-count="promote">
						0
					</span>
					<span class="page-ctl__lbl">promote</span>
					<span class="page-ctl__count" data-mark-count="retire">
						0
					</span>
					<span class="page-ctl__lbl">retire</span>
					<button type="button" data-mark-copy>
						Copy list
					</button>
					<button type="button" data-mark-hide aria-pressed="false">
						Hide retired
					</button>
					<button type="button" data-mark-clear>
						Clear marks
					</button>
				</div>
			</>
		)
	}

	<slot />
</PlaygroundLayout>

<script>
	/**
	 * FRAME MODE comes first, and everything else is in the `else`.
	 *
	 * `?frame=<key>` means this document is inside a phone preview's iframe. The server could not do
	 * the picking — these routes are prerendered, so `Astro.url.searchParams` is empty at build time
	 * — so the page renders in full and is cut down to one row here.
	 *
	 * Cutting it down rather than hiding the rest is deliberate: it takes the other sections' scripts
	 * and players out with them. It is not what keeps a frame from loading frames of its own — it
	 * used to be, and lost that race to lazy loading; the `data-src` in `_Variant` is.
	 */
	const FRAME = new URLSearchParams(location.search).get('frame');
	const GROUND_KEY = 'launch-visuals:ground';

	const readGround = (): string => {
		try {
			return localStorage.getItem(GROUND_KEY) === 'white' ? 'white' : 'tint';
		} catch {
			return 'tint';
		}
	};

	if (FRAME) {
		document.documentElement.dataset.kvFrame = '';
		document.documentElement.dataset.ground = readGround();

		const row = document.querySelector(`.vx[data-vx-key="${CSS.escape(FRAME)}"] [data-vx-row]`);

		/**
		 * Carry the icon definitions across with the row.
		 *
		 * `astro-icon` writes each glyph's `<symbol>` inline in its FIRST use on the page and a bare
		 * `<use href="#ai:…">` everywhere after. Both the section badge and every icon inside a visual
		 * go through it, and on a page of twelve directions the definitions therefore all sit in the
		 * first one. Keeping row seven and dropping the rest left seven's `<use>` pointing at nothing:
		 * a 40px badge tile with no glyph in it, which is what the phone previews were showing — ten
		 * of eleven on the connect page, every one except the first.
		 *
		 * So every symbol NOT already inside the row comes along, in a hidden sprite. Filtered rather
		 * than cloned wholesale, because a duplicate id would shadow the real one in the row itself.
		 */
		if (row) {
			const orphans = Array.from(document.querySelectorAll('symbol[id]')).filter((sym) => !row.contains(sym));
			const sprite = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
			sprite.setAttribute('aria-hidden', 'true');
			sprite.setAttribute('style', 'position:absolute;width:0;height:0;overflow:hidden');
			orphans.forEach((sym) => sprite.appendChild(sym.cloneNode(true)));
			document.body.replaceChildren(sprite, row);
		}

		/**
		 * An iframe has no intrinsic height — it defaults to 150px and clips. Only this document knows
		 * how tall its row came out, so it measures itself and says; the parent sets the iframe.
		 *
		 * Re-measured on resize, on any box change, and after fonts land, because a row whose copy is
		 * still in the fallback face is a different height from the same row a moment later.
		 */
		const post = () => {
			const h = Math.ceil(document.documentElement.getBoundingClientRect().height);
			window.parent.postMessage({ kvFrameHeight: h, kvFrameKey: FRAME }, '*');
		};
		post();
		window.addEventListener('load', post);
		window.addEventListener('resize', post);
		if ('ResizeObserver' in window) new ResizeObserver(post).observe(document.documentElement);
		document.fonts?.ready.then(post);

		// The page's ground toggle writes to localStorage, which fires `storage` in every OTHER
		// same-origin document — that is these frames. Without it, flipping the toggle would leave
		// twelve phones on the old ground until a reload.
		window.addEventListener('storage', (e) => {
			if (e.key === GROUND_KEY) document.documentElement.dataset.ground = readGround();
		});
	} else {
		// The phone previews get their `src` here, from the top-level page only — see the note on
		// `data-src` in `_Variant`. This branch never runs inside a frame, so a frame's own phone
		// iframes stay empty and it cannot load the page again. `loading="lazy"` is on the element,
		// so they still wait until they are near the viewport.
		document.querySelectorAll<HTMLIFrameElement>('iframe[data-vx-phone][data-src]').forEach((f) => {
			f.src = f.dataset.src!;
		});

		/**
		 * The promote / retire control.
		 *
		 * Every `[data-variant]` section gets two buttons in its header. A section is in one of three
		 * states — unmarked, promoted, retired — and the buttons toggle between them, so pressing
		 * Promote on something already retired moves it rather than needing the retire cleared first.
		 *
		 * A direction is keyed by `visual/name`, written by `_Variant`, and stored WITH its label. The
		 * key alone would rot the first time a name was edited; the label alone is not unique. Together
		 * they survive either one changing, which matters because the list is read back days later by
		 * someone deleting files or moving a component onto the homepage.
		 *
		 * Nothing here changes a file. It writes a decision down at the moment the decision is good.
		 */
		const MARK_KEY = 'launch-visuals:marks';

		type State = 'promote' | 'retire';
		type Mark = { state: State; label: string };
		type Marks = Record<string, Mark>;

		const readMarks = (): Marks => {
			try {
				return JSON.parse(localStorage.getItem(MARK_KEY) || '{}') as Marks;
			} catch {
				return {};
			}
		};
		const writeMarks = (m: Marks) => {
			try {
				localStorage.setItem(MARK_KEY, JSON.stringify(m));
			} catch {
				/* private window, cleared site data — the marks are a convenience, not the work */
			}
		};

		{
			const bar = document.querySelector<HTMLElement>('[data-mark-bar]');
			const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-variant]'));

			const paint = () => {
				const marks = readMarks();
				sections.forEach((s) => {
					const mark = marks[s.dataset.vxKey ?? ''];
					if (mark) s.dataset.vxState = mark.state;
					else delete s.dataset.vxState;
					s.querySelectorAll<HTMLButtonElement>('[data-vx-cmd]').forEach((b) =>
						b.setAttribute('aria-pressed', String(b.dataset.vxCmd === mark?.state))
					);
				});

				const all = Object.values(marks);
				(['promote', 'retire'] as State[]).forEach((state) => {
					const el = document.querySelector<HTMLElement>(`[data-mark-count="${state}"]`);
					if (el) el.textContent = String(all.filter((m) => m.state === state).length);
				});
				if (bar) bar.hidden = all.length === 0;
			};

			sections.forEach((section) => {
				const slot = section.querySelector('[data-vx-cmds]');
				const key = section.dataset.vxKey;
				const label = section.dataset.vxLabel ?? key ?? '';
				if (!slot || !key) return;

				(
					[
						['promote', 'Promote', 'This is the one to ship'],
						['retire', 'Retire', 'Done with this direction'],
					] as const
				).forEach(([state, text, title]) => {
					const btn = document.createElement('button');
					btn.type = 'button';
					btn.className = 'vx__cmd';
					btn.dataset.vxCmd = state;
					btn.title = title;
					btn.textContent = text;
					btn.setAttribute('aria-pressed', 'false');
					btn.addEventListener('click', () => {
						const marks = readMarks();
						// Pressing the state it already has clears it; pressing the other one moves it.
						if (marks[key]?.state === state) delete marks[key];
						else marks[key] = { state, label };
						writeMarks(marks);
						paint();
					});
					slot.appendChild(btn);
				});
			});

			// Promotions first: the list is read top down by whoever acts on it, and what to ship is a
			// different job from what to delete.
			document.querySelector('[data-mark-copy]')?.addEventListener('click', () => {
				const marks = readMarks();
				const rows = (state: State) =>
					Object.entries(marks)
						.filter(([, m]) => m.state === state)
						.map(([k, m]) => `${k}\t${m.label}`);
				const text = [
					...(rows('promote').length ? ['PROMOTE', ...rows('promote'), ''] : []),
					...(rows('retire').length ? ['RETIRE', ...rows('retire')] : []),
				].join('\n');
				navigator.clipboard?.writeText(text);
			});

			// Retired sections are dimmed, not hidden, so a mark can be reconsidered. This hides them,
			// which is the only way to see what the page would look like after the cleanup.
			document.querySelector<HTMLButtonElement>('[data-mark-hide]')?.addEventListener('click', (e) => {
				const btn = e.currentTarget as HTMLButtonElement;
				const on = btn.getAttribute('aria-pressed') === 'true';
				btn.setAttribute('aria-pressed', on ? 'false' : 'true');
				btn.textContent = on ? 'Hide retired' : 'Retired hidden';
				document.documentElement.toggleAttribute('data-hide-retired', !on);
			});

			document.querySelector('[data-mark-clear]')?.addEventListener('click', () => {
				writeMarks({});
				paint();
			});

			paint();
		}

		{
			/**
			 * The ground switch. Sets `data-ground` on the document, which the rule in this file's global
			 * block reads, and remembers the pick so a reload does not reset it mid-comparison.
			 *
			 * On the document rather than on each row: every row on the page moves together, which is the
			 * only way the comparison is between GROUNDS rather than between rows.
			 */
			const picks = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-ground-pick]'));

			const applyGround = (value: string) => {
				document.documentElement.dataset.ground = value;
				picks.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.groundPick === value)));
			};

			let savedGround: string | null = null;
			try {
				savedGround = localStorage.getItem(GROUND_KEY);
			} catch {
				/* private window; tint is the default and that is fine */
			}
			applyGround(savedGround === 'white' ? 'white' : 'tint');

			picks.forEach((b) =>
				b.addEventListener('click', () => {
					const value = b.dataset.groundPick ?? 'tint';
					applyGround(value);
					try {
						localStorage.setItem(GROUND_KEY, value);
					} catch {
						/* ignore */
					}
				})
			);

			// The phone previews are iframes of this same page, so each one runs this script too and reads
			// the stored ground at load. `storage` fires in every OTHER same-origin document when the key
			// changes, which is exactly the frames — so flipping the toggle moves them with the page
			// rather than leaving twelve phones on yesterday's ground until a reload.
			window.addEventListener('storage', (e) => {
				if (e.key === GROUND_KEY) applyGround(e.newValue === 'white' ? 'white' : 'tint');
			});
		}

		{
			// Parent side. Each frame says how tall it came out and which direction it is; the message
			// names its key so twelve of them on one page cannot resize each other.
			window.addEventListener('message', (e) => {
				if (e.source === window || typeof e.data !== 'object' || !e.data) return;
				const { kvFrameHeight, kvFrameKey } = e.data as { kvFrameHeight?: number; kvFrameKey?: string };
				if (typeof kvFrameHeight !== 'number' || !kvFrameKey) return;
				const frameEl = document.querySelector<HTMLIFrameElement>(`[data-vx-phone="${CSS.escape(kvFrameKey)}"]`);
				if (frameEl) frameEl.style.height = `${kvFrameHeight}px`;
			});
		}
	}
</script>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	// --- the commands in a variant's header ------------------------------------------------------
	//
	// Global because the buttons are built in the script above and appended into `_Variant`'s markup,
	// so there is no one file a scoped rule could be written in that would match them.

	.vx__cmd {
		@include text-xs;
		padding: 2px $spacing-3;
		border: 1px solid var(--color-border, #ebebeb);
		border-radius: $radius-md;
		background: none;
		font-family: $font-family-mono;
		color: var(--color-text-secondary, #5b616e);
		// Quiet until wanted: two of these on every section would read as a page full of buttons.
		opacity: 0;
		cursor: pointer;

		&:hover,
		&:focus-visible {
			color: var(--color-text, #17181c);
		}

		&[aria-pressed='true'] {
			border-color: transparent;
			color: #fff;
		}

		&[data-vx-cmd='promote'][aria-pressed='true'] {
			background: $color-brand;
		}

		&[data-vx-cmd='retire'][aria-pressed='true'] {
			background: var(--color-text, #17181c);
		}
	}

	.vx:hover .vx__cmd,
	.vx__cmd:focus-visible,
	.vx[data-vx-state] .vx__cmd {
		opacity: 1;
	}

	:root[data-hide-retired] .vx[data-vx-state='retire'] {
		display: none;
	}

	// --- frame mode ------------------------------------------------------------------------------
	//
	// Inside a phone preview's iframe the document holds one row and nothing else, so the playground's
	// own page padding has to go: the row paints its ground edge to edge on a phone, and 40px of white
	// around it would be a margin no phone has.
	:root[data-kv-frame] body {
		padding: 0;
	}

	// Astro injects its dev toolbar into every document, and a phone preview is a document — so each
	// frame was drawing a floating toolbar over the bottom of the row it exists to show, and
	// measuring itself tall enough to hold one. Dev-only markup, so this costs nothing in a build.
	:root[data-kv-frame] astro-dev-toolbar {
		display: none;
	}

	// --- the ground under the desktop rows -------------------------------------------------------
	//
	// `_home-rows.scss` paints the wash with `:root .new-rows .feature-block-section:nth-child(odd)`,
	// which is (0,4,0) — and in the sandbox every section holds ONE row, so nth-child(odd) always
	// matches and every row would be tinted. This is (0,5,0) on the attribute, so it wins outright
	// rather than tying and being settled by which file the bundler emitted last.
	//
	// It lives here, not in `_home-rows.scss`: that file is the homepage's row and the sandbox reads
	// it, so nothing sandbox-only belongs in it.
	:root[data-ground='white'] .new-rows .feature-block-section:nth-child(odd) {
		background: none;
	}

	// --- exhibits ---------------------------------------------------------------------------------
	//
	// What is left of `.stage` after the refactor. A direction is a `_Variant`; a stage is a
	// TECHNICAL exhibit — a breakpoint being pinned down, a component's own parts laid out, a
	// measurement. They are not versions and carry no promote or retire, because the way to be rid
	// of one is to delete it.

	.stage {
		margin: 0 auto $spacing-16;

		&[data-w='full'] {
			max-width: 1200px;
		}
		&[data-w='half'] {
			max-width: 600px;
		}
		&[data-w='card'] {
			max-width: 380px;
		}
	}

	.stage__cap {
		display: flex;
		align-items: baseline;
		gap: $spacing-3;
		margin-bottom: $spacing-3;
		padding-bottom: $spacing-2;
		border-bottom: 1px solid var(--sl-color-hairline-light);
	}

	.stage__name {
		@include card-title-sm;
		font-family: $font-family-mono;
	}

	.stage__note {
		@include text-xs;
		color: var(--color-text-secondary, #5b616e);
	}

	.stage__frame {
		// The checkerboard shows where a visual's own background stops and the page's begins —
		// a transparent edge is invisible against a plain white frame.
		background:
			linear-gradient(45deg, #f2f4f8 25%, transparent 25%, transparent 75%, #f2f4f8 75%),
			linear-gradient(45deg, #f2f4f8 25%, transparent 25%, transparent 75%, #f2f4f8 75%);
		background-position:
			0 0,
			8px 8px;
		background-size: 16px 16px;
		border-radius: $radius-xl;
	}

	// For visuals that carry their own white surface: the checkerboard reads as a background
	// competing with the card fills rather than as absence of one.
	.stage__frame--plain {
		background: none;
	}

	// --- the page's own bar -----------------------------------------------------------------------

	.page-ctl {
		display: flex;
		align-items: center;
		gap: $spacing-2;
		max-width: 1200px;
		margin: 0 auto $spacing-10;

		// `display: flex` above beats the UA sheet's `[hidden] { display: none }` on specificity, so
		// the bar sat on every page reading "0 promote 0 retire" however the script set `hidden`.
		&[hidden] {
			display: none;
		}

		button {
			@include text-xs;
			padding: $spacing-1 $spacing-3;
			border: 1px solid var(--sl-color-hairline-light);
			border-radius: $radius-md;
			background: none;
			font-weight: $font-weight-medium;
			color: var(--color-text-secondary, #5b616e);
			cursor: pointer;

			&[aria-pressed='true'] {
				border-color: var(--color-text, #17181c);
				background: var(--color-text, #17181c);
				color: #fff;
			}
		}
	}

	.page-ctl__name {
		@include text-xs;
		margin-right: $spacing-1;
		font-family: $font-family-mono;
		color: var(--color-text-secondary, #5b616e);
	}

	.page-ctl__lbl {
		@include text-xs;
		margin-right: $spacing-2;
		color: var(--color-text-secondary, #5b616e);
	}

	.page-ctl__count {
		@include text-xs;
		min-width: 1.6em;
		padding: 0 $spacing-1;
		border-radius: $radius-sm;
		background: var(--color-text, #17181c);
		font-family: $font-family-mono;
		text-align: center;
		color: #fff;
	}

	// Promotions are the brand colour wherever they appear, so the bar and the buttons agree.
	.page-ctl__count--up {
		background: $color-brand;
	}

	// A hard-set width so the composition is judged at a known size rather than whatever the page
	// happens to give it. Each probe names its own width; the dashed edge shows exactly how much room
	// the visual was handed, so an upscale cap or a floor is visible as space rather than guessed.
	.probe {
		width: var(--probe, 630px);
		max-width: 100%;
		margin: 0 auto;
		// An outline, not a border or padding: it must not eat into the width being measured.
		outline: 1px dashed var(--color-border, #ebebeb);
		outline-offset: $spacing-3;
		border-radius: $radius-sm;
	}

	// Each shell at the width it has in the key visual — measured 258.67px, the 1.6fr app column of
	// a 630px composition — so what gets judged here is what ships. This row is a technical exhibit,
	// so it is free to be wider than the visual it serves.
	.dash-row {
		display: grid;
		grid-template-columns: repeat(3, 259px);
		justify-content: center;
		gap: $spacing-5;
	}

	// Each unit at the width it has in the twin visual — 243px, the 1fr column of a 630px
	// composition split 1 : 96px : 1.2 — so what gets judged here is what ships.
	.unit-row {
		display: grid;
		grid-template-columns: repeat(auto-fill, 243px);
		justify-content: center;
		align-items: start;
		gap: $spacing-5;
	}

	.dash-row__cap {
		@include text-xs;
		margin: $spacing-3 0 0;
		font-family: $font-family-mono;
		color: var(--color-text-secondary, #5b616e);
	}
</style>

<style lang="scss">
	@use '../../styles/variables' as *;

	// The strip of links between visuals. Replaced a tab strip, and is a different thing: a tab hid
	// eight panels that were still on the page, this leaves them on disk.
	//
	// STICKY, because these pages run to twelve thousand pixels and the strip was only reachable from
	// the top of one. It is what you use after deciding something, which is exactly when you are at
	// the bottom.
	//
	// FULL BLEED, by cancelling the playground's body padding on three sides and paying it back as
	// its own. A bar that stops 24px short of the window does not read as a bar; it reads as a row of
	// pills that happens not to scroll. The negative top margin is what lets it sit against the top
	// edge rather than sliding up to it — it is the first element in the document now, above the
	// page's own heading, because a page title is not navigation.
	//
	// It needs an opaque background: sticky only takes it out of flow, so without one the rows scroll
	// through it. Opaque rather than a blur — what passes under is the tinted row, and a blur would
	// tint the strip along with it.
	.vnav {
		position: sticky;
		top: 0;
		z-index: 10;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 2px;
		margin: calc(-1 * #{$spacing-10}) calc(-1 * #{$spacing-6}) $spacing-10;
		padding: $spacing-2 $spacing-6;
		background: #fff;
		border-bottom: 1px solid var(--color-border, #ebebeb);
	}

	// The way out, as a mark. See the note on the markup for why it stopped being the word "Sandbox".
	.vnav__up {
		display: grid;
		place-items: center;
		width: 24px;
		height: 24px;
		margin-right: $spacing-2;
		border-radius: $radius-sm;
		color: var(--color-text-secondary, #5b616e);

		[data-icon] {
			width: 16px;
			height: 16px;
		}

		&:hover,
		&:focus-visible {
			background: var(--sl-color-hairline-light, #ebebeb);
			color: var(--color-text, #17181c);
		}
	}

	// The seam between what is on the homepage and what is not. A rule rather than a gap: a gap in a
	// wrapping row is just where a line happened to break.
	.vnav__seam {
		width: 1px;
		height: 14px;
		margin: 0 $spacing-2;
		background: var(--color-border, #ebebeb);
	}

	// Compact: 12px in a 2px gutter, so ten of them hold one line at the measure these pages are read
	// at. They were 14px in a 12px gutter and wrapped to two.
	.vnav__link,
	.vnav__here {
		@include text-xs;
		padding: 3px $spacing-2;
		border-radius: $radius-sm;
		font-weight: $font-weight-medium;
		line-height: 1.5;
		text-decoration: none;
		white-space: nowrap;
	}

	.vnav__link {
		color: var(--color-text-secondary, #5b616e);

		&:hover,
		&:focus-visible {
			background: var(--sl-color-hairline-light, #ebebeb);
			color: var(--color-text, #17181c);
		}
	}

	.vnav__here {
		background: var(--color-text, #17181c);
		color: #fff;
	}
</style>
