		}
	}

	.vx-cmd {
		@include text-xs;
		display: inline-flex;
		align-items: center;
		gap: 4px;
		height: 28px;
		padding: 0 10px 0 8px;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: $radius-md;
		background: var(--color-bg-surface, #fff);
		font-family: inherit;
		font-weight: $font-weight-medium;
		color: var(--color-text-secondary, #5b616e);
		cursor: pointer;

		:global([data-icon]) {
			width: 15px;
			height: 15px;
		}

		&:hover {
			border-color: var(--color-border, #c9ccd4);
			color: var(--color-text, #17181c);
		}

		&:focus-visible {
			outline: 2px solid $color-brand;
			outline-offset: 2px;
		}

		&[data-vx-cmd='promote'][aria-pressed='true'] {
			border-color: #1f8b4d;
			background: #1f8b4d;
			color: #fff;
		}

		&[data-vx-cmd='retire'][aria-pressed='true'] {
