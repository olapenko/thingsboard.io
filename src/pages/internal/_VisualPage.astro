---
import PlaygroundLayout from '@layouts/PlaygroundLayout.astro';
import { KEY_VISUALS, kv } from '@root/pages/internal/_key-visuals';

/**
 * One visual's page in the sandbox: the shell every one of them shares.
 *
 * The sandbox used to be a single page holding all nine visuals as tab panels. Looking at six
 * stages meant compiling and rendering fifty-eight, and the tab strip was machinery that existed
 * only because they were on one page. Now each visual is its own route and its own file, and this
 * carries what they have in common — the strip of links between them, the retire control, and the
 * stage chrome.
 *
 * The chrome is `is:global` on purpose, not scoped: the stages are written in the PAGE that uses
 * this component, and an Astro scoped rule only matches markup in its own file. Scoped here, every
 * probe in the sandbox would silently lose its width.
 */

interface Props {
	/** The key-visual id this page shows. Names the page, and keys its retire marks. */
	visual: string;
}

const { visual } = Astro.props;
const me = kv(visual);
---

<PlaygroundLayout title={me.label} description={me.title ?? 'Stages for one key visual.'}>
	{/* Every visual is one click away, and the current one is marked rather than linked. */}
	<nav class="vnav" aria-label="Key visual">
		<a class="vnav__home" href="/internal/launch-visuals/">Sandbox</a>
		{
			KEY_VISUALS.map((v) =>
				v.id === visual ? (
					<span class="vnav__here" aria-current="page">
						{v.label}
					</span>
				) : (
					<a class="vnav__link" href={`/internal/launch-visuals/${v.id}/`}>
						{v.label}
					</a>
				)
			)
		}
	</nav>

	{
		/* Retiring stages.
	    The judgement about whether an exhibit is still worth keeping is only good while you are
	    looking at the exhibit — so it is made there, with the ✕ in each stage's caption, and
	    collected here.

	    Marking is not deleting. It records a decision in localStorage and greys the stage; the files
	    go when someone reads the list back and removes them, which is a separate commit and a revert
	    if it turns out to be wrong. The store is shared across every visual's page, so the count and
	    the copied list are the whole sandbox, not just this page. Copy it before clearing site data —
	    this is the only place it lives. */
	}
	<div class="page-ctl" data-retire-bar data-visual={visual} hidden>
		<span class="page-ctl__name">Retired</span>
		<span class="page-ctl__count" data-retire-count>0</span>
		<button type="button" data-retire-copy>Copy list</button>
		<button type="button" data-retire-show aria-pressed="false">Show marked</button>
		<button type="button" data-retire-clear>Clear marks</button>
	</div>

	<slot />
</PlaygroundLayout>

<script>
	/**
	 * The retire control.
	 *
	 * Every `.stage` gets a ✕ in its caption. Clicking it marks that stage as no longer wanted and
	 * greys it; the bar at the top of the page counts the marks and copies them out.
	 *
	 * A stage is keyed by its visual and its position on the page, and the key is stored WITH the
	 * caption's text. The key alone would rot the first time a stage moved; the text alone is not
	 * unique (every feature row is called "Feature row"). Together they survive either one changing,
	 * which matters because the list is read back days later by someone deleting files. The store is
	 * shared by every visual's page, so the count and the copied list cover the whole sandbox.
	 *
	 * Nothing here deletes anything. It writes a decision down at the moment the decision is good.
	 */
	const RETIRE_KEY = 'launch-visuals:retire';

	type Retired = Record<string, string>;
	const readMarks = (): Retired => {
		try {
			return JSON.parse(localStorage.getItem(RETIRE_KEY) || '{}') as Retired;
		} catch {
			return {};
		}
	};
	const writeMarks = (m: Retired) => {
		try {
			localStorage.setItem(RETIRE_KEY, JSON.stringify(m));
		} catch {
			/* private window, cleared site data — the marks are a convenience, not the work */
		}
	};

	{
		const bar = document.querySelector<HTMLElement>('[data-retire-bar]');
		const countEl = document.querySelector<HTMLElement>('[data-retire-count]');
		const stages = Array.from(document.querySelectorAll<HTMLElement>('.stage'));

		// visual id + position, so a key says where to look as well as what to remove
		const seen: Record<string, number> = {};
		const keyed = stages.map((stage) => {
			const page = bar?.dataset.visual ?? 'page';
			seen[page] = (seen[page] ?? 0) + 1;
			const name = stage.querySelector('.stage__name')?.textContent?.trim() ?? '';
			const note = stage.querySelector('.stage__note')?.textContent?.trim() ?? '';
			return { stage, key: `${page}/${seen[page]}`, label: note ? `${name} — ${note}` : name };
		});

		const paint = () => {
			const marks = readMarks();
			keyed.forEach(({ stage, key }) => stage.toggleAttribute('data-retired', key in marks));
			const n = Object.keys(marks).length;
			if (countEl) countEl.textContent = String(n);
			if (bar) bar.hidden = n === 0;
		};

		keyed.forEach(({ stage, key, label }) => {
			const cap = stage.querySelector('.stage__cap');
			if (!cap) return;
			const btn = document.createElement('button');
			btn.type = 'button';
			btn.className = 'stage__retire';
			btn.title = 'Mark this stage as no longer needed';
			btn.setAttribute('aria-label', `Retire ${label}`);
			btn.textContent = '✕';
			btn.addEventListener('click', () => {
				const marks = readMarks();
				if (key in marks) delete marks[key];
				else marks[key] = label;
				writeMarks(marks);
				paint();
			});
			cap.appendChild(btn);
		});

		document.querySelector('[data-retire-copy]')?.addEventListener('click', () => {
			const marks = readMarks();
			const text = Object.entries(marks)
				.map(([k, v]) => `${k}\t${v}`)
				.join('\n');
			navigator.clipboard?.writeText(text);
		});

		// Marked stages are dimmed, not hidden, so a mark can be reconsidered. This hides them, which
		// is the only way to see what the page would actually look like after the cleanup.
		document.querySelector<HTMLButtonElement>('[data-retire-show]')?.addEventListener('click', (e) => {
			const btn = e.currentTarget as HTMLButtonElement;
			const on = btn.getAttribute('aria-pressed') === 'true';
			btn.setAttribute('aria-pressed', on ? 'false' : 'true');
			btn.textContent = on ? 'Show marked' : 'Marked hidden';
			document.documentElement.toggleAttribute('data-hide-retired', !on);
		});

		document.querySelector('[data-retire-clear]')?.addEventListener('click', () => {
			writeMarks({});
			paint();
		});

		paint();
	}
</script>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	// Each visual gets its own band so two of them never share an edge — adjacent visuals read
	// as one composition otherwise, which is the thing this page exists to avoid.
	.stage {
		margin: 0 auto $spacing-16;

		&[data-w='full'] {
			max-width: 1200px;
		}
		&[data-w='half'] {
			max-width: 600px;
		}
		&[data-w='card'] {
			max-width: 380px;
		}
	}

	.stage__cap {
		display: flex;
		align-items: baseline;
		gap: $spacing-3;
		margin-bottom: $spacing-3;
		padding-bottom: $spacing-2;
		border-bottom: 1px solid var(--sl-color-hairline-light);
	}

	.stage__name {
		@include card-title-sm;
		font-family: $font-family-mono;
	}

	.stage__note {
		@include text-xs;
		color: var(--color-text-secondary, #5b616e);
	}

	.stage__frame {
		// The checkerboard shows where a visual's own background stops and the page's begins —
		// a transparent edge is invisible against a plain white frame.
		background:
			linear-gradient(45deg, #f2f4f8 25%, transparent 25%, transparent 75%, #f2f4f8 75%),
			linear-gradient(45deg, #f2f4f8 25%, transparent 25%, transparent 75%, #f2f4f8 75%);
		background-position:
			0 0,
			8px 8px;
		background-size: 16px 16px;
		border-radius: $radius-xl;
	}

	// For visuals that carry their own white surface: the checkerboard reads as a background
	// competing with the card fills rather than as absence of one.
	.stage__frame--plain {
		background: none;
	}
	// --- retiring a stage --------------------------------------------------------------------

	.stage__retire {
		@include text-xs;
		margin-left: auto;
		padding: 0 $spacing-2;
		border: 0;
		border-radius: $radius-sm;
		background: none;
		line-height: 1.6;
		color: var(--color-text-secondary, #5b616e);
		// Quiet until wanted: forty-eight of these along the page would read as forty-eight errors.
		opacity: 0;
		cursor: pointer;

		&:hover,
		&:focus-visible {
			background: var(--sl-color-hairline-light, #ebebeb);
			color: var(--color-text, #17181c);
		}
	}

	.stage:hover .stage__retire,
	.stage__retire:focus-visible,
	.stage[data-retired] .stage__retire {
		opacity: 1;
	}

	// Dimmed, not hidden: a mark is a decision that can still be looked at and taken back.
	.stage[data-retired] {
		opacity: 0.4;

		.stage__name {
			text-decoration: line-through;
		}
	}

	:root[data-hide-retired] .stage[data-retired] {
		display: none;
	}

	.page-ctl__count {
		@include text-xs;
		min-width: 1.6em;
		padding: 0 $spacing-1;
		border-radius: $radius-sm;
		background: var(--color-text, #17181c);
		font-family: $font-family-mono;
		text-align: center;
		color: #fff;
	}

	// --- chrome the PANELS use --------------------------------------------------------------
	//
	// Global, and that is not a style choice: these classes are written in `_panels/*.astro`, and an
	// Astro scoped rule only matches markup in its own file. Scoped here, every probe on the page
	// would silently lose its width. `.page-tabs` below stays scoped because it is the only chrome
	// this file still renders itself.

	// A small control for a single visual's options, sitting where that visual's stages start.
	.page-ctl {
		display: flex;
		align-items: center;
		gap: $spacing-2;
		max-width: 1200px;
		margin: 0 auto $spacing-6;

		button {
			@include text-xs;
			padding: $spacing-1 $spacing-3;
			border: 1px solid var(--sl-color-hairline-light);
			border-radius: $radius-md;
			background: none;
			font-weight: $font-weight-medium;
			color: var(--color-text-secondary, #5b616e);
			cursor: pointer;

			&[aria-pressed='true'] {
				border-color: var(--color-text, #17181c);
				background: var(--color-text, #17181c);
				color: #fff;
			}
		}
	}

	.page-ctl__name {
		@include text-xs;
		margin-right: $spacing-1;
		font-family: $font-family-mono;
		color: var(--color-text-secondary, #5b616e);
	}

	// A hard-set width so the composition is judged at a known size rather than whatever the page
	// happens to give it. Each probe names its own width; the dashed edge shows exactly how much room
	// the visual was handed, so an upscale cap or a floor is visible as space rather than guessed.
	.probe {
		width: var(--probe, 630px);
		max-width: 100%;
		margin: 0 auto;
		// An outline, not a border or padding: it must not eat into the width being measured.
		outline: 1px dashed var(--color-border, #ebebeb);
		outline-offset: $spacing-3;
		border-radius: $radius-sm;
	}

	// Each shell at the width it has in the key visual — measured 258.67px, the 1.6fr app column of
	// a 630px composition — so what gets judged here is what ships. This row is a technical exhibit,
	// so it is free to be wider than the visual it serves.
	.dash-row {
		display: grid;
		grid-template-columns: repeat(3, 259px);
		justify-content: center;
		gap: $spacing-5;
	}

	// Each unit at the width it has in the twin visual — 243px, the 1fr column of a 630px
	// composition split 1 : 96px : 1.2 — so what gets judged here is what ships.
	.unit-row {
		display: grid;
		grid-template-columns: repeat(auto-fill, 243px);
		justify-content: center;
		align-items: start;
		gap: $spacing-5;
	}

	.dash-row__cap {
		@include text-xs;
		margin: $spacing-3 0 0;
		font-family: $font-family-mono;
		color: var(--color-text-secondary, #5b616e);
	}
</style>

<style lang="scss">
	@use '../../styles/variables' as *;

	// The strip of links between visuals. Replaced a tab strip, and is a different thing: a tab hid
	// eight panels that were still on the page, this leaves them on disk.
	.vnav {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: $spacing-1 $spacing-3;
		max-width: 1200px;
		margin: 0 auto $spacing-10;
		padding-bottom: $spacing-3;
		border-bottom: 1px solid var(--sl-color-hairline-light);
	}

	.vnav__home {
		@include text-xs;
		margin-right: $spacing-2;
		font-family: $font-family-mono;
		color: var(--color-text-secondary, #5b616e);
	}

	.vnav__link,
	.vnav__here {
		@include text-s;
		padding: $spacing-1 $spacing-3;
		border-radius: $radius-md;
		font-weight: $font-weight-medium;
		text-decoration: none;
	}

	.vnav__link {
		color: var(--color-text-secondary, #5b616e);

		&:hover {
			color: var(--color-text, #17181c);
		}
	}

	.vnav__here {
		background: var(--color-text, #17181c);
		color: #fff;
	}
</style>
