		&[hidden] {
			display: none;
		}

		b {
			display: inline-block;
			min-width: 1.5em;
			margin-right: 2px;
			padding: 0 4px;
			border-radius: $radius-sm;
			background: var(--color-text, #17181c);
			font-family: $font-family-mono;
			font-weight: 400;
			text-align: center;
			color: #fff;
		}

		button {
			padding: 2px $spacing-2;
			border: 0;
			border-radius: $radius-sm;
			background: none;
			font: inherit;
			font-weight: $font-weight-medium;
			color: var(--color-text, #17181c);
			cursor: pointer;

			&:hover {
				background: var(--sl-color-gray-6, #f2f3f7);
			}

			&[aria-pressed='true'] {
				background: var(--color-text, #17181c);
				color: #fff;
			}

			&:focus-visible {
				outline: 2px solid $color-brand;
				outline-offset: 1px;
			}
		}
	}

	.vp-marks__lbl {
		font-family: $font-family-mono;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	// Promotions green, as every check is.
	.vp-marks__n--up b {
		background: #1f8b4d;
	}

	.vp-marks__acts {
		display: inline-flex;
		gap: 2px;
		margin-left: auto;
	}

	// ---- Promote and retire, in the open direction's header ----------------------------------------

	.vx-cmds {
