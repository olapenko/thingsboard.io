---
import Workbench from '@root/pages/internal/_Workbench.astro';
import Direction from '@root/pages/internal/_Direction.astro';
import Frames from '@root/pages/internal/_Frames.astro';
import StateControls from '@root/pages/internal/_StateControls.astro';
import FooterStage from '@root/pages/internal/chrome/_FooterStage.astro';
import { chrome } from '@root/pages/internal/_chrome';

/**
 * THE FOOTER: every page's last word. Three footers exist on this branch, and a fourth layout:
 *
 * - `Landing/Footer`, the one every page shows today: newsletter, four badges, the logo, six links.
 * - `Landing/FooterMap`, the one the redesigned pages take as they land (`footer="map"` on
 *   `BaseLayout`): the brand row, the platform mapped as the Products menu groups it, four link
 *   columns, the foot. Its `focus` layout is a candidate; its Appearance row shows on the pages
 *   that follow the theme.
 * - `starlight/DocFooter`, the docs': the nav links, copyright, socials and Appearance.
 *
 * The footers a page can opt into are framed as real pages, scrolled to their foot, at 1440, 1024
 * and 768 (where the map's columns stack) and on a phone; the two that no route renders yet are
 * drawn in the page under a stand-in for the closing band.
 */
const part = chrome('footer');
const stage = (variant: string) => `/internal/chrome/stage/footer/${variant}/?scroll=bottom`;
const FRAMES = [
	{ w: 1440, h: 720 },
	{ w: 1024, h: 760 },
	{ w: 768, h: 900 },
];
---

<Workbench title={part.label} description={part.blurb}>
	<aside class="brief" slot="brief">
		<p class="brief__kicker">The footer</p>
		<dl class="brief__facts">
			<div>
				<dt>In use</dt>
				<dd>
					<em>Site footer</em> on every marketing page today: newsletter and four badges, the logo beside six links,
					copyright and social, on <code>#0f161d</code>, naming no product. The docs keep <code>DocFooter</code>.
				</dd>
			</div>
			<div>
				<dt>Landing</dt>
				<dd>
					<em>Platform map</em> (<code>Landing/FooterMap</code>, words in <code>data/footer-map.ts</code>) closes each
					redesigned page as it lands — Contact us and Thanks first, then Installations, Cloud, On-premises, Home. A page
					opts in with <code>footer="map"</code> on <code>BaseLayout</code>; nothing else changes.
				</dd>
			</div>
			<div>
				<dt>Appearance</dt>
				<dd>
					The theme switch joins the map’s base row on the pages that follow the theme (<code>util/page-theme</code>);
					the redesigned pages are locked light, so it shows once the docs or the blog move onto this footer. Drawn here
					outright on its own tab.
				</dd>
			</div>
			<div>
				<dt>Open</dt>
				<dd>
					MailerLite’s success state (the form posts to a new tab, as the one in use does). Case studies close Solutions
					since 5 Oct, after the use cases, as an arrowed link.
				</dd>
			</div>
		</dl>
	</aside>

	<StateControls slot="controls" scrolled={false} drawer={false} />

	<Direction
		name="Site footer"
		shipping
		source="Landing/Footer · BaseLayout's default"
		note="the footer every marketing page has today, under a closing band in the bookends' indigo"
	>
		<Frames route={stage('site')} frames={FRAMES} />
		<Frames route={stage('site')} phone />
	</Direction>

	<Direction
		name="Platform map"
		source="Landing/FooterMap layout=map · footer=&quot;map&quot; on BaseLayout"
		note="the redesigned pages' footer: brand row with the newsletter; a panel mapping the platform — the two platforms with their filled badges, the six ecosystem products on washes of their own hue, a line under each — then four link columns (Solutions, Developers, Services, Company), and the foot · on black under the closing band, no line at the seam"
	>
		<Frames route={stage('map')} frames={FRAMES} />
		<Frames route={stage('map')} phone />
	</Direction>

	<Direction
		name="Platform map · Appearance"
		source="Landing/FooterMap appearance · ThemeChoice tone=footer"
		note="the map with the Appearance control under the legal links — System · Light · Dark in the footer's muted ink — as a theme-following page would show it"
	>
		<FooterStage layout="map" appearance />
	</Direction>

	<Direction
		name="Platforms and highlights"
		source="Landing/FooterMap layout=focus"
		note="candidate · one Platform group of four peers — ThingsBoard Cloud, ThingsBoard, Pricing, Installation options — a mark and a name each, no lines; the six ecosystem products move to a link column in front of the other four, with the License portal at its foot"
	>
		<FooterStage layout="focus" />
	</Direction>

	<Direction
		name="Docs footer"
		shipping
		source="starlight/DocFooter"
		note="the documentation's: the nav links, copyright and socials on one row, Appearance on a line of its own under them; hidden in print"
	>
		<Frames route={stage('docs')} frames={FRAMES} />
		<Frames route={stage('docs')} phone />
	</Direction>
</Workbench>
