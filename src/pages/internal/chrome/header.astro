---
import Workbench from '@root/pages/internal/_Workbench.astro';
import Direction from '@root/pages/internal/_Direction.astro';
import Frames from '@root/pages/internal/_Frames.astro';
import StateControls from '@root/pages/internal/_StateControls.astro';
import { chrome } from '@root/pages/internal/_chrome';

/**
 * THE HEADER: one bar for the whole site (`Landing/HeaderContent`), in each look `util/header-config`
 * defines and each state it takes. Every tab is the real bar on a real page, framed at the widths
 * where it changes shape — 1480 (the field fits), 1440 (the box), 1300 (the star count has given way), 1024 (the
 * nav folds into Menu) — and on a 375 phone. The controls above the tabs set the state every frame is
 * judged in: the theme, the bar at the top or scrolled, the menu closed or open.
 *
 * Which look a page gets is its layout's: the docs take `docs` through Starlight, every `BaseLayout`
 * page takes `marketing`, and a page that opens on a hero says `hero="dark"` or `"light"` on it.
 */
const part = chrome('header');
const stage = (variant: string) => `/internal/chrome/stage/header/${variant}/`;

const SEARCH_SAYS = {
	1480: 'The field: the magnifier, “Search” and the key hint in one stroke, 152 wide, where the row has 50px a side to spare.',
	1440: 'Below 1480 the same control as the 40px box — Sign in’s stroke, no label. The keys still open it.',
	1300: 'The box beside the mark alone; the count gave way at 1340.',
	375: 'The box beside Menu; the dialog is a sheet from the foot of the screen.',
};

const DOCS_SAYS = {
	1440: 'The search box (the field needs 1480), then the star count, Sign in, Try for free. No theme switch: Appearance is in the docs footer.',
	1300: 'The box still; the count gave way at 1340 and the mark stands alone until 1281.',
	1024: 'The nav is in Menu; the box, the count and the account pair stay in the bar.',
	375: 'The box beside Menu; opened, the sheet: the sections as a list, a section as its own view, and Close where Menu was.',
};

const MENU_SAYS = {
	1440: 'Open: one panel under the bar — the rail of sections, the open section beside it with its promotions along the foot; hover the rail or the row to switch.',
	1300: 'The same panel; the row has packed toward the wordmark and the count has given way.',
	1024: 'The row is gone: Menu opens the sheet, the panel’s rail as a list.',
	375: 'The sheet: a section opens as a view of its own with a row back; Escape and a swipe right step back before they close.',
};

const DROPDOWNS_SAYS = {
	1440: 'The kept alternative: a panel under the item, the same section content, kept inside the viewport.',
	1300: 'The same; a wide section wraps its groups rather than overrun the window.',
};

const MARKETING_SAYS = {
	1440: 'The nav inline; the search icon, the count, Sign in and Try for free at the end. A hairline under the bar at the top of the page, a shadow once scrolled.',
	1300: 'The nav still inline; the count gave way at 1340 and the mark stands alone.',
	1024: 'The nav folds into Menu.',
	375: 'Wordmark, the search icon and Menu; the account pair steps into the sheet’s foot under 600.',
};
---

<Workbench title={part.label} description={part.blurb}>
	<aside class="brief" slot="brief">
		<p class="brief__kicker">The bar</p>
		<dl class="brief__facts">
			<div>
				<dt>In use</dt>
				<dd>
					One header component on every route, in two looks. <em>Docs</em> on the documentation: the sidebar ground with
					a hairline, one state. <em>Marketing</em> on every other page: the surface with a hairline at the top of the
					page and, scrolled, the shadow in its place. A page that opens on a hero starts the bar transparent over it —
					the homepage and the product pages in white ink over a dark hero, pricing and the affiliate page in the page's
					ink over a light one.
				</dd>
			</div>
			<div>
				<dt>Looks</dt>
				<dd>
					<code>util/header-config.ts</code> — <code>look: marketing · docs</code>, <code>hero?: dark · light</code>. No
					theme icon in either: the theme follows the system and its switch is the footer's. Search is on every bar, one
					control sized by the room (layer 12, PR #21). The seven variants this replaced (layer 11, PR #20) each chose
					its own icons; nothing chooses them now.
				</dd>
			</div>
			<div>
				<dt>Try</dt>
				<dd>
					Click into a frame and press <code>/</code> or Ctrl K on the docs tab. Set <em>Scrolled</em> to see the shadow
					and, on the heroes, the surface return; <em>Open</em> to see the menu — the panel from 1281, the sheet below —
					and <em>Dark</em> for the pages that follow the theme.
				</dd>
			</div>
			<div>
				<dt>Open</dt>
				<dd>
					The star count's threshold (1340, measured with 49px left beside the nav) and the field's (1480, the same
					room). The menu model: the one panel ships (5 Oct); the dropdowns are kept, judged on their own tab.
				</dd>
			</div>
		</dl>
	</aside>

	<StateControls slot="controls" search />

	<Direction
		name="Docs"
		shipping
		source="look: docs (Starlight pages by default)"
		note="the documentation's bar: the sidebar ground with a hairline; the search control, the count, Sign in, Try for free"
	>
		<Frames route={stage('docs')} says={DOCS_SAYS} />
		<Frames route={stage('docs')} says={DOCS_SAYS} phone />
	</Direction>

	<Direction
		name="Search"
		shipping
		source="SearchButton · SiteSearch (layer 12)"
		note="one control at two sizes, by the room: the labelled field from 1480, the stroked 40px box below; set Search to Open to see the dialog — the Dialog's panel, the Field around Google's input, title rows on the type ladder, Escape and the backdrop close it, focus returns to the control"
	>
		<Frames
			route={stage('docs')}
			says={SEARCH_SAYS}
			frames={[
				{ w: 1480, h: 600 },
				{ w: 1440, h: 600 },
				{ w: 1300, h: 600 },
			]}
		/>
		<Frames route={stage('docs')} says={SEARCH_SAYS} phone />
	</Direction>

	<Direction
		name="The menu"
		shipping
		source="SiteMenu, model panel (layer 13)"
		note="set Menu to Open: from 1281 one panel under the bar, a rail of the sections and the open one beside it; below, the sheet — the rail as a list, a section as its own view with a row back"
	>
		<Frames
			route={stage('marketing')}
			says={MENU_SAYS}
			frames={[
				{ w: 1440, h: 760 },
				{ w: 1300, h: 760 },
				{ w: 1024, h: 760 },
			]}
		/>
		<Frames route={stage('marketing')} says={MENU_SAYS} phone />
	</Direction>

	<Direction
		name="Dropdowns"
		source="SiteMenu, model dropdowns · BaseLayout menu"
		note="the alternative, kept: a panel under each item, with the same section content (SiteMenuBody); below 1281 the same sheet"
	>
		<Frames
			route={stage('dropdowns')}
			says={DROPDOWNS_SAYS}
			frames={[
				{ w: 1440, h: 760 },
				{ w: 1300, h: 760 },
			]}
		/>
	</Direction>

	<Direction
		name="Marketing"
		shipping
		source="look: marketing (every BaseLayout page)"
		note="the surface with a hairline at the top of the page; scrolled, the shadow in its place and the bar lifting off the page it covers"
	>
		<Frames route={stage('marketing')} says={MARKETING_SAYS} />
		<Frames route={stage('marketing')} says={MARKETING_SAYS} phone />
	</Direction>

	<Direction
		name="Over a dark hero"
		shipping
		source="hero: dark (the homepage, Cloud, On-premises, Edge)"
		note="transparent over the hero in white ink, the wordmark inverted; scrolled past it, the marketing look's surface and shadow"
	>
		<Frames route={stage('hero-dark')} says={MARKETING_SAYS} />
		<Frames route={stage('hero-dark')} says={MARKETING_SAYS} phone />
	</Direction>

	<Direction
		name="Over a light hero"
		shipping
		source="hero: light (pricing, the affiliate page)"
		note="transparent over the hero in the page's own ink; scrolled, the same surface and shadow"
	>
		<Frames route={stage('hero-light')} says={MARKETING_SAYS} />
		<Frames route={stage('hero-light')} says={MARKETING_SAYS} phone />
	</Direction>
</Workbench>
