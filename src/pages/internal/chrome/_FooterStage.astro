---
import FooterMap from '@components/Landing/FooterMap.astro';

/**
 * A `FooterMap` layout drawn in the page, under a stand-in for the band that closes a page, for the
 * directions that no route renders yet: the `focus` layout, and the map with its Appearance row.
 * The ones a page can opt into are framed as real pages instead (`chrome/footer.astro`).
 *
 * The stand-in is the bookends' indigo with a heading; the real `Bookend` arrives with the Home
 * layer and takes its place here.
 */
interface Props {
	layout?: 'map' | 'focus';
	appearance?: boolean;
}

const { layout = 'map', appearance = false } = Astro.props;
---

<div class="fst">
	<section class="fst__close" data-surface="dark" aria-hidden="true">
		<div class="fst__in">
			<h2 class="fst__h2">Start building with ThingsBoard</h2>
			<p class="fst__copy">Try it free in the cloud, or install it on your own servers.</p>
		</div>
	</section>
	<FooterMap {layout} {appearance} />
</div>

<style lang="scss">
	@use '../../../styles/variables' as *;

	.fst {
		overflow: hidden;
		border-radius: $radius-sm;
	}

	.fst__close {
		padding: $spacing-16 0;
		background: var(--band-indigo, #121425);
		color: #fff;
	}

	.fst__in {
		max-width: 1000px;
		margin: 0 auto;
		padding: 0 $spacing-6;
	}

	.fst__h2 {
		@include type-section;
		margin: 0 0 $spacing-3;
	}

	.fst__copy {
		@include type-body;
		margin: 0;
		color: rgba(255, 255, 255, 0.8);
	}
</style>
