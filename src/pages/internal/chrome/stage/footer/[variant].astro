---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import StageState from '@root/pages/internal/chrome/stage/_StageState.astro';
import Devices, { getHeadings } from '@includes/docs/user-guide/devices.mdx';
import { Products } from '@models/site.models';

/**
 * ONE FOOTER on a real page, for the footer workbench's frames (`chrome/footer.astro`): `site` is
 * the footer every page carries today (`Landing/Footer`, `BaseLayout`'s default), `map` is
 * `FooterMap` as a page opts into it (`footer="map"`), `docs` is a docs page's `DocFooter`. The
 * frame asks for the foot of the page (`scroll=bottom`); a short body above, so the footer meets a
 * page rather than the bar.
 */
export function getStaticPaths() {
	return ['site', 'map', 'docs'].map((variant) => ({ params: { variant } }));
}

const variant = Astro.params.variant as 'site' | 'map' | 'docs';
---

{
	variant === 'docs' ? (
		<StarlightPage
			frontmatter={{
				title: 'Devices',
				description: 'Footer stage: the docs footer (internal).',
				tableOfContents: true,
				head: [{ tag: 'meta', attrs: { name: 'robots', content: 'noindex, nofollow' } }],
			}}
			headings={getHeadings()}
		>
			<StageState />
			<Devices product={Products.PE} />
		</StarlightPage>
	) : (
		<BaseLayout
			title={`Footer stage · ${variant}`}
			description="Footer stage: one footer under a marketing page (internal)."
			headerVariant="solid-border"
			footer={variant === 'map' ? 'map' : undefined}
			noIndex
		>
			<StageState />
			<main class="st">
				<section class="st__body">
					<div class="st__in">
						<p class="st__eyebrow">Footer stage · {variant}</p>
						<h1 class="st__title">The last section before the footer</h1>
						<p class="st__copy">
							What a page ends with: a closing band, then the footer. The seam between the two is half of what a
							footer is judged on, so the band here takes the bookends' indigo.
						</p>
					</div>
				</section>
				<section class="st__close" data-surface="dark">
					<div class="st__in">
						<h2 class="st__h2">Start building with ThingsBoard</h2>
						<p class="st__copy st__copy--light">Try it free in the cloud, or install it on your own servers.</p>
					</div>
				</section>
			</main>
		</BaseLayout>
	)
}

<style lang="scss">
	@use '../../../../../styles/variables' as *;

	.st__in {
		max-width: 1000px;
		margin: 0 auto;
		padding: 0 $spacing-6;
	}

	.st__body {
		padding: 120px 0 $spacing-16;
	}

	.st__eyebrow {
		@include type-eyebrow;
		margin: 0 0 $spacing-3;
		font-family: $font-family-mono;
		color: var(--color-text-secondary, #5b616e);
	}

	.st__title {
		@include type-title;
		margin: 0 0 $spacing-4;
	}

	.st__h2 {
		@include type-section;
		margin: 0 0 $spacing-3;
		color: #fff;
	}

	.st__copy {
		@include type-body;
		max-width: 65ch;
		margin: 0;
		color: var(--color-text-secondary, #5b616e);
	}

	.st__copy--light {
		color: rgba(255, 255, 255, 0.8);
	}

	.st__close {
		padding: $spacing-20 0;
		background: var(--band-indigo, #121425);
		color: #fff;
	}
</style>
