---
import Workbench from '@root/pages/internal/_Workbench.astro';
import Direction from '@root/pages/internal/_Direction.astro';
import CookieStage from '@root/pages/internal/_CookieStage.astro';
import { chrome } from '@root/pages/internal/_chrome';

/**
 * COOKIE NOTICE: the notice at the foot of every page (`CookieNotice`, rendered by `BaseLayout`),
 * judged over a window of the page it lands on — the homepage's black hero, or a docs page — with
 * the chat launcher it shares the corner with. Each tab is the component in demo mode: Accept hides
 * it without writing the cookie. The real thing, at a real width, is in every frame of the header
 * and footer pages.
 *
 * IN USE since 2026-10-01: "Bar · short, linked title · indigo". The banner it replaced
 * (`CookieBanner`, kept beside the sandbox in `_before/`) is the first tab after it, as "Before".
 */
const part = chrome('cookie-notice');
const inst = (id: string) => ({ id: `cn-${id}` });
---

<Workbench title={part.label} description={part.blurb}>
	<aside class="brief" slot="brief">
		<p class="brief__kicker">The notice</p>
		<dl class="brief__facts">
			<div>
				<dt>In use</dt>
				<dd>
					Since 2026-10-01, <em>Bar · short, linked title · indigo</em>: the indigo bar, “Cookie policy ›” as the
					heading and the link, the short sentence at 13/20, one Accept. 77px at 1440, 173px on a phone.
				</dd>
			</div>
			<div>
				<dt>Before</dt>
				<dd>
					A translucent dark bar across the foot of the window: “Cookie policy” over the sentence, Accept in
					<code>#1a6fd4</code>, a close beside it that does the same thing. System face. 96px tall at 1440, where the
					chat launcher misses the close by 15px (at 1280 it covers it); 213px of an 812px phone at 13px.
				</dd>
			</div>
			<div>
				<dt>Component</dt>
				<dd>
					<code>components/CookieNotice.astro</code> — <code>layout</code> (card · bar), <code>tone</code> (light · dark),
					<code>copy</code> (shipped · short), <code>titleLink</code>, <code>textSize</code>. Same cookie as before
					(<code>cookie-notice-dismissed=true</code>, a year), read before first paint. Here it runs in demo mode.
				</dd>
			</div>
			<div>
				<dt>Copy</dt>
				<dd>
					Every direction carries the old sentence verbatim except the ones marked <em>short</em>: a DRAFT, not legal’s
					words, that keeps why, browsing-is-agreeing and the policy link and drops the pointer to browser settings.
					It is what lets the bar hold one line on desktop — and what is in use.
				</dd>
			</div>
			<div>
				<dt>Not done</dt>
				<dd>
					Legal’s sign-off on the short sentence; a Reject or settings choice — it is still a notice, and that is a
					consent decision rather than a brush-up.
				</dd>
			</div>
		</dl>
		<p class="brief__acts">
			<button type="button" class="brief__btn" data-cs-replay>Show the notices again</button>
		</p>
	</aside>

	<div class="page-ctl" slot="controls" role="group" aria-label="Page behind the notice">
		<span class="page-ctl__name">Behind it</span>
		<button type="button" data-cs-pick="home" aria-pressed="true">Homepage</button>
		<button type="button" data-cs-pick="docs" aria-pressed="false">Docs page</button>
	</div>

	<Direction
		name="Bar · short, linked title · indigo"
		shipping
		source="BaseLayout: <CookieNotice layout=&quot;bar&quot; tone=&quot;dark&quot; copy=&quot;short&quot; titleLink textSize=&quot;small&quot; />"
		note="DRAFT COPY, not legal's · the bar with 'Cookie policy ›' as the heading and the link, the short sentence under it at 13/20 with the policy's name as plain text, one Accept at the end of the line · 77px at 1440 and 1280 (before: 96 and 117), 97 at 768 · 173px on a phone against 213, the chat launcher clear · on the bookends' indigo"
	>
		<CookieStage
			notice={{ layout: 'bar', tone: 'dark', copy: 'short', titleLink: true, textSize: 'small', ...inst('bar-link-dark') }}
		/>
	</Direction>

	<Direction
		name="Before · CookieBanner"
		source="components/CookieBanner.astro, until 2026-10-01 (kept in internal/_before/)"
		note="the banner every page rendered before · glass bar edge to edge, system face, Accept and a close that do the same thing · 96px at 1440, 117 at 1280, where the chat launcher covers the close · 213px on a phone, the copy at 13px"
	>
		<CookieStage shipped />
	</Direction>

	<Direction
		name="Bar · short, linked title · white"
		source="layout: bar · tone: light · copy: short · titleLink · textSize: small"
		note="the same bar in white, a hairline and a soft shadow upward · reads as part of the page's chrome, like the header at the other end"
	>
		<CookieStage
			notice={{ layout: 'bar', tone: 'light', copy: 'short', titleLink: true, textSize: 'small', ...inst('bar-link-light') }}
		/>
	</Direction>

	<Direction
		name="Card · white"
		source="layout: card · tone: light"
		note="the old words verbatim in a 400px card, bottom-left, 24px in: title, sentence, Accept, 236px tall · white with a hairline and the UI shadow · on a phone 8px in on three sides, the title dropped: 222px, at 14px rather than 13"
	>
		<CookieStage notice={{ layout: 'card', tone: 'light', ...inst('card-light') }} />
	</Direction>

	<Direction
		name="Card · linked title"
		source="layout: card · tone: light · titleLink · textSize: small"
		note="the white card with the heading as the link and the policy's name in the sentence back to plain text, so one link, not two · the sentence at 13/20 · 226px on desktop · the heading stays on a phone: 234px"
	>
		<CookieStage notice={{ layout: 'card', tone: 'light', titleLink: true, textSize: 'small', ...inst('card-link') }} />
	</Direction>

	<Direction
		name="Card · indigo"
		source="layout: card · tone: dark"
		note="the same card on the bookends' indigo, #121425 · quieter over a white page, close to disappearing over the black hero"
	>
		<CookieStage notice={{ layout: 'card', tone: 'dark', ...inst('card-dark') }} />
	</Direction>

	<Direction
		name="Bar · indigo"
		source="layout: bar · tone: dark"
		note="the old shape, brushed: edge to edge, solid indigo for the glass, the old sentence at the 1200 content width beside one Accept, the close gone · 77px at 1440, 99 at 1280 · 221px on a phone"
	>
		<CookieStage notice={{ layout: 'bar', tone: 'dark', ...inst('bar-dark') }} />
	</Direction>

	<Direction
		name="Bar · white"
		source="layout: bar · tone: light"
		note="the brushed bar in white, a hairline and a soft shadow upward"
	>
		<CookieStage notice={{ layout: 'bar', tone: 'light', ...inst('bar-light') }} />
	</Direction>

	<Direction
		name="Card · short copy"
		source="layout: card · tone: light · copy: short"
		note="DRAFT COPY, not legal's · the white card with the sentence cut to its three claims · 192px on desktop, 156 on a phone"
	>
		<CookieStage notice={{ layout: 'card', tone: 'light', copy: 'short', ...inst('card-short') }} />
	</Direction>

	<Direction
		name="Bar · short copy"
		source="layout: bar · tone: dark · copy: short"
		note="DRAFT COPY, not legal's · the indigo bar with the short sentence on ONE line at 1440 and two at 1280 — 77px either way, the button's height · 155px on a phone, 19% of the screen against 26%"
	>
		<CookieStage notice={{ layout: 'bar', tone: 'dark', copy: 'short', ...inst('bar-short') }} />
	</Direction>
</Workbench>
