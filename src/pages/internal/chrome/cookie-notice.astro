---
import Workbench from '@root/pages/internal/_Workbench.astro';
import Direction from '@root/pages/internal/_Direction.astro';
import CookieStage from '@root/pages/internal/_CookieStage.astro';
import { chrome } from '@root/pages/internal/_chrome';

/**
 * COOKIE CONSENT: the card in the bottom-left corner of every page and the preferences behind it (`CookieConsent`,
 * mounted once per page from `starlight/SkipLink.astro`), judged over a window of the page it lands
 * on — the homepage's black hero, or a docs page — with the chat launcher it shares the corner with.
 * The tab is the component in demo mode: every choice hides it without writing the cookie or
 * reaching GTM, and Manage preferences opens the real dialog. The real thing, at a real width, is in
 * every frame of the header and footer pages.
 *
 * IN USE since 2026-10-05: upstream's consent (#704) as main shows it, a card, on the kit.
 * The notice's other directions (card, white, the old copy) went with `CookieNotice`; they are in
 * the history. The banner before both (`CookieBanner`, kept in `_before/`) is the second tab.
 */
const part = chrome('cookie-notice');
---

<Workbench title={part.label} description={part.blurb}>
	<aside class="brief" slot="brief">
		<p class="brief__kicker">The consent card</p>
		<dl class="brief__facts">
			<div>
				<dt>In use</dt>
				<dd>
					Since 2026-10-05: main’s card, on the kit — 340 wide, 20px in from the bottom-left corner, on the page’s own
					surface: “We use cookies”, upstream’s sentence with its Cookie Policy link, Accept all and Reject all as two
					equal buttons, Manage preferences under them. The chat launcher keeps the other corner from a tablet up and
					lifts above the card on a phone.
				</dd>
			</div>
			<div>
				<dt>Consent</dt>
				<dd>
					Upstream’s (#704), unchanged: a choice per category — Analytics, Marketing, with Strictly necessary shown and
					locked on — stored in <code>tb_consent</code> for 180 days and sent to Google Consent Mode v2;
					<code>ad_personalization</code> is never granted. Any <code>data-cc="show-preferences"</code> element reopens
					the preferences: the footers’ Cookie settings, the Cookie Policy page.
				</dd>
			</div>
			<div>
				<dt>Component</dt>
				<dd>
					<code>components/CookieConsent.astro</code> on the kit: the card’s actions in <code>ui/Button</code> and
					<code>ui/ButtonGroup</code>, the preferences in <code>ui/Dialog</code> (focus trap, Escape, focus back to the
					opener, a bottom sheet under 560). <code>demo</code> for this sandbox. Layer PR #27.
				</dd>
			</div>
			<div>
				<dt>Copy</dt>
				<dd>
					Upstream’s, word for word: the draft short sentence the bar carried is gone, so there is nothing for legal to
					sign off.
				</dd>
			</div>
		</dl>
		<p class="brief__acts">
			<button type="button" class="brief__btn" data-cs-replay>
				Show the bars again
			</button>
		</p>
	</aside>

	<div class="page-ctl" slot="controls" role="group" aria-label="Page behind the bar">
		<span class="page-ctl__name">Behind it</span>
		<button type="button" data-cs-pick="home" aria-pressed="true">
			Homepage
		</button>
		<button type="button" data-cs-pick="docs" aria-pressed="false">
			Docs page
		</button>
	</div>

	<Direction
		name="Consent card"
		shipping
		source="starlight/SkipLink: <CookieConsent />"
		note="main's card on the kit, upstream's words · 340 wide in the bottom-left corner on the page's surface: 'We use cookies', the sentence and its Cookie Policy link, Accept all and Reject all as equals, Manage preferences under them · Manage preferences opens the dialog: a switch per category, Strictly necessary locked on, Save · on a phone the card takes the width and the launcher lifts above it"
	>
		<CookieStage />
	</Direction>

	<Direction
		name="Before · CookieBanner"
		source="components/CookieBanner.astro, until 2026-10-01 (kept in internal/_before/)"
		note="the banner every page rendered before the redesign's notice · glass bar edge to edge, system face, Accept and a close that do the same thing, no choice to refuse · 96px at 1440, 117 at 1280, where the chat launcher covers the close · 213px on a phone"
	>
		<CookieStage before />
	</Direction>
</Workbench>
