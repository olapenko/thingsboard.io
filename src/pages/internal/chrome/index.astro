---
import PlaygroundLayout from '@layouts/PlaygroundLayout.astro';
import Tiles from '@root/pages/internal/_Tiles.astro';
import { CHROME, chromeHref } from '@root/pages/internal/_chrome';

/**
 * Chrome › Overview: one tile per part of the frame every page shares. ADD a part: an entry in
 * `_chrome.ts` and a page in `chrome/`; it appears here, in the top bar and in the old-address map
 * with no other edit.
 */
---

<PlaygroundLayout
	title="Chrome"
	description="The frame every page shares — header, footer, cookie notice, chat — each in every variation the site supports, as the real page in frames, under shared state controls."
>
	<Tiles tiles={CHROME.map((p) => ({ href: chromeHref(p), label: p.label, blurb: p.blurb, icon: p.icon, source: p.source }))} />
</PlaygroundLayout>
