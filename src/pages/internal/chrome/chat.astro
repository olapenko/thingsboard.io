---
import Workbench from '@root/pages/internal/_Workbench.astro';
import Direction from '@root/pages/internal/_Direction.astro';
import ChatStage from '@root/pages/internal/_ChatStage.astro';
import ChatSkin from '@components/ChatWidget/ChatSkin.astro';
import { chrome } from '@root/pages/internal/_chrome';

/**
 * CHAT: the YourGPT widget every page loads, restyled from our side (`ChatSkin`), opened from our own
 * launcher (`ChatLauncher`). Each tab holds the REAL chat — one widget per page, mounted into the open
 * tab's window — so what is judged is what a visitor would type into. Typing here talks to the live bot.
 *
 * IN USE since 2026-10-02: "Wash · small question" (`CHAT_SKIN`, `CHAT_LAUNCHER` in `data/chat-widget`).
 * A new direction is tried here first; promoting one means pointing those two at it and moving `shipping`.
 */
const part = chrome('chat');
---

<Workbench title={part.label} description={part.blurb}>
	<ChatSkin slot="brief" />
	<aside class="brief" slot="brief">
		<p class="brief__kicker">The chat</p>
		<dl class="brief__facts">
			<div>
				<dt>In use</dt>
				<dd>
					<em>Wash · small question</em>, on every page since 2026-10-02 (<code>YourGptWidget</code> reads
					<code>CHAT_SKIN</code> and <code>CHAT_LAUNCHER</code>), after <em>Wash · white circle</em> for a day. Before
					them: YourGPT’s defaults, the baseline tab. The bot is named <em>Staging</em> in their dashboard.
				</dd>
			</div>
			<div>
				<dt>How</dt>
				<dd>
					The widget is in the page’s DOM, so <code>components/ChatWidget/ChatSkin.astro</code> restyles it through
					their <code>--yourgptChatbot*</code> properties and stable class names, scoped by <code>data-chat-skin</code>.
					<code>ChatLauncher</code> is our button: a click loads the widget if it has not loaded and opens it
					(<code>util/chat-widget.ts</code>). The window and the launcher run one clock, the AI section’s hue cycle.
				</dd>
			</div>
			<div>
				<dt>Live</dt>
				<dd>
					Each tab holds the real chat, so what you type here goes to the live bot. Their bubbles, send button and
					focus rings take the brand blue: their colours are HSL triplets, which cannot follow an animated colour.
				</dd>
			</div>
			<div>
				<dt>Not done</dt>
				<dd>
					The bot’s name and welcome text in their dashboard; their welcome pop-up, placed for their launcher.
				</dd>
			</div>
		</dl>
	</aside>

	<Direction
		name="Wash · small question"
		shipping
		source="CHAT_SKIN: wash · CHAT_LAUNCHER: circle / white / small / question"
		note="the white circle at 44 — the cookie bar's Accept — 16px in, so it sits on that button's row while the bar is up · a question mark for the sparkles, which are the AI section's mark and read as a second copy of it in the corner · the window 10 clear of it"
	>
		<ChatStage skin="wash" launcher={{ shape: 'circle', tone: 'white', size: 'small', glyph: 'question' }} />
	</Direction>

	<Direction
		name="Wash"
		source="skin: wash · launcher: tile / hue"
		note="the AI band's wash in the header, the hue at 18% fading to white by the first message · our sparkles tile as the bot's mark · Ubuntu, ink, the bot's bubble pale, the visitor's in the brand · launcher: the AI tile at 56, cycling, glow under it"
	>
		<ChatStage skin="wash" launcher={{ shape: 'tile', tone: 'hue' }} />
	</Direction>

	<Direction
		name="Wash · Ask AI pill"
		source="skin: wash · launcher: pill / hue"
		note="the same window; the launcher a white capsule with the tile and 'Ask AI' — says what it is rather than leaving it to the glyph, at the cost of a wider corner · folds to the tile while the chat is open"
	>
		<ChatStage skin="wash" launcher={{ shape: 'pill', tone: 'hue' }} />
	</Direction>

	<Direction
		name="Wash · white circle"
		source="skin: wash · launcher: circle / white (in use 2026-10-01 to 10-02)"
		note="the same window; the launcher a white disc at 56 with the sparkles in the hue, the glow round it in the hue too · the quietest of the launchers on a light page, and the one that stands clearest on the dark hero"
	>
		<ChatStage skin="wash" launcher={{ shape: 'circle', tone: 'white' }} />
	</Direction>

	<Direction
		name="Full wash"
		source="skin: fullwash · launcher: tile / hue"
		note="the band's own direction: white at the top, the hue at 14% at the foot of the window, under the messages and the composer · bot bubbles white on it · the most colour of the four"
	>
		<ChatStage skin="fullwash" launcher={{ shape: 'tile', tone: 'hue' }} />
	</Direction>

	<Direction
		name="Dark header"
		source="skin: dark · launcher: tile / dark"
		note="the bookends' indigo header, white title, a 2px line of the hue along its foot glowing into the chat · launcher in the same indigo with the glyph and the glow in the hue"
	>
		<ChatStage skin="dark" launcher={{ shape: 'tile', tone: 'dark' }} />
	</Direction>

	<Direction
		name="Wash · still launcher"
		source="skin: wash · launcher: tile / hue / cycle: false"
		note="as Wash, but the launcher rests in the brand blue and only cycles while the chat is open · for a corner that is on screen for as long as any page is read"
	>
		<ChatStage skin="wash" launcher={{ shape: 'tile', tone: 'hue', cycle: false }} />
	</Direction>

	<Direction
		name="YourGPT default"
		source="skin: yourgpt · their launcher"
		note="the look before 2026-10-01, as a baseline · the dashboard's settings restated for a mounted chat: purple header and bot bubbles, system font, 18px window, their 50px disc"
	>
		<ChatStage skin="yourgpt" launcher="yourgpt" />
	</Direction>
</Workbench>
