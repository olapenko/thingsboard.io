---
import { Icon } from 'astro-icon/components';
import FeatureBlockSection from '@components/Landing/FeatureBlockSection.astro';
import IntroSection from '@components/Landing/IntroSection.astro';
import type { KeyVisual } from '@root/pages/internal/_key-visuals';

/**
 * ONE DIRECTION, as one section.
 *
 * The sandbox used to lay a direction out as three separate exhibits in a row: the feature row, a
 * bare probe at the shipping width, and a phone probe. Each carried its own caption and its own
 * retire ✕, so three views of ONE idea looked like three competing versions, and the connect page
 * came to thirty exhibits for eight directions. Anyone scrolling it was counting versions that did
 * not exist.
 *
 * A direction is now a section with a header and two views inside it — desktop and phone — and it
 * is promoted or retired as a whole, because a direction is the thing you actually decide about.
 * The middle probe is gone: it duplicated the desktop row at the same width and was only ever there
 * because the row was drawn at the wrong one.
 *
 * On the page, `_VisualPage` turns each direction into a tab: the header below is the tab's heading,
 * and its promote and retire buttons live in the page's bar over the tabs. Without script the
 * directions simply stack, each under its rule.
 *
 * The desktop view passes `badge` along with the copy, because the mark is part of the section and
 * a row judged without it is a row with a 40px hole where the homepage has a glyph. It comes from
 * the visual's own copy object, so both pages take the same one from the same place. The header
 * does NOT carry the mark: on a header it read as a status, and the one status a header shows is
 * `shipping`.
 *
 * The GROUND under that row — tint or white — is a page-level toggle rather than a prop here. The
 * homepage alternates, so which one a visual gets depends on where its row happens to fall, and the
 * two are not equally kind to a pale diagram. That makes it a thing to flip while looking, not a
 * fact to declare per direction.
 *
 * The component is passed as a VALUE rather than through the slot, and rendered twice from that one
 * reference. Two slots would have meant writing every variant's markup twice in the page, and two
 * copies of a thing that must stay identical is how the desktop and phone views end up testing
 * different props.
 */

interface Props {
	/**
	 * Supplies the row's copy. The homepage reads the same object.
	 *
	 * Typed as what this component USES rather than as a whole `KeyVisual`, so a copy draft kept
	 * beside the real entry — `SCALE_CANDIDATE_COPY` — can be passed without being given a `label`
	 * it would never show.
	 */
	visual: Pick<KeyVisual, 'id' | 'title' | 'body' | 'link' | 'badge'>;
	/** What this direction IS. The thing being decided about, so it goes in the header. */
	name: string;
	/** One line on what makes it different from its neighbours. */
	note?: string;
	/**
	 * The direction in use: on the homepage, or for a piece that ships elsewhere, on its page. Set
	 * in source, never from the promote mark, so the green check it earns is always true. The tab
	 * and the hub tile show it; its tab comes first.
	 */
	shipping?: boolean;
	/** The visual itself. Rendered twice — once per view — from this one reference. */
	component: any;
	/** Props for it. The same object both times, so the two views cannot drift apart. */
	props?: Record<string, unknown>;
	/**
	 * Overrides for the phone view only, merged over `props`. For the handful of props that are
	 * genuinely about the width — a rotation that has no room to be noticed, a motion that costs
	 * more than it says on a small drawing. Anything else belongs in `props`, where both views get
	 * it and the comparison stays honest.
	 */
	phoneProps?: Record<string, unknown>;
	/** Media on the left, as the homepage's alternating rows do it for some visuals. */
	imageFirst?: boolean;
	/**
	 * Phone VIEWPORT width, not the visual's width. 375 is the iPhone the row was sized against; the
	 * homepage then hands the visual 367 of it, because `_home-rows.scss` breaks the media out past
	 * the page gutter to 4px of the screen edge. The sandbox used to probe these at 335 — the copy
	 * column's width, not the visual's — so every phone judgement was made 32px too narrow.
	 */
	phone?: number;
	/**
	 * For a visual that is a full-bleed SECTION rather than a row's media: the desktop view becomes a
	 * probe at this width instead of the feature row. A row hands its media 525px, and a section
	 * diagram is already in its stacked form at that width — putting one in a row would be judging a
	 * different picture. The section still groups and still promotes or retires as one.
	 */
	deskWidth?: number;
	/**
	 * Render the homepage's CENTRED statement above the visual instead of putting the visual in a
	 * row. Pass the section's copy — `PLATFORM_SECTION_COPY` is the one this exists for.
	 *
	 * The centred section is where the platform visual is headed — first thing under the hero, the
	 * statement over it rather than beside it — so this is that arrangement, with the real
	 * `IntroSection` and the real copy rather than a mock-up of either. No badge: the centred section
	 * does not carry one, and that is the difference from a row, not an omission.
	 *
	 * It applies to BOTH views. The phone preview frames it like any row, so the statement sits over
	 * the visual there too, at the sizes a phone gives both.
	 */
	intro?: {
		title: string;
		description: string;
		/**
		 * The brand word the heading opens with, as a link. Omitted means NO link — the default here
		 * is the opposite of `IntroSection`'s, because a heading written as one whole sentence is the
		 * normal case for a section drafted against its own drawing.
		 */
		titleLink?: { text: string; href: string } | null;
	};
	/**
	 * The component IS a whole homepage section — its own header, its own full-bleed bands — so it
	 * gets no row and no probe: the desktop view renders it edge to edge at this window's width, the
	 * way `index.astro` places it. `AiSection` is the one this exists for.
	 *
	 * Not `deskWidth`: a probe is a box of a fixed width, and this section's layout answers VIEWPORT
	 * queries (its rows stack at 900, its terminal type steps down at 560), which a box cannot fire.
	 * The phone view frames it, so those queries meet a real 375 viewport there.
	 *
	 * The homepage's global context — `landing`, `sections-flat`, the stripped section fills — is not
	 * loaded here, because every sandbox page imports this file and none of the others want it. The
	 * page that uses `bleed` loads it itself; see `sections/ai.astro`.
	 */
	bleed?: boolean;
}

const {
	visual,
	name,
	note,
	shipping = false,
	component: C,
	props = {},
	phoneProps,
	imageFirst = false,
	phone = 375,
	deskWidth,
	intro,
	bleed = false,
} = Astro.props;

const onPhone = phoneProps ? { ...props, ...phoneProps } : props;

// Keyed by visual and name rather than by position: the mark is read back days later by someone
// deleting files, and a key that says WHICH direction survives the section moving up the page.
const key = `${visual.id}/${name}`;
---

<section
	class="vx"
	data-variant
	data-vx-key={key}
	data-vx-name={name}
	data-vx-label={`${visual.id} · ${name}`}
	data-vx-shipping={shipping ? '' : undefined}
>
	<header class="vx__cap">
		<div class="vx__titles">
			<div class="vx__head">
				<h2 class="vx__name">{name}</h2>
				{
					shipping && (
						<span class="vx__inuse">
							<Icon name="tabler:circle-check-filled" aria-hidden="true" />
							In use
						</span>
					)
				}
			</div>
			{note && <p class="vx__note">{note}</p>}
		</div>
		{/* The page's promote and retire pair is moved in here while this direction is open. */}
		<div class="vx__cmds" data-vx-cmds></div>
	</header>

	<div class="vx__views">
		{/* Desktop: the real row, not a copy of it. Same component, same styles as the homepage. */}
		<div class="vx__view vx__view--desk">
			<p class="vx__vlabel">
				{
					bleed
						? 'Desktop · full-bleed section at this window’s width'
						: intro
							? 'Desktop · 960px in the centred section'
							: deskWidth
								? `Desktop · ${deskWidth}px section`
								: 'Desktop · 525px in the row'
				}
			</p>
			{
				bleed ? (
					<div class="vx__bleed" data-vx-row>
						<C {...props} />
					</div>
				) : intro ? (
					<div class="new-rows" data-vx-row>
						<IntroSection title={intro.title} description={intro.description} titleLink={intro.titleLink ?? null}>
							<C {...props} />
						</IntroSection>
					</div>
				) : deskWidth ? (
					<div class="vx__frame vx__frame--plain">
						<div class="probe" style={`--probe: ${deskWidth}px`}>
							<C {...props} />
						</div>
					</div>
				) : (
					<div class="new-rows" data-vx-row>
						<FeatureBlockSection
							heading={visual.title ?? name}
							description={visual.body ?? ''}
							links={visual.link ? [{ href: visual.link.href, text: visual.link.text }] : []}
							badge={visual.badge}
							imageFirst={imageFirst}
							imageEqual
						>
							<C {...props} />
						</FeatureBlockSection>
					</div>
				)
			}
		</div>

		{
			/* Phone: the row as a phone gets it, not a drawing on a checkerboard.

		    An IFRAME at `phone` CSS pixels, loading this same page with `?frame=<key>`. That matters
		    because the row stacks on `@media (max-width: 768px)` — a VIEWPORT query — so a 375px box
		    on a desktop viewport gets the desktop layout at a quarter of the room, which is not a
		    picture of anything. Inside a frame the viewport really is 375, so the row stacks, the
		    copy reflows, and the media breaks out past the gutter exactly as it does on a phone.

		    The alternative was to reproduce the stacked row here. That is precisely how the desktop
		    view came to be drawn at 673px against the homepage's 525, and it is not being done twice.

		    The frame shows THIS section's desktop row, lifted out by the script in `_VisualPage` —
		    these routes are prerendered, so `Astro.url.searchParams` is empty at build time and the
		    server cannot do the picking. One consequence worth knowing: the framed row renders
		    `props`, not `phoneProps`, so a phone-only override shows in the probe under a `deskWidth`
		    section but not through a frame. Only `whitelabel` uses one today, and rotation is a thing
		    you watch rather than measure. */
		}
		<div class="vx__view vx__view--phone">
			<p class="vx__vlabel">
				Phone · {phone}px viewport{
					phoneProps && (
						<span class="vx__diff">
							{' '}
							·{' '}
							{Object.entries(phoneProps)
								.map(([k, v]) => `${k}=${v}`)
								.join(' ')}
						</span>
					)
				}
			</p>
			<div class="vx__phonebox">
				<div class="vx__device">
					{
						deskWidth && !intro ? (
							// No row to frame: a full-bleed section is not in a feature row on any page. The
							// probe stays, on the row's ground rather than the checkerboard.
							<div class="probe vx__screen" style={`--probe: ${phone}px`}>
								<C {...onPhone} />
							</div>
						) : (
							/* `data-src`, NOT `src`. The frame is this same page, which holds more of these
							   frames — and `loading="lazy"` does not hold them back: Chrome starts a lazy
							   iframe 1250-2500px before it scrolls in, and a page of full-bleed sections put
							   the next phone inside that margin, so each frame loaded frames of its own
							   before the trim in `_VisualPage` could run. One load of the AI page turned into
							   hundreds, and the tab ran out of connections — fonts first, which is how it
							   showed. Only the top-level page copies this into `src`, so a frame never gets
							   one: no recursion, by construction rather than by winning a race. */
							<iframe
								class="vx__phone vx__screen"
								data-src={`?frame=${encodeURIComponent(key)}`}
								width={phone}
								height="600"
								loading="lazy"
								title={`${name} at ${phone}px`}
								data-vx-phone={key}
							/>
						)
					}
				</div>
				{/* Beside the phone it changes. Every phone on the page moves together (`_VisualPage`). */}
				<div class="page-ctl vx__phonectl" role="group" aria-label="Phone view">
					<button type="button" data-phone-pick="screen" aria-pressed="true">One screen</button>
					<button type="button" data-phone-pick="full" aria-pressed="false">Full length</button>
				</div>
			</div>
		</div>
	</div>
</section>

{
	/* The homepage's own row overrides, the same file `index.astro` reads. Global because they are
	   overrides ON a shared component and match ITS class names, which a scoped rule cannot reach.
	   Astro emits a component's styles once however many instances a page has. */
}
<style lang="scss" is:global>
	@use '../../styles/home-rows';
	@use '../../styles/home-intro';

	// `.vx__bleed` is `100vw`, which counts a classic scrollbar's width, so on a page holding one the
	// section would overhang the window by that much and scroll sideways. `clip` rather than `hidden`
	// because `hidden` makes the body a scroll container and the sticky strip stops sticking.
	:root:has(.vx__bleed) body {
		overflow-x: clip;
	}
</style>

<style lang="scss">
	@use '../../styles/variables' as *;

	.vx {
		max-width: 1200px;
		margin: 0 auto $spacing-16;

		// Marked, not hidden: a decision stays visible and can be taken back. Only the heading dims,
		// so a retired direction can still be read while it is open.
		&[data-vx-state='retire'] .vx__head {
			opacity: 0.5;

			.vx__name {
				text-decoration: line-through;
			}
		}
	}

	// With the tabs, a hairline over the open direction sets it off from the tabs and controls above.
	:global(:root[data-vp-tabs]) .vx {
		padding-top: $spacing-6;
		border-top: 1px solid var(--sl-color-hairline-light);
	}

	// Without the tabs (no script), directions stack, and the rule is what tells one from the next.
	:global(:root:not([data-vp-tabs])) .vx {
		padding-top: $spacing-6;
		border-top: 2px solid var(--color-text, #17181c);
	}

	// The name and its description on the left, held to a reading width; promote and retire at the
	// right, level with the name.
	.vx__cap {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: $spacing-4;
		margin-bottom: $spacing-8;
	}

	.vx__titles {
		min-width: 0;
		max-width: 80ch;
	}

	.vx__cmds {
		flex: none;
		padding-top: 2px;

		&:empty {
			display: none;
		}
	}

	.vx__head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: $spacing-2 $spacing-3;
	}

	// The direction's name in the site's own face: it is the thing being decided about, so it reads
	// as a heading, not as a code identifier.
	.vx__name {
		@include card-title;
		margin: 0;
	}

	// Green, the same green as the hub's check: in use means the same thing on every page.
	.vx__inuse {
		@include text-s;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 2px 10px 2px 6px;
		border-radius: 999px;
		background: #e7f5ec;
		font-weight: $font-weight-medium;
		color: #17693a;

		[data-icon] {
			width: 18px;
			height: 18px;
			color: #1f8b4d;
		}
	}

	// Under the name, regular and at reading size: it is the one line that says what is different
	// about this direction.
	.vx__note {
		@include text-m;
		margin: $spacing-2 0 0;
		color: var(--color-text-secondary, #5b616e);
	}

	// Desktop above, phone below. Side by side would put the 525 row and the 335 probe at the same
	// optical size on a laptop, which is the one comparison this page must not invite.
	.vx__views {
		display: grid;
		gap: $spacing-10;
	}

	.vx__vlabel {
		@include text-xs;
		margin: 0 0 $spacing-2;
		font-family: $font-family-mono;
		color: var(--color-text-secondary, #5b616e);
	}

	// A phone override is stated on the label, because a view that is not testing the same thing as
	// the one above it has to say so where it is looked at.
	.vx__diff {
		color: $color-brand;
	}

	// The phone sits centred on the page. The row inside paints its own ground edge to edge, which is
	// what a phone shows; a checkerboard around it would be a border the homepage does not have.
	// Three columns so the phone stays centred with its switch beside it: the outer two share what is
	// left, and the switch takes the start of the right one.
	.vx__phonebox {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: start;
		padding: $spacing-6 0;
	}

	.vx__device {
		grid-column: 2;
	}

	// Stacked, and sticky under the top bar, so at full length it is still beside the phone halfway
	// down it.
	.vx__phonectl {
		position: sticky;
		top: 88px;
		flex-direction: column;
		align-items: stretch;
		justify-self: start;
		max-width: none;
		margin: 0 0 0 $spacing-5;
	}

	// A flat dark frame, so the screen reads as a phone in a hand rather than a strip of page: an even
	// bezel and rounded corners, no notch, buttons or gloss — nothing that would have to be kept
	// honest about which phone it is. The screen's corners follow the bezel's, inset by its width.
	.vx__device {
		--bezel: 10px;
		--corner: 44px;
		// A charcoal a step above the page's darkest ink, so the edge still shows round the dark bands
		// (Products, Choice), whose ground is near-black themselves.
		--frame: #2c2e35;
		padding: var(--bezel);
		border-radius: var(--corner);
		background: var(--frame);
		// Lifted off the page just enough to read as an object, not a cut-out.
		box-shadow:
			0 1px 2px rgb(23 24 28 / 10%),
			0 16px 32px -12px rgb(23 24 28 / 28%);
	}

	// The screen's own box is painted the frame's colour, not white: the rounded clip antialiases the
	// element's background and the framed document separately, and a white box left a light hairline
	// round the corners wherever the row is dark. The document inside paints its own ground anyway.
	.vx__screen {
		display: block;
		overflow: hidden;
		border-radius: calc(var(--corner) - var(--bezel));
		background: var(--frame);
	}

	// A probe has no document of its own to paint the ground, so it keeps the page's white.
	.probe.vx__screen {
		background: #fff;
	}

	// ONE SCREEN, the phone view's default (the switch is in `_VisualPage`): the screen held at a
	// phone's height, the row scrolling inside it. 667 is the 375-wide phone's viewport, which is
	// also about what Safari leaves of a taller phone once its bars are showing. `!important` over
	// the frame's own measured height, which `_VisualPage` writes inline for full length.
	:global(:root[data-phone='screen']) .vx__screen {
		height: 667px !important;
		overflow-y: auto;
		scrollbar-width: none;
	}

	.vx__phone {
		border: 0;
	}

	// A sandbox window that is itself phone-width already shows the row as a phone gets it, in the
	// desktop view above, so a phone preview under it is the same row twice — and a 395px frame
	// that overflows the page. `_VisualPage` does not load the frame at this width either.
	@include media-down(md) {
		.vx__view--phone {
			display: none;
		}
	}

	// The checkerboard shows where a visual's own background stops and the page's begins — a
	// transparent edge is invisible against a plain white frame.
	.vx__frame {
		padding: $spacing-6 0;
		background:
			linear-gradient(45deg, #f2f4f8 25%, transparent 25%, transparent 75%, #f2f4f8 75%),
			linear-gradient(45deg, #f2f4f8 25%, transparent 25%, transparent 75%, #f2f4f8 75%);
		background-position:
			0 0,
			8px 8px;
		background-size: 16px 16px;
		border-radius: $radius-xl;
	}

	// For visuals carrying their own white surface: the checkerboard reads as a background competing
	// with the card fills rather than as the absence of one.
	.vx__frame--plain {
		background: none;
	}

	// Out of the 1200 column and the playground's body padding, to the window's edges. Both are
	// symmetric, so the column's centre is the window's and `50% - 50vw` lands on its left edge.
	.vx__bleed {
		width: 100vw;
		margin-inline: calc(50% - 50vw);
	}
</style>
