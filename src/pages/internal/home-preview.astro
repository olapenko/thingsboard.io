---
import BaseLayout from '@layouts/BaseLayout.astro';
import InternalNav from './_InternalNav.astro';
import { Icon } from 'astro-icon/components';
import CustomersLogo from '@components/Landing/CustomersLogo.astro';
import Hero from '@components/Landing/Hero.astro';
import DashboardShowcase from '@components/Landing/DashboardShowcase.astro';
import { Products } from '@models/site.models';
import IntroSection from '@components/Landing/IntroSection.astro';
import FeatureBlockSection from '@components/Landing/FeatureBlockSection.astro';

import ConnectFlow from '@components/Landing/ConnectFlow.astro';
import SolutionFlow from '@components/Landing/SolutionFlow.astro';
import DigitalTwin from '@components/Landing/DigitalTwin.astro';
import NormalizeFlow from '@components/Landing/NormalizeFlow.astro';
import ScaleGrowth from '@components/Landing/ScaleGrowth.astro';

import { CONNECT_COPY, CONNECT_ROUTES } from '@data/connect-visual';
import { DIGITAL_TWIN_COPY } from '@data/digital-twin-visual';
import { NORMALIZE_COPY } from '@data/normalize-visual';
import { SCALE_COPY } from '@data/scale-visual';
import { SOLUTION_COPY } from '@data/solution-flow';
import FeatureTile from '@components/Landing/FeatureTile.astro';
import ClosingCta from '@components/Landing/ClosingCta.astro';
import EcosystemCard from '@components/Landing/EcosystemCard.astro';
import SectionHeader from '@components/Landing/SectionHeader.astro';
import { homeFeatures } from '~/data/homeFeatures';
import { homeEcosystem } from '~/data/homeEcosystem';
import { homeProducts } from '~/data/homeProducts';
import PricingBackground from '@components/Pricing/PricingBackground.astro';
import { homeCarouselItems } from '~/data/homeCarousel';
import { heroLcpPreload } from '@util/lcp-preload';

/**
 * The homepage with its four feature rows replaced by the five new key visuals, in running order.
 *
 * A copy of `index.astro` rather than a branch inside it: the point is to read the new rows in the
 * page they are headed for — hero, dark customer strip, products, ecosystem and all — without any
 * of that being at risk while the visuals are still being argued about. Everything below the five
 * rows is the live page verbatim.
 *
 * The rows themselves are `FeatureBlockSection`, which is the repo's own alternating row, given a
 * component in its default slot instead of an image. `imageFirst` alternates the sides.
 *
 * Delete this page once the visuals land in `index.astro` for real.
 */

// Passed to both <Hero> and the preload, so the <link> can't name a file the CSS
// won't paint — which is also why backgroundImage isn't left to Hero's default.
// One 16:9 asset at every width. tb-cover-mobile.webp is a 700x1080 portrait
// crop, art-directed for the old full-bleed hero; the split layout's panel is
// 16:9 everywhere, so that crop lost most of its height to `cover` and read as
// a fragment of a dashboard. tb-cover.webp is exactly 1920x1080, so it fits the
// panel with no crop at all.
const HERO_BACKGROUND = '/images/hero/tb-cover.webp';
---

<BaseLayout
	noIndex
	headerVariant="transparent"
	forceLightTheme
	title="Home preview · new key visuals"
	description="ThingsBoard is an open-source IoT platform for device management, data collection, processing, and visualization for your IoT projects."
	customTitle={true}
	preloadLcpImage={heroLcpPreload(HERO_BACKGROUND)}
>
	<!-- HERO -->
	<Hero
		product={Products.CE}
		backgroundImage={HERO_BACKGROUND}
		title={['ThingsBoard', 'The all-in-one IoT platform']}
		subtitle="White-labeled and multi-tenant, deployable on our cloud or inside your own network, with device management, data processing, and visualisation built in."
		buttons={[
			{
				text: 'Try for free',
				icon: 'tabler:cloud-filled',
				href: 'https://thingsboard.cloud/signup',
				variant: 'brand',
				ariaLabel: 'Try ThingsBoard Cloud for free',
			},
			{ text: 'Install', icon: 'tabler:download', href: '/installations/', variant: 'outline' },
		]}
		layout="split"
		showArrow={false}
		anchorLink="#intro"
		videoBackground={{
			webm: 'https://video.thingsboard.io/tb-cover2.webm',
			mp4: 'https://video.thingsboard.io/tb-cover2.mp4',
		}}
	>
		<a slot="kicker" href="https://u24.gov.ua/" target="_blank" rel="noopener noreferrer" class="ua-kicker">
			<svg class="ua-kicker__flag" width="30" height="20" viewBox="0 0 3 2" aria-hidden="true">
				<rect width="3" height="1" fill="#0057b7"></rect>
				<rect y="1" width="3" height="1" fill="#ffdd00"></rect>
			</svg>
			<span class="ua-kicker__label">Support Ukraine</span>
		</a>

		<p class="header-animation hero-note">
			Evaluating for a large deployment?
			<a href="/contact-us/">
				Talk to an expert
				<Icon name="tabler:chevron-right" size="14" aria-hidden="true" />
			</a>
		</p>
	</Hero>

	<!-- Dark strip closing the hero, rather than opening the page content. -->
	<CustomersLogo productTag="ce" onDark />

	<section id="overflow">
		{
			/* The centred statement, in the published wording. An earlier pass rewrote it to set up the
		    five rows; this is the approved copy restored exactly. */
		}
		<IntroSection
			title=" is an all-in-one IoT platform that gives you everything you need to build, deploy, and scale IoT solutions"
			description="It enables device connectivity via industry-standard IoT protocols - Modbus, LoRaWAN, MQTT, and CoAP, and supports both cloud and on-premises deployments. ThingsBoard combines scalability, fault tolerance, and performance so you will never lose your data."
		/>

		{
			/* The five new key visuals, in running order, alternating sides. Wrapped so the page can
		    tighten the row and alternate its wash without touching the shared component, which two
		    product pages also use. */
		}
		<div class="new-rows">
			<FeatureBlockSection
				heading={CONNECT_COPY.title}
				description={CONNECT_COPY.body}
				links={[{ href: CONNECT_COPY.link.href, text: CONNECT_COPY.link.text }]}
				badge={CONNECT_COPY.badge}
				imageEqual
			>
				<ConnectFlow groups={CONNECT_ROUTES} />
			</FeatureBlockSection>

			<FeatureBlockSection
				heading={SOLUTION_COPY.title}
				description={SOLUTION_COPY.body}
				links={[{ href: SOLUTION_COPY.link.href, text: SOLUTION_COPY.link.text }]}
				badge={SOLUTION_COPY.badge}
				imageFirst
				imageEqual
			>
				<SolutionFlow />
			</FeatureBlockSection>

			<FeatureBlockSection
				heading={DIGITAL_TWIN_COPY.title}
				description={DIGITAL_TWIN_COPY.body}
				links={[{ href: DIGITAL_TWIN_COPY.link.href, text: DIGITAL_TWIN_COPY.link.text }]}
				badge={DIGITAL_TWIN_COPY.badge}
				imageEqual
			>
				<DigitalTwin />
			</FeatureBlockSection>

			<FeatureBlockSection
				heading={NORMALIZE_COPY.title}
				description={NORMALIZE_COPY.body}
				links={[{ href: NORMALIZE_COPY.link.href, text: NORMALIZE_COPY.link.text }]}
				badge={NORMALIZE_COPY.badge}
				imageFirst
				imageEqual
			>
				<NormalizeFlow />
			</FeatureBlockSection>

			<FeatureBlockSection
				heading={SCALE_COPY.title}
				description={SCALE_COPY.body}
				links={[{ href: SCALE_COPY.link.href, text: SCALE_COPY.link.text }]}
				badge={SCALE_COPY.badge}
				imageEqual
			>
				<ScaleGrowth />
			</FeatureBlockSection>
		</div>

		<!-- Products + ecosystem share one band; the wave field is Products' own -->
		<div class="home-band">
			<!-- Products Section -->
			<section id="products">
				<PricingBackground contained />
				<div class="main-div">
					<SectionHeader title="Products" subtitle="Same platform either way. Choose who owns the infrastructure." />
					<div class="product-list">
						{homeProducts.map((product) => <EcosystemCard {...product} />)}
					</div>
				</div>
			</section>

			<!-- Product Ecosystem Section -->
			<section id="product-ecosystem">
				<div class="main-div">
					<SectionHeader
						title="Product ecosystem"
						subtitle="Add what your project needs — protocol bridges, analytics, edge nodes, a mobile app, and a library of ready-made components."
					/>
					<div class="product-ecosystem-list">
						{
							homeEcosystem.map((product) => (
								<EcosystemCard
									name={product.name}
									label={product.label}
									description={product.description}
									icon={product.icon}
									href={product.href}
									accent={product.accent}
									action={product.action}
									addOn={product.addOn}
									wide={product.wide}
									videoWebm={product.videoWebm}
									videoMp4={product.videoMp4}
									stores={product.stores}
									flipped={product.flipped}
									tiles={product.tiles}
								/>
							))
						}
					</div>
				</div>
			</section>
		</div>

		<!-- Dashboard Description Section -->
		<section id="dashboard_description">
			<div class="main-div">
				<SectionHeader
					title="Build real-time IoT dashboards"
					subtitle="Build the view your users need from 600+ widgets, and control devices from the same screen. No front-end work required."
				>
					<div class="view-all-link">
						<a href="/use-cases/">Browse all use cases</a>
					</div>
				</SectionHeader>
				<DashboardShowcase items={homeCarouselItems} interval={12000} />
			</div>
		</section>

		<!-- Bottom Features Section -->
		<section id="bottom-features">
			<div class="main-div">
				<SectionHeader
					title="ThingsBoard Features"
					subtitle="What you get out of the box, before writing a line of code."
				/>
				<div id="cards">
					{homeFeatures.map((feature) => <FeatureTile {...feature} />)}
				</div>
			</div>
		</section>
	</section>

	<ClosingCta />
	<InternalNav />
</BaseLayout>

{/* Scoped to `.new-rows`, so none of it reaches the product pages that share this component. */}
<style is:global lang="scss">
	@use '../../styles/variables' as *;

	// --- the row ----------------------------------------------------------------------------

	// The tighter measure these visuals were drawn against. FeatureBlockSection is built for a
	// screenshot — a 1400 measure, 100px of side padding, a 60px gutter — which hands them a 540px
	// column when they were authored for 673.
	//
	// Typography is NOT overridden here. An earlier pass set 36px bold, which is the sandbox's own
	// approximation rather than anything this site uses; the component's 32px semibold is the real
	// homepage scale and the rows should be read in it.
	// The measure the Products band below already uses — `.main-div` at 1000 with 20px of side
	// padding, so 960 of content. The rows were running 160px wider than everything under them,
	// which is the kind of difference you feel as the page wandering rather than see.
	.new-rows .main-div {
		max-width: 1000px;
		// 80, not 72 plus a 420 floor. The floor was holding rows at 564px when the tallest visual
		// needs about 400 — so most of every row was air. Padding alone now sets the rhythm and the
		// content sets the height.
		padding: 80px 20px;
	}

	.new-rows .block {
		gap: 56px;
		// Enough that the shortest row does not collapse next to the tallest, low enough that none of
		// them is mostly empty.
		min-height: 300px;
	}

	// The copy column capped in characters rather than as a fraction: a measure is a reading
	// constraint, and the media takes what is left.
	// 42ch, not 46. At the narrower measure the old split left the media 473px — below the 480 the
	// tightest visual wants — so the copy gives up four characters and the gap sixteen pixels, and
	// the visuals get the difference. A measure of 42 characters is still inside the comfortable
	// range for reading; a visual 473px wide is not inside anything.
	.new-rows .feature-des {
		flex: 0 1 42ch;
		max-width: 42ch;
	}

	// --- typography ---------------------------------------------------------------------------

	// A step down the existing scale rather than an arbitrary number: $font-size-3xl, which the
	// component already drops to at phone width. At 32px these headings ran to three lines in a 46ch
	// column and the row had to grow to hold them.
	.new-rows .feature-des .phrase-heading {
		font-size: $font-size-3xl;
		line-height: 1.25;
		text-wrap: balance;
	}

	.new-rows .feature-des .heading-wrap {
		margin-bottom: 14px;
	}

	.new-rows .feature-des p {
		font-size: 17px;
		line-height: 1.6;
	}

	.new-rows .feature-des .links {
		margin-top: 20px;
	}

	// A smaller tile carrying a bigger glyph: 40px around 24px, so the mark fills 60% of the square
	// instead of 42%. The padding was doing the work the icon should do — at 20px in a 48px tile the
	// two read as a square with something in it rather than as one mark. The rounding stays the
	// page's 32%, a percentage, so it holds at the smaller size without retuning.
	.new-rows .feature-badge {
		width: 40px;
		height: 40px;
		margin-bottom: 18px;
	}

	// Matched through `.feature-des` as well: the component nests its glyph rule inside the badge,
	// so the shorter selector tied on specificity and lost on order — the tile shrank and the icon
	// in it did not.
	.new-rows .feature-des .feature-badge [data-icon] {
		width: 24px;
		height: 24px;
	}

	// Capped, and centred in whatever is left over. These are drawn at 480-630 design units with an
	// upscale ceiling, so an unbounded column just makes them bigger than they were designed —
	// which is what made the scale chart tower over its own row.
	.new-rows .preview {
		display: flex;
		flex: 1 1 0;
		justify-content: center;
		min-width: 0;
	}

	.new-rows .preview > * {
		width: 100%;
		max-width: 560px;
	}

	// --- the phone ------------------------------------------------------------------------------

	// Everything above is sized for a row read side by side. Stacked, the same numbers are mostly
	// scroll: 80px of padding top and bottom plus a 56px gap is 216px of nothing per row, which on a
	// 812px screen is a quarter of the section before a word of it has been read. Five rows came to
	// 3885px — very nearly five screenfuls.
	@media screen and (max-width: 768px) {
		.new-rows .main-div {
			padding: 36px 20px;
		}

		.new-rows .block {
			gap: 20px;
			// Sized to keep a side-by-side row from collapsing beside a taller one. Stacked there is
			// no beside, and the floor only holds short rows open.
			min-height: 0;
		}

		// The one that was really costing the height. `flex: 0 1 42ch` is a MEASURE — a reading width
		// — and it is only that while the row is a row. Once it stacks, flex-basis is the main axis
		// again, so 42ch resolved to 379px of HEIGHT and the copy sat in a box 76px taller than its
		// own text, on every row. A measure has no meaning in a single-column layout; the screen is
		// the measure.
		.new-rows .feature-des {
			flex: 0 1 auto;
			max-width: none;
		}

		// Out past the page's own gutter, to 4px of the screen edge.
		//
		// 16px, because the gutter is 20 — the number to change if that ever moves. These diagrams
		// scale rather than reflow, so 32 more pixels of width is 32 more pixels of everything:
		// 335 -> 367 takes the smallest label from 5.8px to 6.4px. Worth having and not a fix. The
		// thing that actually decides legibility here is the ratio of a composition's native width to
		// its smallest type, and no amount of margin touches that.
		//
		// `align-self: stretch` comes from the component, so the negative margins widen the box
		// rather than just sliding it left.
		.new-rows .preview {
			margin-inline: -16px;
		}

		// The 560 cap is a desktop ceiling — it exists so a visual is not upscaled past its design
		// size in a wide column. At 367 nothing is near it, and leaving it in would only re-centre
		// the visual inside the width just given to it.
		.new-rows .preview > * {
			max-width: none;
		}

		// The copy's own rhythm, closed up to match.
		.new-rows .feature-badge {
			margin-bottom: 12px;
		}

		.new-rows .feature-des .heading-wrap {
			margin-bottom: 10px;
		}

		.new-rows .feature-des .links {
			margin-top: 16px;
		}
	}

	// --- the opening statement -----------------------------------------------------------------

	// Tighter. The section ships with 80px of padding above and 178px of margin below, sized for a
	// page whose next element was not a full-bleed band; against one it reads as a gap rather than
	// as breathing room.
	:root #intro.intro-section {
		margin-bottom: 64px;
		padding-top: 64px;
	}

	:root #intro .intro-section__title {
		margin-bottom: 20px;
	}

	// --- the wash ---------------------------------------------------------------------------

	// Full bleed and square. A rounded card at the measure read as a component sitting on the page;
	// a band reads as the page itself changing colour, which is what alternating rows are for.
	//
	// The `:root` prefix is not decoration. `sections-flat` carries
	// `:root section:not(.customers-logo--dark):not(.closing-cta) { background: none }`, which scores
	// (0,3,1) — one higher than this selector managed without it, so the wash was being painted and
	// then flattened with no error anywhere.
	:root .new-rows .feature-block-section:nth-child(odd) {
		background: #f5f6ff;
	}

	// --- links ------------------------------------------------------------------------------

	// A link that behaves like one: underlined on hover, a visible focus ring for the keyboard, and
	// a pressed state. The arrow is gone — the colour already says it is a link, and the chevron was
	// a second signal for the same thing.
	.new-rows .read-more-link .arrow-container {
		display: none;
	}

	.new-rows .read-more-link {
		text-decoration: none;
		text-underline-offset: 0.2em;
		transition: color 0.15s ease;

		&:hover {
			text-decoration: underline;
		}

		&:focus-visible {
			outline: 2px solid currentColor;
			outline-offset: 3px;
			border-radius: 2px;
		}

		&:active {
			opacity: 0.75;
		}
	}
</style>

<style is:global lang="scss">
	@use '../../styles/landing';
	@use '../../styles/variables' as *;
	// FLAT SECTIONS TRIAL — delete this one line to revert the homepage to the
	// diagonal bands, card shadows and full-strength accents. See the file
	// header in _sections-flat.scss for what it changes and why.
	@use '../../styles/sections-flat';

	// --- Homepage facelift: menu height, primaries, secondaries, GitHub button ---

	.hero-note {
		margin: 24px 0 0;
		font-size: 14px;
		line-height: 1.4;
		// Secondary: it sat at the same full white as .tb-sub-title, so a
		// qualifying aside carried the weight of the hero's body copy. The link
		// keeps its brighter 0.85 — it is the actionable half, and dimming an
		// underlined link along with its label costs affordance rather than
		// emphasis. Last in the reveal (nth-child(5) -> 1200ms), so it arrives
		// after the buttons rather than alongside the headline.
		color: rgba(255, 255, 255, 0.6);

		// The `header-animation` class alone does nothing here: this paragraph is
		// slotted into Hero, so it never receives Hero's scope hash and none of
		// that component's `.header-animation` rules match it — measured as
		// `animation-delay: 0s` and `opacity: 1` while the headline, subtitle and
		// buttons all animated. The reveal is restated locally instead, picking up
		// the stagger after the buttons' 900ms. `slideup-in` is emitted unscoped,
		// so the keyframes themselves are shared rather than duplicated.
		&.header-animation {
			opacity: 0;
			transform: translate3d(0, 45px, 0);
			animation-name: slideup-in;
			animation-duration: 600ms;
			animation-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94);
			animation-fill-mode: forwards;
			animation-delay: 1200ms;
		}

		// Authoring this reveal fresh, so it gets the guard the component's own
		// sequence never had.
		@media (prefers-reduced-motion: reduce) {
			&.header-animation {
				animation: none;
				opacity: 1;
				transform: none;
			}
		}

		a {
			// Always its own line. Side by side only ever fitted at the widest
			// columns, and the 8px that set the link off from the question became a
			// stray indent the moment the note wrapped — the link hung in from the
			// paragraph's left edge with nothing above it. Stacking retires the
			// margin instead of tuning it per breakpoint. `fit-content` keeps the
			// underline on the words rather than running the paragraph's width.
			display: flex;
			width: fit-content;
			align-items: center;
			gap: 2px;
			margin-top: 6px;
			color: rgba(255, 255, 255, 0.85);
			text-decoration: underline;
			text-underline-offset: 3px;

			&:hover,
			&:focus-visible {
				color: #fff;
			}
		}
	}

	// `html:root` rather than `:root`: Starlight sets its accent on `:root` too,
	// and at equal specificity the winner is whichever sheet lands last.
	html:root {
		// Shorter menu. Hero reads it too, so the video panel and the text column
		// stay clear of it without a second constant to keep in sync.
		--home-header-h: 64px;

		// One purple. `--color-primary` resolves through Starlight's accent, which
		// was still the old #1a6fd4, and `--tb-main-color` was #2a7dec — while
		// `--color-primary-rgb` had already moved to 61,80,245.
		--sl-color-text-accent: #{$color-brand};
		--color-primary: #{$color-brand};
		--tb-main-color: #{$color-brand};

		// Muted hero text. Full alpha and a stronger chroma: dropping the alpha
		// mixes the colour toward the black column, which is what kept flattening
		// the hue. Vividness has to come from the colour, not the opacity.
		--hero-muted: rgba(150, 164, 255, 0.72);
	}

	header.header {
		height: var(--home-header-h);
		transition-duration: 0.1s;
	}

	// The transparent bar gets a scrim rather than nothing. It spans both halves
	// of the split hero — the black text column and the video panel — and over
	// the footage the nav had no ground of its own, so its legibility changed
	// with whatever frame was playing. 80% black reads as one continuous surface
	// across both halves while the panel still shows through.
	//
	// Both guards match the Sign in and GitHub rules below: the scrolled bar has
	// its own solid surface, and the open drawer is a light one, so neither wants
	// black poured over it. Scoped to this page — the three product pages also
	// use `transparent`, over a full-bleed image rather than a split panel, and
	// changing their heroes was not asked for.
	header.header:not(.opened-burger):not([data-header-scrolled]):has([data-header-variant='transparent']) {
		background-color: rgba(0, 0, 0, 0.8);
	}

	// `.logo--lg` in the header component resolves to `header .logo.logo--lg`,
	// which ties with a plain `header.header .logo` — so match its class count
	// and win on order rather than relying on it.
	header.header .logo.logo--lg {
		height: 50px;
		width: 175px;

		@media screen and (min-width: 1025px) {
			width: 215px;
		}

		@media screen and (min-width: 1281px) and (max-width: 1599px) {
			width: 160px;
		}

		// Phones: 175px put the wordmark shoulder to shoulder with the Menu
		// button on a 375px screen. Height follows so the mark keeps its ratio
		// inside the box — width drives `contain` at every one of these sizes.
		@media screen and (max-width: 767px) {
			width: 168px;
			height: 48px;
		}

		@media screen and (max-width: 480px) {
			width: 152px;
			height: 44px;
		}
	}

	// Primary: one purple across the page — the header CTA, the hero, and the
	// n-button primaries in the sections below. White on #3d50f5 is 5.73:1, which
	// clears AA for body-sized text.
	.n-button--filled,
	#hero .button.brand,
	.closing-cta__primary,
	.closing-cta__secondary {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		font-weight: $font-weight-bold;
		background-color: $color-brand;
		color: #fff;
	}

	// Shimmer: a single skewed highlight crossing on hover. Transform-only, so it
	// composites rather than repainting, and it runs once per hover instead of
	// looping.
	.n-button--filled::after,
	#hero .button.brand::after,
	#hero .learn-tb::after,
	.closing-cta__primary::after,
	.closing-cta__secondary::after {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		width: 45%;
		z-index: -1;
		pointer-events: none;
		background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.38), transparent);
		transform: translateX(-160%) skewX(-18deg);
	}

	.n-button--filled:hover::after,
