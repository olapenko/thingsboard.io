---
import { Icon } from 'astro-icon/components';

/**
 * ONE DIRECTION of a chrome part — one variant or candidate — as a section the workbench turns
 * into a tab (`_Workbench`). The header below is the tab's heading. Without script the directions
 * simply stack, each under its rule.
 *
 * `shipping` marks the one in use. Set in source, never from a mark, so the green check is always
 * true; its tab comes first and opens by default.
 */
interface Props {
	name: string;
	/** One line on what makes it different from its neighbours. */
	note?: string;
	shipping?: boolean;
	/** Where it is set: a file, a prop, a data key. The tab's footnote. */
	source?: string;
}

const { name, note, shipping = false, source } = Astro.props;
const slug = name
	.toLowerCase()
	.replace(/[^a-z0-9]+/g, '-')
	.replace(/^-|-$/g, '');
---

<section class="dir" data-direction={slug} data-dir-name={name} data-dir-shipping={shipping ? '' : undefined}>
	<header class="dir__head">
		<div class="dir__titles">
			<h2 class="dir__name">
				{name}
				{shipping && (
					<span class="dir__inuse">
						<Icon name="tabler:circle-check-filled" aria-hidden="true" />
						In use
					</span>
				)}
			</h2>
			{note && <p class="dir__note">{note}</p>}
			{source && <p class="dir__source">{source}</p>}
		</div>
	</header>
	<div class="dir__body">
		<slot />
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	.dir {
		max-width: 1200px;
		margin: 0 auto;
		padding-top: $spacing-6;
	}

	.dir__head {
		margin-bottom: $spacing-6;
	}

	.dir__name {
		@include type-subsection;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: $spacing-3;
		margin: 0;
	}

	.dir__inuse {
		@include type-small-strong;
		display: inline-flex;
		align-items: center;
		gap: 4px;
		color: var(--color-accent-green, #008741);

		:global(svg) {
			width: 18px;
			height: 18px;
		}
	}

	.dir__note {
		@include type-body;
		max-width: 90ch;
		margin: $spacing-2 0 0;
		color: var(--color-text-secondary, #5b616e);
		text-wrap: pretty;
	}

	.dir__source {
		@include type-small;
		margin: $spacing-2 0 0;
		font-family: $font-family-mono;
		color: var(--color-text-muted, #868d9a);
	}
</style>
