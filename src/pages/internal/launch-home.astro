---
import PlaygroundLayout from '@layouts/PlaygroundLayout.astro';
import LaunchRow from './_LaunchRow.astro';

import ConnectFlow from '@components/Landing/ConnectFlow.astro';
import SolutionFlow from '@components/Landing/SolutionFlow.astro';
import DigitalTwin from '@components/Landing/DigitalTwin.astro';
import NormalizeFlow from '@components/Landing/NormalizeFlow.astro';
import ScaleGrowth from '@components/Landing/ScaleGrowth.astro';

import { CONNECT_COPY, CONNECT_ROUTES } from '@data/connect-visual';
import { DIGITAL_TWIN_COPY } from '@data/digital-twin-visual';
import { NORMALIZE_COPY } from '@data/normalize-visual';
import { SCALE_COPY } from '@data/scale-visual';

/**
 * The five new key visuals in the running order, alternating sides — the thing the tabbed sandbox
 * cannot show, which is how they read one after another.
 *
 * Each visual is judged on its own over on `launch-visuals`; this page is for the questions only a
 * sequence asks. Do the five look like one family or five hands? Does the eye get tired of the same
 * converging-curve shape three sections running? Is the rhythm right once the sides alternate?
 *
 * Copy comes from each visual's own data file, so this page and the sandbox cannot drift apart.
 * The device-to-end-user row is the exception — its words still live in the sandbox's tab list
 * rather than in a data file of their own, so they are repeated here and marked as such.
 */

// The only copy on this page without a data file behind it. It belongs in `solution-flow.ts`
// alongside the cases, and should move there before either page ships.
const SOLUTION_COPY = {
	title: 'Build IoT solutions from device to end-user',
	body: 'ThingsBoard enables development of the complete use-case and is white-labeled for your customers or your team: ship complete IoT applications, not just data pipelines.',
	link: { text: 'Why ThingsBoard is the best IoT platform', href: '/products/' },
};
---

<PlaygroundLayout
	title="Launch home"
	description="The five new key visuals in running order, alternating sides, in the homepage row they are headed for."
>
	<p class="lead">
		Five new key visuals in running order. Alternating sides, homepage measure, no stage chrome — for judging the
		sequence rather than any one of them.
	</p>

	<LaunchRow title={CONNECT_COPY.title} body={CONNECT_COPY.body} link={CONNECT_COPY.link}>
		{
			/* The four routes the connectivity guide defines, not the three-group set the component
		    still defaults to — that one calls LoRaWAN an endpoint and NB-IoT a connection method. */
		}
		<ConnectFlow groups={CONNECT_ROUTES} />
	</LaunchRow>

	<LaunchRow title={SOLUTION_COPY.title} body={SOLUTION_COPY.body} link={SOLUTION_COPY.link} flip>
		<SolutionFlow />
	</LaunchRow>

	<LaunchRow title={DIGITAL_TWIN_COPY.title} body={DIGITAL_TWIN_COPY.body} link={DIGITAL_TWIN_COPY.link}>
		<DigitalTwin />
	</LaunchRow>

	<LaunchRow title={NORMALIZE_COPY.title} body={NORMALIZE_COPY.body} link={NORMALIZE_COPY.link} flip>
		<NormalizeFlow />
	</LaunchRow>

	<LaunchRow title={SCALE_COPY.title} body={SCALE_COPY.body} link={SCALE_COPY.link}>
		<ScaleGrowth />
	</LaunchRow>
</PlaygroundLayout>

<style lang="scss">
	@use '../../styles/variables' as *;

	.lead {
		@include text-s;
		max-width: 1160px;
		margin: 0 auto $spacing-8;
		color: var(--color-text-secondary, #5b616e);
	}
</style>
