---
import Bookend from '@components/Landing/Bookend.astro';
import Footer from '@components/Landing/Footer.astro';
import FooterMap from '@components/Landing/FooterMap.astro';

/**
 * The bottom of a page: a bookend, then a footer under it. The band is `Bookend`, the homepage's
 * unless a `bookend` is given; the footer is the one in use or a `FooterMap` layout. The seam between
 * the two is half of what either is judged on.
 */
interface Props {
	footer?: 'in-use' | 'map' | 'focus';
	/** Which bookend, and how; the homepage's centred band without one. */
	bookend?: {
		id: 'home' | 'cloud' | 'onprem';
		ways?: 'buttons' | 'regions' | 'platforms' | 'cards';
		tone?: 'dark' | 'light';
	};
}

const { footer = 'map', bookend } = Astro.props;
---

<div class="fs">
	<Bookend {...bookend ?? { id: 'home' }} />
	{footer === 'in-use' ? <Footer /> : <FooterMap layout={footer} />}
</div>
