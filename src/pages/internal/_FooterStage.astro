---
import ClosingCta from '@components/Landing/ClosingCta.astro';
import Footer from '@components/Landing/Footer.astro';
import FooterMap from '@components/Landing/FooterMap.astro';

/**
 * The bottom of the homepage: the closing band, then a footer under it — the one in use or the
 * candidate. The band is the real `ClosingCta`, because the seam between the two dark grounds is
 * half of what the footer is judged on; the footer in use sits on `#0f161d` under the band's
 * `#121425`, and the candidate on the band's own.
 */
interface Props {
	footer: 'in-use' | 'map' | 'strip';
}

const { footer } = Astro.props;
---

<div class="fs">
	<ClosingCta />
	{footer === 'in-use' ? <Footer /> : <FooterMap layout={footer} />}
</div>

<style is:global>
	/* The band's ground back. `_bleed-context` strips every section's fill, as `index.astro` does —
	   but the homepage exempts this band (`:not(.closing-cta)`), and the stage has to as well, or the
	   seam being judged is a white band over a dark footer. */
	:root .fs section.closing-cta {
		background-color: #121425;
	}
</style>
