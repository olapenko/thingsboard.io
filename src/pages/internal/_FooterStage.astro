---
import ClosingCta from '@components/Landing/ClosingCta.astro';
import Bookend from '@components/Landing/Bookend.astro';
import Footer from '@components/Landing/Footer.astro';
import FooterMap from '@components/Landing/FooterMap.astro';

/**
 * The bottom of a page: a bookend, then a footer under it. The band is the real `ClosingCta` unless
 * a `bookend` is given, in which case it is the `Bookend` candidate; the footer is the one in use or
 * a `FooterMap` layout. The seam between the two is half of what either is judged on.
 */
interface Props {
	footer?: 'in-use' | 'map' | 'focus';
	/** Draw the `Bookend` candidate instead of `ClosingCta`. */
	bookend?: {
		id: 'home' | 'cloud' | 'onprem';
		ways?: 'buttons' | 'regions' | 'platforms' | 'cards';
		tone?: 'dark' | 'light';
	};
}

const { footer = 'map', bookend } = Astro.props;
---

<div class="fs">
	{bookend ? <Bookend {...bookend} /> : <ClosingCta />}
	{footer === 'in-use' ? <Footer /> : <FooterMap layout={footer} />}
</div>

<style is:global>
	/* The bands' grounds back. `_bleed-context` strips every section's fill, as `index.astro` does —
	   but the homepage exempts its closing band (`:not(.closing-cta)`), and the stage has to exempt
	   both it and the Bookend, or the seam being judged is a white band over a dark footer. */
	:root .fs section.closing-cta {
		background-color: #121425;
	}

	:root .fs section.bk {
		background-color: var(--bk-ground);
	}
</style>
