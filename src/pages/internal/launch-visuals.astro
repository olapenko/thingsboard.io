---
/**
 * Working surface for the launch visuals.
 *
 * Internal reference page: not linked from anywhere, `noindex` via the layout, and so kept out
 * of the sitemap. Its job is to hold each new visual on its own, at the width it will really
 * get, with nothing else on the page competing for judgement — one page tab per visual.
 *
 * This file is only the frame: the tab strip, the page-wide controls, and one `<Panel />` per
 * visual. Every panel's stages live in `_panels/_<id>.astro`, so two people — or two sessions —
 * working on different visuals never edit the same file.
 *
 * ADD a visual: an entry in `_key-visuals.ts`, a file in `_panels/`, and one line in each of the
 * two lists below. REMOVE one: delete the panel file and those same two lines. Nothing else on
 * the page knows a given visual exists.
 *
 * Inside a panel, wrap each exhibit in `<figure class="stage" data-stage="<id>">`. `data-w` picks
 * the frame width — `full`, `half` or `card` — matching the three widths a visual actually lands
 * in on the marketing pages, and `data-stage` is what the retire control marks. `_FeatureRow` is
 * the homepage row a visual is headed for, with its token switch.
 *
 * Stage chrome is declared `is:global` below, not scoped: a scoped rule here cannot reach markup
 * that lives in a panel file.
 *
 * This page is scaffolding, not shipped content: nothing here needs to survive into a
 * marketing page except the components themselves.
 */
import PlaygroundLayout from '@layouts/PlaygroundLayout.astro';
import { KEY_VISUALS } from '@root/pages/internal/_key-visuals';
import CliPanel from '@root/pages/internal/_panels/_cli.astro';
import SolutionPanel from '@root/pages/internal/_panels/_solution.astro';
import TwinPanel from '@root/pages/internal/_panels/_twin.astro';
import NormalizePanel from '@root/pages/internal/_panels/_normalize.astro';
import GatewayPanel from '@root/pages/internal/_panels/_gateway.astro';
import ConnectPanel from '@root/pages/internal/_panels/_connect.astro';
import ScalePanel from '@root/pages/internal/_panels/_scale.astro';
import DeployPanel from '@root/pages/internal/_panels/_deploy.astro';
import WhitelabelPanel from '@root/pages/internal/_panels/_whitelabel.astro';
import CompactPanel from '@root/pages/internal/_panels/_compact.astro';
---

<PlaygroundLayout
	title="Launch visuals"
	description="Each visual on its own, at the width it gets in the page it is headed for. One tab per visual."
>
	{
		/* Page tabs: one per key visual. Each shows only its own stages, so a visual is judged without
	    the others in the corner of the eye. The pick is remembered across reloads. */
	}
	<nav class="page-tabs" role="tablist" aria-label="Key visual" data-page-tabs>
		{
			KEY_VISUALS.map((kv, i) => (
				<button
					type="button"
					role="tab"
					id={`page-tab-${kv.id}`}
					aria-selected={i === 0 ? 'true' : 'false'}
					aria-controls={`page-panel-${kv.id}`}
					data-page-tab={kv.id}
				>
					{kv.label}
				</button>
			))
		}
	</nav>

	{
		/* Page-wide, not per-panel: the question this answers — does the family want a monospace
	    face at all — is the same question in every visual, and switching one at a time is how you
	    end up preferring whichever you happened to look at last.

	    It works by setting `--flow-font-mono`, which every visual's chip and label rules read with
	    the mono stack as their fallback. Nothing outside this page is affected: with no attribute
	    set the property is undefined and the fallback stands, which is exactly what a marketing
	    page renders.

	    CliTerminal is deliberately NOT wired to it. A terminal in a proportional face is not a
	    design option, it is a mistake. */
	}
	<div class="page-ctl" role="group" aria-label="Chip typeface" data-font-switch>
		<span class="page-ctl__name">Chips &amp; labels</span>
		<button type="button" data-font-pick="mono" aria-pressed="true">Ubuntu Mono</button>
		<button type="button" data-font-pick="sans" aria-pressed="false">Ubuntu</button>
	</div>

	{
		/* Retiring stages.
	    A sandbox only earns its keep while you can still see what is in it, and this one is at
	    forty-eight exhibits. The judgement about whether an exhibit is still worth keeping is only
	    good while you are looking at the exhibit — so it is made there, with the ✕ in each stage's
	    caption, and collected here.

	    Marking is not deleting. It records a decision in localStorage and greys the stage; the
	    files go when someone reads the list back and removes them, which is a separate commit and
	    a revert if it turns out to be wrong. Copy the list before clearing site data — this is the
	    only place it lives. */
	}
	<div class="page-ctl" data-retire-bar hidden>
		<span class="page-ctl__name">Retired</span>
		<span class="page-ctl__count" data-retire-count>0</span>
		<button type="button" data-retire-copy>Copy list</button>
		<button type="button" data-retire-show aria-pressed="false">Show marked</button>
		<button type="button" data-retire-clear>Clear marks</button>
	</div>

	<CliPanel />
	<SolutionPanel />
	<TwinPanel />
	<NormalizePanel />
	<GatewayPanel />
	<ConnectPanel />
	<ScalePanel />
	<DeployPanel />
	<WhitelabelPanel />
	<CompactPanel />
</PlaygroundLayout>

<script>
	// The page tabs. One panel showing at a time; the pick is remembered like the token set.
	const TAB_KEY = 'launch-visuals:tab';
	document.querySelectorAll<HTMLElement>('[data-page-tabs]').forEach((list) => {
		const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[data-page-tab]'));
		const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-page-panel]'));
		const show = (id: string) => {
			tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.pageTab === id)));
			panels.forEach((p) => (p.hidden = p.dataset.pagePanel !== id));
		};
		let saved: string | null = null;
		try {
			saved = localStorage.getItem(TAB_KEY);
		} catch {
			/* private mode; fine */
		}
		if (saved && tabs.some((t) => t.dataset.pageTab === saved)) show(saved);
		tabs.forEach((t) =>
			t.addEventListener('click', () => {
				const id = t.dataset.pageTab ?? '';
				show(id);
				try {
					localStorage.setItem(TAB_KEY, id);
				} catch {
					/* ignore */
				}
			})
		);
	});

	// The cloud's chip coding. Drives `data-chip` on every ConnectCloud in the panel, which is the
	// same attribute the component's own prop sets — so the sandbox and a real page cannot disagree
	// about what a value means.
	const CHIP_KEY = 'launch-visuals:chip';
	document.querySelectorAll<HTMLElement>('[data-chip-switch]').forEach((group) => {
		const picks = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-chip-pick]'));
		const clouds = Array.from(document.querySelectorAll<HTMLElement>('[data-page-panel="connect"] .cl'));
		// Two things from one pick: `data-chip` chooses the coding, `--connect-tint` its strength. The
		// property goes on :root rather than on the clouds because the section's copy reads it too,
		// and that copy is not inside any of them.
		const apply = (value: string) => {
			clouds.forEach((c) => c.setAttribute('data-chip', value === 'tint-light' ? 'tint' : value));
			if (value === 'tint-light') document.documentElement.style.setProperty('--connect-tint', '10%');
			else document.documentElement.style.removeProperty('--connect-tint');
			picks.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.chipPick === value)));
		};
		let saved: string | null = null;
		try {
			saved = localStorage.getItem(CHIP_KEY);
		} catch {
			/* private mode; fine */
		}
		if (saved) apply(saved);
		picks.forEach((b) =>
			b.addEventListener('click', () => {
				const value = b.dataset.chipPick ?? 'tint';
				apply(value);
				try {
					localStorage.setItem(CHIP_KEY, value);
				} catch {
					/* ignore */
				}
			})
		);
	});

	// How the section's copy keys the cloud. One attribute on <html>; `_connect-terms.scss` turns it
	// into either a tint behind the four terms or a squircle before them.
	const LEGEND_KEY = 'launch-visuals:legend';
	document.querySelectorAll<HTMLElement>('[data-legend-switch]').forEach((group) => {
		const picks = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-legend-pick]'));
		// Swatch is the default, so it is the ABSENCE of the attribute — the sandbox can only ever
		// add the opt-in, which keeps a real page rendering the candidate with no script at all.
		const apply = (value: string) => {
			if (value === 'highlight') document.documentElement.dataset.legend = 'highlight';
			else delete document.documentElement.dataset.legend;
			picks.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.legendPick === value)));
		};
		let saved: string | null = null;
		try {
			saved = localStorage.getItem(LEGEND_KEY);
		} catch {
			/* private mode; fine */
		}
		if (saved) apply(saved);
		picks.forEach((b) =>
			b.addEventListener('click', () => {
				const value = b.dataset.legendPick ?? 'swatch';
				apply(value);
				try {
					localStorage.setItem(LEGEND_KEY, value);
				} catch {
					/* ignore */
				}
			})
		);
	});

	// The typeface switch. Same shape as the others; it sets one attribute on <html>, and the rule
	// in the global block turns that into `--flow-font-mono` for every visual on the page.
	const FONT_KEY = 'launch-visuals:font';
	document.querySelectorAll<HTMLElement>('[data-font-switch]').forEach((group) => {
		const picks = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-font-pick]'));
		const apply = (value: string) => {
			if (value === 'mono') delete document.documentElement.dataset.font;
			else document.documentElement.dataset.font = value;
			picks.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.fontPick === value)));
		};
		let saved: string | null = null;
		try {
			saved = localStorage.getItem(FONT_KEY);
		} catch {
			/* private mode; fine */
		}
		if (saved) apply(saved);
		picks.forEach((b) =>
			b.addEventListener('click', () => {
				const value = b.dataset.fontPick ?? 'mono';
				apply(value);
				try {
					localStorage.setItem(FONT_KEY, value);
				} catch {
					/* ignore */
				}
			})
		);
	});

	/**
	 * The retire control.
	 *
	 * Every `.stage` gets a ✕ in its caption. Clicking it marks that stage as no longer wanted and
	 * greys it; the bar at the top of the page counts the marks and copies them out.
	 *
	 * A stage is keyed by its panel and its position in it, and the key is stored WITH the caption's
	 * text. The key alone would rot the first time a stage moved; the text alone is not unique
	 * (every feature row is called "Feature row"). Together they survive either one changing, which
	 * matters because the list is read back days later by someone deleting files.
	 *
	 * Nothing here deletes anything. It writes a decision down at the moment the decision is good.
	 */
	const RETIRE_KEY = 'launch-visuals:retire';

	type Retired = Record<string, string>;
	const readMarks = (): Retired => {
		try {
			return JSON.parse(localStorage.getItem(RETIRE_KEY) || '{}') as Retired;
		} catch {
			return {};
		}
	};
	const writeMarks = (m: Retired) => {
		try {
			localStorage.setItem(RETIRE_KEY, JSON.stringify(m));
		} catch {
			/* private window, cleared site data — the marks are a convenience, not the work */
		}
	};

	{
		const bar = document.querySelector<HTMLElement>('[data-retire-bar]');
		const countEl = document.querySelector<HTMLElement>('[data-retire-count]');
		const stages = Array.from(document.querySelectorAll<HTMLElement>('.stage'));

		// panel id + position, so a key says where to look as well as what to remove
		const seen: Record<string, number> = {};
		const keyed = stages.map((stage) => {
			const panel = stage.closest<HTMLElement>('[data-page-panel]')?.dataset.pagePanel ?? 'page';
			seen[panel] = (seen[panel] ?? 0) + 1;
			const name = stage.querySelector('.stage__name')?.textContent?.trim() ?? '';
			const note = stage.querySelector('.stage__note')?.textContent?.trim() ?? '';
			return { stage, key: `${panel}/${seen[panel]}`, label: note ? `${name} — ${note}` : name };
		});

		const paint = () => {
			const marks = readMarks();
			keyed.forEach(({ stage, key }) => stage.toggleAttribute('data-retired', key in marks));
			const n = Object.keys(marks).length;
			if (countEl) countEl.textContent = String(n);
			if (bar) bar.hidden = n === 0;
		};

		keyed.forEach(({ stage, key, label }) => {
			const cap = stage.querySelector('.stage__cap');
			if (!cap) return;
			const btn = document.createElement('button');
			btn.type = 'button';
			btn.className = 'stage__retire';
			btn.title = 'Mark this stage as no longer needed';
			btn.setAttribute('aria-label', `Retire ${label}`);
			btn.textContent = '✕';
			btn.addEventListener('click', () => {
				const marks = readMarks();
				if (key in marks) delete marks[key];
				else marks[key] = label;
				writeMarks(marks);
				paint();
			});
			cap.appendChild(btn);
		});

		document.querySelector('[data-retire-copy]')?.addEventListener('click', () => {
			const marks = readMarks();
			const text = Object.entries(marks)
				.map(([k, v]) => `${k}\t${v}`)
				.join('\n');
			navigator.clipboard?.writeText(text);
		});

		// Marked stages are dimmed, not hidden, so a mark can be reconsidered. This hides them, which
		// is the only way to see what the page would actually look like after the cleanup.
		document.querySelector<HTMLButtonElement>('[data-retire-show]')?.addEventListener('click', (e) => {
			const btn = e.currentTarget as HTMLButtonElement;
			const on = btn.getAttribute('aria-pressed') === 'true';
			btn.setAttribute('aria-pressed', on ? 'false' : 'true');
			btn.textContent = on ? 'Show marked' : 'Marked hidden';
			document.documentElement.toggleAttribute('data-hide-retired', !on);
		});

		document.querySelector('[data-retire-clear]')?.addEventListener('click', () => {
			writeMarks({});
			paint();
		});

		paint();
	}
</script>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;
	@use '../../styles/connect-terms';

	// What the typeface switch above actually does. One property, read by every visual through
	// `var(--flow-font-mono, <mono stack>)`, so the default costs nothing and the override reaches
	// all of them at once.
	:root[data-font='sans'] {
		--flow-font-mono: #{$font-family-base};
	}

	// Each visual gets its own band so two of them never share an edge — adjacent visuals read
	// as one composition otherwise, which is the thing this page exists to avoid.
	.stage {
		margin: 0 auto $spacing-16;

		&[data-w='full'] {
			max-width: 1200px;
		}
		&[data-w='half'] {
			max-width: 600px;
		}
		&[data-w='card'] {
			max-width: 380px;
		}
	}

	.stage__cap {
		display: flex;
		align-items: baseline;
		gap: $spacing-3;
		margin-bottom: $spacing-3;
		padding-bottom: $spacing-2;
		border-bottom: 1px solid var(--sl-color-hairline-light);
	}

	.stage__name {
		@include card-title-sm;
		font-family: $font-family-mono;
	}

	.stage__note {
		@include text-xs;
		color: var(--color-text-secondary, #5b616e);
	}

	.stage__frame {
		// The checkerboard shows where a visual's own background stops and the page's begins —
		// a transparent edge is invisible against a plain white frame.
		background:
			linear-gradient(45deg, #f2f4f8 25%, transparent 25%, transparent 75%, #f2f4f8 75%),
			linear-gradient(45deg, #f2f4f8 25%, transparent 25%, transparent 75%, #f2f4f8 75%);
		background-position:
			0 0,
			8px 8px;
		background-size: 16px 16px;
		border-radius: $radius-xl;
	}

	// For visuals that carry their own white surface: the checkerboard reads as a background
	// competing with the card fills rather than as absence of one.
	.stage__frame--plain {
		background: none;
	}
	// --- retiring a stage --------------------------------------------------------------------

	.stage__retire {
		@include text-xs;
		margin-left: auto;
		padding: 0 $spacing-2;
		border: 0;
		border-radius: $radius-sm;
		background: none;
		line-height: 1.6;
		color: var(--color-text-secondary, #5b616e);
		// Quiet until wanted: forty-eight of these along the page would read as forty-eight errors.
		opacity: 0;
		cursor: pointer;

		&:hover,
		&:focus-visible {
			background: var(--sl-color-hairline-light, #ebebeb);
			color: var(--color-text, #17181c);
		}
	}

	.stage:hover .stage__retire,
	.stage__retire:focus-visible,
	.stage[data-retired] .stage__retire {
		opacity: 1;
	}

	// Dimmed, not hidden: a mark is a decision that can still be looked at and taken back.
	.stage[data-retired] {
		opacity: 0.4;

		.stage__name {
			text-decoration: line-through;
		}
	}

	:root[data-hide-retired] .stage[data-retired] {
		display: none;
	}

	.page-ctl__count {
		@include text-xs;
		min-width: 1.6em;
		padding: 0 $spacing-1;
		border-radius: $radius-sm;
		background: var(--color-text, #17181c);
		font-family: $font-family-mono;
		text-align: center;
		color: #fff;
	}

	// --- chrome the PANELS use --------------------------------------------------------------
	//
	// Global, and that is not a style choice: these classes are written in `_panels/*.astro`, and an
	// Astro scoped rule only matches markup in its own file. Scoped here, every probe on the page
	// would silently lose its width. `.page-tabs` below stays scoped because it is the only chrome
	// this file still renders itself.

	// A small control for a single visual's options, sitting where that visual's stages start.
	.page-ctl {
		display: flex;
		align-items: center;
		gap: $spacing-2;
		max-width: 1200px;
		margin: 0 auto $spacing-6;

		button {
			@include text-xs;
			padding: $spacing-1 $spacing-3;
			border: 1px solid var(--sl-color-hairline-light);
			border-radius: $radius-md;
			background: none;
			font-weight: $font-weight-medium;
			color: var(--color-text-secondary, #5b616e);
			cursor: pointer;

			&[aria-pressed='true'] {
				border-color: var(--color-text, #17181c);
				background: var(--color-text, #17181c);
				color: #fff;
			}
		}
	}

	.page-ctl__name {
		@include text-xs;
		margin-right: $spacing-1;
		font-family: $font-family-mono;
		color: var(--color-text-secondary, #5b616e);
	}

	.compact-note {
		@include text-m;
		max-width: 70ch;
		margin: 0 auto $spacing-4;
		color: var(--color-text-secondary, #5b616e);
		text-wrap: pretty;

		strong {
			color: var(--color-text, #171c22);
			font-weight: $font-weight-medium;
		}
	}

	// The last note sits directly above the first row, which has its own top margin.
	.compact-note + .compact-note {
		margin-bottom: $spacing-10;
	}

	// A hard-set width so the composition is judged at a known size rather than whatever the page
	// happens to give it. Each probe names its own width; the dashed edge shows exactly how much room
	// the visual was handed, so an upscale cap or a floor is visible as space rather than guessed.
	.probe {
		width: var(--probe, 630px);
		max-width: 100%;
		margin: 0 auto;
		// An outline, not a border or padding: it must not eat into the width being measured.
		outline: 1px dashed var(--color-border, #ebebeb);
		outline-offset: $spacing-3;
		border-radius: $radius-sm;
	}

	// Each shell at the width it has in the key visual — measured 258.67px, the 1.6fr app column of
	// a 630px composition — so what gets judged here is what ships. This row is a technical exhibit,
	// so it is free to be wider than the visual it serves.
	.dash-row {
		display: grid;
		grid-template-columns: repeat(3, 259px);
		justify-content: center;
		gap: $spacing-5;
	}

	// Each unit at the width it has in the twin visual — 243px, the 1fr column of a 630px
	// composition split 1 : 96px : 1.2 — so what gets judged here is what ships.
	.unit-row {
		display: grid;
		grid-template-columns: repeat(auto-fill, 243px);
		justify-content: center;
		align-items: start;
		gap: $spacing-5;
	}

	.dash-row__cap {
		@include text-xs;
		margin: $spacing-3 0 0;
		font-family: $font-family-mono;
		color: var(--color-text-secondary, #5b616e);
	}
</style>

<style lang="scss">
	@use '../../styles/variables' as *;

	@use '../../styles/variables' as *;

	// Page tabs, on the same left edge as the title and the stages.
	.page-tabs {
		display: flex;
		gap: $spacing-1;
		max-width: 1200px;
		margin: 0 auto $spacing-10;
		padding-bottom: $spacing-3;
		border-bottom: 1px solid var(--sl-color-hairline-light);

		button {
			@include text-s;
			padding: $spacing-1 $spacing-3;
			border: 0;
			border-radius: $radius-md;
			background: none;
			font-weight: $font-weight-medium;
			color: var(--color-text-secondary, #5b616e);
			cursor: pointer;

			&:hover {
				color: var(--color-text, #17181c);
			}

			&[aria-selected='true'] {
				background: var(--color-text, #17181c);
				color: #fff;
			}
		}
	}
</style>
