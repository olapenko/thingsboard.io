---
/**
 * Working surface for the launch visuals.
 *
 * Internal reference page: not linked from anywhere, `noindex` via the layout, and so kept out
 * of the sitemap. Its job is to hold each new visual on its own, at the width it will really
 * get, with nothing else on the page competing for judgement — one page tab per visual.
 *
 * Add a visual by giving it an entry in `KEY_VISUALS`, a tab panel below, and `<figure
 * class="stage">` blocks inside it. The `data-w` attribute picks the frame width — `full`, `half`
 * or `card` — matching the three widths a visual actually lands in on the marketing pages.
 * `_FeatureRow` is the homepage row a visual is headed for, with its token switch.
 *
 * This page is scaffolding, not shipped content: nothing here needs to survive into a
 * marketing page except the components themselves.
 */
import PlaygroundLayout from '@layouts/PlaygroundLayout.astro';
import CliTerminal from '@components/Landing/CliTerminal.astro';
import SolutionFlow from '@components/Landing/SolutionFlow.astro';
import SolutionAppShell from '@components/Landing/SolutionAppShell.astro';
import DigitalTwin from '@components/Landing/DigitalTwin.astro';
import NormalizeFlow from '@components/Landing/NormalizeFlow.astro';
import GatewayDiagram from '@components/Landing/GatewayDiagram.astro';
import TwinUnit from '@components/Landing/TwinUnit.astro';
import { SOLUTION_CASES, SOLUTION_RAIL } from '@data/solution-flow';
import { DIGITAL_TWIN_COPY, UNIT_GALLERY } from '@data/digital-twin-visual';
import { NORMALIZE_COPY } from '@data/normalize-visual';
import FeatureRow from '@root/pages/internal/_FeatureRow.astro';

/**
 * The key visuals, one per page tab. Copy is the design's, verbatim; the CLI has no row yet.
 */
const KEY_VISUALS = [
	{
		id: 'cli',
		label: 'CLI',
	},
	{
		id: 'solution',
		label: 'Device to end-user',
		title: 'Build IoT solutions from device to end-user',
		body: 'ThingsBoard enables development of the complete use-case and is white-labeled for your customers or your team: ship complete IoT applications, not just data pipelines.',
		link: { text: 'Why ThingsBoard is the best IoT platform', href: '/products/' },
	},
	{
		id: 'twin',
		label: 'Digital twin',
		...DIGITAL_TWIN_COPY,
	},
	{
		id: 'normalize',
		label: 'Normalize',
		title: NORMALIZE_COPY.title,
		body: NORMALIZE_COPY.body,
		link: NORMALIZE_COPY.link,
	},
	{
		id: 'gateway',
		label: 'IoT Gateway',
		// The Gateway's own words, from its `homeEcosystem` entry — description, action label and
		// href verbatim. Only the headline is changed, from the description's opening sentence
		// ("Brings legacy equipment online.") into the imperative the other three headlines use.
		title: 'Bring legacy equipment online',
		body: 'Modbus, OPC UA, BACnet, SNMP, KNX and 25+ industrial protocols, translated to MQTT or HTTP. Open-source, runs on any hardware.',
		link: { text: 'See supported protocols', href: '/docs/iot-gateway/' },
	},
];
---

<PlaygroundLayout
	title="Launch visuals"
	description="Each visual on its own, at the width it gets in the page it is headed for. One tab per visual."
>
	{
		/* Page tabs: one per key visual. Each shows only its own stages, so a visual is judged without
	    the others in the corner of the eye. The pick is remembered across reloads. */
	}
	<nav class="page-tabs" role="tablist" aria-label="Key visual" data-page-tabs>
		{
			KEY_VISUALS.map((kv, i) => (
				<button
					type="button"
					role="tab"
					id={`page-tab-${kv.id}`}
					aria-selected={i === 0 ? 'true' : 'false'}
					aria-controls={`page-panel-${kv.id}`}
					data-page-tab={kv.id}
				>
					{kv.label}
				</button>
			))
		}
	</nav>

	{/* --- CLI ------------------------------------------------------------------------------- */}
	<section id="page-panel-cli" role="tabpanel" aria-labelledby="page-tab-cli" data-page-panel="cli">
		{
			/* Checks the token wiring as much as the component: CliTerminal reads --sl-color-* and
		    --color-* directly, so if it renders correctly here the layout is loading both sheets. */
		}
		<figure class="stage" data-w="half">
			<figcaption class="stage__cap">
				<span class="stage__name">CliTerminal</span>
				<span class="stage__note">existing · token-wiring check</span>
			</figcaption>
			<div class="stage__frame">
				<CliTerminal />
			</div>
		</figure>
	</section>

	{/* --- Device to end-user ---------------------------------------------------------------- */}
	<section
		id="page-panel-solution"
		role="tabpanel"
		aria-labelledby="page-tab-solution"
		data-page-panel="solution"
		hidden
	>
		<FeatureRow visual={KEY_VISUALS[1]}>
			<SolutionFlow />
		</FeatureRow>

		{
			/* One composition, four widths. The visual scales as a whole rather than reflowing, so what is
		    judged here is the same picture at the sizes it really gets: the desktop feature row, the
		    row's narrow variant, a phone, and a wide container where the upscale cap kicks in. */
		}
		{
			[
				{ w: 673, note: 'desktop feature row' },
				{ w: 433, note: 'narrow row · tablet' },
				{ w: 335, note: 'phone' },
				{ w: 1200, note: 'wide · capped at 1.15x' },
			].map((probe) => (
				<figure class="stage" data-w="full">
					<figcaption class="stage__cap">
						<span class="stage__name">SolutionFlow · {probe.w}px</span>
						<span class="stage__note">{probe.note}</span>
					</figcaption>
					<div class="stage__frame stage__frame--plain">
						<div class="probe" style={`--probe: ${probe.w}px`}>
							<SolutionFlow />
						</div>
					</div>
				</figure>
			))
		}

		{
			/* The three use cases side by side, same shell, no rotation. Wording and metrics are taken
		    from the published pages in `src/data/use-cases/` rather than invented, so the copy here can
		    move to a marketing page without being re-checked. Deliberately three DIFFERENT industries
		    with the same panel shape — that similarity is what shows the app is configuration. */
		}
		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">SolutionAppShell · 3 use cases</span>
				<span class="stage__note">static, for comparison</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="dash-row">
					{
						SOLUTION_CASES.map((c) => (
							<div class="dash-row__item">
								<SolutionAppShell rail={SOLUTION_RAIL} cases={[c]} animate />
								<p class="dash-row__cap">{c.source}</p>
							</div>
						))
					}
				</div>
			</div>
		</figure>
	</section>

	{/* --- Digital twin ---------------------------------------------------------------------- */}
	<section id="page-panel-twin" role="tabpanel" aria-labelledby="page-tab-twin" data-page-panel="twin" hidden>
		<FeatureRow visual={KEY_VISUALS[2]}>
			<DigitalTwin />
		</FeatureRow>

		{
			/* The arrangement nesting replaced: the unit on its own, with its site named nowhere. Kept
		    so the choice can still be judged, now that nesting is what the row above shows. */
		}
		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">DigitalTwin · flat</span>
				<span class="stage__note">superseded · the unit without its site</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 673px">
					<DigitalTwin nested={false} />
				</div>
			</div>
		</figure>

		{
			/* Other units the composition could hold, each at the width the unit has in the visual and
		    without a twin: the point is to judge the unit's card across subjects, not the mirror. */
		}
		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">TwinUnit · gallery</span>
				<span class="stage__note">other units the composition could hold · no twin</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="unit-row">{UNIT_GALLERY.map((u) => <TwinUnit unit={u} />)}</div>
			</div>
		</figure>

		{/* The same composition at the phone width, to check it survives the scale-down. */}
		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">DigitalTwin · 335px</span>
				<span class="stage__note">phone</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 335px">
					<DigitalTwin />
				</div>
			</div>
		</figure>
	</section>

	{/* --- Normalize ------------------------------------------------------------------------- */}
	<section
		id="page-panel-normalize"
		role="tabpanel"
		aria-labelledby="page-tab-normalize"
		data-page-panel="normalize"
		hidden
	>
		{
			/* First half of the design's "Turn IoT data into action" section. The second half — a rule
		    chain raising an alarm and notifying — is a separate argument and will be its own visual,
		    so the copy in this row still covers both and will need splitting with it. */
		}
		<FeatureRow visual={KEY_VISUALS[3]}>
			<NormalizeFlow />
		</FeatureRow>

		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">NormalizeFlow · 673px</span>
				<span class="stage__note">draft · the width the feature row gives it</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 673px">
					<NormalizeFlow />
				</div>
			</div>
		</figure>

		{/* The same composition at the phone width, to check the curves survive the scale-down. */}
		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">NormalizeFlow · 335px</span>
				<span class="stage__note">phone</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 335px">
					<NormalizeFlow />
				</div>
			</div>
		</figure>
	</section>

	{/* --- IoT Gateway ----------------------------------------------------------------------- */}
	<section id="page-panel-gateway" role="tabpanel" aria-labelledby="page-tab-gateway" data-page-panel="gateway" hidden>
		{
			/* Drafted before the others and built differently: one root <svg> on a 720 viewBox rather
		    than a grid on the design unit. It reaches the same place by another road — the whole
		    board scales as a piece and never reflows — so it sits in the row without adjustment. Its
		    purple is `#7b3fe4`, which is the accent the Gateway already carries in homeEcosystem. */
		}
		<FeatureRow visual={KEY_VISUALS[4]}>
			<GatewayDiagram />
		</FeatureRow>

		{/* At the width the row gives it, and at the phone width, as the others are probed. */}
		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">GatewayDiagram · 673px</span>
				<span class="stage__note">existing · authored on a 720 viewBox</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 673px">
					<GatewayDiagram />
				</div>
			</div>
		</figure>

		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">GatewayDiagram · 335px</span>
				<span class="stage__note">phone</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 335px">
					<GatewayDiagram />
				</div>
			</div>
		</figure>
	</section>
</PlaygroundLayout>

<script>
	// The page tabs. One panel showing at a time; the pick is remembered like the token set.
	const TAB_KEY = 'launch-visuals:tab';
	document.querySelectorAll<HTMLElement>('[data-page-tabs]').forEach((list) => {
		const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[data-page-tab]'));
		const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-page-panel]'));
		const show = (id: string) => {
			tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.pageTab === id)));
			panels.forEach((p) => (p.hidden = p.dataset.pagePanel !== id));
		};
		let saved: string | null = null;
		try {
			saved = localStorage.getItem(TAB_KEY);
		} catch {
			/* private mode; fine */
		}
		if (saved && tabs.some((t) => t.dataset.pageTab === saved)) show(saved);
		tabs.forEach((t) =>
			t.addEventListener('click', () => {
				const id = t.dataset.pageTab ?? '';
				show(id);
				try {
					localStorage.setItem(TAB_KEY, id);
				} catch {
					/* ignore */
				}
			})
		);
	});
</script>

{/* The stage vocabulary is global to the page so `_FeatureRow` can use it for its caption. */}
<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	// Each visual gets its own band so two of them never share an edge — adjacent visuals read
	// as one composition otherwise, which is the thing this page exists to avoid.
	.stage {
		margin: 0 auto $spacing-16;

		&[data-w='full'] {
			max-width: 1200px;
		}
		&[data-w='half'] {
			max-width: 600px;
		}
		&[data-w='card'] {
			max-width: 380px;
		}
	}

	.stage__cap {
		display: flex;
		align-items: baseline;
		gap: $spacing-3;
		margin-bottom: $spacing-3;
		padding-bottom: $spacing-2;
		border-bottom: 1px solid var(--sl-color-hairline-light);
	}

	.stage__name {
		@include card-title-sm;
		font-family: $font-family-mono;
	}

	.stage__note {
		@include text-xs;
		color: var(--color-text-secondary, #5b616e);
	}

	.stage__frame {
		// The checkerboard shows where a visual's own background stops and the page's begins —
		// a transparent edge is invisible against a plain white frame.
		background:
			linear-gradient(45deg, #f2f4f8 25%, transparent 25%, transparent 75%, #f2f4f8 75%),
			linear-gradient(45deg, #f2f4f8 25%, transparent 25%, transparent 75%, #f2f4f8 75%);
		background-position:
			0 0,
			8px 8px;
		background-size: 16px 16px;
		border-radius: $radius-xl;
	}

	// For visuals that carry their own white surface: the checkerboard reads as a background
	// competing with the card fills rather than as absence of one.
	.stage__frame--plain {
		background: none;
	}
</style>

<style lang="scss">
	@use '../../styles/variables' as *;

	// Page tabs, on the same left edge as the title and the stages.
	.page-tabs {
		display: flex;
		gap: $spacing-1;
		max-width: 1200px;
		margin: 0 auto $spacing-10;
		padding-bottom: $spacing-3;
		border-bottom: 1px solid var(--sl-color-hairline-light);

		button {
			@include text-s;
			padding: $spacing-1 $spacing-3;
			border: 0;
			border-radius: $radius-md;
			background: none;
			font-weight: $font-weight-medium;
			color: var(--color-text-secondary, #5b616e);
			cursor: pointer;

			&:hover {
				color: var(--color-text, #17181c);
			}

			&[aria-selected='true'] {
				background: var(--color-text, #17181c);
				color: #fff;
			}
		}
	}

	// A hard-set width so the composition is judged at a known size rather than whatever the page
	// happens to give it. Each probe names its own width; the dashed edge shows exactly how much room
	// the visual was handed, so an upscale cap or a floor is visible as space rather than guessed.
	.probe {
		width: var(--probe, 630px);
		max-width: 100%;
		margin: 0 auto;
		// An outline, not a border or padding: it must not eat into the width being measured.
		outline: 1px dashed var(--color-border, #ebebeb);
		outline-offset: $spacing-3;
		border-radius: $radius-sm;
	}

	// Each shell at the width it has in the key visual — measured 258.67px, the 1.6fr app column of
	// a 630px composition — so what gets judged here is what ships. This row is a technical exhibit,
	// so it is free to be wider than the visual it serves.
	.dash-row {
		display: grid;
		grid-template-columns: repeat(3, 259px);
		justify-content: center;
		gap: $spacing-5;
	}

	// Each unit at the width it has in the twin visual — 243px, the 1fr column of a 630px
	// composition split 1 : 96px : 1.2 — so what gets judged here is what ships.
	.unit-row {
		display: grid;
		grid-template-columns: repeat(auto-fill, 243px);
		justify-content: center;
		align-items: start;
		gap: $spacing-5;
	}

	.dash-row__cap {
		@include text-xs;
		margin: $spacing-3 0 0;
		font-family: $font-family-mono;
		color: var(--color-text-secondary, #5b616e);
	}
</style>
