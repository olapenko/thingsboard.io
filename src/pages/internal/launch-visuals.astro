---
/**
 * Working surface for the launch visuals.
 *
 * Internal reference page: not linked from anywhere, `noindex` via the layout, and so kept out
 * of the sitemap. Its job is to hold each new visual on its own, at the width it will really
 * get, with nothing else on the page competing for judgement — one page tab per visual.
 *
 * Add a visual by giving it an entry in `KEY_VISUALS`, a tab panel below, and `<figure
 * class="stage">` blocks inside it. The `data-w` attribute picks the frame width — `full`, `half`
 * or `card` — matching the three widths a visual actually lands in on the marketing pages.
 * `_FeatureRow` is the homepage row a visual is headed for, with its token switch.
 *
 * This page is scaffolding, not shipped content: nothing here needs to survive into a
 * marketing page except the components themselves.
 */
import PlaygroundLayout from '@layouts/PlaygroundLayout.astro';
import CliTerminal from '@components/Landing/CliTerminal.astro';
import SolutionFlow from '@components/Landing/SolutionFlow.astro';
import SolutionAppShell from '@components/Landing/SolutionAppShell.astro';
import DigitalTwin from '@components/Landing/DigitalTwin.astro';
import NormalizeFlow from '@components/Landing/NormalizeFlow.astro';
import GatewayDiagram from '@components/Landing/GatewayDiagram.astro';
import ConnectFlow from '@components/Landing/ConnectFlow.astro';
import ConnectCloud from '@components/Landing/ConnectCloud.astro';
import ScaleChart from '@components/Landing/ScaleChart.astro';
import ScaleMachines from '@components/Landing/ScaleMachines.astro';
import ScaleTiers from '@components/Landing/ScaleTiers.astro';
import ScaleGrowth from '@components/Landing/ScaleGrowth.astro';
import DeployFork from '@components/Landing/DeployFork.astro';
import WhiteLabelApp from '@components/Landing/WhiteLabelApp.astro';
import TwinUnit from '@components/Landing/TwinUnit.astro';
import { SOLUTION_CASES, SOLUTION_RAIL, SOLUTION_COPY } from '@data/solution-flow';
import { DIGITAL_TWIN_COPY, UNIT_GALLERY } from '@data/digital-twin-visual';
import { NORMALIZE_COPY } from '@data/normalize-visual';
import { CONNECT_COPY, CONNECT_ROUTES, CONNECT_BODY_HTML } from '@data/connect-visual';
import { SCALE_COPY, SCALE_TIERS_PAIR } from '@data/scale-visual';
import { DEPLOY_COPY } from '@data/deploy-visual';
import { WHITELABEL_COPY } from '@data/whitelabel-visual';
import ConnectCompact from '@components/Landing/ConnectCompact.astro';
import SolutionCompact from '@components/Landing/SolutionCompact.astro';
import TwinCompact from '@components/Landing/TwinCompact.astro';
import NormalizeCompact from '@components/Landing/NormalizeCompact.astro';
import ScaleCompact from '@components/Landing/ScaleCompact.astro';
import FeatureRow from '@root/pages/internal/_FeatureRow.astro';

/**
 * The key visuals, one per page tab. Copy is the design's, verbatim; the CLI has no row yet.
 */
const KEY_VISUALS = [
	{
		id: 'cli',
		label: 'CLI',
	},
	{
		id: 'solution',
		label: 'Device to end-user',
		title: SOLUTION_COPY.title,
		body: SOLUTION_COPY.body,
		link: SOLUTION_COPY.link,
	},
	{
		id: 'twin',
		label: 'Digital twin',
		...DIGITAL_TWIN_COPY,
	},
	{
		id: 'normalize',
		label: 'Normalize',
		title: NORMALIZE_COPY.title,
		body: NORMALIZE_COPY.body,
		link: NORMALIZE_COPY.link,
	},
	{
		id: 'gateway',
		label: 'IoT Gateway',
		// The Gateway's own words, from its `homeEcosystem` entry — description, action label and
		// href verbatim. Only the headline is changed, from the description's opening sentence
		// ("Brings legacy equipment online.") into the imperative the other three headlines use.
		title: 'Bring legacy equipment online',
		body: 'Modbus, OPC UA, BACnet, SNMP, KNX and 25+ industrial protocols, translated to MQTT or HTTP. Open-source, runs on any hardware.',
		link: { text: 'See supported protocols', href: '/docs/iot-gateway/' },
	},
	{
		id: 'connect',
		label: 'Connect devices',
		title: CONNECT_COPY.title,
		body: CONNECT_COPY.body,
		link: CONNECT_COPY.link,
	},
	{
		id: 'scale',
		label: 'Scale',
		title: SCALE_COPY.title,
		body: SCALE_COPY.body,
		link: SCALE_COPY.link,
	},
	{
		id: 'deploy',
		label: 'Deploy anywhere',
		title: DEPLOY_COPY.title,
		body: DEPLOY_COPY.body,
		link: DEPLOY_COPY.link,
	},
	{
		id: 'whitelabel',
		label: 'White-labeling',
		title: WHITELABEL_COPY.title,
		body: WHITELABEL_COPY.body,
		link: WHITELABEL_COPY.link,
	},
	{
		id: 'compact',
		label: 'Compact · 448',
	},
];

/**
 * The five home-preview visuals, redrawn to one scale.
 *
 * Every one is a new component beside the shipped one rather than a change to it: the home preview
 * still renders the originals, so nothing on that page can move because of anything in this tab.
 *
 * Appended to KEY_VISUALS rather than inserted, because the panels above address their copy by
 * index — `KEY_VISUALS[6]` and friends — and an insert would silently retitle four of them.
 */
const COMPACT_ROWS = [
	{ Visual: ConnectCompact, copy: CONNECT_COPY, was: 'ConnectFlow · 630u, 14u floor · 7.4px' },
	{ Visual: SolutionCompact, copy: SOLUTION_COPY, was: 'SolutionFlow · 630u, 11u floor · 5.8px' },
	{ Visual: TwinCompact, copy: DIGITAL_TWIN_COPY, was: 'DigitalTwin · 630u, 12u floor · 6.4px' },
	{ Visual: NormalizeCompact, copy: NORMALIZE_COPY, was: 'NormalizeFlow · 630u, 14u floor · 7.4px' },
	{ Visual: ScaleCompact, copy: SCALE_COPY, was: 'ScaleGrowth · 448u, 14u floor · 10.5px' },
];
---

<PlaygroundLayout
	title="Launch visuals"
	description="Each visual on its own, at the width it gets in the page it is headed for. One tab per visual."
>
	{
		/* Page tabs: one per key visual. Each shows only its own stages, so a visual is judged without
	    the others in the corner of the eye. The pick is remembered across reloads. */
	}
	<nav class="page-tabs" role="tablist" aria-label="Key visual" data-page-tabs>
		{
			KEY_VISUALS.map((kv, i) => (
				<button
					type="button"
					role="tab"
					id={`page-tab-${kv.id}`}
					aria-selected={i === 0 ? 'true' : 'false'}
					aria-controls={`page-panel-${kv.id}`}
					data-page-tab={kv.id}
				>
					{kv.label}
				</button>
			))
		}
	</nav>

	{
		/* Page-wide, not per-panel: the question this answers — does the family want a monospace
	    face at all — is the same question in every visual, and switching one at a time is how you
	    end up preferring whichever you happened to look at last.

	    It works by setting `--flow-font-mono`, which every visual's chip and label rules read with
	    the mono stack as their fallback. Nothing outside this page is affected: with no attribute
	    set the property is undefined and the fallback stands, which is exactly what a marketing
	    page renders.

	    CliTerminal is deliberately NOT wired to it. A terminal in a proportional face is not a
	    design option, it is a mistake. */
	}
	<div class="page-ctl" role="group" aria-label="Chip typeface" data-font-switch>
		<span class="page-ctl__name">Chips &amp; labels</span>
		<button type="button" data-font-pick="mono" aria-pressed="true">Ubuntu Mono</button>
		<button type="button" data-font-pick="sans" aria-pressed="false">Ubuntu</button>
	</div>

	{/* --- CLI ------------------------------------------------------------------------------- */}
	<section id="page-panel-cli" role="tabpanel" aria-labelledby="page-tab-cli" data-page-panel="cli">
		{
			/* Checks the token wiring as much as the component: CliTerminal reads --sl-color-* and
		    --color-* directly, so if it renders correctly here the layout is loading both sheets. */
		}
		<figure class="stage" data-w="half">
			<figcaption class="stage__cap">
				<span class="stage__name">CliTerminal</span>
				<span class="stage__note">existing · token-wiring check</span>
			</figcaption>
			<div class="stage__frame">
				<CliTerminal />
			</div>
		</figure>
	</section>

	{/* --- Device to end-user ---------------------------------------------------------------- */}
	<section
		id="page-panel-solution"
		role="tabpanel"
		aria-labelledby="page-tab-solution"
		data-page-panel="solution"
		hidden
	>
		<FeatureRow visual={KEY_VISUALS[1]}>
			<SolutionFlow />
		</FeatureRow>

		{
			/* One composition, four widths. The visual scales as a whole rather than reflowing, so what is
		    judged here is the same picture at the sizes it really gets: the desktop feature row, the
		    row's narrow variant, a phone, and a wide container where the upscale cap kicks in. */
		}
		{
			[
				{ w: 673, note: 'desktop feature row' },
				{ w: 433, note: 'narrow row · tablet' },
				{ w: 335, note: 'phone' },
				{ w: 1200, note: 'wide · capped at 1.15x' },
			].map((probe) => (
				<figure class="stage" data-w="full">
					<figcaption class="stage__cap">
						<span class="stage__name">SolutionFlow · {probe.w}px</span>
						<span class="stage__note">{probe.note}</span>
					</figcaption>
					<div class="stage__frame stage__frame--plain">
						<div class="probe" style={`--probe: ${probe.w}px`}>
							<SolutionFlow />
						</div>
					</div>
				</figure>
			))
		}

		{
			/* The three use cases side by side, same shell, no rotation. Wording and metrics are taken
		    from the published pages in `src/data/use-cases/` rather than invented, so the copy here can
		    move to a marketing page without being re-checked. Deliberately three DIFFERENT industries
		    with the same panel shape — that similarity is what shows the app is configuration. */
		}
		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">SolutionAppShell · 3 use cases</span>
				<span class="stage__note">static, for comparison</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="dash-row">
					{
						SOLUTION_CASES.map((c) => (
							<div class="dash-row__item">
								<SolutionAppShell rail={SOLUTION_RAIL} cases={[c]} animate />
								<p class="dash-row__cap">{c.source}</p>
							</div>
						))
					}
				</div>
			</div>
		</figure>
	</section>

	{/* --- Digital twin ---------------------------------------------------------------------- */}
	<section id="page-panel-twin" role="tabpanel" aria-labelledby="page-tab-twin" data-page-panel="twin" hidden>
		<FeatureRow visual={KEY_VISUALS[2]}>
			<DigitalTwin />
		</FeatureRow>

		{
			/* The arrangement nesting replaced: the unit on its own, with its site named nowhere. Kept
		    so the choice can still be judged, now that nesting is what the row above shows. */
		}
		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">DigitalTwin · flat</span>
				<span class="stage__note">superseded · the unit without its site</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 673px">
					<DigitalTwin nested={false} />
				</div>
			</div>
		</figure>

		{
			/* Other units the composition could hold, each at the width the unit has in the visual and
		    without a twin: the point is to judge the unit's card across subjects, not the mirror. */
		}
		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">TwinUnit · gallery</span>
				<span class="stage__note">other units the composition could hold · no twin</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="unit-row">{UNIT_GALLERY.map((u) => <TwinUnit unit={u} />)}</div>
			</div>
		</figure>

		{/* The same composition at the phone width, to check it survives the scale-down. */}
		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">DigitalTwin · 335px</span>
				<span class="stage__note">phone</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 335px">
					<DigitalTwin />
				</div>
			</div>
		</figure>
	</section>

	{/* --- Normalize ------------------------------------------------------------------------- */}
	<section
		id="page-panel-normalize"
		role="tabpanel"
		aria-labelledby="page-tab-normalize"
		data-page-panel="normalize"
		hidden
	>
		{
			/* First half of the design's "Turn IoT data into action" section. The second half — a rule
		    chain raising an alarm and notifying — is a separate argument and will be its own visual,
		    so the copy in this row still covers both and will need splitting with it. */
		}
		<FeatureRow visual={KEY_VISUALS[3]}>
			<NormalizeFlow />
		</FeatureRow>

		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">NormalizeFlow · 673px</span>
				<span class="stage__note">draft · the width the feature row gives it</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 673px">
					<NormalizeFlow />
				</div>
			</div>
		</figure>

		{/* The same composition at the phone width, to check the curves survive the scale-down. */}
		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">NormalizeFlow · 335px</span>
				<span class="stage__note">phone</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 335px">
					<NormalizeFlow />
				</div>
			</div>
		</figure>
	</section>

	{/* --- IoT Gateway ----------------------------------------------------------------------- */}
	<section id="page-panel-gateway" role="tabpanel" aria-labelledby="page-tab-gateway" data-page-panel="gateway" hidden>
		{
			/* Drafted before the others and built differently: one root <svg> on a 720 viewBox rather
		    than a grid on the design unit. It reaches the same place by another road — the whole
		    board scales as a piece and never reflows — so it sits in the row without adjustment. Its
		    purple is `#7b3fe4`, which is the accent the Gateway already carries in homeEcosystem. */
		}
		<FeatureRow visual={KEY_VISUALS[4]}>
			<GatewayDiagram />
		</FeatureRow>

		{/* At the width the row gives it, and at the phone width, as the others are probed. */}
		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">GatewayDiagram · 673px</span>
				<span class="stage__note">existing · authored on a 720 viewBox</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 673px">
					<GatewayDiagram />
				</div>
			</div>
		</figure>

		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">GatewayDiagram · 335px</span>
				<span class="stage__note">phone</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 335px">
					<GatewayDiagram />
				</div>
			</div>
		</figure>
	</section>

	{/* --- Connect devices ------------------------------------------------------------------- */}
	<section id="page-panel-connect" role="tabpanel" aria-labelledby="page-tab-connect" data-page-panel="connect" hidden>
		{
			/* Replaces the section's grid of protocol logos. The names are set as the subject and the
		    route — devices, gateways, networks — is demoted to the caption over them, which is the
		    swap the draft asked for. */
		}
		{
			/* The node's name is off in the component by default. This flips every ConnectFlow on the
		    panel at once so the two can be compared without a rebuild — it only ever changes what is
		    VISIBLE, since the label stays in the markup for screen readers either way. */
		}
		{
			/* The cloud drops its group captions, so its four accents are the only thing saying which
		    route a chip belongs to — and how loudly they say it is the open question. Three codings,
		    switched together so they are compared rather than each admired on its own. */
		}
		<div class="page-ctl" role="group" aria-label="Cloud chip style" data-chip-switch>
			<span class="page-ctl__name">Cloud chips</span>
			<button type="button" data-chip-pick="tint" aria-pressed="true">Tinted</button>
			<button type="button" data-chip-pick="text" aria-pressed="false">White + colour text</button>
			<button type="button" data-chip-pick="edge" aria-pressed="false">White + edge</button>
		</div>

		<div class="page-ctl" role="group" aria-label="ThingsBoard label" data-conn-label-switch>
			<span class="page-ctl__name">ThingsBoard label</span>
			<button type="button" data-conn-label-pick="off" aria-pressed="true">Hidden</button>
			<button type="button" data-conn-label-pick="on" aria-pressed="false">Shown</button>
		</div>

		<FeatureRow visual={KEY_VISUALS[5]}>
			<ConnectFlow />
		</FeatureRow>

		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">ConnectFlow · 673px</span>
				<span class="stage__note">draft · the width the feature row gives it</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 673px">
					<ConnectFlow />
				</div>
			</div>
		</figure>

		{
			/* The alternative grouping: the four routes the connectivity guide defines, rather than
		    three that merge LPWAN networks into "networks & clouds". Kept beside the three-group
		    version rather than replacing it — the simpler read and the accurate one are a real
		    trade, and the fourth card costs height the phone width can least afford. */
		}
		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">ConnectFlow · 4 routes</span>
				<span class="stage__note">variant · as the connectivity guide groups them · surface: shadow (default)</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 673px">
					<ConnectFlow groups={CONNECT_ROUTES} />
				</div>
			</div>
		</figure>

		{
			/* The same composition with the other two surfaces, at the same width, so the only thing
		    changing between the three is how a card separates itself from the page. All three reserve
		    the same border box, so nothing else moves. */
		}
		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">ConnectFlow · surface: outline</span>
				<span class="stage__note">hairline, no shadow · what these cards started as</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 673px">
					<ConnectFlow groups={CONNECT_ROUTES} surface="outline" />
				</div>
			</div>
		</figure>

		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">ConnectFlow · surface: both</span>
				<span class="stage__note">shadow and hairline · for grounds close to the card fill</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 673px">
					<ConnectFlow groups={CONNECT_ROUTES} surface="both" />
				</div>
			</div>
		</figure>

		{
			/* Two routes each side of the node, which trades width for height: the same four routes are
		    412 units tall stacked and 196 split. For a full-bleed band rather than a column. */
		}
		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">ConnectFlow · split · 1120px</span>
				<span class="stage__note">variant · 2 routes → app ← 2 routes</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 1120px">
					<ConnectFlow groups={CONNECT_ROUTES} layout="split" />
				</div>
			</div>
		</figure>

		{
			/* The last width that still gets the wide arrangement. One pixel narrower and the next two
		    stages are what shows instead, so this pair is where the handover gets judged. */
		}
		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">ConnectFlow · split · 1000px</span>
				<span class="stage__note">variant · the threshold, still wide</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 1000px">
					<ConnectFlow groups={CONNECT_ROUTES} layout="split" />
				</div>
			</div>
		</figure>

		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">ConnectFlow · split · 999px</span>
				<span class="stage__note">variant · one pixel under, regrouped into one column</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 999px">
					<ConnectFlow groups={CONNECT_ROUTES} layout="split" />
				</div>
			</div>
		</figure>

		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">ConnectFlow · split · 335px</span>
				<span class="stage__note">variant · phone, so the stacked arrangement</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 335px">
					<ConnectFlow groups={CONNECT_ROUTES} layout="split" />
				</div>
			</div>
		</figure>

		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">ConnectFlow · 4 routes · 335px</span>
				<span class="stage__note">variant · phone</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 335px">
					<ConnectFlow groups={CONNECT_ROUTES} />
				</div>
			</div>
		</figure>

		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">ConnectFlow · 335px</span>
				<span class="stage__note">phone</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 335px">
					<ConnectFlow />
				</div>
			</div>
		</figure>

		{
			/* --- the cloud ----------------------------------------------------------------------
		    A different argument from the same parts: not "four ways in" but "whatever you have is
		    already in here". Names and accents come from CONNECT_ROUTES, so the two cuts cannot
		    disagree about what is supported or what colour a route is. */
		}
		<FeatureRow visual={{ ...KEY_VISUALS[5], bodyHtml: CONNECT_BODY_HTML }} note="the cloud — its copy IS its legend">
			<ConnectCloud />
		</FeatureRow>

		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">ConnectCloud · 525px</span>
				<span class="stage__note">variant · the home row at 1440</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 525px">
					<ConnectCloud />
				</div>
			</div>
		</figure>

		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">ConnectCloud · 673px</span>
				<span class="stage__note">the width the sandbox row gives it</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
				<div class="probe" style="--probe: 673px">
					<ConnectCloud />
				</div>
			</div>
		</figure>

		<figure class="stage" data-w="full">
			<figcaption class="stage__cap">
				<span class="stage__name">ConnectCloud · 367px</span>
				<span class="stage__note">phone · the width that decides it</span>
			</figcaption>
			<div class="stage__frame stage__frame--plain">
