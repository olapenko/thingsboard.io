---
import PlaygroundLayout from '@layouts/PlaygroundLayout.astro';
import { Icon } from 'astro-icon/components';
import Button from '@components/ui/Button.astro';
import ButtonGroup from '@components/ui/ButtonGroup.astro';
import Link from '@components/ui/Link.astro';
import Mark from '@components/ui/Mark.astro';
import Chip from '@components/ui/Chip.astro';
import ChipGroup from '@components/ui/ChipGroup.astro';
import Tabs from '@components/ui/Tabs.astro';
import Segmented from '@components/ui/Segmented.astro';
import TabPanel from '@components/ui/TabPanel.astro';
import Field from '@components/ui/Field.astro';
import Card from '@components/ui/Card.astro';
import CardGrid from '@components/ui/CardGrid.astro';
import LinkCard from '@components/ui/LinkCard.astro';
import Band from '@components/ui/Band.astro';
import Dialog from '@components/ui/Dialog.astro';
import RegionChoice from '@components/Landing/RegionChoice.astro';
import InstallOptions from '@components/Landing/InstallOptions.astro';
import SectionHeader from '@components/Landing/SectionHeader.astro';
import { BOOKEND_PLATFORMS } from '@data/bookends';
import { homeCarouselItems } from '@data/homeCarousel';

/**
 * The kit: the foundations every `ui/` component is drawn with, then every component in every
 * variant, size and ground, rendered from the component itself. The numbers under a specimen are
 * MEASURED in the browser from what it rendered (size, padding, type, corner, lift, timing), so
 * this page cannot drift from the code: change a component and its caption changes with it.
 * Hover, press and tab through everything; the plan holds the static state grids.
 */

const NAV = [
	{
		group: 'Foundations',
		items: [
			['colour', 'Colour'],
			['grounds', 'Grounds and focus'],
			['elevation', 'Elevation'],
			['radius', 'Radius'],
			['spacing', 'Spacing'],
			['type', 'Type'],
			['icons', 'Icons and motion'],
		],
	},
	{
		group: 'Components',
		items: [
			['button', 'Button'],
			['link', 'Link'],
			['mark', 'Mark'],
			['chip', 'Chip'],
			['tabs', 'Tabs'],
			['field', 'Field'],
			['card', 'Card'],
			['band', 'Band'],
			['header', 'Section header'],
			['dialog', 'Dialog'],
			['regions', 'Region choice'],
		],
	},
] as const;

const SCHEMES = [
	{ id: 'brand', name: 'brand', use: 'Cloud, the site' },
	{ id: 'onprem', name: 'onprem', use: 'On-premises' },
	{ id: 'neutral', name: 'neutral', use: 'Quiet controls, the dialog close' },
] as const;
const SCHEME_ROLES = [
	{ v: '--accent-fill', name: 'fill', use: 'Primary buttons, solid marks, pressed toggles' },
	{ v: '--accent-on-fill', name: 'on-fill', use: 'Text on the fill' },
	{ v: '--accent-ink', name: 'ink', use: 'Links, tertiary labels, tints on light' },
	{ v: '--accent-light', name: 'light', use: 'The same on a dark ground' },
] as const;

const ELEVATION = [
	{ token: '--elev-tile', use: 'A card in a grid, a row in a list', where: 'Card tile and row, region rows' },
	{ token: '--elev-tile-hover', use: 'A link tile under the pointer', where: 'Card with href, on hover' },
	{ token: '--elev-panel', use: 'A card that stands alone', where: 'Card panel, the contact form' },
	{ token: '--elev-dialog', use: 'The top layer', where: 'Dialog' },
	{ token: '--elev-mark', use: 'A mark on a card or straddling one', where: 'Mark lift' },
] as const;

const RADII = [
	{ name: '2px', box: '2px', where: 'An inline link’s focus ring' },
	{ name: 'md · 6', box: '6px', where: 'Button, Field' },
	{ name: 'lg · 8', box: '8px', where: 'Card tile and row, list and grid tabs, region rows' },
	{ name: 'xl · 16', box: '16px', where: 'Card panel and ghost, Dialog' },
	{ name: 'full', box: '100px', where: 'Chip, segmented tabs and thumb' },
	{ name: '32%', box: '32%', where: 'Mark, at every size' },
	{ name: '50%', box: '50%', where: 'Mark circle (region globes)' },
] as const;

const SPACING = [4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 100, 120];
const BAND_PADS = [
	['none', 0, 0],
	['sm', 48, 32],
	['md', 64, 48],
	['lg', 80, 48],
	['xl', 96, 64],
] as const;

const TYPE = [
	{ mixin: 'display', sample: 'The all-in-one IoT platform', use: 'Hero headline' },
	{ mixin: 'title', sample: 'Why ThingsBoard Cloud', use: 'Page title, product sections' },
	{ mixin: 'section', sample: 'Build IoT solutions faster', use: 'Homepage sections' },
	{ mixin: 'card', sample: 'Choose your data region', use: 'Card, dialog and panel titles' },
	{ mixin: 'tile-lg', sample: 'Trusted by 1,500+ companies', use: 'Large tile titles' },
	{ mixin: 'tile', sample: 'Rule engine', use: 'Tile titles' },
	{ mixin: 'lede', sample: 'Tell us about your project and we will get back to you.', use: 'Page intro lede' },
	{ mixin: 'body', sample: 'Route, transform and enrich telemetry with visual chains.', use: 'Running text' },
	{ mixin: 'link', sample: 'See supported protocols', use: 'Link md' },
	{ mixin: 'action', sample: 'Connectivity guide', use: 'Link lg' },
	{ mixin: 'small', sample: 'Data stored in the European Union', use: 'Notes, card lines' },
	{ mixin: 'small-strong', sample: 'Case study', use: 'Link sm' },
	{ mixin: 'eyebrow', sample: 'ThingsBoard Cloud', use: 'Eyebrows, group labels' },
] as const;

const SIZES = ['xs', 'sm', 'md', 'lg', 'xl'] as const;
const LADDER = [36, 40, 48, 64, 72, 80, 88] as const;
const PRODUCTS = ['edge', 'trendz', 'gateway', 'mobile', 'tbmq'] as const;
const FILLS = ['solid', 'white', 'wash', 'neutral'] as const;
const GROUNDS = [
	{ ground: 'flat', note: 'White' },
	{ ground: 'tint', note: '--band-tint' },
	{ ground: 'fade', note: 'White to 10% of the hue' },
	{ ground: 'hue', note: '22% to 6% of the hue, 150°' },
	{ ground: 'dark', note: '--band-indigo, sets data-surface="dark"' },
] as const;
const USE_CASES = homeCarouselItems.map((item, i) => ({ label: item.title, icon: item.icon, panel: `kit-grid-${i}` }));
---

<PlaygroundLayout title="Kit" description="The foundations and every ui/ component, live; the numbers are measured.">
	<div class="kit">
		<nav class="kit__nav" aria-label="Kit">
			{
				NAV.map((g) => (
					<div class="kit__nav-group">
						<p class="kit__nav-title">{g.group}</p>
						<ul>
							{g.items.map(([id, name]) => (
								<li>
									<a href={`#${id}`}>{name}</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</nav>

		<main class="kit__main">
			<p class="kit__part">Foundations</p>

			<!-- ── Colour ── -->
			<section class="kit-sec" id="colour">
				<header class="kit-sec__head">
					<h2>Colour</h2>
					<p>
						An accent is four values, set on any ancestor with <code>data-accent</code>; a component's
						<code>accent</code> prop takes a scheme or a one-off colour for itself alone. The ratios are measured.
					</p>
					<p class="kit-sec__src">src/styles/_theme.scss</p>
				</header>
				<div class="kit-schemes">
					{
						SCHEMES.map((sc) => (
							<div class="kit-scheme" data-accent={sc.id}>
								<p class="kit-scheme__name">
									<code>{sc.name}</code> <span>{sc.use}</span>
								</p>
								<ul class="kit-scheme__swatches">
									{SCHEME_ROLES.map((r) => (
										<li>
											<span class="kit-swatch" style={`background: var(${r.v})`} />
											<b>{r.name}</b>
											<code data-var={r.v} />
										</li>
									))}
								</ul>
								<p class="kit-scheme__ratios" data-ratios />
							</div>
						))
					}
				</div>
				<table class="kit-table">
					<thead><tr><th>Role</th><th>Variable</th><th>Used for</th></tr></thead>
					<tbody>
						{
							SCHEME_ROLES.map((r) => (
								<tr>
									<td>{r.name}</td>
									<td>
										<code>{r.v}</code>
									</td>
									<td>{r.use}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</section>

			<!-- ── Grounds and focus ── -->
			<section class="kit-sec" id="grounds">
				<header class="kit-sec__head">
					<h2>Grounds and focus</h2>
					<p>
						<code>data-surface</code> on an ancestor says what a control sits on: a Band sets it from its ground, a Card and
						a Dialog set <code>light</code>. It picks each component's dark look and the focus ring (2px, 3px out,
						keyboard only). Tab through the row on each ground.
					</p>
					<p class="kit-sec__src">src/components/ui/Band.astro · src/styles/_surface.scss</p>
				</header>
				<div class="kit-grounds">
					{
						GROUNDS.map((g) => (
							<figure class="kit-ground">
								<Band
									ground={g.ground}
									pad="sm"
									hue={g.ground === 'hue' || g.ground === 'fade' ? '#3d50f5' : undefined}
								>
									<div class="kit-ground__row">
										<Button size="sm">Primary</Button>
										<Button size="sm" variant="secondary">
											Secondary
										</Button>
										<Link href="#grounds" size="sm">
											Link
										</Link>
									</div>
								</Band>
								<figcaption>
									<b>{g.ground}</b> {g.note}
								</figcaption>
							</figure>
						))
					}
					<figure class="kit-ground">
						<Band ground="dark" pad="sm">
							<div class="kit-ground__card" data-surface="light">
								<Button size="sm">Primary</Button>
								<Button size="sm" variant="secondary">Secondary</Button>
								<Link href="#grounds" size="sm">Link</Link>
							</div>
						</Band>
						<figcaption>
							<b>white box in dark</b> data-surface="light" brings the light look back
						</figcaption>
					</figure>
				</div>
				<div class="kit-rings">
					<figure class="kit-ring">
						<span class="kit-ring__sample" style="--r: var(--focus-ring-light)"></span>
						<figcaption><b>On light</b> <code data-var="--focus-ring-light"></code></figcaption>
					</figure>
					<figure class="kit-ring kit-ring--dark">
						<span class="kit-ring__sample" style="--r: var(--focus-ring-dark)"></span>
						<figcaption><b>On dark</b> <code data-var="--focus-ring-dark"></code></figcaption>
					</figure>
				</div>
			</section>

			<!-- ── Elevation ── -->
			<section class="kit-sec" id="elevation">
				<header class="kit-sec__head">
					<h2>Elevation</h2>
					<p>
						Five lifts, all cast in one UI ink (<code>--color-shadow-ui-rgb</code>), so a card throws the same shadow on
						white and on a tint. Nothing else casts a shadow.
					</p>
					<p class="kit-sec__src">src/styles/_theme.scss</p>
				</header>
				<div class="kit-elev">
					{
						ELEVATION.map((e) => (
							<figure class="kit-elev__item">
								<span class="kit-elev__box" style={`box-shadow: var(${e.token})`} />
								<figcaption>
									<code>{e.token}</code>
									<span>{e.use}</span>
									<span class="kit-muted">{e.where}</span>
								</figcaption>
							</figure>
						))
					}
				</div>
				<div class="kit-elev kit-elev--tint">
					{
						ELEVATION.map((e) => (
							<figure class="kit-elev__item">
								<span class="kit-elev__box" style={`box-shadow: var(${e.token})`} />
								<figcaption>
									<code>{e.token}</code> <span class="kit-muted">on the tint</span>
								</figcaption>
							</figure>
						))
					}
				</div>
				<table class="kit-table">
					<thead><tr><th>Token</th><th>Value</th></tr></thead>
					<tbody>
						{
							ELEVATION.map((e) => (
								<tr>
									<td>
										<code>{e.token}</code>
									</td>
									<td>
										<code class="kit-value" data-var={e.token} />
									</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</section>

			<!-- ── Radius ── -->
			<section class="kit-sec" id="radius">
				<header class="kit-sec__head">
					<h2>Radius</h2>
					<p>One corner per role. A component owns its corner; a page never sets one.</p>
					<p class="kit-sec__src">src/styles/_variables.scss ($radius-*)</p>
				</header>
				<div class="kit-radii">
					{
						RADII.map((r) => (
							<figure class="kit-radius">
								<span class="kit-radius__box" style={`border-radius: ${r.box}`} />
								<figcaption>
									<b>{r.name}</b>
									<span class="kit-muted">{r.where}</span>
								</figcaption>
							</figure>
						))
					}
				</div>
			</section>

			<!-- ── Spacing ── -->
			<section class="kit-sec" id="spacing">
				<header class="kit-sec__head">
					<h2>Spacing</h2>
					<p>
						The scale every gap and padding is drawn from (<code>$spacing-*</code>), and the five steps a Band pads a
						section with, which drop a step below 750.
					</p>
					<p class="kit-sec__src">src/styles/_variables.scss · src/components/ui/Band.astro</p>
				</header>
				<div class="kit-scale">
					{
						SPACING.map((n) => (
							<div class="kit-scale__step">
								<span class="kit-scale__bar" style={`width: ${n}px`} />
								<code>{n}</code>
							</div>
						))
					}
				</div>
				<table class="kit-table">
					<thead><tr><th>Band pad</th><th>From 750</th><th>Below 750</th></tr></thead>
					<tbody>
						{
							BAND_PADS.map(([name, wide, narrow]) => (
								<tr>
									<td>
										<code>{name}</code>
									</td>
									<td>{wide}</td>
									<td>{narrow}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</section>

			<!-- ── Type ── -->
			<section class="kit-sec" id="type">
				<header class="kit-sec__head">
					<h2>Type</h2>
					<p>Ubuntu, in steps, never fluid. The numbers are measured at this width; resize to see the phone steps.</p>
					<p class="kit-sec__src">src/styles/_variables.scss (type-*)</p>
				</header>
				<div class="kit-type">
					{
						TYPE.map((t) => (
							<div class="kit-type__row" data-m="type" data-m-el={`.kit-t--${t.mixin}`}>
								<p class={`kit-t--${t.mixin}`}>{t.sample}</p>
								<p class="kit-type__meta">
									<code>type-{t.mixin}</code>
									<span class="kit-m" />
									<span class="kit-muted">{t.use}</span>
								</p>
							</div>
						))
					}
				</div>
			</section>

			<!-- ── Icons and motion ── -->
			<section class="kit-sec" id="icons">
				<header class="kit-sec__head">
					<h2>Icons and motion</h2>
					<p>
						Tabler glyphs, sized by the component they sit in. Motion is short and stops for anyone who asked for less (<code
							>prefers-reduced-motion</code
						>).
					</p>
				</header>
				<table class="kit-table">
					<thead><tr><th>Where</th><th>Icon</th></tr></thead>
					<tbody>
						<tr><td>Button xs · sm · md and lg · xl</td><td>16 · 18 · 20 · 22</td></tr>
						<tr><td>Link chevron and arrow</td><td>1.25em of the text (18 · 20 · 22); the arrow 1em</td></tr>
						<tr><td>Chip md · sm</td><td>20 · 16</td></tr>
						<tr><td>Tabs list · grid · segmented</td><td>20 · 18 · 20</td></tr>
						<tr><td>Mark</td><td>60% of the tile (its ladder)</td></tr>
					</tbody>
				</table>
				<div class="kit-specs" style="--spec-h: 46px; --spec-w: 150px">
					<figure class="kit-spec" data-m="dur">
						<Button>Button</Button><figcaption><b>Button colour</b><span class="kit-m"></span></figcaption>
					</figure>
					<figure class="kit-spec" data-m="dur">
						<Chip href="#icons">Chip</Chip><figcaption><b>Chip</b><span class="kit-m"></span></figcaption>
					</figure>
					<figure class="kit-spec" data-m="dur">
						<Card href="#icons" title="Card" pad="sm" /><figcaption>
							<b>Card lift</b><span class="kit-m"></span>
						</figcaption>
					</figure>
					<figure class="kit-spec" data-m="dur" data-m-el=".ui-seg__thumb">
						<Tabs
							label="Motion"
							items={[
								{ label: 'One', panel: 'kit-motion-a' },
								{ label: 'Two', panel: 'kit-motion-b' },
							]}
						/>
						<figcaption><b>Segmented thumb</b><span class="kit-m"></span></figcaption>
					</figure>
				</div>
				<div class="kit-panels">
					<TabPanel id="kit-motion-a" selected><span></span></TabPanel>
					<TabPanel id="kit-motion-b"><span></span></TabPanel>
				</div>
			</section>

			<p class="kit__part">Components</p>

			<!-- ── Button ── -->
			<section class="kit-sec" id="button">
				<header class="kit-sec__head">
					<h2>Button</h2>
					<p>
						Three variants, five sizes, one 6px corner. Colour from the scheme, the ring from the ground. An
						<code>&lt;a&gt;</code> with <code>href</code>, a <code>&lt;button&gt;</code> without.
					</p>
					<p class="kit-sec__src">src/components/ui/Button.astro · src/styles/_button.scss</p>
				</header>
				<div class="kit-stage">
					<p class="kit-label">Variants</p>
					<div class="kit-specs" style="--spec-h: 44px; --spec-w: 190px">
						<figure class="kit-spec" data-m="size,pad,type,radius">
							<Button icon="tabler:cloud-filled">Primary</Button>
							<figcaption><b>primary</b><span class="kit-m"></span></figcaption>
						</figure>
						<figure class="kit-spec" data-m="size,pad,type,radius">
							<Button variant="secondary" icon="tabler:download">Secondary</Button>
							<figcaption><b>secondary</b><span class="kit-m"></span></figcaption>
						</figure>
						<figure class="kit-spec" data-m="size,pad,type,radius">
							<Button variant="tertiary">Tertiary</Button>
							<figcaption><b>tertiary</b><span class="kit-m"></span></figcaption>
						</figure>
						<figure class="kit-spec">
							<Button variant="secondary" tinted>Tinted</Button>
							<figcaption><b>secondary tinted</b><span class="kit-muted">the label in the ink</span></figcaption>
						</figure>
						<figure class="kit-spec">
							<Button variant="tertiary" flush>Flush</Button>
							<figcaption><b>tertiary flush</b><span class="kit-muted">no side padding</span></figcaption>
						</figure>
					</div>
					<p class="kit-label">Schemes</p>
					<div class="kit-row">
						<Button>brand</Button>
						<Button accent="onprem">onprem</Button>
						<Button accent="neutral">neutral</Button>
						<Button accent="#0b6952">one-off #0b6952</Button>
						<Button variant="secondary" tinted accent="onprem">onprem tinted</Button>
					</div>
				</div>
				<div class="kit-stage kit-stage--tint">
					<p class="kit-label">Sizes</p>
					<div class="kit-specs" style="--spec-h: 56px; --spec-w: 230px">
						{
							SIZES.map((s) => (
								<figure class="kit-spec" data-m="size,pad,type,icon">
									<Button size={s} icon="tabler:cloud-filled">
										Try for free
									</Button>
									<figcaption>
										<b>{s}</b>
										<span class="kit-m" />
									</figcaption>
								</figure>
							))
						}
					</div>
					<p class="kit-label">Per breakpoint</p>
					<div class="kit-row">
						<figure class="kit-spec" data-m="size">
							<Button size={{ base: 'md', lg: 'xl' }}>md, xl from lg</Button>
							<figcaption>
								<b>size=&#123;&#123; base: 'md', lg: 'xl' &#125;&#125;</b><span class="kit-m"></span>
							</figcaption>
						</figure>
					</div>
				</div>
				<div class="kit-stage kit-stage--dark" data-surface="dark">
					<p class="kit-label">On dark</p>
					<div class="kit-row">
						<Button icon="tabler:cloud-filled">Primary</Button>
						<Button variant="secondary" icon="tabler:download">Secondary</Button>
						<Button variant="tertiary">Tertiary</Button>
						<Button shimmer icon="tabler:cloud-filled">Shimmer on hover</Button>
					</div>
				</div>
				<div class="kit-stage">
					<p class="kit-label">States and options</p>
					<div class="kit-specs" style="--spec-h: 44px; --spec-w: 170px">
						<figure class="kit-spec">
							<Button disabled>Disabled</Button><figcaption>
								<b>disabled</b><span class="kit-muted">40%</span>
							</figcaption>
						</figure>
						<figure class="kit-spec">
							<Button href="/" disabled variant="secondary">Disabled link</Button><figcaption>
								<b>disabled link</b><span class="kit-muted">aria-disabled, no href</span>
							</figcaption>
						</figure>
						<figure class="kit-spec">
							<Button loading loadingLabel="Sending">Send message</Button><figcaption>
								<b>loading</b><span class="kit-muted">width held</span>
							</figcaption>
						</figure>
						<figure class="kit-spec" data-m="size">
							<Button iconOnly icon="tabler:x" label="Close" variant="tertiary" accent="neutral" size="sm" /><figcaption
							>
								<b>icon only</b><span class="kit-m"></span>
							</figcaption>
						</figure>
						<figure class="kit-spec">
							<Button href="https://thingsboard.cloud/" external variant="secondary">Support portal</Button><figcaption>
								<b>external</b><span class="kit-muted">arrow, new tab</span>
							</figcaption>
						</figure>
						<figure class="kit-spec">
							<Button to="cloud-signup" icon="tabler:cloud-filled">Start for free</Button><figcaption>
								<b>to="cloud-signup"</b><span class="kit-muted">opens the region picker</span>
							</figcaption>
						</figure>
					</div>
					<p class="kit-label">ButtonGroup: stacks by its own width</p>
					<div class="kit-row kit-row--top">
						<div class="kit-col" style="width: 360px">
