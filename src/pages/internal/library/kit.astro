---
import PlaygroundLayout from '@layouts/PlaygroundLayout.astro';
import Button from '@components/ui/Button.astro';
import ButtonGroup from '@components/ui/ButtonGroup.astro';
import Link from '@components/ui/Link.astro';
import Mark from '@components/ui/Mark.astro';
import Chip from '@components/ui/Chip.astro';
import ChipGroup from '@components/ui/ChipGroup.astro';
import Tabs from '@components/ui/Tabs.astro';
import TabPanel from '@components/ui/TabPanel.astro';
import Field from '@components/ui/Field.astro';
import Card from '@components/ui/Card.astro';
import CardGrid from '@components/ui/CardGrid.astro';
import LinkCard from '@components/ui/LinkCard.astro';
import Band from '@components/ui/Band.astro';
import Dialog from '@components/ui/Dialog.astro';
import RegionChoice from '@components/Landing/RegionChoice.astro';
import SectionHeader from '@components/Landing/SectionHeader.astro';

/**
 * The kit: every `ui/` component in every variant, size and ground, rendered live from the
 * component itself, so what you see here is what a page gets. Hover, press and tab through it;
 * the static state grids live in the plan. One section per component, in the plan's order.
 */

const SIZES = ['xs', 'sm', 'md', 'lg', 'xl'] as const;
const LADDER = [36, 40, 48, 64, 72, 80, 88] as const;
const PRODUCTS = ['edge', 'trendz', 'gateway', 'mobile', 'tbmq'] as const;
---

<PlaygroundLayout title="Kit" description="Every ui/ component in every variant, size and ground, live.">
	<div class="kit">
		<!-- ── Button ── -->
		<section class="kit__block" id="button">
			<h2 class="kit__h">Button</h2>

			<div class="kit__stage">
				<p class="kit__label">Variants · on light</p>
				<div class="kit__row">
					<Button icon="tabler:cloud-filled">Try for free</Button>
					<Button variant="secondary" icon="tabler:download">Install</Button>
					<Button variant="tertiary">Talk to sales</Button>
					<Button accent="onprem">Install for free</Button>
					<Button variant="secondary" tinted accent="#0b6952" icon="tabler:cloud-filled">Start for free</Button>
				</div>
			</div>

			<div class="kit__stage kit__stage--dark" data-surface="dark">
				<p class="kit__label">Variants · on dark</p>
				<div class="kit__row">
					<Button icon="tabler:cloud-filled">Try for free</Button>
					<Button variant="secondary" icon="tabler:download">Install</Button>
					<Button variant="tertiary">Talk to sales</Button>
					<Button shimmer icon="tabler:cloud-filled">With shimmer</Button>
				</div>
				<div class="kit__card" data-surface="light">
					<p class="kit__label">A light card inside the dark band</p>
					<div class="kit__row">
						<Button>Primary</Button>
						<Button variant="secondary">Secondary</Button>
						<Button variant="tertiary">Tertiary</Button>
					</div>
				</div>
			</div>

			<div class="kit__stage kit__stage--tint">
				<p class="kit__label">Sizes</p>
				<div class="kit__row kit__row--end">
					{
						SIZES.map((s) => (
							<div class="kit__spec">
								<Button size={s} icon="tabler:cloud-filled">
									Try for free
								</Button>
								<span class="kit__cap">{s}</span>
							</div>
						))
					}
					<div class="kit__spec">
						<Button size={{ base: 'md', lg: 'xl' }}>md, xl from lg</Button>
						<span class="kit__cap">per breakpoint</span>
					</div>
				</div>
			</div>

			<div class="kit__stage">
				<p class="kit__label">States and options</p>
				<div class="kit__row">
					<Button disabled>Disabled</Button>
					<Button href="/" disabled variant="secondary">Disabled link</Button>
					<Button loading loadingLabel="Sending">Send message</Button>
					<Button iconOnly icon="tabler:x" label="Close" variant="tertiary" accent="neutral" size="sm" />
					<Button href="https://thingsboard.cloud/" external variant="secondary">Support portal</Button>
					<Button to="cloud-signup" icon="tabler:cloud-filled">Opens the region picker</Button>
					<Button variant="tertiary" flush>Flush tertiary</Button>
				</div>
				<div class="kit__narrow">
					<p class="kit__label">ButtonGroup stackBelow={400}, in a 360 column</p>
					<ButtonGroup stackBelow={400} equal>
						<Button icon="tabler:cloud-filled">Start for free</Button>
						<Button variant="secondary">See plans</Button>
					</ButtonGroup>
				</div>
				<div class="kit__wide">
					<p class="kit__label">The same group in a 560 column, centred</p>
					<ButtonGroup stackBelow={400} align="center">
						<Button icon="tabler:cloud-filled">Start for free</Button>
						<Button variant="secondary">See plans</Button>
					</ButtonGroup>
				</div>
			</div>
		</section>

		<!-- ── Link ── -->
		<section class="kit__block" id="link">
			<h2 class="kit__h">Link</h2>
			<div class="kit__stage">
				<p class="kit__label">Sizes and tones</p>
				<div class="kit__row">
					<Link href="#link" size="sm">Case study</Link>
					<Link href="#link">See supported protocols</Link>
					<Link href="#link" size="lg">Connectivity guide</Link>
					<Link href="#link" tone="ink">Customer stories</Link>
					<Link href="#link" tone="muted" dir="back">Back to the homepage</Link>
					<Link href="https://thingsboard.cloud/" external>Support portal</Link>
				</div>
				<p class="kit__prose">
					Read the <Link variant="inline" href="#link">installation guide</Link> first, then come back here.
				</p>
			</div>
			<div class="kit__stage" data-accent="onprem">
				<p class="kit__label">data-accent="onprem"</p>
				<div class="kit__row">
					<Link href="#link">Explore On-premises</Link>
					<Link href="#link" tone="ink">Customer stories</Link>
				</div>
			</div>
			<div class="kit__stage kit__stage--dark" data-surface="dark">
				<p class="kit__label">On dark</p>
				<div class="kit__row">
					<Link href="#link">See plans</Link>
					<Link href="#link" tone="ink">Customer stories</Link>
					<Link href="#link" tone="muted">Legal note</Link>
				</div>
				<p class="kit__prose kit__prose--dark">
					Read the <Link variant="inline" href="#link">installation guide</Link> first.
				</p>
			</div>
		</section>

		<!-- ── Mark ── -->
		<section class="kit__block" id="mark">
			<h2 class="kit__h">Mark</h2>
			<div class="kit__stage kit__stage--tint">
				<p class="kit__label">The ladder · icon</p>
				<div class="kit__row kit__row--end">
					{
						LADDER.map((s) => (
							<div class="kit__spec">
								<Mark size={s} icon="tabler:box" />
								<span class="kit__cap">{s}</span>
							</div>
						))
					}
				</div>
				<p class="kit__label">Logo, solid and white</p>
				<div class="kit__row kit__row--end">
					{
						LADDER.filter((s) => s !== 36).map((s) => (
							<div class="kit__spec">
								<Mark size={s} logo="thingsboard" />
								<Mark size={s} logo="thingsboard" fill="white" lift />
								<span class="kit__cap">{s}</span>
							</div>
						))
					}
				</div>
				<p class="kit__label">Products at 72, knocked out and original</p>
				<div class="kit__row kit__row--end">
					{
						PRODUCTS.map((p) => (
							<div class="kit__spec">
								<Mark size={72} product={p} accent="#3d50f5" />
								<Mark size={72} product={p} fill="white" lift />
								<span class="kit__cap">{p}</span>
							</div>
						))
					}
				</div>
				<p class="kit__label">Products at 40, original</p>
				<div class="kit__row kit__row--end">
					{PRODUCTS.map((p) => <Mark size={40} product={p} fill="white" lift />)}
				</div>
			</div>
			<div class="kit__stage">
				<p class="kit__label">Fills</p>
				<div class="kit__row kit__row--end">
					<Mark size={64} icon="tabler:box" />
					<Mark size={64} icon="tabler:box" fill="white" lift accent="brand" />
					<Mark size={64} icon="tabler:box" fill="wash" />
					<Mark size={64} icon="tabler:message-circle" fill="neutral" />
					<Mark size={64} icon="tabler:box" accent="onprem" />
					<Mark size={40} icon="tabler:world" fill="wash" shape="circle" accent="#0e8aa8" />
				</div>
			</div>
			<div class="kit__stage kit__stage--dark" data-surface="dark">
				<p class="kit__label">On dark</p>
				<div class="kit__row kit__row--end">
					<Mark size={64} icon="tabler:box" />
					<Mark size={64} icon="tabler:box" fill="white" />
					<Mark size={64} icon="tabler:box" fill="wash" />
					<Mark size={80} logo="thingsboard" fill="white" />
				</div>
			</div>
		</section>

		<!-- ── Chip ── -->
		<section class="kit__block" id="chip">
			<h2 class="kit__h">Chip</h2>
			<div class="kit__stage">
				<ChipGroup label="On your servers">
					<li><Chip href="#chip" icon="tabler:box" note="Linux, macOS">Docker</Chip></li>
					<li><Chip href="#chip" icon="tabler:box">Ubuntu</Chip></li>
					<li><Chip href="#chip" size="sm" icon="tabler:box">Small</Chip></li>
				</ChipGroup>
				<div class="kit__row">
					<Chip kind="toggle" size="sm">Gateway</Chip>
					<Chip kind="toggle" size="sm" pressed>Edge</Chip>
					<Chip>Nearest to you</Chip>
					<Chip tone="neutral">Add-on</Chip>
					<Chip solid>Popular</Chip>
				</div>
			</div>
			<div class="kit__stage kit__stage--dark" data-surface="dark">
				<div class="kit__row">
					<Chip href="#chip" icon="tabler:box" note="Linux, macOS">Docker</Chip>
					<Chip>Last visited</Chip>
				</div>
			</div>
		</section>

		<!-- ── Tabs ── -->
		<section class="kit__block" id="tabs">
			<h2 class="kit__h">Tabs</h2>
			<div class="kit__stage">
				<p class="kit__label">Segmented</p>
				<Tabs
					label="Route"
					items={[
						{ label: 'Rule chain', panel: 'kit-seg-a' },
						{ label: 'AI agent', panel: 'kit-seg-b' },
					]}
				/>
				<TabPanel id="kit-seg-a" selected><p class="kit__prose">The rule chain panel.</p></TabPanel>
				<TabPanel id="kit-seg-b"><p class="kit__prose">The AI agent panel.</p></TabPanel>
				<p class="kit__label">List, md and sm</p>
				<div class="kit__tabs">
					<Tabs
						look="list"
						label="Questions"
						items={[
							{ label: 'General', panel: 'kit-list-a' },
							{ label: 'Security', panel: 'kit-list-b' },
							{ label: 'Billing', panel: 'kit-list-c' },
						]}
					/>
					<div>
						<TabPanel id="kit-list-a" selected><p class="kit__prose">General questions.</p></TabPanel>
						<TabPanel id="kit-list-b"><p class="kit__prose">Security questions.</p></TabPanel>
						<TabPanel id="kit-list-c"><p class="kit__prose">Billing questions.</p></TabPanel>
					</div>
					<Tabs
						look="list"
						size="sm"
						label="Use cases"
						items={[
							{ label: 'Smart energy', panel: 'kit-sm-a', icon: 'tabler:bolt' },
							{ label: 'Fleet tracking', panel: 'kit-sm-b', icon: 'tabler:truck' },
						]}
					/>
					<div>
						<TabPanel id="kit-sm-a" selected><p class="kit__prose">Energy.</p></TabPanel>
						<TabPanel id="kit-sm-b"><p class="kit__prose">Fleets.</p></TabPanel>
					</div>
				</div>
			</div>
		</section>

		<!-- ── Field ── -->
		<section class="kit__block" id="field">
			<h2 class="kit__h">Field</h2>
			<div class="kit__stage">
				<div class="kit__fields">
					<Field name="kit-email" label="Work email" type="email" placeholder="name@company.com" />
					<Field name="kit-company" label="Company" optional hint="Working on your own? Your name is fine." />
					<Field name="kit-bad" label="Email" error="Enter an email like name@company.com." value="ana@acme" />
					<Field name="kit-msg" label="How can we help?" type="textarea" maxLength={3000} counter />
				</div>
			</div>
			<div class="kit__stage kit__stage--dark" data-surface="dark">
				<Field name="kit-sub" label="Subscribe to product news" size="md" type="email" placeholder="name@company.com">
					<Button slot="end" size="md" attached="start">Subscribe</Button>
				</Field>
			</div>
		</section>

		<!-- ── Card ── -->
		<section class="kit__block" id="card">
			<h2 class="kit__h">Card</h2>
			<div class="kit__stage kit__stage--tint">
				<CardGrid>
					<Card href="#card" title="Rule engine">
						<p class="kit__small">Route, transform and enrich telemetry with visual chains.</p>
					</Card>
					<Card title="A tile that holds actions">
						<p class="kit__small">Its buttons own the states; the card stays still.</p>
						<ButtonGroup slot="footer"><Button size="sm">Start</Button></ButtonGroup>
					</Card>
					<Card role="panel" title="A panel" titleSize="card">
						<p class="kit__small">r16, the panel lift, 32 padding.</p>
					</Card>
				</CardGrid>
				<CardGrid cols={2}>
					<LinkCard href="#card" title="Explore Cloud" line="Plans and regions." icon="tabler:cloud" markFill="wash" />
					<LinkCard
						href="https://thingsboard.io/"
						title="An external card"
						line="Leaves the site."
						icon="tabler:book"
						trail="external"
					/>
				</CardGrid>
			</div>
		</section>

		<!-- ── Band + Section header ── -->
		<section class="kit__block" id="band">
			<h2 class="kit__h">Band and section header</h2>
		</section>
	</div>
	<Band ground="tint" pad="md">
		<SectionHeader
			title="A tint band, md"
			subtitle="64 above and below, 48 on a phone."
			subtitleMeasure="copy"
			spacing="none"
			badge={{ icon: 'tabler:box', color: '#3d50f5' }}
		/>
	</Band>
	<Band ground="fade" strength={14} pad="md">
		<SectionHeader title="A fade to 14%" subtitle="The trust band's ground." subtitleMeasure="copy" spacing="none" />
	</Band>
	<Band ground="dark" wave pad="xl">
		<SectionHeader
			title="A dark band with the wave"
			subtitle="data-surface flips everything inside."
			titleSize="closing"
			subtitleMeasure="closing"
			spacing="sm"
		/>
		<ButtonGroup align="center">
			<Button icon="tabler:cloud-filled">Primary</Button>
			<Button variant="secondary">Secondary</Button>
			<Link href="#band">A link</Link>
		</ButtonGroup>
	</Band>
	<Band ground="hue" hue="#3d50f5" pad="md">
		<RegionChoice layout="row" />
	</Band>
	<div class="kit">
		<!-- ── Dialog ── -->
		<section class="kit__block" id="dialog">
			<h2 class="kit__h">Dialog</h2>
			<div class="kit__stage">
				<div class="kit__row">
					<Button attrs={{ 'data-dialog-open': 'kit-dialog' }}>Open the dialog</Button>
				</div>
			</div>
			<Dialog
				id="kit-dialog"
				title="Choose your data region"
				eyebrow="ThingsBoard Cloud"
				lede="Your data stays in the region you choose."
				mark={{ logo: 'thingsboard' }}
			>
				<RegionChoice layout="card" nearest="eu" />
				<p class="kit__small" slot="footer">A footer line.</p>
			</Dialog>
		</section>
	</div>
</PlaygroundLayout>

<style lang="scss">
	@use '../../../styles/variables' as *;

	.kit {
		display: grid;
		gap: 72px;
		max-width: 1200px;
		margin: 0 auto;
		padding: 32px 20px 120px;
	}

	.kit__block {
		display: grid;
		gap: 16px;
	}

	.kit__h {
		@include type-section;

		margin: 0;
	}

	.kit__stage {
		display: grid;
		gap: 16px;
		padding: 28px;
		border: 1px solid rgba(23, 24, 28, 0.1);
		border-radius: 14px;
		background: #fff;
	}

	.kit__stage--tint {
		background: var(--band-tint);
	}

	.kit__stage--dark {
		border-color: transparent;
		background: var(--band-indigo);
		color: #fff;
	}

	.kit__card {
		display: grid;
		gap: 12px;
		padding: 20px;
		border-radius: 8px;
		background: #fff;
		color: var(--color-text);
	}

	.kit__label {
		@include type-eyebrow;

		margin: 0;
		color: var(--color-text-secondary);

		.kit__stage--dark & {
			color: rgba(255, 255, 255, 0.6);
		}

		.kit__card & {
			color: var(--color-text-secondary);
		}
	}

	.kit__row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 20px 24px;
	}

	.kit__row--end {
		align-items: flex-end;
	}

	.kit__spec {
		display: grid;
		justify-items: start;
		gap: 8px;
	}

	.kit__cap {
		@include type-small;

		color: var(--color-text-secondary);
	}

	.kit__narrow {
		display: grid;
		gap: 8px;
		width: 360px;
		max-width: 100%;
	}

	.kit__wide {
		display: grid;
		gap: 8px;
		width: 560px;
		max-width: 100%;
	}

	.kit__prose {
		@include type-body;

		margin: 0;
	}

	.kit__prose--dark {
		color: rgba(255, 255, 255, 0.85);
	}

	.kit__small {
		@include type-small;

		margin: 0;
		color: var(--color-text-secondary);
	}

	.kit__tabs {
		display: grid;
		grid-template-columns: 220px minmax(0, 1fr);
		gap: 16px 32px;
	}

	.kit__fields {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 20px 16px;
	}
</style>
