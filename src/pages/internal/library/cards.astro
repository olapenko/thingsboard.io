---
import PlaygroundLayout from '@layouts/PlaygroundLayout.astro';
import EcosystemCard from '@components/Landing/EcosystemCard.astro';
import CliTerminal from '@components/Landing/CliTerminal.astro';
import GatewayDiagram from '@components/Landing/GatewayDiagram.astro';
import GatewayHub from '@components/Landing/GatewayHub.astro';
import GatewayRelay from '@components/Landing/GatewayRelay.astro';
import CardVideo from '@components/Landing/CardVideo.astro';
import { homeEcosystem } from '@data/homeEcosystem';
import { AI_CLI_SESSION, AI_CLI_LABEL } from '@data/ai-visual';

// Internal reference page: every ecosystem card in both formats, so a new one
// can be checked against the set before it reaches a marketing page. Not linked
// from anywhere and kept out of the index.

type CardProps = Record<string, unknown>;

// Ecosystem cards only. The deployment cards reuse this component but not its
// logic — badge fill, corner glyph, tinted name — so they are checked on the
// homepage, not here.
// Library-only, deliberately not in homeEcosystem: the CLI is being drafted here
// before any decision to put it on a marketing page.
const cliCard: CardProps = {
	name: 'ThingsBoard CLI',
	label: 'Solutions as code',
	description:
		'Build and manage solutions from the terminal, then version, review and ship them to any environment. Drive it yourself, or let an AI agent drive it for you.',
	icon: 'tabler:terminal-2',
	href: '/docs/pe/user-guide/cli/',
	accent: '#1c7ed6',
	action: 'Read the CLI docs',
};

const all: { source: string; props: CardProps }[] = [
	...homeEcosystem.map((c) => ({ source: 'homeEcosystem', props: c as unknown as CardProps })),
	{ source: 'library only', props: cliCard },
];

// Visuals arrive one at a time; a card not named here shows the placeholder slot.
const SLOT_VISUALS = ['ThingsBoard CLI', 'IoT Gateway', 'Trendz'];

// Grouped by card, not by format: the point of the page is comparing one card's
// two shapes, which is hard to do when they sit in different sections.
const cards = all.map(({ source, props }) => ({
	source,
	name: props.name as string,
	visual: SLOT_VISUALS.includes(props.name as string) ? (props.name as string) : null,
	hasVisual: Boolean(props.videoWebm || props.tiles) || SLOT_VISUALS.includes(props.name as string),
	// The plain card, stripped of anything that only exists to fill a second
	// column, so the two shapes are a like-for-like comparison.
	single: {
		...props,
		wide: false,
		at: undefined,
		tiles: undefined,
		videoWebm: undefined,
		videoMp4: undefined,
		stores: undefined,
	},
	double: { ...props, wide: true },
}));
---

{
	/* PlaygroundLayout, like every other internal page, not BaseLayout: no site header, no footer,
	   nothing between the cards and the page edge that is not under review. It also carries the
	   internal toolbar. */
}
<PlaygroundLayout
	title="Ecosystem cards"
	description="Every card in the set, one row each: the one-wide shape beside the two-wide one, so a card can be judged against itself rather than against its neighbours. Two-wide cards without artwork show a placeholder slot — those get filled in one at a time."
>
	<div class="lib">
		<p class="lib__meta">
			{cards.length} cards · {cards.filter((c) => c.hasVisual).length} with artwork ·{' '}
			{cards.filter((c) => !c.hasVisual).length} awaiting artwork
		</p>

		{
			cards.map((card) => (
				<section class="lib__group">
					<header class="lib__group-head">
						<h2>{card.name}</h2>
						<p class="lib__group-meta">
							<span>{card.source}</span> ·{' '}
							<span class:list={['lib__tag', card.hasVisual && 'lib__tag--done']}>
								{card.hasVisual ? 'artwork' : 'placeholder'}
							</span>
						</p>
					</header>

					<div class="lib__pair">
						<figure class="lib__item">
							<EcosystemCard {...(card.single as any)} />
							<figcaption>One-wide</figcaption>
						</figure>

						<figure class="lib__item">
							{card.visual === 'ThingsBoard CLI' ? (
								<EcosystemCard {...(card.double as any)} class="lib-cli-card">
									{/* The AI section's terminal: the same typed session, docked to the card's
									    foot and cut by it. The card's `--accent` reaches the prompt, arguments
									    and caret, so the session takes the card's blue, not the section's violet. */}
									<div class="lib__cli">
										<CliTerminal session={AI_CLI_SESSION} path="cold-chain" ariaLabel={AI_CLI_LABEL} />
									</div>
								</EcosystemCard>
							) : card.visual === 'IoT Gateway' ? (
								<EcosystemCard {...(card.double as any)}>
									<GatewayDiagram />
								</EcosystemCard>
							) : card.visual === 'Trendz' ? (
								<EcosystemCard {...(card.double as any)}>
									<CardVideo
										webm="https://video.thingsboard.io/trendz-hero-video.webm"
										mp4="https://video.thingsboard.io/trendz-hero-video.mp4"
										label="Trendz building a chart from device telemetry"
									/>
								</EcosystemCard>
							) : (
								<EcosystemCard {...(card.double as any)} />
							)}
							<figcaption>Two-wide</figcaption>
						</figure>

						{/* A candidate visual under the one the card ships with, at the same size, so the
						    two are judged side by side rather than from memory. */}
						{card.visual === 'IoT Gateway' && (
							<figure class="lib__item lib__item--candidate">
								<EcosystemCard {...(card.double as any)}>
									<GatewayRelay />
								</EcosystemCard>
								<figcaption>
									Two-wide · PRIMARY candidate: <span>GatewayRelay</span> — GatewayHub simplified: no destination,
									the uplink cut by the card's edge. What the homepage ships.
								</figcaption>
							</figure>
						)}

						{card.visual === 'IoT Gateway' && (
							<figure class="lib__item lib__item--candidate">
								<EcosystemCard {...(card.double as any)}>
									<GatewayHub />
								</EcosystemCard>
								<figcaption>
									Two-wide · candidate: <span>GatewayHub</span> — the Connect and Platform visuals' vocabulary
								</figcaption>
							</figure>
						)}

						{/* Superseded forms, kept renderable so a backtrack is a props change, not a
						    reconstruction. The store buttons are restated here because the data no
						    longer carries them. */}
						{card.name === 'Mobile App' && (
							<figure class="lib__item lib__item--candidate">
								<EcosystemCard
									{...(card.double as any)}
									wholeCard={false}
									stores={[
										{ label: 'App Store', href: '/products/mobile-pe/' },
										{ label: 'Google Play', href: '/products/mobile-pe/' },
									]}
								/>
								<figcaption>
									Two-wide · previous: <span>store buttons</span>, link-only hover — both buttons pointed at the
									product page for want of real store URLs
								</figcaption>
							</figure>
						)}

						{card.name === 'IoT Hub' && (
							<figure class="lib__item lib__item--candidate">
								<EcosystemCard {...(card.double as any)} wholeCard={false} at={{ cols3: 'flip', cols2: 'flip' }} />
								<figcaption>
									Two-wide · previous: <span>flipped</span> (tiles left, copy right), link-only hover
								</figcaption>
							</figure>
						)}
					</div>
				</section>
			))
		}
	</div>
</PlaygroundLayout>

<style lang="scss">
	@use '../../../styles/variables' as *;

	.lib {
		// 1160, not the playground's 1200: the column this page had under BaseLayout (1200 less its own
		// 20px gutters), which is what sets the cards at 380 / 760 — the widths they were judged at.
		max-width: 1160px;
		margin: 0 auto;
		// The line height the cards inherit on the site's own pages (24px at 16), which the playground
		// body leaves at `normal`. Without it every card came out 5.5px shorter here than where it
		// ships, and this page exists to show them at their real size.
		line-height: 1.5;
	}

	// The layout's page title, held to the same column so it keeps the cards' left edge.
	:global(.pg__head) {
		max-width: 1160px;
	}

	h2 {
		@include card-title;
		margin: 0;
	}

	.lib__meta {
		@include text-s;
		margin: 0 0 $spacing-10;
		color: var(--color-text-secondary, #5b616e);
	}

	// One row per card: the one-wide shape at roughly the width it gets on the
	// homepage, the two-wide one at twice that, so both are judged at true size.
	.lib__group {
		margin-bottom: $spacing-20;
	}

	.lib__group-head {
		display: flex;
		align-items: baseline;
		gap: $spacing-3;
		margin-bottom: $spacing-5;
		padding-bottom: $spacing-2;
		border-bottom: 1px solid var(--sl-color-hairline-light);
	}

	.lib__group-meta {
		@include text-s;
		margin: 0;
		color: var(--color-text-secondary, #5b616e);

		span {
			font-family: $font-family-mono;
			font-size: 0.9em;
		}
	}

	.lib__pair {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: $spacing-5;
		align-items: start;

		// Below the card's own two-column breakpoint the pair would be two nearly
		// identical stacks, so they go one under the other instead.
		@include media-down(lg) {
			grid-template-columns: 1fr;
			gap: $spacing-10;
		}
	}

	code {
		padding: 1px 5px;
		border-radius: 4px;
		background: var(--sl-color-gray-6, #f2f3f7);
		font-family: $font-family-mono;
		font-size: 0.9em;
	}

	.lib__item {
		margin: 0;
		display: flex;
		flex-direction: column;
	}

	// Under the shipping two-wide card, in its column. Only while the pair is two columns: stacked,
	// `grid-column: 2` would invent a second column rather than find one.
	.lib__item--candidate {
		@include media-up(lg) {
			grid-column: 2;
		}
	}

	figcaption {
		@include text-s;
		margin-top: $spacing-3;
		color: var(--color-text-secondary, #5b616e);

		span {
			font-family: $font-family-mono;
			font-size: 0.9em;
		}
	}

	.lib__tag {
		padding: 1px 6px;
		border-radius: 4px;
		background: #fdf0e6;
		color: #a04503;
	}

	// ── The CLI card's terminal ─────────────────────────────────────
	// The AI section's CLI band, at card size. There the window runs off the band's bottom edge;
	// here it runs off the card's. The visual column drops its centring and reaches through the
	// card's bottom padding, so the crop and the card's edge are the same line — the same move
	// `.ecosystem-card__mockup` makes for the phone.
	.lib :global(.lib-cli-card .ecosystem-card__visual) {
		position: relative;
		align-self: stretch;
		height: 250px;
		margin-bottom: calc(-1 * #{$spacing-5});
		overflow: hidden;

		@include media-up(md) {
			align-self: end;
		}
	}

	// Absolute, top-anchored and taller than its box, so the box's foot is where the window is cut —
	// the same arithmetic as `.ai__cli`, and for the same reason: a flex item that overflows does not
	// place predictably.
	.lib__cli {
		position: absolute;
		top: 20px;
		right: 0;
		left: 0;
		max-width: 500px;
		margin: 0 auto;
	}

	.lib__cli :global(.cli) {
		--cli-chrome: 0.8;

		display: flex;
		flex-direction: column;
		height: 260px;
		border-radius: 10px;
		// The AI band's shadow, pulled in: the card is a smaller surface than a full-bleed band, and
		// a heavier drop read as the window lifting off it.
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.06) inset,
			0 6px 14px rgba(0, 0, 0, 0.22);
	}

	.lib__cli :global(.cli__scroll) {
		flex: 1 1 auto;
		min-height: 0;
	}

	// Sized so the whole session fits with no scroll. The longest command is 25.15em including its
	// gutter (measured for the AI band), and the narrowest two-column cell leaves ~318px of log, so
	// 12.5px is the ceiling; nine rows at 1.4 plus padding is ~182px against ~222px visible.
	.lib__cli :global(.cli__body) {
		height: 100%;
		max-height: 100%;
		padding-bottom: 8px;
		font-size: 12.5px;
		line-height: 1.4;
	}

	.lib__cli :global(.cli__path) {
		font-size: 11px;
	}

	// Stacked, the card is the whole phone column, and a 47-character command needs the type down a
	// step to stay on one line.
	@include media-down(md) {
		.lib :global(.lib-cli-card .ecosystem-card__visual) {
			height: 220px;
			margin-top: $spacing-4;
		}

		.lib__cli :global(.cli__body) {
			font-size: 10.5px;
		}

		.lib__cli :global(.cli__path) {
			font-size: 9.5px;
		}
	}

	.lib__tag--done {
		background: #e7f5ec;
		color: #1f8b4d;
	}
</style>
