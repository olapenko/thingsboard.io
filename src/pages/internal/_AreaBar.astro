---
import { Icon } from 'astro-icon/components';
import { TABS_UP_TO, areaFor } from '@root/pages/internal/_areas';

/**
 * The top bar of every internal page: the area's name, its overview as a grid icon, and its pages,
 * above the page's title. The island at the bottom opens an area; this moves between its pages.
 *
 * ONE RULE for every area: the pages are tabs while there are few (`TABS_UP_TO`), and a picker,
 * grouped as the overview groups its tiles, once there are more. Components has thirteen sections,
 * so it gets the picker; Flows and Design system have two each, so they get tabs. An area that
 * grows past the limit switches by itself.
 *
 * STICKY, because these pages run long and the way to the next page is what you want after
 * deciding something, which is when you are at the bottom. FULL BLEED, by cancelling the
 * playground's body padding on three sides and paying it back as its own. Opaque, or the rows
 * scroll through it.
 *
 * Two slots. `end` sits at the bar's right, for a page that needs a control there. `below` is a
 * slim second row that sticks with the bar: the section pages' marks summary, shown only while
 * something is marked.
 *
 * Renders nothing on a page outside every area.
 */
interface Props {
	path: string;
}

const path = Astro.props.path.replace(/\/?$/, '/');
const { area, page } = areaFor(path);
const overview = area?.pages.find((p) => p.icon);
const pages = area?.pages.filter((p) => p !== overview) ?? [];
const asPicker = pages.length > TABS_UP_TO;
const inPage = page && page !== overview ? page : undefined;

// The picker's groups, in the order the pages come.
const groups = pages.reduce<{ title: string; items: typeof pages }[]>((acc, p) => {
	const title = p.group ?? '';
	const last = acc[acc.length - 1];
	if (last && last.title === title) last.items.push(p);
	else acc.push({ title, items: [p] });
	return acc;
}, []);
---

{
	area && (
		<div class="abar">
			<nav class="abar__row" aria-label={area.label}>
				<span class="abar__area">{area.label}</span>
				{overview && (
					<a
						class:list={['abar__tab', 'abar__tab--icon', page === overview && 'is-here']}
						href={overview.href}
						aria-current={page === overview ? 'page' : undefined}
						aria-label={overview.label}
						title={overview.label}
					>
						<Icon name={overview.icon!} aria-hidden="true" />
					</a>
				)}
				{asPicker ? (
					// A `<details>` disclosure: a list of links needs no more machinery than that, and it
					// works without the script, which only closes it on an outside click or Escape.
					<details class="abar__pick" data-abar-pick>
						<summary
							class:list={['abar__summary', inPage && 'is-here']}
							aria-label={`${area.label}: ${inPage ? inPage.label : 'choose a page'}`}
						>
							<span class="abar__current">{inPage ? inPage.label : 'All pages'}</span>
							<Icon name="tabler:chevron-down" class="abar__caret" aria-hidden="true" />
						</summary>
						<div class="abar__menu">
							{groups.map((g) => (
								<div class="abar__group">
									{g.title && <p class="abar__gname">{g.title}</p>}
									<ul>
										{g.items.map((p) => (
											<li>
												<a class="abar__item" href={p.href} aria-current={p === page ? 'page' : undefined}>
													{p.label}
												</a>
											</li>
										))}
									</ul>
								</div>
							))}
						</div>
					</details>
				) : (
					<ul class="abar__tabs">
						{pages.map((p) => (
							<li>
								<a
									class:list={['abar__tab', p === page && 'is-here']}
									href={p.href}
									aria-current={p === page ? 'page' : undefined}
								>
									{p.label}
								</a>
							</li>
						))}
					</ul>
				)}
				<div class="abar__end">
					<slot name="end" />
				</div>
			</nav>
			<slot name="below" />
		</div>
	)
}

<script>
	document.querySelectorAll<HTMLDetailsElement>('[data-abar-pick]').forEach((pick) => {
		document.addEventListener('click', (e) => {
			if (pick.open && !pick.contains(e.target as Node)) pick.open = false;
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && pick.open) {
				pick.open = false;
				pick.querySelector('summary')?.focus();
			}
		});
	});
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	.abar {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: calc(-1 * #{$spacing-10}) calc(-1 * #{$spacing-6}) $spacing-10;
		background: #fff;
		border-bottom: 1px solid var(--color-border, #ebebeb);
	}

	.abar__row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: $spacing-2;
		min-height: 48px;
		padding: $spacing-2 $spacing-6;
	}

	.abar__area {
		@include text-xs;
		margin-right: $spacing-2;
		font-family: $font-family-mono;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-text-secondary, #5b616e);
	}

	.abar__tabs {
		display: flex;
		gap: 2px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.abar__tab {
		@include text-s;
		display: inline-flex;
		align-items: center;
		height: 32px;
		padding: 0 $spacing-3;
		border-radius: $radius-md;
		font-weight: $font-weight-medium;
		color: var(--color-text-secondary, #5b616e);
		text-decoration: none;
		white-space: nowrap;

		&:hover {
			background: var(--sl-color-gray-6, #f2f3f7);
			color: var(--color-text, #17181c);
		}

		&:focus-visible {
			outline: 2px solid $color-brand;
			outline-offset: 1px;
		}

		&.is-here {
			background: var(--color-text, #17181c);
			color: #fff;
		}
	}

	.abar__tab--icon {
		justify-content: center;
		width: 32px;
		padding: 0;

		:global(svg) {
			width: 18px;
			height: 18px;
		}
	}

	// ---- The picker, for an area with more pages than tabs can hold -------------------------------

	.abar__pick {
		position: relative;
	}

	.abar__summary {
		display: inline-flex;
		align-items: center;
		gap: $spacing-2;
		height: 32px;
		padding: 0 $spacing-2 0 $spacing-3;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: $radius-md;
		list-style: none;
		cursor: pointer;
		user-select: none;

		&::-webkit-details-marker {
			display: none;
		}

		&:hover {
			border-color: var(--color-border, #c9ccd4);
		}

		&:focus-visible {
			outline: 2px solid $color-brand;
			outline-offset: 2px;
		}

		// A page of the area is open: the picker reads as the selected tab, as a tab would.
		&.is-here {
			border-color: var(--color-text, #17181c);
			background: var(--color-text, #17181c);
			color: #fff;

			.abar__caret {
				color: #fff;
			}
		}
	}

	.abar__current {
		@include text-s;
		font-weight: $font-weight-medium;
		white-space: nowrap;
		color: inherit;
	}

	.abar__caret {
		width: 16px;
		height: 16px;
		color: var(--color-text-secondary, #5b616e);
		transition: transform 0.15s ease;
	}

	.abar__pick[open] .abar__caret {
		transform: rotate(180deg);
	}

	.abar__menu {
		position: absolute;
		top: calc(100% + 6px);
		left: 0;
		z-index: 20;
		min-width: 260px;
		max-height: min(70vh, 600px);
		overflow-y: auto;
		padding: $spacing-2;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: $radius-lg;
		background: #fff;
		box-shadow:
			0 1px 2px rgb(23 24 28 / 6%),
			0 12px 32px rgb(23 24 28 / 14%);

		ul {
			margin: 0;
			padding: 0;
			list-style: none;
		}
	}

	.abar__group + .abar__group {
		margin-top: $spacing-2;
		padding-top: $spacing-2;
		border-top: 1px solid var(--sl-color-hairline-light);
	}

	.abar__gname {
		@include text-xs;
		margin: 0;
		padding: $spacing-1 $spacing-3;
		font-family: $font-family-mono;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-text-secondary, #5b616e);
	}

	.abar__item {
		@include text-s;
		display: block;
		padding: 5px $spacing-3;
		border-radius: $radius-md;
		color: var(--color-text, #17181c);
		text-decoration: none;

		&:hover,
		&:focus-visible {
			background: var(--sl-color-gray-6, #f2f3f7);
		}

		&:focus-visible {
			outline: 2px solid $color-brand;
			outline-offset: -2px;
		}

		&[aria-current='page'] {
			background: var(--color-text, #17181c);
			color: #fff;
		}
	}

	.abar__end {
		display: flex;
		align-items: center;
		gap: $spacing-2;
		margin-left: auto;

		&:empty {
			display: none;
		}
	}
</style>
