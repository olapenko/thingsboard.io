---
import { Icon } from 'astro-icon/components';
import { paasChoice } from '@data/paasPage';
import { onPremChoice } from '@data/onPremPage';

/**
 * The product pages' choice cards, restated for the sandbox: the Cloud page's Public/Private pair
 * or the On-premises page's licence pair, on the dark ground each page gives them.
 *
 * The card markup is the pages' own, and the styles come from `product-page.scss` via the global
 * import below — so a treatment judged here is judged on the shipping rules, not on a copy. What
 * IS restated is the `#choose` section shell (an id can't render twice on one sandbox page) and
 * each page's own custom properties, which normally arrive from the page's root: On-premises runs
 * the PE green on its own near-black; Cloud runs the defaults.
 */
interface Props {
	source: 'paas' | 'onprem';
}

const { source } = Astro.props;
const choice = source === 'paas' ? paasChoice : onPremChoice;
---

<section class:list={['sbx-choose', `sbx-choose--${source}`]}>
	<div class="choice__inner">
		<h3 class="choice__title">{choice.title}</h3>
		<p class="choice__lead">{choice.lead}</p>

		<div class="choice-grid">
			{
				choice.options.map((option) => (
					<div class="choice-card">
						<h4 class="choice-card__name">
							<Icon name={option.icon} class="choice-card__mark" aria-hidden="true" />
							{option.name}
						</h4>
						<p class="choice-card__price">
							{option.price}
							<span class="choice-card__price-note">{option.priceNote}</span>
						</p>
						<p class="choice-card__summary">{option.summary}</p>
						<ul class="choice-card__points">
							{option.points.map((point) => (
								<li>
									<Icon name="tabler:check" aria-hidden="true" />
									{point}
								</li>
							))}
						</ul>
						<div class="choice-card__actions">
							<a class:list={['choice-card__cta', `choice-card__cta--${option.cta.variant}`]} href={option.cta.href}>
								<Icon name={option.cta.icon} class="choice-card__cta-icon" aria-hidden="true" />
								{option.cta.text}
								<span class="sr-only">— ThingsBoard {option.name}</span>
							</a>
							<a class="choice-card__plans" href={option.plansHref}>
								See plans
								<span class="sr-only">for ThingsBoard {option.name}</span>
								<Icon name="tabler:chevron-right" aria-hidden="true" />
							</a>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<style is:global lang="scss">
	@use '../../styles/variables' as *;
	// The shipping rules, not a copy: `.choice`, `.choice-grid` and `.choice-card` all come from
	// here, exactly as the two product pages load them.
	@use '../../styles/product-page';

	// `#choose`'s shell, restated as a class: the section's own eight lines, minus the wave field
	// (the cards, not the weather, are what the sandbox reviews).
	.sbx-choose {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: $spacing-20 0;
		background-color: var(--page-hero-ground, #121425);
		color: #fff;
	}

	// What the On-premises page's root declares for itself.
	.sbx-choose--onprem {
		--page-accent: #{$color-pe-dark};
		--page-accent-light: #b4e7cd;
		--page-hero-ground: #101a14;
	}
</style>
