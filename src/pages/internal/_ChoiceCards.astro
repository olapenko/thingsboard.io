---
import ChoiceBand from '@components/Landing/ChoiceBand.astro';
import { paasChoice, paasOnPremises } from '@data/paasPage';
import { onPremChoice, onPremCtas } from '@data/onPremPage';

/**
 * The product pages' choice band, for the sandbox: the Cloud page's Public/Private pair or the
 * On-premises page's licence pair, each as its page renders it — the same `ChoiceBand`, with the
 * same props, so a treatment judged here is judged on the shipping component rather than a copy.
 *
 * What IS restated is what the On-premises page's root declares for itself (its near-black and its
 * wave), on a wrapper here, and the band's id: `#choose` cannot render twice on one sandbox page.
 */
interface Props {
	source: 'paas' | 'onprem';
}

const { source } = Astro.props;
---

{
	source === 'paas' ? (
		<ChoiceBand
			id="sbx-choose-paas"
			title={paasChoice.title}
			lead={paasChoice.lead}
			options={paasChoice.options}
			productName="ThingsBoard"
			note={{
				icon: paasOnPremises.icon,
				lead: paasOnPremises.lead,
				link: { text: paasOnPremises.text, href: paasOnPremises.href },
			}}
		/>
	) : (
		<div class="sbx-choose--onprem">
			<ChoiceBand
				id="sbx-choose-onprem"
				title={onPremChoice.title}
				lead={onPremChoice.lead}
				options={onPremChoice.options}
				accent="onprem"
				ground="var(--page-hero-ground)"
				waveHue="var(--page-wave)"
				note={{
					icon: onPremCtas.cloud.icon,
					lead: onPremCtas.cloud.lead,
					link: { text: onPremCtas.cloud.text, href: onPremCtas.cloud.href },
					tail: onPremCtas.cloud.tail,
				}}
			/>
		</div>
	)
}

<style lang="scss">
	@use '../../styles/variables' as *;

	// What the On-premises page's root declares for the band (`products/thingsboard-pe/index.astro`).
	.sbx-choose--onprem {
		--page-hero-ground: #101a14;
		--page-wave: #{$color-pe-hover};
	}
</style>
