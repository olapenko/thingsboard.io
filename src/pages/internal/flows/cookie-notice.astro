---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import Variant from '@root/pages/internal/_Variant.astro';
import CookieStage from '@root/pages/internal/_CookieStage.astro';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * Cookie notice: the banner at the foot of every page (`CookieBanner`, rendered by `BaseLayout`),
 * and its brush-up (`CookieNotice`), judged over a window of the page it lands on — the homepage's
 * black hero, or a docs page — with the chat launcher it shares the corner with.
 *
 * THE ONE IN USE, measured on the homepage: a 96px glass bar at 1440x900, in the system face, with
 * a blue that is not the site's, and two buttons — Accept and a close — that set the same cookie. On
 * a 375x812 phone it is 213px tall, 26% of the screen, and its paragraph is the page's LCP element
 * on every redesigned page but the homepage (the Lighthouse run of 2026-09-29).
 *
 * IN USE since 2026-10-01: "Bar · short, linked title · indigo", rendered by `BaseLayout`. The old
 * banner stays here as "Before". The new one reads the same cookie, so a visitor who dismissed the
 * old banner does not see it.
 */

const inst = (id: string) => ({ id: `cn-${id}` });
---

<VisualPage visual="cookie-notice">
	<aside class="brief">
		<p class="brief__kicker">The notice</p>
		<dl class="brief__facts">
			<div>
				<dt>In use</dt>
				<dd>
					Since 2026-10-01, <em>Bar · short, linked title · indigo</em>: the indigo bar, “Cookie policy ›” as the
					heading and the link, the short sentence at 13/20, one Accept. 77px at 1440, 173px on a phone.
				</dd>
			</div>
			<div>
				<dt>Before</dt>
				<dd>
					A translucent dark bar across the foot of the window: “Cookie policy” over the sentence, Accept in
					<code>#1a6fd4</code>, a close beside it that does the same thing. System face. 96px tall at 1440, where the
					chat launcher misses the close by 15px (at 1280 it covers it); 213px of an 812px phone at 13px.
				</dd>
			</div>
			<div>
				<dt>Brushed</dt>
				<dd>
					Ubuntu on the site’s type roles (<code>type-small</code> copy, <code>type-tile</code> title), the hero’s own button
					(brand <code>#3d50f5</code>, 700, 44px, 4px corners), a solid ground in white or the bookends’ indigo,
					<em>one</em> action, a hairline and the UI shadow ink, a 200ms rise in and a fade out (none under reduced motion),
					focus rings. The chat launcher keeps its corner in every direction.
				</dd>
			</div>
			<div>
				<dt>Component</dt>
				<dd>
					<code>components/CookieNotice.astro</code> — <code>layout</code> (card · bar), <code>tone</code> (light · dark),
					<code>copy</code> (shipped · short), <code>title</code>. Same cookie as today (<code
						>cookie-notice-dismissed=true</code
					>, a year), read before first paint. Here it runs in demo mode: Accept hides it without writing the cookie.
				</dd>
			</div>
			<div>
				<dt>Copy</dt>
				<dd>
					Every direction carries today’s sentence verbatim except the two marked <em>short</em>: a DRAFT, not legal’s
					words, that keeps why, browsing-is-agreeing and the policy link and drops the pointer to browser settings (the
					Cookie Policy page covers that). It is what lets the bar hold one line on desktop.
				</dd>
			</div>
			<div>
				<dt>Not done</dt>
				<dd>
					Legal’s sign-off on the short sentence, which is in use as drafted; a Reject or settings choice — it is still
					a notice, as before, and that is a consent decision rather than a brush-up.
				</dd>
			</div>
		</dl>
		<p class="brief__acts">
			<button type="button" class="brief__btn" data-cs-replay>Show the notices again</button>
		</p>
	</aside>

	<div class="page-ctl" role="group" aria-label="Page behind the notice">
		<span class="page-ctl__name">Behind it</span>
		<button type="button" data-cs-pick="home" aria-pressed="true">Homepage</button>
		<button type="button" data-cs-pick="docs" aria-pressed="false">Docs page</button>
	</div>

	<Variant
		visual={kv('cookie-notice')}
		component={CookieStage}
		props={{ shipped: true }}
		bleed
		name="Before · CookieBanner"
		note="the banner every page rendered until 2026-10-01 · glass bar edge to edge, system face, Accept and a close that do the same thing · 96px at 1440, 117 at 1280, where the chat launcher covers the close · 213px on a phone, the copy at 13px"
	/>

	<Variant
		visual={kv('cookie-notice')}
		component={CookieStage}
		props={{ notice: { layout: 'card', tone: 'light', ...inst('card-light') } }}
		bleed
		name="Card · white"
		note="recommended · today's words verbatim in a 400px card, bottom-left, 24px in: title, sentence, Accept, 236px tall · white with a hairline and the UI shadow, the brightest thing over the black hero and lifted by its shadow over a white page · on a phone 8px in on three sides, the title dropped: 222px against today's 213, at 14px rather than 13"
	/>

	<Variant
		visual={kv('cookie-notice')}
		component={CookieStage}
		props={{ notice: { layout: 'card', tone: 'light', titleLink: true, textSize: 'small', ...inst('card-link') } }}
		bleed
		name="Card · linked title"
		note="the white card with the heading as the link — 'Cookie policy ›' to /cookie-policy/, underlined on hover — and the policy's name in the sentence back to plain text, so one link, not two · the sentence at 13/20, a step under the ladder's 14px floor · 226px on desktop (236 at 14px) · the heading stays on a phone, since the link lives there: 234px against today's 213"
	/>

	<Variant
		visual={kv('cookie-notice')}
		component={CookieStage}
		props={{ notice: { layout: 'card', tone: 'dark', ...inst('card-dark') } }}
		bleed
		name="Card · indigo"
		note="the same card on the bookends' indigo, #121425 · quieter over a white page, close to disappearing over the black hero"
	/>

	<Variant
		visual={kv('cookie-notice')}
		component={CookieStage}
		props={{ notice: { layout: 'bar', tone: 'dark', ...inst('bar-dark') } }}
		bleed
		name="Bar · indigo"
		note="today's shape, brushed: edge to edge, solid indigo for the glass, the sentence at the 1200 content width beside one Accept, the close gone · 77px at 1440 (today 96), 99 at 1280 · the right side held 90px clear of the launcher at any width · 221px on a phone"
	/>

	<Variant
		visual={kv('cookie-notice')}
		component={CookieStage}
		props={{ notice: { layout: 'bar', tone: 'light', ...inst('bar-light') } }}
		bleed
		name="Bar · white"
		note="the brushed bar in white, a hairline and a soft shadow upward · reads as part of the page's chrome, like the header at the other end"
	/>

	<Variant
		visual={kv('cookie-notice')}
		component={CookieStage}
		props={{ notice: { layout: 'card', tone: 'light', copy: 'short', ...inst('card-short') } }}
		bleed
		name="Card · short copy"
		note="DRAFT COPY, not legal's · the white card with the sentence cut to its three claims: 'We use cookies to keep this site secure and improve your experience. By continuing to browse, you agree to our Cookie Policy.' · 192px on desktop, 156 on a phone (today 213)"
	/>

	<Variant
		visual={kv('cookie-notice')}
		component={CookieStage}
		props={{ notice: { layout: 'bar', tone: 'dark', copy: 'short', ...inst('bar-short') } }}
		bleed
		name="Bar · short copy"
		note="DRAFT COPY, not legal's · the indigo bar with the short sentence on ONE line at 1440 and two at 1280 — 77px either way, the button's height · 155px on a phone, 19% of the screen against today's 26%"
	/>
	<Variant
		visual={kv('cookie-notice')}
		component={CookieStage}
		props={{
			notice: {
				layout: 'bar',
				tone: 'dark',
				copy: 'short',
				titleLink: true,
				textSize: 'small',
				...inst('bar-link-dark'),
			},
		}}
		bleed
		shipping
		name="Bar · short, linked title · indigo"
		note="DRAFT COPY, not legal's · the bar with 'Cookie policy ›' as the heading and the link, the short sentence under it at 13/20 with the policy's name as plain text, one Accept at the end of the line · 77px at 1440 and 1280 (today 96 and 117), 97 at 768 · 173px on a phone against today's 213, the chat launcher clear · on the bookends' indigo"
	/>

	<Variant
		visual={kv('cookie-notice')}
		component={CookieStage}
		props={{
			notice: {
				layout: 'bar',
				tone: 'light',
				copy: 'short',
				titleLink: true,
				textSize: 'small',
				...inst('bar-link-light'),
			},
		}}
		bleed
		name="Bar · short, linked title · white"
		note="DRAFT COPY, not legal's · the bar with 'Cookie policy ›' as the heading and the link, the short sentence under it at 13/20 with the policy's name as plain text, one Accept at the end of the line · 77px at 1440 and 1280 (today 96 and 117), 97 at 768 · 173px on a phone against today's 213, the chat launcher clear · in white, a hairline and a soft shadow upward"
	/>
</VisualPage>

<style lang="scss">
	@use '../../../styles/variables' as *;

	.brief {
		max-width: 1200px;
		margin: 0 auto $spacing-12;
		padding: $spacing-6;
		border-radius: $radius-lg;
		background: var(--color-bg-secondary, #f5f6ff);
	}

	.brief__kicker {
		@include text-xs;
		margin: 0 0 $spacing-4;
		font-family: $font-family-mono;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-secondary, #5b616e);
	}

	.brief__facts {
		display: grid;
		gap: $spacing-3;
		margin: 0;

		> div {
			display: grid;
			grid-template-columns: 110px minmax(0, 1fr);
			gap: $spacing-4;

			@media (max-width: 599px) {
				grid-template-columns: 1fr;
				gap: $spacing-1;
			}
		}

		dt {
			@include text-s;
			font-family: $font-family-mono;
			color: var(--color-text-secondary, #5b616e);
		}

		dd {
			@include text-s;
			margin: 0;
			max-width: 80ch;
		}

		code {
			font-family: $font-family-mono;
			font-size: 0.92em;
		}

		em {
			font-style: normal;
			font-weight: $font-weight-medium;
		}
	}

	.brief__acts {
		margin: $spacing-4 0 0;
	}

	.brief__btn {
		@include text-s;
		padding: 6px 12px;
		border: 1px solid var(--color-border-light, #e0e1e2);
		border-radius: $radius-md;
		background: #fff;
		cursor: pointer;

		&:hover {
			border-color: var(--color-text-secondary, #63656c);
		}
	}
</style>
