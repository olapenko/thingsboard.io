---
import PlaygroundLayout from '@layouts/PlaygroundLayout.astro';
import HubGrid from '@root/pages/internal/_HubGrid.astro';
import { areaGroups } from '@root/pages/internal/_key-visuals';

/**
 * Flows › Overview: the paths behind the site's buttons that lead to Cloud, one page per button,
 * each holding its variants the way a section page holds directions. The same tiles as the
 * Components overview; the island opens Flows here.
 */
---

<PlaygroundLayout title="Flows">
	<HubGrid groups={areaGroups('flows')} />
</PlaygroundLayout>
