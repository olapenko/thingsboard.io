---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import Variant from '@root/pages/internal/_Variant.astro';
import DocsStage from '@root/pages/internal/_DocsStage.astro';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * Docs notice: the banner over the Community Edition docs saying the product went source-available
 * at 4.4 and the CE documentation is not where the work happens any more.
 *
 * THE ONE IN USE (develop.tbqa.cloud/docs/) is red: a three-line card with the triangle glyph, the
 * lead in bold, the support sentence under it, the link a line below that, a close at the corner.
 * It reads as an error over a docs page that works. Every direction here is amber or yellow and,
 * on desktop, ONE LINE — the round glyph, the lead, the support, the link, the close — and each is
 * the same `DocsNotice` component under a different `layout`. The stage is the top of the CE docs
 * landing, restated (`_DocsStage`), so the notice is judged under a header and over the hero.
 *
 * THE COPY, MEASURED. With the link inline — "…free with the Community Grant Program ›" — the
 * shipped sentence holds one line verbatim at the docs width (72rem, less the glyph, the close and
 * the padding: 1044px for the line): 863px at 14px, 986px at 16px. Before, with "Full guide for
 * Community Edition Users" as a separate link at the end, it did not fit at either size and had to
 * be trimmed. The link's target is not in this fork; it is `#` until the page is known.
 *
 * NOT WIRED IN. The component exists and the CE landing's hero is where it goes; that is the next
 * change, once a direction is promoted.
 */

const LINK_HREF = '#'; // the Community Grant Program page: target not known from this fork

/** The banner in use today, word for word; the link moved onto the programme's name. */
const SHIPPED = {
	lead: 'From version 4.4, ThingsBoard becomes a source-available product.',
	support: 'Keep what you run today free with the {link}.',
	link: { text: 'Community Grant Program', href: LINK_HREF },
};

/**
 * DRAFT COPY that says what the page asked for — that the CE docs here are discontinued — rather
 * than only the licence news. Not the design's words; written here to see the shape with a lead
 * about the docs themselves.
 */
const DISCONTINUED = {
	lead: 'These docs are no longer updated.',
	support: 'ThingsBoard 4.4+ is source-available; the {link} keeps what you run today free.',
	link: { text: 'Community Grant Program', href: LINK_HREF },
};

// Each instance keeps its own dismissal key, so closing one in the sandbox does not close the rest.
const inst = (id: string) => ({ id: `dn-${id}`, key: `docs-notice:sandbox/${id}` });
---

<VisualPage visual="docs-notice">
	<aside class="brief">
		<p class="brief__kicker">The notice</p>
		<dl class="brief__facts">
			<div>
				<dt>In use</dt>
				<dd>
					Red card over the CE docs hero, three lines: triangle glyph, bold lead, support, a blue “Full guide for
					Community Edition Users” link on its own line, close. The <em>Stack</em> direction is that shape in amber, as the
					baseline.
				</dd>
			</div>
			<div>
				<dt>Asked</dt>
				<dd>
					Amber or yellow rather than red, less alarm, a round glyph, and the whole sentence on one line on desktop. The
					CE docs under <code>/docs/</code> are being discontinued; the notice is what says so.
				</dd>
			</div>
			<div>
				<dt>Component</dt>
				<dd>
					<code>components/starlight/DocsNotice.astro</code> — <code>layout</code> (strip · line · pill · band · stack), <code
						>tone</code
					> (amber · yellow), <code>size</code> (14 or 16), <code>icon</code>,
					<code>dismissible</code>. The close remembers itself per browser; “Show dismissed” below brings them back.
				</dd>
			</div>
			<div>
				<dt>Copy</dt>
				<dd>
					The shipped sentence holds one line at neither 14 nor 16px at the docs width, so the one-line directions carry
					it trimmed (four words fewer at 14px, six at 16px); the <em>Stack</em> keeps it verbatim. One direction carries
					draft copy about the docs themselves being discontinued — not the design’s words.
				</dd>
			</div>
			<div>
				<dt>Not done</dt>
				<dd>
					Placing it on the CE landing (above <code>DocHero</code>), the guide’s URL, and reading the dismissal before
					first paint.
				</dd>
			</div>
		</dl>
		<p class="brief__acts">
			<button type="button" class="brief__btn" data-dn-reset>Show dismissed notices</button>
		</p>
	</aside>

	<Variant
		visual={kv('docs-notice')}
		component={DocsStage}
		props={{ notice: { ...SHIPPED, layout: 'strip', tone: 'amber', ...inst('strip-amber') } }}
		bleed
		name="Strip · amber"
		note="recommended · the shipped sentence, verbatim, on one line at 14/22: round glyph, lead in medium, support in grey with the link inline on the programme's name — underlined, text colour, a chevron — close at the edge · pale amber fill, hairline of the same hue, 8px corners, at the docs content width"
	/>

	<Variant
		visual={kv('docs-notice')}
		component={DocsStage}
		props={{ notice: { ...SHIPPED, layout: 'strip', tone: 'yellow', ...inst('strip-yellow') } }}
		bleed
		name="Strip · yellow"
		note="the same strip one step warmer: cream fill, a gold hairline, a brighter glyph · 'yellow' as most people picture it, against the site's own ochre above"
	/>

	<Variant
		visual={kv('docs-notice')}
		component={DocsStage}
		props={{ notice: { ...SHIPPED, layout: 'strip', tone: 'amber', size: 'base', ...inst('strip-16') } }}
		bleed
		name="Strip · 16px"
		note="the strip at the page's running size, 16/24 · the same sentence holds the line here too, at 986px of the 1044 a line has"
	/>

	<Variant
		visual={kv('docs-notice')}
		component={DocsStage}
		props={{ notice: { ...SHIPPED, layout: 'line', tone: 'amber', ...inst('line') } }}
		bleed
		name="Line"
		note="no box: a hairline above and below, the glyph the only thing in colour · the quietest one that still holds a place on the page"
	/>

	<Variant
		visual={kv('docs-notice')}
		component={DocsStage}
		props={{ notice: { ...SHIPPED, layout: 'pill', tone: 'amber', ...inst('pill') } }}
		bleed
		name="Pill"
		note="the lead and the programme link alone in a centred capsule; the support sentence dropped · for the version that wants to be small and out of the way · opens into a soft box on a phone"
	/>

	<Variant
		visual={kv('docs-notice')}
		component={DocsStage}
		props={{ notice: { ...SHIPPED, layout: 'band', tone: 'amber', ...inst('band') } }}
		bleed
		name="Band"
		note="edge to edge under the header, the fill running the full width and the copy at the content width · reads as part of the site's chrome rather than a card in the page"
	/>

	<Variant
		visual={kv('docs-notice')}
		component={DocsStage}
		props={{ notice: { ...DISCONTINUED, layout: 'strip', tone: 'amber', ...inst('discontinued') } }}
		bleed
		name="Strip · docs-discontinued copy"
		note="DRAFT COPY, not the design's · the lead about the docs themselves ('no longer updated'), the licence news as the support · shows the shape with a lead that says what this page is for"
	/>

	<Variant
		visual={kv('docs-notice')}
		component={DocsStage}
		props={{ notice: { ...SHIPPED, layout: 'stack', tone: 'amber', ...inst('stack') } }}
		bleed
		name="Stack · today's shape, recoloured"
		note="baseline · the shipped banner's stacked shape in amber with the round glyph: the lead on its own line, the support under it — two lines now that the link sits inside the sentence instead of on a third · what the one-line directions are judged against"
	/>
</VisualPage>

<style lang="scss">
	@use '../../../styles/variables' as *;

	.brief {
		max-width: 1200px;
		margin: 0 auto $spacing-12;
		padding: $spacing-6;
		border-radius: $radius-lg;
		background: var(--color-bg-secondary, #f5f6ff);
	}

	.brief__kicker {
		@include text-xs;
		margin: 0 0 $spacing-4;
		font-family: $font-family-mono;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-secondary, #5b616e);
	}

	.brief__facts {
		display: grid;
		gap: $spacing-3;
		margin: 0;

		> div {
			display: grid;
			grid-template-columns: 110px minmax(0, 1fr);
			gap: $spacing-4;

			@media (max-width: 599px) {
				grid-template-columns: 1fr;
				gap: $spacing-1;
			}
		}

		dt {
			@include text-s;
			font-family: $font-family-mono;
			color: var(--color-text-secondary, #5b616e);
		}

		dd {
			@include text-s;
			margin: 0;
			max-width: 80ch;
		}

		code {
			font-family: $font-family-mono;
			font-size: 0.92em;
		}

		em {
			font-style: normal;
			font-weight: $font-weight-medium;
		}
	}

	.brief__acts {
		margin: $spacing-4 0 0;
	}

	.brief__btn {
		@include text-s;
		padding: 6px 12px;
		border: 1px solid var(--color-border-light, #e0e1e2);
		border-radius: $radius-md;
		background: #fff;
		cursor: pointer;

		&:hover {
			border-color: var(--color-text-secondary, #63656c);
		}
	}
</style>
