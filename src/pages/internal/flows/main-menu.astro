---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import Variant from '@root/pages/internal/_Variant.astro';
import MenuStage from '@root/pages/internal/_MenuStage.astro';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * Main menu: how the new bar carries search on docs pages. Search is the tool docs readers reach for
 * most; the bar has no room to spare (the user: "the main menu is already too crowded"), so search
 * goes on DOCS ONLY and every other page keeps the bar it has.
 *
 * THE ONE IN USE is thingsboard.io's docs bar: the new bar with two unlabelled 40px icons before
 * Sign in — a theme switch that cycles System, Dark and Light, then search — and no GitHub star. On a
 * phone the theme switch takes the first slot, ahead of search. Neither ⌘K nor `/` does anything.
 *
 * THE CANDIDATES put `HeaderSearch` first in the group, before GitHub, Sign in and Try for free, and
 * drop the theme switch from the bar (it moves to the footer and the Menu drawer: the dark-mode work).
 * Both open the same dialog as today (`SiteSearch`, Google Programmable Search). ⌘K, Ctrl K and `/`
 * open it on either.
 *
 * WIDTHS, measured on the bar at 16a7a3c85: the nav leaves 246px free at 1440 and 111 at 1300, so a
 * 152px field fits from 1440 and only the 40px icon fits from 1281 to 1439. Below 1281 the nav is in
 * Menu and the icon sits beside Sign in; under 560 it sits beside Menu.
 *
 * Each frame is the real PE "Devices" guide under the candidate bar, so everything in it works.
 */
---

<VisualPage visual="main-menu">
	<aside class="brief">
		<p class="brief__kicker">Search in the bar</p>
		<dl class="brief__facts">
			<div>
				<dt>In use</dt>
				<dd>
					thingsboard.io’s docs: two unlabelled icons before Sign in, the theme switch and then search, and no GitHub
					star. No keyboard shortcut. The redesigned pages on this branch show no search at all.
				</dd>
			</div>
			<div>
				<dt>Asked</dt>
				<dd>
					A consistent search button in the main menu where search is available, without adding to a bar that is already
					full. Decided so far: search on <em>docs pages only</em>; the theme switch leaves the bar for the footer and
					the Menu drawer.
				</dd>
			</div>
			<div>
				<dt>Component</dt>
				<dd>
					<code>components/Landing/HeaderSearch.astro</code> — <code>form</code> (field · icon). The field: 152 × 40, magnifier,
					“Search” and the key hint (Ctrl K, or ⌘K on Apple devices), outline and hover from Sign in, from 1440px; a 40px
					icon below. Keys: ⌘K or Ctrl K anywhere, <code>/</code> outside a text field. The dialog is today’s, shared through
					<code>components/SiteSearch.astro</code>.
				</dd>
			</div>
			<div>
				<dt>Try</dt>
				<dd>
					Click into a frame and press <code>/</code> or Ctrl K. Open Menu in the 1024 frame and on the phone. The frames
					are the real docs page, so the dialog returns real results.
				</dd>
			</div>
			<div>
				<dt>Not done</dt>
				<dd>
					Wiring it into the docs bar (docs still render the old bar on this branch, so moving docs onto the new bar
					comes first), and the dialog’s placeholder naming the product (“Search ThingsBoard PE docs”).
				</dd>
			</div>
		</dl>
	</aside>

	<Variant
		visual={kv('main-menu')}
		component={MenuStage}
		props={{ candidate: 'field' }}
		phoneProps={{ phone: true }}
		deskWidth={1160}
		name="Field from 1440"
		note="recommended · search first in the group as a labelled field with its key hint where the bar has room (1440 and up), an icon below that · theme switch out of the bar · keys ⌘K, Ctrl K and /"
	/>

	<Variant
		visual={kv('main-menu')}
		component={MenuStage}
		props={{ candidate: 'icon' }}
		phoneProps={{ phone: true }}
		deskWidth={1160}
		name="Icon"
		note="the same place and keys, a 40px icon at every width · quieter at 1440, and the bar keeps the 112px the field would take · relies on the magnifier and the keys being known"
	/>

	<Variant
		visual={kv('main-menu')}
		component={MenuStage}
		props={{ candidate: 'live' }}
		phoneProps={{ phone: true }}
		deskWidth={1160}
		shipping
		name="Live docs bar"
		note="in use on thingsboard.io/docs · the new bar with the theme switch and the search icon before Sign in, no GitHub star · no keys · rebuilt here from this branch's bar, so the type and the measures are ours"
	/>
</VisualPage>

<style lang="scss">
	@use '../../../styles/variables' as *;

	.brief {
		max-width: 1200px;
		margin: 0 auto $spacing-12;
		padding: $spacing-6;
		border-radius: $radius-lg;
		background: var(--color-bg-secondary, #f5f6ff);
	}

	.brief__kicker {
		@include text-xs;
		margin: 0 0 $spacing-4;
		font-family: $font-family-mono;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-secondary, #5b616e);
	}

	.brief__facts {
		display: grid;
		gap: $spacing-3;
		margin: 0;

		> div {
			display: grid;
			grid-template-columns: 110px minmax(0, 1fr);
			gap: $spacing-4;

			@media (max-width: 599px) {
				grid-template-columns: 1fr;
				gap: $spacing-1;
			}
		}

		dt {
			@include text-s;
			font-family: $font-family-mono;
			color: var(--color-text-secondary, #5b616e);
		}

		dd {
			@include text-s;
			margin: 0;
			max-width: 80ch;
		}

		code {
			font-family: $font-family-mono;
			font-size: 0.92em;
		}

		em {
			font-style: normal;
			font-weight: $font-weight-medium;
		}
	}
</style>
