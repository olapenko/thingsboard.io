---
import VisualPage from '@root/pages/internal/_VisualPage.astro';
import Variant from '@root/pages/internal/_Variant.astro';
import ChatStage from '@root/pages/internal/_ChatStage.astro';
import ChatSkin from '@components/ChatWidget/ChatSkin.astro';
import { kv } from '@root/pages/internal/_key-visuals';

/**
 * AI chat: the YourGPT widget every page loads, restyled from our side, opened from our own launcher.
 *
 * THE ONE IN USE (since 2026-10-02) is "Wash · small question": the `wash` window opened from a
 * white 44px disc with a question mark and its glow in the cycling hue, 16px in, centred on the
 * cookie bar's Accept while the bar is up — wired into every page by `YourGptWidget` (`CHAT_SKIN`,
 * `CHAT_LAUNCHER`). It replaced "Wash · white circle" (2026-10-01), the same disc at 56 with the
 * sparkles, which repeated the AI section's mark in the corner. Before both, YourGPT's default — a purple (`#6354ee`)
 * header and bot bubbles, the system font, an 18px window and their 50px purple disc — kept here as
 * the baseline. The bot is named "Staging" in their dashboard, so that is what the header says on
 * thingsboard.io: a dashboard fix, not ours.
 *
 * HOW. The widget renders into the page's DOM, so these are OUR stylesheet (`ChatSkin`) over THEIR
 * markup — no fork, no proxy, nothing changed in their dashboard. The colour cycle is the AI section's
 * mark's, on its band's 2.5s leg, read from the same data (`CHAT_HUES`). Every stage holds the real
 * chat: one widget per page, mounted (`widget:mount`) into the open direction's window, so what is
 * judged is what a visitor would type into. Typing here talks to the live bot.
 *
 * A new direction is tried here first; promoting one means pointing `CHAT_SKIN` and `CHAT_LAUNCHER`
 * at it and moving `shipping`.
 */
---

<VisualPage visual="chat-widget">
	<ChatSkin />

	<aside class="brief">
		<p class="brief__kicker">The chat</p>
		<dl class="brief__facts">
			<div>
				<dt>In use</dt>
				<dd>
					<em>Wash · small question</em>, on every page since 2026-10-02 (<code>YourGptWidget</code> reads
					<code>CHAT_SKIN</code> and <code>CHAT_LAUNCHER</code>), after <em>Wash · white circle</em> from 2026-10-01. Before
					them: YourGPT’s defaults, the baseline tab. The bot is named <em>Staging</em> in their dashboard, so the header
					says so too.
				</dd>
			</div>
			<div>
				<dt>Asked</dt>
				<dd>
					The site’s look (1), our own launcher (2), and the AI section’s colour cycle on both, with a subtle glow.
				</dd>
			</div>
			<div>
				<dt>How</dt>
				<dd>
					The widget is in the page’s DOM, so <code>components/ChatWidget/ChatSkin.astro</code> restyles it through their
					<code>--yourgptChatbot*</code> properties and stable class names, scoped by <code>data-chat-skin</code>.
					<code>ChatLauncher</code> is the AI mark as a button: a click loads the widget if it has not loaded and opens it
					(<code>util/chat-widget.ts</code>). The window and the launcher run one clock.
				</dd>
			</div>
			<div>
				<dt>Live</dt>
				<dd>
					Each stage holds the real chat, so what you type here goes to the live bot. The hue sits on the window’s frame
					and its header; their bubbles, send button and focus rings take the brand blue (their colours are HSL
					triplets, which cannot follow an animated colour).
				</dd>
			</div>
			<div>
				<dt>Not done</dt>
				<dd>
					The bot’s name and welcome text in their dashboard, their welcome pop-up (it did not show in testing; it was
					placed for their launcher), and the cookie banner, whose close sits next to the launcher.
				</dd>
			</div>
		</dl>
	</aside>

	<Variant
		visual={kv('chat-widget')}
		component={ChatStage}
		props={{ skin: 'wash', launcher: { shape: 'tile', tone: 'hue' } }}
		bleed
		name="Wash"
		note="recommended · the AI band's wash in the header, the hue at 18% fading to white by the first message · our sparkles tile as the bot's mark · Ubuntu, ink, the bot's bubble pale, the visitor's in the brand · 16px window with a soft glow in the hue · launcher: the AI tile at 56, cycling, glow under it"
	/>

	<Variant
		visual={kv('chat-widget')}
		component={ChatStage}
		props={{ skin: 'wash', launcher: { shape: 'pill', tone: 'hue' } }}
		bleed
		name="Wash · Ask AI pill"
		note="the same window; the launcher a white capsule with the tile and 'Ask AI' — says what it is rather than leaving it to the glyph, at the cost of a wider corner · folds to the tile while the chat is open"
	/>

	<Variant
		visual={kv('chat-widget')}
		component={ChatStage}
		props={{ skin: 'wash', launcher: { shape: 'circle', tone: 'white', size: 'small', glyph: 'question' } }}
		bleed
		shipping
		name="Wash · small question"
		note="the white circle at 44 — the cookie bar's Accept — 16px in, so it sits on that button's row while the bar is up · a question mark for the sparkles, which are the AI section's mark and read as a second copy of it in the corner · the window 10 clear of it"
	/>

	<Variant
		visual={kv('chat-widget')}
		component={ChatStage}
		props={{ skin: 'wash', launcher: { shape: 'circle', tone: 'white' } }}
		bleed
		name="Wash · white circle"
		note="in use 2026-10-01 to 10-02 · the same window; the launcher a white disc at 56 with the sparkles in the hue, the glow round it in the hue too — the AI section's white chat mark as a button · the quietest of the launchers on a light page, and the one that stands clearest on the dark hero"
	/>

	<Variant
		visual={kv('chat-widget')}
		component={ChatStage}
		props={{ skin: 'fullwash', launcher: { shape: 'tile', tone: 'hue' } }}
		bleed
		name="Full wash"
		note="the band's own direction: white at the top, the hue at 14% at the foot of the window, under the messages and the composer · bot bubbles white on it · the most colour of the four"
	/>

	<Variant
		visual={kv('chat-widget')}
		component={ChatStage}
		props={{ skin: 'dark', launcher: { shape: 'tile', tone: 'dark' } }}
		bleed
		name="Dark header"
		note="the bookends' indigo header, white title, a 2px line of the hue along its foot glowing into the chat · launcher in the same indigo with the glyph and the glow in the hue · the AI terminal's look"
	/>

	<Variant
		visual={kv('chat-widget')}
		component={ChatStage}
		props={{ skin: 'wash', launcher: { shape: 'tile', tone: 'hue', cycle: false } }}
		bleed
		name="Wash · still launcher"
		note="as Wash, but the launcher rests in the brand blue and only cycles while the chat is open · for a corner that is on screen for as long as any page is read"
	/>

	<Variant
		visual={kv('chat-widget')}
		component={ChatStage}
		props={{ skin: 'yourgpt', launcher: 'yourgpt' }}
		bleed
		name="YourGPT default"
		note="the look before 2026-10-01, as a baseline · the dashboard's settings restated for a mounted chat: purple header and bot bubbles, system font, 18px window, their 50px disc"
	/>
</VisualPage>

<style lang="scss">
	@use '../../../styles/variables' as *;

	.brief {
		max-width: 1200px;
		margin: 0 auto $spacing-12;
		padding: $spacing-6;
		border-radius: $radius-lg;
		background: var(--color-bg-secondary, #f5f6ff);
	}

	.brief__kicker {
		@include text-xs;
		margin: 0 0 $spacing-4;
		font-family: $font-family-mono;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-secondary, #5b616e);
	}

	.brief__facts {
		display: grid;
		gap: $spacing-3;
		margin: 0;

		> div {
			display: grid;
			grid-template-columns: 110px minmax(0, 1fr);
			gap: $spacing-4;

			@media (max-width: 599px) {
				grid-template-columns: 1fr;
				gap: $spacing-1;
			}
		}

		dt {
			@include text-s;
			font-family: $font-family-mono;
			color: var(--color-text-secondary, #5b616e);
		}

		dd {
			@include text-s;
			margin: 0;
			max-width: 80ch;
		}

		code {
			font-family: $font-family-mono;
			font-size: 0.92em;
		}

		em {
			font-style: normal;
			font-weight: $font-weight-medium;
		}
	}
</style>
