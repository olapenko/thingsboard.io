---
/**
 * Bare page shell for the internal visual playground under `src/pages/internal/`.
 *
 * Deliberately NOT `BaseLayout`: that wraps `<StarlightPage>`, which brings the header,
 * sidebar, search, footer and cookie banner with it. None of that helps while iterating on a
 * single visual, and all of it has to be scrolled past to reach the thing being worked on.
 *
 * The catch is that bypassing Starlight also bypasses its `customCss`, which is where every
 * design token normally comes from. So this layout loads the two sheets itself:
 *
 *   1. Starlight's own `props.css`  — the `--sl-*` tokens. Ten of the Landing components read
 *      these directly (`--sl-color-hairline-light`, `--sl-color-gray-*`, …), so a hand-written
 *      shim would drift from the real values; this is the same file the docs pages get.
 *      Imported by relative path because the package's `exports` map does not expose
 *      `./style/props.css` for a bare specifier.
 *   2. `_starlight-overrides.scss` — `@use`s `_theme.scss`, which emits all the `--color-*`
 *      properties. `_theme.scss` says not to `@use` it from a component `<style>` block, and
 *      that still holds: the point is that it is emitted exactly once per page. On this route
 *      there is no Starlight to emit it, so this layout is that one place.
 *
 * The upshot: a visual built on a playground page renders against the same tokens, fonts and
 * mixins it will get on a marketing page, so it moves across without being re-fitted.
 */
import { Icon } from 'astro-icon/components';
import InternalNav from '@root/pages/internal/_InternalNav.astro';
import AreaBar from '@root/pages/internal/_AreaBar.astro';

import '../../node_modules/@astrojs/starlight/style/props.css';
import '@fontsource/ubuntu/300.css';
import '@fontsource/ubuntu/400.css';
import '@fontsource/ubuntu/500.css';
import '@fontsource/ubuntu/700.css';
import '@fontsource/ubuntu-mono/400.css';
// 700 as well, as `astro.config.ts` loads for the site: without it a bold mono here is synthesised
// while the homepage draws the real face, and the two stop matching.
import '@fontsource/ubuntu-mono/700.css';

interface Props {
	title: string;
	/** Shown under the title. One line on what the page is for. */
	description?: string;
	/** The page's mark before its title: a section's own badge, as its homepage row carries it. */
	badge?: { icon: string; color: string };
	/**
	 * Page furniture off: no header, no service nav, just the slot.
	 *
	 * For the phone previews, which load a sandbox page inside a 375px iframe so its media queries
	 * fire against a real phone viewport. What has to be in that frame is the row and nothing else.
	 */
	bare?: boolean;
}

const { title, description, badge, bare = false } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} · internal</title>
		{
			/* Keeps the page out of the sitemap: the sitemap integration reads the built HTML and
		    drops anything carrying `noindex`, rather than keeping a deny-list that drifts. */
		}
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" href="data:," />
	</head>

	<body>
		{
			/* Above the heading, and the first thing in the document: the area's top bar. A page's own
			   title is not navigation, so it should not come before the way between pages, and the bar is
			   sticky, which only reads as a toolbar if it starts at the top edge. A page adds to it
			   through two slots: `nav` at the bar's right (a section page's picker) and `below`, a slim
			   row that sticks with it (the marks summary). */
		}
		{
			!bare && (
				<AreaBar path={Astro.url.pathname}>
					<slot name="nav" slot="end" />
					<slot name="below" slot="below" />
				</AreaBar>
			)
		}

		{
			!bare && (
				<header class="pg__head">
					<div class="pg__title">
						{badge && (
							<span class="pg__badge" style={`--badge: ${badge.color}`} aria-hidden="true">
								<Icon name={badge.icon} />
							</span>
						)}
						<h1>{title}</h1>
					</div>
					{description && <p class="pg__lede">{description}</p>}
				</header>
			)
		}

		<slot />

		{!bare && <InternalNav />}
	</body>
</html>

<style lang="scss" is:global>
	@use '../styles/starlight-overrides';
	@use '../styles/variables' as *;

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		padding: $spacing-10 $spacing-6 $spacing-24;
		font-family: $font-family-base;
		background: var(--color-bg, #fff);
		color: var(--color-text, #171c22);
		-webkit-font-smoothing: antialiased;
	}

	img,
	svg {
		display: block;
		max-width: 100%;
	}

	// Aligned to the widest stage rather than to its own text measure, so the page title sits on
	// the same left edge as the visuals it labels. Only the lede is held to a reading width.
	.pg__head {
		max-width: 1200px;
		margin: 0 auto $spacing-10;
	}

	// The mark and the title on one line, the mark centred on the title's cap height.
	.pg__title {
		display: flex;
		align-items: center;
		gap: $spacing-4;
	}

	.pg__head h1 {
		@include section-title;
		margin: 0;
	}

	// The homepage row's own mark (`.feature-badge`) at title size: a squircle in the section's hue.
	.pg__badge {
		display: grid;
		flex: none;
		place-items: center;
		width: 48px;
		height: 48px;
		border-radius: 32%;
		background: var(--badge);
		color: #fff;

		svg {
			width: 28px;
			height: 28px;
		}
	}

	.pg__lede {
		@include body-text;
		max-width: 70ch;
		margin: $spacing-3 0 0;
		color: var(--color-text-secondary, #5b616e);
		text-wrap: pretty;
	}
</style>
