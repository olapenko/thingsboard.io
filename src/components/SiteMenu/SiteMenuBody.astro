---
import { Icon } from 'astro-icon/components';
import SiteMenuSection from '@components/SiteMenu/SiteMenuSection.astro';
import SiteMenuPromos from '@components/SiteMenu/SiteMenuPromos.astro';
import { describes, iconSizeOf, type MenuSection } from '@components/SiteMenu/menu-model';

/**
 * ONE SECTION'S CONTENT, the same on every surface that opens it — the one panel, a dropdown, the
 * sheet: its groups of links and the row of promotions it closes on, and, where the surface asks for
 * it, the section's name. The surface lays it out; this decides what is in it, once.
 */
interface Props {
	entry: MenuSection;
	/**
	 * The id of the section's heading. Without one there is no heading: the one panel and a dropdown
	 * hang under the item in the bar, which names the section already; only the sheet, a view of its
	 * own on a phone, says which section it is. A section item that owns a page leads with its
	 * "All …" link either way.
	 */
	titleId?: string;
}

const {
	entry: { item, sub },
	titleId,
} = Astro.props;
const all = item.href ? `All ${item.label.toLowerCase()}` : undefined;
---

{titleId ? (
	<div class="sm__head">
		<h2 class="sm__title" id={titleId}>
			{item.label}
		</h2>
		{all && (
			<a class="sm__all" href={item.href}>
				{all}
				<Icon name="tabler:chevron-right" aria-hidden="true" />
			</a>
		)}
	</div>
) : (
	all && (
		<a class="sm__all sm__all--lead" href={item.href}>
			{all}
			<Icon name="tabler:chevron-right" aria-hidden="true" />
		</a>
	)
)}
<SiteMenuSection
	submenu={sub}
	iconSize={iconSizeOf(sub)}
	describe={describes(sub)}
	omitName={titleId ? item.label : undefined}
/>
<SiteMenuPromos section={sub.id} />
