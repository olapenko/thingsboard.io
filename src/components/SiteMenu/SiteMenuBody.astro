---
import { Icon } from 'astro-icon/components';
import SiteMenuSection from '@components/SiteMenu/SiteMenuSection.astro';
import SiteMenuCustomers from '@components/SiteMenu/SiteMenuCustomers.astro';
import SiteMenuPromos from '@components/SiteMenu/SiteMenuPromos.astro';
import { iconSizeOf, type MenuSection } from '@components/SiteMenu/menu-model';

/**
 * ONE SECTION'S CONTENT, the same on every surface that opens it — the one panel, a dropdown, the
 * sheet: the section's name and its "All …" page, its groups of links, and what it carries besides
 * (Customers' stories, a row of promotions). The surface lays it out; this decides what is in it, once.
 */
interface Props {
	entry: MenuSection;
	/**
	 * The id of the section's heading. Without one there is no heading: a dropdown hangs under its
	 * item in the bar, which names it already, and leads with the "All …" link alone.
	 */
	titleId?: string;
}

const {
	entry: { item, sub },
	titleId,
} = Astro.props;
const all = item.href ? `All ${item.label.toLowerCase()}` : undefined;
---

{titleId ? (
	<div class="sm__head">
		<h2 class="sm__title" id={titleId}>
			{item.label}
		</h2>
		{all && (
			<a class="sm__all" href={item.href}>
				{all}
				<Icon name="tabler:chevron-right" aria-hidden="true" />
			</a>
		)}
	</div>
) : (
	all && (
		<a class="sm__all sm__all--lead" href={item.href}>
			{all}
			<Icon name="tabler:chevron-right" aria-hidden="true" />
		</a>
	)
)}
<SiteMenuSection submenu={sub} iconSize={iconSizeOf(sub)} />
{sub.id === 'nav-customers' && <SiteMenuCustomers />}
<SiteMenuPromos section={sub.id} />
