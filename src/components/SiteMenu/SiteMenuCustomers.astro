---
import { Icon } from 'astro-icon/components';
import { MENU_QUOTE, MENU_STORIES } from '@data/menu-customers';

/**
 * WHAT THE CUSTOMERS SECTION SHOWS under its links: three case studies as value cards — the figure,
 * what it counts, whose it is — and one line of feedback with its author. Styled by `SiteMenu` under `sm__story` and `sm__quote`.
 */
---

<div class="sm__cust">
	<div>
		<p class="sm__group-name">From the case studies</p>
		<ul class="sm__stories">
			{MENU_STORIES.map((s) => (
				<li>
					<a class="sm__story" href={s.href}>
						<b class="sm__story-value">{s.value}</b>
						<span class="sm__story-label">{s.label}</span>
						<span class="sm__story-meta">{s.company}</span>
					</a>
				</li>
			))}
		</ul>
	</div>
	<figure class="sm__quote">
		<Icon name="tabler:quote" class="sm__quote-mark" aria-hidden="true" />
		<blockquote class="sm__quote-text">{MENU_QUOTE.text}</blockquote>
		<figcaption class="sm__quote-by">
			<b>{MENU_QUOTE.author}</b>, {MENU_QUOTE.position} · {MENU_QUOTE.company}
		</figcaption>
		<a class="sm__all" href={MENU_QUOTE.href}>
			All feedback
			<Icon name="tabler:chevron-right" aria-hidden="true" />
		</a>
	</figure>
</div>
