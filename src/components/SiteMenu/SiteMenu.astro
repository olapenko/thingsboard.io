---
import { Icon } from 'astro-icon/components';
import SiteMenuSection from '@components/SiteMenu/SiteMenuSection.astro';
import SiteMenuSheet from '@components/SiteMenu/SiteMenuSheet.astro';
import SiteMenuPromos from '@components/SiteMenu/SiteMenuPromos.astro';
import SiteMenuCustomers from '@components/SiteMenu/SiteMenuCustomers.astro';
import { mainNavItems, allSubmenus } from '@data/navigation';

/**
 * THE MAIN MENU, rendered once from `data/navigation`, in one of two desktop models (layer 13's two
 * candidates) over one phone sheet:
 *
 * - `dropdowns`: each item with a section opens its own panel under it — the current menu's shape,
 *   redrawn: the section's groups side by side in their columns, the product marks, a featured slot
 *   in Products, the panel kept inside the viewport.
 * - `panel`: one surface under the whole bar; a rail of the sections on the left, the open section's
 *   groups on the right. Hovering or focusing a rail entry, or another item in the bar, switches the
 *   section without closing.
 *
 * A section may close on a row of promotions, one-line tiles from `data/menu-featured`
 * (`SiteMenuPromos`): Products on Pricing, Installation options and the Cloud sign-up; Services on
 * the proof and a conversation; Docs on the CLI and Get started. Customers closes on three case
 * studies and a line of feedback (`SiteMenuCustomers`). Docs is set in the monospace face, bold.
 *
 * Both open on hover intent (120ms), on click, and on Enter; both close on leave (200ms grace), on
 * Escape (focus back on the item), on a click outside, and when focus leaves the menu. Below 1281 the
 * row and the panels are gone and the bar's Menu button opens `SiteMenuSheet` instead.
 *
 * The item for a section is a `<button aria-expanded>`; a section whose item also has a page of its
 * own (Use Cases) gets that page as the first link of its panel. Items with no section are links.
 *
 * All of its styles are global under the `sm__` prefix: the panels are moved and measured by the
 * script, and the bar's own rules (white ink over a dark hero, the open sheet's surface) reach in.
 *
 * COLOUR IS A SET OF TOKENS, named once on `nav.sm` (`--sm-ink`, `--sm-soft`, `--sm-accent`,
 * `--sm-rule`, `--sm-fill`, `--sm-surface`) and reassigned, never restyled, where the ground changes:
 * the dark theme, the docs bar, the transparent bar over a dark hero. Every surface — the row, a
 * dropdown, the one panel, the sheet — draws from the same set, so what a reader sees on one page is
 * what they see on the next. The products' marks are the one exception by design: a logo keeps its
 * own colour on every ground, so those are literals (`--sm-brand-*`), the products page's.
 */
interface Props {
	model: 'dropdowns' | 'panel';
}

const { model } = Astro.props;

const submenuById = (id?: string) => (id ? allSubmenus.find((s) => s.id === id) : undefined);
const sections = mainNavItems
	.map((item) => ({ item, sub: submenuById(item.submenuId) }))
	.filter(
		(x): x is { item: (typeof mainNavItems)[number]; sub: NonNullable<ReturnType<typeof submenuById>> } => !!x.sub
	);
const panelId = (id: string) => `sm-${id}`;

// The item for the page a reader is on: its line stays, in the ink. A section whose item also has
// a page (Use Cases) is marked the same way through `data-current`, since `aria-current` is a link's.
const pathname = Astro.url.pathname;
const isHere = (href?: string) => !!href && href !== '/' && pathname.startsWith(href);
---

<nav class="sm print:hidden" data-model={model} aria-label="Main">
	<ul class="sm__row">
		{mainNavItems.map((item) => {
			const sub = submenuById(item.submenuId);
			return (
				<li class="sm__item" data-sm-item={sub?.id}>
					{sub ? (
						<button
							type="button"
							class="sm__top"
							id={item.id}
							aria-expanded="false"
							aria-controls={model === 'panel' ? 'sm-one' : panelId(sub.id)}
							data-sm-trigger={sub.id}
							data-current={isHere(item.href) || undefined}
						>
							{item.label}
							<Icon name="tabler:chevron-down" class="sm__top-chev" aria-hidden="true" />
						</button>
					) : (
						<a
							class:list={['sm__top', item.linkClass]}
							id={item.id}
							href={item.href}
							aria-current={isHere(item.href) ? 'page' : undefined}
						>
							{item.label}
						</a>
					)}
					{model === 'dropdowns' && sub && (
						<div class="sm__drop" id={panelId(sub.id)} data-sm-panel={sub.id} hidden>
							{item.href && (
								<a class="sm__all" href={item.href}>
									All {item.label.toLowerCase()}
									<Icon name="tabler:chevron-right" aria-hidden="true" />
								</a>
							)}
							<SiteMenuSection submenu={sub} iconSize={sub.id === 'nav-products' ? 32 : 24} />
							{sub.id === 'nav-customers' && <SiteMenuCustomers />}
							<SiteMenuPromos section={sub.id} />
						</div>
					)}
				</li>
			);
		})}
	</ul>

	{model === 'panel' && (
		<div class="sm__one" id="sm-one" data-sm-one hidden>
			<div class="sm__one-in">
				<ul class="sm__rail">
					{sections.map(({ item, sub }) => (
						<li>
							<button type="button" class="sm__rail-btn" data-sm-rail={sub.id} aria-current="false">
								{item.label}
								<Icon name="tabler:chevron-right" aria-hidden="true" />
							</button>
						</li>
					))}
				</ul>
				<div class="sm__one-body">
					{sections.map(({ item, sub }) => (
						<section class="sm__one-sec" data-sm-panel={sub.id} aria-label={item.label} hidden>
							<div class="sm__one-head">
								<h2 class="sm__one-title">{item.label}</h2>
								{item.href && (
									<a class="sm__all" href={item.href}>
										All {item.label.toLowerCase()}
										<Icon name="tabler:chevron-right" aria-hidden="true" />
									</a>
								)}
							</div>
							<SiteMenuSection submenu={sub} iconSize={sub.id === 'nav-products' ? 32 : 24} />
							{sub.id === 'nav-customers' && <SiteMenuCustomers />}
							<SiteMenuPromos section={sub.id} />
						</section>
					))}
				</div>
			</div>
		</div>
	)}

	<SiteMenuSheet />
</nav>

<script>
	import { lockScroll, unlockScroll } from '@util/scroll-lock';

	const nav = document.querySelector<HTMLElement>('nav.sm');
	if (nav) {
		const header = nav.closest<HTMLElement>('header.header');
		const triggers = [...nav.querySelectorAll<HTMLButtonElement>('[data-sm-trigger]')];
		const panels = [...nav.querySelectorAll<HTMLElement>('[data-sm-panel]')];
		const rails = [...nav.querySelectorAll<HTMLButtonElement>('[data-sm-rail]')];
		const one = nav.querySelector<HTMLElement>('[data-sm-one]');
		const sheet = nav.querySelector<HTMLElement>('[data-sm-sheet]');
		const toggle = header?.querySelector<HTMLButtonElement>('[data-sm-toggle]') ?? null;

		const desktop = () => matchMedia('(min-width: 1281px)').matches;
		const OPEN_DELAY = 120;
		const CLOSE_DELAY = 200;
		let openId: string | null = null;
		let openTimer = 0;
		let closeTimer = 0;

		// --- the desktop panels -------------------------------------------------------------------

		/** Keeps a dropdown inside the viewport: measured once shown, shifted by what overflows. */
		const nudge = (panel: HTMLElement) => {
			panel.style.removeProperty('--sm-shift');
			const r = panel.getBoundingClientRect();
			const over = r.right - (window.innerWidth - 16);
			const under = 16 - r.left;
			const shift = over > 0 ? -over : under > 0 ? under : 0;
			if (shift) panel.style.setProperty('--sm-shift', `${shift}px`);
		};

		const show = (id: string) => {
			if (!desktop()) return;
			window.clearTimeout(closeTimer);
			openId = id;
			triggers.forEach((t) => t.setAttribute('aria-expanded', String(t.dataset.smTrigger === id)));
			panels.forEach((p) => {
				p.hidden = p.dataset.smPanel !== id;
			});
			rails.forEach((r) => r.setAttribute('aria-current', String(r.dataset.smRail === id)));
			if (one) one.hidden = false;
			nav.setAttribute('data-open', id);
			header?.setAttribute('data-sm-desktop-open', '');
			const panel = panels.find((p) => p.dataset.smPanel === id);
			if (panel && !one) nudge(panel);
		};

		const hide = () => {
			window.clearTimeout(openTimer);
			window.clearTimeout(closeTimer);
			if (openId === null) return;
			openId = null;
			triggers.forEach((t) => t.setAttribute('aria-expanded', 'false'));
			panels.forEach((p) => {
				p.hidden = true;
			});
			if (one) one.hidden = true;
			nav.removeAttribute('data-open');
			header?.removeAttribute('data-sm-desktop-open');
		};

		const soon = (id: string) => {
			window.clearTimeout(openTimer);
			window.clearTimeout(closeTimer);
			// Something open already: switch at once, the way a reader sweeps along the row.
			if (openId !== null) show(id);
			else openTimer = window.setTimeout(() => show(id), OPEN_DELAY);
		};
		const later = () => {
			window.clearTimeout(openTimer);
			window.clearTimeout(closeTimer);
			closeTimer = window.setTimeout(hide, CLOSE_DELAY);
		};

		nav.querySelectorAll<HTMLElement>('[data-sm-item]').forEach((li) => {
			const id = li.dataset.smItem;
			if (!id) {
				// A plain link: sweeping onto it closes what a neighbour opened.
				li.addEventListener('mouseenter', later);
				return;
			}
			li.addEventListener('mouseenter', () => soon(id));
			li.addEventListener('mouseleave', later);
		});
		one?.addEventListener('mouseenter', () => window.clearTimeout(closeTimer));
		one?.addEventListener('mouseleave', later);

		triggers.forEach((t) =>
			t.addEventListener('click', () => {
				const id = t.dataset.smTrigger!;
				if (openId === id) hide();
				else show(id);
			})
		);
		rails.forEach((r) => {
			const id = r.dataset.smRail!;
			r.addEventListener('mouseenter', () => show(id));
			r.addEventListener('focus', () => show(id));
			r.addEventListener('click', () => show(id));
		});

		// Keyboard: Escape closes and puts focus back on the item; focus leaving the menu closes it.
		nav.addEventListener('keydown', (e) => {
			if (e.key !== 'Escape' || openId === null) return;
			const id = openId;
			e.preventDefault();
			hide();
			triggers.find((t) => t.dataset.smTrigger === id)?.focus();
		});
		nav.addEventListener('focusout', (e) => {
			const next = e.relatedTarget as Node | null;
			if (openId !== null && (!next || !nav.contains(next))) later();
		});
		document.addEventListener('pointerdown', (e) => {
			if (openId !== null && !nav.contains(e.target as Node)) hide();
		});

		// --- the phone sheet ----------------------------------------------------------------------

		const sheetOpen = () => !!sheet && !sheet.hidden;
		const openSheet = () => {
			if (!sheet) return;
			sheet.hidden = false;
			header?.setAttribute('data-sm-open', '');
			toggle?.setAttribute('aria-expanded', 'true');
			lockScroll('menu');
		};
		const closeSheet = () => {
			if (!sheet || !sheetOpen()) return;
			sheet.hidden = true;
			header?.removeAttribute('data-sm-open');
			toggle?.setAttribute('aria-expanded', 'false');
			unlockScroll('menu');
		};
		toggle?.addEventListener('click', () => (sheetOpen() ? closeSheet() : openSheet()));
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && sheetOpen()) {
				closeSheet();
				toggle?.focus();
			}
		});

		// Crossing the breakpoint closes whichever menu the other side had.
		matchMedia('(min-width: 1281px)').addEventListener('change', (q) => {
			if (q.matches) closeSheet();
			else hide();
		});
	}
</script>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	// ---------------------------------------------------------------------------------------------
	// THE TOKENS. One set for every surface; the grounds below reassign them.
	// ---------------------------------------------------------------------------------------------
	.sm {
		// The panels, the sheet and the dropdowns.
		--sm-ink: var(--color-text);
		--sm-soft: var(--color-text-secondary);
		--sm-accent: var(--color-primary);
		--sm-rule: var(--color-border);
		--sm-fill: color-mix(in srgb, var(--color-primary) 6%, transparent);
		--sm-fill-strong: color-mix(in srgb, var(--color-primary) 10%, transparent);
		--sm-surface: var(--color-bg-surface);
		--sm-shadow: var(--elev-panel);
		// The row in the bar: its ink, and the line under the open section.
		--sm-bar-ink: var(--color-text);
		--sm-bar-accent: var(--color-primary);
		// How far a product's hue is lifted toward white when it carries TEXT on a dark ground; its
		// mark is never lifted.
		--sm-lift: 0%;
		// The products' own colours — the products page's, the logos' — on every ground and in both
		// themes. Not the `--brand-*` tokens: those switch to pastels in the dark theme.
		--sm-brand-pe: #1f8b4d;
		--sm-brand-cloud: #2a7dec;
		--sm-brand-edge: #009688;
		--sm-brand-gateway: #7a4dc3;
		--sm-brand-mobile: #2a7dec;
		--sm-brand-tbmq: #1f8b4d;
		--sm-brand-trendz: #5555ff;

		display: flex;
		align-items: center;
		height: 100%;
	}

	// The dark theme: the same tokens resolve dark through the site's, and a product's text lifts.
	html[data-theme='dark'] .sm {
		--sm-lift: 35%;
	}

	// The docs bar is the sidebar's ground, not the surface; the panel is one piece with it.
	header.header:has([data-header-look='docs']) .sm {
		--sm-surface: var(--sl-color-bg-sidebar);
		--sm-rule: var(--sl-color-hairline-shade);
	}

	// Over a dark hero the bar is transparent and its ink white, a panel open or not, until the bar is
	// scrolled onto its surface or the sheet opens. The one panel takes a dark ground under that bar,
	// so the open menu is one piece with it rather than a white sheet hung under it.
	header.header:not([data-header-scrolled]):not([data-sm-open]):has([data-header-hero='dark']) .sm {
		--sm-bar-ink: #fff;
		--sm-bar-accent: #b3c7ff;

		.sm__one {
			--sm-ink: #fff;
			--sm-soft: rgba(255, 255, 255, 0.72);
			--sm-accent: #b3c7ff;
			--sm-rule: rgba(255, 255, 255, 0.12);
			--sm-fill: rgba(255, 255, 255, 0.08);
			--sm-fill-strong: rgba(255, 255, 255, 0.12);
			--sm-surface: rgba(8, 9, 14, 0.92);
			--sm-shadow: 0 24px 48px rgba(0, 0, 0, 0.4);
			--sm-lift: 35%;
		}
	}

	// And the bar itself takes the panel's ground while the panel is open, so there is no seam of hero
	// between the row and the menu. Stronger than a page's own scrim rule, which this must win over.
	header.header:not(.opened-burger):not([data-header-scrolled]):not([data-sm-open]):has(
			[data-header-hero='dark']
		)[data-sm-desktop-open] {
		background-color: rgba(8, 9, 14, 0.92);
	}

	// ---------------------------------------------------------------------------------------------
	// THE ROW
	// ---------------------------------------------------------------------------------------------
	.sm__row {
		display: flex;
		align-items: center;
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	// The one-panel row gravitates to the wordmark — a clear gap off it, then the items packed — and
	// the account cluster is pushed to the far side. The dropdowns keep the centred row they inherit.
	.sm[data-model='panel'] {
		margin-inline: 24px auto;
	}

	.sm__item {
		position: relative;
	}

	// An item is text in the bar's ink, not a button: no fill, no corner. Two kinds of line under it:
	// a PAGE (a link, or the page a section item also owns) is underlined in the ink, on hover and
	// while the reader is on it; an open SECTION is marked in the accent. The ink follows the bar —
	// white over a hero, the text ink once scrolled, and dark — so the row reads the same everywhere.
	.sm__top {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 2px;
		height: 40px;
		padding: 0 8px;
		border: 0;
		background: none;
		color: var(--sm-bar-ink);
		font: inherit;
		font-size: 15px;
		line-height: 1;
		white-space: nowrap;
		text-decoration: none;
		cursor: pointer;
		transition: color 0.15s ease;

		&::after {
			content: '';
			position: absolute;
			right: 8px;
			bottom: 5px;
			left: 8px;
			height: 2px;
			border-radius: 1px;
			background: currentColor;
			opacity: 0;
			transition:
				opacity 0.15s ease,
				background-color 0.15s ease;
		}

		&:hover {
			color: var(--sm-bar-ink);
		}

		&:focus-visible {
			outline: 2px solid currentColor;
			outline-offset: 2px;
			border-radius: 2px;
		}
	}

	// A page: the ink's line.
	a.sm__top:hover::after,
	a.sm__top[aria-current='page']::after,
	button.sm__top[data-current]::after {
		opacity: 1;
	}

	// An open section: the accent's line, over whatever the item's own would be.
	button.sm__top[aria-expanded='true']::after {
		background: var(--sm-bar-accent);
		opacity: 1;
	}

	.sm__top-chev {
		width: 14px;
		height: 14px;
		opacity: 0.55;
		transition:
			transform 0.2s ease,
			opacity 0.15s ease;

		.sm__top:hover > &,
		[aria-expanded='true'] > & {
			opacity: 1;
		}

		[aria-expanded='true'] > & {
			transform: rotate(180deg);
		}
	}

	// ---------------------------------------------------------------------------------------------
	// A SECTION'S CONTENT, on every surface
	// ---------------------------------------------------------------------------------------------
	.sm__groups {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 24px 32px;
	}

	.sm__group-name {
		margin: 0 0 6px;
		padding: 0 10px;
		font-size: 12px;
		font-weight: $font-weight-medium;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--sm-soft);
	}

	.sm__cols {
		display: grid;
		grid-template-columns: repeat(var(--cols, 1), minmax(176px, max-content));
		gap: 0 12px;
	}

	.sm__col {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.sm__link {
		display: flex;
		align-items: flex-start;
		gap: 12px;
		padding: 8px 10px;
		border-radius: $radius-lg;
		color: var(--sm-ink);
		text-decoration: none;
		transition: background-color 0.15s ease;

		&:hover,
		&:focus-visible {
			background: var(--sm-fill);
		}

		&:focus-visible {
			outline: 2px solid currentColor;
			outline-offset: -2px;
		}

		svg.nav-icon {
			flex: none;
			margin-top: 1px;
			color: var(--sm-accent);
		}

		&:hover .sm__link-heading {
			color: var(--sm-accent);
		}
	}

	.sm__link-text {
		display: flex;
		flex-direction: column;
		gap: 1px;
		min-width: 0;
	}

	.sm__link-heading {
		font-size: 15px;
		font-weight: $font-weight-medium;
		line-height: 1.4;
		transition: color 0.15s ease;
	}

	.sm__link-desc {
		font-size: 13px;
		line-height: 1.4;
		color: var(--sm-soft);
	}

	// A product's link carries its own colour: on its mark as it is, on its heading (hover) lifted
	// toward white where the ground is dark, so it stays the same hue and reads as text.
	.sm__link[data-product] {
		svg.nav-icon {
			color: var(--sm-brand);
		}

		&:hover .sm__link-heading {
			color: color-mix(in srgb, var(--sm-brand), #fff var(--sm-lift));
		}
	}
	.sm__link[data-product='pe'] {
		--sm-brand: var(--sm-brand-pe);
	}
	.sm__link[data-product='cloud'] {
		--sm-brand: var(--sm-brand-cloud);
	}
	.sm__link[data-product='edge'] {
		--sm-brand: var(--sm-brand-edge);
	}
	.sm__link[data-product='gateway'] {
		--sm-brand: var(--sm-brand-gateway);
	}
	.sm__link[data-product='mobile'] {
		--sm-brand: var(--sm-brand-mobile);
	}
	.sm__link[data-product='tbmq'] {
		--sm-brand: var(--sm-brand-tbmq);
	}
	.sm__link[data-product='trendz'] {
		--sm-brand: var(--sm-brand-trendz);
	}

	.sm__all {
		display: inline-flex;
		align-items: center;
		gap: 2px;
		font-size: 14px;
		font-weight: $font-weight-medium;
		color: var(--sm-accent);
		text-decoration: none;

		svg {
			width: 18px;
			height: 18px;
		}

		&:hover {
			text-decoration: underline;
			text-decoration-thickness: 1px;
			text-underline-offset: 3px;
		}

		&:focus-visible {
			outline: 2px solid currentColor;
			outline-offset: 2px;
			border-radius: 2px;
		}
	}

	// The featured slot: a tinted card to the Cloud sign-up.
	.sm__feat {
		display: grid;
		gap: 2px;
		padding: 14px 16px;
		border-radius: 12px;
		background: var(--sm-fill);
		color: var(--sm-ink);
		text-decoration: none;
		transition: background-color 0.15s ease;

		&:hover {
			background: var(--sm-fill-strong);
		}

		&:focus-visible {
			outline: 2px solid currentColor;
			outline-offset: 2px;
		}
	}

	.sm__feat-eyebrow {
		font-size: 12px;
		font-weight: $font-weight-medium;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--sm-accent);
	}

	.sm__feat-title {
		font-size: 16px;
		font-weight: $font-weight-bold;
		line-height: 1.3;
	}

	.sm__feat-text {
		font-size: 13px;
		line-height: 1.45;
		color: var(--sm-soft);
	}

	.sm__feat-cta {
		display: inline-flex;
		align-items: center;
		gap: 2px;
		margin-top: 6px;
		font-size: 14px;
		font-weight: $font-weight-medium;
		color: var(--sm-accent);

		svg {
			width: 18px;
			height: 18px;
		}
	}

	// ---------------------------------------------------------------------------------------------
	// MODEL A — DROPDOWNS: one panel under each item, kept inside the viewport by `--sm-shift`.
	// ---------------------------------------------------------------------------------------------
	.sm__drop {
		position: absolute;
		top: calc(100% + 8px);
		left: 50%;
		z-index: 5;
		display: grid;
		gap: 16px;
		// Sized by its content, capped by the viewport: a section with five columns is wide, and where
