---
import { Icon } from 'astro-icon/components';
import NavIcon from '@components/Landing/NavIcon.astro';
import { menuBadgeOf } from '@data/product-badges';
import { badgesIn } from '@components/SiteMenu/menu-model';
import type { SubMenu, SubMenuGroup } from '@data/navigation';
import { externalLinkAttrs, isExternalHref, newTabLinkLabel } from '@util/external-links';

/**
 * ONE SECTION OF THE MENU — a submenu's groups, each one list of its links — as every surface of
 * `SiteMenu` renders it: a dropdown, the one panel, the phone sheet. A list is one `<ul>` however
 * many columns it shows in, so a screen reader hears ten use cases rather than two lists of five; the
 * stylesheet folds it into columns of `--rows` (a CSS grid flowing down, then across), and the
 * surface decides whether it folds at all. This decides the markup, once.
 */
interface Props {
	submenu: SubMenu;
	/** Products and Docs draw their marks a step larger: they are the products' logos (`iconSizeOf`). */
	iconSize?: number;
	/** Each link's line under its name, where the section keeps it (`describes`). */
	describe?: boolean;
	/**
	 * A group name not to repeat: the sheet's view is headed by the section's name, so Company's
	 * own "Company" group goes unlabelled under it, and only "Partners" is named.
	 */
	omitName?: string;
}

const { submenu, iconSize = 24, describe = true, omitName } = Astro.props;
// A product's row draws its badge (Products, Docs); every other row its nav icon.
const badgeFor = (heading: string) => (badgesIn(submenu) ? menuBadgeOf(heading) : undefined);
const named = (name?: string) => !!name && name.toLowerCase() !== omitName?.toLowerCase();

/** Widest a group lays its columns out side by side. */
const MAX_COLUMNS = 3;

/**
 * The rows a group's list runs to before it starts the next column: `perColumn` from the nav data,
 * or the whole list in one column, and never more columns than `MAX_COLUMNS`.
 */
const rowsOf = ({ items, perColumn }: SubMenuGroup) =>
	Math.max(perColumn ?? items.length, Math.ceil(items.length / MAX_COLUMNS));

// A logo in the repo (the homepage strip's, `/src/assets/…`) is served by its built URL; any other
// (the case studies' CDN) as it is.
const logoUrls = import.meta.glob<string>('/src/assets/images/landings/customer-logo/*.svg', {
	query: '?url',
	import: 'default',
});
const logoSrc = async (src: string) => (logoUrls[src] ? await logoUrls[src]() : src);
const sections = await Promise.all(
	submenu.groups.map(async (group) => ({
		...group,
		items: await Promise.all(
			group.items.map(async (item) => ({
				...item,
				logo: item.logo ? await logoSrc(item.logo) : undefined,
				badge: badgeFor(item.heading),
			}))
		),
	}))
);
---

<div class="sm__groups" data-sm-section={submenu.id}>
	{sections.map((group) => (
		<div class="sm__group">
			{named(group.name) && <p class="sm__group-name">{group.name}</p>}
			<ul class="sm__cols" style={`--rows: ${rowsOf(group)}`}>
				{group.items.map((item) => (
					<li>
						<a
							class:list={['sm__link', item.linkClass]}
							href={item.href}
							aria-label={isExternalHref(item.href) ? newTabLinkLabel(item.heading, item.href) : undefined}
							{...externalLinkAttrs(item.href)}
						>
							{item.logo ? (
								<span class="sm__link-logo">
									{/* Lazy: the section is hidden until it opens, and then it is the only thing loading. */}
									<img
										src={item.logo}
										alt={item.heading}
										loading="lazy"
										decoding="async"
										style={item.logoHeight ? `--sm-logo-h: ${item.logoHeight}px` : undefined}
									/>
								</span>
							) : (
								<Fragment>
									{item.badge ? (
										<span class="sm__link-icon">
											<span
												class:list={[
													'sm__badge',
													`sm__badge--${item.badge.fill}`,
													item.badge.wide && 'sm__badge--wide',
												]}
												style={`--badge-hue: ${item.badge.hue}; --badge-glyph: ${item.badge.size}px`}
											>
												<NavIcon src={item.badge.glyph} size={item.badge.size} alt="" />
											</span>
										</span>
									) : (
										item.icon && (
											<span class="sm__link-icon">
												<NavIcon src={item.icon} size={iconSize} alt="" />
											</span>
										)
									)}
									<span class="sm__link-text">
										<span class="sm__link-heading">{item.heading}</span>
										{describe && item.description && <span class="sm__link-desc">{item.description}</span>}
									</span>
								</Fragment>
							)}
						</a>
					</li>
				))}
			</ul>
			{group.more && (
				<a class="sm__more" href={group.more.href}>
					{group.more.label}
					<Icon name="tabler:chevron-right" aria-hidden="true" />
				</a>
			)}
		</div>
	))}
</div>
