---
import { Icon } from 'astro-icon/components';
import Button from '@components/ui/Button.astro';
import SiteMenuSection from '@components/SiteMenu/SiteMenuSection.astro';
import { mainNavItems, allSubmenus } from '@data/navigation';

/**
 * THE PHONE SHEET, shared by both desktop models: below 1281 the menu is this, under the bar, the
 * height of the screen. Search at the top, as a field the width of the sheet; then the sections
 * as an accordion (`<details name>`, so one is open at a time where the browser knows the
 * attribute); the plain links between them; and under 600, where the bar has stepped its account
 * pair into the drawer, Sign in and Try for free pinned at the foot. No theme row: the theme
 * follows the system, and its switch is the footer's.
 */
const submenuById = (id?: string) => (id ? allSubmenus.find((s) => s.id === id) : undefined);
---

<div class="sm__sheet" id="sm-sheet" data-sm-sheet hidden>
	<div class="sm__sheet-top">
		{/* The dialog it opens is the bar's; any `<search-button>` on the page opens it. */}
		<search-button>
			<button type="button" class="sm__sheet-search" aria-label="Search">
				<Icon name="tabler:search" aria-hidden="true" />
				<span>Search</span>
			</button>
		</search-button>
	</div>

	<ul class="sm__sheet-list">
		{mainNavItems.map((item) => {
			const sub = submenuById(item.submenuId);
			return (
				<li class="sm__sheet-item">
					{sub ? (
						<details class="sm__acc" name="sm-sheet-sections">
							<summary class="sm__acc-sum">
								{item.label}
								<Icon name="tabler:chevron-down" class="sm__acc-chev" aria-hidden="true" />
							</summary>
							<div class="sm__acc-body">
								{item.href && (
									<a class="sm__all" href={item.href}>
										All {item.label.toLowerCase()}
										<Icon name="tabler:chevron-right" aria-hidden="true" />
									</a>
								)}
								<SiteMenuSection submenu={sub} />
							</div>
						</details>
					) : (
						<a class:list={['sm__sheet-link', item.linkClass]} id={item.id} href={item.href}>
							{item.label}
						</a>
					)}
				</li>
			);
		})}
	</ul>

	<div class="sm__sheet-foot">
		<Button
			variant="secondary"
			size="md"
			href="https://thingsboard.cloud/login"
			attrs={{ 'data-cloud-auth': 'signin', target: '_blank', rel: 'noopener noreferrer' }}
		>
			Sign in
		</Button>
		<Button variant="primary" size="md" to="cloud-signup">
			Try for free
		</Button>
	</div>
</div>
