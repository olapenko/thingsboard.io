---
import { Icon } from 'astro-icon/components';
import Button from '@components/ui/Button.astro';
import SiteMenuBody from '@components/SiteMenu/SiteMenuBody.astro';
import { MENU_ENTRIES, MENU_SECTIONS, isHere } from '@components/SiteMenu/menu-model';

/**
 * THE SHEET: the menu below 1281, under the bar, the height of the screen — the one panel at a
 * phone's width. The panel's rail becomes the first view, the sections and the plain links as one
 * list; a section opens as a view of its own showing what the panel shows for it (`SiteMenuBody`:
 * the heading and its "All …" page, the groups, the section's stories and promotions), with a row
 * back to the list. One view at a time, so a section is never a fold inside a long scroll, and
 * nothing in it is a step smaller than on the desktop.
 *
 * No search field: the bar above keeps its search control at every width, one tap from the open
 * sheet, and a second field under it was the same control twice. Under 600, where the bar has
 * stepped Sign in and Try for free out, the two sit at the foot. No theme row: the theme follows
 * the system, and its switch is the footer's.
 *
 * `SiteMenu`'s script drives it: the views, focus, Escape (back a view, then close), and the page
 * made inert underneath while it is open.
 */
const pathname = Astro.url.pathname;
---

<div class="sm__sheet" id="sm-sheet" data-sm-sheet data-view="root" hidden>
	<div class="sm__view sm__view--root" data-sm-view="root">
		<ul class="sm__list">
			{MENU_ENTRIES.map(({ item, sub }) => (
				<li>
					{sub ? (
						<button
							type="button"
							class="sm__sheet-row"
							data-sm-open-view={sub.id}
							aria-controls={`sm-sheet-${sub.id}`}
							data-current={isHere(pathname, item.href) || undefined}
						>
							{item.label}
							<Icon name="tabler:chevron-right" class="sm__sheet-chev" aria-hidden="true" />
						</button>
					) : (
						<a
							class:list={['sm__sheet-row', item.linkClass]}
							href={item.href}
							aria-current={isHere(pathname, item.href) ? 'page' : undefined}
						>
							{item.label}
						</a>
					)}
				</li>
			))}
		</ul>
	</div>

	{MENU_SECTIONS.map((entry) => (
		<section
			class="sm__view sm__view--sec"
			id={`sm-sheet-${entry.sub.id}`}
			data-sm-view={entry.sub.id}
			aria-labelledby={`sm-sheet-${entry.sub.id}-title`}
			hidden
		>
			<button type="button" class="sm__back" data-sm-back>
				<Icon name="tabler:chevron-left" aria-hidden="true" />
				Menu
			</button>
			<SiteMenuBody entry={entry} titleId={`sm-sheet-${entry.sub.id}-title`} />
		</section>
	))}

	<div class="sm__sheet-foot">
		<Button
			variant="secondary"
			size="md"
			href="https://thingsboard.cloud/login"
			attrs={{ 'data-cloud-auth': 'signin', target: '_blank', rel: 'noopener noreferrer' }}
		>
			Sign in
		</Button>
		<Button variant="primary" size="md" to="cloud-signup">
			Try for free
		</Button>
	</div>
</div>
