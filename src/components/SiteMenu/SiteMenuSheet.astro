---
import { Icon } from 'astro-icon/components';
import Button from '@components/ui/Button.astro';
import SiteMenuBody from '@components/SiteMenu/SiteMenuBody.astro';
import GitHubButton from '@components/Landing/GitHubButton.astro';
import { MENU_ENTRIES, MENU_SECTIONS, inSection, isHere } from '@components/SiteMenu/menu-model';
import type { Products } from '@models/site.models';

/**
 * THE SHEET: the menu below 1200, under the bar, the height of the screen — the one panel at a
 * phone's or a tablet's width. The row becomes a list, the sections and the plain links in one;
 * a section shows what the panel shows for it (`SiteMenuBody`: the heading and its "All …" page,
 * the groups, the section's stories and promotions).
 *
 * Two layouts of the same views, by the room (`MENU_SPLIT_QUERY`). On a phone, one view at a time:
 * the list, then a section as a view of its own with a row back, so a section is never a fold inside
 * a long scroll; every row runs edge to edge, and the step between views moves both at once, the
 * section over the list. On a tablet, SPLIT: the list stays as a sidebar and the section shows beside
 * it, opened with the sheet on the section the page is in (else the first), switched by a tap with
 * no step back; at 768 the list alone left half the screen empty and every section a screen away.
 *
 * Under the list, GitHub: the bar shows it only beside the row, so under 1200 this is where it is.
 *
 * No search field: where the page has search, the bar above keeps its control at every width, one
 * tap from the open sheet, and a second field under it would be the same control twice; where the
 * page has none (the homepage, the product pages), the menu has none either. Under 600, where the bar
 * has stepped Sign in and Try for free out, the two sit at the foot, the same links with the same
 * analytics names as the bar's (`_Sheet` on the ids, which must stay unique on the page). No theme
 * row: the theme follows the system, and its switch is the footer's.
 *
 * `SiteMenu`'s script drives it: the views, focus, Escape (on a phone back a view, then close; split,
 * close), and the page
 * made inert underneath while it is open. Without a script the bar's Menu is a link to the sheet,
 * which then lays every section out in one scroll (the `<noscript>` rule at the end).
 */
interface Props {
	/** The repository the GitHub link points at, as the bar's does. */
	gitHubPlatform?: Products;
}

const { gitHubPlatform } = Astro.props;
const pathname = Astro.url.pathname;
---

<div class="sm__sheet" id="sm-sheet" data-sm-sheet data-view="root" hidden>
	{/* The views share one cell and step sideways between each other; see `SiteMenu`'s styles. */}
	<div class="sm__views">
		<div class="sm__view sm__view--root" data-sm-view="root" data-pos="center">
			<ul class="sm__list">
				{MENU_ENTRIES.map(({ item, sub }) => (
					<li>
						{sub ? (
							<button
								type="button"
								class="sm__sheet-row"
								data-sm-open-view={sub.id}
								aria-controls={`sm-sheet-${sub.id}`}
								data-current={inSection(pathname, { item, sub }) || undefined}
							>
								{item.label}
								<Icon name="tabler:chevron-right" class="sm__sheet-chev" aria-hidden="true" />
							</button>
						) : (
							<a
								class:list={['sm__sheet-row', item.linkClass]}
								id={item.id ? `${item.id}_Sheet` : undefined}
								href={item.href}
								aria-current={isHere(pathname, item.href) ? 'page' : undefined}
							>
								{item.label}
							</a>
						)}
					</li>
				))}
			</ul>
			<div class="sm__sheet-more">
				<GitHubButton platform={gitHubPlatform} place="menu" />
			</div>
		</div>

		{MENU_SECTIONS.map((entry) => (
			<section
				class="sm__view sm__view--sec"
				id={`sm-sheet-${entry.sub.id}`}
				data-sm-view={entry.sub.id}
				aria-labelledby={`sm-sheet-${entry.sub.id}-title`}
				data-pos="right"
			>
				<button type="button" class="sm__back" data-sm-back>
					<Icon name="tabler:chevron-left" aria-hidden="true" />
					Menu
				</button>
				<SiteMenuBody entry={entry} titleId={`sm-sheet-${entry.sub.id}-title`} />
			</section>
		))}
	</div>

	<div class="sm__sheet-foot">
		<Button
			variant="secondary"
			size="md"
			href="https://thingsboard.cloud/login"
			attrs={{ 'data-cloud-auth': 'signin', target: '_blank', rel: 'noopener noreferrer' }}
		>
			Sign in
		</Button>
		<Button
			variant="primary"
			size="md"
			href="/installations/choose-region/"
			class="gtm_button"
			attrs={{ 'data-cloud-auth': 'signup', id: 'Menu_TryItNow_Sheet' }}
		>
			Try for free
		</Button>
	</div>

	{/* No script: the sheet is the target of the bar's Menu link (`HeaderContent`), shown with every
	    view stacked in one scroll; a section's row and its back row, which need the script, go. */}
	<noscript>
		<a class="sm__sheet-row sm__nojs-close" href="#">
			Close the menu
		</a>
	</noscript>
</div>

<noscript>
	<style is:inline>
		header.header .burger[data-sm-toggle],
		.sm__row {
			display: none !important;
		}
		header.header .sm__nojs {
			display: flex !important;
		}
		#sm-sheet:target {
			display: flex !important;
		}
		#sm-sheet .sm__views {
			display: block;
			overflow-y: auto;
		}
		#sm-sheet .sm__view {
			overflow: visible;
			translate: none !important;
			opacity: 1 !important;
			visibility: visible !important;
		}
		#sm-sheet [data-sm-open-view],
		#sm-sheet .sm__back {
			display: none;
		}
		#sm-sheet > noscript {
			display: block;
			order: -1;
			border-bottom: 1px solid var(--sm-rule);
		}
	</style>
</noscript>
