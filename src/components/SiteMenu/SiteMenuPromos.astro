---
import { Icon } from 'astro-icon/components';
import { MENU_FEATURED, MENU_PRODUCT_PROMOS } from '@data/menu-featured';

/**
 * THE FOOT OF THE PRODUCTS SECTION, on every surface that shows it: Pricing and Installation options
 * as two promotions, and the Cloud card beside them. Styled by `SiteMenu` under `sm__promo`.
 */
---

<div class="sm__promos">
	{MENU_PRODUCT_PROMOS.map((p) => (
		<a class="sm__promo" href={p.href} id={p.id}>
			<Icon name={p.icon} class="sm__promo-icon" aria-hidden="true" />
			<span class="sm__promo-text">
				<span class="sm__promo-title">{p.title}</span>
				<span class="sm__link-desc">{p.text}</span>
			</span>
		</a>
	))}
	<a class="sm__feat" href={MENU_FEATURED.href} {...MENU_FEATURED.attrs}>
		<span class="sm__feat-eyebrow">{MENU_FEATURED.eyebrow}</span>
		<span class="sm__feat-title">{MENU_FEATURED.title}</span>
		<span class="sm__feat-text">{MENU_FEATURED.text}</span>
		<span class="sm__feat-cta">
			{MENU_FEATURED.cta}
			<Icon name="tabler:chevron-right" aria-hidden="true" />
		</span>
	</a>
</div>
