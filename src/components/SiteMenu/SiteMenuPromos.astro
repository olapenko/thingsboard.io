---
import { Icon } from 'astro-icon/components';
import { MENU_SECTION_PROMOS } from '@data/menu-featured';

/**
 * THE FOOT OF A SECTION that promotes something (`data/menu-featured`): one row of one-line tiles,
 * an icon and a title each, the featured one in the accent. Renders nothing for a section without
 * promotions. Styled by `SiteMenu` under `sm__promo`.
 */
interface Props {
	section: string;
}

const { section } = Astro.props;
const promos = MENU_SECTION_PROMOS[section] ?? [];
---

{promos.length > 0 && (
	<div class="sm__promos">
		{promos.map((p) => (
			<a class:list={['sm__promo', p.featured && 'sm__promo--feat']} href={p.href} id={p.id} {...p.attrs}>
				<Icon name={p.icon} class="sm__promo-icon" aria-hidden="true" />
				<span class="sm__promo-title">{p.title}</span>
				{p.featured && <Icon name="tabler:chevron-right" class="sm__promo-chev" aria-hidden="true" />}
			</a>
		))}
	</div>
)}
