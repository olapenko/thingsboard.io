---
import FooterMap from '@components/Landing/FooterMap.astro';
import FooterDocs from '@components/SiteFooter/FooterDocs.astro';

/**
 * THE SITE'S FOOTER, at a density. One component the switchboard (`starlight/Footer.astro`) renders
 * for every page that has moved onto the kit, each density on the same data (`data/footer-map`) and
 * ending on the same base row (`FooterBase`):
 *
 * - `map`: the footer that maps the platform — the brand row with the newsletter, the two ways to
 *   run it and the products around it, four link columns, the base row. The redesigned pages' footer.
 * - `docs`: the documentation's — the brand row with the follow line, three short columns and the
 *   base row with the Appearance switch, spanning the content pane under the sidebar's edge.
 *
 * Two densities and no third. Main's `Landing/Footer` is retired: every page `BaseLayout` renders
 * takes `map`.
 */
interface Props {
	density: 'map' | 'docs';
	/** The element's id. Only the page's own footer takes one (`footer`); the sandbox's several do not. */
	id?: string;
	/** The Appearance switch in the base row. Defaults to whether the page follows the theme. */
	appearance?: boolean;
}

const { density, id, appearance } = Astro.props;
---

{density === 'map' ? <FooterMap id={id} appearance={appearance} /> : <FooterDocs id={id} appearance={appearance} />}
