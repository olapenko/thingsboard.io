---
/**
 * PREVIEW ONLY — `feat/wide-measure`. A switch for `--page-measure` (`_theme.scss`), so the measure
 * can be judged on the real pages rather than argued about. BaseLayout renders it in dev only, and
 * it goes before the branch is proposed.
 *
 * The choice is kept per browser (localStorage) so it follows from page to page, and `?measure=`
 * sets it from a link. Guides draws the current measure's edges, with the old 960 dashed.
 */
const MEASURES = [960, 1040, 1080, 1120, 1200];
---

<script is:inline>
	// Before the page's content is parsed, so nothing lays out at one width and jumps to another.
	(() => {
		const root = document.documentElement;
		let v = new URLSearchParams(location.search).get('measure');
		try {
			if (v) localStorage.setItem('tb-measure-preview', v);
			else v = localStorage.getItem('tb-measure-preview');
		} catch {}
		if (v && /^\d{3,4}$/.test(v)) root.style.setProperty('--page-measure', v + 'px');
	})();
</script>

<div class="mp" role="group" aria-label="Page measure (preview)" data-measure-preview>
	<span class="mp__label">Measure</span>
	{MEASURES.map((m) => (
		<button type="button" class="mp__btn" data-m={m} aria-pressed="false">
			{m}
		</button>
	))}
	<button type="button" class="mp__btn mp__btn--guides" data-guides aria-pressed="false">
		Guides
	</button>
</div>
<div class="mp-guides" aria-hidden="true" hidden>
	<i class="mp-guides__edge mp-guides__edge--l"></i>
	<i class="mp-guides__edge mp-guides__edge--r"></i>
	<i class="mp-guides__old mp-guides__old--l"></i>
	<i class="mp-guides__old mp-guides__old--r"></i>
</div>

<script is:inline>
	(() => {
		const root = document.documentElement;
		const bar = document.querySelector('[data-measure-preview]');
		const guides = document.querySelector('.mp-guides');
		if (!bar || !guides) return;
		const store = (k, v) => {
			try {
				v == null ? localStorage.removeItem(k) : localStorage.setItem(k, v);
			} catch {}
		};
		const read = (k) => {
			try {
				return localStorage.getItem(k);
			} catch {
				return null;
			}
		};
		const sync = () => {
			const now = parseInt(getComputedStyle(root).getPropertyValue('--page-measure'), 10);
			bar.querySelectorAll('[data-m]').forEach((b) => b.setAttribute('aria-pressed', String(+b.dataset.m === now)));
			const on = !guides.hidden;
			bar.querySelector('[data-guides]').setAttribute('aria-pressed', String(on));
		};
		bar.addEventListener('click', (e) => {
			const b = e.target.closest('button');
			if (!b) return;
			if (b.hasAttribute('data-guides')) {
				guides.hidden = !guides.hidden;
				store('tb-measure-guides', guides.hidden ? null : '1');
			} else {
				root.style.setProperty('--page-measure', b.dataset.m + 'px');
				store('tb-measure-preview', b.dataset.m);
				const url = new URL(location.href);
				url.searchParams.set('measure', b.dataset.m);
				history.replaceState(history.state, '', url);
				// Components that measure themselves (the hero, the step bar, the logo loop) listen for this.
				window.dispatchEvent(new Event('resize'));
			}
			sync();
		});
		if (read('tb-measure-guides')) guides.hidden = false;
		sync();
	})();
</script>

<style lang="scss">
	.mp {
		position: fixed;
		z-index: 2147483000;
		bottom: 16px;
		left: 16px;
		display: flex;
		align-items: center;
		gap: 2px;
		padding: 4px;
		border-radius: 999px;
		background: rgb(17 18 23 / 0.92);
		box-shadow: 0 6px 24px rgb(0 0 0 / 0.25);
		font:
			500 12px/1 system-ui,
			sans-serif;
		color: #fff;
		backdrop-filter: blur(8px);
	}

	.mp__label {
		padding: 0 8px 0 10px;
		opacity: 0.6;
	}

	.mp__btn {
		all: unset;
		box-sizing: border-box;
		height: 28px;
		padding: 0 10px;
		border-radius: 999px;
		cursor: pointer;
		font-variant-numeric: tabular-nums;

		&:hover {
			background: rgb(255 255 255 / 0.12);
		}

		&[aria-pressed='true'] {
			background: #fff;
			color: #111217;
		}

		&:focus-visible {
			outline: 2px solid #7fb2ff;
			outline-offset: 1px;
		}
	}

	.mp__btn--guides {
		margin-left: 6px;
		box-shadow: inset 1px 0 0 rgb(255 255 255 / 0.15);
		border-radius: 0 999px 999px 0;

		&[aria-pressed='true'] {
			border-radius: 999px;
			box-shadow: none;
		}
	}

	.mp-guides {
		position: fixed;
		z-index: 2147482999;
		inset: 0;
		pointer-events: none;

		&[hidden] {
			display: none;
		}
	}

	.mp-guides__edge,
	.mp-guides__old {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 0;
	}

	.mp-guides__edge {
		border-left: 1px solid rgb(255 0 128 / 0.55);
	}

	.mp-guides__old {
		border-left: 1px dashed rgb(0 140 255 / 0.6);
	}

	.mp-guides__edge--l {
		left: calc(50% - min(var(--page-measure), 100% - 40px) / 2);
	}

	.mp-guides__edge--r {
		left: calc(50% + min(var(--page-measure), 100% - 40px) / 2);
	}

	.mp-guides__old--l {
		left: calc(50% - min(960px, 100% - 40px) / 2);
	}

	.mp-guides__old--r {
		left: calc(50% + min(960px, 100% - 40px) / 2);
	}

	@media (max-width: 767px) {
		.mp {
			display: none;
		}
	}
</style>
