---
import { CHAT_HUE_VARS, CHAT_LAUNCHER, LAUNCHER_BOX } from '@data/chat-widget';

/**
 * CANDIDATE (2026-10-01): the YourGPT chat in the site's colours, with the AI mark's colour cycle.
 *
 * One stylesheet for the widget wherever it renders: FLOATING, in their `#yourgpt_root`, chosen by
 * `data-chat-skin` on the root element; and MOUNTED (`widget:mount`) inside an element of ours that
 * carries `data-chat-mount` and its own `data-chat-skin`, which is how the sandbox's stages show four
 * skins on one page with one widget. Render this once per page, before anything that cycles: it
 * declares the hues and the keyframes `ChatLauncher` animates as well.
 *
 * EVERY SKIN, FOR THE SANDBOX. The pages render `ChatSkinInUse`, the same rules for `CHAT_SKIN`
 * alone: the other three skins and the mounted chat's dashboard look are 14 KB that no page but the
 * chat workbench can show. Both draw from `styles/_chat-skin.scss`, so a change to a skin is made
 * once.
 *
 * SPECIFICITY. Their rules are styled-components classes, some nested two deep, injected after ours;
 * every rule here is scoped by `:is(<floating scope>, <mounted scope>)`, which takes the specificity
 * of its heaviest argument — an id — for both, so one selector outranks theirs in either place.
 * `!important` only where their dashboard's own `widget_css` uses it (the font).
 *
 * WHAT CYCLES. `--chat-hue`, a registered colour, runs the mark's cycle on the WINDOW'S FRAME and is
 * read by everything inside it — the header's wash, the avatar tile, the glow. Their own colours stay
 * still: they are HSL triplets (`hsl(var(--…Hsl))`), and a triplet cannot be derived from an animated
 * colour, so the bubbles, the send button and the focus rings take the brand blue.
 */

const launcherBox = LAUNCHER_BOX[CHAT_LAUNCHER.size ?? 'large'];
---

{/* The hues and the clock, on the root: a launcher anywhere on the page and a window in their root both read them. */}
{/* The launcher in use's box beside them, which sets where their floating window opens. */}
<style
	set:html={`:root { ${CHAT_HUE_VARS}; --chat-launcher-tile: ${launcherBox.tile}px; --chat-launcher-inset: ${launcherBox.inset}px; }`}
></style>

<style lang="scss" is:global>
	// Every skin, in the order the sandbox's stages compare them (`styles/_chat-skin.scss`).
	@use '../../styles/chat-skin' as *;

	@include chat-skins(('yourgpt', 'wash', 'fullwash', 'dark'));
</style>
