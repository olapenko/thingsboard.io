---
import { CHAT_HUE_VARS, CHAT_LAUNCHER, CHAT_SKIN, LAUNCHER_BOX } from '@data/chat-widget';

/**
 * The chat's skin as every page runs it: `CHAT_SKIN` alone, floating in their `#yourgpt_root`.
 *
 * `ChatSkin` draws every skin, because the sandbox's chat workbench shows four on one page, mounted;
 * shipped on every page, that was 14 KB of CSS for skins no page can show. This is the same rules
 * (`styles/_chat-skin.scss`) for the skin in use, and the same hues and clock on the root, so it
 * holds what `ChatLauncher` needs as well. Render it once per page, before anything that cycles.
 */

// The sheet below names its skin, which SCSS cannot read from `CHAT_SKIN`: the two change together.
if (CHAT_SKIN !== 'wash') {
	throw new Error(`ChatSkinInUse: CHAT_SKIN is "${CHAT_SKIN}", but this sheet draws "wash"; change its @include too.`);
}

const launcherBox = LAUNCHER_BOX[CHAT_LAUNCHER.size ?? 'large'];
---

{/* The hues and the clock, on the root: a launcher anywhere on the page and a window in their root both read them. */}
{/* The launcher in use's box beside them, which sets where their floating window opens. */}
<style
	set:html={`:root { ${CHAT_HUE_VARS}; --chat-launcher-tile: ${launcherBox.tile}px; --chat-launcher-inset: ${launcherBox.inset}px; }`}
></style>

<style lang="scss" is:global>
	@use '../../styles/chat-skin' as *;

	@include chat-skins('wash');
</style>
