---
import SiteFooter from '@components/SiteFooter/SiteFooter.astro';
import InternalNav from '@root/pages/internal/_InternalNav.astro';
import LegacyFooter from '@root/pages/internal/_LegacyFooter.astro';
import { HOME_COMPOSITIONS, REFERENCE_COMPOSITION, SHIPPING_COMPOSITION } from '@data/home-compositions';

// The switchboard in front of Starlight's footer slot: the documentation gets `SiteFooter` at its
// `docs` density, a page rendered through `BaseLayout` (`Astro.locals.bsl`) the `map` density.
const locals = Astro.locals as unknown as Record<string, unknown>;
const isBaseStarlight = locals.bsl === true;

// LAB ONLY. The sandbox's island on every page the site renders — docs, marketing, the redesigned
// pages — so Homepages, Chrome and the Design system are one tap away wherever a review is standing.
// This switchboard is where it mounts because every Starlight page passes through it; the internal
// pages mount their own from `PlaygroundLayout`. On a homepage the island grows the running-order
// switch: `/` is the shipping order, `/internal/homepages/<id>/` the one named.
const pathname = Astro.url.pathname;
const orderMatch = pathname.match(/^\/internal\/homepages\/([^/]+)\/$/);
const homepage =
	pathname === '/'
		? SHIPPING_COMPOSITION
		: orderMatch && HOME_COMPOSITIONS.some((c) => c.id === orderMatch[1])
			? orderMatch[1]
			: undefined;

// LAB ONLY. Main's footer (`Landing/Footer`, retired from handoff, kept here as `_LegacyFooter`) for
// the two places that show what main ships: the `live` reference order, and the footer workbench's
// `site` stage.
const legacy =
	(homepage === REFERENCE_COMPOSITION && pathname !== '/') || pathname === '/internal/chrome/stage/footer/site/';
---

{isBaseStarlight ? legacy ? <LegacyFooter /> : <SiteFooter density="map" id="footer" /> : <SiteFooter density="docs" />}
<InternalNav homepage={homepage} />
