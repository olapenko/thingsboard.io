---
import DocFooter from '~/components/starlight/DocFooter.astro';
import LandingFooter from '~/components/Landing/Footer.astro';
import FooterMap from '@components/Landing/FooterMap.astro';
import InternalNav from '@root/pages/internal/_InternalNav.astro';
import { HOME_COMPOSITIONS, SHIPPING_COMPOSITION } from '@data/home-compositions';

// Proxy in front of the actual Starlight footer chrome. Pages
// rendered through `BaseLayout` set `Astro.locals.bsl = true`
// to opt into the marketing footer (`Landing/Footer`); everything else
// gets the docs footer (`DocFooter`). Each branch is a separate
// component so only the styles of the chosen variant land in the
// route's CSS bundle — there's no per-page cost for the unused one.
//
// A page can ask for the footer that maps the platform instead (`footer="map"` on BaseLayout, read
// here as `bslFooter`): the homepage does, for the running orders that carry it (A and B). It gets
// the `footer` id the one in use has, which the sandbox hub's "Homepage ↗" link lands on.
const locals = Astro.locals as unknown as Record<string, unknown>;
const isBaseStarlight = locals.bsl === true;
const footerMap = locals.bslFooter === 'map';

// LAB ONLY. The sandbox's island on every page the site renders — docs, marketing, the redesigned
// pages — so Homepages, Chrome and the Design system are one tap away wherever a review is standing.
// This switchboard is where it mounts because every Starlight page passes through it; the internal
// pages mount their own from `PlaygroundLayout`. On a homepage the island grows the running-order
// switch: `/` is the shipping order, `/internal/homepages/<id>/` the one named.
const pathname = Astro.url.pathname;
const orderMatch = pathname.match(/^\/internal\/homepages\/([^/]+)\/$/);
const homepage =
	pathname === '/'
		? SHIPPING_COMPOSITION
		: orderMatch && HOME_COMPOSITIONS.some((c) => c.id === orderMatch[1])
			? orderMatch[1]
			: undefined;
---

{isBaseStarlight ? footerMap ? <FooterMap id="footer" /> : <LandingFooter /> : <DocFooter />}
<InternalNav homepage={homepage} />
