---
import HeaderContent from '../Landing/HeaderContent.astro';
import PromoBanner from '../PromoBanner.astro';
import { Products } from '@models/site.models';
import { resolveHeaderConfig, type HeaderConfig } from '@util/header-config';

const pathname = Astro.url.pathname;

function getGitHubPlatform(path: string): Products {
	if (path.includes('/docs/iot-gateway/')) return Products.GW;
	if (path.includes('/docs/edge/pe/') || path.includes('/docs/edge/')) return Products.EDGE;
	return Products.CE;
}

const locals = Astro.locals as unknown as Record<string, unknown>;

// `BaseLayout` passes the page's product via Astro.locals so the GitHub button
// targets the right repo; everywhere else the platform is inferred from the URL
// (docs routes carry the product as a path prefix).
const override = locals.bslGitHubPlatform as Products | undefined;
const gitHubPlatform = override ?? getGitHubPlatform(pathname);

// Docs / Starlight pages don't pass through BaseLayout, so no header config is
// present → fall back to the default `docs` look.
const headerConfig = (locals.bslHeaderConfig as HeaderConfig | undefined) ?? resolveHeaderConfig();

// Homepage facelift. Gated on the route so the other ~630 pages — docs
// included — keep the header and promo banner they have today.
//
// `/products/paas/` joins it as the second page rebuilt on the candidate design. It opens on the
// same split hero, and the old bar above it read as a different site: a smaller logo, "Try it now"
// rather than "Try for free", no Sign in region and the promo banner pushing the whole thing down.
// This is the list to add to as more pages move over, and the set is the extension point the route
// gate was written to have.
const HOME_NAV_ROUTES = new Set(['/', '/products/paas/']);
const isHome = HOME_NAV_ROUTES.has(pathname);
---

{
	/* Skipping the markup isn't enough: the component's `--promo-h: 40px` still
	   ships with the page CSS, leaving a 40px band and pushing the fixed header
	   down. Reset it the same way PromoBanner does when it has no slides. */
	isHome ? <style is:inline set:html=":root{--promo-h:0px;--promo-anim:none}" /> : <PromoBanner />
}
<HeaderContent gitHubPlatform={gitHubPlatform} headerConfig={headerConfig} homeNav={isHome} />
