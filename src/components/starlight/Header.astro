---
import HeaderContent from '../Landing/HeaderContent.astro';
import PromoBanner from '../PromoBanner.astro';
import { Products } from '@models/site.models';
import { resolveHeaderConfig, type HeaderConfig } from '@util/header-config';

const pathname = Astro.url.pathname;

function getGitHubPlatform(path: string): Products {
	if (path.includes('/docs/iot-gateway/')) return Products.GW;
	if (path.includes('/docs/edge/pe/') || path.includes('/docs/edge/')) return Products.EDGE;
	return Products.CE;
}

const locals = Astro.locals as unknown as Record<string, unknown>;

// `BaseLayout` passes the page's product via Astro.locals so the GitHub button
// targets the right repo; everywhere else the platform is inferred from the URL
// (docs routes carry the product as a path prefix).
const override = locals.bslGitHubPlatform as Products | undefined;
const gitHubPlatform = override ?? getGitHubPlatform(pathname);

// Docs / Starlight pages don't pass through BaseLayout, so no header config is
// present → fall back to the default `docs` look.
const headerConfig = (locals.bslHeaderConfig as HeaderConfig | undefined) ?? resolveHeaderConfig();

// Homepage facelift. Gated on the route so the other ~630 pages — docs
// included — keep the header and promo banner they have today.
//
// `/products/paas/` and `/products/thingsboard-pe/` join it as the pages rebuilt on the candidate
// design. Both open on the same split hero, and the old bar above one read as a different site: a
// smaller logo, "Try it now" rather than "Try for free", no Sign in region and the promo banner
// pushing the whole thing down. This is the list to add to as more pages move over, and the set is
// the extension point the route gate was written to have.
const HOME_NAV_ROUTES = new Set(['/', '/products/paas/', '/products/thingsboard-pe/']);
const isHome = HOME_NAV_ROUTES.has(pathname);
---

{
	/* ---------------------------------------------------------------------------
	 * TEMPORARY — REMOVE BEFORE PRODUCTION (see also _InternalNav.astro)
	 *
	 * The facelift routes used to skip the promo banner outright: it pushed the
	 * whole bar down and the split hero was designed without it. The banner now
	 * carries the AI announcements, so the hero has to be judged WITH it rather
	 * than beside it — its 40px is part of the fold budget the hero measures
	 * against (`--promo-h`, read by #hero.split's max-height).
	 *
	 * `data-temp-no-banner` on <html> takes it back out at runtime so the two can
	 * be compared without a rebuild; the internal strip writes it. Deleting this
	 * block, the inline script below and the toggle in _InternalNav returns the
	 * banner to whatever the production decision turns out to be.
	 * --------------------------------------------------------------------------- */
	isHome && (
		<script
			is:inline
			set:html="try{if(sessionStorage.getItem('tb-temp-no-banner')==='1')document.documentElement.dataset.tempNoBanner='1'}catch(e){}"
		/>
	)
}
{
	/* Skipping the markup isn't enough: the component's `--promo-h: 40px` still
	   ships with the page CSS, leaving a 40px band and pushing the fixed header
	   down. Reset it the same way PromoBanner does when it has no slides. */
	<PromoBanner />
}
<style is:inline set:html={`:root[data-temp-no-banner]{--promo-h:0px;--promo-anim:none}:root[data-temp-no-banner] #promo-banner{display:none}`} />
<HeaderContent gitHubPlatform={gitHubPlatform} headerConfig={headerConfig} homeNav={isHome} />
