---
import { Icon } from 'astro-icon/components';

/**
 * The cookie notice, brushed up, as every page renders it through `BaseLayout` since 2026-10-01:
 * `layout="bar" tone="dark" copy="short" titleLink textSize="small"`. It replaced `CookieBanner.astro`,
 * which stays as the before at `/internal/flows/cookie-notice/`, where every direction is judged.
 *
 * The dismissal is read from the same cookie the old banner wrote (`cookie-notice-dismissed=true`),
 * so nobody who closed the old one sees this one.
 *
 * WHAT THE OLD ONE GOT WRONG, measured on the homepage at 1440x900 and 375x812:
 * - It is set in the system face, not Ubuntu, so it reads as a third-party widget on the page.
 * - Its blue (#1a6fd4) is not the site's; the hero's "Try for free" beside it is #3d50f5.
 * - Two buttons that do the same thing: Accept and the close both set the same cookie.
 * - On a phone it is 213px of a 812px screen (26%), title over five lines over two buttons, set at
 *   13px — under the 14px floor the type ladder sets for page text.
 * - It runs under the chat launcher (50px, 20px in from the bottom-right corner on desktop and
 *   phone alike, above it in z): at 1280 the launcher covers its close; at 1440 it misses by 15px.
 * - Translucent glass over the homepage's footage, so its ground changes as the footage plays.
 *
 * WHAT THIS ONE DOES: the site's face and type roles (`type-small` copy, `type-tile` title), the
 * hero's button (brand fill, 700, 44px, 4px corners), a solid ground in one of two tones, one
 * action, the bottom-right corner left to the launcher, a 200ms rise in and a fade out (none under
 * reduced motion). `layout` is what the sandbox compares:
 *
 * - `bar`  — edge to edge at the foot of the window, the copy at the content width, Accept at the
 *            end of the line. Today's shape.
 * - `card` — a card in the bottom-left corner, 400px wide on desktop, the gutter's width in from
 *            the screen's edges on a phone. The page stays visible around it.
 *
 * THE WORDS. `copy="shipped"` is today's sentence, verbatim. `copy="short"` is a DRAFT, not legal's
 * words: it keeps the three things the sentence says — why the cookies (security, experience), that
 * browsing on is agreeing, and the link to the policy — and drops the pointer to browser settings,
 * which the Cookie Policy page itself covers ("you may configure your browser…"). It is what lets
 * the bar hold one line on desktop and the card three on a phone.
 *
 * STILL A NOTICE, NOT A CHOICE: there is no Reject and no settings, as there are none today. Adding
 * them is a consent decision for whoever owns the policy, not a brush-up.
 */
export type CookieLayout = 'bar' | 'card';
export type CookieTone = 'light' | 'dark';
export type CookieCopy = 'shipped' | 'short';

interface Props {
	layout?: CookieLayout;
	tone?: CookieTone;
	copy?: CookieCopy;
	/**
	 * The heading over the copy. The card carries one by default and the bar does not: on one line,
	 * "Cookie policy Our website uses…" reads as a run-on, and the link already names the policy.
	 */
	title?: boolean;
	/**
	 * The heading IS the link to the Cookie Policy page, with a chevron after it, and the policy's
	 * name in the sentence goes back to plain text — one link to the page, not two. The heading then
	 * stays on a phone too, since it is where the link lives.
	 */
	titleLink?: boolean;
	/**
	 * The sentence's size. `base` is the ladder's `type-small`, 14/22, the floor it sets for page
	 * text; `small` is 13/20, a step under it, for a notice that is chrome rather than page.
	 */
	textSize?: 'base' | 'small';
	/**
	 * Sandbox only: always shown on load, and Accept hides it without writing the cookie, so trying
	 * a direction never dismisses the real notice on the rest of the site.
	 */
	demo?: boolean;
	/** Draft only: a second instance on the same page needs its own id. */
	id?: string;
}

const {
	layout = 'card',
	tone = 'light',
	copy = 'shipped',
	titleLink = false,
	textSize = 'base',
	title = layout === 'card' || titleLink,
	demo = false,
	id = 'cookie-notice',
} = Astro.props;

const COPY: Record<CookieCopy, { title: string; text: string }> = {
	shipped: {
		title: 'Cookie policy',
		text: 'Our website uses cookies to ensure site security and optimize your experience. By continuing to browse this site, you agree to the use of these cookies, in accordance with our {link}. For details on managing cookies, please adjust your browser settings.',
	},
	short: {
		title: 'Cookies',
		text: 'We use cookies to keep this site secure and improve your experience. By continuing to browse, you agree to our {link}.',
	},
};

const words = COPY[copy];

/**
 * The sentence is rendered from a STRING, not from template children: Astro keeps the whitespace
 * between children and Prettier puts each on its own line, which leaks a space between the link and
 * the full stop after it (the same fix as `DocsNotice`).
 */
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const [before, after = ''] = words.text.split('{link}', 2);
const POLICY_HREF = '/cookie-policy/';
const policy = titleLink ? 'Cookie Policy' : `<a class="cn__link" href="${POLICY_HREF}">Cookie Policy</a>`;
const textHtml = `${esc(before)}${policy}${esc(after)}`;
// Linked, the heading names the page it goes to, whichever sentence runs under it.
const heading = titleLink ? 'Cookie policy' : words.title;
---

<aside
	class="cn"
	id={id}
	data-cn
	data-layout={layout}
	data-tone={tone}
	data-size={textSize}
	data-title-link={titleLink ? '' : undefined}
	data-cn-demo={demo ? '' : undefined}
	aria-label="Cookie notice"
	hidden
>
	<div class="cn__in">
		<div class="cn__copy">
			{
				title && (
					<p class="cn__title">
						{titleLink ? (
							<a class="cn__head-link" href={POLICY_HREF}>
								{heading}
								<Icon name="tabler:chevron-right" aria-hidden="true" />
							</a>
						) : (
							heading
						)}
					</p>
				)
			}
			<p class="cn__text" set:html={textHtml} />
		</div>
		<button type="button" class="cn__accept" data-cn-accept>Accept</button>
	</div>
</aside>

{
	/* Inline and right after the notice, so it runs before first paint: a visitor who dismissed it
	   never sees it flash, and one who has not sees it with the page. It finds its own notice as the
	   element before it, so a page holding several (the sandbox) runs one script per notice. */
}
<script is:inline>
	(function (el) {
		if (!el) return;
		const demo = el.hasAttribute('data-cn-demo');
		const COOKIE = 'cookie-notice-dismissed';
		if (demo || !new RegExp('(?:^|; )' + COOKIE + '=true(?:;|$)').test(document.cookie)) el.hidden = false;

		el.addEventListener('click', function (e) {
			if (!e.target.closest('[data-cn-accept]')) return;
			if (!demo) document.cookie = COOKIE + '=true; max-age=31536000; path=/; SameSite=Lax';
			const done = function () {
				el.hidden = true;
				el.removeAttribute('data-cn-leaving');
			};
			if (matchMedia('(prefers-reduced-motion: reduce)').matches) return done();
			el.setAttribute('data-cn-leaving', '');
			setTimeout(done, 160);
		});
	})(document.currentScript && document.currentScript.previousElementSibling);
</script>

<style lang="scss">
	@use '../styles/variables' as *;

	// ---- Tone -------------------------------------------------------------------------------
	//
	// Solid in both. LIGHT is the page's own surface, lifted off it by a hairline and the shadow
	// ink the UI pass settled on (16,24,40): over the homepage's black hero it is the brightest thing
	// on screen, over a white docs page the shadow carries it. DARK is the bookends' indigo
	// (#121425), not black, so the brand-blue button sits on a ground of its own family; the copy is
	// white at 78%, 11:1 on it.
	.cn {
		--cn-ground: var(--color-bg-surface, #fff);
		--cn-text: var(--color-text, #17181c);
		--cn-muted: var(--color-text-secondary, #63656c);
		--cn-edge: rgba(23, 24, 28, 0.1);
		--cn-shadow: 0 16px 40px -12px rgba(16, 24, 40, 0.28), 0 2px 8px rgba(16, 24, 40, 0.08);
		--cn-focus: #{$color-brand};

		&[data-tone='dark'] {
			--cn-ground: #121425;
			--cn-text: #fff;
			--cn-muted: rgba(255, 255, 255, 0.78);
			--cn-edge: rgba(255, 255, 255, 0.12);
			--cn-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.6);
			--cn-focus: #8b9bff;
		}

		// No `display` here: the UA's `[hidden] { display: none }` is what hides it, and an author
		// display on this element would beat it.
		position: fixed;
		z-index: 9999; // the one in use; the chat launcher sits above at the 32-bit maximum
		box-sizing: border-box;
		font-family: var(--font-family, $font-family-base);
		color: var(--cn-text);
		background: var(--cn-ground);
		animation: cn-in 200ms cubic-bezier(0.2, 0.7, 0.2, 1) both;

		&[data-cn-leaving] {
			animation: cn-out 160ms ease-in forwards;
		}

		@media (prefers-reduced-motion: reduce) {
			animation: none;
		}
	}

	@keyframes cn-in {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
	}

	@keyframes cn-out {
		to {
			opacity: 0;
			transform: translateY(8px);
		}
	}

	.cn__copy {
		min-width: 0;
	}

	.cn__title {
		@include type-tile;
		margin: 0 0 $spacing-1;
		color: var(--cn-text);
	}

	.cn__text {
		@include type-small;
		margin: 0;
		color: var(--cn-muted);

		.cn[data-size='small'] & {
			font-size: 13px;
			line-height: 20px;
		}
	}

	// The heading as the link: the text colour, no underline until hover, the chevron the site's
	// outgoing links carry (1.25em, pulled in by a pixel), nudged on hover.
	.cn__head-link {
		display: inline-flex;
		align-items: center;
		gap: 2px;
		color: inherit;
		text-decoration: none;
		border-radius: 2px;

		svg {
			width: 1.25em;
			height: 1.25em;
			margin-right: -1px;
			transition: transform 0.15s ease;
		}

		&:hover {
			text-decoration: underline;
			text-decoration-thickness: 1px;
			text-underline-offset: 3px;

			svg {
				transform: translateX(2px);
			}
		}

		&:focus-visible {
			outline: 2px solid var(--cn-focus);
			outline-offset: 2px;
		}

		@media (prefers-reduced-motion: reduce) {
			svg {
				transition: none;
			}
		}
	}

	.cn__text :global(.cn__link) {
		color: var(--cn-text);
		font-weight: $font-weight-medium;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
		border-radius: 2px;

		&:hover {
			text-decoration-color: currentColor;
		}

		&:focus-visible {
			outline: 2px solid var(--cn-focus);
			outline-offset: 2px;
		}
	}

	// The hero's "Try for free", restated: brand fill, 16/700, 44px, 4px corners, the same 15% dark
	// overlay on hover that `button-primary` uses.
	.cn__accept {
		@include type-button;
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 0 $spacing-6;
		border: 0;
		border-radius: $radius-sm;
		background-color: $color-brand;
		background-image: linear-gradient(rgba(0, 0, 0, 0), rgba(0, 0, 0, 0));
		color: #fff;
		font-family: inherit;
		line-height: 1;
		cursor: pointer;
		transition: background-image 0.15s ease;

		&:hover {
			background-image: linear-gradient(rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0.15));
		}

		&:focus-visible {
			outline: 2px solid var(--cn-focus);
			outline-offset: 2px;
		}
	}

	// ---- Bar --------------------------------------------------------------------------------
	//
	// The content width (1200, the homepage's) centred, but never closer than 90px to the right
	// edge: that is the launcher's 50px plus its 20px inset, twice over. At 1440 the centring already
	// leaves 120 and the bar is symmetric; at 1280 it would leave 40, so the right side holds 90 and
	// the line gives up the difference.
	.cn[data-layout='bar'] {
		left: 0;
		right: 0;
		bottom: 0;
		border-top: 1px solid var(--cn-edge);
		box-shadow: 0 -8px 24px -16px rgba(16, 24, 40, 0.3);

		.cn__in {
			display: flex;
			align-items: center;
			gap: $spacing-8;
			padding: $spacing-4 max(90px, calc((100% - 1200px) / 2)) $spacing-4 max($spacing-6, calc((100% - 1200px) / 2));
		}

		.cn__copy {
			flex: 1;
		}

		// A phone: the copy over the button, the button at its own width on the left so the
		// launcher keeps the right of the row. The home indicator's inset under it.
		@include media-down(md) {
			.cn__in {
				flex-direction: column;
				align-items: flex-start;
				gap: $spacing-3;
				padding: $spacing-4 $spacing-4 calc(#{$spacing-4} + env(safe-area-inset-bottom, 0px));
			}
		}
	}

	// ---- Card -------------------------------------------------------------------------------
	//
	// Bottom-LEFT, the corner nothing else claims: the launcher has the right. 24px in on desktop;
	// on a phone 8px in on three sides, so the page still shows round it and it reads as a note on
	// top rather than a strip of the page.
	.cn[data-layout='card'] {
		left: $spacing-6;
		bottom: $spacing-6;
		width: min(400px, calc(100% - #{$spacing-12}));
		border: 1px solid var(--cn-edge);
		border-radius: $radius-lg;
		box-shadow: var(--cn-shadow);

		.cn__in {
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: $spacing-4;
			padding: $spacing-5;
		}

		// The title goes on a phone: the region is still named "Cookie notice" and the link names the
		// policy, and the 24px it took is what keeps the card no taller than the bar in use.
		@include media-down(md) {
			left: $spacing-2;
			right: $spacing-2;
			bottom: calc(#{$spacing-2} + env(safe-area-inset-bottom, 0px));
			width: auto;

			.cn__in {
				gap: $spacing-3;
				padding: $spacing-4;
			}

			.cn__title {
				display: none;
			}

			&[data-title-link] .cn__title {
				display: block;
			}
		}
	}

	// Docs pages: past 72rem Starlight draws the sidebar, and the notice starts where the page does,
	// as the one in use does.
	@media (min-width: 72rem) {
		:global(html[data-has-sidebar]) .cn[data-layout='bar'] {
			left: var(--sl-sidebar-width);
		}

		:global(html[data-has-sidebar]) .cn[data-layout='card'] {
			left: calc(var(--sl-sidebar-width) + #{$spacing-6});
		}
	}
</style>
