---
/**
 * The button for the new pages: three variants, five sizes, one 6px corner, plain by default, and
 * bold unless told otherwise (`weight`).
 *
 * Colour comes from the accent schemes (`data-accent` on any ancestor, or `accent` here), the focus
 * ring from the ground (`data-surface`). An `<a>` with `href`, a `<button>` without. Everything a
 * page needs to track or hook a button (an id, `gtm_button`, `data-*`) passes through `attrs`
 * untouched. The spec and every state: the plan's Button section and the Design system's UI page.
 */
import { Icon } from 'astro-icon/components';
import { DESTINATIONS, type Destination } from '@data/cta-destinations';
import { accentAttrs, sizeClasses, type Accent, type Responsive } from '@util/ui-kit';
import { newTabAttrs, NEW_TAB_NOTE } from '@util/external-links';

interface Props {
	variant?: 'primary' | 'secondary' | 'tertiary';
	/** 32 · 40 · 44 · 48 · 56, or one per breakpoint: `{ base: 'md', lg: 'xl' }`. */
	size?: Responsive<'xs' | 'sm' | 'md' | 'lg' | 'xl'>;
	/** A scheme, or a colour for a one-off fill (a product's hue). Default: the nearest `data-accent`. */
	accent?: Accent;
	/** A tabler name before the label: 16 xs · 18 sm · 20 md and lg · 22 xl. */
	icon?: string;
	iconEnd?: string;
	/** Square, the icon alone; `label` names it. */
	iconOnly?: boolean;
	label?: string;
	href?: string;
	/** A destination from `cta-destinations.ts`: its href and attributes together. */
	to?: Destination;
	/** Leaves the site: the up-right arrow, a new tab, and "opens in a new tab" for screen readers. */
	external?: boolean;
	type?: 'button' | 'submit' | 'reset';
	/** Tertiary: no inline padding, so the label lines up with the text above it. */
	flush?: boolean;
	/** Secondary: the label in the accent rather than the ink. */
	tinted?: boolean;
	/**
	 * The label's weight. Bold wherever a button is a call; `regular` for a quiet control that sits
	 * among others of its kind — the bar's Sign in beside Menu and the star count (2026-10-07), where
	 * a bold label beside the bold Try for free read as a second call.
	 */
	weight?: 'bold' | 'regular';
	/** Joined to a field on this side. */
	attached?: 'start' | 'end';
	/**
	 * Busy: the spinner and `loadingLabel` in the label's place, the width held. A button a script
	 * sets busy (`aria-busy="true"`) passes `loadingLabel` alone, and the busy line is there to show.
	 */
	loading?: boolean;
	loadingLabel?: string;
	disabled?: boolean;
	/** The opt-in highlight on hover; off by default. */
	shimmer?: boolean;
	/** Visually hidden text after the label, e.g. "for ThingsBoard Cloud". */
	srSuffix?: string;
	id?: string;
	class?: string;
	/** Passed through untouched: ids, `gtm_button`, `data-*`. */
	attrs?: Record<string, string | undefined>;
}

const {
	variant = 'primary',
	size = 'md',
	accent,
	icon,
	iconEnd,
	iconOnly = false,
	label,
	to,
	external = false,
	type = 'button',
	flush = false,
	tinted = false,
	weight = 'bold',
	attached,
	loading = false,
	loadingLabel,
	disabled = false,
	shimmer = false,
	srSuffix,
	id,
	class: className,
	attrs = {},
} = Astro.props;

if (iconOnly && !label) throw new Error('ui/Button: an iconOnly button needs a label.');
if (loading && loadingLabel === undefined) throw new Error('ui/Button: a loading button needs a loadingLabel.');

const destination = to ? DESTINATIONS[to] : undefined;
const href = Astro.props.href ?? destination?.href;
// A copy: Astro writes into an object it spreads, and the destination's is shared by every button.
const destinationAttrs = { ...destination?.attrs };
// Whatever opens the new tab, `external` or a `target` passed through, a screen reader hears it.
const newTab = external || attrs.target === '_blank';

// An `<a>` with an href, a `<button>` without. A disabled link keeps its element and loses its href,
// so it is announced as a link that cannot be followed rather than turning into a button.
const Tag = href === undefined ? 'button' : 'a';
const element =
	Tag === 'button'
		? { type, disabled: disabled || undefined }
		: disabled
			? { 'aria-disabled': 'true' as const, role: 'link' as const }
			: { href, ...newTabAttrs(external) };

const classes = [
	'ui-btn',
	`ui-btn--${variant}`,
	...sizeClasses('ui-btn', size),
	flush && 'ui-btn--flush',
	tinted && 'ui-btn--tinted',
	weight === 'regular' && 'ui-btn--regular',
	attached && `ui-btn--attached-${attached}`,
	iconOnly && 'ui-btn--icon-only',
	shimmer && 'ui-btn--shimmer',
	className,
]
	.filter(Boolean)
	.join(' ');

// A one-off colour and a caller's own style (a minimum width) both ride on `style`.
const { style: accentStyle, ...accentData } = accentAttrs(accent, 'btn');
const { style: callerStyle, ...passed } = attrs;
const style = [accentStyle, callerStyle].filter(Boolean).join('; ') || undefined;
---

<Tag
	class={classes}
	id={id}
	aria-label={iconOnly ? label : undefined}
	aria-busy={loading ? 'true' : undefined}
	style={style}
	{...accentData}
	{...element}
	{...destinationAttrs}
	{...passed}
>
	{loadingLabel === undefined ? (
		<>
			{icon && <Icon name={icon} class="ui-btn__icon" aria-hidden="true" />}
			{!iconOnly && <slot />}
		</>
	) : (
		<span class="ui-btn__stack">
			<span class="ui-btn__label">
				{icon && <Icon name={icon} class="ui-btn__icon" aria-hidden="true" />}
				{!iconOnly && <slot />}
			</span>
			<span class="ui-btn__busy">
				<span class="ui-btn__spin" />
				{loadingLabel}
			</span>
		</span>
	)}
	{srSuffix && <span class="ui-sr"> {srSuffix}</span>}
	{iconEnd && <Icon name={iconEnd} class="ui-btn__icon" aria-hidden="true" />}
	{external && <Icon name="tabler:arrow-up-right" class="ui-btn__icon" aria-hidden="true" />}
	{newTab && <span class="ui-sr">{NEW_TAB_NOTE}</span>}
</Tag>

<style is:global lang="scss">
	@use 'sass:map';
	@use '../../styles/variables' as *;
	@use '../../styles/button' as *;
	@use '../../styles/effects' as *;

	.ui-btn {
		@include ui-button-base;
		@include ui-button-size(md);
	}

	.ui-btn--primary {
		@include ui-button-primary;
	}

	.ui-btn--secondary {
		@include ui-button-secondary;
	}

	.ui-btn--secondary.ui-btn--tinted {
		@include ui-button-secondary-tinted;
	}

	.ui-btn--tertiary {
		@include ui-button-tertiary;
	}

	@each $size, $values in $ui-button-sizes {
		.ui-btn--#{$size} {
			@include ui-button-size($size);
		}
	}

	@each $bp in (sm, md, lg) {
		@include media-up($bp) {
			@each $size, $values in $ui-button-sizes {
				.ui-btn--#{$bp}-up-#{$size} {
					@include ui-button-size($size);
				}
			}
		}
	}

	// xs and sm are under the 44px touch target: on a coarse pointer an invisible extension grows the
	// tap area to 44 without changing the look (none from md up, where the box is already 44).
	@media (pointer: coarse) {
		.ui-btn::before {
			content: '';
			position: absolute;
			inset: min(0px, (var(--btn-h) - 44px) / 2) 0;
		}
	}

	.ui-btn--tertiary.ui-btn--flush {
		padding-inline: 0;
	}

	.ui-btn--regular {
		font-weight: $font-weight-normal;
	}

	.ui-btn--icon-only {
		width: var(--btn-h);
		padding: 0;
	}

	.ui-btn--attached-start {
		border-start-start-radius: 0;
		border-end-start-radius: 0;
	}

	.ui-btn--attached-end {
		border-start-end-radius: 0;
		border-end-end-radius: 0;
	}

	.ui-btn--shimmer {
		@include shimmer;
	}

	@include shimmer-keyframes;

	// Right-to-left: a directional icon points the other way.
	[dir='rtl'] .ui-btn :where(.ui-btn__icon[data-icon*='arrow'], .ui-btn__icon[data-icon*='chevron']) {
		transform: scaleX(-1);
	}

	// Loading: the label and the busy line share one cell, so the width holds while it swaps. The
	// hidden one is `visibility: hidden`, out of the accessibility tree too, so the button is named by
	// whichever shows.
	.ui-btn__stack {
		display: inline-grid;

		> * {
			grid-area: 1 / 1;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: var(--btn-gap);
		}
	}

	.ui-btn__busy {
		visibility: hidden;
	}

	.ui-btn[aria-busy='true'] {
		.ui-btn__label {
			visibility: hidden;
		}

		.ui-btn__busy {
			visibility: visible;
		}
	}

	.ui-btn__spin {
		flex: none;
		width: 16px;
		height: 16px;
		border: 2px solid currentColor;
		border-right-color: transparent;
		border-radius: 50%;
		animation: ui-btn-spin 0.8s linear infinite;

		@media (prefers-reduced-motion: reduce) {
			animation-duration: 2.4s;
		}
	}

	@keyframes ui-btn-spin {
		to {
			transform: rotate(360deg);
		}
	}
</style>
