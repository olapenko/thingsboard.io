---
/**
 * A band: a ground, a padding step and the page measure. Every section on the new pages is one.
 *
 * It paints its own ground on itself (so no page needs the rule that strips section backgrounds),
 * and sets `data-surface` from it, so every Button, Link, header and ring inside takes the right
 * tone with no props; `accent` sets `data-accent` the same way.
 *
 * Grounds: flat · tint (`--band-tint`) · fade (white to the hue at 8, 10, 14 or 20%) · dark
 * (`--band-indigo`, or the page's hero ground) · hue (150°, 22% to 6% of the hue). `wave` lays the
 * wave field over the ground, in `--band-wave` on dark and the hue elsewhere.
 *
 * Padding: none 0 · sm 48 · md 64 · lg 80 · xl 96, stepping to 0 · 32 · 48 · 48 · 64 below 750.
 * Measure: `page` is 960 inside 20px gutters; `full` lets the content run edge to edge.
 */
import PricingBackground from '@components/Pricing/PricingBackground.astro';
import type { Scheme } from '@util/ui-kit';

type Pad = 'none' | 'sm' | 'md' | 'lg' | 'xl';

interface Props {
	as?: 'section' | 'div' | 'aside' | 'footer';
	id?: string;
	labelledby?: string;
	ground?: 'flat' | 'tint' | 'fade' | 'dark' | 'hue';
	/** fade and hue: the colour mixed in. Default: the scheme fill. */
	hue?: string;
	/** tint and dark: the ground itself, where the page has its own (On-premises' green tint). */
	groundColor?: string;
	/** fade: how much of the hue at the bottom, in %. */
	strength?: 8 | 10 | 14 | 20;
	wave?: boolean;
	/** The wave's colour, where the ground's default is not wanted. */
	waveHue?: string;
	pad?: Pad | { top?: Pad; bottom?: Pad };
	measure?: 'page' | 'full';
	accent?: Scheme;
	class?: string;
	innerClass?: string;
	attrs?: Record<string, string | undefined>;
}

const {
	as: Tag = 'section',
	id,
	labelledby,
	ground = 'flat',
	hue,
	groundColor,
	strength = 10,
	wave = false,
	waveHue,
	pad = 'md',
	measure = 'page',
	accent,
	class: className,
	innerClass,
	attrs = {},
} = Astro.props;

const top = typeof pad === 'string' ? pad : (pad.top ?? 'md');
const bottom = typeof pad === 'string' ? pad : (pad.bottom ?? 'md');
const dark = ground === 'dark';
const style = [
	hue && `--band-hue: ${hue}`,
	groundColor && `--band-ground: ${groundColor}`,
	ground === 'fade' && `--band-strength: ${strength}%`,
]
	.filter(Boolean)
	.join('; ');
---

<Tag
	id={id}
	aria-labelledby={labelledby}
	class:list={[
		'ui-band',
		`ui-band--${ground}`,
		`ui-band--pt-${top}`,
		`ui-band--pb-${bottom}`,
		wave && 'ui-band--wave',
		className,
	]}
	style={style || undefined}
	data-surface={dark ? 'dark' : 'light'}
	data-accent={accent}
	{...attrs}
>
	{
		wave && (
			<PricingBackground
				contained
				hue={waveHue ?? (dark ? 'var(--band-wave)' : 'var(--band-hue, var(--accent-fill))')}
			/>
		)
	}
	<div class:list={['ui-band__inner', `ui-band__inner--${measure}`, innerClass]}>
		<slot />
	</div>
</Tag>

<style is:global lang="scss">
	@use 'sass:list';
	@use '../../styles/variables' as *;

	.ui-band {
		--_hue: var(--band-hue, var(--accent-fill));

		position: relative;
		box-sizing: border-box;
	}

	.ui-band--flat {
		background-color: var(--color-bg, #fff);
	}

	.ui-band--tint {
		background-color: var(--band-ground, var(--band-tint));
	}

	.ui-band--fade {
		background-color: #fff;
		background-image: linear-gradient(to bottom, #fff, color-mix(in srgb, var(--_hue) var(--band-strength, 10%), #fff));
	}

	.ui-band--dark {
		background-color: var(--band-ground, var(--band-indigo));
		color: #fff;
	}

	.ui-band--hue {
		background-color: #fff;
		background-image: linear-gradient(
			150deg,
			color-mix(in srgb, var(--_hue) 22%, #fff),
			color-mix(in srgb, var(--_hue) 6%, #fff)
		);
	}

	// The wave sits in the band's own stacking context, over the ground and under the content.
	.ui-band--wave {
		overflow: hidden;
		isolation: isolate;
	}

	.ui-band__inner {
		position: relative;
		z-index: 1;
		box-sizing: border-box;
	}

	.ui-band__inner--page {
		width: 100%;
		max-width: calc(960px + #{$spacing-5} * 2);
		margin-inline: auto;
		padding-inline: $spacing-5;
	}

	$band-pad: (
		none: (
			0,
			0,
		),
		sm: (
			48px,
			32px,
		),
		md: (
			64px,
			48px,
		),
		lg: (
			80px,
			48px,
		),
		xl: (
			96px,
			64px,
		),
	);

	@each $step, $values in $band-pad {
		.ui-band--pt-#{$step} {
			padding-top: list.nth($values, 1);

			@include media-down(md) {
				padding-top: list.nth($values, 2);
			}
		}

		.ui-band--pb-#{$step} {
			padding-bottom: list.nth($values, 1);

			@include media-down(md) {
				padding-bottom: list.nth($values, 2);
			}
		}
	}
</style>
