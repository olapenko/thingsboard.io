---
/**
 * The card that is a link with a mark, a title and a line: the thank-you page's next steps, Bookend's
 * side cards, the contact routes. A `Card` with `href`, so it lifts, presses and rings like every
 * other link card; the mark sits beside the text (`row`) or above it (`tall`), and a trailing glyph
 * says where it goes: a chevron on the site, the up-right arrow off it.
 */
import { Icon } from 'astro-icon/components';
import Card from '@components/ui/Card.astro';
import Mark from '@components/ui/Mark.astro';

interface Props {
	href: string;
	title: string;
	line?: string;
	/** A tabler name for the 48 mark. */
	icon?: string;
	markFill?: 'solid' | 'white' | 'wash' | 'neutral';
	layout?: 'row' | 'tall';
	/** `ghost` on a dark or tinted ground: translucent, no lift. */
	tone?: 'surface' | 'ghost';
	/** 12 16 · 20 (default). */
	pad?: 'sm' | 'md';
	/** `external` also makes the link leave the site (new tab, `rel`, screen-reader text). */
	trail?: 'chevron' | 'external' | 'none';
	/** Attributes for the card's link itself (the region dialog's `data-cloud-auth`). */
	linkAttrs?: Record<string, string | undefined>;
	level?: 2 | 3 | 4;
	as?: 'div' | 'li';
	accent?: 'brand' | 'onprem' | 'neutral';
	class?: string;
	attrs?: Record<string, string | undefined>;
}

const {
	href,
	title,
	line,
	icon,
	markFill = 'neutral',
	layout = 'row',
	tone = 'surface',
	pad = 'md',
	trail = 'chevron',
	linkAttrs,
	level = 3,
	as = 'div',
	accent,
	class: className,
	attrs = {},
} = Astro.props;
---

<Card
	href={href}
	title={title}
	level={level}
	as={as}
	accent={accent}
	tone={tone}
	pad={pad}
	linkAttrs={linkAttrs}
	external={trail === 'external'}
	class:list={['ui-link-card', `ui-link-card--${layout}`, className]}
	attrs={attrs}
>
	{icon && <Mark slot="mark" size={48} icon={icon} fill={markFill} class="ui-link-card__mark" />}
	{line && <p class="ui-link-card__line">{line}</p>}
	{
		trail !== 'none' && (
			<Icon
				name={trail === 'external' ? 'tabler:arrow-up-right' : 'tabler:chevron-right'}
				class="ui-link-card__trail"
				aria-hidden="true"
			/>
		)
	}
</Card>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	.ui-card.ui-link-card {
		display: grid;
		gap: 2px $spacing-3;
	}

	// Row: the mark, then the title over its line, then the trail; centred on the text block.
	.ui-card.ui-link-card--row {
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;

		> .ui-link-card__mark {
			grid-row: 1 / span 2;
			grid-column: 1;
		}

		> .ui-card__title {
			grid-column: 2;
			align-self: end;
		}

		> .ui-link-card__line {
			grid-column: 2;
			align-self: start;
		}

		> .ui-link-card__trail {
			grid-row: 1 / span 2;
			grid-column: 3;
		}
	}

	.ui-card.ui-link-card--tall {
		grid-template-columns: minmax(0, 1fr) auto;

		> .ui-link-card__mark {
			grid-column: 1 / -1;
			margin-bottom: $spacing-2;
		}

		> .ui-link-card__trail {
			grid-row: 2;
			grid-column: 2;
		}
	}

	.ui-link-card__line {
		@include type-small;

		margin: 0;
		color: var(--color-text-secondary, #{$color-text-secondary});
	}

	.ui-link-card__trail {
		width: 20px;
		height: 20px;
		color: var(--color-text-secondary, #{$color-text-secondary});
		transition: transform 0.15s ease;

		.ui-link-card:hover & {
			transform: translateX(2px);
		}

		@media (prefers-reduced-motion: reduce) {
			transition: none;

			.ui-link-card:hover & {
				transform: none;
			}
		}
	}
</style>
