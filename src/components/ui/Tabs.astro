---
/**
 * Tabs: one behaviour, three looks, each with one job.
 *
 * - segmented: a pill track with a white thumb that slides to the chosen segment, for two or three
 *   short options above a visual (the AI switch, Automate). The track takes its ground: `neutral`
 *   is the ink at 6%, so it darkens whatever band is under it; `accent` is the scheme's wash.
 * - list: a column of 16px items for four to eight categories beside their content (the product
 *   FAQ).
 * - grid: the compact 14px items in two columns, filled down then across, for eight or more
 *   choices that drive one visual (the dashboards' use cases).
 *
 * List and grid share the item's states (6% of the accent on hover, 10% and the accent ink when
 * chosen, never a weight change) and become one scrolling row below 750, so a choice never changes
 * its look at a breakpoint.
 *
 * ARIA tabs, not a radio group: what changes is which PANEL is on the page. The script is
 * `util/tabs.ts`, shared by every set. The caller renders the panels with `TabPanel`, the first
 * shown and the rest `hidden`, so the page is right before the script runs. An on/off setting is a
 * toggle `Chip`, not a tab.
 *
 * SEGMENTED is the switch the homepage's AI section and Automate were built on, and keeps its class
 * names (`.seg`, `.seg__opt`, `data-segmented`): those callers style and script against them. Its
 * thumb's slide reads `--seg-duration` and `--seg-ease`, so a caller animating its panels moves
 * them on the same curve.
 */
import { Icon } from 'astro-icon/components';

export interface TabItem {
	label: string;
	/** Shown instead of `label` on a phone (segmented), where two segments share ~330px. */
	shortLabel?: string;
	icon?: string;
	/** Id of the panel this tab shows; the tab's own id is `<panel>-tab`. */
	panel: string;
	/** Segmented: the chosen label's colour. Dark enough to read on the white thumb. */
	color?: string;
}

interface Props {
	look?: 'segmented' | 'list' | 'grid';
	/** Segmented: the track, the ink blended into the ground (default) or the scheme's wash. */
	tone?: 'neutral' | 'accent';
	/** The tablist's accessible name: what is being chosen between. */
	label: string;
	items: TabItem[];
	/** Index of the tab shown first. */
	selected?: number;
	/** List: the column sticks under the header while its panels scroll. */
	sticky?: boolean;
	class?: string;
}

const {
	look = 'segmented',
	tone = 'neutral',
	label,
	items,
	selected = 0,
	sticky = false,
	class: className,
} = Astro.props;
---

{
	look === 'segmented' ? (
		<div
			class:list={['seg', tone === 'accent' && 'seg--accent', className]}
			role="tablist"
			aria-label={label}
			data-tabs
			data-segmented
			style={`--seg-count: ${items.length}; --seg-index: ${selected}`}
		>
			<span class="seg__thumb" aria-hidden="true" />
			{items.map((o, i) => (
				<button
					type="button"
					class="seg__opt"
					role="tab"
					id={`${o.panel}-tab`}
					aria-controls={o.panel}
					aria-selected={i === selected ? 'true' : 'false'}
					tabindex={i === selected ? 0 : -1}
					style={o.color ? `--seg-color: ${o.color}` : undefined}
				>
					{o.icon && <Icon name={o.icon} class="seg__icon" aria-hidden="true" />}
					<span class:list={['seg__label', o.shortLabel && 'seg__label--long']}>{o.label}</span>
					{o.shortLabel && <span class="seg__label seg__label--short">{o.shortLabel}</span>}
				</button>
			))}
		</div>
	) : (
		<div
			class:list={['ui-tabs', `ui-tabs--${look}`, sticky && 'ui-tabs--sticky', className]}
			role="tablist"
			aria-label={label}
			aria-orientation="vertical"
			data-tabs
			data-tabs-orient="md"
			style={look === 'grid' ? `--tabs-rows: ${Math.ceil(items.length / 2)}` : undefined}
		>
			{items.map((o, i) => (
				<button
					type="button"
					class:list={['ui-tabs__item', i === selected && 'is-active']}
					role="tab"
					id={`${o.panel}-tab`}
					aria-controls={o.panel}
					aria-selected={i === selected ? 'true' : 'false'}
					tabindex={i === selected ? 0 : -1}
				>
					{o.icon && <Icon name={o.icon} class="ui-tabs__icon" aria-hidden="true" />}
					{o.label}
				</button>
			))}
		</div>
	)
}

<script>
	import { mountAllTabs } from '@util/tabs';

	mountAllTabs();
</script>

<style is:global lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/surface' as *;

	// ── SEGMENTED ───────────────────────────────────────────────────────────
	// The track: a pill with no stroke, so the fill alone makes it a slot the thumb sits IN. The fill
	// is translucent, so it takes the ground's hue (a tint band, the AI wash) instead of laying a
	// grey of its own on it; the white thumb stays white. `fit-content`, so a grid or a flex column
	// around it never stretches it to the row.
	.seg {
		--seg-pad: 3px;
		--_track: rgba(23, 24, 28, 0.06);
		--_label: var(--color-text-secondary, #{$color-text-secondary});
		--_label-hover: var(--color-text, #{$color-text-primary});

		position: relative;
		display: inline-grid;
		grid-auto-columns: 1fr;
		grid-auto-flow: column;
		width: fit-content;
		max-width: 100%;
		padding: var(--seg-pad);
		border-radius: $radius-full;
		background: var(--_track);
		isolation: isolate;

		@include on-dark {
			--_track: rgba(255, 255, 255, 0.1);
			--_label: rgba(255, 255, 255, 0.72);
			--_label-hover: #fff;
		}
	}

	// The scheme's wash: 10% of the fill, its light tone at 16% on dark.
	.seg--accent {
		--_track: color-mix(in srgb, var(--accent-fill) 10%, transparent);

		@include on-dark {
			--_track: color-mix(in srgb, var(--accent-light) 16%, transparent);
		}
	}

	// The thumb: one segment wide, moved in whole segments through two custom properties rather
	// than measured, so it cannot drift from the segment under it at any width or zoom.
	.seg__thumb {
		position: absolute;
		z-index: -1;
		top: var(--seg-pad);
		bottom: var(--seg-pad);
		left: var(--seg-pad);
		width: calc((100% - 2 * var(--seg-pad)) / var(--seg-count));
		border-radius: $radius-full;
		background: #fff;
		box-shadow:
			0 1px 2px rgba(var(--color-shadow-ui-rgb), 0.1),
			0 3px 10px rgba(var(--color-shadow-ui-rgb), 0.08);
		transform: translateX(calc(var(--seg-index) * 100%));
		transition: transform var(--seg-duration, 280ms) var(--seg-ease, cubic-bezier(0.3, 0.7, 0.2, 1));
	}

	.seg__opt {
		@include type-body;

		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		min-height: 40px;
		margin: 0;
		padding: 0 $spacing-4;
		border: 0;
		border-radius: $radius-full;
		background: none;
		font-weight: $font-weight-medium;
		line-height: 1;
		white-space: nowrap;
		color: var(--_label);
		cursor: pointer;
		transition: color 180ms ease;

		@media (hover: hover) {
			&:hover {
				color: var(--_label-hover);
			}
		}

		// On the white thumb, so always the light ground's ink, on any band.
		&[aria-selected='true'] {
			color: var(--seg-color, var(--color-text, #{$color-text-primary}));
			cursor: default;
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 2px;
		}

		@media (forced-colors: active) {
			&[aria-selected='true'] {
				outline: 2px solid Highlight;
			}
		}
	}

	// 20, the site's icon size beside 16px type.
	.seg__icon {
		flex: none;
		width: 20px;
		height: 20px;
	}

	// The last resort for a label with no `shortLabel` that still does not fit: cut with an
	// ellipsis inside its own segment rather than widening it out from under the thumb. Its own
	// line-height, because a clip at the button's 1 cuts the descenders.
	.seg__label {
		min-width: 0;
		overflow: hidden;
		line-height: 1.4;
		text-overflow: ellipsis;
	}

	// `display: none`, so the label not showing is out of the accessibility tree too.
	.seg__label--short {
		display: none;
	}

	// A phone holds the segments at full width, equal (`minmax(0, 1fr)`: a bare 1fr has a
	// min-content floor and a long label grew its segment out from under the thumb), 44 tall for a
	// thumb pressing it, and a `shortLabel` takes over.
	@media (max-width: 480px) {
		.seg {
			display: grid;
			grid-auto-columns: minmax(0, 1fr);
			width: 100%;
		}

		.seg__label--long {
			display: none;
		}

		.seg__label--short {
			display: inline;
		}

		.seg__opt {
			min-height: 44px;
			padding: 0 $spacing-3;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.seg__thumb,
		.seg__opt {
			transition: none;
		}
	}

	// ── LIST AND GRID ───────────────────────────────────────────────────────
	// Items on a tint when chosen: 6% of the accent on hover, 10% and the accent ink when selected,
	// never a weight change, so a label never shifts its neighbours. Below 750 the same items run as
	// one scrolling row.
	.ui-tabs {
		display: flex;
		flex-direction: column;
		gap: $spacing-1;
	}

	.ui-tabs--sticky {
		@include media-up(md) {
			position: sticky;
			top: calc(var(--home-header-h, 64px) + #{$spacing-6});
		}
	}

	.ui-tabs__item {
		@include type-body;

		display: flex;
		align-items: center;
		gap: $spacing-2;
		width: 100%;
		margin: 0;
		padding: $spacing-3 $spacing-4;
		border: 0;
		border-radius: $radius-lg;
		background: none;
		font-weight: $font-weight-medium;
		text-align: left;
		color: var(--color-text-secondary, #{$color-text-secondary});
		cursor: pointer;

		@media (hover: hover) {
			&:hover {
				background-color: color-mix(in srgb, var(--accent-ink) 6%, transparent);
				color: var(--color-text, #{$color-text-primary});
			}
		}

		&[aria-selected='true'] {
			background-color: color-mix(in srgb, var(--accent-ink) 10%, transparent);
			color: var(--accent-ink);
			cursor: default;
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 2px;
		}

		@media (forced-colors: active) {
			&[aria-selected='true'] {
				outline: 2px solid Highlight;
			}
		}
	}

	.ui-tabs__icon {
		flex: none;
		width: 20px;
		height: 20px;
	}

	// GRID: 14px items, 40 tall, in two columns filled down then across (`--tabs-rows` is half the
	// count, set on the list), so ten names stand five high beside the copy instead of ten.
	.ui-tabs--grid {
		.ui-tabs__item {
			@include type-small;

			min-height: 40px;
			padding: $spacing-2 $spacing-3;
			font-weight: $font-weight-medium;
		}

		.ui-tabs__icon {
			width: 18px;
			height: 18px;
		}

		@include media-up(md) {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-template-rows: repeat(var(--tabs-rows, 4), auto);
			grid-auto-flow: column;
			gap: $spacing-1 $spacing-4;
		}
	}

	@include media-down(md) {
		.ui-tabs {
			flex-direction: row;
			gap: $spacing-2;
			// The 2px keep the focus ring inside the scroller's clip.
			padding: 2px;
			overflow-x: auto;
			scrollbar-width: none;

			&::-webkit-scrollbar {
				display: none;
			}
		}

		.ui-tabs__item {
			flex: none;
			width: auto;
			white-space: nowrap;
		}
	}
</style>
