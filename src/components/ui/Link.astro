---
/**
 * The link for the new pages. Two kinds, one component:
 *
 * - standalone: a label and a chevron that ends a card or a section; underlined on hover only.
 * - inline: sits in running text, always underlined, no glyph.
 *
 * Links go somewhere. Anything that toggles, submits or opens a dialog is a `Button` (tertiary).
 * One glyph for going somewhere on the site (the chevron, forward or back); the up-right arrow only
 * for leaving it. Colour from the accent schemes (`data-accent`), the ring from the ground
 * (`data-surface`).
 */
import { Icon } from 'astro-icon/components';
import { newTabAttrs, NEW_TAB_NOTE } from '@util/external-links';

interface Props {
	href?: string;
	variant?: 'standalone' | 'inline';
	/** 14 · 16 · 18; the chevron is 1.25em of it. An inline link inherits the text's size. */
	size?: 'sm' | 'md' | 'lg';
	/** accent: the scheme's ink · ink: near-black, accent on hover · muted: grey, ink on hover. */
	tone?: 'accent' | 'ink' | 'muted';
	/** The chevron's direction; `none` drops it (a standalone link in a list that reads without it). */
	dir?: 'forward' | 'back' | 'none';
	/** Leaves the site: the up-right arrow, a new tab, "opens in a new tab" for screen readers. */
	external?: boolean;
	/** Visually hidden text after the label, e.g. "for ThingsBoard Cloud". */
	srSuffix?: string;
	id?: string;
	class?: string;
	attrs?: Record<string, string | undefined>;
}

const {
	variant = 'standalone',
	size = 'md',
	tone = 'accent',
	dir = 'forward',
	external = false,
	srSuffix,
	id,
	class: className,
	attrs = {},
} = Astro.props;

const { href } = Astro.props;
const standalone = variant === 'standalone';
// Whatever opens the new tab, `external` or a `target` passed through, a screen reader hears it.
const newTab = external || attrs.target === '_blank';
---

<a
	id={id}
	href={href}
	class:list={[
		'ui-link',
		`ui-link--${variant}`,
		standalone && `ui-link--${size}`,
		`ui-link--${tone}`,
		standalone && dir === 'back' && 'ui-link--back',
		className,
	]}
	{...newTabAttrs(external)}
	{...attrs}
>
	{/* One line: inside an inline link any whitespace would be underlined. */}{
		standalone && dir === 'back' && <Icon name="tabler:chevron-left" class="ui-link__glyph" aria-hidden="true" />
	}<slot />{srSuffix && <span class="ui-sr">{` ${srSuffix}`}</span>}{
		standalone && dir === 'forward' && !external && (
			<Icon name="tabler:chevron-right" class="ui-link__glyph" aria-hidden="true" />
		)
	}{external && <Icon name="tabler:arrow-up-right" class="ui-link__glyph ui-link__glyph--out" aria-hidden="true" />}{
		newTab && <span class="ui-sr">{NEW_TAB_NOTE}</span>
	}</a
>

<style is:global lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/surface' as *;

	// Each tone names its colour and its hover colour on each ground; the ground picks the pair.
	.ui-link {
		--_light: var(--accent-ink);
		--_light-hover: var(--accent-ink);
		--_dark: var(--accent-light);
		--_dark-hover: var(--accent-light);
		--_c: var(--_light);
		--_c-hover: var(--_light-hover);

		color: var(--_c);
		text-decoration-line: none;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		border-radius: 2px;
		-webkit-tap-highlight-color: transparent;

		@include on-dark {
			--_c: var(--_dark);
			--_c-hover: var(--_dark-hover);
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 2px;
		}

		@media (hover: hover) {
			&:hover {
				color: var(--_c-hover);
			}
		}

		@media (forced-colors: active) {
			color: LinkText;
			text-decoration-line: underline;
		}
	}

	// ink: near-black, the accent on hover. muted: grey, the ink on hover.
	.ui-link--ink {
		--_light: var(--color-text, #17181c);
		--_dark: #fff;
	}

	.ui-link--muted {
		--_light: var(--color-text-secondary, #63656c);
		--_light-hover: var(--color-text, #17181c);
		--_dark: rgba(255, 255, 255, 0.72);
		--_dark-hover: #fff;
	}

	// STANDALONE: the label and its chevron held on one line; the underline is the hover, at 1px,
	// and the press steps it to 2px at 75% opacity. The chevron holds still.
	.ui-link--standalone {
		display: inline-flex;
		align-items: center;
		white-space: nowrap;

		@media (hover: hover) {
			&:hover {
				text-decoration-line: underline;
			}
		}

		&:focus-visible {
			text-decoration-line: underline;
		}

		&:active {
			text-decoration-line: underline;
			text-decoration-thickness: 2px;
			opacity: 0.75;
		}
	}

	.ui-link--sm {
		@include type-small-strong;
	}

	.ui-link--md {
		@include type-link;
	}

	.ui-link--lg {
		@include type-action;
	}

	// 1.25em of the text, so 18 · 20 · 22 for 14 · 16 · 18; the glyph's own side bearing is the gap.
	.ui-link__glyph {
		flex: none;
		width: 1.25em;
		height: 1.25em;
		margin-inline-start: -1px;
	}

	.ui-link--back .ui-link__glyph {
		margin-inline: 0 -1px;
	}

	.ui-link__glyph--out {
		width: 1em;
		height: 1em;
		margin-inline-start: 4px;
	}

	[dir='rtl'] .ui-link__glyph:not(.ui-link__glyph--out) {
		transform: scaleX(-1);
	}

	// INLINE: in running text, always underlined; 1px at rest, 2px on hover, 3px pressed.
	.ui-link--inline {
		text-decoration-line: underline;
		text-decoration-thickness: 1px;

		@media (hover: hover) {
			&:hover {
				text-decoration-thickness: 2px;
			}
		}

		&:active {
			text-decoration-thickness: 3px;
			opacity: 0.75;
		}
	}
</style>
