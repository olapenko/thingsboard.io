---
/**
 * A set of chips under an optional label: wrapping with an 8px gap, or one row that scrolls
 * sideways with the page gutter bled (`overflow="scroll"`). Wrap each `Chip` in an `<li>`: the set
 * is a list, so a screen reader hears how many there are.
 */
interface Props {
	/** The group's heading, in the eyebrow type. */
	label?: string;
	overflow?: 'wrap' | 'scroll';
	class?: string;
}

const { label, overflow = 'wrap', class: className } = Astro.props;
---

<div class:list={['ui-chip-group', className]}>
	{label && <p class="ui-chip-group__label">{label}</p>}
	<ul class:list={['ui-chip-group__list', `ui-chip-group__list--${overflow}`]}>
		<slot />
	</ul>
</div>

<style is:global lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/surface' as *;

	.ui-chip-group__label {
		@include type-eyebrow;

		margin: 0 0 $spacing-3;
		color: var(--color-text-secondary, #{$color-text-secondary});

		@include on-dark {
			color: rgba(255, 255, 255, 0.6);
		}
	}

	.ui-chip-group__list {
		display: flex;
		gap: $spacing-2;
		margin: 0;
		padding: 0;
		list-style: none;

		> li {
			display: contents;
		}
	}

	.ui-chip-group__list--wrap {
		flex-wrap: wrap;
	}

	.ui-chip-group__list--scroll {
		overflow-x: auto;
		margin-inline: -$spacing-5;
		padding: 4px $spacing-5;
		scrollbar-width: none;

		&::-webkit-scrollbar {
			display: none;
		}
	}
</style>
