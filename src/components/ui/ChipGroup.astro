---
/**
 * A set of chips under an optional label, wrapping with an 8px gap. Wrap each `Chip` in an `<li>`:
 * the set is a list named by its label, so a screen reader hears what it is and how many there are
 * (`role="list"`, because Safari drops the role of a list without bullets).
 */
import { slugId } from '@util/slug-id';

interface Props {
	/** The group's heading, in the eyebrow type. */
	label?: string;
	class?: string;
}

const { label, class: className } = Astro.props;
const labelId = label ? slugId(label, 'ui-chip-group') : undefined;
---

<div class:list={['ui-chip-group', className]}>
	{label && (
		<p class="ui-chip-group__label" id={labelId}>
			{label}
		</p>
	)}
	<ul class="ui-chip-group__list" role="list" aria-labelledby={labelId}>
		<slot />
	</ul>
</div>

<style is:global lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/surface' as *;

	.ui-chip-group__label {
		@include type-eyebrow;

		margin: 0 0 $spacing-3;
		color: var(--color-text-secondary, #{$color-text-secondary});

		@include on-dark {
			color: rgba(255, 255, 255, 0.6);
		}
	}

	.ui-chip-group__list {
		display: flex;
		flex-wrap: wrap;
		gap: $spacing-2;
		margin: 0;
		padding: 0;
		list-style: none;

		> li {
			display: flex;
		}
	}
</style>
