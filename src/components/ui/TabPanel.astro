---
/**
 * One panel of a `ui/Tabs` set. Named by its tab (`<id>-tab`), hidden unless it is the one shown
 * first; `util/tabs.ts` swaps `hidden` from then on. A panel with nothing focusable inside takes
 * `focusable` so a keyboard user can reach its content after the tabs.
 */
interface Props {
	id: string;
	selected?: boolean;
	focusable?: boolean;
	class?: string;
}

const { id, selected = false, focusable = false, class: className } = Astro.props;
---

<div
	id={id}
	class:list={['ui-tab-panel', className]}
	role="tabpanel"
	aria-labelledby={`${id}-tab`}
	tabindex={focusable ? 0 : undefined}
	hidden={!selected}
>
	<slot />
</div>

<style is:global>
	.ui-tab-panel[hidden] {
		display: none;
	}
</style>
