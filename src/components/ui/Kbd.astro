---
/**
 * A key hint: the key's name in a hairline box, 20 tall, in `currentColor` — "Ctrl K" in the bar's
 * search field, "Esc" on the search dialog's close. Decorative: it sits beside a control that already
 * says what it does, so it is hidden from assistive technology, and the shortcut itself is the
 * control's `aria-keyshortcuts`. Markup a script builds takes the `ui-kbd` mixin (`_kbd.scss`).
 */

interface Props {
	class?: string;
	/** Passed through untouched: `data-*` hooks a script finds the hint by. */
	attrs?: Record<string, string | undefined>;
}

const { class: className, attrs = {} } = Astro.props;
---

<kbd class:list={['ui-kbd', className]} aria-hidden="true" {...attrs}>
	<slot />
</kbd>

<style is:global lang="scss">
	@use '../../styles/kbd' as *;

	.ui-kbd {
		@include ui-kbd;
	}
</style>
