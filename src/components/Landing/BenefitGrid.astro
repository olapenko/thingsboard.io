---
import { Icon } from 'astro-icon/components';
import CardGrid from '@components/ui/CardGrid.astro';
import type { Benefit } from '@data/product-blocks';

/**
 * The product pages' benefit tiles, under each page's "Why" header: three across (four for four
 * tiles, so none is left alone on a row), two across from 750, one on a phone (`ui/CardGrid`'s
 * steps), and no card behind them.
 *
 * No card and no squircle. `FeatureTile` on the homepage is the same kind of item — one glyph, one
 * title, one line of copy — and it draws the glyph solid with no fill behind it. Six of these in a
 * 3x2 is exactly the case that treatment was written for: a filled mark per tile would be an accent
 * system with nothing to decode. What separates the tiles is a hairline over each one rather than a
 * box around it, which gives the grid its columns without putting the cards back.
 */
interface Props {
	items: Benefit[];
}

const { items } = Astro.props;
const cols = items.length === 4 ? 4 : 3;
---

<CardGrid cols={cols} gap="lg" class="benefit-grid">
	{items.map((item) => (
		<div class="benefit-grid__item">
			<Icon
				name={item.icon}
				class="benefit-grid__icon"
				style={item.color ? `color: ${item.color}` : undefined}
				aria-hidden="true"
			/>
			<h3 class="benefit-grid__title">{item.title}</h3>
			<p class="benefit-grid__text">{item.description}</p>
		</div>
	))}
</CardGrid>

<style lang="scss">
	@use '../../styles/variables' as *;

	.benefit-grid__item {
		display: flex;
		flex-direction: column;
		gap: $spacing-2;
		padding-top: $spacing-5;
		border-top: 1px solid var(--color-border);
	}

	// 36, from `FeatureTile`'s 28. That component runs sixteen tiles in a strip where 28 is already a
	// lot of ink; six in a 3x2 have the room, and at 28 on a 304 column the glyph read as a bullet
	// rather than as the tile's mark. The colour arrives inline, per tile.
	.benefit-grid__icon {
		width: 36px;
		height: 36px;
		color: var(--accent-fill);
	}

	// A step above `FeatureTile`'s 16: six in a 3x2 have the room, and at 304 a column the longer
	// titles still hold two lines.
	.benefit-grid__title {
		@include type-tile-lg;

		margin: $spacing-1 0 0;
		color: var(--color-text);
	}

	.benefit-grid__text {
		@include type-body;

		margin: 0;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}
</style>
