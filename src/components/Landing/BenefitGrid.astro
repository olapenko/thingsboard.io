---
import CardGrid from '@components/ui/CardGrid.astro';
import Mark from '@components/ui/Mark.astro';
import type { Benefit } from '@data/product-blocks';

/**
 * The product pages' benefit tiles, under each page's "Why" header: three across (four for four
 * tiles, so none is left alone on a row), two across from 750, one on a phone (`ui/CardGrid`'s
 * steps), and no card behind them.
 *
 * Each glyph sits on a WHITE squircle (`ui/Mark`, `fill="white"`, lifted), in the tile's own hue.
 * The band under the grid is the page's tint, and a bare glyph on it read as loose ink; the white
 * tile gives each one a ground of its own. White rather than a filled mark: six solid accents in a
 * 3x2 would be a colour system with nothing to decode, where white keeps the hue on the glyph
 * alone. What separates the tiles is still a hairline over each one rather than a box around it,
 * which gives the grid its columns without putting the cards back.
 */
interface Props {
	items: Benefit[];
}

const { items } = Astro.props;
const cols = items.length === 4 ? 4 : 3;
---

<CardGrid cols={cols} gap="lg" class="benefit-grid">
	{items.map((item) => (
		<div class="benefit-grid__item">
			<Mark size={48} fill="white" icon={item.icon} accent={item.color} lift />
			<h3 class="benefit-grid__title">{item.title}</h3>
			<p class="benefit-grid__text">{item.description}</p>
		</div>
	))}
</CardGrid>

<style lang="scss">
	@use '../../styles/variables' as *;

	.benefit-grid__item {
		display: flex;
		flex-direction: column;
		gap: $spacing-2;
		padding-top: $spacing-5;
		border-top: 1px solid var(--color-border);
	}

	// A step above `FeatureTile`'s 16: six in a 3x2 have the room, and at 304 a column the longer
	// titles still hold two lines.
	.benefit-grid__title {
		@include type-tile-lg;

		margin: $spacing-1 0 0;
		color: var(--color-text);
	}

	.benefit-grid__text {
		@include type-body;

		margin: 0;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}
</style>
