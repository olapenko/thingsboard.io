---
import mark from '@root/assets/images/landings/draft/thingsboard-mark.svg?raw';
import { CONNECT_ROUTES } from '@data/connect-visual';

/**
 * Connect, as a cloud of tags around the platform rather than four labelled routes into it.
 *
 * A CANDIDATE, in the sandbox only. `ConnectFlow` is what the home preview renders and nothing here
 * touches it — the two share their names and their accents through `connect-visual.ts`, so a
 * protocol added there appears in both, but every other decision is this file's own.
 *
 * What it argues differently: the route version says "there are four ways in, and here is what each
 * one speaks". This says "whatever you have, it is already in here". The first is a better answer
 * to "how do I connect a Modbus PLC"; the second is a better answer to "will this work with my
 * stuff", which is the question a homepage is actually being asked.
 *
 * --- the thing this arrangement costs, and where it went -----------------------------------
 *
 * The captions. In the route version each group is headed by what it IS, and the accent is a
 * second, redundant signal. Take the headings away and the accent carries the whole categorisation
 * on its own — four colours a reader has never been taught. An unexplained colour coding is
 * decoration that looks like information, which is worse than no coding at all.
 *
 * This carried a legend for a while, which fixed that and cost a two-by-two block under the cloud
 * saying four things the section's own copy was already most of the way to saying. That legend then
 * moved into the copy as four colour-marked terms, and has now been removed from there too.
 *
 * So the four accents currently teach nobody anything: they group twenty-four names into families
 * that the page never names. Read that as texture rather than as a coding — which is a decision,
 * not an oversight, and the thing to revisit if the grouping turns out to matter. The body copy
 * still lists the four routes in words; it just no longer points at the colours.
 */

// Measured, not chosen — see the note below on how the rows were balanced. Set to the widest row
// (418) at the narrowest unit this is drawn at, with a few units left for a font that renders
// wider. Re-measure it after any change to the names, the gap or the chip padding.
//
// It is measured in Ubuntu Mono, and it is only true in Ubuntu Mono: the same chips in Ubuntu run
// about 4% wider on these strings, which takes the rows past this number. A composition balanced by
// hand is balanced for one face, so changing the chips' typeface means measuring this again — and
// until then `flex-wrap` below is what keeps the failure honest.
interface Props {
	/**
	 * How a chip carries its route.
	 *
	 *   tint — a wash of the accent behind ink text. Reads as one mass at a glance, which is what a
	 *          cloud wants, and is the weakest of the three at saying WHICH route any one chip is.
	 *   text — white chip, the name itself in the accent. The strongest coding, and the one that
	 *          survives being read one chip at a time, but four coloured words per row is a lot of
	 *          colour for a page that already has a badge and a heading in it.
	 */
	chipStyle?: 'tint' | 'text';
}

const { chipStyle = 'tint' } = Astro.props;

const NATIVE = 422;

const CHIP_H = 32;
const GAP = 6;

// The hole the middle rows leave for the squircle. There is no plate under it any more — that was
// a white card in the reference sketch, which turned out to be the screenshot's own background
// showing through rather than part of the composition. The rows already leave the space, so the
// card was masking nothing.
//
// Sized so the three rows it spans clear the badge vertically — 3 chips at 32 plus 2 gaps at 6 is
// 108 against the badge's 104 — and so that it does NOT clear it horizontally.
//
// The arithmetic is easy to get wrong by one term, and it moves whenever GAP does. The squircle
// overhangs the hole by (104 - 76) / 2 = 14 units a side, and the first GAP of those only crosses
// the grid gap between the hole and the chip beside it. So the bite out of the chip is 14 - 6 = 8
// units — less than a chip's own 10 units of padding, and therefore landing on padding rather than
// on a glyph. (An earlier 88-unit hole made the overhang exactly the gap, and the badge merely
// touched the chips: measured zero overlap. Closing GAP without reopening HOLE would do the
// opposite and put the bite through the first letter.)
//
// Eight units is enough to read as the app sitting ON the cloud rather than in a slot cut out of
// it, without a clipped letter that reads as a bug.
const BADGE = 104;
const HOLE = 76;

/** Category -> accent, so the colour coding cannot drift from the routes it codes. */
const ACCENT_BY_CATEGORY = new Map(CONNECT_ROUTES.map((r) => [r.category, r.accent] as const));

/**
 * Names this cut carries beyond the route version's, and where each one is documented.
 *
 * They live here rather than in `connect-visual.ts` because `ConnectFlow` fits exactly one row of
 * chips per route — a sixth name there wraps the card and overflows a fixed height. A cloud has no
 * such constraint, so it can afford the longer answer to "is my thing supported".
 *
 * Every name is on a page in this repo:
 *
 *   Sparkplug B  — its own row in the Direct Connection table, `connectivity-guide.mdx`. It is a
 *                  payload convention over MQTT rather than a sixth transport, which is why the
 *                  five transports beside it are the complete set and this is the one addition.
 *   CAN, OCPP    — two of the gateway's fifteen built-in connectors,
 *                  `_includes/docs/iot-gateway/connectors.mdx`.
 *   ThingPark    — a LoRaWAN network server, from the integration type list rendered at
 *                  /docs/pe/user-guide/integrations/.
 *   RabbitMQ,    — messaging integrations from that same list.
 *   AWS SQS
 *
 * Cut from an earlier, longer draft, on the grounds that a cloud is only persuasive while every
 * name in it is one somebody recognises: ODBC and Socket (generic where the rest are protocols),
 * Pulsar (Kafka and RabbitMQ already carry messaging), TCP and UDP (they say less than the named
 * integrations beside them), KPN Things (regional, and the least recognised name in the set).
 *
 * Deliberately never here: IBM Watson and Everynet (no doc page — the first survives only as a dead
 * enum value in two config dumps), and OceanConnect (same). A name in a marketing visual has to be
 * a page someone can be sent to.
 */
const EXTRA: Record<string, string[]> = {
	'Direct connection': ['Sparkplug B'],
	'IoT Gateway': ['CAN', 'OCPP'],
	'LoRaWAN & LPWAN': ['ThingPark'],
	'Platform integrations': ['RabbitMQ', 'AWS SQS'],
};

const ACCENT = new Map<string, string>([
	...CONNECT_ROUTES.flatMap((r) => r.names.map((n) => [n, r.accent] as const)),
	...Object.entries(EXTRA).flatMap(([category, names]) =>
		names.map((n) => [n, ACCENT_BY_CATEGORY.get(category)!] as const)
	),
]);

/**
 * The cloud, authored row by row.
 *
 * Hand-placed rather than generated: a random scatter reads as a mess about one time in three, and
 * this has to be the same picture on every load. Three rules behind the arrangement — no two
 * neighbours share an accent (including across the hole), every row carries at least three of the
 * four, and the rows come out close enough in width that the silhouette is a block rather than a
 * lens.
 *
 * That last one is why the straddle rows carry two a side. The hole plus its two gaps is 104 units
 * that a full row does not pay, so a straddle row needs about two fewer chips than a full one to
 * measure the same — six across and two a side is the pairing that lands. The side pairs are also
 * chosen to sum alike, around 159 units each, so the two `1fr` tracks resolve close together and no
 * row has an obviously long side.
 *
 * `left`/`right` rows straddle the badge. The three of them are the band it covers.
 */
const ROWS: ({ chips: string[] } | { left: string[]; right: string[]; plate?: true })[] = [
	{ chips: ['Modbus', 'MQTT', 'Sigfox', 'Pub/Sub', 'BLE', 'HTTP'] },
	{ left: ['Sparkplug B', 'KNX'], right: ['RabbitMQ', 'LORIOT'] },
	{ left: ['Azure IoT', 'LwM2M'], right: ['ChirpStack', 'OCPP'], plate: true },
	{ left: ['ThingPark', 'Kafka'], right: ['BACnet', 'AWS IoT'] },
	{ chips: ['CoAP', 'OPC UA', 'TTN', 'AWS SQS', 'CAN', 'SNMP'] },
];

// Every name placed above has to be one this component knows, and every name it knows has to be
// placed — otherwise adding a protocol silently drops it from this visual, or renaming one silently
// drops its colour. Both are the kind of failure nobody notices in a screenshot.
const placed = ROWS.flatMap((r) => ('chips' in r ? r.chips : [...r.left, ...r.right]));
const missing = placed.filter((n) => !ACCENT.has(n));
const unplaced = [...ACCENT.keys()].filter((n) => !placed.includes(n));
if (missing.length || unplaced.length) {
	throw new Error(
		`ConnectCloud is out of step with its name list.` +
			(missing.length ? ` Not in CONNECT_ROUTES or EXTRA: ${missing.join(', ')}.` : '') +
			(unplaced.length ? ` Known but not placed: ${unplaced.join(', ')}.` : '')
	);
}

const vars = [
	`--cl-u: min(1.15px, calc(100cqw / ${NATIVE}))`,
	`--cl-native: ${NATIVE}`,
	`--cl-chip-h: ${CHIP_H}`,
	`--cl-gap: ${GAP}`,
	`--cl-hole: ${HOLE}`,
	`--cl-badge: ${BADGE}`,
].join('; ');
---

<div class="cl-fit">
	<div class="cl" style={vars} data-chip={chipStyle}>
		{
			ROWS.map((row) =>
				'chips' in row ? (
					<ul class="cl__row">
						{row.chips.map((n) => (
							<li style={`--cl-accent: ${ACCENT.get(n)}`}>
								<span class="cl__chip">{n}</span>
							</li>
						))}
					</ul>
				) : (
					<div class="cl__row cl__row--split">
						<ul class="cl__side cl__side--l">
							{row.left.map((n) => (
								<li style={`--cl-accent: ${ACCENT.get(n)}`}>
									<span class="cl__chip">{n}</span>
								</li>
							))}
						</ul>

						{/* Only the middle hole carries the badge; the other two are just space. */}
						<div class="cl__hole">{row.plate && <span class="cl__badge" aria-hidden="true" set:html={mark} />}</div>

						<ul class="cl__side cl__side--r">
							{row.right.map((n) => (
								<li style={`--cl-accent: ${ACCENT.get(n)}`}>
									<span class="cl__chip">{n}</span>
								</li>
							))}
						</ul>
					</div>
				)
			)
		}
	</div>
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	.cl-fit {
		container-type: inline-size;
	}

	.cl {
		--u: var(--cl-u);
		display: grid;
		// `minmax(0, 1fr)`, not the implicit `auto` column. An auto track takes its max-content size,
		// which is the widest row — so `max-width: 100%` on a straddle row resolved against a track
		// wider than the composition and never bit, and the full rows had no width to wrap against
		// either. The rows overflowed and `.cl` merely clipped the result. Pinning the track to the
		// container is what makes both of those constraints real.
		grid-template-columns: minmax(0, 1fr);
		gap: u(var(--cl-gap));
		justify-items: center;
		max-width: u(var(--cl-native));
		margin-inline: auto;
	}

	.cl__row {
		display: flex;
		// Never used by the design — every row fits the native width in Ubuntu Mono, measured. It is
		// here for what happens when something makes a row wider than the composition was measured
		// for: a name gains a character, the gap closes, the typeface changes. Wrapping says
		// "this no longer fits"; without it the chips simply leave the box, which reads as broken.
		flex-wrap: wrap;
		gap: u(var(--cl-gap));
		justify-content: center;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	// Two equal outer tracks with the plate's width between them, so the hole is centred in the row
	// by construction rather than by anything having to balance.
	//
	// Sized `max-content`, not `100%`. Under max-content both `1fr` tracks resolve to the WIDER of
	// the two groups, which is what makes them equal while leaving the row only as wide as it needs
	// to be. At `100%` the fr tracks absorbed every spare pixel instead: all three straddle rows
	// stretched to the full native width and the middle of the cloud became a band of air with the
	// chips pinned to the plate.
	.cl__row--split {
		display: grid;
		grid-template-columns: 1fr u(var(--cl-hole)) 1fr;
		gap: u(var(--cl-gap));
		align-items: center;
		width: max-content;
		max-width: 100%;
	}

	.cl__row li,
	.cl__side li {
		display: flex;
	}

	.cl__side {
		display: flex;
		flex-wrap: wrap;
		gap: u(var(--cl-gap));
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.cl__side--l {
		justify-content: flex-end;
	}

	.cl__side--r {
		justify-content: flex-start;
	}

	// The list item is the grid cell; the chip inside it is the thing that will become a link.
	// Splitting them now means adding an href later changes one element and no geometry: a chip is
	// already a self-contained box with its own hover and focus states, and `<span>` and `<a>` lay
	// out identically once both are `inline-flex` with the same metrics.
	.cl__chip {
		display: inline-flex;
		align-items: center;
		height: u(var(--cl-chip-h));
		padding: 0 u(10);
		border-radius: u(var(--flow-radius, 8));
		font-family: $font-family-mono;
		font-size: u(17);
		font-weight: $font-weight-bold;
		line-height: u(24);
		color: var(--color-text);
		text-decoration: none;
		white-space: nowrap;
		transition:
			background-color 0.12s ease,
			box-shadow 0.12s ease;
	}

	// Nothing any style adds has a width, and that is a rule rather than a coincidence. Both of the
	// obvious ways to mark a chip cost layout: a 1px border is 1px whatever the design unit is — it
	// does not scale, and six of them to a row was enough to push the rows past the 422 this
	// composition is balanced at and wrap all five — and a coloured dot is 9 units of content plus
	// its gap, which wrapped every row at every width. Both were tried and both are gone. Anything
	// added here has to paint inside the box the balance was measured with.

	// --- the two codings ----------------------------------------------------------------------

	// A wash of the accent behind ink text.
	//
	// The strength comes from `--connect-tint` rather than being written in, because the marked
	// terms in the section's copy use the same wash and the two have to move together — a lighter
	// chip beside an 18% mark is two codings, not one. The sandbox sets the property on :root; with
	// nothing set, 18% stands.
	.cl[data-chip='tint'] .cl__chip {
		background: color-mix(in srgb, var(--cl-accent) var(--connect-tint, 18%), transparent);
	}

	// White chip, the name itself in the accent, and no edge at all.
	//
	// The accent is darkened to 80% for text and only for text: the paler routes do not clear 4.5:1
	// on white at full strength. Darkening all four rather than patching one keeps them a set, and
	// the chips elsewhere still use the undarkened value. This 80% is also the constraint that
	// picked the lime in connect-visual.ts — see the note there.
	//
	// Without a hairline this style depends entirely on the ground it is drawn on: it reads on the
	// row's wash and disappears on white, which the sandbox's own frame is.
	.cl[data-chip='text'] .cl__chip {
		background: var(--color-bg, #fff);
		color: color-mix(in srgb, var(--cl-accent) 80%, #000);
	}

	// --- hover, prepared -------------------------------------------------------------------------

	// These chips are going to be links to the connectivity guide and the connector pages. Nothing
	// carries an href yet, so they render as <span> and the states below are here to be judged, not
	// used. When the hrefs land, `<span class="cl__chip">` becomes `<a class="cl__chip" href>` and
	// nothing else in this file changes — including the focus ring, which a span can never show.
	.cl__chip:hover,
	.cl__chip:focus-visible {
		cursor: pointer;
	}

	// Hover is a fixed step above whatever the resting tint is, so a lighter chip still has a
	// noticeable one.
	.cl[data-chip='tint'] .cl__chip:hover,
	.cl[data-chip='tint'] .cl__chip:focus-visible {
		background: color-mix(in srgb, var(--cl-accent) calc(var(--connect-tint, 18%) + 14%), transparent);
	}

	.cl[data-chip='text'] .cl__chip:hover,
	.cl[data-chip='text'] .cl__chip:focus-visible {
		background: color-mix(in srgb, var(--cl-accent) 12%, transparent);
	}

	.cl__chip:focus-visible {
		outline: 2px solid color-mix(in srgb, var(--cl-accent) 70%, #000);
		outline-offset: 2px;
	}

	// --- the platform --------------------------------------------------------------------------

	.cl__hole {
		position: relative;
		height: u(var(--cl-chip-h));
	}

	// Centred on the middle row of the three, so it covers the band whatever the rows above and
	// below happen to weigh. Out of flow, so it cannot push the row it sits in.
	.cl__badge {
		position: absolute;
		top: 50%;
		left: 50%;
		// Above the chips it overhangs. Without this the right-hand group — which follows the hole in
		// the markup — paints over the squircle instead, and the overlap reads the wrong way round.
		z-index: 1;
		transform: translate(-50%, -50%);
		display: flex;
		align-items: center;
		justify-content: center;
		width: u(var(--cl-badge));
		height: u(var(--cl-badge));
		padding: u(16);
		// The page's shared squircle, at the same 69% mark-to-tile the route version settled on.
		border-radius: 32%;
		color: var(--color-white, #fff);
		background: var(--color-primary, #3d50f5);
		box-shadow: var(
			--flow-shadow-badge,
			0 1px 2px rgba(16, 24, 40, 0.06),
			0 #{u(7)} #{u(16)} #{u(-5)} rgba(16, 24, 40, 0.22)
		);
	}
</style>
