---
import { Icon } from 'astro-icon/components';
import { SOLUTION_CASES, SPARK_WINDOW } from '@data/solution-flow';
import { sparkPaths } from '@util/sparkline';

/**
 * Device to end-user, redrawn to the compact family's scale. A CANDIDATE beside `SolutionFlow`.
 * See `ConnectCompact.astro` for the rule the family is built to: 448 units wide, nothing under
 * 16u, so the smallest type lands at 12px on a phone and 16px in the home row.
 *
 * This one had the worst R of the five — 57, from an 11u browser bar in a 630-unit composition,
 * which is 5.8px on a phone. Two things had to go to fix it:
 *
 *   1. The browser chrome. It was the 11u, and it was decoration: the host name says
 *      "white-labelled" faster than anything else on the card, so it is promoted into the brand
 *      bar at 16u rather than dropped.
 *   2. The third column. Three columns of 630 units become three of 448, and at 16u a list row
 *      needs about 150u. Two stages stack down the left instead, which also suits a phone: the
 *      composition loses width before it loses anything else.
 *
 * The shell is static here. `SolutionAppShell` rotates three brands on a timer and is 710 lines
 * of tween bookkeeping; this candidate is about whether the SIZE works, and an animation that
 * has to be re-fitted anyway would only be in the way. Northwind Fuel is the brand the shipped
 * row happens to be showing.
 */

const STAGES = [
	{
		caption: 'Connect devices',
		rows: [
			{ icon: 'tabler:cpu', label: 'Sensors' },
			{ icon: 'tabler:router', label: 'Gateways' },
			{ icon: 'tabler:building-factory-2', label: 'Machines' },
			{ icon: 'tabler:gauge', label: 'Meters' },
		],
	},
	{
		caption: 'Build the solution',
		rows: [
			{ icon: 'tabler:binary-tree', label: 'Digital twins' },
			{ icon: 'tabler:git-branch', label: 'Rule chains' },
			{ icon: 'tabler:bell-ringing', label: 'Alarms' },
			{ icon: 'tabler:layout-dashboard', label: 'Dashboards' },
		],
	},
];

const NATIVE = 448;
const COL = 208;
const GUT = NATIVE - COL * 2; // 32

// The sparkline's own box, in design units. Drawn with preserveAspectRatio="none", which is safe:
// a cubic Bezier is affine-invariant, so a stretched curve is the spline of the stretched points.
const SPARK = { w: 184, h: 64, pad: 4 };

const app = SOLUTION_CASES[1];
// Not `window`: shadowing the global reads as a mistake even where there is no DOM.
const win = Math.min(SPARK_WINDOW, app.series.length);
const shown = app.series.slice(0, win);
const reading = shown[shown.length - 1];
const { line, area } = sparkPaths(shown, app.domain ?? [0, 100], SPARK, win);

const vars = [
	`--sc-u: min(1px, calc(100cqw / ${NATIVE}))`,
	`--sc-native: ${NATIVE}`,
	`--sc-col: ${COL}`,
	`--sc-gut: ${GUT}`,
	`--sc-accent: ${app.brand.accent}`,
].join(';');
---

<div class="sc-fit">
	<div class="sc" style={vars}>
		<div class="sc__stack">
			{
				STAGES.map((s) => (
					<section class="sc__stage">
						<p class="sc__cap">{s.caption}</p>
						<ul class="sc__rows">
							{s.rows.map((r) => (
								<li class="sc__row">
									<Icon name={r.icon} />
									<span>{r.label}</span>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>

		<section class="sc__stage sc__stage--app">
			<p class="sc__cap">Ship to your users</p>

			<div class="sc__app">
				<header class="sc__brand">
					<span class="sc__mark"><Icon name={app.brand.icon} /></span>
					<span class="sc__host">{app.brand.host}</span>
				</header>

				<div class="sc__body">
					<p class="sc__metric">{app.metricLabel}</p>
					<p class="sc__value">
						{reading.toFixed(app.decimals ?? 0)}<span class="sc__unit">{app.unit}</span>
					</p>

					<svg class="sc__spark" viewBox={`0 0 ${SPARK.w} ${SPARK.h}`} preserveAspectRatio="none" aria-hidden="true">
						<path class="sc__area" d={area}></path>
						<path class="sc__line" d={line}></path>
					</svg>

					<p class="sc__alarm">
						<Icon name="tabler:alert-triangle" />
						{app.alarms} alarm
					</p>
				</div>
			</div>
		</section>
	</div>
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	.sc-fit {
		container-type: inline-size;
	}

	.sc {
		--u: var(--sc-u);
		display: grid;
		grid-template-columns: u(var(--sc-col)) u(var(--sc-col));
		gap: u(var(--sc-gut));
		max-width: u(var(--sc-native));
		margin-inline: auto;
	}

	.sc__stack {
		display: grid;
		gap: u(18);
		align-content: start;
	}

	.sc__cap {
		margin: 0 0 u(6);
		font-size: u(16);
		line-height: u(18);
		font-weight: $font-weight-medium;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-text-secondary, #5b616e);
		white-space: nowrap;
	}

	.sc__rows {
		margin: 0;
		padding: u(10);
		border: 1px solid var(--color-border, #ebebeb);
		border-radius: u(10);
		background: var(--color-bg, #fff);
		list-style: none;
	}

	.sc__row {
		display: flex;
		align-items: center;
		gap: u(8);
		height: u(24);
		font-size: u(17);
		color: var(--color-text, #171c22);
		white-space: nowrap;

		:global([data-icon]) {
			width: u(18);
			height: u(18);
			color: var(--color-text-secondary, #5b616e);
		}
	}

	// --- the app ------------------------------------------------------------------------------

	.sc__app {
		display: flex;
		flex-direction: column;
		height: u(274);
		border-radius: u(10);
		overflow: hidden;
		background: var(--color-bg, #fff);
		box-shadow:
			0 u(1) u(2) rgba(23, 28, 34, 0.08),
			0 u(4) u(14) rgba(23, 28, 34, 0.1);
	}

	// The brand bar carries the customer's colour and their own domain. It is the whole claim of
	// this visual, so it is the one thing drawn at full strength.
	.sc__brand {
		display: flex;
		align-items: center;
		gap: u(8);
		height: u(34);
		padding: 0 u(10);
		background: var(--sc-accent, #3d50f5);
		color: #fff;

		:global([data-icon]) {
			width: u(18);
			height: u(18);
		}
	}

	.sc__host {
		font-size: u(16);
		font-weight: $font-weight-medium;
	}

	.sc__body {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: u(12);
	}

	.sc__metric {
		margin: 0;
		font-size: u(16);
		line-height: u(18);
		color: var(--color-text-secondary, #5b616e);
	}

	.sc__value {
		margin: u(2) 0 u(8);
		font-size: u(38);
		line-height: u(42);
		font-weight: $font-weight-bold;
		color: var(--color-text, #171c22);
	}

	.sc__unit {
		font-size: u(22);
		font-weight: $font-weight-medium;
		color: var(--color-text-secondary, #5b616e);
	}

	.sc__spark {
		width: 100%;
		max-width: none;
		height: u(64);
		flex: 1;
	}

	.sc__area {
		fill: color-mix(in srgb, var(--sc-accent, #3d50f5) 14%, transparent);
	}

	.sc__line {
		fill: none;
		stroke: var(--sc-accent, #3d50f5);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
	}

	.sc__alarm {
		display: flex;
		align-items: center;
		gap: u(6);
		margin: u(10) 0 0;
		padding-top: u(10);
		border-top: 1px solid var(--color-border, #ebebeb);
		font-size: u(16);
		color: var(--color-text-secondary, #5b616e);

		:global([data-icon]) {
			width: u(16);
			height: u(16);
			color: #b45309;
		}
	}
</style>
