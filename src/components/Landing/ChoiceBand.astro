---
import { Icon } from 'astro-icon/components';
import Band from '@components/ui/Band.astro';
import Button from '@components/ui/Button.astro';
import ButtonGroup from '@components/ui/ButtonGroup.astro';
import Card from '@components/ui/Card.astro';
import CardGrid from '@components/ui/CardGrid.astro';
import Link from '@components/ui/Link.astro';
import SectionHeader from '@components/Landing/SectionHeader.astro';
import type { ChoiceNote, ChoiceOption } from '@data/product-blocks';

/**
 * THE CHOICE: the "which edition" band, under the comparison that informs it. Cloud's Public or
 * Private, On-premises' subscription or perpetual licence. Judged at `/internal/sections/choice/`.
 *
 * It was two buttons under the table, with the same decision also put as a full section at the top
 * of the page: one decision asked twice, the first time before the reader had seen anything to
 * decide on. These are the top section's cards, moved down and given the entry price and their own
 * call to action.
 *
 * Built from the kit: the ground and the wave are a `Band` (dark, the page's hero ground, so the
 * page's two dark moments are one colour), the header a `SectionHeader`, the cards `ui/Card`s in
 * the `ghost` tone — a panel ON the ground rather than a card cut out of it, since a white card
 * would hide the field the band has one for — and the actions a `ButtonGroup` and a `ui/Link`. Each
 * card holds two actions, so it is not a link itself: an anchor cannot contain another.
 *
 * The scheme comes from the nearest `data-accent` (or `accent`), so the primary, the prices and the
 * checks take the page's colour.
 */
interface Props {
	title: string;
	lead?: string;
	options: ChoiceOption[];
	/** The line under the cards. */
	note?: ChoiceNote;
	/**
	 * The product the options are editions of, for the hidden suffix that names each card's actions
	 * out of context: "Start for free — ThingsBoard Public Cloud", "See plans for ThingsBoard
	 * Public Cloud". Omit it where the options are not products (On-premises' licences), and the
	 * option is named on its own: "— Monthly subscription", "See plans for the Monthly subscription".
	 */
	productName?: string;
	id?: string;
	accent?: 'brand' | 'onprem';
	/** The dark ground, where the page has its own (On-premises' green-cast near-black). */
	ground?: string;
	/**
	 * The field's hue. A LIFTED tone, not the accent: it is drawn at 3.5–10% opacity, where the
	 * accent all but vanishes. Default: the pricing field's own blue, which Cloud's band has always
	 * drawn.
	 */
	waveHue?: string;
}

const { title, lead, options, note, productName, id = 'choose', accent, ground, waveHue = '#3369ff' } = Astro.props;

// Each card's actions read "Start for free" and "See plans" — fine beside their own heading,
// ambiguous in a list of every link on the page.
const ctaSuffix = (option: ChoiceOption) => `— ${productName ? `${productName} ` : ''}${option.name}`;
const plansSuffix = (option: ChoiceOption) => `for ${productName ?? 'the'} ${option.name}`;
---

<Band id={id} ground="dark" groundColor={ground} wave waveHue={waveHue} pad="lg" accent={accent}>
	<SectionHeader title={title} subtitle={lead} subtitleMeasure="copy" spacing="md" />

	<CardGrid cols={2} gap="lg">
		{
			options.map((option) => (
				<Card tone="ghost" pad="lg" class="choice-band__card">
					<h3 class="choice-band__name">
						{option.icon && <Icon name={option.icon} class="choice-band__mark" aria-hidden="true" />}
						{option.name}
					</h3>
					{option.price && (
						<p class="choice-band__price">
							{option.price}
							{option.priceNote && <span class="choice-band__price-note">{option.priceNote}</span>}
						</p>
					)}
					{option.summary && <p class="choice-band__summary">{option.summary}</p>}
					<ul class="choice-band__points">
						{option.points.map((point) => (
							<li>
								<Icon name="tabler:check" aria-hidden="true" />
								{point}
							</li>
						))}
					</ul>
					<ButtonGroup slot="footer" class="choice-band__actions">
						<Button
							variant={option.cta.variant}
							icon={option.cta.icon}
							href={option.cta.href}
							attrs={option.cta.attrs}
							srSuffix={ctaSuffix(option)}
						>
							{option.cta.text}
						</Button>
						{option.plansHref && (
							<Link href={option.plansHref} tone="ink" srSuffix={plansSuffix(option)}>
								See plans
							</Link>
						)}
					</ButtonGroup>
				</Card>
			))
		}
	</CardGrid>

	{
		note && (
			<p class="choice-band__note">
				<Icon name={note.icon} class="choice-band__note-mark" aria-hidden="true" />
				{note.lead}
				<Link variant="inline" tone="ink" href={note.link.href}>
					{note.link.text}
				</Link>
				{note.tail}
			</p>
		)
	}
</Band>

<style lang="scss">
	@use '../../styles/variables' as *;

	.choice-band__card {
		gap: $spacing-3;
	}

	.choice-band__name {
		@include subsection-title;

		display: flex;
		align-items: center;
		gap: $spacing-3;
		margin: 0;
		color: #fff;
	}

	// Sized in `em` so it tracks the name through its 32 -> 24 step below 750 rather than needing a
	// breakpoint of its own.
	.choice-band__mark {
		flex: none;
		width: 1em;
		height: 1em;
		color: #fff;
	}

	// The entry number and nothing else. One step under the name: the name identifies the option and
	// the price qualifies it, so the eye should land on "Public Cloud" and then on "Free", not the
	// other way round. The name steps 32 -> 24 below 750, so this steps with it — left at a flat 24
	// the two would tie on a phone and the order would stop reading.
	.choice-band__price {
		@include type-card;

		display: flex;
		flex-direction: column;
		gap: 2px;
		margin: 0;
		// The scheme's light tone: the fill itself is 2.1:1 on this ground and unreadable as text.
		color: var(--accent-light);

		@include media-down(md) {
			font-size: $font-size-xl;
		}
	}

	.choice-band__price-note {
		@include type-body;

		color: rgba(255, 255, 255, 0.6);
	}

	.choice-band__summary {
		@include type-body;

		margin: 0;
		color: rgba(255, 255, 255, 0.72);
	}

	.choice-band__points {
		@include type-body;

		display: flex;
		flex-direction: column;
		gap: $spacing-2;
		margin: $spacing-2 0 0;
		padding: 0;
		list-style: none;

		li {
			display: flex;
			align-items: flex-start;
			gap: $spacing-2;
		}

		// Optical centring on a 24px line, rather than the 2px a 22px line wanted.
		:global(svg) {
			flex: none;
			width: 20px;
			height: 20px;
			margin-top: 2px;
			color: var(--accent-light);
		}
	}

	// The card's footer is pinned to its bottom, which is what keeps the two cards' buttons on one
	// line across the pair when their lists run to different lengths.
	.choice-band__actions {
		padding-top: $spacing-6;
	}

	// The exit to the other deployment, under the two this band is about: a line rather than a card,
	// since a third option in the grid would flatten the choice it has just set up. Its mark is
	// `aria-hidden` and carries no meaning the words do not.
	.choice-band__note {
		@include type-body;

		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: $spacing-2;
		margin: $spacing-10 0 0;
		color: rgba(255, 255, 255, 0.72);
	}

	// An outline glyph with detail inside it, which wants the room a 14px rhombus did not.
	.choice-band__note-mark {
		flex: none;
		width: 22px;
		height: 22px;
		color: #fff;
	}
</style>
