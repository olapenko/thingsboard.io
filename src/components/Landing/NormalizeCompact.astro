---
import {
	NORMALIZE_CASES,
	NORMALIZE_STAGES,
	NORMALIZE_NODE,
	NORMALIZE_KEY,
	payloadTokens,
	readingText,
} from '@data/normalize-visual';

/**
 * Turn IoT data into action, redrawn to the compact family's scale. A CANDIDATE beside
 * `NormalizeFlow`. See `ConnectCompact.astro` for the rule: 448 units, nothing under 16u, R = 28.
 *
 * The one real edit is on the right. The full-size version repeats the key on every row —
 * "temperature 24.5 °C", four times — which at 448 units would need 143 units of column for what
 * is the same word four times over. Here the key is stated once, as the column's own subtitle, and
 * the rows carry readings only. That is not just a saving: "one data model" is a claim about there
 * being ONE key, and saying it once says it better than saying it four times.
 *
 * Static, where the shipped visual animates its readings. The animation is worth keeping and
 * should come back if this cut wins — it is left out here so the size is judged on its own.
 */

const NATIVE = 448;
// Sized right to left. The out column is set by its caption ("One data model", 105u at 16u), the
// in column by its widest chip (TEMP_K=293.8, 12 mono characters at 8u plus padding = 112u), the
// node by its own label, and the gutters take what is left — which is where curves want it anyway.
const COL = { in: 116, gut: 60, node: 96, out: 116 };

const CHIP_H = 30;
const CHIP_GAP = 12;
const BODY_H = NORMALIZE_CASES.length * CHIP_H + (NORMALIZE_CASES.length - 1) * CHIP_GAP;
const MID = BODY_H / 2;

const centres = NORMALIZE_CASES.map((_, i) => CHIP_H / 2 + i * (CHIP_H + CHIP_GAP));

// Horizontal control points at the gutter's midpoint, so every curve leaves flat and arrives flat.
const bend = COL.gut / 2;
const converge = centres.map((cy) => `M 0,${cy} C ${bend},${cy} ${bend},${MID} ${COL.gut},${MID}`);
const diverge = centres.map((cy) => `M 0,${MID} C ${bend},${MID} ${bend},${cy} ${COL.gut},${cy}`);

const vars = [
	`--nc-u: min(1px, calc(100cqw / ${NATIVE}))`,
	`--nc-native: ${NATIVE}`,
	`--nc-in: ${COL.in}`,
	`--nc-gut: ${COL.gut}`,
	`--nc-node: ${COL.node}`,
	`--nc-out: ${COL.out}`,
	`--nc-body-h: ${BODY_H}`,
	`--nc-chip-h: ${CHIP_H}`,
	`--nc-chip-gap: ${CHIP_GAP}`,
].join(';');
---

<div class="nc-fit">
	<div class="nc" style={vars}>
		<p class="nc__cap nc__cap--in">{NORMALIZE_STAGES.in}</p>
		<p class="nc__cap nc__cap--out">
			{NORMALIZE_STAGES.out}
			<span class="nc__key">{NORMALIZE_KEY} · °C</span>
		</p>

		<ul class="nc__in">
			{
				NORMALIZE_CASES.map((c) => (
					<li class="nc__chip" title={c.note}>
						{payloadTokens(c).map((t) => (
							<span class={`nc__t nc__t--${t.role}`}>{t.t}</span>
						))}
					</li>
				))
			}
		</ul>

		<svg
			class="nc__wires nc__wires--l"
			viewBox={`0 0 ${COL.gut} ${BODY_H}`}
			preserveAspectRatio="none"
			aria-hidden="true"
			focusable="false"
		>
			{converge.map((d) => <path class="nc__wire" d={d} />)}
		</svg>

		<div class="nc__node"><span class="nc__pill">{NORMALIZE_NODE.label}</span></div>

		<svg
			class="nc__wires nc__wires--r"
			viewBox={`0 0 ${COL.gut} ${BODY_H}`}
			preserveAspectRatio="none"
			aria-hidden="true"
			focusable="false"
		>
			{diverge.map((d) => <path class="nc__wire" d={d} />)}
		</svg>

		<ul class="nc__out">
			{NORMALIZE_CASES.map((c) => <li class="nc__reading">{readingText(c)}</li>)}
		</ul>
	</div>
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	.nc-fit {
		container-type: inline-size;
	}

	.nc {
		--u: var(--nc-u);
		// Dark-ground syntax values. The light-surface set would be all but invisible on the chips.
		--nc-syn-key: #d2a8ff;
		--nc-syn-num: #ffb86b;
		--nc-syn-unit: #7ee787;
		--nc-syn-punct: #9aa4b2;

		display: grid;
		grid-template-columns: u(var(--nc-in)) u(var(--nc-gut)) u(var(--nc-node)) u(var(--nc-gut)) u(var(--nc-out));
		grid-template-rows: auto auto;
		align-items: center;
		max-width: u(var(--nc-native));
		margin-inline: auto;
	}

	// Captions run over their column AND the gutter beside it. The gutter is empty at this height,
	// and holding "Mixed payloads" inside 116 units would have meant either a smaller word or a
	// wider column — and the column is already set by something that matters more.
	.nc__cap {
		grid-row: 1;
		align-self: end;
		margin: 0 0 u(8);
		font-size: u(16);
		line-height: u(18);
		font-weight: $font-weight-medium;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-text-secondary, #5b616e);
		white-space: nowrap;
	}

	.nc__cap--in {
		grid-column: 1 / 3;
	}

	.nc__cap--out {
		grid-column: 4 / 6;
		text-align: right;
	}

	// The key, said once. Lower case and mono because it is an identifier, not a label.
	.nc__key {
		display: block;
		margin-top: u(2);
		font-family: var(--flow-font-mono, #{$font-family-mono});
		font-size: u(16);
		font-weight: $font-weight-normal;
		letter-spacing: 0;
		text-transform: none;
		color: var(--color-text, #171c22);
	}

	.nc__in,
	.nc__out {
		grid-row: 2;
		display: grid;
		gap: u(var(--nc-chip-gap));
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.nc__in {
		grid-column: 1;
	}

	.nc__out {
		grid-column: 5;
	}

	.nc__chip {
		display: flex;
		align-items: center;
		height: u(var(--nc-chip-h));
		padding: 0 u(8);
		border-radius: u(6);
		background: var(--flow-chrome, #1b1e27);
		font-family: var(--flow-font-mono, #{$font-family-mono});
		font-size: u(16);
		white-space: nowrap;
	}

	.nc__t--key {
		color: var(--nc-syn-key);
	}

	.nc__t--num {
		color: var(--nc-syn-num);
	}

	.nc__t--unit {
		color: var(--nc-syn-unit);
	}

	.nc__t--punct {
		color: var(--nc-syn-punct);
	}

	.nc__reading {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		height: u(var(--nc-chip-h));
		padding: 0 u(8);
		border: 1px solid var(--color-border, #ebebeb);
		border-radius: u(6);
		background: var(--color-bg, #fff);
		font-size: u(17);
		font-weight: $font-weight-medium;
		color: var(--color-text, #171c22);
		white-space: nowrap;
	}

	// Both connectors name their own column. Auto-placement would put them wherever the row had
	// room, which is not the same thing as where the curve's endpoints are.
	.nc__wires {
		grid-row: 2;
		width: 100%;
		max-width: none;
		height: u(var(--nc-body-h));
	}

	.nc__wires--l {
		grid-column: 2;
	}

	.nc__wires--r {
		grid-column: 4;
	}

	.nc__node {
		grid-row: 2;
		grid-column: 3;
		display: grid;
		place-items: center;
	}

	.nc__pill {
		padding: u(6) u(12);
		border-radius: 999px;
		background: var(--color-primary, #3d50f5);
		font-size: u(16);
		line-height: u(18);
		font-weight: $font-weight-medium;
		color: #fff;
		white-space: nowrap;
	}

	.nc__wire {
		fill: none;
		stroke: var(--color-text-secondary, #5b616e);
		stroke-width: 1.25;
		stroke-linecap: round;
		vector-effect: non-scaling-stroke;
	}
</style>
