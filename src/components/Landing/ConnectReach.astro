---
import { Icon } from 'astro-icon/components';
import { CONNECT_COPY, CONNECT_NODE } from '@data/connect-visual';

/**
 * A third cut of Connect: every protocol reaches the platform, and the picture is about HOW FAR it
 * has to come.
 *
 * `ConnectFlow` argues "four ways in" with four columns and fanned arrows. `ConnectCloud` argues
 * "whatever you have is already in here" with an unsorted drift of names. This argues the thing
 * neither of them says: some protocols arrive with nothing in between, and some arrive through
 * exactly one thing, and that thing has a name.
 *
 * So each route is one rail leaving the badge. The direct rail is unbroken. The other two are
 * interrupted by the hop you pass through — a gateway, an integration — drawn as a node ON the
 * rail rather than as a caption beside it. The absence of a node on the first rail is the whole
 * argument, and it only reads because the other two have one.
 *
 * --- names ----------------------------------------------------------------------------------
 *
 * Declared here, not read from `CONNECT_ROUTES`, and deliberately a DIFFERENT set. The shipped
 * routes name vendors — ChirpStack, TTN, LORIOT, AWS IoT, Azure IoT, Pub/Sub, AWS SQS — and this
 * cut exists partly to avoid that: where a vendor would stand, it names the category instead
 * ("MQTT brokers", "Cloud IoT platforms"), which is also more honest about what is supported,
 * since the list was never only those three clouds.
 *
 * Four names here are still products rather than standards — Sigfox, Kafka, RabbitMQ and S7 — and
 * they are the ones to revisit if the concern is brand names as such rather than picking winners
 * among cloud vendors. Generic stand-ins exist for all four: "LPWAN networks", "message brokers"
 * (which would absorb RabbitMQ and Kafka into one chip), and "PLC protocols" for S7.
 *
 * --- scale ----------------------------------------------------------------------------------
 *
 * 470 units wide with nothing under 16u, so R = 29.4 and the smallest type lands at 12.5px in the
 * 367px column a 375px phone gives it. See `CLAUDE.md` in this directory for what R is and why it
 * is the only number that predicts a phone.
 */

interface Props {
	/** Draws the caption under the badge. Off, as on the other two cuts. */
	nodeLabel?: boolean;
}

const { nodeLabel = false } = Astro.props;

/**
 * The three routes, ordered by how far the protocol has to come. `hop` is what sits on the rail;
 * the direct route has none, which is the point of the drawing.
 */
const ROUTES = [
	{
		id: 'direct',
		caption: 'directly',
		accent: '#0e7490',
		hop: null,
		names: ['MQTT', 'HTTP', 'CoAP', 'LwM2M', 'SNMP', 'Sparkplug B', 'OCPP'],
	},
	{
		id: 'gateway',
		caption: 'via IoT gateway',
		accent: '#7b3fe4',
		hop: { label: 'IoT gateway', icon: 'tabler:router' },
		names: ['Modbus', 'OPC UA', 'S7', 'BACnet', 'KNX', 'CAN', 'BLE', 'TCP/UDP'],
	},
	{
		id: 'integration',
		caption: 'via integrations',
		accent: '#65a30d',
		hop: { label: 'Integration', icon: 'tabler:plug-connected' },
		names: ['LoRaWAN', 'Sigfox', 'MQTT brokers', 'Kafka', 'RabbitMQ', 'Cloud IoT platforms'],
	},
];

// --- geometry -------------------------------------------------------------------------------
//
// Three fixed columns and one that takes the rest: the badge, the rail, and the chips. The rail is
// fixed because the hop nodes have to line up down the page — a rail sized to its own row would
// put the gateway and the integration at two different distances, which says something the design
// does not mean.
const NATIVE = 470;
const BADGE = 80;
const GAP = 14;
const RAIL = 96;
const CHIPS = NATIVE - BADGE - GAP - RAIL - GAP;

const CHIP_H = 30;
const CHIP_GAP = 6;
const ROW_GAP = 18;
const CAPTION_H = 20;

const vars = [
	`--cr-u: min(1.15px, calc(100cqw / ${NATIVE}))`,
	`--cr-native: ${NATIVE}`,
	`--cr-badge: ${BADGE}`,
	`--cr-gap: ${GAP}`,
	`--cr-rail: ${RAIL}`,
	`--cr-chips: ${CHIPS}`,
	`--cr-chip-h: ${CHIP_H}`,
	`--cr-chip-gap: ${CHIP_GAP}`,
	`--cr-row-gap: ${ROW_GAP}`,
	`--cr-caption-h: ${CAPTION_H}`,
].join(';');
---

<div class="cr-fit">
	<div class="cr" style={vars} data-node-label={nodeLabel ? 'on' : 'off'}>
		<div class="cr__node">
			<span class="cr__badge" style={`--cr-badge-color: ${CONNECT_COPY.badge.color}`}>
				<Icon name={CONNECT_COPY.badge.icon} />
			</span>
			<span class="cr__node-label">{CONNECT_NODE.label}</span>
		</div>

		{
			ROUTES.map((r) => (
				<div class="cr__route" style={`--cr-accent: ${r.accent}`} data-route={r.id}>
					{/* The rail. Unbroken for the direct route — that gap is where the hop would be. */}
					<div class="cr__rail" aria-hidden="true">
						<span class="cr__line" />
						{r.hop && (
							<span class="cr__hop" title={r.hop.label}>
								<Icon name={r.hop.icon} />
							</span>
						)}
						<span class="cr__line" />
					</div>

					<div class="cr__group">
						<p class="cr__caption">{r.caption}</p>
						<ul class="cr__chips">
							{r.names.map((n) => (
								<li class="cr__chip">{n}</li>
							))}
						</ul>
					</div>
				</div>
			))
		}
	</div>
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	.cr-fit {
		container-type: inline-size;
	}

	.cr {
		--u: var(--cr-u);
		display: grid;
		// Badge, then everything else. The rail is a column INSIDE each route rather than a third
		// grid column, because the chips wrap and a grid row would stretch the rail with them.
		grid-template-columns: u(var(--cr-badge)) minmax(0, 1fr);
		// Declared, not implicit. `grid-row: 1 / -1` counts to the last EXPLICIT row line, so with
		// implicit rows it resolves to `1 / 1`, the badge occupies one row, and auto-placement drops
		// the second route into the badge's column — where its chips stack one per line. Measured,
		// not guessed: that is exactly what happened. `DigitalTwin.astro` carries the same warning.
		grid-template-rows: repeat(3, auto);
		column-gap: u(var(--cr-gap));
		row-gap: u(var(--cr-row-gap));
		align-items: center;
		max-width: u(var(--cr-native));
		margin-inline: auto;
	}

	// --- the platform ---------------------------------------------------------------

	.cr__node {
		// All three rails leave the same object, so it spans them and centres.
		grid-column: 1;
		grid-row: 1 / -1;
		display: grid;
		justify-items: center;
		gap: u(6);
	}

	.cr__badge {
		display: grid;
		place-items: center;
		width: u(var(--cr-badge));
		height: u(var(--cr-badge));
		// The page's shared squircle.
		border-radius: 32%;
		background: var(--cr-badge-color, #0e7490);
		color: #fff;
		box-shadow: 0 u(3) u(10) rgba(23, 28, 34, 0.18);

		:global([data-icon]) {
			width: u(42);
			height: u(42);
		}
	}

	.cr__node-label {
		font-size: u(16);
		line-height: u(20);
		font-weight: $font-weight-medium;
		white-space: nowrap;
		color: var(--color-text-secondary, #5b616e);
	}

	.cr[data-node-label='off'] .cr__node-label {
		@include visually-hidden;
	}

	// --- a route --------------------------------------------------------------------

	.cr__route {
		// Pinned, so no route can be auto-placed into the badge's column.
		grid-column: 2;
		display: flex;
		align-items: flex-start;
		gap: u(var(--cr-gap));
	}

	// Sits beside the FIRST line of chips, not centred in the whole wrapped block: the rail arrives
	// at the names, and the names start at the top.
	.cr__rail {
		flex: none;
		display: flex;
		align-items: center;
		width: u(var(--cr-rail));
		height: u(var(--cr-chip-h));
		margin-top: u(var(--cr-caption-h));
	}

	.cr__line {
		flex: 1;
		height: max(1px, #{u(2)});
		background: var(--color-text-secondary, #5b616e);
	}

	// The hop. Fixed width whether or not it is there, so the chips of all three routes start on the
	// same vertical — the rails differ by what is ON them, not by how long they are.
	.cr__hop {
		flex: none;
		display: grid;
		place-items: center;
		width: u(30);
		height: u(30);
		margin-inline: u(5);
		border-radius: 28%;
		background: color-mix(in srgb, var(--cr-accent) 16%, transparent);
		color: var(--cr-accent);

		:global([data-icon]) {
			width: u(18);
			height: u(18);
		}
	}

	// Nothing on the direct rail, and the space is held anyway. An unbroken line of the same length
	// as two broken ones is the comparison the drawing is making.
	.cr__route[data-route='direct'] .cr__line:first-child {
		flex: 1 1 auto;
	}

	.cr__group {
		min-width: 0;
		flex: 1;
	}

	.cr__caption {
		height: u(var(--cr-caption-h));
		margin: 0;
		font-size: u(16);
		line-height: u(20);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--cr-accent);
	}

	.cr__chips {
		display: flex;
		flex-wrap: wrap;
		gap: u(var(--cr-chip-gap));
		margin: 0;
		padding: 0;
		list-style: none;
	}

	// Tinted, no border: a 1px border is not a design unit, and eight of them per row push the
	// composition past its native width at small sizes. Same reasoning as ConnectCloud's chips.
	.cr__chip {
		display: flex;
		align-items: center;
		height: u(var(--cr-chip-h));
		padding: 0 u(10);
		border-radius: u(7);
		background: color-mix(in srgb, var(--cr-accent) 14%, transparent);
		font-family: $font-family-mono;
		font-size: u(16);
		line-height: 1;
		white-space: nowrap;
		color: var(--color-text, #17181c);
	}
</style>
