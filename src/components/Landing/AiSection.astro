---
import { Icon } from 'astro-icon/components';
import SectionHeader from './SectionHeader.astro';
import AiAssistant from './AiAssistant.astro';
import CliTerminal from './CliTerminal.astro';
import { AI_COPY, AI_COLUMNS, AI_CLI_SESSION, AI_CLI_LABEL, AI_CTA } from '@data/ai-visual';

/**
 * "Build IoT solutions faster than ever with AI inside ThingsBoard" — two routes into the platform,
 * a prompt and a terminal, each shown as a working window.
 *
 * Ported from `tb-landing-prototype` (`src/sections/06-ai.html`). This is the section's SHELL; the
 * two windows are `AiAssistant` and `CliTerminal`, and the copy is `@data/ai-visual`.
 *
 * ── THE LAYOUT: ALTERNATING ROWS ──────────────────────────────────────────────────────────────
 * Not the prototype's two-up columns. Each route is a full-width row — window on one side, copy on
 * the other — and the two rows swap sides, which is the pattern the five key visuals above already
 * run in.
 *
 * The geometry is `_home-rows.scss`'s, so these read as a continuation of that sequence rather than
 * as a different thing at a different size: a 56px gutter, a 350px floor, and the copy capped at a
 * 40ch MEASURE with the media taking what is left. Those numbers were measured for those rows; they
 * are matched here rather than re-derived.
 *
 * IT IS NOT `FeatureBlockSection`, which is the component those rows use, and the reason is its API
 * rather than its look: it has no eyebrow, and these rows' eyebrows carry the section's whole
 * argument — the same platform, reached two ways. It also requires a `links` array these rows have
 * nothing to put in. Borrowing its geometry without borrowing the component is the smaller lie.
 *
 * The first row leads with the media, because the last of the five rows above (`ScaleDuo`) leads
 * with its copy — so the alternation carries on down the page instead of restarting.
 *
 * ── THE WINDOWS ───────────────────────────────────────────────────────────────────────────────
 * The treatment is the prototype's preview panel at **Wells: Crop · AI: In app · AI band: Light**,
 * read off the prototype built and running in that config rather than from its source (its
 * stylesheet is 73 files deep and attribute selectors outrank the plain rules written after them,
 * so what a rule says and what the page computes are two different questions).
 *
 * - **Crop.** The panel is shorter than the window it holds, so the window is cut by it and reads
 *   as a full-size screen rather than a toy. The chat is anchored to the BOTTOM and cut at the top,
 *   keeping the composer and newest replies in frame; the terminal is anchored to the TOP and cut
 *   at the bottom, so you watch the script being typed under the title bar. The prototype gets
 *   there by blowing the windows up 1.35x; nothing is scaled here, so nothing is resampled.
 * - **In app.** The chat keeps its slice of the product — the green app bar and the card cropped by
 *   the left edge. "Bare" would drop the plate.
 * - **Light.** The section takes the page ground, which is white.
 *
 * NOT ported: the prototype's dot field behind each window (asked for twice, removed twice), and
 * the 1px rules that framed the two-up band — those existed to split a side-by-side comparison, and
 * there is no longer one to split.
 */

interface Props {
	/** Play both windows. Off renders them as stills — used by the sandbox. */
	animate?: boolean;
}

const { animate = true } = Astro.props;
---

<section id="ai" class="ai" data-animate={animate ? 'on' : null}>
	<div class="main-div">
		<SectionHeader
			title={AI_COPY.title}
			subtitle={AI_COPY.body}
			titleSize="section"
			subtitleMeasure="copy"
			badge={AI_COPY.badge}
		/>
	</div>

	{
		/* One band per route. Each is full-bleed so the gradient is a BAND across the page rather than
		   a patch under a window, and the content inside returns to `.main-div`'s measure. The wrapper
		   is what holds the two to one height — see `.ai__bands`. */
	}
	<div class="ai__bands">
	<div class="ai__band ai__band--dock-top" style={`--accent: ${AI_COLUMNS.assistant.accent}; --accent-text: ${AI_COLUMNS.assistant.accentText}`}>
		<div class="main-div">
			<div class="ai__row">
				<div class="ai__media">
					<AiAssistant animate={animate} />
				</div>

				<div class="ai__copy">
					<p class="ai__eyebrow">{AI_COLUMNS.assistant.eyebrow}</p>
					<h3 class="ai__row-title">{AI_COLUMNS.assistant.title}</h3>
					<p class="ai__row-text">{AI_COLUMNS.assistant.body}</p>
				</div>
			</div>
		</div>
	</div>

	<div class="ai__band ai__band--dock-bottom" style={`--accent: ${AI_COLUMNS.cli.accent}; --accent-text: ${AI_COLUMNS.cli.accentText}`}>
		<div class="main-div">
			<div class="ai__row ai__row--flip">
				<div class="ai__media">
					{
						/* `CliTerminal` reads `--accent` for its prompt and caret, so the row's hue reaches
						   inside the terminal without this section knowing anything about its internals. */
					}
					<div class="ai__cli">
						<CliTerminal session={AI_CLI_SESSION} path="cold-chain" ariaLabel={AI_CLI_LABEL} />
					</div>
				</div>

				<div class="ai__copy">
					<p class="ai__eyebrow">{AI_COLUMNS.cli.eyebrow}</p>
					<h3 class="ai__row-title">{AI_COLUMNS.cli.title}</h3>
					<p class="ai__row-text">{AI_COLUMNS.cli.body}</p>
				</div>
			</div>
		</div>
	</div>
	</div>

	<div class="main-div">
		{
			/* ⚠ See the note on `AI_CTA`: this overlaps the page's own `ClosingCta`. Ported because the
			   prototype's section carries it, flagged because only one of the two should survive. */
		}
		<div class="ai-cta">
			<p class="ai-cta__title">{AI_CTA.title}</p>
			<p class="ai-cta__body">{AI_CTA.body}</p>

			<a class="ai-cta__btn" href={AI_CTA.link.href}>
				{AI_CTA.link.text}
				<Icon name="tabler:chevron-right" aria-hidden="true" />
			</a>
		</div>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	.ai {
		// No background: the homepage strips them —
		// `:root section:not(.customers-logo--dark):not(.closing-cta) { background: none }` in
		// `index.astro` — so a fill here would be dead CSS. White was the brief, and white is the ground.
		padding: $spacing-16 0;
	}

	// ── The bands ─────────────────────────────────────────────────────
	// One full-bleed gradient band per route, stacked flush, rather than a small wash under each
	// window.
	//
	// The gradient is the ORIGINAL underlay's — white at the top, the hue at 20% at the bottom, run
	// over the band's whole height instead of a 300px panel. An intermediate version faded out again
	// at the base so the two bands would meet on white; this does not, which is the intended look.
	// The consequence to know about: each band ENDS on full hue, so there is a colour change at the
	// junction where band one's base meets band two's clear top, and another where band two's base
	// meets the CTA. That edge is the design, not a bug — do not "fix" it by re-adding the fade-out.
	//
	// THE TWO BANDS ARE HELD TO ONE HEIGHT, at every width. Side by side they already matched — both
	// are a 300px media row plus one 48px margin — but stacked they drift, and not consistently: at
	// 900px the CLI band ran 15px TALLER (its window is 304 against the chat's 289), and at 375px it
	// ran 33px SHORTER (its copy is two lines less). `grid-auto-rows: 1fr` resolves every row to the
	// tallest, which is the only thing that holds when both the media and the copy differ.
	.ai__bands {
		display: grid;
		grid-auto-rows: 1fr;
	}

	// A column, so the spare height a shorter band is given lands at the end it is NOT docked to.
	// Without this the grid would stretch the box and leave the CLI's window floating above its own
	// bottom edge, which is the one thing the dock exists to prevent.
	// `section .main-div` ships a ~5px vertical margin from `landing.scss`, which is invisible in a
	// normal section and not here: it sat between the window and the band edge it is docked to, so the
	// CLI's terminal floated 5px above its own bottom line. Zeroed, so the dock is exactly the dock.
	.ai__band .main-div {
		margin-top: 0;
		margin-bottom: 0;
	}

	// 80px, and only on the side the window is NOT docked to — see the dock rules below, which take
	// the other side to zero. A band is therefore its 300px row plus one 80px margin.
	.ai__band {
		display: flex;
		flex-direction: column;
		padding: $spacing-20 0;
		background-image: linear-gradient(
			180deg,
			transparent 0%,
			color-mix(in srgb, var(--accent) 20%, transparent) 100%
		);

	}

	.ai__bands {
		margin-top: $spacing-12;
	}

	// ── Docking ───────────────────────────────────────────────────────
	// Each window is cut on one side, so it is docked to the band edge it is cut ON: the cut and the
	// band's boundary become the same line, and the window reads as running past the band rather than
	// floating inside it with wash above or below the cut.
	//
	//   creator  cut at the TOP     → docked to the band's top edge
	//   CLI      cut at the BOTTOM  → docked to the band's bottom edge
	//
	// `align-self` as well as the zeroed padding, so the dock holds even if a copy column ever grows
	// taller than the 300px media and starts driving the row's height.
	// ── Centring the copy ─────────────────────────────────────────────
	// The copy is centred in its ROW, but a docked band's padding is all on one side, so centred-in-
	// the-row sits half that padding off centre-in-the-BAND — high in the chat, low in the CLI, by
	// 40px each once the padding is 80.
	//
	// The fix is a RELATIVE offset of half the padding, towards the padded side. Relative offsets do
	// not affect layout, which is the whole reason for choosing one:
	//
	//   dock-top     row 0..R,     copy centre R/2       + P/2  =  (R + P) / 2  = band centre
	//   dock-bottom  row P..P+R,   copy centre P + R/2   − P/2  =  (P + R) / 2  = band centre
	//
	// A margin was tried first and is subtly worse. `align-items: center` centres an item's MARGIN
	// box, so it lands the copy in the same place — but it also grows the row past the media on the
	// longer column, which made one band 10px taller, which made `grid-auto-rows` stretch the other,
	// which put the copy 5px off centre again. An offset leaves both rows at the media's own height,
	// so the bands match with nothing to stretch.
	.ai__band--dock-top {
		justify-content: flex-start;
		padding-top: 0;

		.ai__media {
			align-self: flex-start;

			// THE SHADOW FADES HERE, on the crop box, not on the window.
			//
			// A mask on the window itself cannot do it: `mask-clip` defaults to `border-box`, so the
			// outer shadow falls outside the mask's painting area and is DELETED rather than faded. The
			// usual answer is a wrapper padded by the shadow's reach — but this element already is that
			// wrapper. `.ai__media` is the box that crops the window, it holds the window and every
			// pixel of shadow that survives the crop, and it has no background of its own (the band
			// carries the gradient), so masking it touches nothing else.
			//
			// One declaration therefore fades the three things that meet at the cut — the window's
			// fill, its side shadows, and its content — and they fade together, which is what makes it
			// read as the window dissolving rather than as three effects happening at once.
			//
			// 48px, against a shadow that reaches about 7px sideways: long enough that the side shadow
			// thins out rather than stopping, short enough not to reach the greeting.
			-webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 48px);
			mask-image: linear-gradient(to bottom, transparent 0, #000 48px);
		}

		.ai__copy {
			position: relative;
			top: $spacing-10;
		}
	}

	.ai__band--dock-bottom {
		justify-content: flex-end;
		padding-bottom: 0;

		.ai__media {
			align-self: flex-end;
		}

		.ai__copy {
			position: relative;
			top: -$spacing-10;
		}
	}

	// ── The section's mark ──────────────────────────────────
	// LARGER THAN THE PAGE'S OTHER TILES, and knowingly. `SectionHeader` draws 40 with a 24 glyph to
	// match the row marks beside it, and the reason is written there: a section mark a third larger
	// than the row marks would be a second idea of what a tile is. That holds for a mark whose whole
	// job is to label its section. This one has another — it is the only mark on the page that moves,
	// and at 40 the movement had nothing to happen in. 56/34 keeps the tile's own proportion (0.6
	// glyph to tile; the radius is a percentage, so it follows by itself) and puts it clearly in a
	// different class from the row marks rather than nearly matching them, which is the reading that
	// would look like a mistake.
	//
	// Overridden from here rather than added to `SectionHeader` as a prop, which is this repo's usual
	// answer: the size only earns itself next to the animation below, and the animation is this
	// section's own. A `badgeSize` prop would offer every other header a size that makes no sense
	// without it.
	.ai :global(.section-header__badge) {
		width: 56px;
		height: 56px;
	}

	.ai :global(.section-header__badge [data-icon]) {
		width: 34px;
		height: 34px;
	}

	// A twinkle when the mark scrolls into view, once per entry. Same gate as the two windows below,
	// which is the point of using one: nothing in this section moves while it is off screen.
	//
	// THE GLYPH MOVES, NOT THE TILE. A tile that scales drags the title under it around, and the
	// header is the calmest thing on this page. Scaling the glyph inside a tile that holds still also
	// reads as the mark catching light, which is what a sparkle should do.
	.ai :global(.section-header__badge.is-lit [data-icon]) {
		animation: ai-badge-twinkle 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	@keyframes ai-badge-twinkle {
		0% {
			opacity: 0;
			transform: scale(0.6) rotate(-25deg);
		}
		45% {
			opacity: 1;
			transform: scale(1.14) rotate(8deg);
		}
		70% {
			transform: scale(0.97) rotate(-3deg);
		}
		100% {
			opacity: 1;
			transform: scale(1) rotate(0deg);
		}
	}

	// Belt and braces with the script, which does not attach the observer at all under reduced motion:
	// this also covers the setting being turned on after the class has already landed.
	@media (prefers-reduced-motion: reduce) {
		.ai :global(.section-header__badge.is-lit [data-icon]) {
			animation: none;
		}
	}

	// `_home-rows.scss`'s gutter, so these sit in the same rhythm as the five visuals above.
	//
	// NO 350px FLOOR, though that file sets one. Its job there is to hold five rows of differing
	// natural height to one height; here both rows are the same 300px media, so the floor was never
	// equalising anything — it was 50px of air inside every band. The content sets the height.
	.ai__row {
		display: flex;
		align-items: center;
		gap: 56px;
	}

	// The second row swaps sides. `row-reverse` rather than `order`, so the DOM keeps media before
	// copy in both rows and the reading order never depends on which way the row faces.
	.ai__row--flip {
		flex-direction: row-reverse;
	}

	// The copy is a MEASURE, not a fraction — the media takes what is left, exactly as the rows above.
	.ai__copy {
		display: flex;
		flex: 0 1 40ch;
		flex-direction: column;
		max-width: 40ch;
	}

	// The crop: shorter than the window it holds, so the window is cut rather than shrunk. The wash
	// rises to the base — clear where the window is, gathering under it.
	.ai__media {
		position: relative;
		display: flex;
		flex: 1 1 auto;
		align-items: flex-end;
		justify-content: center;
		min-width: 0;
		// 350. The crop box has to hold the chat's rendered height less the amount being cut, and the
		// chat now renders 396 rather than 347 — so at 300 the cut grew to 110, which took 46 native
		// pixels off the log and left less than the greeting needs. 350 puts the cut back to 60, where
		// the log keeps 20px of slack over the intro. This is the cost of matching the two windows'
		// type: the bands go from 380 to 430.
		//
		// NO BACKGROUND of its own: this box is only the crop, and the colour behind it belongs to the
		// band.
		height: 350px;
		overflow: hidden;
	}

	// The chat is AUTHORED at 400x289 and blown up here — see the note on `.assistant`. The section
	// owns the factor because the section owns the column it has to fill: 400 x 1.2 = 480, the width
	// the window occupies either way. Authoring wider and scaling less is how the magnification came
	// down from 1.3333 without the window changing size on the page.
	//
	// The crop then follows from the scaled height, measured off the bottom edge the scale grows from:
	//
	//   289 x 1.37 = 396 (window) − (350 panel − 14 offset) = 60 cut from the top
	//
	// and 60 is comfortably more than the 47 the `New chat` bar occupies once scaled, so the bar goes
	// with the cut. What survives is the live end — the composer, the chip and the latest replies.
	.ai__media :global(.assistant) {
		// 500 ÷ 365 — the common window width over the chat's native width. Both windows are 500 wide
		// here, which is what finally matches them: same width, and the chat's body type lands at
		// 16.4px against the terminal's 18px mono, which is parity once the mono's bigger x-height is
		// accounted for.
		--ui-scale: 1.37;

		// POSITIONED, like the terminal beside it, and for a reason that only shows on a phone: a
		// transform does not shrink the LAYOUT box. The window is 365 wide whatever the scale renders
		// it at, so in the flow it pushed its cell to 365, the cell pushed `.main-div` to 405, and the
		// band went 30px wider than a 375px viewport — clipped by `#overflow`, so it hid as a slight
		// horizontal shift rather than as a scrollbar.
		//
		// Out of the flow it contributes no width, and `left/right: 0` with `margin: 0 auto` centres it
		// against the cell instead. Both windows are now placed the same way, which is the point.
		position: absolute;
		right: 0;
		// 24, AND THE NUMBER IS THE SHADOW'S. The window's own shadow is authored `0 4px 12px` and gets
		// multiplied by the scale like everything else, so it reaches 5.5 + 16.4 ≈ 22px below the frame
		// here — against the 14 this used to leave, which ended it on the crop's straight edge. 24 clears
		// it. The 10px comes off the top of the window instead, where the crop is already 60 deep and the
		// log's mask holds transparent for 20 of its own: the cut moves from 9.7 to 17.1 into the log and
		// stays inside that hold, so the seam is still invisible. Below 560 the scale is 1, the shadow is
		// a third the size, and this comes back down — see the note there.
		bottom: 24px;
		left: 0;
		margin: 0 auto;
	}

	// The terminal is the mirror image: pinned to the top, 56px down, and taller than the room left
	// below that, so the frame is genuinely cut at the bottom.
	//
	//   350 (panel) − 20 (offset) + 24 (bleed) = 354
	//
	// `CliTerminal` is a plain block whose log carries its own cap, so all three parts have to be
	// told to fill: the window, the scroll box, and the log inside it.
	// POSITIONED, NOT ALIGNED. The window is deliberately taller than the box that crops it, and a
	// flex item whose margin box overflows its line does not place predictably: with
	// `align-self: flex-start; margin-top: 40px` this measured at 40px from the top in one reading and
	// 16px in the next, so the visible log was sometimes 218px and sometimes 242px. That is what let
	// an 18px log fit when it was checked and crop its last line when it was looked at.
	//
	// Absolute placement makes the crop arithmetic true by construction: top 20, height 304, so the
	// window always overhangs the 300px box by 24 and the log is always
	// 300 − 20 (offset) − 42 (title bar) = 238px tall.
	.ai__cli {
		position: absolute;
		top: 20px;
		right: 0;
		left: 0;
		margin: 0 auto;
		width: 100%;
		// 500, THE SAME WIDTH AS THE CHAT. It used to fill its 543px cell while the chat sat inset, and
		// that 13% difference was the loudest thing separating them.
		//
		// It can give up the width because it was not using it: the longest line — `tb calculated-field
		// save --name mean-cargo-temp`, 47 characters — is 453px, so 543 left 58px of empty console.
		// At 500 it has 468px of content and 15px spare, which is the floor: `white-space: pre` cannot
		// break that line, so any narrower and the whole span drops to a second row, and one wrapped
		// row is the 23px that puts the log into a scroll.
		max-width: 500px;
	}

	.ai__cli :global(.cli) {
		display: flex;
		flex-direction: column;
		height: 354px;
		// CUT TO FIT THE CROP. The component's own `0 12px 32px` is right for a terminal standing in a
		// card, and wrong inside a box that clips it: a 32px blur paints 32px past the frame and the crop
		// leaves 21, so the outer third of the shadow ended on a straight vertical line down both sides,
		// and the 20px above the window was exactly the reach of the top edge. 18px of blur fits both
		// with room to spare; the alpha comes up a little so it does not read as weaker for being
		// tighter. The BOTTOM is cut either way — that cut is the composition.
		box-shadow:
			0 1px 0 rgba(255, 255, 255, 0.06) inset,
			0 8px 18px rgba(0, 0, 0, 0.3);
		// Matched to the chat's rendered corner rather than to its authored one: the chat is scaled
		// 1.2, so its 8px becomes 9.6 on the page. Overridden here rather than in `CliTerminal`, whose
		// own 6px is right for the cards it sits in elsewhere.
		border-radius: 10px;
	}

	.ai__cli :global(.cli__scroll) {
		flex: 1 1 auto;
		min-height: 0;
	}

	// 18/1.3, against the component's 12.5/1.9. That ratio is built for a still being read at rest; a
	// session being typed wants the lines closer together, so the log reads as one block of output
	// rather than a list, and much larger so the command is legible across the row.
	//
	// THE SIZE IS DERIVED, NOT CHOSEN, because the session has to fit with NO SCROLL — a log that
	// scrolls hides the command that opened it. Both bounds were measured in the browser rather than
	// estimated:
	//
	//   down   16 top + 9 rows x 22.5 + 8 bottom = 227 against 288px of visible log   → 61px spare
	//   across the longest line is `tb calculated-field save --name mean-cargo-temp` at 47 characters;
	//          this mono font advances 0.5em per character, so with the 1.65em gutter that is 25.15em
	//          = 453px against 468px of content width                                 → 15px spare
	//
	// 218 IS THE NUMBER THAT MATTERS and it is not the log's own height. The window is 284 tall and
	// hangs 24px past the media box that crops it, so `body.clientHeight` reports 242 while only 218
	// is ever seen. Sizing against 242 fit the log on paper and dropped its last line into the cut —
	// `scrollHeight <= clientHeight` is not the test here; the media's bottom edge is.
	//
	//   visible log = 350 (media) − 20 (the window's top offset) − 42 (title bar) = 288
	//
	// Height is the binding bound; the width has room to spare. Re-measure both if a command gets
	// longer, a step is added, or the crop offsets change.
	.ai__cli :global(.cli__body) {
		max-height: 100%;
		height: 100%;
		padding-bottom: 8px;
		// 1.4, up from 1.25. Tight leading is right for a log you are meant to read as one block, but at
		// 18px it had closed up enough that the output lines read as attached to the command above them.
		// The budget pays for it easily: 9 rows at 25.2 plus the padding is 235 against the 288 the crop
		// leaves, so this still lands 53px clear of the cut.
		line-height: 1.4;

		// NOT a container query. `min(18px, calc((100cqw - 32px) / 25.15))` off a
		// `container-type: inline-size` on the wrapper is the obvious way to tie the type to the
		// terminal's own width, and it does not work here: inline-size containment on a flex item
		// collapsed the width it was meant to measure, and all nine rows wrapped to three lines each.
		// A breakpoint below.
		font-size: 18px;
	}

	// The title bar was left at the component's 11px and read as a caption under an 18px log.
	.ai__cli :global(.cli__path) {
		font-size: 14px;
	}

	// ── Typography, matched to the feature rows ───────────────────────
	// Every value below is `_home-rows.scss`'s, so these rows and the five key visuals above are set
	// in one voice rather than two that nearly agree:
	//
	//   heading   `type-subsection` + `text-wrap: balance`   (.new-rows .feature-des .phrase-heading)
	//   gap       14px under the heading                     (.new-rows .feature-des .heading-wrap)
	//   body      `type-body` in INK, not the muted grey     (.new-rows .feature-des p)
	//
	// The body was the real mismatch: 14px at `--color-text-secondary` against those rows' 16px at
	// full ink. That file's own note explains the ink — the component's #6b6b72 is a product-page
	// grey meant to recede beside a screenshot, and it reads washed out beside a quiet diagram.
	//
	// The eyebrow has no counterpart there; those rows carry a squircle badge instead. It is kept
	// because it is the section's argument — the same platform, reached two ways — and set on the
	// shared ladder so it is at least not a fourth voice.
	// NOT `--accent`. The kicker is the one place this hue is set as type, and the band it is set on is
	// washed with that same hue — so the accent is being read against a tint of itself, and both landed
	// under what 14px needs (4.94:1 and 4.18:1, the purple failing outright). `--accent-text` is each
	// accent darkened until it clears 5:1 against the deepest point of its own wash; the derivation and
	// the numbers are in `@data/ai-visual`. The wash and the terminal's prompt keep `--accent`.
	.ai__eyebrow {
		@include type-eyebrow;

		margin: 0 0 $spacing-3;
		color: var(--accent-text, var(--accent));
	}

	.ai__row-title {
		@include type-subsection;

		margin: 0 0 14px;
		color: var(--color-text);
		text-wrap: balance;
	}

	.ai__row-text {
		@include type-body;

		margin: 0;
		color: var(--color-text, #17181c);
	}

	// ── The section's closing CTA ─────────────────────────────────────
	.ai-cta {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-top: $spacing-16;
		text-align: center;
	}

	.ai-cta__title {
		@include type-card;

		margin: 0;
		color: var(--color-text);
		text-wrap: balance;
	}

	.ai-cta__body {
		@include type-small;

		max-width: 52ch;
		margin: $spacing-2 0 0;
		color: var(--color-text-secondary);
	}

	// The page's primary, same as the hero's and the bookend's — one button style down the page.
	.ai-cta__btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 44px;
		margin-top: $spacing-6;
		padding: 0 16px;
		border: 1px solid $color-brand;
		border-radius: $radius-md;
		background-color: $color-brand;
		font-size: $font-size-base;
		font-weight: $font-weight-bold;
		color: $color-white;
		text-decoration: none;
		transition: background-image 0.15s ease;

		&:hover,
		&:focus-visible {
			background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2));
		}

		:global(svg) {
			flex: 0 0 auto;
			width: 18px;
			height: 18px;
		}
	}

	// Stacked: the media on top in BOTH rows, so a phone reads picture-then-words twice rather than
	// inheriting the desktop alternation as an inconsistency.
	@include media-down(lg) {
		.ai__row,
		.ai__row--flip {
			flex-direction: column;
			align-items: stretch;
			gap: $spacing-8;
			min-height: 0;
		}

		.ai__copy {
			flex: 1 1 auto;
			max-width: 100%;
		}

		// The dock's `align-self` has to go once the row turns into a column: `align-self` works on
		// the CROSS axis, so the same declaration that pins the media to the row's top or bottom side
		// by side pushes it to the left or right edge stacked — which measured as the CLI band's
		// media 15px in and 15px narrow. Docking is a horizontal-row idea; stacked, both windows just
		// fill the column.
		// Matched through the band, not just `.ai__media`: the dock rules score (0,2,0) and a media
		// query adds nothing, so the shorter selector lost on specificity and the media stayed pinned.
		.ai__band--dock-top .ai__media,
		.ai__band--dock-bottom .ai__media {
			align-self: stretch;
		}

		// NOTHING ABOUT SIZE BELONGS IN THIS BLOCK. Stacking is a question about DIRECTION — the row
		// turns into a column, the dock has no side to reach for — and it starts at 991px, where the
		// column is still 700px wide and holds the full-size composition without complaint. The size
		// reductions live under `max-width: 560px` below, at the width where the cell actually stops
		// holding a 500px window.
		//
		// They were in here, and the seam showed: from 560 to 991 the chat was pinned to 365 and drawn
		// at native scale while the terminal beside it kept its 500 and its 18px log, so a tablet got
		// the two windows at visibly different sizes with the chat's type half the terminal's — the
		// exact mismatch the matched widths were meant to end.

		// The BAND's padding goes symmetric and the copy stops compensating for it. Docking the media to
		// a band edge is a side-by-side idea: stacked, the media is always first in the column with the
		// copy under it, so there is no edge for the second window to reach.
		//
		// `justify-content` goes with it, for a reason that only shows up once the padding is even.
		// `grid-auto-rows` holds both bands to one height, and stacked the CLI band's column comes out
		// 48px shorter than the chat's — so `flex-end` collected every pixel of that slack ABOVE the
		// terminal and started the second band's picture 96px down against the first band's 48. Centred,
		// each band splits its own slack and both read as evenly padded, which is the only thing a band
		// edge can still mean once there is no dock reaching for it.
		.ai__band--dock-top,
		.ai__band--dock-bottom {
			justify-content: center;
			padding-top: $spacing-12;
			padding-bottom: $spacing-12;
		}

		// ...and this is the other half of that sentence, which the code was not keeping. The relative
		// offset that centres the copy against one-sided padding survived into a layout that has none,
		// so it moved the copy 40px for nothing — down into the band's bottom padding in the chat band,
		// and UP OVER the terminal in the CLI one, where the copy's box crossed the media's by 8px and
		// the eyebrow printed on the window.
		//
		// Matched through the band, like the `align-self` reset above and for the same reason: those
		// rules score (0,2,0), a media query adds nothing, and a bare `.ai__copy` here loses.
		.ai__band--dock-top .ai__copy,
		.ai__band--dock-bottom .ai__copy {
			top: 0;
		}
	}

	// ── THE SAME COMPOSITION, SCALED DOWN ──────────────────────────
	// Everything the full-size layout does — the crop, the flush edge, the fade — stays on here. What
	// changes is ONE number, the scale, and the box heights that follow from it.
	//
	// 600 IS A WIDTH ABOUT THE WINDOWS, not about phones, which is why this is a bare media query
	// rather than one of the shared breakpoints. Two things have to fit in the cell before the 500px
	// composition can be used, and the wider of the two sets the number:
	//
	//   the log     `tb calculated-field save --name mean-cargo-temp` is 25.15em, so an 18px log needs
	//               453px of content and 485px of window   →  cell 485, viewport 525
	//   the shadows the crop box clips whatever the window does not leave it, and the terminal's
	//               reaches 18px past the frame            →  cell 536, viewport 576
	//
	// This was 560, which cleared the first and not the second: from 561 to about 576 the cell had
	// only 10px beside a 500px window and both shadows ended flat down their sides. 600 clears both
	// with 30px of room. The log step matters more than it looks either way: `white-space: pre` cannot
	// break that line, so it does not shrink — it drops to a second row, and one wrapped row is the
	// 23px that puts the log into a scroll.
	@media (max-width: 599px) {
		// The chat is drawn AT the cell's width rather than drawn wider and scaled down to it. Scaling
		// to 0.92 was the first attempt and it is worse on both counts: it renders the body at 11px
		// where drawing at native renders 12, and a 365px layout box centred in a 335px cell is
		// over-constrained — `width` with `left: 0` and `right: 0` — so the browser drops `right` and
		// the window sits 30px off centre.
		//
		// Nothing about the COMPOSITION depends on the scale: the crop, the flush edge and the fade all
		// come from the box, and they are all still here. The 40-character prompts were sized for the
		// composer this leaves, so they still fit on one line.
		.ai__media :global(.assistant) {
			--ui-scale: 1;

			width: calc(100% - 40px);
			max-width: 365px;
			// 16, not the 24 the full-size layout needs: at scale 1 the shadow is a third the size and
			// reaches 16 below the frame, and every pixel spent here is spent twice — it comes off the top
			// of the window, where the log's mask only holds transparent for 20 and the whole 289px window
			// is being cropped by a 250px box. 16 is exactly the reach, and leaves the cut at 21 into the
			// log: one pixel past the hold, which is 3% of the ramp and invisible.
			bottom: 16px;
		}

		// 250: the chat renders 289 here, so the box cuts 55 of it — comfortably more than the 34 the
		// `New chat` bar takes, so the bar goes with the cut exactly as it does at full size, and the
		// log keeps its slack over the greeting.
		//
		// AND IT BLEEDS INTO THE GUTTER, which is the only place the shadows can go down here. The
		// windows are drawn at the cell's own width on a phone, so the crop box was exactly as wide as
		// what it held and both shadows ended flat against its sides — the terminal's especially, at
		// 0.28 alpha. Pulling the box 20px wider each way costs nothing (it has no background, and the
		// page gutter is exactly 20) and the windows keep the cell's width by taking 40 off their own,
		// which is what `calc(100% - 40px)` is doing above and on `.ai__cli` below.
		.ai__media {
			height: 250px;
			margin-inline: -20px;
		}

		// A shallower cut gets a shorter fade; there is less window above it to dissolve.
		.ai__band--dock-top .ai__media {
			-webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 32px);
			mask-image: linear-gradient(to bottom, transparent 0, #000 32px);
		}

		// The terminal keeps its proportions — offset and bleed take the same ratio as the box:
		//
		//   250 (panel) − 14 (offset) + 16 (bleed) = 252
		//
		// AND IT COMES DOWN TO THE CHAT'S WIDTH, which is the whole reason the two match here. The chat
		// cannot pass 365 without going back to a scale, so 365 is what one width can be; left at 500
		// the terminal simply took whatever the cell offered and ran 135px wider than the chat above it
		// from about 405px of viewport up. 365 still holds the longest line at 11.5px with 44px spare.
		.ai__cli {
			top: 14px;
			width: calc(100% - 40px);
			max-width: 365px;
		}

		.ai__cli :global(.cli__body) {
			font-size: 11.5px;
			line-height: 1.5;
		}

		// The title bar comes down with the log, and it is the only part of the window that would not
		// have. Everything else in here is sized off the log's font; the bar is drawn in absolute
		// pixels, so at 11.5px type the stock 10px dots sat at 0.87 of the body where they sit at 0.56
		// at full size — the window controls had become the largest objects in the terminal. 0.65 puts
		// them back on that ratio, and the bar gives up 9px of height on the way, which the log takes.
		.ai__cli :global(.cli) {
			--cli-chrome: 0.65;

			height: 252px;
		}

		// 9.5px holds the bar's own ratio to the log (14:18 at full size) rather than nearly matching
		// it at 11, which is what made the path read as a line of the session rather than as chrome.
		.ai__cli :global(.cli__path) {
			font-size: 9.5px;
		}
	}

	// One more step, for the narrowest width the page lays out for. At 320 the cell is 280 and the log
	// has 248px of content against the 289 the longest line needs at 11.5px, so the command wraps —
	// and a wrapped command is the one thing this window is here to show not happening. 9.5px needs
	// 239, which clears it.
	@media (max-width: 374px) {
		.ai__cli :global(.cli__body) {
			font-size: 9.5px;
		}

		.ai__cli :global(.cli__path) {
			font-size: 8.5px;
		}
	}

	@include media-down(md) {
		.ai {
			padding: 60px 0;
		}

		// The bands carry the rhythm now, so they lose height rather than the rows gaining margin.
		.ai__band {
			padding: $spacing-12 0;
		}

		.ai-cta {
			margin-top: $spacing-12;
		}

		.ai-cta__btn {
			width: 100%;
			justify-content: center;
		}
	}
</style>

<script>
	// The section mark twinkles when it scrolls into view.
	//
	// Its own observer rather than a shared one: the chat and the terminal each carry theirs, this is
	// the same gate, and a section-wide observer would have to know what all three want. `#ai` is a
	// singleton, so there is no instance to thread through.
	const section = document.querySelector('#ai');
	const badge = section?.querySelector('.section-header__badge');

	if (badge && section?.dataset.animate === 'on' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					// OFF, THEN ON. Re-adding a class that is already there restarts nothing — the browser
					// sees the same animation still applied and leaves it running. Removing it, forcing the
					// style to flush by reading a layout property, then adding it back is what makes the
					// next entry a new animation rather than a no-op.
					badge.classList.remove('is-lit');

					if (entry.isIntersecting) {
						void (badge as HTMLElement).offsetWidth;
						badge.classList.add('is-lit');
					}
				}
			},
			// Half of it, so the twinkle fires when the mark is properly on screen rather than as its
			// first pixel clears the fold.
			{ threshold: 0.5 }
		).observe(badge);
	}
</script>
