---
import { Icon } from 'astro-icon/components';
import { PLATFORM_STAGES } from '@data/platform-visual';

/**
 * The platform's four stages, docked under the header for the four rows they stand for.
 *
 * `PlatformSteps` draws the stages as a track across its card; when that track scrolls up to the
 * header, this bar takes its place — the same tiles, the same verbs, on the same columns — and stays
 * until the last of the four rows has gone by. While a row is read, its step is lit: its tile fills
 * (the row's own mark, which this bar now carries in place of the badge over the row's heading) and
 * the rule under it fills with the reader's progress through that row. Steps already read keep a
 * full rule, so the four rules together are the reader's progress through the platform.
 *
 * WHERE ITS NUMBERS COME FROM. Nothing about the grid is restated here: the script reads the
 * track's box and its column gap and lays the bar's list over them, so the docked steps land where
 * the drawn ones were at any width the track runs across at. The rows are found by the anchors the
 * stages name (`PLATFORM_STAGES[].row`), and the composition check in `data/home-compositions.ts`
 * guarantees an order that renders this runs those rows next, in that order.
 *
 * `position: fixed`, NOT sticky. Every section of the homepage sits in `#overflow`, which is
 * `overflow: hidden` — and that makes it the scroll container a sticky child resolves against, a
 * box that never scrolls, so a sticky bar would never stick. Changing the wrapper would change every
 * running order's page; a fixed bar and a few lines of script change none of them.
 *
 * WITHOUT SCRIPT IT IS NOT THERE AT ALL, and nothing else changes either: the rows keep their marks,
 * because the rule that hides them keys on the attribute the script sets on each row.
 */
---

<nav class="steps-bar" aria-label="Platform stages" data-steps-bar>
	<ol class="steps-bar__list" role="list">
		{PLATFORM_STAGES.map((st) => (
			<li class="steps-bar__item" style={`--stage: ${st.accent}`}>
				<a class="steps-bar__link" href={`#${st.row}`} data-step={st.row}>
					<span class="steps-bar__tile" aria-hidden="true">
						<Icon name={st.icon} />
					</span>
					<span class="steps-bar__name">{st.name}</span>
					<span class="steps-bar__meter" aria-hidden="true">
						<span class="steps-bar__fill" />
					</span>
				</a>
			</li>
		))}
	</ol>
</nav>

<script>
	const bar = document.querySelector<HTMLElement>('[data-steps-bar]');
	const track = document.querySelector<HTMLElement>('[data-steps-track]');

	if (bar && track) dock(bar, track);

	function dock(bar: HTMLElement, track: HTMLElement) {
		const links = Array.from(bar.querySelectorAll<HTMLAnchorElement>('a[data-step]'));
		const rows = links.map((a) => document.getElementById(a.dataset.step ?? ''));
		// Not the page this was built for. Leave it exactly as it rendered, marks and all.
		if (!rows.length || rows.some((r) => !r)) return;
		const targets = rows as HTMLElement[];

		const root = document.documentElement;
		const steps = Array.from(track.children) as HTMLElement[];
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

		// The rows hand their marks to the bar from here on (see the style below).
		targets.forEach((row) => row.setAttribute('data-step-row', ''));

		/**
		 * Where the reading line sits in the visible page under the bar, as a fraction of its height.
		 * The row the line is in is the one being read. A row reaches the line with its TOP, so the
		 * higher the line, the longer the previous step stays lit: at 0.4 the next step lit while the
		 * last row's copy and its link still held the top of the screen; at 0.3 a row takes over once
		 * it has most of it.
		 */
		const READ_AT = 0.3;
		const barTile = bar.querySelector<HTMLElement>('.steps-bar__tile');

		let frame = 0;

		const update = () => {
			frame = 0;

			// The bar's top is the header's bottom, live (the promo strip collapses as you scroll), and
			// its height depends on the form it is in, so both are read rather than assumed.
			const top = parseFloat(getComputedStyle(bar).top) || 0;
			const height = bar.offsetHeight;

			// ACROSS while the track's first two steps share a line. Then the bar lies over the track's
			// own columns and docks the moment the drawn tiles reach its tile row; when the track runs
			// down the card instead, the bar keeps its own layout and docks once the last drawn step
			// has gone under it.
			const box = track.getBoundingClientRect();
			const across = steps.length > 1 && steps[0].offsetTop === steps[1].offsetTop;
			bar.toggleAttribute('data-across', across);
			if (across) {
				bar.style.setProperty('--steps-x', `${box.left}px`);
				bar.style.setProperty('--steps-w', `${box.width}px`);
				bar.style.setProperty('--steps-gap', getComputedStyle(track).columnGap);
			}
			// The bar's tile row, measured inside the bar (its top hairline and its padding both count),
			// so the drawn tiles hand over at the pixel the docked ones sit at.
			const tileRow = top + (barTile ? barTile.getBoundingClientRect().top - bar.getBoundingClientRect().top : 0);
			const reached = across ? box.top <= tileRow : box.bottom <= top + height;

			// Pushed out by the end of its last row, the way a sticky element leaves with its container.
			const end = targets[targets.length - 1].getBoundingClientRect().bottom;
			const push = Math.min(0, end - (top + height));
			const shown = reached && push > -height;

			bar.style.setProperty('--steps-push', `${push}px`);
			bar.toggleAttribute('data-docked', shown);
			root.toggleAttribute('data-steps-docked', shown);

			// Each row's progress past the reading line, 0 to 1. The step whose row the line is inside
			// is the current one; between rows (and before the first) none is.
			const line = top + height + (window.innerHeight - top - height) * READ_AT;
			let current = -1;
			targets.forEach((row, i) => {
				const r = row.getBoundingClientRect();
				const p = Math.min(1, Math.max(0, (line - r.top) / r.height));
				links[i].style.setProperty('--p', p.toFixed(4));
				links[i].toggleAttribute('data-done', p >= 1);
				if (p > 0 && p < 1) current = i;
			});
			links.forEach((a, i) => {
				if (i === current) a.setAttribute('aria-current', 'step');
				else a.removeAttribute('aria-current');
			});
		};

		const schedule = () => {
			if (!frame) frame = requestAnimationFrame(update);
		};

		window.addEventListener('scroll', schedule, { passive: true });
		window.addEventListener('resize', schedule);
		update();

		// A step goes to its row, landing the row's top edge exactly under the bar. The target is worked
		// out here rather than left to `scroll-margin-top`: Starlight puts a `scroll-padding-top` on the
		// root (1.5rem plus its nav height, 104px once the promo strip has gone) and the two ADD, so a
		// margin sized to the bar landed every row 104px lower than asked. A link from elsewhere still
		// lands by the page's own anchor offset, which is below the bar.
		//
		// The address follows without adding a history entry per click; focus moves to the row, so the
		// next Tab continues from there rather than from the bar.
		bar.addEventListener('click', (event) => {
			const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-step]');
			const row = link ? document.getElementById(link.dataset.step ?? '') : null;
			if (!row) return;
			event.preventDefault();
			const under = (parseFloat(getComputedStyle(bar).top) || 0) + bar.offsetHeight;
			window.scrollTo({
				top: row.getBoundingClientRect().top + window.scrollY - under,
				behavior: reduce.matches ? 'instant' : 'smooth',
			});
			history.replaceState(null, '', `#${row.id}`);
			if (!row.hasAttribute('tabindex')) row.setAttribute('tabindex', '-1');
			row.focus({ preventScroll: true });
		});
	}
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	.steps-bar {
		--steps-ink: var(--color-text, #17181c);
		--steps-muted: var(--color-text-secondary, #5b616e);

		position: fixed;
		// The header's own offset (`HeaderContent`: it sits under the promo strip and rises with it)
		// plus the header's height, so the bar is always flush under it.
		top: calc(var(--promo-cur, var(--promo-h, 0px)) + var(--home-header-h, 64px));
		right: 0;
		left: 0;
		// Under the header's 8888, so the menu drawer opens over the bar rather than under it.
		z-index: 8000;
		// The header's surface and the header's shadow. While the bar is docked the header gives its
		// shadow up (below), so the two read as one bar with a second line, not two bars stacked.
		border-top: 1px solid rgba(var(--color-shadow-ui-rgb), 0.06);
		background: var(--color-bg-surface, #fff);
		box-shadow: var(--shadow-header);

		// Hidden until docked, and out of the tab order with it. A FADE, and a short one, with no
		// movement: across, the drawn steps are exactly where the docked ones appear, so anything that
		// moved would read as a second bar arriving rather than as the track stopping.
		visibility: hidden;
		opacity: 0;
		// The push at the end, which tracks the scroll exactly and so never transitions.
		translate: 0 var(--steps-push, 0px);
		transition:
			opacity 0.12s ease,
			visibility 0s linear 0.12s;

		&[data-docked] {
			visibility: visible;
			opacity: 1;
			transition:
				opacity 0.12s ease,
				visibility 0s;
		}
	}

	// The bar's own layout, for when the track is not across (or before it has been measured): the
	// rows' measure, inset by the page gutter and the card's padding.
	.steps-bar__list {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		column-gap: var(--steps-gap, 16px);
		box-sizing: border-box;
		max-width: $page-measure-box;
		height: 48px;
		margin: 0 auto;
		padding: 0 44px;
		list-style: none;
	}

	// Over the track's own box, read by the script, so the columns are the drawing's columns.
	.steps-bar[data-across] .steps-bar__list {
		width: var(--steps-w);
		max-width: none;
		margin: 0 0 0 var(--steps-x);
		padding: 0;
	}

	.steps-bar__item {
		min-width: 0;
	}

	// 9 of air, the 28px tile, 9 more, the 2px meter: the drawn step's head, exactly.
	.steps-bar__link {
		position: relative;
		display: flex;
		align-items: center;
		gap: 10px;
		box-sizing: border-box;
		height: 100%;
		padding: 9px 0 11px;
		border-radius: 4px;
		text-decoration: none;

		&:focus-visible {
			outline: 2px solid var(--stage);
			outline-offset: 2px;
		}
	}

	.steps-bar__tile {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border-radius: 32%;
		background: color-mix(in srgb, var(--stage) 10%, #fff);
		color: var(--stage);
		transition:
			background-color 0.2s ease,
			color 0.2s ease;

		:global([data-icon]) {
			width: 18px;
			height: 18px;
		}
	}

	// The colour is set HERE, on the verb, never on the link: the homepage paints every `#overflow li a`
	// in the brand at (1,0,2), which no class on the link can outrank without an id of its own.
	.steps-bar__name {
		@include type-tile;
		overflow: hidden;
		color: var(--steps-ink);
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	// The drawn step's rule, now a meter: the tint is the track, the stage's full hue the reading.
	.steps-bar__meter {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: 2px;
		overflow: hidden;
		background: color-mix(in srgb, var(--stage) 22%, #fff);
	}

	.steps-bar__fill {
		display: block;
		height: 100%;
		background: var(--stage);
		transform: scaleX(var(--p, 0));
		transform-origin: left center;
	}

	// The step being read: its tile is the row's mark, filled.
	.steps-bar__link[aria-current] .steps-bar__tile {
		background: var(--stage);
		color: #fff;
	}

	// --- when the track runs down the card: the four verbs, nothing else ----------------------------
	//
	// Keyed to the TRACK's form, which the script reports, rather than to a width of the bar's own:
	// the two would otherwise turn at different widths (the track's container is the page column,
	// the bar's is the window), and in between, a bar of tiles would be docked from a vertical track.
	//
	// Four tiles and four verbs do not fit 335px. The verbs alone do, at 14px medium, with room:
	// "Automate", the longest, sets 64.9px in an 80px column at a 375px window. The current one is
	// set in ink and the rest in grey, since there is no tile left to carry the state.
	.steps-bar:not([data-across]) {
		.steps-bar__list {
			height: 44px;
			padding: 0 16px;
			column-gap: 8px;
		}

		.steps-bar__link {
			justify-content: center;
			padding: 0;
		}

		.steps-bar__tile {
			display: none;
		}

		.steps-bar__name {
			@include type-small-strong;
			color: var(--steps-muted);
		}

		[aria-current] .steps-bar__name {
			color: var(--steps-ink);
		}
	}

	// After both forms, so it wins in either: the verb takes its stage's colour under the pointer.
	.steps-bar .steps-bar__link:hover .steps-bar__name {
		color: var(--stage);
	}

	@media (prefers-reduced-motion: reduce) {
		.steps-bar,
		.steps-bar[data-docked] {
			transition: none;
		}

		.steps-bar__tile {
			transition: none;
		}
	}

	// --- what the bar changes on the rest of the page --------------------------------------------
	//
	// Keyed on attributes the script sets, so none of it applies without the bar.

	// The rows' marks: the bar carries them now. `:root` for the score — the component's own rule
	// and `_home-rows.scss` both reach this badge at (0,2,0).
	:global(:root [data-step-row] .feature-badge) {
		display: none;
	}

	// Focus moved to a row by a click is for the next Tab, not something to draw.
	:global([data-step-row]:focus) {
		outline: none;
	}

	// The header gives its shadow to the bar while the bar is docked.
	:global(:root[data-steps-docked] header.header[data-header-scrolled]) {
		box-shadow: none;
	}
</style>
