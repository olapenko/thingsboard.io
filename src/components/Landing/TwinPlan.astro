---
import { Icon } from 'astro-icon/components';
import { DIGITAL_TWIN_STAGES, PHYSICAL_ASSET, TWIN, TWIN_FLOWS, TWIN_HISTORY } from '@data/digital-twin-visual';
import { segmentWidth, sparkPaths, sparkY } from '@util/sparkline';

/**
 * The twin composition with the physical half drawn as a FLOOR PLAN, seen from above. A third
 * candidate beside `TwinCorridor`'s two, which are untouched — the plain one and the nested one are
 * both still in the panel and the nested one is still what the home preview shows.
 *
 * --- what is different ------------------------------------------------------------------------
 *
 * The other two draw the physical side as cards: a frame for the site, a card for the unit, a list
 * of devices inside it. This draws the place instead. The warehouse is a plan, the zone is an area
 * marked on its floor, and the cold storage unit is a rectangle standing in that area — no header
 * band, no device rows, no status light.
 *
 * The argument for it: containment stops being a stack of rounded rectangles and becomes what it
 * actually is, a thing standing somewhere. The twin opposite says `Acme Inc > Warehouse 3 > Zone B`
 * in words; the plan says the same in plan. Nothing has to assert a hierarchy that the drawing is
 * already showing.
 *
 * The argument against, and it is the thing to judge: the unit stops listing its devices, so the
 * word "devices" in the copy beside the visual has nothing in the picture any more — only the twin's
 * three rows imply them. And a plan of one object risks looking like an empty room, which is why
 * there are two racks on the floor and a door on the unit rather than a bare box.
 *
 * The door is the detail that makes it a plan rather than three nested rectangles: a gap in the
 * unit's wall with its swing drawn, in the plan convention. It is also the one the twin reports on,
 * so the two halves are describing the same door.
 *
 * --- what is shared ---------------------------------------------------------------------------
 *
 * The twin's card, its three rows and the whole of the day's data are copied from `TwinCorridor`
 * rather than shared, because that component is what the home preview renders and the directory's
 * rule is not to edit a shipped visual to try an idea. If this one wins, the two should be folded
 * back together; while it is a draft, the duplication is the cheaper mistake.
 *
 * The connectors work exactly as they do there: elbows, anchored to the unit's top and bottom edges
 * and to the twin's left, drawn on one layer over the whole composition.
 */

interface Props {
	/**
	 * Put the unit among its peers: three more cold rooms on the floor, faded and unlabelled, and
	 * no door drawn on any of them.
	 *
	 * It changes what the picture is about. Alone, the unit is THE cold storage unit and the plan is
	 * its address. Among others it becomes one of several, which is the truer thing for a platform
	 * whose argument is that it models a whole estate — and it is why the subject needs a name that
	 * identifies it rather than describes its type.
	 */
	peers?: boolean;
}

const { peers = false } = Astro.props;

// --- content ------------------------------------------------------------------------------

const SITE = { name: PHYSICAL_ASSET.path[0], icon: 'tabler:building-warehouse' };
const ZONE = { name: PHYSICAL_ASSET.path[1], icon: 'tabler:map-pin' };

/** As deep as the plan goes, so the two halves describe the same containment. */
const PATH = ['Acme Inc', ...PHYSICAL_ASSET.path];

/**
 * Among peers the unit needs a name that picks it out rather than one that says what it is: every
 * rectangle on that floor is a cold storage unit. Overridden here rather than in the shared data,
 * which the other candidates and the shipped visual are still reading.
 */
const UNIT_NAME = peers ? 'Cold storage 02' : PHYSICAL_ASSET.name;
const TWIN_NAME = peers ? `${UNIT_NAME} twin` : TWIN.name;

const telemetry = TWIN_FLOWS.find((f) => f.to === 'twin');
const commands = TWIN_FLOWS.find((f) => f.to === 'physical');

const attr = (key: string) => TWIN.attributes.find((a) => a.key === key)?.value ?? '';

// --- the day ------------------------------------------------------------------------------
//
// Copied from `TwinCorridor`. See the note above on why this is a copy.

const TAU = Math.PI * 2;
const STEP_H = 0.5;
const STEPS = TWIN_HISTORY.hours / STEP_H;
const START_H = 1;

const bump = (t: number) => Math.pow(Math.max(0, Math.sin((TAU * t) / 6)), 6);
const tempAt = (t: number) =>
	-18.3 + 0.9 * Math.sin((TAU * t) / 9 + 0.6) + 0.3 * Math.sin((TAU * t) / 2.3) + 1.1 * bump(t);

const SERIES = Array.from({ length: STEPS + 1 }, (_, i) => Math.round(tempAt(START_H + i * STEP_H) * 100) / 100);

const WINDOW = 5;
const smooth = (i: number) => {
	const lo = Math.max(0, i - (WINDOW >> 1));
	const hi = Math.min(SERIES.length - 1, i + (WINDOW >> 1));
	let sum = 0;
	for (let j = lo; j <= hi; j++) sum += SERIES[j];
	return sum / (hi - lo + 1);
};
const RUNNING = Array.from({ length: STEPS }, (_, i) => smooth(i + 1) < smooth(i));

const IDLE_KW = 0.35;
const RUN_KW = 2.4;
const POWER = Array.from({ length: STEPS + 1 }, (_, i) => {
	const on = RUNNING[Math.min(i, STEPS - 1)];
	return Math.round(((on ? RUN_KW : IDLE_KW) + 0.05 * Math.sin(i * 1.7)) * 100) / 100;
});

const DOOR_OPEN = Array.from({ length: STEPS }, (_, i) => {
	const t = START_H + i * STEP_H;
	return bump(t) > 0.55 && Math.floor(t / 6) % 2 === 1;
});

const spans = (flags: boolean[]) => {
	const out: { x: number; w: number }[] = [];
	for (let i = 0; i < flags.length; i++) {
		if (!flags[i]) continue;
		const start = i;
		while (flags[i + 1]) i++;
		out.push({ x: (start / flags.length) * 100, w: ((i - start + 1) / flags.length) * 100 });
	}
	return out;
};

const DOOR_SPANS = spans(DOOR_OPEN);

const CHART_H = 30;
const BAND_H = 12;

const TEMP_VIEW = { w: 100, h: CHART_H, pad: 0 };
const temp = sparkPaths(SERIES, TWIN_HISTORY.domain, TEMP_VIEW);

const POWER_VIEW = { w: 100, h: CHART_H, pad: 0 };
const POWER_DOMAIN: [number, number] = [0, 3];
const POWER_SEG = segmentWidth(POWER.length, POWER_VIEW);
const powerPts = POWER.map((v, i) => `${(i * POWER_SEG).toFixed(2)},${sparkY(v, POWER_DOMAIN, POWER_VIEW).toFixed(2)}`);
const power = {
	line: `M ${powerPts.join(' L ')}`,
	area: `M ${powerPts.join(' L ')} L ${POWER_VIEW.w},${POWER_VIEW.h} L 0,${POWER_VIEW.h} Z`,
};

// --- geometry -----------------------------------------------------------------------------
//
// The same footprint as the other two, so all three can be laid over each other.

const NATIVE = 558;
const COL = { site: 258, gut: 18, twin: 282 };
const BODY = 338;

const FRAME_PAD = 12;
const HEAD_H = 24; // the warehouse's name, on the plan's top line

const TWIN_HEAD_PAD = 12;
const PATH_H = 18;
const PATH_GAP = 14;
const NAME_H = 22;
const TWIN_HEAD_H = TWIN_HEAD_PAD + PATH_H + PATH_GAP + NAME_H + 14;

// --- the plan ------------------------------------------------------------------------------
//
// Everything on the left is placed in the column's own 258 x 338 units, so the whole plan scales
// with the composition and nothing has to be positioned as a percentage of something else.
//
// Read top to bottom: the warehouse's name, then open floor with two racks on it, then the zone
// marked out across the lower two thirds, with the unit standing in it. The telemetry line runs
// across that open floor, which is the same corridor trade the other two make — here it reads as
// the link leaving the building rather than as an arrow in a gutter.

const ZONE_BOX = { x: FRAME_PAD, y: 110, w: COL.site - FRAME_PAD * 2, h: 216 };
const ZONE_PAD = 8;

// Centred on the same axis the other two put it on, so the risers stand where they always have.
const UNIT = { x: 58, y: 168, w: 142, h: 94 };
const UNIT_TOP = UNIT.y;
const UNIT_BOT = UNIT.y + UNIT.h;

// A door in the unit's left wall, drawn the way a plan draws one: a gap in the wall, and the leaf
// swung open across the floor it opens onto. It faces the aisle rather than the twin, and it is on
// the wall the connectors do not use — they take the top and bottom edges.
const DOOR = { y: 196, h: 44, swing: 34 };

// Racking on the open floor, so the zone reads as an area OF a warehouse rather than as the whole
// of one. Below the telemetry run and above the zone, which is the only band they fit in.
const RACKS = peers
	? []
	: [
			{ x: 12, y: 78, w: 68, h: 22 },
			{ x: 178, y: 78, w: 68, h: 22 },
		];

// The other cold rooms, when there are any: two out on the floor and one sharing the zone, so the
// subject is one of several both in the building and in its own area. Faded and unnamed — they are
// there to be counted, not read — and placed clear of both risers, which stand on x = 129.
const PEERS = peers
	? [
			{ x: 12, y: 72, w: 78, h: 34 },
			{ x: 168, y: 72, w: 78, h: 34 },
			{ x: 20, y: 272, w: 74, h: 46 },
		]
	: [];

const UNIT_X = UNIT.x + UNIT.w / 2;
const TWIN_X = COL.site + COL.gut;

const UP_Y = TWIN_HEAD_PAD + PATH_H + PATH_GAP + NAME_H;
const DOWN_Y = UNIT_BOT + 28;
const LABEL_GAP = 16;
const LABEL_X = (UNIT_X + COL.site) / 2;

const R = 12;
const HEAD = 8;
const WING = 5;

const wires = {
	up: `M ${UNIT_X},${UNIT_TOP} L ${UNIT_X},${UP_Y + R} Q ${UNIT_X},${UP_Y} ${UNIT_X + R},${UP_Y} L ${TWIN_X},${UP_Y}`,
	upHead: `M ${TWIN_X - HEAD},${UP_Y - WING} L ${TWIN_X},${UP_Y} L ${TWIN_X - HEAD},${UP_Y + WING}`,
	down: `M ${TWIN_X},${DOWN_Y} L ${UNIT_X + R},${DOWN_Y} Q ${UNIT_X},${DOWN_Y} ${UNIT_X},${DOWN_Y - R} L ${UNIT_X},${UNIT_BOT}`,
	downHead: `M ${UNIT_X - WING},${UNIT_BOT + HEAD} L ${UNIT_X},${UNIT_BOT} L ${UNIT_X + WING},${UNIT_BOT + HEAD}`,
};

/** The door leaf and its swing, in the plan's own coordinates. */
const door = {
	leaf: `M ${UNIT.x},${DOOR.y} L ${UNIT.x - DOOR.swing},${DOOR.y}`,
	arc: `M ${UNIT.x - DOOR.swing},${DOOR.y} A ${DOOR.swing},${DOOR.swing} 0 0 0 ${UNIT.x},${DOOR.y + DOOR.swing}`,
};

const CARD_PAD_B = 14;
const ROWS = [
	{ key: 'temperature', value: attr('temperature'), h: 90, kind: 'spline', accent: '#0e7490', on: null },
	{
		key: 'power',
		value: `${POWER[POWER.length - 1].toFixed(1)} kW`,
		h: 90,
		kind: 'steps',
		accent: '#b45309',
		on: null,
	},
	{ key: 'door', value: attr('door'), h: 64, kind: 'band', accent: '#b23c33', on: null },
];

const at = (x: number, y: number) => `--x: ${((x / NATIVE) * 100).toFixed(3)}%; --y: ${((y / BODY) * 100).toFixed(3)}%`;

const vars = [
	`--tp-u: clamp(0.45px, calc(100cqw / ${NATIVE}), 1.15px)`,
	`--tp-native: ${NATIVE}`,
	`--tp-site: ${COL.site}`,
	`--tp-gut: ${COL.gut}`,
	`--tp-twin: ${COL.twin}`,
	`--tp-body: ${BODY}`,
	`--tp-pad: ${FRAME_PAD}`,
	`--tp-head: ${HEAD_H}`,
	`--tp-twin-head: ${TWIN_HEAD_H}`,
	`--tp-head-pad: ${TWIN_HEAD_PAD}`,
	`--tp-path-h: ${PATH_H}`,
	`--tp-path-gap: ${PATH_GAP}`,
	`--tp-name-h: ${NAME_H}`,
	`--tp-chart-h: ${CHART_H}`,
	`--tp-band-h: ${BAND_H}`,
	`--tp-card-pad-b: ${CARD_PAD_B}`,
	`--tp-zone-x: ${ZONE_BOX.x}`,
	`--tp-zone-y: ${ZONE_BOX.y}`,
	`--tp-zone-w: ${ZONE_BOX.w}`,
	`--tp-zone-h: ${ZONE_BOX.h}`,
	`--tp-zone-pad: ${ZONE_PAD}`,
	`--tp-unit-x: ${UNIT.x}`,
	`--tp-unit-y: ${UNIT.y}`,
	`--tp-unit-w: ${UNIT.w}`,
	`--tp-unit-h: ${UNIT.h}`,
	// Two walls' worth: the plan's own outline, which the risers cross on their way out of the
	// building, is 2px and box-sizing takes it out of the space everything inside is placed in.
	`--tp-nudge: 2px`,
].join(';');
---

<div class="tp-fit">
	<div class="tp" style={vars} data-twin-plan>
		<p class="tp__stage">{DIGITAL_TWIN_STAGES.physical}</p>
		<p class="tp__stage tp__stage--right">{DIGITAL_TWIN_STAGES.twin}</p>

		<div class="tp__body">
			{/* --- the warehouse, from above ------------------------------------------------- */}
			<div class="tp__plan">
				<p class="tp__site-name">
					<Icon name={SITE.icon} aria-hidden="true" />
					<span>{SITE.name}</span>
				</p>

				{RACKS.map((r) => <i class="tp__rack" style={`--x: ${r.x}; --y: ${r.y}; --w: ${r.w}; --h: ${r.h}`} />)}
				{PEERS.map((r) => <i class="tp__peer" style={`--x: ${r.x}; --y: ${r.y}; --w: ${r.w}; --h: ${r.h}`} />)}

				<div class="tp__zone">
					<p class="tp__zone-name">
						<Icon name={ZONE.icon} aria-hidden="true" />
						<span>{ZONE.name}</span>
					</p>
				</div>

				<div class="tp__unit">
					<span>{UNIT_NAME}</span>
				</div>

				{
					/* The door, over the unit's wall: a gap where the leaf is, then the leaf and its swing
				    across the floor. Drawn last so it sits on top of the dark. Dropped among peers,
				    where three more rooms are already saying what kind of thing these are. */
				}
				{
					!peers && (
						<svg
							class="tp__door"
							viewBox={`0 0 ${COL.site} ${BODY}`}
							preserveAspectRatio="none"
							aria-hidden="true"
							focusable="false"
						>
							<rect class="tp__door-gap" x={UNIT.x - 2} y={DOOR.y} width="4" height={DOOR.h} />
							<path class="tp__door-line" d={door.leaf} />
							<path class="tp__door-line tp__door-line--swing" d={door.arc} />
						</svg>
					)
				}
			</div>

			{/* --- its twin ------------------------------------------------------------------ */}
			<div class="tp__card">
				<header class="tp__head">
					<p class="tp__path">
						{
							PATH.map((step, i) => (
								<Fragment>
									{i > 0 && (
										<span class="tp__sep" aria-hidden="true">
											›
										</span>
									)}
									<span>{step}</span>
								</Fragment>
							))
						}
					</p>
					<p class="tp__name">
						<Icon name="tabler:box-model" aria-hidden="true" />
						<span>{TWIN_NAME}</span>
					</p>
				</header>

				<ul class="tp__attrs">
					{
						ROWS.map((row) => (
							<li
								class="tp__attr"
								style={`--h: ${row.h}; --accent: ${row.accent}; --accent-on: ${row.on ?? row.accent}`}
								data-twin-attr={row.key}
							>
								<span class="tp__k">{row.key}</span>
								<span class="tp__v">{row.value}</span>

								{row.kind === 'band' ? (
									<span class="tp__band">
										<svg viewBox={`0 0 100 ${BAND_H}`} preserveAspectRatio="none" aria-hidden="true">
											<rect class="tp__band-off" x="0" y="0" width="100" height={BAND_H} />
											{DOOR_SPANS.map((s) => (
												<rect class="tp__band-on" x={s.x} y="0" width={s.w} height={BAND_H} />
											))}
										</svg>
									</span>
								) : (
									<span class="tp__chart">
										<svg viewBox={`0 0 100 ${CHART_H}`} preserveAspectRatio="none" aria-hidden="true">
											<path class="tp__chart-area" d={row.kind === 'steps' ? power.area : temp.area} />
											<path class="tp__chart-line" d={row.kind === 'steps' ? power.line : temp.line} />
										</svg>
									</span>
								)}
							</li>
						))
					}
				</ul>
			</div>

			<svg
				class="tp__wires"
				viewBox={`0 0 ${NATIVE} ${BODY}`}
				preserveAspectRatio="none"
				aria-hidden="true"
				focusable="false"
			>
				<path class="tp__wire" d={wires.up}></path>
				<path class="tp__wire tp__wire--head" d={wires.upHead}></path>
				<path class="tp__wire" d={wires.down}></path>
				<path class="tp__wire tp__wire--head" d={wires.downHead}></path>
			</svg>

			<span class="tp__flow-name" style={at(LABEL_X, UP_Y - LABEL_GAP)}>{telemetry?.label}</span>
			<span class="tp__flow-name" style={at(LABEL_X, DOWN_Y + LABEL_GAP)}>{commands?.label}</span>
		</div>
	</div>
</div>

<script>
	/** The two readings tick, as in the other two. Nothing else moves. */
	const BEAT_MS = 3000;
	const TEMPS = [-18.4, -18.2, -18.6, -18.3, -18.7, -18.1];
	const KW = [2.4, 2.3, 2.5, 2.4, 2.6, 2.3];

	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll<HTMLElement>('[data-twin-plan]').forEach((root) => {
		if (reduce) return;
		const temp = root.querySelector<HTMLElement>('[data-twin-attr="temperature"] .tp__v');
		const power = root.querySelector<HTMLElement>('[data-twin-attr="power"] .tp__v');
		if (!temp || !power) return;

		let beat = 0;
		let visible = false;
		let timer = 0;

		const tick = () => {
			if (!visible) return;
			beat++;
			temp.textContent = `−${Math.abs(TEMPS[beat % TEMPS.length]).toFixed(1)} °C`;
			power.textContent = `${KW[beat % KW.length].toFixed(1)} kW`;
			timer = window.setTimeout(tick, BEAT_MS);
		};

		new IntersectionObserver(
			(entries) => {
				visible = entries.some((e) => e.isIntersecting);
				clearTimeout(timer);
				if (visible) timer = window.setTimeout(tick, BEAT_MS);
			},
			{ rootMargin: '80px' }
		).observe(root);
	});
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	// The same floor marking the other two use, and here it is doing its literal job.
	@mixin hatch {
		background: repeating-linear-gradient(45deg, var(--tp-shade) 0 #{u(12)}, transparent #{u(12)} #{u(20)});
	}

	.tp-fit {
		container-type: inline-size;
	}

	.tp {
		--u: var(--tp-u);
		--tp-label: var(--kv-label, 16);
		// A shade rather than a grey, so the plan takes the hue of whatever it is laid on. See the
		// note in TwinCorridor for the measurements behind it.
		--tp-shade: rgba(0, 0, 0, 0.06);
		display: grid;
		grid-template-columns: u(var(--tp-site)) u(var(--tp-gut)) u(var(--tp-twin));
		justify-content: center;
		max-width: u(var(--tp-native));
		margin: 0 auto;
	}

	:global([data-theme='dark']) .tp {
		--tp-shade: rgba(255, 255, 255, 0.08);
	}

	.tp__stage {
		grid-column: 1;
		min-height: u(24);
		margin: 0 0 u(8);
		font-size: u(var(--tp-label));
		line-height: u(24);
		text-align: center;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		white-space: nowrap;
		color: var(--color-text-secondary, #5b616e);
	}

	.tp__stage--right {
		grid-column: 3;
	}

	.tp__body {
		position: relative;
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: u(var(--tp-site)) u(var(--tp-gut)) u(var(--tp-twin));
		height: u(var(--tp-body));
	}

	// --- the plan -------------------------------------------------------------------

	// The building. Everything inside is placed absolutely in the column's own units, which is what
	// makes this a drawing rather than a stack of boxes — a plan has no flow.
	.tp__plan {
		position: relative;
		grid-column: 1;
		height: u(var(--tp-body));
		border: 2px solid var(--tp-shade);
		border-radius: u(var(--flow-radius, 8));
	}

	.tp__site-name {
		display: flex;
		position: absolute;
		top: u(var(--tp-pad));
		left: u(var(--tp-pad));
		align-items: center;
		gap: u(8);
		height: u(var(--tp-head));
		margin: 0;
		font-size: u(15);
		font-weight: $font-weight-medium;
		line-height: u(22);
		white-space: nowrap;
		color: var(--color-text-secondary, #5b616e);

		[data-icon] {
			flex: none;
			width: u(18);
			height: u(18);
		}
	}

	// Racking, outlined and empty. It is context, not content: enough to say the zone is an area of a
	// floor rather than the whole floor, and quiet enough not to be read as another object.
	.tp__rack {
		display: block;
		position: absolute;
		top: u(var(--y));
		left: u(var(--x));
		width: u(var(--w));
		height: u(var(--h));
		border: 1px solid var(--tp-shade);
		border-radius: u(2);
	}

	// The other rooms. The unit's own surface at a fraction of its strength, and no shadow — the same
	// kind of thing, receded, so they can be counted without being read. Unlabelled on purpose: names
	// on them would make the floor a list.
	.tp__peer {
		display: block;
		position: absolute;
		top: u(var(--y));
		left: u(var(--x));
		width: u(var(--w));
		height: u(var(--h));
		border-radius: u(var(--flow-radius, 8));
		background: var(--flow-chrome, #1b1e27);
		opacity: 0.16;
	}

	.tp__zone {
		position: absolute;
		top: u(var(--tp-zone-y));
		left: u(var(--tp-zone-x));
		width: u(var(--tp-zone-w));
		height: u(var(--tp-zone-h));
		padding: u(var(--tp-zone-pad));
		border-radius: u(var(--flow-radius, 8));
		@include hatch;
	}

	.tp__zone-name {
		display: flex;
		align-items: center;
		gap: u(8);
		margin: 0;
		font-size: u(15);
		font-weight: $font-weight-medium;
		line-height: u(22);
		white-space: nowrap;
		color: var(--color-text-secondary, #5b616e);

		[data-icon] {
			flex: none;
			width: u(18);
			height: u(18);
		}
	}

	// The unit, in plan: a rectangle standing on the floor with its name in it. The family's dark
	// surface and its shadow, so it is still the one solid object in the picture — but no head band,
	// no rows and no status light, because from above a cold room is a box.
	.tp__unit {
		display: flex;
		position: absolute;
		top: u(var(--tp-unit-y));
		left: u(var(--tp-unit-x));
