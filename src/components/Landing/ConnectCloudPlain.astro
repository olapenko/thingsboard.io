---
import { Icon } from 'astro-icon/components';
import { CONNECT_COPY } from '@data/connect-visual';

/**
 * The cloud again, with a different vocabulary: no vendor names, and no categories.
 *
 * Same composition as `ConnectCloud` — hand-placed rows of chips with the squircle biting into the
 * middle three — because the composition was not the question. Two things change:
 *
 *   1. NO VENDORS. `ConnectCloud` names ChirpStack, TTN, LORIOT, ThingPark, AWS IoT, Azure IoT,
 *      Pub/Sub and AWS SQS. Where a vendor stood, this names the category of thing instead —
 *      "MQTT brokers", "Cloud IoT platforms" — which is also more honest, since support was never
 *      limited to whichever three clouds happened to fit the row.
 *
 *   2. NO COLOUR CODING. `ConnectCloud` tints each chip by its route, and the key that explained
 *      those four hues has been removed from the section's copy. Four hues nobody is taught are
 *      decoration that looks like information, so here every chip is the same neutral. The picture
 *      claims one thing — "whatever you have, it is in here" — and says it once.
 *
 * Four names are still products rather than standards: Sigfox, Kafka, RabbitMQ and S7. Generic
 * stand-ins exist for each — "LPWAN networks", "message brokers" (which would absorb Kafka and
 * RabbitMQ into one chip), "PLC protocols" — and they are the next thing to look at if the concern
 * is brand names as such rather than picking winners among cloud vendors.
 */

const NATIVE = 422;
const CHIP_H = 32;
const GAP = 6;
const BADGE = 104;
// See ConnectCloud for why 76 and not 88: it leaves an 8-unit bite, which lands on a chip's 10
// units of padding rather than through a glyph.
const HOLE = 76;

/**
 * The twenty-one names, hand-placed.
 *
 * Hand-placed rather than generated, as in `ConnectCloud`: a scatter reads as a mess about one time
 * in three and this has to be the same picture on every load. Without accents there is one rule
 * fewer to satisfy — no "no two neighbours share a colour" — so the arrangement is only about the
 * silhouette being a block rather than a lens, which means the rows coming out close in width.
 *
 * "Cloud IoT platforms" is the constraint: at nineteen characters it is more than twice the next
 * longest name, so it sets its row and cannot go in a straddle row's side without making that side
 * wider than the hole allows. Its row therefore needs a fourth chip to reach the others — measured,
 * three left it at 301 units against 418 for the middle rows, which tapers the block into a lens.
 * RabbitMQ is the one that fits, and it comes out of the row above, which was governed by its other
 * side and so did not shrink when it left.
 */
const ROWS: ({ chips: string[] } | { left: string[]; right: string[]; plate?: true })[] = [
	{ chips: ['Modbus', 'Sigfox', 'LoRaWAN', 'OPC UA', 'BACnet'] },
	{ left: ['Sparkplug B', 'KNX'], right: ['HTTP', 'MQTT'] },
	{ left: ['MQTT brokers', 'S7'], right: ['TCP/UDP', 'BLE'], plate: true },
	{ left: ['Kafka', 'LwM2M'], right: ['CAN', 'OCPP'] },
	{ chips: ['CoAP', 'Cloud IoT platforms', 'SNMP', 'RabbitMQ'] },
];

/** Every keyword has to be placed exactly once — a duplicate or a drop is invisible in a screenshot. */
const KEYWORDS = [
	'LoRaWAN',
	'Sigfox',
	'MQTT brokers',
	'Kafka',
	'RabbitMQ',
	'Modbus',
	'OPC UA',
	'S7',
	'BACnet',
	'KNX',
	'TCP/UDP',
	'MQTT',
	'HTTP',
	'CoAP',
	'CAN',
	'Cloud IoT platforms',
	'BLE',
	'LwM2M',
	'SNMP',
	'Sparkplug B',
	'OCPP',
];
const placed = ROWS.flatMap((r) => ('chips' in r ? r.chips : [...r.left, ...r.right]));
const missing = KEYWORDS.filter((n) => !placed.includes(n));
const extra = placed.filter((n) => !KEYWORDS.includes(n));
const dupes = placed.filter((n, i) => placed.indexOf(n) !== i);
if (missing.length || extra.length || dupes.length) {
	throw new Error(
		'ConnectCloudPlain is out of step with its keyword list.' +
			(missing.length ? ` Not placed: ${missing.join(', ')}.` : '') +
			(extra.length ? ` Placed but not a keyword: ${extra.join(', ')}.` : '') +
			(dupes.length ? ` Placed twice: ${dupes.join(', ')}.` : '')
	);
}

const vars = [
	`--cp-u: min(1.15px, calc(100cqw / ${NATIVE}))`,
	`--cp-native: ${NATIVE}`,
	`--cp-chip-h: ${CHIP_H}`,
	`--cp-gap: ${GAP}`,
	`--cp-hole: ${HOLE}`,
	`--cp-badge: ${BADGE}`,
].join('; ');
---

<div class="cp-fit">
	<div class="cp" style={vars}>
		{
			ROWS.map((row) =>
				'chips' in row ? (
					<ul class="cp__row">
						{row.chips.map((n) => (
							<li>
								<span class="cp__chip">{n}</span>
							</li>
						))}
					</ul>
				) : (
					<div class="cp__row cp__row--split">
						<ul class="cp__side">
							{row.left.map((n) => (
								<li>
									<span class="cp__chip">{n}</span>
								</li>
							))}
						</ul>

						{/* Only the middle hole carries the badge; the other two are just space. */}
						<div class="cp__hole">
							{row.plate && (
								<span class="cp__badge" aria-hidden="true" style={`--cp-badge-color: ${CONNECT_COPY.badge.color}`}>
									<Icon name={CONNECT_COPY.badge.icon} />
								</span>
							)}
						</div>

						<ul class="cp__side">
							{row.right.map((n) => (
								<li>
									<span class="cp__chip">{n}</span>
								</li>
							))}
						</ul>
					</div>
				)
			)
		}
	</div>
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	.cp-fit {
		container-type: inline-size;
	}

	.cp {
		--u: var(--cp-u);
		display: grid;
		// `minmax(0, 1fr)`, not the implicit `auto` track: auto takes max-content, so `max-width: 100%`
		// on a straddle row would resolve against the widest row and never bite. See ConnectCloud.
		grid-template-columns: minmax(0, 1fr);
		gap: u(var(--cp-gap));
		justify-items: center;
		max-width: u(var(--cp-native));
		margin-inline: auto;
	}

	.cp__row {
		display: flex;
		// Not used by the design — every row fits, measured. Here so that a name gaining a character
		// says "this no longer fits" by wrapping, rather than the chips leaving the box.
		flex-wrap: wrap;
		gap: u(var(--cp-gap));
		justify-content: center;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	// Two equal outer tracks with the hole between them, so the badge is centred by construction.
	// `max-content`, not `100%`: at 100% the fr tracks absorb every spare pixel and the middle of the
	// cloud becomes a band of air with the chips pinned to the badge.
	.cp__row--split {
		display: grid;
		grid-template-columns: 1fr u(var(--cp-hole)) 1fr;
		gap: u(var(--cp-gap));
		align-items: center;
		width: max-content;
		max-width: 100%;
	}

	.cp__row li,
	.cp__side li {
		display: flex;
	}

	.cp__side {
		display: flex;
		flex-wrap: wrap;
		gap: u(var(--cp-gap));
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.cp__hole {
		display: grid;
		place-items: center;
	}

	.cp__badge {
		display: grid;
		place-items: center;
		width: u(var(--cp-badge));
		height: u(var(--cp-badge));
		// The page's shared squircle.
		border-radius: 32%;
		background: var(--cp-badge-color, #0e7490);
		color: #fff;
		box-shadow: 0 u(4) u(14) rgba(23, 28, 34, 0.18);

		:global([data-icon]) {
			width: u(52);
			height: u(52);
		}
	}

	// One neutral for every chip. No accent, because there are no categories to code — and a hue a
	// reader has never been taught is decoration that looks like information.
	.cp__chip {
		display: inline-flex;
		align-items: center;
		height: u(var(--cp-chip-h));
		padding: 0 u(10);
		border-radius: u(var(--flow-radius, 8));
		background: color-mix(in srgb, var(--color-text, #17181c) 7%, transparent);
		font-family: $font-family-mono;
		font-size: u(17);
		font-weight: $font-weight-bold;
		line-height: u(24);
		white-space: nowrap;
		color: var(--color-text);
	}
</style>
