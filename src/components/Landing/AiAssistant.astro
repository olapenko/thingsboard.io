---
import { Icon } from 'astro-icon/components';
import { AI_ASSISTANT_DEMO, AI_ASSISTANT_LABEL } from '@data/ai-visual';

/**
 * The AI Assistant, as a window typing out one exchange and answering it.
 *
 * Ported from `tb-landing-prototype` (`src/sections/06-ai.html` plus the assistant block in
 * `src/scripts/00-block.js.html`).
 *
 * ── BARE, NOT IN-APP ──────────────────────────────────────────────────────────────────────────
 * This was the prototype's "In app" treatment: the chat sat on a grey plate inside a slice of the
 * product — green app bar, a card cropped by the left edge, 9px of grey showing all round. That is
 * gone, which is the prototype's own "Bare" switch. The white body now carries the shadow itself,
 * so the window reads as one object instead of a screenshot of a screenshot, and the grey is not
 * competing with the panel wash behind it.
 *
 * The window is CUT AT THE TOP by the panel that holds it (see `AiSection`), and the cut is sized
 * to take the `New chat` bar with it. Nothing above the log earns its space while the demo is
 * running: the log fills from the bottom, so the top of it is empty for most of the loop.
 *
 * ── NO FAKE MOUSE ────────────────────────────────────────────────────────────────────────────
 * The prototype drove this with a drawn cursor: it slid in, became an I-beam, clicked the composer,
 * moved aside while the line was typed, then travelled to Send and pressed it. That is gone, and the
 * demo is KEYBOARD-ONLY — the composer is already focused, the prompt types, Enter commits it.
 *
 * Four reasons, in the order they matter:
 *
 * 1. It argued the wrong thing. The section's claim is that you DESCRIBE what you want in plain
 *    English; a cursor hunting for a button makes the story about clicking.
 * 2. It was the only skeuomorph on the page. Nothing else here draws a pretend input device.
 * 3. It is meaningless on a phone, where most of this traffic is, and `prefers-reduced-motion`
 *    already hid it — so the no-pointer reading was already shipping to two audiences and reads fine.
 * 4. It was the most fragile code here. Its path was computed from `offsetLeft`/`offsetTop` against
 *    a window that is now scaled 1.2x and cropped, so every geometry change was a chance to leave
 *    the arrow pointing at nothing.
 *
 * KEPT from the prototype: the rest of the choreography — type, commit, thinking dots, answer, loop
 * — and the product's own greens, sampled from the ThingsBoard UI, which make it read as the real
 * thing.
 *
 * CHANGED: Material Symbols became Tabler through `astro-icon`, the only icon set this repo ships;
 * `Roboto` is no longer named, because the product UI font is not loaded here and asking for it
 * only produced a fallback; and every query is scoped to this instance, with playback held until
 * the window is on screen and parked again when it leaves — the prototype's script reached the
 * document and ran forever.
 *
 * Nothing here is interactive on purpose. It is a picture of an app, and real controls would be tab
 * stops that do nothing — so the whole thing is one `role="img"` with a label saying what the
 * exchange is, rather than a fake chat log for a screen reader to walk.
 */

interface Props {
	/** Play the exchange. Off renders the empty state as a still. */
	animate?: boolean;
}

const { animate = true } = Astro.props;
---

<div
	class="assistant"
	role="img"
	aria-label={AI_ASSISTANT_LABEL}
	data-assistant-plate
	data-animate={animate ? 'on' : null}
>
	<div class="assistant__bar" aria-hidden="true">
		<span class="assistant__chat">
			New chat
			<Icon name="tabler:chevron-down" />
		</span>
		<span class="assistant__tools">
			<span class="assistant__ring"></span>
			<Icon name="tabler:edit" />
			<Icon name="tabler:x" />
		</span>
	</div>

	<div class="assistant__log" data-assistant-log aria-hidden="true">
		<div class="assistant__intro" data-assistant-intro>
			<p class="assistant__hello">{AI_ASSISTANT_DEMO.hello}</p>
			<p class="assistant__lead">{AI_ASSISTANT_DEMO.lead}</p>
			<span class="assistant__chip">{AI_ASSISTANT_DEMO.chip}</span>
		</div>
	</div>

	<div class="assistant__input" data-assistant-field aria-hidden="true">
		{
			/* The hint is drawn by CSS `content`, which cannot read the data file — so the string is
			   handed over as a custom property rather than retyped in the stylesheet. One source. */
		}
		<span
			class="assistant__typed is-idle"
			style={`--placeholder: "${AI_ASSISTANT_DEMO.placeholder}"`}
			data-assistant-typed></span>
		<span class="assistant__send" data-assistant-send>
			<Icon name="tabler:send" />
		</span>
	</div>

</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	// The product's own greens, sampled from the ThingsBoard UI. Fixed rather than themed: this is a
	// photograph of an app, and the app does not change colour with the page around it.
	.assistant {
		--tb-green: #0a5648;
		--tb-ink: #1c1c1c;
		--tb-muted: #5d6d68;
		--tb-bubble: #e9f0ee;

		// THE UI IS DRAWN NARROW AND BLOWN UP, rather than drawn at the size it ends up.
		//
		// The window occupies 500x396 on the page, but it is authored at 365x289 and scaled by
		// `--ui-scale`, which the section sets. Two things fall out of that, both wanted: every glyph
		// inside renders larger than its declared size, and the layout is a genuinely NARROWER app —
		// text wraps where it would in a 365px panel, so it reads like a real assistant docked in a
		// sidebar instead of a wide box with small type in it.
		//
		// 365 IS THE NUMBER THAT SATISFIES THREE THINGS AT ONCE, and there is not much room either
		// side of it:
		//
		//   composer holds 45 characters      → native ≥ 361
		//   phone body type stays above 11px  → native ≤ 365
		//   body type matches the terminal    → scale ≈ 1.37, which 500 ÷ 365 gives
		//
		// The scale is not a taste setting: it is the common window width divided by this number, so
		// changing either one moves the type at BOTH breakpoints. Re-derive all three if you touch it.
		//
		// `bottom center` pairs with the crop in `AiSection`: the layout box is placed by the flow and
		// the scale grows UP and out from its bottom edge, so the bottom stays where it was put and the
		// overflow goes off the top — which is the edge the panel cuts.
		--ui-scale: 1;

		position: relative;
		display: flex;
		flex-direction: column;
		width: 365px;
		height: 289px;
		overflow: hidden;
		transform: scale(var(--ui-scale));
		transform-origin: bottom center;
		// 8 authored, which renders 9.6 once `--ui-scale` has had it — the terminal is set to 10, so
		// the two windows carry the same corner on the page. Everything authored in this component is
		// multiplied by the scale, radii included.
		border-radius: 8px;
		background: $color-white;
		// The window's own lift, now that there is no plate under it to cast one — and it has to be a
		// SMALL one, for a reason that is easy to miss: this shadow is drawn in authored pixels and
		// then multiplied by `--ui-scale` along with everything else. The old `0 18px 48px` rendered as
		// roughly `0 22px 58px`, which reached ~35px past the window — further than the 31px of panel
		// beside it and the 14px beneath it, so the crop box cut the shadow off and what was left read
		// as a grey smear with straight edges rather than a soft lift.
		//
		// `0 4px 12px` renders as `0 5px 14px`, which stays inside the crop on every side.
		box-shadow: 0 4px 12px rgba(23, 24, 28, 0.1);
		text-align: left;
	}

	.assistant__bar {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: space-between;
		height: 34px;
		padding: 0 12px;
		border-bottom: 1px solid $color-border-dark;
	}

	.assistant__chat {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 12px;
		color: var(--tb-ink);
	}

	.assistant__tools {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.assistant :global(svg) {
		width: 16px;
		height: 16px;
		color: var(--tb-muted);
	}

	// The context ring from the product header.
	.assistant__ring {
		position: relative;
		width: 17px;
		height: 17px;
		border: 2px solid #e2e6e5;
		border-radius: 50%;

		&::after {
			content: '';
			position: absolute;
			top: -1px;
			right: 0;
			width: 5px;
			height: 5px;
			border-radius: 50%;
			background: var(--tb-green);
		}
	}

	// The exchange grows from the bottom, as in a real chat.
	.assistant__log {
		position: relative;
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		justify-content: flex-end;
		gap: 14px;
		min-height: 0;
		padding: 18px 18px 14px;
		overflow: hidden;
		// The list dissolves upward instead of ending on the panel's cut. Masked on the LOG rather
		// than on the window, deliberately: the window's own edge and its shadow stay crisp, and what
		// fades is the conversation — which reads as "this has been going on above" rather than "this
		// box is chopped off".
		//
		// A mask and not an overlay, because the band behind is itself a gradient: any colour painted
		// over the top would be right at one point on that gradient and wrong everywhere else. A mask
		// removes pixels rather than covering them, so it does not care what is behind.
		//
		// THE HOLD AT 20px IS THE POINT, not the ramp's length. The panel cuts 51px into the window and
		// the bar takes 34 of those, so the log's first visible pixel is 17px down — and a ramp that
		// starts at 0 is already a third opaque by then, which is why the old one read as "slightly
		// grey" rather than as a fade. Holding transparent past the cut means the topmost visible line
		// is genuinely gone.
		//
		// TWO RAMPS, because the two states can afford different amounts. This one is the resting
		// state, and it is short because the intro is 99px tall in a 164px log: anything past ~52
		// reaches the greeting, and a half-faded greeting reads as a rendering fault rather than as a
		// fade. Nothing is scrolling off here anyway — there is no conversation yet to suggest.
		-webkit-mask-image: linear-gradient(to bottom, transparent 0, transparent 20px, #000 52px);
		mask-image: linear-gradient(to bottom, transparent 0, transparent 20px, #000 52px);
	}

	// Once the conversation is running the intro is gone and the whole log is messages, so the ramp
	// can be as long as it likes — 96px, most of the visible log. THIS is where a dramatic fade earns
	// its place: the top of the list genuinely dissolves, which is what says the exchange continues
	// above the cut. It swaps length at the moment the intro fades and the first bubble lands, which
	// is busy enough to hide the change.
	.assistant__log.is-running {
		-webkit-mask-image: linear-gradient(to bottom, transparent 0, transparent 20px, #000 96px);
		mask-image: linear-gradient(to bottom, transparent 0, transparent 20px, #000 96px);
	}

	.assistant__intro {
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 7px;
		// Pushed clear of the resting mask, which ends at 52.
		//
		// The ceiling here is tight and worth stating, because two earlier guesses broke it: the log's
		// content box is 164, the chip reserves 36 below, and the greeting block MEASURES 99 — a 24px
		// line, a 7px gap and a lead that wraps to five. Past 29 of padding the intro outgrows its own
		// box and gets pushed UP, above the log's top edge, which is worse than the fade it was trying
		// to escape. 36 only works because the lead is widened below to wrap in four lines instead.
		//
		// This padding, that max-width and the resting ramp are one measurement in three places.
		//
		// ASYMMETRIC ON PURPOSE, and the sum is what matters. The greeting sat 14px off the composer,
		// which read as cramped — the block wants air under it, not a tighter box. The content is
		// centred between these two, so moving 12px from the top padding to the bottom moves the whole
		// greeting up 12 and lets the chip follow it (see `.assistant__chip`), without changing how much
		// room the block has. The cost is the top: the greeting now starts at 49.5 against a ramp that
		// finishes at 52, so its first line carries a few per cent of the fade. That is the trade, and
		// it is the right way round — a hair of fade at the cut, a clear gap at the composer.
		padding-top: 24px;
		padding-bottom: 48px; // room for the chip pinned above the composer
		text-align: center;
		transition: opacity 0.3s ease;
	}

	.assistant__intro.is-out {
		opacity: 0;
	}

	.assistant__hello {
		margin: 0;
		font-size: 15px;
		font-weight: $font-weight-medium;
		color: var(--tb-ink);
	}

	.assistant__lead {
		// 330, not 300: it drops the lead from five lines to four, and that line is the 17px that lets
		// the greeting clear the mask. See the note on `.assistant__intro`'s padding.
		max-width: 330px;
		margin: 0;
		font-size: 12px;
		line-height: 17px;
		color: var(--tb-muted);
	}

	.assistant__chip {
		position: absolute;
		// Against the LOG's bottom edge, which is the composer's top edge — so this number is the gap
		// between the greeting block and the field. 14 matched the log's own padding and read as the
		// text resting on the input; 26 gives it somewhere to sit. It moves with the greeting above it,
		// which is why `.assistant__intro` shifts 12px of padding at the same time.
		bottom: 26px;
		left: 50%;
		padding: 5px 12px;
		transform: translateX(-50%);
		border: 1px solid rgba(0, 0, 0, 0.18);
		border-radius: $radius-full;
		font-size: 12px;
		white-space: nowrap;
		color: var(--tb-ink);
	}

	// ── Messages ──────────────────────────────────────────────────────
	// `:global` because these are appended by the script below, so the scoped class hash never
	// reaches them.
	.assistant__log :global(.assistant__msg) {
		max-width: 78%;
		margin: 0;
		font-size: 13px;
		line-height: 18px;
		animation: assistant-in 0.35s ease-out both;
	}

	.assistant__log :global(.assistant__msg--user) {
		align-self: flex-end;
		padding: 9px 12px;
		border-radius: 10px 10px 3px 10px;
		background: var(--tb-bubble);
		color: var(--tb-ink);
	}

	.assistant__log :global(.assistant__msg--bot) {
		align-self: flex-start;
		max-width: 92%;
		padding: 4px 3px;
		line-height: 18px;
		color: var(--tb-ink);
	}

	.assistant__log :global(.assistant__msg--bot b) {
		font-weight: $font-weight-medium;
		color: var(--tb-green);
	}

	.assistant__log :global(.assistant__thinking) {
		display: flex;
		align-items: center;
		gap: 7px;
		margin: 0;
		font-size: 13px;
		color: var(--tb-muted);
	}

	.assistant__log :global(.assistant__dots) {
		display: inline-flex;
		gap: 3px;
	}

	.assistant__log :global(.assistant__dots i) {
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: var(--tb-green);
		animation: assistant-dot 1.2s ease-in-out infinite;
	}

	.assistant__log :global(.assistant__dots i:nth-child(2)) {
		animation-delay: 0.15s;
	}

	.assistant__log :global(.assistant__dots i:nth-child(3)) {
		animation-delay: 0.3s;
	}

	@keyframes assistant-dot {
		0%,
		60%,
		100% {
			opacity: 0.25;
		}
		30% {
			opacity: 1;
		}
	}

	@keyframes assistant-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	// ── Composer ──────────────────────────────────────────────────────
	.assistant__input {
		display: flex;
		flex: none;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		min-height: 44px;
		margin: 0 14px 14px;
		padding: 6px 8px 6px 12px; // the round send button carries the height
		// 2px AT REST, not on focus. A border that thickens when focus lands moves everything inside it
		// by a pixel, and in a loop that replays every twelve seconds that jump is the thing you
		// notice. Carrying the weight all the time leaves focus only the colour to change.
		//
		// DIVIDED BY THE SCALE, so 2px means 2px ON THE PAGE. Everything authored in this component is
		// multiplied by `--ui-scale`, so a flat `2px` was landing at 2.4 — which is why it read fatter
		// than the 2 it was asked for. Hairlines are one of the few things that should be specified in
		// rendered pixels rather than the window's own, because the eye reads them against the page.
		border: calc(2px / var(--ui-scale)) solid rgba(0, 0, 0, 0.12);
		// 8, down from 12. At 12 against a 44px field the ends were most of the way to a pill, which
		// read as a chat bubble rather than as an input.
		border-radius: 8px;
		font-size: 13px;
	}

	.assistant__input.is-focused {
		border-color: var(--tb-green);
		// A wide, faint ring rather than the old tight 2px one: at 2px it sat directly on the border
		// and just read as a smudge thickening it. Spread out, it reads as focus. Also in rendered
		// pixels, for the same reason as the border — and because the two are read as one edge.
		box-shadow: 0 0 0 calc(4px / var(--ui-scale)) rgba(10, 86, 72, 0.07);
	}

	.assistant__typed {
		display: flex; // the pseudos become items, so the caret can lead
		flex: 1 1 auto;
		align-items: center;
		min-width: 0;
		color: var(--tb-ink);
		// ONE LINE, ALWAYS. This is a single-line composer and it has to behave like one: wrapped, the
		// second line pushed the caret down and out of the field's centre, which is what made the
		// cursor look broken. `nowrap` plus a hidden overflow makes the text slide left as it is typed,
		// which is exactly what a real `<input>` does — the script keeps it scrolled to the tail so the
		// caret stays in frame. The prompts are written short enough that it rarely has to.
		white-space: nowrap;
		overflow: hidden;

		&::after {
			content: '';
			display: inline-block;
			width: 1px;
			// A REAL CARET IS TALLER THAN ITS TEXT. Browsers draw one over the font's whole
			// ascent-to-descent, not over its em — at 13px that is about 16. This was 13, exactly the
			// type size, which is what made it read as a small drawn rectangle sitting next to the words
			// rather than as a cursor sitting in them. In `em` so it tracks the field's type instead of
			// having to be re-measured if that ever moves.
			height: 1.25em;
			margin-left: 1px;
			background: var(--tb-green);
			animation: assistant-caret 1.1s steps(1) infinite;
		}
	}

	.assistant__typed:empty::before {
		content: var(--placeholder);
		color: #9aa5a1;
	}

	// `animation: none` as well as the opacity, and this is the whole cursor bug: an animation's
	// keyframes beat a normal declaration, so `opacity: 0` on its own did NOTHING — the caret went on
	// blinking in front of the placeholder from the moment the loop started, before anything had been
	// clicked. Killing the animation is what lets the opacity apply.
	.assistant__typed.is-idle::after {
		animation: none;
		opacity: 0;
	}

	// Solid while the prompt is being typed. A real caret does not blink mid-keystroke — it only
	// blinks once the typing stops — and the blink was reading as a flicker under the moving text.
	.assistant__typed.is-typing::after {
		animation: none;
		opacity: 1;
	}

	// With nothing typed the caret sits at the head of the hint, not after it.
	.assistant__typed:empty::after {
		order: -1;
		margin-right: 3px;
		margin-left: 0;
	}

	@keyframes assistant-caret {
		0%,
		50% {
			opacity: 1;
		}
		50.01%,
		100% {
			opacity: 0;
		}
	}

	// Send behaves like the product's icon button: a soft round hover, a shade darker while pressed.
	.assistant__send {
		display: inline-flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: 30px;
		height: 30px;
		border-radius: 50%;
		transition:
			background-color 0.15s ease,
			transform 0.15s ease;
	}

	.assistant__send :global(svg) {
		width: 22px;
		height: 22px;
		color: var(--tb-green);
	}

	.assistant__send.is-hover {
		background: #f4f7f6;
	}

	.assistant__send.is-press {
		background: #e2eae7;
		transform: scale(0.94);
	}

	// Greys out only while the assistant is working on the answer.
	.assistant__send.is-busy :global(svg) {
		color: #b5c0bc;
	}

	@media (prefers-reduced-motion: reduce) {
		.assistant__typed::after,
		.assistant__log :global(.assistant__msg),
		.assistant__log :global(.assistant__dots i) {
			animation: none;
		}

		.assistant__log :global(.assistant__dots i) {
			opacity: 0.6;
		}
	}
</style>

<script>
	import { AI_ASSISTANT_DEMO } from '@data/ai-visual';

	/**
	 * The exchange, played on a loop, KEYBOARD-ONLY: the composer is already focused, the prompt is
	 * typed into it, and Enter commits — Send takes a brief pressed state at that moment because Enter
	 * fires the same action, which is the only honest way to show a commit without drawing a hand.
	 *
	 * There is no fake cursor. See the note at the top of this file for why it went.
	 *
	 * The prompt and the reply are IMPORTED, not restated — the same strings the empty state and the
	 * component's aria-label were rendered from, so the demo cannot end up typing one sentence while
	 * the label promises another.
	 *
	 * Per instance, so several of these can share a page, and held to the viewport: a cycle only
	 * begins while the window is actually on screen.
	 */
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll<HTMLElement>('[data-assistant-plate]').forEach((frame) => {
		if (frame.dataset.animate !== 'on') return;

		const log = frame.querySelector<HTMLElement>('[data-assistant-log]');
		const typed = frame.querySelector<HTMLElement>('[data-assistant-typed]');
		const field = frame.querySelector<HTMLElement>('[data-assistant-field]');
		const sendBtn = frame.querySelector<HTMLElement>('[data-assistant-send]');
		if (!log || !typed || !field || !sendBtn) return;

		// Reduced motion keeps the empty state exactly as the server rendered it — unfocused, no caret.
		if (reduce) return;

		const introHTML = log.innerHTML;
		const { exchanges } = AI_ASSISTANT_DEMO;

		let timers: number[] = [];
		let run = 0;
		let onScreen = false;
		let waiting = false;

		/** Schedules `fn`, tagged with the cycle that booked it, so a restart cancels the old run. */
		const at = (ms: number, fn: () => void) => {
			const id = run;
			timers.push(
				window.setTimeout(() => {
					if (id === run) fn();
				}, ms)
			);
		};

		const el = (cls: string, html: string) => {
			const node = document.createElement('p');
			node.className = cls;
			node.innerHTML = html;
			log!.appendChild(node);
			return node;
		};

		/**
		 * One prompt, from empty composer to answer, then hands on to the next exchange.
		 *
		 * The intro card is only cleared by the FIRST one — after that the conversation is already
		 * running and the follow-up simply joins it, which is the whole reason there are two.
		 */
		function exchange(n: number) {
			const { prompt, reply } = exchanges[n];
			const intro = log!.querySelector<HTMLElement>('[data-assistant-intro]');
			let i = 0;

			const type = () => {
				if (document.hidden) {
					at(400, type);
					return;
				}
				typed!.classList.add('is-typing');
				typed!.textContent = prompt.slice(0, ++i);
				// Follow the tail, as a single-line input does once the text outruns the field.
				typed!.scrollLeft = typed!.scrollWidth;
				if (i < prompt.length) {
					at(38 + Math.random() * 38, type);
					return;
				}
				// Typing is over: the caret goes back to blinking for the beat before Enter.
				typed!.classList.remove('is-typing');
				at(420, commit);
			};

			const done = () => {
				if (n + 1 < exchanges.length) at(1500, () => exchange(n + 1));
				else at(4200, cycle);
			};

			const think = () => {
				sendBtn!.classList.add('is-busy');
				const row = el('assistant__thinking', '<span class="assistant__dots"><i></i><i></i><i></i></span>Thinking…');
				at(1700, () => {
					row.remove();
					sendBtn!.classList.remove('is-busy');
					el('assistant__msg assistant__msg--bot', reply);
					done();
				});
			};

			const send = () => {
				typed!.textContent = '';
				typed!.scrollLeft = 0;
				if (intro) {
					intro.classList.add('is-out');
					at(300, () => intro.remove());
				}
				// The log is a conversation from here, so it takes the long fade.
				log!.classList.add('is-running');
				at(180, () => {
					el('assistant__msg assistant__msg--user', prompt);
					at(520, think);
				});
			};

			/** Enter. Send lights up because the key fires the button's own action. */
			function commit() {
				sendBtn!.classList.add('is-press');
				at(200, () => sendBtn!.classList.remove('is-press'));
				send();
			}

			at(n === 0 ? 900 : 300, type);
		}

		function cycle() {
			// Off screen or in a background tab: park the loop and look again shortly. Checked at the
			// cycle boundary rather than mid-exchange, so nothing is ever left half-played.
			if (!onScreen || document.hidden) {
				if (waiting) return;
				waiting = true;
				window.setTimeout(() => {
					waiting = false;
					cycle();
				}, 600);
				return;
			}

			run++;
			timers.forEach(clearTimeout);
			timers = [];

			log!.innerHTML = introHTML;
			log!.classList.remove('is-running');
			typed!.textContent = '';
			typed!.scrollLeft = 0;
			typed!.classList.remove('is-typing');
			// The composer starts FOCUSED and empty, which is what a chat waiting for you looks like:
			// a lit border and a caret blinking at the head of the hint.
			typed!.classList.remove('is-idle');
			field!.classList.add('is-focused');
			sendBtn!.classList.remove('is-press', 'is-busy');

			exchange(0);
		}

		new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					onScreen = entry.isIntersecting;
				});
			},
			{ threshold: 0.2 }
		).observe(frame);

		cycle();
	});
</script>
