---
// A framed product video for a two-wide card's visual column.
//
// Loading is deferred to the observer EcosystemCard already ships: it watches
// `video.ecosystem-lazy-video` across the page and swaps `data-src` in on
// approach, so nothing here is fetched until the card is near the viewport, and
// there is only ever one observer regardless of how many cards carry video.

interface Props {
	webm: string;
	mp4: string;
	/** Described for screen readers, since the video itself carries no text. */
	label: string;
	/** Frame's aspect, as width/height. */
	ratio?: string;
}

const { webm, mp4, label, ratio = '16 / 9' } = Astro.props;
---

<figure class="cardvid" style={`--cardvid-ratio: ${ratio}`} aria-label={label}>
	<video class="cardvid__video ecosystem-lazy-video" loop muted playsinline preload="none">
		<source data-src={webm} type="video/webm" />
		<source data-src={mp4} type="video/mp4" />
	</video>
</figure>

<style lang="scss">
	@use '../../styles/variables' as *;

	.cardvid {
		margin: 0;
		overflow: hidden;
		border-radius: $radius-md;
		// No stroke and no dark ground: the footage is light-on-white, so either
		// one drew a hard edge around it. The shadow alone lifts the frame.
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.14);
	}

	.cardvid__video {
		display: block;
		width: 100%;
		aspect-ratio: var(--cardvid-ratio);
		object-fit: cover;
	}
</style>
