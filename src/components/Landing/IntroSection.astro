---
interface Props {
	/**
	 * Override title content
	 */
	title?: string;
	/**
	 * Override description content
	 */
	description?: string;
	/**
	 * A link to open the title with, before `title`. Off by default: this used to default to
	 * "ThingsBoard" → the PE docs, which made the statement's first two words a link out of the page
	 * at the point the page is trying to say what it is. It also forced every caller's `title` to
	 * begin mid-sentence, so the string read as a fragment wherever it was edited.
	 */
	titleLink?: { text: string; href: string } | null;
}

const { title, description, titleLink = null } = Astro.props;
---

<section id="intro" class="intro-section">
	<div class="main-div">
		<h2 class="intro-section__title">
			{
				titleLink && (
					<a class="heading-1" href={titleLink.href}>
						{titleLink.text}
					</a>
				)
			}
			{
				title ||
					'ThingsBoard is an all-in-one IoT platform for data collection, processing, visualization, and device management'
			}
		</h2>
		<p class="intro-section__text">
			{
				description ||
					'It enables device connectivity via industry standard IoT protocols — MQTT, CoAP and HTTP and supports both cloud and on-premises deployments. ThingsBoard combines scalability, fault-tolerance and performance so you will never lose your data.'
			}
		</p>
		<slot />
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	.intro-section {
		margin-bottom: 178px;
		padding-top: $spacing-20;

		@include media-down(md) {
			margin-bottom: 70px;
			padding-top: $spacing-12;
		}

		&__title {
			@include section-title;
			text-align: center;
			margin-bottom: $spacing-12;
			color: var(--color-text);

			@include media-down(md) {
				margin-bottom: $spacing-8;
			}
		}

		&__text {
			@include text-m;
			text-align: center;
			margin: $spacing-1 0 $spacing-4;
			margin-left: auto;
			margin-right: auto;
		}
	}
</style>
