---
import { defaultCustomersLogos, type CustomerLogo } from '../../data/customersLogo';

interface Props {
	/**
	 * Product tag for styling: 'ce' | 'pe' | 'paas' | 'edge' | etc.
	 */
	productTag?: string;
	/**
	 * Custom logos array. If not provided, uses default logos.
	 */
	logos?: CustomerLogo[];
	/**
	 * Renders the row as a full-width dark strip. Used directly under the
	 * homepage hero, where it closes the hero rather than opening the content.
	 */
	onDark?: boolean;
}

const { productTag = 'ce', logos = defaultCustomersLogos, onDark = false } = Astro.props;

const filterMap: Record<string, string> = {
	ce: 'invert(86%) sepia(5%) saturate(530%) hue-rotate(171deg) brightness(237%) contrast(86%)',
	pe: 'invert(79%) sepia(25%) saturate(246%) hue-rotate(93deg) brightness(185%) contrast(82%)',
	paas: 'invert(87%) sepia(3%) saturate(664%) hue-rotate(176deg) brightness(237%) contrast(82%)',
	edge: 'invert(79%) sepia(25%) saturate(246%) hue-rotate(130deg) brightness(185%) contrast(82%)',
};
// On the dark strip the per-product tints land on light grey, not white.
// `brightness(0)` flattens each mark to black, `invert(1)` takes it to pure white.
const imgFilter = onDark ? 'brightness(0) invert(1)' : (filterMap[productTag] ?? '');

const LOCAL_PREFIX = '/src/assets/images/';
const svgUrls = import.meta.glob<string>('/src/assets/images/**/*.svg', {
	query: '?url',
	import: 'default',
});

const resolvedLogos = await Promise.all(
	logos.map(async (logo) => {
		if (logo.src.startsWith(LOCAL_PREFIX)) {
			const loader = svgUrls[logo.src];
			return { ...logo, src: loader ? await loader() : logo.src };
		}
		return logo;
	})
);
---

<section id="tb-customers" class:list={['customers-logo', onDark && 'customers-logo--dark']}>
	<div class="customers-logo__content">
		{
			resolvedLogos.map((logo) => (
				<a href={logo.href} class="customers-logo__item">
					<img
						src={logo.src}
						alt={logo.ariaLabel}
						width={logo.width}
						height={logo.height}
						style={imgFilter ? `filter:${imgFilter}` : undefined}
					/>
				</a>
			))
		}
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	.customers-logo {
		max-width: 1800px;
		margin: 0 auto;
		padding: $spacing-12 0;
		text-align: justify;
		text-align-last: justify;

		img {
			// Every logo scales with the viewport rather than sitting at a fixed
			// height, so the row shrinks as one instead of wrapping the last logo
			// onto a line of its own. Sizing by height keeps each mark's own
			// proportions — equal-width flex slots would render the wide logos
			// smaller than the narrow ones.
			height: clamp(20px, 2.2vw, 36px);
			width: auto;
		}

		&__content {
			display: flex;
			flex-direction: row;
			flex-wrap: nowrap;
			justify-content: space-around;
			gap: clamp(12px, 2.2vw, 48px);
			width: 100%;
			align-items: center;
			padding: 0 clamp(16px, 4vw, 60px);
		}

		&__item {
			display: block;
			flex: 0 0 auto;
		}

		// Full-bleed dark band; the row itself stays capped and centred so the
		// logos keep line with the rest of the page.
		&--dark {
			position: relative;
			max-width: none;
			background-color: #000;

			// Marks stay plain white — `brightness(0) invert(1)` above flattens each
			// one — so the only variable is how far it sits back from the strip.
			// Opacity alone carries that, which keeps every mark the same hue at
			// rest and on hover.
			.customers-logo__item {
				// Hover lifts the mark out of its transparency rather than changing
				// its colour, so the row reads as one material at two strengths.
				img {
					transition: opacity 0.18s ease;
				}

				&:hover img,
				&:focus-visible img {
					opacity: 1;
				}
			}

			.customers-logo__content {
				// Centred on the ribbon rather than run out to the hero's own
				// margins. At full bleed the row spanned as wide as the hero itself
				// and read as a second band competing with it; capped and centred it
				// sits as one contained group. space-between still spreads the marks
				// evenly, now within the cap rather than across the viewport.
				max-width: 1100px;
				margin: 0 auto;
				padding-inline: clamp(24px, calc(0.5rem + 2vw), 56px);
				justify-content: space-between;
			}

			img {
				// Smaller than the light rows: this one sits directly under the hero,
				// so the marks stay supporting rather than structural. Capping the row
				// alone wouldn't have held them — the height is what scales with the
				// viewport, so the vw factor and ceiling come down too. Height drives
				// it (width: auto above), which keeps every aspect ratio intact.
				height: clamp(18px, 1.6vw, 28px);
				opacity: 0.5;
			}

			// Stack rather than scroll. The shared rule below turns this row into an
			// x-scroller under lg, which put four of the seven marks behind a swipe
			// most people never make and clipped the row mid-logo at the viewport
			// edge — it read as broken rather than scrollable. Wrapping shows all
			// seven at once; the marks get smaller instead of hidden.
			@include media-down(lg) {
				.customers-logo__content {
					overflow-x: visible;
					flex-wrap: wrap;
					// space-between strands the last row's marks against the edges once
					// the count stops dividing evenly.
					justify-content: center;
					// Column gap stays wider than the row gap so each line still reads
					// as one band rather than a grid.
					gap: 14px 24px;
					padding-inline: 20px;
				}

				// Qualified through __item on purpose: the shared `img { height: 28px }`
				// below is `.customers-logo img`, which ties this on specificity and
				// would win on source order. The extra class settles it without
				// touching the light rows on other pages.
				.customers-logo__item img {
					// As small as these wordmarks stay legible — TEKTELIC's subtitle
					// line is what sets the floor for the whole set.
					height: 18px;
				}
			}
		}

		// Narrow viewports can't hold seven marks at a legible size, so the row
		// scrolls rather than shrinking them into mush.
		@include media-down(lg) {
			&__content {
				overflow-x: auto;
				justify-content: flex-start;
				scroll-snap-type: x proximity;
			}

			&__item {
				scroll-snap-align: center;
			}

			img {
				height: 28px;
			}
		}
	}
</style>
