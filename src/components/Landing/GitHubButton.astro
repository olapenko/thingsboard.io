---
import { Products } from '@models/site.models';
import { GITHUB_STARS } from '@data/github-stars';

interface Props {
	platform?: Products;
}

const { platform = Products.CE } = Astro.props;

const repoMap: Partial<Record<Products, string>> = {
	[Products.CE]: 'thingsboard/thingsboard',
	[Products.GW]: 'thingsboard/thingsboard-gateway',
	[Products.EDGE]: 'thingsboard/thingsboard-edge',
	[Products.EDGE_PE]: 'thingsboard/thingsboard-edge',
	[Products.TBMQ]: 'thingsboard/tbmq',
	[Products.TBMQ_PE]: 'thingsboard/tbmq',
};

const repo = repoMap[platform] ?? 'thingsboard/thingsboard';
const link = `https://github.com/${repo}`;

// A count from the first paint. The live one is fetched only after interaction or 5.5s (the script
// below), and until then the button was a 96px box holding the mark and nothing — a control that
// read as broken for the first seconds of every visit, and for good wherever the API is out of reach.
// Rounded down to the hundred and written short, so it never claims a precision it does not have;
// the fetch swaps in the exact number. The counts and their date live in `@data/github-stars`.
const known = GITHUB_STARS[repo];
const shortStars = (n: number) => (n < 1000 ? String(n) : `${Math.floor(n / 100) / 10}k`);
const fallback = known === undefined ? undefined : shortStars(known);
---

<div class="gh-wrap">
	<a
		href={link}
		class:list={['gh-button', fallback && 'is-loaded']}
		target="_blank"
		rel="noopener noreferrer"
		aria-label={fallback ? `Star ${repo} on GitHub — ${fallback} stars` : `Star ${repo} on GitHub`}
		data-repo={repo}
	>
		{/* Octicon `mark-github` (GitHub Octicons, MIT). */}
		<svg class="gh-mark" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
			<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
		</svg>
		<span class="gh-count">{fallback ?? '\u00a0'}</span>
	</a>
</div>

<script>
	// Defer via `__deferOnInteraction` (GTM's system); 5.5s fallback > GTM's 5s
	// keeps GTM first. Full tier schedule: DeferredLoadTrigger.astro.
	const DEFER_MS = 5500;

	type DeferFn = (cb: () => void, fallbackMs?: number) => void;

	const fetchStars = async (repo: string): Promise<string | null> => {
		try {
			const res = await fetch(`https://api.github.com/repos/${repo}`, {
				headers: { Accept: 'application/vnd.github.v3+json' },
			});
			if (!res.ok) return null;
			const { stargazers_count: count } = await res.json();
			return count.toLocaleString('en-US');
		} catch {
			return null;
		}
	};

	const init = () => {
		const defer = (window as { __deferOnInteraction?: DeferFn }).__deferOnInteraction;
		document.querySelectorAll<HTMLAnchorElement>('a.gh-button[data-repo]').forEach((btn) => {
			const repo = btn.dataset.repo!;
			const counterEl = btn.querySelector<HTMLElement>('.gh-count')!;

			const show = (text: string) => {
				counterEl.textContent = text;
				// The count is dropped in the tight band, so the icon-only button still announces it.
				btn.setAttribute('aria-label', `Star ${repo} on GitHub — ${text} stars`);
				btn.classList.add('is-loaded');
			};

			const cached = sessionStorage.getItem(`gh_stars_${repo}`);
			if (cached) {
				show(cached);
				return;
			}

			const runFetch = async () => {
				const value = await fetchStars(repo);
				if (value) {
					sessionStorage.setItem(`gh_stars_${repo}`, value);
					show(value);
				}
			};

			if (defer) defer(runFetch, DEFER_MS);
			else setTimeout(runFetch, DEFER_MS);
		});
	};

	if (document.readyState === 'complete') {
		init();
	} else {
		window.addEventListener('load', init, { once: true });
	}
</script>

{/* Global, as the kit's own styles are (`ui/README`): scoped, Astro would pin its scope attribute on the
    `[data-surface='dark']` ancestor the mixin's dark look answers to, which is `HeaderContent`'s, and the
    button would stay in the light look over a dark hero. Every class here is `gh-` prefixed. */}
<style lang="scss" is:global>
	@use '../../styles/variables' as *;
	@use '../../styles/button' as *;

	// `full` fits the mark, its gap, the padding and a five-digit count; below `cutoff` only the
	// mark shows.
	$gh-full: 96px;
	$gh-icon: 40px;
	$gh-cutoff: 84px;

	// A fixed width, so the button never squeezes the nav or the CTA.
	.gh-wrap {
		display: none;
		container-type: inline-size;
		flex: none;
		width: $gh-full;
	}

	// In the bar from a tablet's width (`$menu-split-from`): beside Menu below the row, with its count,
	// where the bar holds the search box, Sign in, Try for free and Menu with room to spare (at 720,
	// with the 168 wordmark, 53px). On a phone the bar has room for none of it, and it goes. Adopted
	// from the lab's menu-by-the-room (2026-10-07) over a 640 mark / 700 count pair measured here.
	@media (width >= #{$menu-split-from}) {
		.gh-wrap {
			display: block;
		}
	}

	// Where the count gives way. The row packs beside the wordmark and the count costs 56 of the
	// slack between the row and the cluster. Measured on the dev server with the 160 wordmark, the
	// search control, Sign in and Try for free beside it: the gap clears 40px with the count from
	// 1340, so the band below it is the mark alone, down to where the row leaves for Menu and the
	// count has its room again.
	@media (width >= #{$menu-row-from}) and (width < 1340px) {
		.gh-wrap {
			width: $gh-icon;
		}
	}

	// The kit's secondary at the bar's 40, regular (2026-10-07): the quiet family Sign in and Menu
	// belong to, drawn by the mixin because the count and its container query are markup `ui/Button`
	// cannot render. Its own 12px padding, so the full pill holds a five-digit count in 96. Over a
	// dark hero the kit's dark look comes with `data-surface` on the cluster (`HeaderScrollWatch`).
	.gh-button {
		@include ui-button(secondary, sm);

		--btn-px: 12px;

		width: 100%;
		font-weight: $font-weight-normal;
		overflow: hidden;
	}

	.gh-mark {
		flex: 0 0 16px;
		fill: currentColor;
	}

	// Width reserved from the first paint, so the mark does not jump when the count arrives; hidden
	// until there is one, which for a known repo is at once.
	.gh-count {
		min-width: $gh-full - 16px - 8px - 24px;
		opacity: 0;
		font-variant-numeric: tabular-nums;
		transition: opacity $transition-fast;
	}

	.gh-button.is-loaded .gh-count {
		opacity: 1;
	}

	@container (max-width: #{$gh-cutoff}) {
		.gh-count {
			display: none;
		}

		.gh-button {
			gap: 0;
			padding: 0;
		}
	}
</style>
