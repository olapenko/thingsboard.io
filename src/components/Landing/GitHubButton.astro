---
import { Products } from '@models/site.models';

interface Props {
	platform?: Products;
}

const { platform = Products.CE } = Astro.props;

const repoMap: Partial<Record<Products, string>> = {
	[Products.CE]: 'thingsboard/thingsboard',
	[Products.GW]: 'thingsboard/thingsboard-gateway',
	[Products.EDGE]: 'thingsboard/thingsboard-edge',
	[Products.EDGE_PE]: 'thingsboard/thingsboard-edge',
	[Products.TBMQ]: 'thingsboard/tbmq',
	[Products.TBMQ_PE]: 'thingsboard/tbmq',
};

const repo = repoMap[platform] ?? 'thingsboard/thingsboard';
const link = `https://github.com/${repo}`;

// A count to show from the first paint. The live one is fetched only after interaction or 5.5s
// (see the script), and until then the button was a 96px box holding nothing but the mark — a
// control that looked broken for the first seconds of every visit, and for good wherever the API
// is out of reach (rate limits, blockers, a static copy). Rounded down to the hundred and written
// short, so it never claims a precision it does not have; the fetch swaps in the exact number.
// Counts as of 2026-09-25 — refresh when one crosses the next hundred, or leave them: they only
// ever read low.
const starsAsOf: Record<string, number> = {
	'thingsboard/thingsboard': 22480,
	'thingsboard/thingsboard-gateway': 2190,
	'thingsboard/thingsboard-edge': 180,
	'thingsboard/tbmq': 766,
};
const known = starsAsOf[repo];
const shortStars = (n: number) => (n < 1000 ? String(n) : `${Math.floor(n / 100) / 10}k`);
const fallback = known === undefined ? undefined : shortStars(known);
---

<div class="gh-wrap">
	<a
		href={link}
		class:list={['gh-button', fallback && 'is-loaded']}
		target="_blank"
		rel="noopener noreferrer"
		aria-label={fallback ? `Star ${repo} on GitHub — ${fallback} stars` : `Star ${repo} on GitHub`}
		data-repo={repo}
	>
		{/* Octicon `mark-github` (GitHub Octicons, MIT). Fills with currentColor so the
		    mark follows the bar through transparent / scrolled / dark exactly as the
		    border does — no second colour to keep in sync. */}
		<svg class="gh-mark" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
			<path
				d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
			></path>
		</svg>
		<span class="gh-count">{fallback ?? '\u00a0'}</span>
	</a>
</div>

<script>
	// Defer via `__deferOnInteraction` (GTM's system); 5.5s fallback > GTM's 5s
	// keeps GTM first. Full tier schedule: DeferredLoadTrigger.astro.
	const DEFER_MS = 5500;

	type DeferFn = (cb: () => void, fallbackMs?: number) => void;

	const fetchStars = async (repo: string): Promise<string | null> => {
		try {
			const res = await fetch(`https://api.github.com/repos/${repo}`, {
				headers: { Accept: 'application/vnd.github.v3+json' },
			});
			if (!res.ok) return null;
			const { stargazers_count: count } = await res.json();
			return count.toLocaleString('en-US');
		} catch {
			return null;
		}
	};

	const init = () => {
		const defer = (window as { __deferOnInteraction?: DeferFn }).__deferOnInteraction;
		document.querySelectorAll<HTMLAnchorElement>('a.gh-button[data-repo]').forEach((btn) => {
			const repo = btn.dataset.repo!;
			const counterEl = btn.querySelector<HTMLElement>('.gh-count')!;

			const show = (text: string) => {
				counterEl.textContent = text;
				// The count can be dropped visually by the container query below, so the
				// number goes on the label too — the icon-only button still announces it.
				btn.setAttribute('aria-label', `Star ${repo} on GitHub — ${text} stars`);
				btn.classList.add('is-loaded');
			};

			const cached = sessionStorage.getItem(`gh_stars_${repo}`);
			if (cached) {
				show(cached);
				return;
			}

			const runFetch = async () => {
				const value = await fetchStars(repo);
				if (value) {
					sessionStorage.setItem(`gh_stars_${repo}`, value);
					show(value);
				}
			};

			if (defer) defer(runFetch, DEFER_MS);
			else setTimeout(runFetch, DEFER_MS);
		});
	};

	if (document.readyState === 'complete') {
		init();
	} else {
		window.addEventListener('load', init, { once: true });
	}
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	// Component-local sizing. Kept here rather than in _variables.scss: nothing else
	// in the site has an opinion about how wide a star counter is.
	//
	//   full   — icon (16) + gap (8) + padding (24) + the count. At the bar's regular
	//            15/400, "18,432" measures 46px, so the cell needs 94 and reserves 96.
	//            A SIXTH digit measures 55 and needs 104: the button clips rather than
	//            grows, so this has to go to 104 before the repo passes 100k stars —
	//            and the widths in the media query below re-measured with it.
	//   icon   — the square cell, matching the 40px height of the row's other controls
	//   cutoff — between the two, so the count drops the moment the cell is nearer
	//            the square than the full pill, whatever drove it there
	$gh-wrap-full: 96px;
	$gh-wrap-icon: 40px;
	$gh-count-cutoff: 84px;

	// The nav and the CTA outrank the star count: this widget is the one item in the
	// bar that gives up space. It gives it up by being SIZED down at the band where
	// the bar is tight, not by flex-shrinking:
	//
	//   `flex: none` + `width`     — the cell is exactly as wide as we say, so the
	//                                CTA beside it can never be squeezed to pay for
	//                                it. (.head-buttons[data-home-nav] holds the
	//                                whole cluster at content width for the same
	//                                reason — see HeaderContent.astro.)
	//   the @container query below — whenever the cell is nearer the square than
	//                                the full pill, the count is DROPPED rather
	//                                than clipped, whatever set that width.
	//
	// `container-type` is why the width has to be explicit: size containment zeroes
	// this box's intrinsic contribution to the cluster's content width, so a
	// content-derived `flex-basis` measured 65px instead of 96px and the count
	// vanished at widths that had 300px of slack. The query is worth that: it makes
	// "an icon when space doesn't allow" true at any width a page hands us, not
	// only at the breakpoints named here.
	.gh-wrap {
		display: none;
		container-type: inline-size;
		flex: none;
		width: $gh-wrap-full;
	}

	@media screen and (min-width: 1120px) {
		.gh-wrap {
			display: block;
		}
	}

	// Where the count gives way. The header is logo 177 + nav 663 + cluster 321 with
	// the count shown, inside the header's 2x20 padding, so the gap left on each
	// side of the centred nav is
	//
	//     gap = (viewport - 1201) / 2
	//
	// 1300 is where that lands at ~50px, which is as close as the cluster can come
	// before it reads as crowding the nav. Raising this number buys the nav room it
	// does not need and costs the count at widths that had space for it. Re-measure
	// the three widths above if the nav gains or loses an item — dropping the group
	// separator alone moved the nav 18px and this number with it. Below the band it
	// is the icon alone, down to 1281 where the nav leaves for the drawer and the
	// question stops arising.
	@media screen and (min-width: 1281px) and (max-width: 1299px) {
		.gh-wrap {
			width: $gh-wrap-icon;
		}
	}

	.gh-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		width: 100%;
		height: 40px;
		padding: 0 12px;
		box-sizing: border-box;
		border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
		border-radius: $radius-sm;
		// Inherit the bar's ink and type rather than naming a colour: the header goes
		// white over the hero, dark once scrolled, and light again in the drawer, and
		// `currentColor` follows all three. This is the same contract `.region-signin
		// summary` keeps, which is why the two now read as one set of controls.
		color: inherit;
		font-family: $font-family-base;
		// The bar's regular type: 15/400, the same as "Sign in" beside it and the nav
		// links. Not the CTA's 14/700 — that weight is what marks "Try for free" as the
		// one thing to press, and a star count borrowing it competes for that.
		font-size: 15px;
		font-weight: $font-weight-normal;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
		overflow: hidden;
		transition:
			background-color $transition-fast,
			border-color $transition-fast;
	}

	.gh-button:hover,
	.gh-button:focus-visible {
		background-color: color-mix(in srgb, currentColor 12%, transparent);
		border-color: color-mix(in srgb, currentColor 55%, transparent);
		color: inherit;
	}

	.gh-mark {
		flex: 0 0 16px;
		fill: currentColor;
	}

	.gh-count {
		// Hidden until there is a count, so the placeholder `&nbsp;` never paints as a blank
		// gap; the width is reserved all along, so nothing shifts when one lands. A known
		// repo ships `is-loaded` with its rounded count, so this only holds for an unknown one.
		opacity: 0;
		font-variant-numeric: tabular-nums;
		transition: opacity $transition-fast;
	}

	.gh-button.is-loaded .gh-count {
		opacity: 1;
	}

	// Below this the cell is the icon alone. `display: none` rather than a width
	// transition: at this size there is nothing to animate, and leaving the node in
	// flow would keep the flex gap.
	@container (max-width: #{$gh-count-cutoff}) {
		.gh-count {
			display: none;
		}

		.gh-button {
			padding: 0;
			gap: 0;
		}
	}
</style>
