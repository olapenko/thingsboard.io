---
import { Icon } from 'astro-icon/components';
import { SCALE_MODES, type ScaleMode } from '@data/scale-visual';

/**
 * A seventh cut: two deployment modes, one colour, and no third element of any kind.
 *
 * Every earlier cut carried hybrid storage as furniture — a third card, then a step between two,
 * then a band joining them. It is none of those: it is a choice of database, and it belongs in the
 * list of databases. Dropping it takes the last of the category error out of the drawing, and takes
 * a whole block of chrome with it.
 *
 * THE FIELD IS DELIBERATELY DUMBER than ScaleGrid's: one colour rather than three, and no roles.
 * The role colours were carrying an argument about kinds of machine that the chips underneath make
 * better; what is left is the only thing the field was ever good at — one, against many.
 *
 * The million sits on the SINGLE-SERVER card, which is what benchmark E measured: 1M devices,
 * 33.3K data points/sec, one instance in monolithic mode, 55% CPU. That is also what lets the
 * section's original copy stand beside this visual without contradicting it.
 */

interface Props {
	modes?: ScaleMode[];
	/**
	 * Ripple the lit cells outward from the entry node, as data arriving and being taken up.
	 *
	 * INGEST, not failover. A cluster losing a node and recovering is the only thing these drawings
	 * could animate that the static frame cannot say — and it is the wrong thing to loop: replayed
	 * every few seconds a recovery reads as "this keeps falling over", and it argues against the card
	 * beside it, which has no redundancy and is carrying the stronger claim. Arrival is what both
	 * modes do all day, it is symmetric, and it makes the bridges earn their place by showing work
	 * crossing them.
	 *
	 * The monolith pulses once with nowhere to propagate; the cluster passes the same pulse along its
	 * connections. The asymmetry IS the difference between the two cards, rather than a gap in one.
	 */
	animate?: boolean;
	/**
	 * Which surface carries the colour.
	 *
	 *   card   the hue washes the card at 6% and the field's empty cells are white.
	 *   field  the inverse: the card is white and the empty cells carry the wash.
	 *
	 * The same two colours and the same strength either way — what moves is which surface is doing
	 * the saying. On `field` the drawing is the only tinted thing on the card, so the eye lands on
	 * it rather than on a tinted panel with a drawing in it; the card becomes a plain white surface
	 * holding one coloured object, which is what the row's other visuals are.
	 */
	hue?: 'card' | 'field';
}

const { modes = SCALE_MODES, animate = false, hue = 'card' } = Astro.props;

/**
 * Chip label to mark. Citus and Valkey are LOCAL files under `src/icons/`, because Simple Icons
 * publishes neither — they were supplied as brand SVGs and redrawn in `currentColor`, so every mark
 * in the row is the project's own rather than a stand-in.
 */
const LOGOS: Record<string, string> = {
	PostgreSQL: 'simple-icons:postgresql',
	Citus: 'citus',
	Cassandra: 'simple-icons:apachecassandra',
	Kafka: 'simple-icons:apachekafka',
	Valkey: 'valkey',
};

// How far each card's surface reaches PAST its column, horizontally — the `inset` on
// `.sd__card::before`. It used to be invisible: a 6% wash bleeding over the gutter is not
// something anyone sees. A WHITE card on a hued band is, and on a phone it ran off the screen —
// the container sits in the row's 4px gutter like every other visual, but the surface overhung it
// and was cut by the viewport edge. Naming it here lets the drawing's real extent include it.
//
// Not to be confused with `BLEED` further down, which is how far a bridge bar tucks under a cell.
const CARD_BLEED = 14;

const COL_W = 220;
// 40 read as two cards that happened to be near each other; 34 reads as a pair, which is what the
// visual argues — one mode against the other, not two independent panels.
//
// THE FLOOR IS 28, and it is not a matter of taste. Each card's surface overhangs its column by
// CARD_BLEED a side, so the ground actually showing between the two white boxes is this number less
// twice that: 12 units at 40, 6 at 34, and exactly none at 28, where the two surfaces meet and the
// pair renders as one continuous white slab with two headings on it. That was measured, not
// guessed — at 28 the right edge of one and the left edge of the next both landed on 937.5px. Any
// value at or under 28 destroys the thing the visual is for.
const COL_GAP = 34;
const NATIVE = modes.length * COL_W + (modes.length - 1) * COL_GAP;
/**
 * What the drawing actually occupies, which is the columns PLUS the surface that overhangs them.
 *
 * The unit is derived from this rather than from `NATIVE`, so a container narrow enough to drive
 * the unit sizes the whole visible object to fit rather than sizing the columns and letting the
 * cards hang over the edge. Above the cap nothing changes — a 525px row divided by either number
 * is over 1, so the desktop composition is untouched to the pixel.
 */
const EXTENT = NATIVE + 2 * CARD_BLEED;

/**
 * The field, derived from the column so the cells tile it exactly.
 *
 * COLS is the only free variable: the cells are sized to fill the column whatever the count is, so
 * dropping a column scales the whole drawing up rather than leaving a gap on the right. Five across
 * at a 5:1 cell-to-gap ratio is about as far as this can usefully go — the cells are now big enough
 * to read as objects rather than as texture, while the gaps stay narrow enough that the field still
 * reads as one surface instead of a scatter of tiles.
 *
 * Three rows, which is exactly what the taller pattern needs: the stack reaches the top row, so
 * there is no empty band above it. The field is now the drawing's extent rather than a frame around
 * it — it gives up the headroom that used to read as capacity not yet taken, and gets the density
 * back in exchange.
 */
const COLS = 5;
const ROWS = 3;
const RATIO = 5;
const S = (COL_W * RATIO) / (COLS * RATIO + (COLS - 1));
const G = S / RATIO;
const FIELD_W = COL_W;
const FIELD_H = ROWS * S + (ROWS - 1) * G;
const R = S / 3;

const r2 = (v: number) => +v.toFixed(2);
const px = (c: number) => r2(c * (S + G));
// Emitted straight onto attributes, so rounded here rather than in the arithmetic — the unrounded
// S and R still feed px(), FIELD_H, T, BLEED and PAD, all of which need the full value.
const S2 = r2(S);
const R2 = r2(R);

/**
 * How far the ripple grows, and the bleed the field reserves for it.
 *
 * Both patterns sit on the field's floor and start at its left edge, so a halo drawn around those
 * cells has nowhere to go: an SVG clips to its viewBox, and the ripple was being cut off square on
 * two sides. The viewBox is padded by exactly the halo's overhang and the box grows to match, with
 * the same amount taken straight back off the margins — so every cell lands where it did before,
 * and the only thing the padding adds is somewhere to spill.
 *
 * PAD is DERIVED from PULSE_SCALE, and the keyframe reads that scale back out of a custom property,
 * so the two cannot drift apart the way a hand-written pad would the first time the scale is tuned.
 */
const PULSE_SCALE = 1.75;
// Rounded UP, never down: two decimals of shortfall at the floor is still a flat edge on the halo.
const PAD = Math.ceil(((S * (PULSE_SCALE - 1)) / 2) * 100) / 100;
const BOX_W = r2(FIELD_W + PAD * 2);
const BOX_H = r2(FIELD_H + PAD * 2);

/**
 * One lit cell against a stack of six.
 *
 * Three on the floor, then two, then one: a pile with its weight at the bottom, which reads as mass
 * rather than as a shape. The earlier patch was an outline — you counted its cells. This one you do
 * not, which is the right instinct to leave the reader with, because the figure underneath already
 * says how many and the drawing should only say "more than one".
 *
 * Both start on the same floor cell, so the difference between the cards is only what is built on
 * it.
 */
const PATTERNS: { c: number; r: number }[][] = [
	[{ c: 0, r: ROWS - 1 }],
	[
		{ c: 0, r: ROWS - 3 },
		{ c: 0, r: ROWS - 2 },
		{ c: 1, r: ROWS - 2 },
		{ c: 0, r: ROWS - 1 },
		{ c: 1, r: ROWS - 1 },
		{ c: 2, r: ROWS - 1 },
	],
];

/**
 * One hue per card, and the lit cells take their own card's.
 *
 * These are alternatives rather than steps, so a single hue at two depths would have said "later,
 * bigger" — the thing every earlier cut in this family had to keep denying. Two different hues at
 * the same strength say "two of these" instead.
 *
 * Both are palette tokens, and both flip for dark mode, which is the reason to use the product
 * accent rather than a literal. The pair is CLOSE: 234° against 263°, where the teal this replaces
 * sat 60° off the blue. That is a deliberate trade — a near pair reads as two members of one family
 * rather than as two unrelated products, which is what these two modes are — and it puts more of
 * the work on the shapes in the field and on the marks along the floor, which were already carrying
 * it.
 */
const HUES = ['var(--color-primary, #3d50f5)', 'var(--color-product-gw, #6d28d9)'];

/**
 * Every orthogonally adjacent pair of lit cells, bridged.
 *
 * Derived rather than listed, so the joins can never fall out of step with the pattern above — the
 * hand-written link lists in earlier cuts had to be renumbered by hand every time a cell moved. A
 * bar in the gap, never a stroke, and drawn UNDER the cells so the overlap is hidden.
 *
 * SQUARE ENDS, no radius. A bar only buries BLEED (S/15) of itself inside each cell, so any corner
 * radius larger than that surfaces in the open gap and pinches the bar at both ends — the earlier
 * S/9 left 0.044*S of visible curve on each end of every bridge. The bar is T (S/3) wide against a
 * cell corner radius of the same S/3, which means its long edges land exactly on the straight
 * middle third of the cell's edge: square meets flat, and the join disappears.
 */
const T = S / 3;
const BLEED = S / 15;
function bridges(cells: { c: number; r: number }[]) {
	const out: { x: number; y: number; width: number; height: number }[] = [];
	cells.forEach((a, i) =>
		cells.slice(i + 1).forEach((b) => {
			if (a.r === b.r && Math.abs(a.c - b.c) === 1) {
				const l = a.c < b.c ? a : b;
				out.push({
					x: r2(px(l.c) + S - BLEED),
					y: r2(px(l.r) + (S - T) / 2),
					width: r2(G + BLEED * 2),
					height: r2(T),
				});
			} else if (a.c === b.c && Math.abs(a.r - b.r) === 1) {
				const t = a.r < b.r ? a : b;
				out.push({
					x: r2(px(t.c) + (S - T) / 2),
					y: r2(px(t.r) + S - BLEED),
					width: r2(T),
					height: r2(G + BLEED * 2),
				});
			}
		})
	);
	return out;
}

/**
 * Hops from the entry cell, breadth-first over orthogonal adjacency.
 *
 * The entry is the bottom-left lit cell, which is where both patterns start, so the wave runs the
 * way the eye already reads them. Derived rather than authored: a hand-numbered sequence would have
 * to be renumbered every time a cell moves, which is the mistake the link lists made twice.
 */
function hops(cells: { c: number; r: number }[]) {
	const key = (x: { c: number; r: number }) => `${x.c},${x.r}`;
	const start = cells.reduce((a, b) => (b.r > a.r || (b.r === a.r && b.c < a.c) ? b : a), cells[0]);
	const dist = new Map<string, number>([[key(start), 0]]);
	const queue = [start];
	while (queue.length) {
		const cur = queue.shift()!;
		cells.forEach((n) => {
			if (dist.has(key(n))) return;
			if (Math.abs(n.c - cur.c) + Math.abs(n.r - cur.r) !== 1) return;
			dist.set(key(n), dist.get(key(cur))! + 1);
			queue.push(n);
		});
	}
	return cells.map((x) => dist.get(key(x)) ?? 0);
}

const STEPS = PATTERNS.map(hops);

/**
 * The card's description, in units, and the pixel size it resolves to.
 *
 * The cap on the design unit comes FROM THE COPY rather than from the drawing, because everything
 * in the card is expressed in units — so pinning the one line of running text pins the mode, the
 * figure, the cells and the marks along with it.
 *
 * At 1.45px a unit put that description at 19.6px against the section paragraph's 18px: the
 * supporting text was louder than the copy it supports. 16px fixed that, but it was chosen against
 * the SANDBOX, whose feature row is not the homepage's feature block — the sandbox gives a 673px
 * column with a 32px heading, the homepage gives 525px with 28px. Measured where it ships, this
 * card was the tallest visual on the page and the only one covering 92% of its box.
 *
 * 14px is the site's minimum body size, so it is the floor for this: the drawing can be made
 * smaller than the copy beside it, but not smaller than text is allowed to be. At the homepage's
 * 525px column the cap binds and the card renders at 480 wide.
 *
 * TRAIT_U has to stay in step with `.sd__trait`'s `font-size: u(14)` below; it is the one number
 * here that the stylesheet repeats rather than reads.
 */
const TRAIT_U = 14;
const TRAIT_PX = 14;

const vars = [
	// `100cqw / EXTENT` still takes over in any container too narrow for the cap, so the phone widths
	// are untouched by this — only containers wide enough to have been capped anyway.
	`--sd-u: min(calc(${TRAIT_PX}px / ${TRAIT_U}), calc(100cqw / ${EXTENT}))`,
	`--sd-extent: ${EXTENT}`,
	`--sd-card-bleed: ${CARD_BLEED}`,
	`--sd-cols: ${modes.length}`,
	`--sd-gap: ${COL_GAP}`,
	`--sd-field-h: ${BOX_H}`,
	`--sd-pad: ${PAD}`,
	`--sd-pulse-scale: ${PULSE_SCALE}`,
].join('; ');
---

<div class="sd-fit">
	<ul class="sd" role="list" style={vars} data-hue={hue} data-animate={animate ? '' : undefined}>
		{
			modes.map((m, i) => (
				<li class="sd__card" style={`--sd-hue: ${HUES[i % HUES.length]}`}>
					{/* Decorative. The card's own text -- mode, trait, lead, figure, unit, and the named
					    marks -- already carries the whole claim, so a label here is a second, weaker voice
					    saying it worse. It also said something DIFFERENT: it counted the cells, announcing
					    "Cluster: 6 machines" while the card's own figure reads "Any size". The shape was
					    redrawn precisely so that nobody counts it -- see the note above PATTERNS -- so do
					    not restore a label. `role` goes with it: an `img` role with no accessible name is
					    announced as a bare "image", which is worse than nothing. */}
					<svg
						class="sd__field"
						viewBox={`${-PAD} ${-PAD} ${BOX_W} ${BOX_H}`}
						preserveAspectRatio="xMinYMid meet"
						aria-hidden="true"
					>
						{Array.from({ length: COLS * ROWS }).map((_, n) => (
							<rect class="sd__cell" x={px(n % COLS)} y={px(Math.floor(n / COLS))} width={S2} height={S2} rx={R2} />
						))}
						{bridges(PATTERNS[i]).map((b) => (
							<rect class="sd__link" x={b.x} y={b.y} width={b.width} height={b.height} />
						))}
						{PATTERNS[i].map((cell) => (
							<rect class="sd__lit" x={px(cell.c)} y={px(cell.r)} width={S2} height={S2} rx={R2} />
						))}
						{/* The ripple rides ON TOP of the lit cells rather than replacing their fill, so the
						    still frame — reduced motion, and the OG image, which cannot animate at all — is
						    the finished drawing rather than a frame of an animation. */}
						{animate &&
							PATTERNS[i].map((cell, n) => (
								<rect
									class="sd__pulse"
									style={`--sd-step: ${STEPS[i][n]}`}
									x={px(cell.c)}
									y={px(cell.r)}
									width={S2}
									height={S2}
									rx={R2}
								/>
							))}
					</svg>

					<div class="sd__head">
						<p class="sd__mode">{m.mode}</p>
						<p class="sd__trait">{m.trait}</p>
					</div>

					<p class="sd__reach">
						{m.lead && <span class="sd__lead">{m.lead}</span>}
						<span class="sd__num">{m.devices}</span>
						{(m.unit ?? 'devices') && <span class="sd__unit">{m.unit ?? 'devices'}</span>}
					</p>

					{/* Marks, with no words and no pills. Possible here only because Citus and Valkey were
					    supplied as files — Simple Icons has neither, and two stand-ins out of five was the
					    trap that took Zookeeper off the page entirely. */}
					<ul class="sd__stack" role="list">
						{m.stack.map((s) => (
							<li title={s}>
								<Icon name={LOGOS[s]} aria-hidden="true" />
								<span class="sd__sr">{s}</span>
							</li>
						))}
					</ul>
				</li>
			))
		}
	</ul>
</div>

<script>
	/**
	 * Stops the ripples animating while the field is off screen.
	 *
	 * Pausing rather than removing, because the seven cells are stepped apart by `animation-delay`
	 * and restarting them would collapse the wave into seven cells pulsing together the first time
	 * the row is looked at.
	 *
	 * Safe here because nothing in this file reads the animation's clock. Where something does --
	 * NormalizeSeries times its rows off its own pip -- the beat must be read from the animation's
	 * `currentTime`, which freezes with it, not counted from `startTime`, which does not.
	 */
	const fields = document.querySelectorAll('.sd[data-animate]');

	if (fields.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((e) => {
					(e.target as HTMLElement).style.setProperty('--sd-play', e.isIntersecting ? 'running' : 'paused');
				});
			},
			{ rootMargin: '80px' }
		);

		fields.forEach((f) => io.observe(f));
	}
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	.sd-fit {
		container-type: inline-size;
	}

	// Four shared rows, so the fields, the headings, the figures and the chips each sit on one line
	// across both cards. `1fr` on the last keeps the chips on the floor.
	.sd {
		--u: var(--sd-u);
		display: grid;
		grid-template-columns: repeat(var(--sd-cols), minmax(0, 1fr));
		grid-template-rows: auto auto auto 1fr;
		align-items: stretch;
		// 14 rather than 20. Only 39% of this card's height is the drawing — the rest is four stacked
		// groups and the air between them — so the gaps are the one place height can be taken back
		// without making any of it smaller. Three gaps at six units saved is 18px off the card.
		row-gap: u(14);
		column-gap: u(var(--sd-gap));
		// Border-box, so the columns still measure NATIVE — 474 units — between the paddings and every
		// number inside the drawing is unchanged. What the padding buys is that the cards' overhang
		// now falls INSIDE the element: the white surfaces stop exactly at the container's edges,
		// which are the row's 4px gutter — the same gutter the other four visuals sit in.
		box-sizing: border-box;
		max-width: u(var(--sd-extent));
		margin: 0 auto;
		padding: 0 u(var(--sd-card-bleed));
		list-style: none;
	}

	// No `gap` declaration: a subgrid that sets its own gutters overrides the parent's and collapses
	// every row onto the next.
	.sd__card {
		position: relative;
		display: grid;
		grid-row: span 4;
		grid-template-rows: subgrid;
	}

	// Each card is tinted with its own hue, at the same strength as its neighbour — the difference
	// between them is which colour, never how much.
	.sd__card::before {
		content: '';
		position: absolute;
		inset: u(-16) u(-14);
		border-radius: u(14);
		background: color-mix(in srgb, var(--sd-hue) 6%, transparent);
	}

	// --- hue on the field ---------------------------------------------------
	//
	// The inverse: a white card, and the wash moves into the empty cells. No stroke — this row is the
	// fifth `feature-block-section`, so `nth-child(odd)` puts it on #f5f6ff, and a white card on a
	// hued band is already an object resting on it. A hairline was tried and taken out: with the
	// ground doing the separating, an outline as well was two ways of saying one thing, and it put a
	// drawn edge on the only visual in the row that had none.
	.sd[data-hue='field'] .sd__card::before {
		background: var(--color-bg, #fff);
	}

	// Mixed with WHITE, not with transparent, and that is not a style choice. The bridges are painted
	// UNDER the cells and deliberately bleed into them; what hides the bleed is the cells being
	// opaque. A `transparent` mix at the same strength looks identical on a white card and lets every
	// connector's buried end show through it.
	.sd[data-hue='field'] .sd__cell {
		fill: color-mix(in srgb, var(--sd-hue) 14%, #fff);
	}

	.sd__card > * {
		position: relative;
	}

	// The box is the field PLUS the ripple's overhang on every side, with the overhang taken straight
	// back off the margins. Every cell lands exactly where it did before — 100% is the column, and the
	// column is u(220) at every width — but the halo now grows inside the element instead of against
	// its edge. Written as one `margin` shorthand: a later shorthand silently resets a longhand set
	// above it, and these rules carry no specificity to protect them.
	.sd__field {
		display: block;
		width: calc(100% + 2 * #{u(var(--sd-pad))});
		max-width: none;
		height: u(var(--sd-field-h));
		margin: calc(-1 * #{u(var(--sd-pad))}) 0 calc(#{u(6)} - #{u(var(--sd-pad))}) calc(-1 * #{u(var(--sd-pad))});
	}

	.sd__cell {
		fill: var(--color-bg, #fff);
	}

	.sd__lit {
		fill: var(--sd-hue);
	}

	// The connectors are the RELATIONSHIP, not the machines. At full strength they welded the stack
	// into one solid mass and the nodes stopped being countable at all; held back, they still join,
	// but the cells stay the thing the eye lands on first. `fill-opacity` rather than `opacity` so
	// nothing changes about stacking — the bars are still painted under the cells, and the BLEED that
	// buries their ends inside the cells is still covered by opaque fill on top.
	.sd__link {
		fill: var(--sd-hue);
		fill-opacity: 0.45;
	}

	// One hop is 100ms and each ring expands over 324ms — 9% of the 3.6s cycle. The stack is two hops
	// deep, so the whole wave is over in 524ms and the field is then still for the rest of the loop.
	// The REST is what makes this readable beside a column of copy: a continuous shimmer is a
	// distraction, a quick pulse with a long pause is a heartbeat. Speed belongs in the ring and the
	// hop; the cycle is the pause, and shortening that would make it busy rather than fast.
	.sd__pulse {
		fill: var(--sd-hue);
		transform-box: fill-box;
		transform-origin: center;
		animation: sd-pulse 3.6s ease-out infinite;
		animation-delay: calc(var(--sd-step, 0) * 100ms);
		// Paused while the row is off screen: seven ripples that sit three viewports below the fold
		// otherwise run for the life of the page. Must stay BELOW the shorthand on the line above --
		// Astro scopes to `:where()`, so a later shorthand would silently reset this longhand.
		//
		// The default is `running`, not `paused`, so with no script the field animates exactly as it
		// does today rather than freezing for good.
		animation-play-state: var(--sd-play, running);
	}

	@keyframes sd-pulse {
		0% {
			opacity: 0.55;
			transform: scale(1);
		}
		9% {
			opacity: 0;
			transform: scale(var(--sd-pulse-scale));
		}
		100% {
			opacity: 0;
			transform: scale(var(--sd-pulse-scale));
		}
	}

	// The drawing is complete without it, so there is nothing to substitute — the ripple simply does
	// not run.
	@media (prefers-reduced-motion: reduce) {
		.sd__pulse {
			animation: none;
			opacity: 0;
		}
	}

	// Packed to the top, or the leftover height in the shorter column is shared into both rows and
	// the description drops below its neighbour's first line.
	.sd__head {
		display: grid;
		align-content: start;
		gap: u(3);
	}

	// The weight sits on the NAME, not on the number. The figure was bold because in Ubuntu Mono a
	// regular weight reads thin and technical; in Ubuntu it just became the heaviest thing on the
	// card, so the reader met "1M" before "Monolith" and had to work back up to find out what the
	// million was a million of. The name goes semibold and the figure drops to medium — it is still
	// the largest type here at 24 units against 21, so size carries it without weight having to.
	//
	// Semibold rather than bold: the section heading beside these cards is 32px at medium, and a card
	// title heavier than the heading above it would trade one inversion for another.
	.sd__mode {
		margin: 0;
		font-size: u(21);
		line-height: u(26);
		font-weight: $font-weight-semibold;
		color: var(--color-text);
	}

	.sd__trait {
		margin: 0;
		font-size: u(14);
		line-height: u(19);
		color: var(--color-text-secondary, #5b616e);
		text-wrap: pretty;
	}

	.sd__reach {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0 u(6);
		margin: 0;
		align-self: start;
	}

	// Ubuntu throughout, including the figure. Mono was buying tabular digits nothing here lines up
	// against — the two figures sit in separate cards, so the columns it aligns do not exist — and
	// paying for it with a second typeface on a card that has four words on it.
	.sd__num {
		font-size: u(24);
		font-weight: $font-weight-medium;
		line-height: u(30);
		// The card's hue, so the colour runs the whole column — field, figure, marks — instead of
		// stopping at the drawing and picking up again at the floor. `Up to` and `devices` stay
		// secondary grey, which leaves the coloured words as exactly the two a scanner needs: the
		// figure, and nothing else in the phrase around it.
		color: var(--sd-hue);
		white-space: nowrap;
	}

	.sd__unit {
		font-size: u(14);
		line-height: u(20);
		color: var(--color-text-secondary, #5b616e);
	}

	// Marks on the card, no pills. The longest row is five, and five at 34 units with four 9-unit
	// gaps is 206 of the column's 220 — still one row, with 14 units to spare.
	.sd__stack {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: u(9);
		margin: 0;
		padding: 0;
		list-style: none;
		align-self: end;

		li {
			display: flex;
			align-items: center;
		}
	}

	// Sized in design units, NOT with astro-icon's width/height attributes, which are absolute pixels
	// and would not scale with `--u`.
	//
	// They take the CARD's hue, like the lit cells above them, so the colour owns the whole column
	// rather than stopping at the drawing. In ink they left the Cluster card teal at the top and
	// near-black at the foot, which read as two unrelated halves.
	.sd__stack [data-icon] {
		flex: none;
		width: u(34);
		height: u(34);
		color: var(--sd-hue);
	}

	// The Cassandra mark is a lens: full width in its box, but half its height. Measured against its
	// neighbours it covers 52% of its square where the elephant covers 96%, so at an equal box it
	// carries about half the ink and reads as the runt of the row. Sized by what it COVERS rather than
	// by its box — a flat mark has to run wider than its neighbours to weigh the same.
	//
	// +18% rather than the +36% that would equalise the areas outright, which on a 2:1 mark would let
	// it run away with the row. Five marks then measure 212 of the column's 220: still one line.
	//
	// `li` is in the selector to outrank the rule above it on specificity rather than on source order.
	// Astro scopes with `:where()`, which adds nothing, so these two would otherwise tie and the
	// winner would be whichever was written last.
	.sd__stack li [data-icon='simple-icons:apachecassandra'] {
		width: u(40);
		height: u(40);
	}

	// Inline with the figure, not a line of its own. Stacked, it read as a label over a number; on
	// the same line it reads as one phrase — "Up to 1M devices".
	.sd__lead {
		font-size: u(14);
		line-height: u(20);
		color: var(--color-text-secondary, #5b616e);
	}

	// Off the surface, still in the document.
	// --- the phone exception -------------------------------------------------
	//
	// This visual, alone in the row, gets a break in its own scaling on a phone, and it is worth
	// saying why it is an exception rather than a pattern. Everything here is a multiple of a unit
	// taken from the container, which is what keeps the drawing and its type in one proportion at
	// every width. On a phone that proportion is honest and unreadable at the same time: the
	// container falls to about 367, the unit to roughly 0.74, and the card's supporting line lands
	// at about 10.2px — below this site's 14px floor for page text, and small enough that nobody
	// reads it. (That figure was written as 11px against the old NATIVE divisor; the unit is taken
	// from EXTENT now, so 367 / 502 x 14 is the true number.)
	//
	// So on a phone the drawing keeps the unit and the TYPE stops obeying it. The supporting line
	// goes, and the three things left — the mode, the figure and its unit — are set at larger
	// multiples so they land near the floor rather than under it. A phone reader gets the mode, the
	// number and the marks, which is the whole argument; the sentence was the first thing to lose
	// because it is the one part the drawing beside it already says.
	//
	// A CONTAINER query, not a viewport one. The component is given a width by whatever holds it and
	// has no business knowing the window — the number is comfortably above the 367 a phone row hands
	// it and below the 525 of the desktop row, so the desktop composition never sees any of this.
	//
	// 445 rather than 420, and the 25px matters. The trait is u(14) and the unit is container / 502
	// below its cap, so the sentence paints at container / 35.86 — 11.74px at a 421 container. At
	// 420 the rescue fired just too late: a container between 421 and 445 painted that sentence
	// SMALLER than the smallest thing a 367 phone paints (the lead, at 12.43px), so a wider phone
	// read worse than a narrow one. 445 is where the trait falls to 12.4px, the smallest type this
	// exception is itself willing to paint, which closes that inversion exactly and no further.
	//
	// Deliberately NOT 501, which is where the sentence finally clears the site's 14px floor:
	// that number drags the phone treatment onto half-screen desktop windows, which lose the
	// sentence and get type popping up by about 5px.
	@container (max-width: 445px) {
		// Hidden from the eye, not from the page. `display: none` would take it out of the
		// accessibility tree as well, and a screen reader on a phone would lose a sentence that costs
		// it nothing — the reason to drop this line is that it is too small to read, which is not a
		// reason a screen reader shares.
		.sd__trait {
			@include visually-hidden;
		}

		.sd__mode {
			font-size: u(27);
			line-height: u(32);
		}

		.sd__num {
			font-size: u(32);
			line-height: u(38);
		}

		.sd__lead,
		.sd__unit {
			font-size: u(17);
			line-height: u(22);
		}
	}

	.sd__sr {
		@include visually-hidden;
	}
</style>
