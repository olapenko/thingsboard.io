---
import SmartImage from '@components/SmartImage.astro';
import { Icon } from 'astro-icon/components';

// DISABLED — hover clusters. Marked for removal or repair; do not re-enable as-is.
//
// One cluster per category, reused from the IoT Hub's own hero artwork. The intent: hovering a
// category tile throws that category's hero cluster across the card at 22% opacity.
//
// Why it is off. EVERY rule for this artwork — including the `position: absolute` and `opacity: 0`
// that hide it — lives inside a single `@include media-up(lg)` block in the stylesheet below. Only
// the hover REVEAL belongs behind that breakpoint; the hiding does not. So under 1024px none of it
// applies and all six SVGs render as ordinary flow content. Measured at 1000px wide: six images at
// 858px each, 1302px of stacked artwork, card height 1806px. It is the whole tablet range, not an
// edge case.
//
// To repair: lift `.ecosystem-card__clusters` (absolute, inset 0, overflow hidden) and
// `.ecosystem-card__cluster` (absolute, opacity 0) OUT of the `media-up(lg)` block, leaving only
// the `:has()` hover rules inside it. Then restore the markup below and re-check at 375, 1000 and
// 1440. To remove: delete this block, the markup below, and the `.ecosystem-card__clusters` /
// `__cluster` rules; the six SVGs in `assets/iot-hub/` are the Hub hero's own and stay.
//
// import deviceCluster from '@root/assets/iot-hub/hero-device-cluster.svg';
// import solutionCluster from '@root/assets/iot-hub/hero-solution-template-cluster.svg';
// import widgetCluster from '@root/assets/iot-hub/hero-widget-cluster.svg';
// import calcCluster from '@root/assets/iot-hub/hero-calculated-field-cluster.svg';
// import alarmCluster from '@root/assets/iot-hub/hero-alarm-rule-cluster.svg';
// import ruleChainCluster from '@root/assets/iot-hub/hero-rule-chain-cluster.svg';
//
// const clusterBySlug: Record<string, { src: string }> = {
// 	devices: deviceCluster,
// 	'solution-templates': solutionCluster,
// 	widgets: widgetCluster,
// 	'calculated-fields': calcCluster,
// 	'alarm-rules': alarmCluster,
// 	'rule-chains': ruleChainCluster,
// };
import { externalLinkAttrs } from '@util/external-links';

interface Props {
	name: string;
	/** Category line under the name. */
	label: string;
	description: string;
	icon: string;
	href: string;
	/** Label colour, passed per product. */
	accent: string;
	/** Names the destination — replaces the generic "Read more". */
	action: string;
	/** Fills the squircle and knocks the mark out white on top of it. */
	badgeFill?: string;
	/** Substring of `name` tinted with `badgeFill`. */
	nameHighlight?: string;
	/** Small line icon pinned to the squircle's top-right corner. */
	cornerIcon?: string;
	/** Sold as an add-on rather than core platform. */
	addOn?: boolean;
	/** Spans two columns and carries the phone mockup. */
	wide?: boolean;
	videoWebm?: string;
	videoMp4?: string;
	/**
	 * `region` renders the header sign-in menu's own US/EU mark before the label;
	 * `icon` renders a Tabler glyph there instead. A store has one or the other.
	 */
	stores?: { label: string; href: string; region?: 'us' | 'eu'; icon?: string }[];
	/** Monochrome marks naming where the product can run. Decorative — the labels are
	 *  carried as `title`/`aria-label` on each mark, and the copy above names them too. */
	targets?: { label: string; icon: string }[];
	flipped?: boolean;
	tiles?: { slug: string; label: string; href: string; color: string; icon: string }[];
	class?: string;
}

const {
	name,
	label,
	description,
	icon,
	href,
	accent,
	action,
	badgeFill,
	nameHighlight,
	cornerIcon,
	addOn = false,
	wide = false,
	videoWebm,
	videoMp4,
	stores,
	targets,
	flipped = false,
	tiles,
	class: className = '',
} = Astro.props;

// Split the name so the distinguishing word can carry its badge's colour.
// Throws rather than silently rendering a flat title if the copy changes.
type NamePart = { text: string; tint?: boolean };

let nameParts: NamePart[] = [{ text: name }];

if (nameHighlight) {
	const at = name.indexOf(nameHighlight);

	if (at === -1) {
		throw new Error(`EcosystemCard "${name}": no "${nameHighlight}" in the name to tint.`);
	}

	const before = name.slice(0, at);
	const after = name.slice(at + nameHighlight.length);

	nameParts = [
		...(before ? [{ text: before }] : []),
		{ text: nameHighlight, tint: true },
		...(after ? [{ text: after }] : []),
	];
}
---

<div
	class:list={[
		'ecosystem-card',
		wide && 'ecosystem-card--wide',
		flipped && 'ecosystem-card--flipped',
		badgeFill && 'ecosystem-card--product',
		className,
	]}
	style={`--accent: ${accent}${badgeFill ? `; --badge-fill: ${badgeFill}` : ''}`}
>
	<span class="ecosystem-card__badge" aria-hidden="true">
		{
			icon.startsWith('tabler:') ? (
				<Icon name={icon} class="ecosystem-card__icon ecosystem-card__icon--vector" />
			) : (
				<SmartImage src={icon} alt="" class="ecosystem-card__icon" loading="lazy" width="96" height="96" />
			)
		}
	</span>

	<div class="ecosystem-card__body">
		<p class="ecosystem-card__label">
			{label}
			{addOn && <span class="ecosystem-card__addon"> · Add-on</span>}
		</p>
		<h3 class="ecosystem-card__title">
			{
				nameParts.map((part) =>
					part.tint ? (
						<>
							{cornerIcon && <Icon name={cornerIcon} class="ecosystem-card__title-icon" aria-hidden="true" />}
							<span class="ecosystem-card__name-accent">{part.text}</span>
						</>
					) : (
						part.text
					)
				)
			}
		</h3>
		<p class="ecosystem-card__description">{description}</p>

		{
			/* Buttons above the link, so the card ends on the lighter of the two.
			   The buttons are the thing to do — signing up, installing — and they sit
			   directly under the sentence that argues for it; the link is the "read
			   more first" path and closes the card as a footnote. The card-wide click
			   target is unaffected: it is `__link::after` at `inset: 0`, positioned
			   against the card rather than against its place in this column. */
		}
		<div class="ecosystem-card__actions">
			{
				(stores || targets) && (
					<div class="ecosystem-card__stores">
						{stores?.map((store) => (
							<a class="ecosystem-card__store" href={store.href} {...externalLinkAttrs(store.href)}>
								{store.region && (
									<span class:list={['region-badge', `region-badge--${store.region}`]} aria-hidden="true">
										{store.region.toUpperCase()}
									</span>
								)}
								{store.icon && <Icon name={store.icon} class="ecosystem-card__store-icon" aria-hidden="true" />}
								{store.label}
							</a>
						))}

						{targets && (
							<ul class="ecosystem-card__targets">
								{targets.map((t) => (
									<li>
										<Icon name={t.icon} aria-hidden="true" />
										<span class="sr-only">{t.label}</span>
									</li>
								))}
							</ul>
						)}
					</div>
				)
			}

			<a href={href} class="ecosystem-card__link" {...externalLinkAttrs(href)}>
				{action}
				<span class="sr-only">— {name}</span>
			</a>
		</div>
	</div>

	{
		/* DISABLED — see the note in the frontmatter. Renders six full-size SVGs as flow content
		   below 1024px, because the rules that hide them are inside a `media-up(lg)` block.

		tiles && (
			<div class="ecosystem-card__clusters" aria-hidden="true">
				{tiles.map((tile) => (
					<img class="ecosystem-card__cluster" data-cat={tile.slug} src={clusterBySlug[tile.slug].src} alt="" />
				))}
			</div>
		)
		*/
	}

	{
		tiles && (
			<div class="ecosystem-card__tiles">
				{tiles.map((tile) => (
					<a class="ecosystem-card__tile" data-cat={tile.slug} href={tile.href} style={`--tile: ${tile.color}`}>
						<Icon name={tile.icon} class="ecosystem-card__tile-icon" aria-hidden="true" />
						<span>{tile.label}</span>
					</a>
				))}
			</div>
		)
	}

	{
		wide && Astro.slots.has('default') && (
			<div class="ecosystem-card__visual">
				<slot />
			</div>
		)
	}

	{
		wide && !Astro.slots.has('default') && !videoWebm && !tiles && (
			<div class="ecosystem-card__slot" aria-hidden="true">
				<span>Visual</span>
			</div>
		)
	}

	{
		wide && videoWebm && (
			<div class="ecosystem-card__mockup" aria-hidden="true">
				<div class="ecosystem-card__phone">
					{/* preload="none" + data-src: nothing is fetched until the card is
					    near the viewport, which matters at 564 KB. */}
					<video class="ecosystem-lazy-video" loop muted playsinline preload="none">
						<source data-src={videoWebm} type="video/webm" />
						<source data-src={videoMp4} type="video/mp4" />
					</video>
				</div>
			</div>
		)
	}
</div>

<script>
	// Same deferral the mobile pages use: load on approach, once.
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const io = new IntersectionObserver(
		(entries, obs) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				const video = entry.target as HTMLVideoElement;
				video.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((s) => {
					s.src = s.dataset.src!;
				});
				video.load();
				if (!reduce) video.play().catch(() => {});
				obs.unobserve(video);
			});
		},
		{ rootMargin: '300px' }
	);
	document.querySelectorAll<HTMLVideoElement>('video.ecosystem-lazy-video').forEach((v) => io.observe(v));
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	$badge: 72px;

	.ecosystem-card {
		position: relative;
		display: flex;
		flex-direction: column;
		// Leaves room for the badge to hang over the top edge without the first
		// line of text riding up under it.
		margin-top: calc($badge / 2);
		padding: calc($badge / 2 + #{$spacing-5}) $spacing-5 $spacing-5;
		// No stroke, at rest or on hover. The card is defined by its fill against the
		// band behind it; an outline on top of that was a second edge saying the same
		// thing, and on the dark deployments band it was the weaker of the two.
		border-radius: $radius-lg;
		// Fill alone was not enough on the LIGHT band: white on #f5f6ff is a
		// luminance ratio of 1.076, which holds on a good display and disappears on
		// a poor one. So the edge the stroke used to draw is given back as depth
		// instead of as a line — deliberately far under the hover shadow (24px blur
		// at 8%), so hover still reads as a change rather than as more of the same.
		// It does nothing on the dark band, where the fill already carries the card.
		box-shadow:
			0 1px 2px rgba(0, 0, 0, 0.04),
			0 8px 16px -8px rgba(0, 0, 0, 0.06);
		background-color: var(--color-bg-surface);
		text-align: center;
		color: var(--color-text);
	}

	// App-style squircle straddling the top edge. `border-radius` in percent is
	// the practical approximation — a true superellipse needs an SVG path or
	// `corner-shape`, which isn't broadly supported yet.
	.ecosystem-card__badge {
		position: absolute;
		top: 0;
		left: 50%;
		transform: translate(-50%, -50%);
		display: grid;
		place-items: center;
		width: $badge;
		height: $badge;
		border-radius: 32%;
		background-color: var(--color-bg-surface);
		// Shadow alone lifts the badge off the card; a stroke as well read as two
		// competing edges where the squircle overlaps the card's own border.
		box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
	}

	// Held short of the squircle's corner radius (24% of 72px ≈ 17px) so nothing
	// pokes past the rounded edge — the badge deliberately doesn't clip, since
	// clipping would cost the artwork rather than reveal the problem.
	// Filled squircle: the mark is knocked out white so one asset serves both
	// cards, with the corner icon carrying the difference.
	.ecosystem-card--product {
		.ecosystem-card__badge {
			background-color: var(--badge-fill);
			// Two layers on the fill: a highlight that sweeps across on hover, and a
			// static sheen off the top-left. Driven as backgrounds rather than a
			// pseudo-element because backgrounds are clipped by the squircle's own
			// radius — so the badge still shows any artwork that outgrows it, which
			// `overflow: hidden` would have hidden instead.
			background-image:
				linear-gradient(100deg, rgba(255, 255, 255, 0) 38%, rgba(255, 255, 255, 0.42) 50%, rgba(255, 255, 255, 0) 62%),
				linear-gradient(150deg, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0) 62%);
			// Sweep layer is 2.5x wide and parked past the left edge; only its
			// position animates.
			background-size:
				250% 100%,
				100% 100%;
			background-position:
				100% 0,
				0 0;
			background-repeat: no-repeat;
			// Mark to the bottom-left, deployment icon to the top-right: the two
			// sit on a diagonal so neither crowds the other in a 72px square.
			// The glyph has moved to the title, so the mark has the square to itself.
			// No padding override: it then centres and sizes exactly as every other
			// card's icon does, which is the point.
		}

		// Smaller than the ecosystem marks: this one shares the squircle with a
		// corner icon, so it needs the room rather than filling the tile.
		// The mark leads; the deployment glyph is a qualifier, so it stays small
		// enough not to compete for the same 72px.
		// The mark asset is a true 44x44 square, so it fills its box rather than
		// carrying the favicon's internal padding — it can run larger at the same
		// optical size. Clearance to the corner glyph is checked below.
		// Only the knockout differs from the base icon now.
		.ecosystem-card__icon {
			filter: brightness(0) invert(1);
		}

		// Stroke takes the card's own colour on hover, over a low-saturation wash.
		// Shape follows the docs pattern (SplitCard, DocHero): oversized radial,
		// anchored off-corner so the card catches its edge rather than sitting in
		// the middle of a blob.
		&:hover .ecosystem-card__badge,
		&:focus-within .ecosystem-card__badge {
			animation: badge-shimmer 0.75s cubic-bezier(0.4, 0, 0.2, 1);
		}

		&:hover,
		&:focus-within {
			background:
				radial-gradient(color-mix(in srgb, var(--badge-fill) 13%, transparent), transparent 70%) no-repeat -10% -40% /
					140% 260%,
				var(--color-bg-surface);
		}
	}

	// Sits inside the squircle rather than overhanging it: without the white disc
	// behind it, an overhanging glyph would cross onto the card and disappear.
	@keyframes badge-shimmer {
		from {
			background-position:
				100% 0,
				0 0;
		}
		to {
			background-position:
				0% 0,
				0 0;
		}
	}

	// Separator between the product name and the deployment: deliberately closer
	// to the word it qualifies, and in that deployment's own colour.
	.ecosystem-card__title-icon {
		display: inline-block;
		width: 0.82em;
		height: 0.82em;
		margin-left: 0.16em;
		margin-right: 0.1em;
		vertical-align: -0.08em;
		color: var(--badge-fill);
	}

	.ecosystem-card__corner {
		position: absolute;
		top: 6px;
		right: 6px;
		width: 22px;
		height: 22px;
		color: #fff;
	}

	.ecosystem-card__icon {
		width: 82%;
		height: auto;
	}

	// Tabler glyphs carry their own padding inside a 24x24 viewBox, so they need a
	// smaller box to land at the same optical size as the artwork icons.
	.ecosystem-card__icon--vector {
		width: 64%;
		height: auto;
		color: var(--accent);
	}

	// The word that tells the two deployments apart, tinted to its own badge.
	// The word that tells the two deployments apart, tinted to its own badge. No
	// fallback needed: on cards without --badge-fill this is invalid at
	// computed-value time, which inherits the title's colour.
	.ecosystem-card__name-accent {
		color: var(--badge-fill);
	}

	.ecosystem-card__title {
		margin: $spacing-1 0 $spacing-5;
		font-size: $font-size-h4;
		font-weight: $font-weight-bold;
		line-height: 1.2;
	}

	.ecosystem-card__label {
		margin: 0;
		font-size: $font-size-xs;
		font-weight: $font-weight-bold;
		line-height: 1.2;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--accent);
	}

	// Add-on status rides on the type line rather than arriving as a badge: it is
	// classification, and the classification already lives here. Muted, so the
	// accent still reads first and this is skippable.
	.ecosystem-card__addon {
		color: #6e7481;
		font-weight: $font-weight-medium;
	}

	.ecosystem-card__body {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	// Where it runs, as marks rather than a second sentence — and in the button's
	// own row, so the line reads "Install … on these". Monochrome and at the label's
	// grey, so four vendor logos cost the card one ink instead of four brand colours
	// — the point of `simple-icons`, which is single-path and takes `currentColor`.
	// The names are already in the paragraph above, so these are decorative and
	// carry their text for a screen reader only.
	.ecosystem-card__targets {
		display: flex;
		align-items: center;
		gap: $spacing-3;
		// Centred against the 36px button rather than sitting on its baseline; the
		// row's own gap is 8px, and a little more separates the marks from the
		// control they qualify.
		margin: 0 0 0 $spacing-1;
		padding: 0;
		list-style: none;
		color: #6e7481;

		li {
			display: flex;
		}

		:global([data-icon]) {
			width: 24px;
			height: 24px;
		}
	}

	// Pinned to the foot so links line up across a row of unequal text lengths.
	.ecosystem-card__actions {
		margin-top: auto;
		display: flex;
		flex-direction: column;
		gap: $spacing-3;
		align-items: center;
	}

	.ecosystem-card__description {
		margin: 0 0 $spacing-5;
		font-size: $font-size-sm;
		line-height: 1.55;
		text-wrap: pretty;
		// Keeps the measure readable even when a card is given a wide column.
		max-width: 42ch;
		margin-inline: auto;
	}

	// Pinned to the bottom so the links line up across cards of unequal height.
	.ecosystem-card__link {
		font-weight: $font-weight-medium;
		color: var(--accent);
		text-decoration: none;

		&:hover,
		&:focus-visible {
			text-decoration: underline;
			text-underline-offset: 3px;
		}
	}

	// ── Double-wide variant: the section's key visual ──────────────
	// Two columns at desktop; the phone is anchored to the bottom and clipped by
	// the card, so it reads as continuing past the edge rather than being cut.
	.ecosystem-card--wide {
		// The glow belongs to the two-wide format: a one-wide card is too small to
		// hold it without the colour reading as a fill. Centre tracks the badge,
		// which sits at 50% until the card actually splits into two columns.
		--card-glow: var(--badge-fill, var(--accent));
		--card-glow-x: 50%;

		background-image: radial-gradient(
			95% 105% at var(--card-glow-x) 0%,
			color-mix(in srgb, var(--card-glow) 17%, transparent),
			color-mix(in srgb, var(--card-glow) 7%, transparent) 42%,
			transparent 84%
		);

		// `md`, not `lg`, and the reason is that this card's width does not follow the
		// viewport's. The grid around it is 3 columns from `lg` up and a wide card
		// spans 2 of them; below `lg` the grid is 2 columns and the card spans BOTH,
		// so it is the full 960 measure. Measured:
		//
		//   viewport 1151 -> grid 3 cols -> card 633px
		//   viewport 1000 -> grid 2 cols -> card 960px
		//
		// The card gets 327px WIDER as the viewport narrows. Keyed to `lg` this split
		// therefore turned itself off exactly where the card had the most room, and no
		// viewport breakpoint can express it, because card width is not monotonic in
		// viewport width. `md` is the point the grid itself collapses to one column,
		// so the card is now two columns for precisely as long as the grid is
		// multi-column — the two breakpoints describe the same thing and should be the
		// same one. The narrowest two-column case stays 633px, which is what `lg`
		// already shipped.
		//
		// The robust version is a container query on the card's own width, which would
		// survive the grid being re-laid-out again; it needs a wrapper element to
		// query, since an element cannot query itself.
		@include media-up(md) {
			display: grid;
			grid-template-columns: 1fr 1fr;
			// `stretch` lets the body run the card's full height so its actions can
			// reach the foot; the copy still starts at the top of that column.
			align-items: stretch;
			gap: $spacing-5;

			// Badge centres over the text column, not the whole card — over the
			// midpoint it would float between the copy and the phone, attached to
			// neither. The glow follows it.
			--card-glow-x: 25%;

			.ecosystem-card__badge {
				left: 25%;
			}
		}
	}

	// A visual passed in from the page rather than built into the card — the escape
	// hatch for one-off artwork that isn't worth a prop.
	.ecosystem-card__visual {
		align-self: center;
		min-width: 0;
	}

	// Reserves the second column on a two-wide card that has no visual yet, so the
	// format can be laid out before the artwork exists. Never appears on a card
	// that carries a mockup or tiles.
	.ecosystem-card__slot {
		display: grid;
		place-items: center;
		min-height: 180px;
		border: 1px dashed color-mix(in srgb, var(--card-glow) 45%, transparent);
		border-radius: $radius-md;
		background: color-mix(in srgb, var(--card-glow) 4%, transparent);
		font-size: $font-size-sm;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--card-glow) 70%, transparent);
	}

	// The clip belongs here, not on the card: `overflow: hidden` on the card was
	// also cutting the badge that straddles its top edge. The fixed height decides
	// how much phone shows, and therefore how tall the card is.
	.ecosystem-card__mockup {
		position: relative;
		align-self: end;
		height: 250px;
		overflow: hidden;
		margin-bottom: calc(-1 * #{$spacing-5});
	}

	// Frame art sets the aspect; the video sits in the screen cut-out. Percentages
	// match the iPhone frame used on the mobile pages.
	.ecosystem-card__phone {
		position: absolute;
		top: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 240px;
		// `aspect-ratio` resolves against this element; a percentage `padding-top`
		// would resolve against the grid cell instead and skew the frame.
		aspect-ratio: 480 / 1039;
		background-image: url(/images/mobile/iphone12promax-frame.png);
		background-size: 100% auto;
		background-repeat: no-repeat;

		video {
			position: absolute;
			top: 2.15%;
