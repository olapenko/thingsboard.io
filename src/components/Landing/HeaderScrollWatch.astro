---
// The marketing bar's two marks, both from IntersectionObservers rather than a scroll listener:
//
// - `data-header-scrolled` once the page has started to slide under the bar: just past the promo
//   banner's band, which a hero starts below, or 50px on a page without one. The sentinel is appended
//   to <body> so it sits in the page flow even though this renders in the fixed header.
// - `data-header-over-hero` while a dark hero is still under the bar's bottom edge: the hero and any
//   dark band right after it (the homepage's logo strip). Scrolled over it, the bar keeps the hero's
//   white ink on a ground of the hero's own colour (`--tb-hero-ground`), and takes the light surface
//   only where the page under it turns light, so the swap from white ink to dark happens with the
//   page's own and never over the hero.
---

<script is:inline>
	(function () {
		const header = document.querySelector('header.header');
		if (!header) return;

		const sentinel = document.createElement('div');
		sentinel.setAttribute('aria-hidden', 'true');
		sentinel.style.cssText =
			'position:absolute;top:max(50px, calc(var(--promo-h, 0px) + 8px));left:0;width:1px;height:1px;pointer-events:none;visibility:hidden';
		document.body.prepend(sentinel);

		new IntersectionObserver(
			function (entries) {
				header.toggleAttribute('data-header-scrolled', !entries[0].isIntersecting);
			},
			{ threshold: 0 }
		).observe(sentinel);

		if (!header.querySelector('[data-header-hero="dark"]')) return;

		// An opaque ground darker than a mid grey: the hero's, or a band's that continues it.
		function darkGround(el) {
			const c = getComputedStyle(el).backgroundColor.match(/[\d.]+/g);
			if (!c) return null;
			const [r, g, b, a = 1] = c.map(Number);
			return a > 0.9 && 0.2126 * r + 0.7152 * g + 0.0722 * b < 64 ? `rgb(${r} ${g} ${b})` : null;
		}

		function watchHero() {
			const hero = document.getElementById('hero');
			if (!hero) return;
			const ground = [hero];
			for (let el = hero.nextElementSibling; el; el = el.nextElementSibling) {
				if (!el.offsetHeight) continue; // the scripts and styles between sections
				if (!darkGround(el)) break;
				ground.push(el);
			}
			// A hero drawn by an image has no ground of its own; the bar's fallback stands in.
			const colour = darkGround(hero);
			if (colour) document.documentElement.style.setProperty('--tb-hero-ground', colour);

			const under = new Set();
			let io = null;
			// The root is the one line at the bar's bottom edge; a resize moves it, so it is drawn again.
			function observe() {
				if (io) io.disconnect();
				under.clear();
				const edge = header.offsetHeight;
				io = new IntersectionObserver(
					function (entries) {
						for (const e of entries) {
							if (e.isIntersecting) under.add(e.target);
							else under.delete(e.target);
						}
						header.toggleAttribute('data-header-over-hero', under.size > 0);
					},
					{ rootMargin: `-${edge - 1}px 0px -${Math.max(0, innerHeight - edge)}px 0px` }
				);
				ground.forEach(function (el) {
					io.observe(el);
				});
			}
			observe();
			let t = 0;
			addEventListener('resize', function () {
				clearTimeout(t);
				t = setTimeout(observe, 120);
			});
		}

		if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', watchHero);
		else watchHero();
	})();
</script>
