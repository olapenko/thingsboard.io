---
import { Icon } from 'astro-icon/components';

interface Props {
	/**
	 * Section title
	 */
	title: string;
	/**
	 * Optional subtitle/description
	 */
	subtitle?: string;
	/**
	 * Text alignment
	 */
	align?: 'left' | 'center' | 'right';
	/**
	 * Color theme
	 */
	theme?: 'light' | 'dark';
	/**
	 * Which step of the shared type scale the title takes.
	 *
	 * The page used to say this instead, in rules keyed to the section's ID — `#products
	 * .section-header__title` and a blanket `#overflow h2`. Those score (1,1,0) and (1,0,1), so the
	 * component could not be corrected from its own stylesheet and neither could the mixins: a change
	 * to `section-title` moved nothing on the homepage. Stating it as a prop puts the decision back on
	 * the call site and the values back in the scale.
	 */
	titleSize?: 'display' | 'title' | 'section';
	/**
	 * Measure for the subtitle. `wide` is this component's own 900px; `copy` is the 65ch the homepage
	 * sets so its ledes share one measure — previously `#overflow .section-header__subtitle`.
	 */
	subtitleMeasure?: 'wide' | 'copy';
	/**
	 * Measure for the TITLE. `full` is the header's own width, which is right for the short titles
	 * most sections carry. `headline` caps it so a long one breaks into two lines instead of running
	 * the width of the page — see the rule for why that is a measure and not a line count.
	 */
	titleMeasure?: 'full' | 'headline';
	/**
	 * The section's mark, as the feature rows carry one: the page's squircle in the section's own
	 * hue, above the title. Same 48px tile and 32% radius as `FeatureBlockSection`, centred here
	 * because this header is.
	 */
	badge?: { icon: string; color: string };
	class?: string;
}

const {
	title,
	subtitle,
	align = 'center',
	theme = 'light',
	titleSize = 'section',
	subtitleMeasure = 'wide',
	titleMeasure = 'full',
	badge,
	class: className = '',
} = Astro.props;
---

<div
	class:list={[
		'section-header',
		`section-header--${align}`,
		`section-header--${theme}`,
		`section-header--title-${titleSize}`,
		`section-header--subtitle-${subtitleMeasure}`,
		`section-header--title-measure-${titleMeasure}`,
		className,
	]}
>
	{
		badge && (
			<span class="section-header__badge" style={`--badge-color: ${badge.color}`} aria-hidden="true">
				<Icon name={badge.icon} />
			</span>
		)
	}
	<h2 class="section-header__title">{title}</h2>
	{subtitle && <p class="section-header__subtitle">{subtitle}</p>}
	<slot />
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	// The same tile as the rows carry, to the pixel — which is 40 at a 24 glyph, NOT the 48/28 the
	// shared row component declares. `_home-rows.scss` takes the row badges down to 40/24 on this
	// page, with the reason written there: at 48 with a 28 glyph the tile and the mark read as a
	// square with something in it rather than as one object. A section mark a third larger than the
	// row marks beside it would be a second idea of what a tile is. The 32% radius is a percentage,
	// so it survives the smaller size without retuning.
	.section-header__badge {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		margin-bottom: 18px;
		border-radius: 32%;
		background: var(--badge-color, #{$color-brand});
		color: #fff;

		:global([data-icon]) {
			width: 24px;
			height: 24px;
		}
	}

	// The centred mark is the larger one. The note above explains why the row marks settled at
	// 40/24 — a section mark a third larger than the row marks beside it would be a second idea of
	// what a tile is — and that holds where the two are read together, down a column of rows. A
	// centred section header is not in that column: it opens a band of its own, with nothing beside
	// it to be compared against, and at 40 it read as a row mark that had wandered into the middle.
	// 56/32 keeps the glyph at the same 60% of the tile, so it is the same mark, larger.
	.section-header--center .section-header__badge {
		margin-inline: auto;
		width: 56px;
		height: 56px;

		:global([data-icon]) {
			width: 32px;
			height: 32px;
		}
	}

	.section-header {
		margin-bottom: $spacing-12;

		// Theme resolves through these rather than through a descendant selector
		// on the title. A page-level `#overflow h2 { color: … }` is (1,0,1) and
		// silently outranked `.section-header--dark .section-header__title`
		// (0,2,0), so `theme="dark"` rendered dark-on-dark with no error anywhere.
		// Custom properties inherit instead of competing, so the theme cannot be
		// out-specified by an ancestor-keyed rule again.
		--sh-title-color: var(--color-text);
		--sh-subtitle-color: var(--color-text);

		&--center {
			text-align: center;

			.section-header__subtitle {
				margin-left: auto;
				margin-right: auto;
			}
		}

		&--left {
			text-align: left;
		}

		&--right {
			text-align: right;

			.section-header__subtitle {
				margin-left: auto;
			}
		}

		&__title {
			@include type-section;
			margin-bottom: $spacing-5;
			color: var(--sh-title-color);
		}

		// `type-section` takes the title to 24px on a phone, one step over the 16px body under it.
		// Down a column of left-aligned headings that reads fine, because the alignment itself
		// marks the start of a section. A centred heading has no such edge to work with, and at
		// 1.5x the body it stopped reading as the thing the band is about. The next step on the
		// scale, not a number typed here — and only on the centred variant, so the left-aligned
		// headings keep the size they were set at.
		&--center .section-header__title {
			@include media-down(md) {
				font-size: $font-size-3xl;
			}
		}

		&__subtitle {
			@include type-body;
			max-width: 900px;
			margin: 0;
			color: var(--sh-subtitle-color);
		}

		// The three steps the title can take, each one a role from the ladder rather than a number
		// typed here. `--title-section` is the default and is left to `&__title` above.
		&--title-display .section-header__title {
			@include type-display;
		}

		&--title-title .section-header__title {
			@include type-title;
		}

		&--subtitle-copy .section-header__subtitle {
			// 65ch, matching the intro statement and the feature rows: one lede measure per page. The
			// component's own 900px runs to about 110 characters a line at this size.
			max-width: 65ch;
		}

		// A MEASURE, NOT A LINE COUNT, which is the only way to say this in CSS — there is no "wrap to
		// two lines". Cap the width and let the balancer choose the break.
		//
		// 640 is the middle of a wide plateau rather than a tuned number. This page's longest title sets
		// one line of 952 in a 960 container, filling it to within 8px, and anywhere from 560 to 700
		// gives the same two-line break — so 640 has ~80px of slack each way before a font or a copy
		// edit could flip it. Under ~540 it goes to three lines.
		//
		// `text-wrap: balance` is restated here rather than inherited. The homepage sets it on headings
		// from somewhere outside this component, and a cap without a balancer is worse than no cap: the
		// greedy break fills the first line and leaves a short tail, which is the shape this is meant to
		// fix.
		&--title-measure-headline .section-header__title {
			max-width: 640px;
			text-wrap: balance;
		}

		&--center.section-header--title-measure-headline .section-header__title {
			margin-inline: auto;
		}

		// Dark theme
		&--dark {
			--sh-title-color: #{$color-white};
			--sh-subtitle-color: #{$color-text-disabled};
		}
	}
</style>
