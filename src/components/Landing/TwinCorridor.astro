---
import { Icon } from 'astro-icon/components';
import TwinUnit from '@components/Landing/TwinUnit.astro';
import { DIGITAL_TWIN_STAGES, PHYSICAL_ASSET, TWIN, TWIN_FLOWS, TWIN_HISTORY } from '@data/digital-twin-visual';
import { segmentWidth, sparkPaths, sparkY } from '@util/sparkline';

/**
 * The twin composition with the connectors moved overhead. A CANDIDATE beside `DigitalTwin`, which
 * is untouched and still the row the home preview shows.
 *
 * --- the routing ---------------------------------------------------------------------------
 *
 * The shipped visual runs its connectors through a 96u gutter between the two cards and parks
 * their names in it. That gutter is a fixed track, so every unit in it comes straight off the
 * composition's width — and it is the one part of the picture with nothing in it.
 *
 * Here they leave the unit through its top and bottom edges, run up into the frame's own empty
 * space, and cross. The gutter then only has to be wide enough to be crossed: 96u -> 18u.
 *
 *     shipped    frame 242.7 | gutter 96 | twin 291.3     (measured)
 *     here       frame 258   | gutter 18 | twin 282
 *
 * Elbows, not the family's cubic curves. A curve is the right shape for a connector that leaves
 * and arrives horizontally; these leave vertically and arrive horizontally, and a 90-degree turn
 * drawn as a curve needs most of the corridor to make the bend. The stroke, the grey and the open
 * chevron are the family's, so the hand is the same even though the corner is square.
 *
 * Both connectors attach to CARD EDGES — the unit's top and bottom, the twin's left — and never to
 * a row inside a card. The version this replaces computed its endpoints from row centres, so every
 * content change moved an arrow. Here the card has been refilled twice without the drawing moving.
 *
 * --- what the twin says ----------------------------------------------------------------------
 *
 * The path sits ABOVE the name, as an address does: `Acme Inc > Warehouse 3`, then `CS-04 twin`.
 * An earlier cut had the ancestors listed under the title, which reads backwards — the child first
 * and its parents below it — and that inversion was most of why the hierarchy looked like metadata
 * rather than structure.
 *
 * `zone` is the other direction: the unit nested in a Zone B frame on the left AND Zone B as the
 * path's last step on the right, so the same containment is shown twice — once as geometry, once as
 * an address — and the comparison is what says the twin knows where the thing lives.
 *
 * Three devices against three attributes, in the same order down both cards: temp probe against
 * temperature, power meter against power, door sensor against door. The order is the argument —
 * the twin is not a list of readings, it is the same object seen from the other side.
 *
 * Each history takes the form of its kind, and the three shapes are deliberately unlike:
 *
 *   temperature   a spline in cold teal, because it is a continuous measurement
 *   power         straight segments in amber, because it switches — the plateaus ARE the compressor
 *   door          a violet segment band, which is how the platform's State chart draws `doorState`
 *
 * A hue each rather than three blues: the rows are three different KINDS of reading, and one colour
 * across all of them said they were three samples of the same thing.
 *
 * The power meter carries the compressor rather than a row of its own. A cut that gave the
 * compressor its own row had to show it as a duty cycle — 56 % over the day, one aggregate sitting
 * between two instantaneous readings, and a figure no device ever sends. Power draw is what the
 * meter actually reports, it is instantaneous like its neighbours, and because the compressor is
 * on or off the trace plateaus: the duty cycle is visible without being computed.
 *
 * All three derive from ONE series, so they cannot contradict each other: power is high while the
 * temperature falls, which is what makes it fall, and the door is open across two of the four warm
 * excursions. The other two are the defrost cycles the shared data describes.
 *
 * Deliberately still, as the shipped visual is: only the temperature reading ticks. The flow
 * visual carries the page's motion.
 */

interface Props {
	/**
	 * Show the zone on BOTH sides: the unit nested in a Zone B frame inside the site on the left,
	 * and Zone B as the last step of the path on the right.
	 *
	 * Off by default, which is the shorter reading — site on the left, site as the path's last step.
	 * On, the two halves show the same containment twice, once as geometry and once as an address,
	 * and the comparison is the argument. It costs the corridors about 19u each.
	 */
	zone?: boolean;
}

const { zone = false } = Astro.props;

// --- content ------------------------------------------------------------------------------

const SITE = { name: PHYSICAL_ASSET.path[0], icon: 'tabler:building-warehouse' };
const ZONE = { name: PHYSICAL_ASSET.path[1], icon: 'tabler:map-pin' };

/**
 * The hierarchy the twin knows, root first, as a path over the name. No glyphs: icons in a row at
 * this size read as decoration, and the separators already say it is a path.
 *
 * The path goes exactly as deep as the left side does, so the two halves are describing the same
 * containment rather than two different ones.
 */
const PATH = zone ? ['Acme Inc', ...PHYSICAL_ASSET.path] : ['Acme Inc', SITE.name];

/**
 * Three devices, in the twin's own row order. Picked by label rather than sliced, so the pairing
 * is stated here and a rename in the data file fails loudly instead of quietly shuffling the rows.
 */
const DEVICE_ORDER = ['Temp probe', 'Power meter', 'Door sensor'];
const UNIT = {
	name: PHYSICAL_ASSET.name,
	icon: PHYSICAL_ASSET.icon,
	devices: DEVICE_ORDER.map((label) => {
		const device = PHYSICAL_ASSET.devices.find((d) => d.label === label);
		if (!device) throw new Error(`TwinCorridor: no device named "${label}" in PHYSICAL_ASSET`);
		return device;
	}),
};

const telemetry = TWIN_FLOWS.find((f) => f.to === 'twin');
const commands = TWIN_FLOWS.find((f) => f.to === 'physical');

const attr = (key: string) => TWIN.attributes.find((a) => a.key === key)?.value ?? '';

// --- the day ------------------------------------------------------------------------------
//
// A full day at half-hourly samples, on the data file's own formula and domain: a slow cycle, a
// faster wobble, and a warm excursion every six hours. Generated here rather than taken from
// `TWIN_HISTORY.series` because that series stops at 16:00 on purpose — the shipped chart labels
// its axis and the empty remainder is what says where in the day we are. These rows carry no axis,
// so an empty right third would read as a chart that failed to load.

const TAU = Math.PI * 2;
const STEP_H = 0.5;
const STEPS = TWIN_HISTORY.hours / STEP_H;

// The window is the last 24 hours, so it ends NOW rather than at midnight — and where in the
// compressor's cycle "now" falls decides what the power row says. Starting an hour in is the
// nearest offset that ends mid-run, so the value reads 2.4 kW instead of the 0.3 kW standing load,
// and the temperature lands at -18.7, inside the loop the reading ticks through. Four runs across
// the day either way.
const START_H = 1;

const bump = (t: number) => Math.pow(Math.max(0, Math.sin((TAU * t) / 6)), 6);
const tempAt = (t: number) =>
	-18.3 + 0.9 * Math.sin((TAU * t) / 9 + 0.6) + 0.3 * Math.sin((TAU * t) / 2.3) + 1.1 * bump(t);

const SERIES = Array.from({ length: STEPS + 1 }, (_, i) => Math.round(tempAt(START_H + i * STEP_H) * 100) / 100);

/**
 * The compressor runs while the box is getting colder — that is what makes it colder — and it is
 * the compressor that the power meter is mostly measuring.
 *
 * Read off a 5-sample mean rather than the raw series, and that is a simplification worth naming. A
 * real thermostat clicks every half hour or so, and drawn honestly this came out as two dozen equal
 * pulses — a barcode, which is texture rather than a reading. Smoothing past the fast wobble leaves
 * the shape of the day: a handful of long runs, which is what the row is for.
 */
const WINDOW = 5;
const smooth = (i: number) => {
	const lo = Math.max(0, i - (WINDOW >> 1));
	const hi = Math.min(SERIES.length - 1, i + (WINDOW >> 1));
	let sum = 0;
	for (let j = lo; j <= hi; j++) sum += SERIES[j];
	return sum / (hi - lo + 1);
};
const RUNNING = Array.from({ length: STEPS }, (_, i) => smooth(i + 1) < smooth(i));

/** Standing load — fans, lights, controls — plus the compressor when it is on. */
const IDLE_KW = 0.35;
const RUN_KW = 2.4;
const POWER = Array.from({ length: STEPS + 1 }, (_, i) => {
	const on = RUNNING[Math.min(i, STEPS - 1)];
	return Math.round(((on ? RUN_KW : IDLE_KW) + 0.05 * Math.sin(i * 1.7)) * 100) / 100;
});

/**
 * The door is open across the two largest warm excursions. `bump` peaks four times a day; two of
 * those are somebody opening the door and two are the defrost cycle the data file describes, which
 * is why this takes every other one.
 */
const DOOR_OPEN = Array.from({ length: STEPS }, (_, i) => {
	const t = START_H + i * STEP_H;
	return bump(t) > 0.55 && Math.floor(t / 6) % 2 === 1;
});

/** Contiguous runs of `true`, as percentages of the band's width. */
const spans = (flags: boolean[]) => {
	const out: { x: number; w: number }[] = [];
	for (let i = 0; i < flags.length; i++) {
		if (!flags[i]) continue;
		const start = i;
		while (flags[i + 1]) i++;
		out.push({ x: (start / flags.length) * 100, w: ((i - start + 1) / flags.length) * 100 });
	}
	return out;
};

const DOOR_SPANS = spans(DOOR_OPEN);

const CHART_H = 30;
const BAND_H = 12;

const TEMP_VIEW = { w: 100, h: CHART_H, pad: 0 };
const temp = sparkPaths(SERIES, TWIN_HISTORY.domain, TEMP_VIEW);

// Straight segments rather than the spline the temperature uses. A Catmull-Rom curve through a
// switching signal rounds every edge and overshoots after it, which would draw a compressor that
// eases in and coasts out. It does neither.
const POWER_VIEW = { w: 100, h: CHART_H, pad: 0 };
const POWER_DOMAIN: [number, number] = [0, 3];
const POWER_SEG = segmentWidth(POWER.length, POWER_VIEW);
const powerPts = POWER.map((v, i) => `${(i * POWER_SEG).toFixed(2)},${sparkY(v, POWER_DOMAIN, POWER_VIEW).toFixed(2)}`);
const power = {
	line: `M ${powerPts.join(' L ')}`,
	area: `M ${powerPts.join(' L ')} L ${POWER_VIEW.w},${POWER_VIEW.h} L 0,${POWER_VIEW.h} Z`,
};

// --- geometry -----------------------------------------------------------------------------

const NATIVE = 558;
const COL = { site: 258, gut: 18, twin: 282 };

// The shipped composition's body, measured in the browser at the sandbox row: 337.6u. Held, so the
// two can be laid over each other and the footprint compared rather than argued.
const BODY = 338;

const FRAME_PAD = 12;
const HEAD_H = 24; // the site's own name, on the frame's top line

// TwinUnit's metrics, mirrored so the arrows can be aimed. Its head band is 12 + 22 + 12; its rows
// are 8 + 22 + 8 rather than the 8 + 26 + 8 it ships, because the type overrides at the foot of
// this file bring its line height down to the twin's.
const UNIT_HEAD_H = 46;
const UNIT_ROW_H = 38;
const UNIT_H = UNIT_HEAD_H + UNIT.devices.length * UNIT_ROW_H;

// The twin's header: the path, a clear gap, then the name. The name sits in a band the size of the
// unit's own head — 12 + 22 + 12 — so the two cards are headed alike, with the path as the one
// thing the twin has and the unit does not.
const TWIN_HEAD_H = 80;

// The zone frame, when the unit is nested one level deeper. It runs from below the telemetry line
// all the way to the frame's bottom padding, so the commands connector and its name are INSIDE the
// zone rather than under it — the arrow is in the room it is addressing.
const ZONE_TOP = 88;
const ZONE_PAD = 12;
const ZONE_HEAD = 18;
const ZONE_GAP = 4;
const ZONE_H = BODY - FRAME_PAD - ZONE_TOP;

// The height budget, top to bottom: padding, the site's name, the telemetry corridor, the unit (or
// the zone frame holding it), the commands corridor, padding. Whatever the block in the middle
// takes, the corridors get the rest — which is why the unit holds three devices and not four.
const TOP_CORRIDOR = 70;
const UNIT_TOP = zone ? ZONE_TOP + ZONE_PAD + ZONE_HEAD + ZONE_GAP : FRAME_PAD + HEAD_H + TOP_CORRIDOR;
const UNIT_BOT = UNIT_TOP + UNIT_H;
const BLOCK_GAP = (zone ? ZONE_TOP : UNIT_TOP) - FRAME_PAD - HEAD_H;

// The telemetry run lands on the twin's header band, at its lower edge: the line points at what the
// card IS before it points at what the card reads. Everything on the left hangs below it with room
// for the corner, and nested, the riser crosses the zone's own border on the way — the unit is what
// talks, not the room it stands in, so both ends sit on the unit's edges either way.
const UP_Y = TWIN_HEAD_H;
const DOWN_Y = UNIT_BOT + (zone ? 14 : 22);

// Far enough from its run to read as a caption rather than as part of the line. Nested, the
// commands name sits inside the zone and has its floor to clear as well, so it rides closer.
const LABEL_GAP = zone ? 16 : 22;

// Both risers stand on the unit's centre line. Collinear on purpose — one above the card and one
// below it, so the pair reads as a single axis the unit sits on rather than as two stray lines.
const UNIT_X = FRAME_PAD + (COL.site - FRAME_PAD * 2) / 2;
const TWIN_X = COL.site + COL.gut;

// Halfway between the unit's centre line and the frame's edge, so a name sits over its own run
// rather than over the card it came from.
const LABEL_X = (UNIT_X + COL.site) / 2;

const R = 12; // corner radius
const HEAD = 8;
const WING = 5;

// Quadratic corners: the control point is the corner itself, so the radius cannot disagree with
// where the straight runs end.
const wires = {
	up: `M ${UNIT_X},${UNIT_TOP} L ${UNIT_X},${UP_Y + R} Q ${UNIT_X},${UP_Y} ${UNIT_X + R},${UP_Y} L ${TWIN_X},${UP_Y}`,
	upHead: `M ${TWIN_X - HEAD},${UP_Y - WING} L ${TWIN_X},${UP_Y} L ${TWIN_X - HEAD},${UP_Y + WING}`,
	down: `M ${TWIN_X},${DOWN_Y} L ${UNIT_X + R},${DOWN_Y} Q ${UNIT_X},${DOWN_Y} ${UNIT_X},${DOWN_Y - R} L ${UNIT_X},${UNIT_BOT}`,
	downHead: `M ${UNIT_X - WING},${UNIT_BOT + HEAD} L ${UNIT_X},${UNIT_BOT} L ${UNIT_X + WING},${UNIT_BOT + HEAD}`,
};

/**
 * The twin's height budget: a 66u header, then 98 + 98 + 62 of rows, then 14u of padding under the
 * last one — 338, the frame's own height. Set here and spent in the CSS below, so a row that
 * outgrows its band shows as an overflow rather than by quietly pushing the card past the frame.
 */
const CARD_PAD_B = 14;

/**
 * A hue each, from the accents `ConnectCloud` already uses, rather than three blues at different
 * opacities. They are doing a job: the three rows are three different KINDS of reading, and one
 * colour across all of them said they were three samples of the same thing.
 *
 * Cold for the temperature, energy for the power, and the family's violet — the twin's own badge
 * colour — for the door, which is the one that is a state rather than a measurement.
 */
const ROWS = [
	{ key: 'temperature', value: attr('temperature'), h: 90, kind: 'spline', accent: '#0e7490' },
	{ key: 'power', value: `${POWER[POWER.length - 1].toFixed(1)} kW`, h: 90, kind: 'steps', accent: '#b45309' },
	{ key: 'door', value: attr('door'), h: 64, kind: 'band', accent: '#7b3fe4' },
];

/** As a share of the body's box, so a name tracks the drawing and not the grid. */
const at = (x: number, y: number) => `--x: ${((x / NATIVE) * 100).toFixed(3)}%; --y: ${((y / BODY) * 100).toFixed(3)}%`;

const vars = [
	`--tc-u: clamp(0.45px, calc(100cqw / ${NATIVE}), 1.15px)`,
	`--tc-native: ${NATIVE}`,
	`--tc-site: ${COL.site}`,
	`--tc-gut: ${COL.gut}`,
	`--tc-twin: ${COL.twin}`,
	`--tc-body: ${BODY}`,
	`--tc-pad: ${FRAME_PAD}`,
	`--tc-head: ${HEAD_H}`,
	`--tc-block-gap: ${BLOCK_GAP}`,
	`--tc-zone-gap: ${ZONE_GAP}`,
	`--tc-zone-pad: ${ZONE_PAD}`,
	`--tc-zone-head: ${ZONE_HEAD}`,
	`--tc-zone-h: ${ZONE_H}`,
	`--tc-twin-head: ${TWIN_HEAD_H}`,
	`--tc-unit-h: ${UNIT_H}`,
	`--tc-chart-h: ${CHART_H}`,
	`--tc-band-h: ${BAND_H}`,
	`--tc-card-pad-b: ${CARD_PAD_B}`,
	// One pixel per card border the risers cross on their way to the unit's edge: the site frame
	// always, and the zone frame as well when the unit is nested inside one.
	`--tc-nudge: ${zone ? 2 : 1}px`,
].join(';');
---

<div class="tc-fit">
	<div class="tc" style={vars} data-twin-corridor>
		<p class="tc__stage">{DIGITAL_TWIN_STAGES.physical}</p>
		<p class="tc__stage tc__stage--right">{DIGITAL_TWIN_STAGES.twin}</p>

		<div class="tc__body">
			{
				/* --- the real thing, in its place ----------------------------------------------
			    The frame is the scope and its top line names it. The space under that line is not
			    padding — it is the corridor the telemetry runs through, which is the whole trade
			    this candidate makes. */
			}
			<div class:list={['tc__site', zone && 'tc__site--open']}>
				<p class="tc__site-name">
					<Icon name={SITE.icon} aria-hidden="true" />
					<span>{SITE.name}</span>
				</p>
				{
					zone ? (
						<div class="tc__zone">
							<p class="tc__zone-name">
								<Icon name={ZONE.icon} aria-hidden="true" />
								<span>{ZONE.name}</span>
							</p>
							<TwinUnit unit={UNIT} class="tc__unit" />
						</div>
					) : (
						<TwinUnit unit={UNIT} class="tc__unit" />
					)
				}
			</div>

			{/* --- its twin ------------------------------------------------------------------ */}
			<div class="tc__card">
				<header class="tc__head">
					{/* The address, over the name. Read down, it is the platform's own path to this object. */}
					<p class="tc__path">
						{
							PATH.map((step, i) => (
								<Fragment>
									{i > 0 && (
										<span class="tc__sep" aria-hidden="true">
											›
										</span>
									)}
									<span>{step}</span>
								</Fragment>
							))
						}
					</p>
					<p class="tc__name">
						<Icon name="tabler:box-model" aria-hidden="true" />
						<span>{TWIN.name}</span>
					</p>
				</header>

				<ul class="tc__attrs">
					{
						ROWS.map((row) => (
							<li class="tc__attr" style={`--h: ${row.h}; --accent: ${row.accent}`} data-twin-attr={row.key}>
								<span class="tc__k">{row.key}</span>
								<span class="tc__v">{row.value}</span>

								{row.kind === 'band' ? (
									<span class="tc__band">
										<svg viewBox={`0 0 100 ${BAND_H}`} preserveAspectRatio="none" aria-hidden="true">
											<rect class="tc__band-off" x="0" y="0" width="100" height={BAND_H} />
											{DOOR_SPANS.map((s) => (
												<rect class="tc__band-on" x={s.x} y="0" width={s.w} height={BAND_H} />
											))}
										</svg>
									</span>
								) : (
									<span class="tc__chart">
										<svg viewBox={`0 0 100 ${CHART_H}`} preserveAspectRatio="none" aria-hidden="true">
											<path class="tc__chart-area" d={row.kind === 'steps' ? power.area : temp.area} />
											<path class="tc__chart-line" d={row.kind === 'steps' ? power.line : temp.line} />
										</svg>
									</span>
								)}
							</li>
						))
					}
				</ul>
			</div>

			{
				/* --- what crosses ---------------------------------------------------------------
			    One layer over the whole body rather than an oversized item in the gutter track: the
			    paths are then written in the composition's own coordinates, and no endpoint depends
			    on which track it happens to be over. */
			}
			<svg
				class="tc__wires"
				viewBox={`0 0 ${NATIVE} ${BODY}`}
				preserveAspectRatio="none"
				aria-hidden="true"
				focusable="false"
			>
				<path class="tc__wire" d={wires.up}></path>
				<path class="tc__wire tc__wire--head" d={wires.upHead}></path>
				<path class="tc__wire" d={wires.down}></path>
				<path class="tc__wire tc__wire--head" d={wires.downHead}></path>
			</svg>

			<span class="tc__flow-name" style={at(LABEL_X, UP_Y - LABEL_GAP)}>{telemetry?.label}</span>
			<span class="tc__flow-name" style={at(LABEL_X, DOWN_Y + LABEL_GAP)}>{commands?.label}</span>
		</div>
	</div>
</div>

<script>
	/**
	 * The one thing that moves, as in the shipped visual: the temperature reading steps through a
	 * short precalculated loop, only while on screen. The histories underneath do not follow it —
	 * they are the day, and the day does not change every three seconds.
	 */
	const BEAT_MS = 3000;
	const TEMPS = [-18.4, -18.2, -18.6, -18.3, -18.7, -18.1];

	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll<HTMLElement>('[data-twin-corridor]').forEach((root) => {
		if (reduce) return;
		const temp = root.querySelector<HTMLElement>('[data-twin-attr="temperature"] .tc__v');
		if (!temp) return;

		let beat = 0;
		let visible = false;
		let timer = 0;

		const tick = () => {
			if (!visible) return;
			beat++;
			temp.textContent = `−${Math.abs(TEMPS[beat % TEMPS.length]).toFixed(1)} °C`;
			timer = window.setTimeout(tick, BEAT_MS);
		};

		new IntersectionObserver(
			(entries) => {
				visible = entries.some((e) => e.isIntersecting);
				clearTimeout(timer);
				if (visible) timer = window.setTimeout(tick, BEAT_MS);
			},
			{ rootMargin: '80px' }
		).observe(root);
	});
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	.tc-fit {
		container-type: inline-size;
	}

	.tc {
		--u: var(--tc-u);
		// TwinUnit reads this one; it is the family's unit under its family name.
		--flow-u: var(--tc-u);
		display: grid;
		grid-template-columns: u(var(--tc-site)) u(var(--tc-gut)) u(var(--tc-twin));
		justify-content: center;
		max-width: u(var(--tc-native));
		margin: 0 auto;
	}

	.tc__stage {
		grid-column: 1;
		min-height: u(24);
		margin: 0 0 u(8);
		font-size: u(15);
		line-height: u(24);
		text-align: center;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		white-space: nowrap;
		color: var(--color-text-secondary, #5b616e);
	}

	.tc__stage--right {
		grid-column: 3;
	}

	// The drawing's own box: everything below the stage names is positioned in it, and the wire
	// layer covers exactly it, so a path coordinate and a grid column are the same coordinate.
	.tc__body {
		position: relative;
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: u(var(--tc-site)) u(var(--tc-gut)) u(var(--tc-twin));
		height: u(var(--tc-body));
	}

	// --- the site frame -------------------------------------------------------------

	// With a zone inside it the fill goes: two filled areas, one inside the other, read as two
	// surfaces rather than as containment. The outline and its name are enough to say "warehouse",
	// and the striped zone is then the only thing with a texture.
	.tc__site--open {
		background: none;
	}

	.tc__site {
		grid-column: 1;
		padding: u(var(--tc-pad));
		border: 1px solid var(--color-border, #ebebeb);
		// The cards' own radius, so the frame is one more card and not a different kind of shape.
		border-radius: u(var(--flow-radius, 8));
		background: var(--color-bg-light, #f7f9fc);
	}

	.tc__site-name {
		display: flex;
		align-items: center;
		gap: u(8);
		height: u(var(--tc-head));
		margin: 0;
		font-size: u(15);
		font-weight: $font-weight-medium;
		line-height: u(22);
		white-space: nowrap;
		color: var(--color-text-secondary, #5b616e);

		[data-icon] {
			flex: none;
