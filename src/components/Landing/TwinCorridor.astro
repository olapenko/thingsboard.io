	.tc__zone {
		height: u(var(--tc-zone-h));
		margin-top: u(var(--tc-block-gap));
		padding: u(var(--tc-zone-pad));
		border: 1px solid var(--color-border, #ebebeb);
		border-radius: u(var(--flow-radius, 8));
		background: repeating-linear-gradient(
