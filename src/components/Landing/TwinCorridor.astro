---
import { Icon } from 'astro-icon/components';
import TwinUnit from '@components/Landing/TwinUnit.astro';
import { DIGITAL_TWIN_STAGES, PHYSICAL_ASSET, TWIN, TWIN_FLOWS, TWIN_HISTORY } from '@data/digital-twin-visual';
import { sparkPaths } from '@util/sparkline';

/**
 * The twin composition with the connectors moved overhead. A CANDIDATE beside `DigitalTwin`, which
 * is untouched and still the row the home preview shows.
 *
 * --- the routing ---------------------------------------------------------------------------
 *
 * The shipped visual runs its connectors through a 96u gutter between the two cards and parks
 * their names in it. That gutter is a fixed track, so every unit in it comes straight off the
 * composition's width — and it is the one part of the picture with nothing in it.
 *
 * Here they leave the unit through its top and bottom edges, run up into the frame's own empty
 * space, and cross. The gutter then only has to be wide enough to be crossed: 96u -> 18u.
 *
 *     shipped    frame 242.7 | gutter 96 | twin 291.3     (measured)
 *     here       frame 289   | gutter 18 | twin 283
 *
 * Elbows, not the family's cubic curves. A curve is the right shape for a connector that leaves
 * and arrives horizontally; these leave vertically and arrive horizontally, and a 90-degree turn
 * drawn as a curve needs most of the corridor to make the bend. The stroke, the grey and the open
 * chevron are the family's, so the hand is the same even though the corner is square.
 *
 * Both connectors attach to CARD EDGES — the unit's top and bottom, the twin's left — and never to
 * a row inside a card. The version this replaces computed its endpoints from row centres, so every
 * content change moved an arrow. Here the rows below were added without touching the drawing.
 *
 * --- the parity ----------------------------------------------------------------------------
 *
 * Three devices against three attributes, in the same order down both cards: temp probe against
 * temperature, compressor against compressor, door sensor against door. The order is the argument
 * — the twin is not a list of readings, it is the same object seen from the other side.
 *
 * Each attribute carries its own history, and the form says what KIND of thing it is: temperature
 * is a measurement, so a line; compressor and door are states, so a segment band, which is how the
 * platform's own State chart draws `doorState` and the like.
 *
 * The three histories are derived from ONE series so they cannot contradict each other. The
 * compressor runs while the temperature is falling — that is what makes it fall — and its duty
 * figure is counted off the band it draws, not typed in beside it. Two of the four warm excursions
 * have the door open across them; the other two are the defrost cycles the shared data describes.
 *
 * Deliberately still, as the shipped visual is: only the temperature reading ticks. The flow
 * visual carries the page's motion.
 */

// --- content ------------------------------------------------------------------------------

const SITE = { name: PHYSICAL_ASSET.path[0], icon: 'tabler:building-warehouse' };

/**
 * The hierarchy the twin knows, root first. The frame on the left says where the unit physically
 * sits; this says the same thing as something the platform models, which is the difference the
 * copy beside the visual is promising.
 */
const TREE = [
	{ name: 'Acme Inc', icon: 'tabler:building' },
	{ name: PHYSICAL_ASSET.path[0], icon: 'tabler:building-warehouse' },
	{ name: PHYSICAL_ASSET.path[1], icon: 'tabler:map-pin' },
];

/**
 * Three devices, in the twin's own row order. Picked by label rather than sliced, so the pairing
 * is stated here and a rename in the data file fails loudly instead of quietly shuffling the rows.
 */
const DEVICE_ORDER = ['Temp probe', 'Compressor', 'Door sensor'];
const UNIT = {
	name: PHYSICAL_ASSET.name,
	icon: PHYSICAL_ASSET.icon,
	devices: DEVICE_ORDER.map((label) => {
		const device = PHYSICAL_ASSET.devices.find((d) => d.label === label);
		if (!device) throw new Error(`TwinCorridor: no device named "${label}" in PHYSICAL_ASSET`);
		return device;
	}),
};

const telemetry = TWIN_FLOWS.find((f) => f.to === 'twin');
const commands = TWIN_FLOWS.find((f) => f.to === 'physical');

const attr = (key: string) => TWIN.attributes.find((a) => a.key === key)?.value ?? '';

// --- the day ------------------------------------------------------------------------------
//
// A full day at half-hourly samples, on the data file's own formula and domain: a slow cycle, a
// faster wobble, and a warm excursion every six hours. Generated here rather than taken from
// `TWIN_HISTORY.series` because that series stops at 16:00 on purpose — the shipped chart labels
// its axis and the empty remainder is what says where in the day we are. These rows carry no axis,
// so an empty right third would read as a chart that failed to load.

const TAU = Math.PI * 2;
const STEP_H = 0.5;
const STEPS = TWIN_HISTORY.hours / STEP_H;

const bump = (t: number) => Math.pow(Math.max(0, Math.sin((TAU * t) / 6)), 6);
const tempAt = (t: number) =>
	-18.3 + 0.9 * Math.sin((TAU * t) / 9 + 0.6) + 0.3 * Math.sin((TAU * t) / 2.3) + 1.1 * bump(t);

const SERIES = Array.from({ length: STEPS + 1 }, (_, i) => Math.round(tempAt(i * STEP_H) * 100) / 100);

/**
 * The compressor runs while the box is getting colder. Derived from the series rather than invented
 * beside it, so the band and the line cannot tell different stories: every stretch of solid is a
 * stretch where the temperature falls.
 *
 * Read off a 5-sample mean rather than the raw series, and that is a simplification worth naming. A
 * real thermostat clicks every half hour or so, and drawn honestly this band came out as 24 equal
 * stripes — a barcode, which is texture rather than a state. Smoothing past the fast wobble leaves
 * the shape of the day: a handful of long runs, which is what the row is for.
 */
const WINDOW = 5;
const smooth = (i: number) => {
	const lo = Math.max(0, i - (WINDOW >> 1));
	const hi = Math.min(SERIES.length - 1, i + (WINDOW >> 1));
	let sum = 0;
	for (let j = lo; j <= hi; j++) sum += SERIES[j];
	return sum / (hi - lo + 1);
};
const RUNNING = Array.from({ length: STEPS }, (_, i) => smooth(i + 1) < smooth(i));

/**
 * The door is open across the two largest warm excursions. `bump` peaks four times a day; two of
 * those are somebody opening the door and two are the defrost cycle the data file describes, which
 * is why this takes every other one.
 */
const DOOR_OPEN = Array.from({ length: STEPS }, (_, i) => {
	const t = i * STEP_H;
	return bump(t) > 0.55 && Math.floor(t / 6) % 2 === 1;
});

/** Counted off the band, so the figure beside it and the picture under it agree by construction. */
const DUTY = Math.round((RUNNING.filter(Boolean).length / STEPS) * 100);

/** Contiguous runs of `true`, as percentages of the band's width. */
const spans = (flags: boolean[]) => {
	const out: { x: number; w: number }[] = [];
	for (let i = 0; i < flags.length; i++) {
		if (!flags[i]) continue;
		const start = i;
		while (flags[i + 1]) i++;
		out.push({ x: (start / flags.length) * 100, w: ((i - start + 1) / flags.length) * 100 });
	}
	return out;
};

const RUN_SPANS = spans(RUNNING);
const DOOR_SPANS = spans(DOOR_OPEN);

const SPARK_VIEW = { w: 100, h: 34, pad: 0 };
const spark = sparkPaths(SERIES, TWIN_HISTORY.domain, SPARK_VIEW);

const BAND_H = 20;

// --- geometry -----------------------------------------------------------------------------

const NATIVE = 590;
const COL = { site: 289, gut: 18, twin: 283 };

// The shipped composition's body, measured in the browser at the sandbox row: 337.6u. Held, so the
// two can be laid over each other and the footprint compared rather than argued.
const BODY = 338;

const FRAME_PAD = 12;
const HEAD_H = 24; // the site's own name, on the frame's top line

// TwinUnit's metrics, mirrored so the arrows can be aimed: 12 + 22 + 12 for the head band,
// 8 + 26 + 8 for a device row.
const UNIT_HEAD_H = 46;
const UNIT_ROW_H = 42;
const UNIT_H = UNIT_HEAD_H + UNIT.devices.length * UNIT_ROW_H;

// The height budget, top to bottom: padding, the site's name, the telemetry corridor, the unit,
// the commands corridor, padding. The unit takes what the corridors leave, which is why it holds
// three devices and not four — a fourth row is 42u and the corridor above it is 40u.
const UNIT_TOP = 76;
const UNIT_BOT = UNIT_TOP + UNIT_H;
const UNIT_GAP = UNIT_TOP - FRAME_PAD - HEAD_H;

// The two flat runs. Above: clear of the site's name by 14u. Below: 40u under the unit, which
// leaves the commands name a band of its own before the frame's bottom padding.
const UP_Y = 50;
const DOWN_Y = 288;

// Both risers stand on the unit's centre line. Collinear on purpose — one above the card and one
// below it, so the pair reads as a single axis the unit sits on rather than as two stray lines.
const UNIT_X = FRAME_PAD + (COL.site - FRAME_PAD * 2) / 2;
const TWIN_X = COL.site + COL.gut;

const R = 12; // corner radius
const HEAD = 8;
const WING = 5;

// Quadratic corners: the control point is the corner itself, so the radius cannot disagree with
// where the straight runs end.
const wires = {
	up: `M ${UNIT_X},${UNIT_TOP} L ${UNIT_X},${UP_Y + R} Q ${UNIT_X},${UP_Y} ${UNIT_X + R},${UP_Y} L ${TWIN_X},${UP_Y}`,
	upHead: `M ${TWIN_X - HEAD},${UP_Y - WING} L ${TWIN_X},${UP_Y} L ${TWIN_X - HEAD},${UP_Y + WING}`,
	down: `M ${TWIN_X},${DOWN_Y} L ${UNIT_X + R},${DOWN_Y} Q ${UNIT_X},${DOWN_Y} ${UNIT_X},${DOWN_Y - R} L ${UNIT_X},${UNIT_BOT}`,
	downHead: `M ${UNIT_X - WING},${UNIT_BOT + HEAD} L ${UNIT_X},${UNIT_BOT} L ${UNIT_X + WING},${UNIT_BOT + HEAD}`,
};

/**
 * The twin's height budget: 46 + 76 + 80 + 68 + 68 = 338, the frame's own height. Set here and
 * spent in the CSS below, so a row that outgrows its band shows as an overflow — something you can
 * see — rather than by quietly pushing the card past the frame.
 */
const ROWS = [
	{ key: 'temperature', value: attr('temperature'), h: 80 },
	{ key: 'compressor', value: `${DUTY} %`, h: 68 },
	{ key: 'door', value: attr('door'), h: 68 },
];

/** As a share of the body's box, so a name tracks the drawing and not the grid. */
const at = (x: number, y: number) => `--x: ${((x / NATIVE) * 100).toFixed(3)}%; --y: ${((y / BODY) * 100).toFixed(3)}%`;

const vars = [
	`--tc-u: clamp(0.45px, calc(100cqw / ${NATIVE}), 1.15px)`,
	`--tc-native: ${NATIVE}`,
	`--tc-site: ${COL.site}`,
	`--tc-gut: ${COL.gut}`,
	`--tc-twin: ${COL.twin}`,
	`--tc-body: ${BODY}`,
	`--tc-pad: ${FRAME_PAD}`,
	`--tc-head: ${HEAD_H}`,
	`--tc-unit-gap: ${UNIT_GAP}`,
	`--tc-unit-h: ${UNIT_H}`,
	`--tc-spark-h: ${SPARK_VIEW.h}`,
	`--tc-band-h: ${BAND_H}`,
].join(';');
---

<div class="tc-fit">
	<div class="tc" style={vars} data-twin-corridor>
		<p class="tc__stage">{DIGITAL_TWIN_STAGES.physical}</p>
		<p class="tc__stage tc__stage--right">{DIGITAL_TWIN_STAGES.twin}</p>

		<div class="tc__body">
			{
				/* --- the real thing, in its place ----------------------------------------------
			    The frame is the scope and its top line names it. The space under that line is not
			    padding — it is the corridor the telemetry runs through, which is the whole trade
			    this candidate makes. */
			}
			<div class="tc__site">
				<p class="tc__site-name">
					<Icon name={SITE.icon} aria-hidden="true" />
					<span>{SITE.name}</span>
				</p>
				<TwinUnit unit={UNIT} class="tc__unit" />
			</div>

			{/* --- its twin ------------------------------------------------------------------ */}
			<div class="tc__card">
				<header class="tc__head">
					<Icon name="tabler:box-model" aria-hidden="true" />
					<span class="tc__name">{TWIN.name}</span>
				</header>

				{
					/* The hierarchy, drawn rather than named: each level hangs off the one above on an
				    elbow, so the picture shows a tree where the copy says "hierarchies". */
				}
				<ol class="tc__tree">
					{
						TREE.map((node, i) => (
							<li class="tc__node" style={`--depth: ${i}`}>
								{i > 0 && <i class="tc__branch" aria-hidden="true" />}
								<Icon name={node.icon} aria-hidden="true" />
								<span>{node.name}</span>
							</li>
						))
					}
				</ol>

				<ul class="tc__attrs">
					{
						ROWS.map((row) => (
							<li class="tc__attr" style={`--h: ${row.h}`} data-twin-attr={row.key}>
								<span class="tc__k">{row.key}</span>
								<span class="tc__v">{row.value}</span>

								{row.key === 'temperature' ? (
									<span class="tc__spark">
										<svg viewBox={`0 0 ${SPARK_VIEW.w} ${SPARK_VIEW.h}`} preserveAspectRatio="none" aria-hidden="true">
											<path class="tc__spark-area" d={spark.area} />
											<path class="tc__spark-line" d={spark.line} />
										</svg>
									</span>
								) : (
									/* A state's history is a band of segments, not a line: the platform's own State
								   chart draws `doorState` and the like this way, and a band keeps its meaning at a
								   size where a square wave's pulses would disappear. */
									<span class="tc__band">
										<svg viewBox={`0 0 100 ${BAND_H}`} preserveAspectRatio="none" aria-hidden="true">
											<rect class="tc__band-off" x="0" y="0" width="100" height={BAND_H} />
											{(row.key === 'compressor' ? RUN_SPANS : DOOR_SPANS).map((s) => (
												<rect class="tc__band-on" x={s.x} y="0" width={s.w} height={BAND_H} />
											))}
										</svg>
									</span>
								)}
							</li>
						))
					}
				</ul>
			</div>

			{
				/* --- what crosses ---------------------------------------------------------------
			    One layer over the whole body rather than an oversized item in the gutter track: the
			    paths are then written in the composition's own coordinates, and no endpoint depends
			    on which track it happens to be over. */
			}
			<svg
				class="tc__wires"
				viewBox={`0 0 ${NATIVE} ${BODY}`}
				preserveAspectRatio="none"
				aria-hidden="true"
				focusable="false"
			>
				<path class="tc__wire" d={wires.up}></path>
				<path class="tc__wire tc__wire--head" d={wires.upHead}></path>
				<path class="tc__wire" d={wires.down}></path>
				<path class="tc__wire tc__wire--head" d={wires.downHead}></path>
			</svg>

			<span class="tc__flow-name" style={at(230, 34)}>{telemetry?.label}</span>
			<span class="tc__flow-name" style={at(230, 306)}>{commands?.label}</span>
		</div>
	</div>
</div>

<script>
	/**
	 * The one thing that moves, as in the shipped visual: the temperature reading steps through a
	 * short precalculated loop, only while on screen. The histories underneath do not follow it —
	 * they are the day, and the day does not change every three seconds.
	 */
	const BEAT_MS = 3000;
	const TEMPS = [-18.4, -18.2, -18.6, -18.3, -18.7, -18.1];

	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll<HTMLElement>('[data-twin-corridor]').forEach((root) => {
		if (reduce) return;
		const temp = root.querySelector<HTMLElement>('[data-twin-attr="temperature"] .tc__v');
		if (!temp) return;

		let beat = 0;
		let visible = false;
		let timer = 0;

		const tick = () => {
			if (!visible) return;
			beat++;
			temp.textContent = `−${Math.abs(TEMPS[beat % TEMPS.length]).toFixed(1)} °C`;
			timer = window.setTimeout(tick, BEAT_MS);
		};

		new IntersectionObserver(
			(entries) => {
				visible = entries.some((e) => e.isIntersecting);
				clearTimeout(timer);
				if (visible) timer = window.setTimeout(tick, BEAT_MS);
			},
			{ rootMargin: '80px' }
		).observe(root);
	});
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	.tc-fit {
		container-type: inline-size;
	}

	.tc {
		--u: var(--tc-u);
		// TwinUnit reads this one; it is the family's unit under its family name.
		--flow-u: var(--tc-u);
		display: grid;
		grid-template-columns: u(var(--tc-site)) u(var(--tc-gut)) u(var(--tc-twin));
		justify-content: center;
		max-width: u(var(--tc-native));
		margin: 0 auto;
	}

	.tc__stage {
		grid-column: 1;
		min-height: u(24);
		margin: 0 0 u(8);
		font-size: u(15);
		line-height: u(24);
		text-align: center;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		white-space: nowrap;
		color: var(--color-text-secondary, #5b616e);
	}

	.tc__stage--right {
		grid-column: 3;
	}

	// The drawing's own box: everything below the stage names is positioned in it, and the wire
	// layer covers exactly it, so a path coordinate and a grid column are the same coordinate.
	.tc__body {
		position: relative;
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: u(var(--tc-site)) u(var(--tc-gut)) u(var(--tc-twin));
		height: u(var(--tc-body));
	}

	// --- the site frame -------------------------------------------------------------

	.tc__site {
		grid-column: 1;
		padding: u(var(--tc-pad));
		border: 1px solid var(--color-border, #ebebeb);
		// The cards' own radius, so the frame is one more card and not a different kind of shape.
		border-radius: u(var(--flow-radius, 8));
		background: var(--color-bg-light, #f7f9fc);
	}

	.tc__site-name {
		display: flex;
		align-items: center;
		gap: u(8);
		height: u(var(--tc-head));
		margin: 0;
		font-size: u(15);
		font-weight: $font-weight-medium;
		line-height: u(22);
		white-space: nowrap;
		color: var(--color-text-secondary, #5b616e);

		[data-icon] {
			flex: none;
			width: u(18);
			height: u(18);
		}
	}

	// The height is pinned rather than left to the content, and that is deliberate. TwinUnit carries
	// 4px of border chrome — a border top and bottom, a hairline between each pair of rows — which
	// are PIXELS and do not scale, so its natural height is 4px more than the arithmetic says. Here
	// the connectors TOUCH this card's top and bottom edges, where a 4px miss is visible; the last
	// row losing 4px of its padding is not. So the error is spent there instead.
	.tc__unit {
		height: u(var(--tc-unit-h));
		margin-top: u(var(--tc-unit-gap));
	}

	// --- the twin -------------------------------------------------------------------

	.tc__card {
		grid-column: 3;
		display: flex;
		overflow: hidden;
		flex-direction: column;
		height: u(var(--tc-body));
		border: 1px solid var(--color-border, #ebebeb);
		border-radius: u(var(--flow-radius, 8));
		background: var(--color-bg-surface, #fff);
	}

	.tc__head {
		display: flex;
		align-items: center;
		gap: u(10);
		height: u(46);
		padding: 0 u(16);
		background: var(--color-bg-light, #f7f9fc);

		[data-icon] {
			flex: none;
			width: u(20);
			height: u(20);
			color: var(--color-text-secondary, #5b616e);
		}
	}

	.tc__name {
		font-size: u(16);
		font-weight: $font-weight-medium;
		line-height: u(22);
		white-space: nowrap;
	}

	// --- the hierarchy --------------------------------------------------------------

	.tc__tree {
		height: u(76);
		margin: 0;
		padding: u(10) u(16) u(6);
		list-style: none;
		border-bottom: 1px solid var(--sl-color-hairline-light, #ebebeb);
	}

	.tc__node {
		display: flex;
		position: relative;
		align-items: center;
		gap: u(6);
		height: u(20);
		margin-left: calc(var(--depth) * #{u(12)});
		font-size: u(14);
		line-height: u(20);
		white-space: nowrap;
		color: var(--color-text-secondary, #5b616e);

		// The deepest level is the one the unit is actually in, so it is the one in full ink.
		&:last-child {
			font-weight: $font-weight-medium;
			color: var(--color-text);
		}

		[data-icon] {
			flex: none;
			width: u(14);
			height: u(14);
		}
	}

	// Drawn, not typed: a box-drawing character would be a glyph at the type's size, and this has to
	// be a hairline at the card's. It starts inside the line above rather than in the gap, because
	// the point is that this level hangs off that one.
	.tc__branch {
		flex: none;
		width: u(6);
		height: u(11);
		margin: u(-10) 0 0 u(1);
		border-bottom: 1px solid var(--color-border-strong, #d5d7dd);
		border-left: 1px solid var(--color-border-strong, #d5d7dd);
		border-bottom-left-radius: u(2);
	}

	// --- the attributes -------------------------------------------------------------

	.tc__attrs {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	// Key left, value right, history under them both. Under, not inline: a history squeezed between
	// the key and the value would be a third column fighting for the same line.
	.tc__attr {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: baseline;
		height: u(var(--h));
		padding: u(8) u(16) 0;
		gap: 0 u(12);
		font-size: u(14);
		line-height: u(22);

		& + & {
			border-top: 1px solid var(--sl-color-hairline-light, #ebebeb);
		}
	}

	.tc__k {
		color: var(--color-text-secondary, #5b616e);
	}

	.tc__v {
		justify-self: end;
		font-weight: $font-weight-medium;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		color: var(--color-text);
	}

	.tc__spark,
	.tc__band {
		grid-column: 1 / -1;
		margin-top: u(6);

		svg {
			display: block;
			width: 100%;
			height: 100%;
		}
	}

	.tc__spark {
		height: u(var(--tc-spark-h));

		svg {
			overflow: visible;
		}
	}

	// Rounded on the wrapper and clipped, not on the rects: the box is stretched horizontally, so a
	// radius on a rect would come out oval.
	.tc__band {
		overflow: hidden;
		height: u(var(--tc-band-h));
		border-radius: u(3);
	}

	.tc__spark-area,
	.tc__band-off {
		fill: var(--color-primary, #3d50f5);
		opacity: 0.1;
	}

	.tc__band-on {
		fill: var(--color-primary, #3d50f5);
	}

	.tc__spark-line {
		fill: none;
		stroke: var(--color-primary, #3d50f5);
		stroke-width: max(1px, #{u(2)});
		stroke-linecap: round;
		stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
	}

	// --- the connectors -------------------------------------------------------------

	.tc__wires {
		position: absolute;
		z-index: 2;
		top: 0;
		left: 0;
		// Every card in the drawing sits 1px inside its own border, and the arithmetic above cannot
		// see that border — so measured, both unit-side endpoints came up 1px short of the edge they
		// are meant to touch. A pixel, because what it corrects is a pixel: it must not scale with
