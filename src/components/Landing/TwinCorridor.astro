	.tc__zone-name {
		display: flex;
		align-items: center;
		gap: u(6);
		height: u(var(--tc-zone-head));
		margin: 0;
		font-size: u(14);
		line-height: u(18);
		white-space: nowrap;
		color: var(--color-text-secondary, #5b616e);

		[data-icon] {
			flex: none;
			width: u(14);
			height: u(14);
		}
	}

	.tc__zone > .tc__unit {
		margin-top: u(var(--tc-zone-gap));
	}

	// TwinUnit is shared — `DigitalTwin` and the sandbox gallery render it too — so its type is
