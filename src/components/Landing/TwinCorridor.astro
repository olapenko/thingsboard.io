---
import { Icon } from 'astro-icon/components';
import TwinUnit from '@components/Landing/TwinUnit.astro';
import { DIGITAL_TWIN_STAGES, PHYSICAL_ASSET, TWIN, TWIN_FLOWS, TWIN_HISTORY } from '@data/digital-twin-visual';
import { segmentWidth, sparkPaths, sparkY } from '@util/sparkline';

/**
 * The twin composition with the connectors moved overhead. This is the row the home preview shows,
 * in its `zone` form; `DigitalTwin`, which it replaced, is untouched and still on its own stages in
 * the sandbox so the two can be put side by side.
 *
 * --- the routing ---------------------------------------------------------------------------
 *
 * The shipped visual runs its connectors through a 96u gutter between the two cards and parks
 * their names in it. That gutter is a fixed track, so every unit in it comes straight off the
 * composition's width — and it is the one part of the picture with nothing in it.
 *
 * Here they leave the unit through its top and bottom edges, run up into the frame's own empty
 * space, and cross. The gutter then only has to be wide enough to be crossed: 96u -> 18u.
 *
 *     shipped    frame 242.7 | gutter 96 | twin 291.3     (measured)
 *     here       frame 258   | gutter 18 | twin 282
 *
 * Elbows, not the family's cubic curves. A curve is the right shape for a connector that leaves
 * and arrives horizontally; these leave vertically and arrive horizontally, and a 90-degree turn
 * drawn as a curve needs most of the corridor to make the bend. The stroke, the grey and the open
 * chevron are the family's, so the hand is the same even though the corner is square.
 *
 * Both connectors attach to CARD EDGES — the unit's top and bottom, the twin's left — and never to
 * a row inside a card. The version this replaces computed its endpoints from row centres, so every
 * content change moved an arrow. Here the card has been refilled twice without the drawing moving.
 *
 * --- what the twin says ----------------------------------------------------------------------
 *
 * The path sits ABOVE the name, as an address does: `Acme Inc > Warehouse 3`, then `CS-04 twin`.
 * An earlier cut had the ancestors listed under the title, which reads backwards — the child first
 * and its parents below it — and that inversion was most of why the hierarchy looked like metadata
 * rather than structure.
 *
 * `zone` is the other direction: the unit nested in a Zone B frame on the left AND Zone B as the
 * path's last step on the right, so the same containment is shown twice — once as geometry, once as
 * an address — and the comparison is what says the twin knows where the thing lives.
 *
 * Three devices against three attributes, in the same order down both cards: temp probe against
 * temperature, power meter against power, door sensor against door. The order is the argument —
 * the twin is not a list of readings, it is the same object seen from the other side.
 *
 * Each history takes the form of its kind, and the three shapes are deliberately unlike:
 *
 *   temperature   a spline in cold teal, because it is a continuous measurement
 *   power         straight segments in amber, because it switches — the plateaus ARE the compressor
 *   door          a green segment band, which is how the platform's State chart draws `doorState`
 *
 * A hue each rather than three blues: the rows are three different KINDS of reading, and one colour
 * across all of them said they were three samples of the same thing.
 *
 * The power meter carries the compressor rather than a row of its own. A cut that gave the
 * compressor its own row had to show it as a duty cycle — 56 % over the day, one aggregate sitting
 * between two instantaneous readings, and a figure no device ever sends. Power draw is what the
 * meter actually reports, it is instantaneous like its neighbours, and because the compressor is
 * on or off the trace plateaus: the duty cycle is visible without being computed.
 *
 * All three derive from ONE series, so they cannot contradict each other: power is high while the
 * temperature falls, which is what makes it fall, and the door is open across two of the four warm
 * excursions. The other two are the defrost cycles the shared data describes.
 *
 * Deliberately still, as the shipped visual is: only the temperature reading ticks. The flow
 * visual carries the page's motion.
 */

interface Props {
	/**
	 * Show the zone on BOTH sides: the unit nested in a Zone B frame inside the site on the left,
	 * and Zone B as the last step of the path on the right.
	 *
	 * Off by default, which is the shorter reading — site on the left, site as the path's last step.
	 * On, the two halves show the same containment twice, once as geometry and once as an address,
	 * and the comparison is the argument. It costs the corridors about 19u each.
	 */
	zone?: boolean;
}

const { zone = false } = Astro.props;

// --- content ------------------------------------------------------------------------------

const SITE = { name: PHYSICAL_ASSET.path[0], icon: 'tabler:building-warehouse' };
const ZONE = { name: PHYSICAL_ASSET.path[1], icon: 'tabler:map-pin' };

/**
 * The hierarchy the twin knows, root first, as a path over the name. No glyphs: icons in a row at
 * this size read as decoration, and the separators already say it is a path.
 *
 * The path goes exactly as deep as the left side does, so the two halves are describing the same
 * containment rather than two different ones.
 */
const PATH = zone ? ['Acme Inc', ...PHYSICAL_ASSET.path] : ['Acme Inc', SITE.name];

/**
 * Three devices, in the twin's own row order. Picked by label rather than sliced, so the pairing
 * is stated here and a rename in the data file fails loudly instead of quietly shuffling the rows.
 */
const DEVICE_ORDER = ['Temp probe', 'Power meter', 'Door sensor'];
const UNIT = {
	name: PHYSICAL_ASSET.name,
	icon: PHYSICAL_ASSET.icon,
	devices: DEVICE_ORDER.map((label) => {
		const device = PHYSICAL_ASSET.devices.find((d) => d.label === label);
		if (!device) throw new Error(`TwinCorridor: no device named "${label}" in PHYSICAL_ASSET`);
		return device;
	}),
};

const telemetry = TWIN_FLOWS.find((f) => f.to === 'twin');
const commands = TWIN_FLOWS.find((f) => f.to === 'physical');

const attr = (key: string) => TWIN.attributes.find((a) => a.key === key)?.value ?? '';

// --- the day ------------------------------------------------------------------------------
//
// A full day at half-hourly samples, on the data file's own formula and domain: a slow cycle, a
// faster wobble, and a warm excursion every six hours. Generated here rather than taken from
// `TWIN_HISTORY.series` because that series stops at 16:00 on purpose — the shipped chart labels
// its axis and the empty remainder is what says where in the day we are. These rows carry no axis,
// so an empty right third would read as a chart that failed to load.

const TAU = Math.PI * 2;
const STEP_H = 0.5;
const STEPS = TWIN_HISTORY.hours / STEP_H;

// The window is the last 24 hours, so it ends NOW rather than at midnight — and where in the
// compressor's cycle "now" falls decides what the power row says. Starting an hour in is the
// nearest offset that ends mid-run, so the value reads 2.4 kW instead of the 0.3 kW standing load,
// and the temperature lands at -18.7, inside the loop the reading ticks through. Four runs across
// the day either way.
const START_H = 1;

const bump = (t: number) => Math.pow(Math.max(0, Math.sin((TAU * t) / 6)), 6);
const tempAt = (t: number) =>
	-18.3 + 0.9 * Math.sin((TAU * t) / 9 + 0.6) + 0.3 * Math.sin((TAU * t) / 2.3) + 1.1 * bump(t);

const SERIES = Array.from({ length: STEPS + 1 }, (_, i) => Math.round(tempAt(START_H + i * STEP_H) * 100) / 100);

/**
 * The compressor runs while the box is getting colder — that is what makes it colder — and it is
 * the compressor that the power meter is mostly measuring.
 *
 * Read off a 5-sample mean rather than the raw series, and that is a simplification worth naming. A
 * real thermostat clicks every half hour or so, and drawn honestly this came out as two dozen equal
 * pulses — a barcode, which is texture rather than a reading. Smoothing past the fast wobble leaves
 * the shape of the day: a handful of long runs, which is what the row is for.
 */
const WINDOW = 5;
const smooth = (i: number) => {
	const lo = Math.max(0, i - (WINDOW >> 1));
	const hi = Math.min(SERIES.length - 1, i + (WINDOW >> 1));
	let sum = 0;
	for (let j = lo; j <= hi; j++) sum += SERIES[j];
	return sum / (hi - lo + 1);
};
const RUNNING = Array.from({ length: STEPS }, (_, i) => smooth(i + 1) < smooth(i));

/** Standing load — fans, lights, controls — plus the compressor when it is on. */
const IDLE_KW = 0.35;
const RUN_KW = 2.4;
const POWER = Array.from({ length: STEPS + 1 }, (_, i) => {
	const on = RUNNING[Math.min(i, STEPS - 1)];
	return Math.round(((on ? RUN_KW : IDLE_KW) + 0.05 * Math.sin(i * 1.7)) * 100) / 100;
});

/**
 * The door is open across the two largest warm excursions. `bump` peaks four times a day; two of
 * those are somebody opening the door and two are the defrost cycle the data file describes, which
 * is why this takes every other one.
 */
const DOOR_OPEN = Array.from({ length: STEPS }, (_, i) => {
	const t = START_H + i * STEP_H;
	return bump(t) > 0.55 && Math.floor(t / 6) % 2 === 1;
});

/** Contiguous runs of `true`, as percentages of the band's width. */
const spans = (flags: boolean[]) => {
	const out: { x: number; w: number }[] = [];
	for (let i = 0; i < flags.length; i++) {
		if (!flags[i]) continue;
		const start = i;
		while (flags[i + 1]) i++;
		out.push({ x: (start / flags.length) * 100, w: ((i - start + 1) / flags.length) * 100 });
	}
	return out;
};

const DOOR_SPANS = spans(DOOR_OPEN);

const CHART_H = 30;
const BAND_H = 12;

const TEMP_VIEW = { w: 100, h: CHART_H, pad: 0 };
const temp = sparkPaths(SERIES, TWIN_HISTORY.domain, TEMP_VIEW);

// Straight segments rather than the spline the temperature uses. A Catmull-Rom curve through a
// switching signal rounds every edge and overshoots after it, which would draw a compressor that
// eases in and coasts out. It does neither.
const POWER_VIEW = { w: 100, h: CHART_H, pad: 0 };
const POWER_DOMAIN: [number, number] = [0, 3];
const POWER_SEG = segmentWidth(POWER.length, POWER_VIEW);
const powerPts = POWER.map((v, i) => `${(i * POWER_SEG).toFixed(2)},${sparkY(v, POWER_DOMAIN, POWER_VIEW).toFixed(2)}`);
const power = {
	line: `M ${powerPts.join(' L ')}`,
	area: `M ${powerPts.join(' L ')} L ${POWER_VIEW.w},${POWER_VIEW.h} L 0,${POWER_VIEW.h} Z`,
};

// --- geometry -----------------------------------------------------------------------------

const NATIVE = 558;
const COL = { site: 258, gut: 18, twin: 282 };

// The shipped composition's body, measured in the browser at the sandbox row: 337.6u. Held, so the
// two can be laid over each other and the footprint compared rather than argued.
const BODY = 338;

const FRAME_PAD = 12;
const HEAD_H = 24; // the site's own name, on the frame's top line

// TwinUnit's metrics, mirrored so the arrows can be aimed. Its head band is 12 + 22 + 12; its rows
// are 8 + 22 + 8 rather than the 8 + 26 + 8 it ships, because the type overrides at the foot of
// this file bring its line height down to the twin's.
const UNIT_HEAD_H = 46;
const UNIT_ROW_H = 38;
const UNIT_H = UNIT_HEAD_H + UNIT.devices.length * UNIT_ROW_H;

// The twin's header: the path, a clear gap, then the name. The name sits in a band the size of the
// unit's own head — 12 + 22 + 12 — so the two cards are headed alike, with the path as the one
// thing the twin has and the unit does not. Broken out because the telemetry run lands on the name
// and has to know where its line ends.
const TWIN_HEAD_PAD = 12;
const PATH_H = 18;
const PATH_GAP = 14;
const NAME_H = 22;
const TWIN_HEAD_H = TWIN_HEAD_PAD + PATH_H + PATH_GAP + NAME_H + 14;

// The zone frame, when the unit is nested one level deeper. It runs from below the telemetry line
// all the way to the frame's bottom padding, so the commands connector and its name are INSIDE the
// zone rather than under it — the arrow is in the room it is addressing.
const ZONE_TOP = 72;
const ZONE_PAD = 8;
const ZONE_HEAD = 22;
const ZONE_GAP = 8;
// Down to 6u of the site's own edge rather than stopping at its padding: how high the zone can
// start is capped by the telemetry run above it, so the room the commands name needs comes from
// the other end. An area abutting the wall of the building it is in is how floor plans read anyway.
const ZONE_FOOT = 6;
const ZONE_H = BODY - ZONE_FOOT - ZONE_TOP;

// A hatched bar over the site's name, in the version with no zone in it: the same marking the
// zone carries, so the two versions are decorated by one hand and the plain one is not simply the
// other with something removed. Nested, the zone is the marking and a second one would be noise.
const BAR_H = 10;
const BAR_GAP = 14;

// The height budget, top to bottom: padding, the bar, the site's name, the telemetry corridor, the
// unit (or the zone holding it), the commands corridor, padding. Whatever the block in the middle
// takes, the corridors get the rest — which is why the unit holds three devices and not four.
// The bar is full-bleed, so it stands in for the frame's top padding rather than sitting inside it.
const INNER_TOP = (zone ? FRAME_PAD : BAR_H + BAR_GAP) + HEAD_H;
const TOP_CORRIDOR = 50;
const UNIT_TOP = zone ? ZONE_TOP + ZONE_PAD + ZONE_HEAD + ZONE_GAP : INNER_TOP + TOP_CORRIDOR;
const UNIT_BOT = UNIT_TOP + UNIT_H;
const BLOCK_GAP = (zone ? ZONE_TOP : UNIT_TOP) - INNER_TOP;

// The telemetry run lands on the twin's NAME, at the lower edge of its line: the connector points
// at what the card is before it points at what the card reads. Everything on the left hangs below
// it, and nested, the riser crosses into the zone on the way — the unit is what talks, not the room
// it stands in, so both ends sit on the unit's edges either way.
//
// Its height is what caps how high the zone can start, and through that how much run the bottom
// elbow gets. Landing on the head's lower edge left the nested elbow 6u short of the plain one;
// landing a line higher, on the name itself, is what lets the two match.
const UP_Y = TWIN_HEAD_PAD + PATH_H + PATH_GAP + NAME_H;
// Far enough under the unit that the elbow has a straight run to turn out of: the corner eats 12u
// of whatever this is, so at 16 the riser was almost all corner. The same in both versions now,
// which is what raising the telemetry run bought.
const DOWN_Y = UNIT_BOT + 28;

// Close enough to its run to belong to it, far enough to read as a caption rather than as part of
// the line. Nested, the commands name sits inside the zone and has its floor to clear as well, so
// it rides a little closer still.
const LABEL_GAP = zone ? 16 : 18;

// Both risers stand on the unit's centre line. Collinear on purpose — one above the card and one
// below it, so the pair reads as a single axis the unit sits on rather than as two stray lines.
const UNIT_X = FRAME_PAD + (COL.site - FRAME_PAD * 2) / 2;
const TWIN_X = COL.site + COL.gut;

// Halfway between the unit's centre line and the frame's edge, so a name sits over its own run
// rather than over the card it came from.
const LABEL_X = (UNIT_X + COL.site) / 2;

const R = 12; // corner radius
const HEAD = 8;
const WING = 5;

// Quadratic corners: the control point is the corner itself, so the radius cannot disagree with
// where the straight runs end.
const wires = {
	up: `M ${UNIT_X},${UNIT_TOP} L ${UNIT_X},${UP_Y + R} Q ${UNIT_X},${UP_Y} ${UNIT_X + R},${UP_Y} L ${TWIN_X},${UP_Y}`,
	upHead: `M ${TWIN_X - HEAD},${UP_Y - WING} L ${TWIN_X},${UP_Y} L ${TWIN_X - HEAD},${UP_Y + WING}`,
	down: `M ${TWIN_X},${DOWN_Y} L ${UNIT_X + R},${DOWN_Y} Q ${UNIT_X},${DOWN_Y} ${UNIT_X},${DOWN_Y - R} L ${UNIT_X},${UNIT_BOT}`,
	downHead: `M ${UNIT_X - WING},${UNIT_BOT + HEAD} L ${UNIT_X},${UNIT_BOT} L ${UNIT_X + WING},${UNIT_BOT + HEAD}`,
};

/**
 * The twin's height budget: a 66u header, then 98 + 98 + 62 of rows, then 14u of padding under the
 * last one — 338, the frame's own height. Set here and spent in the CSS below, so a row that
 * outgrows its band shows as an overflow rather than by quietly pushing the card past the frame.
 */
const CARD_PAD_B = 14;

/**
 * A hue each, from the accents `ConnectCloud` already uses, rather than three blues at different
 * opacities. They are doing a job: the three rows are three different KINDS of reading, and one
 * colour across all of them said they were three samples of the same thing.
 *
 * Cold for the temperature, energy for the power, and green for the door, which is the one that is
 * a state rather than a measurement. The door was on the family's violet until the connectors took
 * the platform's blue: next to it, a violet band read as another piece of the same wiring.
 */
const ROWS = [
	{ key: 'temperature', value: attr('temperature'), h: 90, kind: 'spline', accent: '#0e7490', on: null },
	{
		key: 'power',
		value: `${POWER[POWER.length - 1].toFixed(1)} kW`,
		h: 90,
		kind: 'steps',
		accent: '#b45309',
		on: null,
	},
	// One hue, like the two rows above it. Green for closed and red for open was the truer reading —
	// the platform's State chart does assign a colour per state — but two hues in a row this size
	// made four colours in the picture and the band shouted louder than what it was reporting.
	//
	// What it keeps is the part that was actually carrying the meaning: the open spans are SOLID and
	// the closed ground is the same colour at 0.1. The distinction is density, not hue, which is why
	// it survived dropping a colour — and why it survives colour blindness.
	//
	// A brick red, not `--color-danger`: that token is 100% saturated where every other accent here
	// sits between 65 and 90. It is not claiming an alarm — a door opening is normal — but the two
	// spans sit on two of the four warm excursions, and that is worth being able to see.
	{ key: 'door', value: attr('door'), h: 64, kind: 'band', accent: '#b23c33', on: null },
];

/** As a share of the body's box, so a name tracks the drawing and not the grid. */
const at = (x: number, y: number) => `--x: ${((x / NATIVE) * 100).toFixed(3)}%; --y: ${((y / BODY) * 100).toFixed(3)}%`;

const vars = [
	`--tc-u: clamp(0.45px, calc(100cqw / ${NATIVE}), 1.15px)`,
	`--tc-native: ${NATIVE}`,
	`--tc-site: ${COL.site}`,
	`--tc-gut: ${COL.gut}`,
	`--tc-twin: ${COL.twin}`,
	`--tc-body: ${BODY}`,
	`--tc-pad: ${FRAME_PAD}`,
	`--tc-pad-t: ${FRAME_PAD}`,
	`--tc-pad-b: ${zone ? ZONE_FOOT : FRAME_PAD}`,
	`--tc-bar-h: ${BAR_H}`,
	`--tc-bar-gap: ${BAR_GAP}`,
	`--tc-path-h: ${PATH_H}`,
	`--tc-path-gap: ${PATH_GAP}`,
	`--tc-name-h: ${NAME_H}`,
	`--tc-head-pad: ${TWIN_HEAD_PAD}`,
	`--tc-head: ${HEAD_H}`,
	`--tc-block-gap: ${BLOCK_GAP}`,
	`--tc-zone-gap: ${ZONE_GAP}`,
	`--tc-zone-pad: ${ZONE_PAD}`,
	`--tc-zone-head: ${ZONE_HEAD}`,
	`--tc-zone-h: ${ZONE_H}`,
	`--tc-twin-head: ${TWIN_HEAD_H}`,
	`--tc-unit-h: ${UNIT_H}`,
	`--tc-chart-h: ${CHART_H}`,
	`--tc-band-h: ${BAND_H}`,
	`--tc-card-pad-b: ${CARD_PAD_B}`,
	// The site frame's border, which the risers cross on their way to the unit's edge and which the
	// unit arithmetic cannot see. The zone draws none of its own, so this is exactly that one edge —
	// and it is heavier in the nested version, so this follows it.
	`--tc-nudge: ${zone ? 2 : 1}px`,
	`--tc-stroke: ${zone ? 2 : 1}px`,
	`--tc-site-bg: ${zone ? 'none' : 'var(--color-bg-surface, #fff)'}`,
].join(';');
---

<div class="tc-fit">
	<div class="tc" style={vars} data-twin-corridor>
		<p class="tc__stage">{DIGITAL_TWIN_STAGES.physical}</p>
		<p class="tc__stage tc__stage--right">{DIGITAL_TWIN_STAGES.twin}</p>

		<div class="tc__body">
			{
				/* --- the real thing, in its place ----------------------------------------------
			    The frame is the scope and its top line names it. The space under that line is not
			    padding — it is the corridor the telemetry runs through, which is the whole trade
			    this candidate makes. */
			}
			<div class="tc__site">
				{!zone && <i class="tc__bar" aria-hidden="true" />}
				<p class="tc__site-name">
					<Icon name={SITE.icon} aria-hidden="true" />
					<span>{SITE.name}</span>
				</p>
				{
					zone ? (
						<div class="tc__zone">
							<p class="tc__zone-name">
								<Icon name={ZONE.icon} aria-hidden="true" />
								<span>{ZONE.name}</span>
							</p>
							<TwinUnit unit={UNIT} class="tc__unit" />
						</div>
					) : (
						<TwinUnit unit={UNIT} class="tc__unit" />
					)
				}
			</div>

			{/* --- its twin ------------------------------------------------------------------ */}
			<div class="tc__card">
				<header class="tc__head">
					{/* The address, over the name. Read down, it is the platform's own path to this object. */}
					<p class="tc__path">
						{
							PATH.map((step, i) => (
								<Fragment>
									{i > 0 && (
										<span class="tc__sep" aria-hidden="true">
											›
										</span>
									)}
									<span>{step}</span>
								</Fragment>
							))
						}
					</p>
					<p class="tc__name">
						<Icon name="tabler:box-model" aria-hidden="true" />
						<span>{TWIN.name}</span>
					</p>
				</header>

				<ul class="tc__attrs">
					{
						ROWS.map((row) => (
							<li
								class="tc__attr"
								style={`--h: ${row.h}; --accent: ${row.accent}; --accent-on: ${row.on ?? row.accent}`}
								data-twin-attr={row.key}
							>
								<span class="tc__k">{row.key}</span>
								<span class="tc__v">{row.value}</span>

								{row.kind === 'band' ? (
									<span class="tc__band">
										<svg viewBox={`0 0 100 ${BAND_H}`} preserveAspectRatio="none" aria-hidden="true">
											<rect class="tc__band-off" x="0" y="0" width="100" height={BAND_H} />
											{DOOR_SPANS.map((s) => (
												<rect class="tc__band-on" x={s.x} y="0" width={s.w} height={BAND_H} />
											))}
										</svg>
									</span>
								) : (
									<span class="tc__chart">
										<svg viewBox={`0 0 100 ${CHART_H}`} preserveAspectRatio="none" aria-hidden="true">
											<path class="tc__chart-area" d={row.kind === 'steps' ? power.area : temp.area} />
											<path class="tc__chart-line" d={row.kind === 'steps' ? power.line : temp.line} />
										</svg>
									</span>
								)}
							</li>
						))
					}
				</ul>
			</div>

			{
				/* --- what crosses ---------------------------------------------------------------
			    One layer over the whole body rather than an oversized item in the gutter track: the
			    paths are then written in the composition's own coordinates, and no endpoint depends
			    on which track it happens to be over. */
			}
			<svg
				class="tc__wires"
				viewBox={`0 0 ${NATIVE} ${BODY}`}
				preserveAspectRatio="none"
				aria-hidden="true"
				focusable="false"
			>
				<path class="tc__wire" d={wires.up}></path>
				<path class="tc__wire tc__wire--head" d={wires.upHead}></path>
				<path class="tc__wire" d={wires.down}></path>
				<path class="tc__wire tc__wire--head" d={wires.downHead}></path>
			</svg>

			<span class="tc__flow-name" style={at(LABEL_X, UP_Y - LABEL_GAP)}>{telemetry?.label}</span>
			<span class="tc__flow-name" style={at(LABEL_X, DOWN_Y + LABEL_GAP)}>{commands?.label}</span>
		</div>
	</div>
</div>

<script>
	/**
	 * What moves, and only while the visual is on screen.
	 *
	 * The two readings step through short precalculated loops. The histories under them do NOT
	 * follow — they are the day, and the day does not change every three seconds.
	 *
	 * There was a sweep here that plotted each history in when the composition came into view. It
	 * was removed: half a second across a 30u sparkline, fired on an 80px root margin, so it had
	 * usually finished before the eye arrived. If this visual is to look live, the way to do it is
	 * to ADVANCE the charts — `sparkline.ts` takes a window with one point past the right edge for
	 * exactly that — not to draw them once.
	 */
	const BEAT_MS = 3000;
	const TEMPS = [-18.4, -18.2, -18.6, -18.3, -18.7, -18.1];
	/**
	 * Around the compressor's running draw, which is where the day's last sample leaves it. The
	 * spread is deliberate: the first cut of this loop moved by hundredths, and every value in it
	 * rendered as `2.4 kW` at one decimal, so the row sat there looking broken. A compressor's draw
	 * really does wander a couple of hundred watts with head pressure.
	 */
	const KW = [2.4, 2.3, 2.5, 2.4, 2.6, 2.3];

	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll<HTMLElement>('[data-twin-corridor]').forEach((root) => {
		if (reduce) return;
		const temp = root.querySelector<HTMLElement>('[data-twin-attr="temperature"] .tc__v');
		const power = root.querySelector<HTMLElement>('[data-twin-attr="power"] .tc__v');
		if (!temp || !power) return;

		let beat = 0;
		let visible = false;
		let timer = 0;

		const tick = () => {
			if (!visible) return;
			beat++;
			temp.textContent = `−${Math.abs(TEMPS[beat % TEMPS.length]).toFixed(1)} °C`;
			power.textContent = `${KW[beat % KW.length].toFixed(1)} kW`;
			timer = window.setTimeout(tick, BEAT_MS);
		};

		new IntersectionObserver(
			(entries) => {
				visible = entries.some((e) => e.isIntersecting);
				clearTimeout(timer);
				if (visible) timer = window.setTimeout(tick, BEAT_MS);
			},
			{ rootMargin: '80px' }
		).observe(root);
	});
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	// Floor marking: white bands on a washed ground, both of them the composition's own colours, so
	// the hatch carries its own background instead of letting whatever the row is tinted with show
	// through the gaps. Drawn in design units, so it scales with everything else — a gradient in
	// pixels would be one more thing that does not.
	// Bands in the frame's own stroke colour over transparent gaps, so the marking and the outline
	// around it are the same grey and read as one piece of drawing.
	//
	// This was white for a while, which made it show only where the composition sat on a tint. That
	// was the right answer while the site had no fill; with a white card under it, white marking on
	// white is nothing at all.
	//
	// Drawn in design units, so it scales with everything else — a gradient in pixels would be one
	// more thing that does not.
	@mixin hatch {
		background: repeating-linear-gradient(45deg, var(--tc-shade) 0 #{u(12)}, transparent #{u(12)} #{u(20)});
	}

	// Inverted on dark, where darkening a dark surface does nothing. Not a viewport query — the rule
	// against those is about a visual not knowing how wide the page is; it knows its own palette.
	:global([data-theme='dark']) .tc {
		--tc-shade: rgba(255, 255, 255, 0.08);
	}

	.tc-fit {
		container-type: inline-size;
	}

	.tc {
		--u: var(--tc-u);
		// One size for both pairs of captions — the two stage names over the halves, and the two
		// connector names in the corridors. They label the same kind of thing, so they move together.
		--tc-label: 17;
		// The site's marking is a SHADE, not a colour: it darkens whatever is behind it instead of
		// painting a grey on top. `--color-border` is hsl(0, 0%, 92%) — a pure neutral — and the row
		// this sits in is hsl(234, 100%, 98%), so the two were 234 degrees apart and the hatch read as
		// dirty against the tint. At 0.06 over that row this resolves to hsl(234, 25%, 92%): the same
		// lightness as the grey it replaces, and the background's own hue, which no tint can fight.
		--tc-shade: rgba(0, 0, 0, 0.06);
		// TwinUnit reads this one; it is the family's unit under its family name.
		--flow-u: var(--tc-u);
		display: grid;
		grid-template-columns: u(var(--tc-site)) u(var(--tc-gut)) u(var(--tc-twin));
		justify-content: center;
		max-width: u(var(--tc-native));
		margin: 0 auto;
	}

	.tc__stage {
		grid-column: 1;
		min-height: u(24);
		margin: 0 0 u(8);
		font-size: u(var(--tc-label));
		// Fixed, so the size can move without the label row's height moving with it — that row is
		// part of the composition's 370u and the body's 338 sits under it.
		line-height: u(24);
		text-align: center;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		white-space: nowrap;
		color: var(--color-text-secondary, #5b616e);
	}

	.tc__stage--right {
		grid-column: 3;
	}

	// The drawing's own box: everything below the stage names is positioned in it, and the wire
	// layer covers exactly it, so a path coordinate and a grid column are the same coordinate.
	.tc__body {
		position: relative;
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: u(var(--tc-site)) u(var(--tc-gut)) u(var(--tc-twin));
		height: u(var(--tc-body));
	}

	// --- the site frame -------------------------------------------------------------

	// Filled white when it holds the unit directly, unfilled when it holds a zone. With a zone
	// inside it, a fill would put two surfaces one inside the other and the containment stops
	// reading; without one, the site IS the card the unit sits on and wants a card's surface.
	.tc__site {
		background: var(--tc-site-bg);
		grid-column: 1;
		// Pinned, not stretched. Nested, its content adds up to exactly the body's height, so without
		// a height of its own the frame grew by its two 1px borders and hung below the composition.
		height: u(var(--tc-body));
		// The bottom is its own number because the zone runs down into it: the frame's height is the
		// body's, so anything the zone gains below has to come OUT of this padding rather than be
		// added to it. Left unchanged, the frame grew 7.7u past the composition.
		padding: u(var(--tc-pad-t)) u(var(--tc-pad)) u(var(--tc-pad-b));
		// Heavier when it holds a zone: against a hatched area inside it a hairline read as the weaker
		// of the two edges, and the building stopped containing the room. Pixels, like every border
		// here, so it does not scale — which is why the zone's height and the wire layer's nudge are
		// both written in terms of it rather than repeating the number.
		border: var(--tc-stroke) solid var(--tc-shade);
		// The cards' own radius, so the frame is one more card and not a different kind of shape.
		border-radius: u(var(--flow-radius, 8));
	}

	// The same marking as the zone's, as a band across the top of the site. Full bleed: pulled out
	// through the frame's padding on three sides so it meets the border, because inset by a margin it
	// read as a strip laid on the card rather than as the edge of the floor. It takes the place of
	// the frame's top padding, which is why `INNER_TOP` counts it instead.
	.tc__bar {
		display: block;
		height: u(var(--tc-bar-h));
		margin: calc(-1 * #{u(var(--tc-pad))}) calc(-1 * #{u(var(--tc-pad))}) u(var(--tc-bar-gap));
		// The frame's own radius at the top, square below, so it sits into the corners rather than
		// across them.
		border-radius: u(var(--flow-radius, 8)) u(var(--flow-radius, 8)) 0 0;
		@include hatch;
	}

	.tc__site-name {
		display: flex;
		align-items: center;
		gap: u(8);
		height: u(var(--tc-head));
		margin: 0;
		font-size: u(15);
		font-weight: $font-weight-medium;
		line-height: u(22);
		white-space: nowrap;
		color: var(--color-text-secondary, #5b616e);

		[data-icon] {
			flex: none;
			width: u(18);
			height: u(18);
		}
	}

	// The height is pinned rather than left to the content, and with the two rules below the content
	// comes to exactly that — so the pin is an assertion, not a crop.
	.tc__unit {
		height: u(var(--tc-unit-h));
	}

	.tc__site > .tc__unit {
		margin-top: u(var(--tc-block-gap));
	}

	// One level deeper, and quieter than the site frame it sits in: no fill of its own, a dashed
	// hairline, and tighter padding. A second solid box at the same weight reads as two rooms side
	// by side rather than one inside the other.
	// Hatched rather than filled, and it runs to the frame's bottom padding: a zone is an AREA of
	// the warehouse floor, not another card. The stripes are drawn in design units, so they scale
	// with everything else — a gradient in pixels would be one more thing that does not.
	.tc__zone {
		// Less the frame's two borders, which `box-sizing` takes out of the space this sits in.
		height: calc(#{u(var(--tc-zone-h))} - 2 * var(--tc-stroke));
		margin-top: u(var(--tc-block-gap));
		padding: u(var(--tc-zone-pad));
		// No outline of its own. An area is not a card, and once the hatch carries the surface, a
		// border was drawing a box around something that is not one.
		border-radius: u(var(--flow-radius, 8));
		@include hatch;
	}

	// The same line as the warehouse's above it: one level down is said by where it sits and by the
	// hatch around it, not by a smaller, lighter label.
	.tc__zone-name {
		display: flex;
		align-items: center;
		gap: u(8);
		height: u(var(--tc-zone-head));
		margin: 0;
		font-size: u(15);
		font-weight: $font-weight-medium;
		line-height: u(22);
		white-space: nowrap;
		color: var(--color-text-secondary, #5b616e);

		[data-icon] {
			flex: none;
			width: u(18);
			height: u(18);
		}
	}

	.tc__zone > .tc__unit {
		margin-top: u(var(--tc-zone-gap));
	}

	// TwinUnit is shared — `DigitalTwin` and the sandbox gallery render it too — so its type is
	// matched from HERE rather than changed there. Scoped to `.tc`, so nothing outside this
	// composition sees it; by class name, because a scoped rule cannot otherwise reach another
	// component's markup. Astro compiles TwinUnit's own rules to `:where()`, which scores zero, so
	// these win on specificity alone.
	//
	// What it buys: the unit's device rows match the twin's keys in size and line height. Its NAME is
	// left alone — TwinUnit already sets 16u semibold on 22u, which is what the twin's name opposite
	// it now uses, so the two cards are headed identically without a rule here.
	// TwinUnit's 4px of chrome, spent without costing layout. Its card reserves a 1px border that is
	// transparent — it draws nothing — and its rows separate on a 1px border, which does. Together
	// they made the card 4px taller than the unit arithmetic says, and since its height is pinned
	// and it clips, that 4px came off the last device row: `Door sensor` was cropped along its
	// bottom. An invisible border becomes no border, and a separator that has to stay visible
	// becomes an inset shadow, which paints on the same line and reserves nothing. The card is then
	// exactly 46 + 3 x 38 units, and the drawing needs no correction for it at all.
	.tc :global(.unit) {
		border: 0;
	}

	.tc :global(.unit__list li + li) {
		border-top: 0;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
	}

	// Size and line height matched to the twin's rows, but the MEDIUM weight kept: these sit on the
	// dark surface, where the twin's keys sit on white, and dropping them to normal took the
	// substance out of the card that is meant to be the solid object in the picture.
	.tc :global(.unit__list li) {
		gap: u(10);
		padding: u(8) u(16);
		font-size: u(14);
		font-weight: $font-weight-medium;
		line-height: u(22);
	}

	.tc :global(.unit__list [data-icon]) {
		width: u(18);
		height: u(18);
	}

	// --- the twin -------------------------------------------------------------------

	.tc__card {
		grid-column: 3;
		display: flex;
		overflow: hidden;
		flex-direction: column;
		height: u(var(--tc-body));
		// No border to subtract any more: the rows add up to exactly this height, and with the outline
		// gone the content box is the whole of it.
		padding-bottom: u(var(--tc-card-pad-b));
		border-radius: u(var(--flow-radius, 8));
		background: var(--color-bg-surface, #fff);
		// A surface, not an outline. A hairline on a white card standing on a tinted row is the
		// weakest way to say "this is a plane"; a shadow says it without adding a grey line.
		//
		// Shallow on purpose. The unit is the one solid OBJECT in the picture and keeps the family's
		// deep two-layer shadow; this is a UI surface lifted slightly off the page, at roughly a third
		// of that depth. Give them the same shadow and the composition's whole argument — the world is
		// a thing, the twin is the platform's model of it — collapses into two cards.
		box-shadow:
			0 1px 2px rgba(16, 24, 40, 0.04),
			0 #{u(5)} #{u(12)} #{u(-6)} rgba(16, 24, 40, 0.1);
	}

	.tc__head {
		display: flex;
		flex-direction: column;
		height: u(var(--tc-twin-head));
		padding: u(var(--tc-head-pad)) u(16) u(14);
		background: var(--color-bg-light, #f7f9fc);
	}

	// Quieter than the name under it: it is where the object is, not what it is.
	.tc__path {
		margin: 0 0 u(var(--tc-path-gap));
		font-size: u(14);
		line-height: u(var(--tc-path-h));
		white-space: nowrap;
		color: var(--color-text-secondary, #5b616e);
	}

	// Bigger than the words it sits between, not smaller: at the path's own size the glyph was a
	// speck and the three names ran together. Its own line height of 0, so growing it cannot push
	// the line the path sits on.
	.tc__sep {
		display: inline-block;
		margin: 0 u(6);
		font-size: u(19);
		line-height: 0;
		vertical-align: -0.08em;
		opacity: 0.55;
	}

	// Semibold, as `DigitalTwin`'s name and `TwinUnit`'s both are. The directory's note about there
	// being no Ubuntu 600 is about body text and says as much — on a heading the face resolves
	// upward. At medium this went soft against the incumbent, and against the unit opposite it.
	.tc__name {
		display: flex;
		align-items: center;
		gap: u(8);
		margin: 0;
		font-size: u(16);
		font-weight: $font-weight-semibold;
		line-height: u(var(--tc-name-h));
		white-space: nowrap;

		[data-icon] {
			flex: none;
			width: u(18);
			height: u(18);
			color: var(--color-text-secondary, #5b616e);
		}
	}

	// --- the attributes -------------------------------------------------------------

	.tc__attrs {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	// Key left, value right, history under them both. Under, not inline: a history squeezed between
	// the key and the value would be a third column fighting for the same line. The row's height is
	// fixed and its content sits at the top, so the slack falls under the chart as padding.
	.tc__attr {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: baseline;
		height: u(var(--h));
		padding: u(10) u(16) 0;
		gap: 0 u(12);
		// A step up from the 14u this started at. The rows are budgeted 90u and their contents come to
		// 70, so the space was already there — and at 14u the key and its value were the same size as
		// the path in the header, which made the readings look like more metadata.
		font-size: u(15);
		line-height: u(24);

		& + & {
			border-top: 1px solid var(--sl-color-hairline-light, #ebebeb);
		}
	}

	.tc__k {
		color: var(--color-text-secondary, #5b616e);
	}

	.tc__v {
		justify-self: end;
		font-weight: $font-weight-medium;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		color: var(--color-text);
	}

	.tc__chart,
	.tc__band {
		grid-column: 1 / -1;
		margin-top: u(6);

		svg {
			display: block;
			width: 100%;
			height: 100%;
		}
	}

	.tc__chart {
		height: u(var(--tc-chart-h));

		svg {
			overflow: visible;
		}
	}

	// Rounded on the wrapper and clipped, not on the rects: the box is stretched horizontally, so a
	// radius on a rect would come out oval.
	.tc__band {
		overflow: hidden;
		height: u(var(--tc-band-h));
		border-radius: u(3);
	}

	.tc__chart-area,
	.tc__band-off {
		fill: var(--accent);
		opacity: 0.1;
	}

	.tc__band-on {
		fill: var(--accent-on);
	}

	.tc__chart-line {
		fill: none;
		stroke: var(--accent);
		stroke-width: max(1px, #{u(2)});
		stroke-linecap: round;
		stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
	}

	// --- the connectors -------------------------------------------------------------

	.tc__wires {
		position: absolute;
		z-index: 2;
		top: 0;
		left: 0;
		// It covers the WHOLE composition, both cards included, so without this it takes every
		// pointer event and a drag across the card selects nothing — the text is there and copyable,
		// but the drag starts on this layer. The gutter-sized layer the rest of the family uses never
		// had the problem, because it only ever covered empty space.
		pointer-events: none;
		// Every card in the drawing sits 1px inside its own border, and the arithmetic above cannot
		// see that border — so measured, both unit-side endpoints came up short of the edge they are
		// meant to touch, by exactly one pixel per border between the frame's top and the unit's.
		// Nested, that is two. Pixels, because what they correct is pixels: they must not scale with
		// the unit, or they would overshoot at the desktop cap and undershoot on a phone.
		transform: translateY(var(--tc-nudge));
		// Not optional: a global reset gives every svg `max-width: 100%`, which would scale this one
		// down against its container and leave every arrow short, with no error anywhere.
		width: u(var(--tc-native));
		max-width: none;
		height: u(var(--tc-body));
		overflow: visible;
	}

	// The platform's own blue, not the family's grey: these two lines are the only thing in the
	// picture that IS the platform rather than something it is describing.
	.tc__wire {
		fill: none;
		stroke: var(--color-primary, #3d50f5);
		stroke-width: max(1px, #{u(2)});
		stroke-linecap: round;
		stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
	}

	.tc__wire--head {
		fill: none;
	}

	// In the corridor beside its run, not knocked out of it: the corridor is empty, so there is
	// nothing to knock the name out of, and a chip of background over a line would announce a
	// crossing that is not happening.
	// The stage names' size, not a step under it: these two label the same kind of thing — what a
	// part of the picture is — and setting them smaller made them read as a footnote to the drawing
	// rather than as its other pair of captions.
	.tc__flow-name {
		position: absolute;
		z-index: 3;
		top: var(--y);
		left: var(--x);
		// The wire layer's nudge as well as the centring: these are placed from the same arithmetic
		// the paths are, so without it they sit a pixel above the runs they name — measured, that put
		// 9.1u over the telemetry line and 4.9u under the commands one, from the same number.
		transform: translate(-50%, -50%) translateY(var(--tc-nudge));
		font-size: u(var(--tc-label));
		// Tighter leading than the stage names carry at the same size: this is a single uppercase
		// line, and box beyond what it needs is spent on the clearance between it and its run.
		line-height: calc(#{u(var(--tc-label))} + #{u(3)});
		text-transform: uppercase;
		letter-spacing: 0.05em;
		white-space: nowrap;
		color: var(--color-primary, #3d50f5);
	}
</style>
