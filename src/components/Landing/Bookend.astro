---
import { Icon } from 'astro-icon/components';
import PricingBackground from '@components/Pricing/PricingBackground.astro';
import SmartImage from '@components/SmartImage.astro';
import tbMark from '@root/assets/images/landings/draft/thingsboard-mark.svg?raw';
import { externalLinkAttrs } from '@util/external-links';
import {
	BOOKEND_ALL_OPTIONS,
	BOOKEND_CLOUD_PLANS,
	BOOKEND_PLATFORMS,
	BOOKEND_REGIONS,
	BOOKENDS,
	type BookendAction,
	type BookendId,
} from '@data/bookends';

/**
 * THE BOOKEND: the band that closes a marketing page, over its footer — the candidate for
 * `ClosingCta` (homepage) and the `.page-closing` bands of the Cloud and On-premises pages, which
 * are three copies of one shape. Judged at `/internal/sections/footer/`; not wired in.
 *
 * `id` picks the page's words (`data/bookends.ts`); `ways` picks what the way in is made of, and
 * with it the layout:
 *
 * - `buttons` — CENTRED, as all three pages ship today: the mark, the title, the lead, the primary
 *   and the secondary, then whatever the page adds under them (a question, a line across, a note).
 *
 * The rest are COLUMNS (2026-09-30, after a Stripe-like example of the layout): an intro column —
 * a smaller title, the lead, the buttons — beside one or two columns that ARE the way in. Only what
 * the decision needs; the mark, the question, the line across and the legal note go, the footer
 * under the band carries the legal links and the pricing link.
 *
 * - `regions` — Cloud's two regions, each a sign-up on its host, in place of the primary: sign-up has
 *   to know the region, so the band asks it here rather than in a dialog.
 * - `platforms` — four of the On-premises guides and a link to the rest, beside the install pair.
 * - `paths` — Cloud and On-premises as two columns, each its mark, its name, one line and its way
 *   in: the installations hub's two sections as one decision. The homepage's.
 *
 * The regions and guides are the installations hub's own data. The region cards are WHITE on either
 * ground, so on the dark one they are the brightest thing in the band — the thing to press.
 *
 * `tone` is the ground: `dark` (the homepage's, `#121425` with the wave in indigo) or `light` (the
 * product pages', their own tint with the wave in their accent). Set as `data-tone`, so the
 * sandbox's switch can flip every instance without a re-render.
 */

interface Props {
	id: BookendId;
	ways?: 'buttons' | 'regions' | 'platforms' | 'paths';
	tone?: 'dark' | 'light';
	/** Where the homepage's "Talk to an expert" goes; the `live` order passes main's. */
	expertHref?: string;
}

const DEFAULT_WAYS = { home: 'buttons', cloud: 'regions', onprem: 'platforms' } as const;
const DEFAULT_TONE = { home: 'dark', cloud: 'light', onprem: 'light' } as const;

const { id, ways = DEFAULT_WAYS[id], tone = DEFAULT_TONE[id], expertHref } = Astro.props;
const b = BOOKENDS[id];
const ask = b.ask && expertHref ? { ...b.ask, action: { ...b.ask.action, href: expertHref } } : b.ask;
const columns = ways !== 'buttons';

// The centred layout's mark, in both dresses; CSS shows the one the tone wants — the mark itself in
// white on dark (2026-09-30: it was the white tile with the inked mark, `ClosingCta`'s), the mark
// knocked out of the accent on light (the product pages' app logo) — so the tone can flip without a
// re-render. One SVG, in `currentColor`, serves both.
const markLight = tbMark.replace(/<svg\b/, '<svg aria-hidden="true"');
const markDark = markLight;

// With the regions and side cards (the homepage's): the regions are the path, under the lede, and
// the other ways on are the side cards; no buttons.
const side = ways === 'regions' ? b.side : undefined;

type Button = { a: BookendAction; kind: 'primary' | 'secondary' };
const primary = (a: BookendAction): Button => ({ a, kind: 'primary' });
const secondary = (a: BookendAction): Button => ({ a, kind: 'secondary' });

// The intro's buttons. Where the regions or the paths are the way in, the buttons are the OTHER ways
// — outlines, so the white cards stay the thing to press; with the platforms, the install pair.
const buttons: Button[] = side
	? []
	: ways === 'buttons' || ways === 'platforms'
		? [primary(b.primary), secondary(b.secondary)]
		: ways === 'regions'
			? [secondary(b.secondary), ...(ask ? [secondary(ask.action)] : [])]
			: [secondary(ask?.action ?? b.secondary)];

const style = `--bk-accent: ${b.accent}; --bk-band: ${b.band}`;
---

<section class:list={['bk', columns ? 'bk--cols' : 'bk--center']} data-tone={tone} data-ways={ways} style={style}>
	<PricingBackground contained />

	<div class="bk__inner">
		<div class="bk__intro">
			{
				!columns && (
					<Fragment>
						<span class="bk__mark bk__mark--dark" aria-hidden="true" set:html={markDark} />
						<span class="bk__mark bk__mark--light" aria-hidden="true" set:html={markLight} />
					</Fragment>
				)
			}
			<h2 class="bk__title">{b.title}</h2>
			<p class="bk__lead">{b.lead}</p>
			{
				side && (
					<Fragment>
						<p class="bk__caption">{b.primary.text}</p>
						<ul class="bk__regions">
							{BOOKEND_REGIONS.map((r) => (
								<li class="bk__region" data-region={r.id}>
									<a href={r.signup} {...externalLinkAttrs(r.signup)}>
										<span class="bk__globe">
											<Icon name="tabler:world" aria-hidden="true" />
										</span>
										<span class="bk__region-name">
											{r.name}
											<small>{r.note}</small>
										</span>
										<span class="bk__region-cta">
											Sign up
											<span class="bk__sr"> for ThingsBoard Cloud in {r.name}</span>
											<Icon name="tabler:chevron-right" aria-hidden="true" />
										</span>
									</a>
								</li>
							))}
						</ul>
					</Fragment>
				)
			}
			<div class="bk__actions">
				{
					buttons.map(({ a, kind }) => (
						<a class:list={['bk__btn', `bk__btn--${kind}`]} href={a.href} {...a.attrs}>
							<Icon name={a.icon} aria-hidden="true" />
							{a.text}
						</a>
					))
				}
			</div>

			{
				!columns && ask && (
					<div class="bk__ask">
						<p class="bk__ask-label">{ask.label}</p>
						<a class="bk__btn bk__btn--secondary" href={ask.action.href}>
							<Icon name={ask.action.icon} aria-hidden="true" />
							{ask.action.text}
						</a>
					</div>
				)
			}
			{
				!columns && b.links && (
					<p class="bk__links">
						{b.links.map((l) => (
							<a class="bk__more" href={l.href}>
								{l.text}
								<Icon name="tabler:arrow-right" aria-hidden="true" />
							</a>
						))}
					</p>
				)
			}
			{
				!columns && b.cross && (
					<p class="bk__cross">
						{b.cross.lead} <a href={b.cross.link.href}>{b.cross.link.text}</a>
						{b.cross.tail}
					</p>
				)
			}
			{
				!columns && b.note && (
					<p class="bk__note">
						<a href={b.note.href}>{b.note.text}</a>
					</p>
				)
			}
		</div>

		{
			side && (
				<ul class="bk__side">
					{side.map((c) => (
						<li>
							<a class="bk__card" href={c.title === ask?.action.text ? ask.action.href : c.href}>
								<span class="bk__card-icon">
									<Icon name={c.icon} aria-hidden="true" />
								</span>
								<span class="bk__card-text">
									<span class="bk__card-title">{c.title}</span>
									<span class="bk__card-line">{c.line}</span>
								</span>
								<Icon name="tabler:chevron-right" class="bk__card-go" aria-hidden="true" />
							</a>
						</li>
					))}
				</ul>
			)
		}

		{
			ways === 'regions' && !side && (
				<div class="bk__col">
					<p class="bk__caption">{b.primary.text}</p>
					<ul class="bk__regions">
						{BOOKEND_REGIONS.map((r) => (
							<li class="bk__region" data-region={r.id}>
								<a href={r.signup} {...externalLinkAttrs(r.signup)}>
									<span class="bk__globe">
										<Icon name="tabler:world" aria-hidden="true" />
									</span>
									<span class="bk__region-name">
										{r.name}
										<small>{r.note}</small>
									</span>
									<span class="bk__region-cta">
										Sign up
										<span class="bk__sr"> for ThingsBoard Cloud in {r.name}</span>
										<Icon name="tabler:chevron-right" aria-hidden="true" />
									</span>
								</a>
							</li>
						))}
					</ul>
					{id === 'cloud' && (
						<a class="bk__more" href={BOOKEND_CLOUD_PLANS.href}>
							{BOOKEND_CLOUD_PLANS.text}
							<Icon name="tabler:arrow-right" aria-hidden="true" />
						</a>
					)}
				</div>
			)
		}

		{
			ways === 'platforms' && (
				<div class="bk__col">
					<p class="bk__caption">On your servers</p>
					<ul class="bk__chips">
						{BOOKEND_PLATFORMS.map((o) => (
							<li>
								<a class="bk__chip" href={o.href}>
									<SmartImage src={o.logo} alt="" width="90" height="18" loading="lazy" />
									{o.label}
									{o.note && <span class="bk__chip-note">{o.note}</span>}
								</a>
							</li>
						))}
					</ul>
					<a class="bk__more" href={BOOKEND_ALL_OPTIONS.href}>
						{BOOKEND_ALL_OPTIONS.text}
						<Icon name="tabler:arrow-right" aria-hidden="true" />
					</a>
				</div>
			)
		}

		{
			ways === 'paths' && b.paths && (
				<div class="bk__paths">
					<div class="bk__col">
						<span class="bk__pmark" style="--pmark: #3d50f5" aria-hidden="true" set:html={markLight} />
						<p class="bk__path-name">{b.paths.cloud.name}</p>
						<p class="bk__path-line">{b.paths.cloud.line}</p>
						<ul class="bk__regions bk__regions--compact">
							{BOOKEND_REGIONS.map((r) => (
								<li class="bk__region" data-region={r.id}>
									<a href={r.signup} {...externalLinkAttrs(r.signup)}>
										<span class="bk__globe">
											<Icon name="tabler:world" aria-hidden="true" />
										</span>
										<span class="bk__region-name">{r.name}</span>
										<span class="bk__region-cta">
											<span class="bk__sr">Sign up for ThingsBoard Cloud in {r.name}</span>
											<Icon name="tabler:chevron-right" aria-hidden="true" />
										</span>
									</a>
								</li>
							))}
						</ul>
					</div>
					<div class="bk__col">
						<span class="bk__pmark" style="--pmark: #178649" aria-hidden="true" set:html={markLight} />
						<p class="bk__path-name">{b.paths.onprem.name}</p>
						<p class="bk__path-line">{b.paths.onprem.line}</p>
						<a class="bk__btn bk__btn--guide" href="/docs/installation/">
							<Icon name="tabler:server" aria-hidden="true" />
							Installation guide
						</a>
						<a class="bk__more" href={BOOKEND_ALL_OPTIONS.href}>
							{BOOKEND_ALL_OPTIONS.text}
							<Icon name="tabler:arrow-right" aria-hidden="true" />
						</a>
					</div>
				</div>
			)
		}
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	// ---- The two grounds ----------------------------------------------------------------------
	//
	// Everything below reads these, so a tone is one block. DARK is `ClosingCta`'s: `#121425`, white
	// type at the lede's 0.72, the wave in indigo. LIGHT is the product pages' `.page-closing`: the
	// page's own tint, the site's text colours, the wave in the page's accent.
	.bk {
		--bk-ground: #121425;
		--bk-text: #fff;
		--bk-soft: rgba(255, 255, 255, 0.72);
		--bk-muted: rgba(255, 255, 255, 0.6);
		--bk-outline: rgba(255, 255, 255, 0.35);
		--bk-outline-hover: rgba(255, 255, 255, 0.14);
		--bk-wave: #8b9bff;
		--bk-focus: #fff;
		--bk-link: #fff;
		--bk-side: rgba(255, 255, 255, 0.06);
		--bk-side-hover: rgba(255, 255, 255, 0.1);
		--bk-side-icon: rgba(255, 255, 255, 0.08);

		position: relative;
		overflow: hidden;
		// A stacking context, so the field's `z-index: -1` lands above this ground rather than behind it.
		isolation: isolate;
		padding: 96px 0;
		background-color: var(--bk-ground);
		color: var(--bk-text);

		@include media-down(md) {
			padding: 64px 0;
		}

		// The field is another component's markup, which a scoped rule cannot reach.
		:global(.pricing-bg) {
			--pricing-wave-color: var(--bk-wave);
		}
	}

	.bk[data-tone='light'] {
		--bk-ground: var(--bk-band);
		--bk-text: var(--color-text, #17181c);
		--bk-soft: var(--color-text-secondary, #5b616e);
		--bk-muted: var(--color-text-secondary, #5b616e);
		--bk-outline: rgba(15, 23, 42, 0.22);
		--bk-outline-hover: rgba(15, 23, 42, 0.05);
		--bk-wave: var(--bk-accent);
		--bk-focus: var(--bk-accent);
		--bk-link: var(--bk-accent);
		--bk-side: rgba(255, 255, 255, 0.72);
		--bk-side-hover: #fff;
		--bk-side-icon: rgba(15, 23, 42, 0.06);
	}

	a {
		text-decoration: none;
	}

	// The 960 measure inside 20px of padding — `ClosingCta`'s and every card grid's.
	.bk__inner {
		position: relative;
		z-index: 1;
		max-width: calc(960px + #{$spacing-5} * 2);
		margin-inline: auto;
		padding-inline: $spacing-5;
	}

	// ---- Centred (buttons) ---------------------------------------------------------------------

	.bk--center .bk__inner {
		text-align: center;
	}

	.bk__mark {
		display: none;
		align-items: center;
		justify-content: center;
		width: 80px;
		height: 80px;
		margin: 0 auto 14px;
		padding: 12px;
		border-radius: 32%;

		:global(svg) {
			display: block;
			width: 100%;
			height: 100%;
		}
	}

	// The mark itself, white, on the dark ground: no tile. 64px of mark, the tile's 80 less its pad.
	.bk[data-tone='dark'] .bk__mark--dark {
		display: flex;
		width: 64px;
		height: 64px;
		margin-bottom: $spacing-5;
		padding: 0;
		color: #fff;
	}

	.bk[data-tone='light'] .bk__mark--light {
		display: flex;
		padding: 14px;
		color: #fff;
		background: var(--bk-accent);
	}

	.bk__title {
		margin: 0 auto $spacing-5;
		max-width: 28ch;
		font-size: clamp(30px, calc(0.5rem + 2.6vw), 40px);
		font-weight: $font-weight-bold;
		line-height: 1.2;
		text-wrap: balance;
		color: var(--bk-text);
	}

	.bk__lead {
		@include type-body;
		margin: 0 auto $spacing-8;
		max-width: 52ch;
		color: var(--bk-soft);
		text-wrap: pretty;
	}

	.bk__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: $spacing-3;
	}

	// ---- Columns -------------------------------------------------------------------------------
	//
	// The intro left, the way in beside it. Two columns (intro · regions or platforms) share the
	// measure evenly; the two paths make three, the intro a little wider. The title is a step down
	// from the centred one's 40 — 32 at most — so a two-line title fits the narrower column.

	.bk--cols .bk__inner {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: $spacing-10 $spacing-12;
		align-items: start;
		text-align: left;

		@include media-down(lg) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.bk--cols[data-ways='paths'] .bk__inner {
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
		gap: $spacing-10;

		@include media-down(lg) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.bk--cols .bk__title {
		margin: 0 0 $spacing-4;
		max-width: none;
		font-size: clamp(26px, calc(0.5rem + 1.8vw), 32px);
	}

	.bk--cols .bk__lead {
		margin: 0 0 $spacing-6;
		max-width: 44ch;
	}

	.bk--cols .bk__actions {
		justify-content: flex-start;
	}

	.bk__col {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		min-width: 0;
	}

	// The homepage's regions-first form: the regions under the lede, full width of the intro, and the
	// side cards in the second column, centred against it.
	.bk--cols .bk__intro .bk__regions {
		margin-bottom: 0;
	}

	.bk--cols:has(.bk__side) .bk__inner {
		align-items: center;
	}

	.bk__side {
		display: grid;
		gap: $spacing-3;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	// A side door: an icon on a neutral tile, a name over one line, a chevron — no accent anywhere, so
	// the white region cards stay the path. The ground's own white at low alpha, a step up on hover.
	.bk__card {
		display: flex;
		align-items: center;
		gap: $spacing-4;
		padding: $spacing-4;
		border-radius: $radius-lg;
		background: var(--bk-side);
		color: var(--bk-text);
		transition: background-color 0.15s;

		&:hover {
			background: var(--bk-side-hover);

			.bk__card-title {
				text-decoration: underline;
				text-underline-offset: 3px;
			}
		}

		&:focus-visible {
			outline: 2px solid var(--bk-focus);
			outline-offset: 3px;
		}
	}

	.bk__card-icon {
		display: grid;
		flex: none;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 10px;
		background: var(--bk-side-icon);
		color: var(--bk-text);

		:global(svg) {
			width: 20px;
			height: 20px;
		}
	}

	.bk__card-text {
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		min-width: 0;
	}

	.bk__card-title {
		font-size: $font-size-base;
		font-weight: $font-weight-bold;
		line-height: 1.35;
	}

	.bk__card-line {
		font-size: $font-size-sm;
		line-height: 1.5;
		color: var(--bk-soft);
	}

	.bk__card :global(.bk__card-go) {
		flex: none;
		width: 18px;
		height: 18px;
		color: var(--bk-muted);
	}

	.bk__paths {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: $spacing-8;

		@include media-down(md) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	// A path's mark: the platform's squircle, the mark knocked out — the Products section's badge.
	.bk__pmark {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		margin-bottom: $spacing-4;
		padding: 8px;
		border-radius: 12px;
		background: var(--pmark);
		color: #fff;

		:global(svg) {
			display: block;
			width: 100%;
			height: 100%;
		}
	}

	.bk__path-name {
		margin: 0;
		font-size: $font-size-base;
		font-weight: $font-weight-bold;
		line-height: 1.25;
		color: var(--bk-text);
	}

	.bk__path-line {
		margin: $spacing-1 0 $spacing-4;
		font-size: $font-size-sm;
		line-height: 1.5;
		color: var(--bk-soft);
	}

	// What the column is: the primary's own words ("Start free on Cloud"), or the hub's group name.
	.bk__caption {
		margin: 0 0 $spacing-3;
		font-size: $font-size-sm;
		font-weight: $font-weight-bold;
		line-height: 1.5;
		color: var(--bk-text);
	}

	// ---- Buttons -------------------------------------------------------------------------------
	//
	// `ClosingCta`'s geometry, which is the hero pair's: 44 high, 16 across, an 18px glyph.

	.bk__btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 44px;
		padding: 0 16px;
		border-radius: $radius-md;
		font-size: 16px;
		font-weight: $font-weight-bold;
		transition:
			background-color 0.15s,
			border-color 0.15s,
			background-image 0.15s;

		:global(svg) {
			width: 18px;
			height: 18px;
			flex: 0 0 auto;
		}

		&:focus-visible {
			outline: 2px solid var(--bk-focus);
			outline-offset: 3px;
		}
	}

	.bk__btn--primary,
	.bk__btn--guide {
		border: 1px solid var(--bk-accent);
		background-color: var(--bk-accent);
		color: #fff;

		&:hover {
			background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2));
		}
	}

	// The two paths' On-premises guide, in the On-premises green — the installations hub's button.
	.bk__btn--guide {
		--bk-accent: #178649;
	}

	.bk__btn--secondary {
		border: 1px solid var(--bk-outline);
		color: var(--bk-text);

		&:hover {
			background-color: var(--bk-outline-hover);
		}
	}

	// ---- Regions -------------------------------------------------------------------------------
	//
	// The installations hub's rows: a globe in the region's hue, the region over where its data stays,
	// "Sign up" at the end. WHITE on both grounds: on the dark one they pop, and the hues and text are
	// the light ones throughout. Stacked in their column; the compact form (the paths) drops the note,
	// which the column's own line already says, and shows "Sign up" as its chevron alone (the words
	// stay for screen readers) — at 267px "North America" broke beside them.

	.bk__regions {
		display: grid;
		gap: $spacing-3;
		width: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
	}

