---
import { Icon } from 'astro-icon/components';
import PricingBackground from '@components/Pricing/PricingBackground.astro';
import SmartImage from '@components/SmartImage.astro';
import tbMark from '@root/assets/images/landings/draft/thingsboard-mark.svg?raw';
import { inkedMark } from '@util/tb-mark';
import { externalLinkAttrs } from '@util/external-links';
import {
	BOOKEND_ALL_OPTIONS,
	BOOKEND_CLOUD_PLANS,
	BOOKEND_PLATFORMS,
	BOOKEND_REGIONS,
	BOOKENDS,
	type BookendAction,
	type BookendId,
} from '@data/bookends';

/**
 * THE BOOKEND: the band that closes a marketing page, over its footer — the candidate for
 * `ClosingCta` (homepage) and the `.page-closing` bands of the Cloud and On-premises pages, which
 * are three copies of one shape. Judged at `/internal/sections/footer/`; not wired in.
 *
 * The shape: the product's mark, a title, a lead, the way in, a quieter way to ask a person, a note.
 * `id` picks the page's words (`data/bookends.ts`); `ways` picks what the way in is made of:
 *
 * - `buttons` — the primary and the secondary, as all three pages have it today.
 * - `regions` — Cloud's two regions, each a sign-up on its host, IN PLACE OF the primary: sign-up
 *   has to know the region, so the bookend asks it here instead of in a dialog. The secondary stays.
 * - `platforms` — the pair, then four of the On-premises guides as chips and a link to the rest.
 * - `paths` — both platforms side by side, Cloud with its regions, On-premises with its guide and
 *   chips: the installations hub's two sections, as one decision. The homepage's.
 *
 * The regions and guides are the installations hub's own data, so they cannot drift from that page.
 * The pieces are drawn here rather than lifted from `installations/index.astro`, which ships and is
 * not touched to try an idea; once a direction is promoted, the two should share one component.
 *
 * `tone` is the ground: `dark` (the homepage's bookend, `#121425` with the wave in indigo) or `light`
 * (the product pages', their own tint with the wave in their accent). Set as `data-tone`, so the
 * sandbox's switch can flip every instance on the page without re-rendering.
 */

interface Props {
	id: BookendId;
	ways?: 'buttons' | 'regions' | 'platforms' | 'paths';
	tone?: 'dark' | 'light';
	/** Where the homepage's "Talk to an expert" goes; the `live` order passes main's. */
	expertHref?: string;
}

const DEFAULT_WAYS = { home: 'buttons', cloud: 'regions', onprem: 'platforms' } as const;
const DEFAULT_TONE = { home: 'dark', cloud: 'light', onprem: 'light' } as const;

const { id, ways = DEFAULT_WAYS[id], tone = DEFAULT_TONE[id], expertHref } = Astro.props;
const b = BOOKENDS[id];
const ask = b.ask && expertHref ? { ...b.ask, action: { ...b.ask.action, href: expertHref } } : b.ask;

// The mark in both dresses, and CSS shows the one the tone wants: the white tile with the inked mark
// on the dark ground (the homepage's close), the mark knocked out of the accent on the light one (the
// product pages' app logo). Both are rendered so the tone can flip without a re-render.
const markLight = tbMark.replace(/<svg\b/, '<svg aria-hidden="true"');
const markDark = inkedMark();

const style = `--bk-accent: ${b.accent}; --bk-band: ${b.band}`;
const button = (a: BookendAction, kind: 'primary' | 'secondary') => ({ a, kind });
const pair = [button(b.primary, 'primary'), button(b.secondary, 'secondary')];
// The quiet links under the way in, on one row: with the platforms, "All installation options"
// leads it, beside pricing.
const links = [...(ways === 'platforms' ? [BOOKEND_ALL_OPTIONS] : []), ...(b.links ?? [])];
// Regions stand in for the primary; the secondary stays beside the way in.
const after = ways === 'regions' ? [button(b.secondary, 'secondary')] : ways === 'paths' ? [] : pair;
---

<section class="bk" data-tone={tone} data-ways={ways} style={style}>
	<PricingBackground contained />

	<div class="bk__inner">
		<span class="bk__mark bk__mark--dark" aria-hidden="true" set:html={markDark} />
		<span class="bk__mark bk__mark--light" aria-hidden="true" set:html={markLight} />

		<h2 class="bk__title">{b.title}</h2>
		<p class="bk__lead">{b.lead}</p>

		{ways === 'regions' && <p class="bk__caption">{b.primary.text}</p>}
		{
			ways === 'regions' && (
				<ul class="bk__regions">
					{BOOKEND_REGIONS.map((r) => (
						<li class="bk__region" data-region={r.id}>
							<a href={r.signup} {...externalLinkAttrs(r.signup)}>
								<span class="bk__globe">
									<Icon name="tabler:world" aria-hidden="true" />
								</span>
								<span class="bk__region-name">
									{r.name}
									<small>{r.note}</small>
								</span>
								<span class="bk__region-cta">
									Sign up
									<span class="bk__sr"> for ThingsBoard Cloud in {r.name}</span>
									<Icon name="tabler:chevron-right" aria-hidden="true" />
								</span>
							</a>
						</li>
					))}
				</ul>
			)
		}

		{
			ways === 'paths' && b.paths && (
				<div class="bk__paths">
					<div class="bk__path bk__path--cloud">
						<p class="bk__path-name">{b.paths.cloud.name}</p>
						<p class="bk__path-line">{b.paths.cloud.line}</p>
						<ul class="bk__regions">
							{BOOKEND_REGIONS.map((r) => (
								<li class="bk__region" data-region={r.id}>
									<a href={r.signup} {...externalLinkAttrs(r.signup)}>
										<span class="bk__globe">
											<Icon name="tabler:world" aria-hidden="true" />
										</span>
										<span class="bk__region-name">
											{r.name}
											<small>{r.note}</small>
										</span>
										<span class="bk__region-cta">
											Sign up
											<span class="bk__sr"> for ThingsBoard Cloud in {r.name}</span>
											<Icon name="tabler:chevron-right" aria-hidden="true" />
										</span>
									</a>
								</li>
							))}
						</ul>
						<a class="bk__more bk__more--foot" href={BOOKEND_CLOUD_PLANS.href}>
							{BOOKEND_CLOUD_PLANS.text}
							<Icon name="tabler:arrow-right" aria-hidden="true" />
						</a>
					</div>
					<div class="bk__path bk__path--onprem">
						<p class="bk__path-name">{b.paths.onprem.name}</p>
						<p class="bk__path-line">{b.paths.onprem.line}</p>
						<a class="bk__btn bk__btn--guide" href="/docs/installation/">
							<Icon name="tabler:server" aria-hidden="true" />
							Installation guide
						</a>
						<ul class="bk__chips">
							{BOOKEND_PLATFORMS.map((o) => (
								<li>
									<a class="bk__chip" href={o.href}>
										<SmartImage src={o.logo} alt="" width="90" height="18" loading="lazy" />
										{o.label}
										{o.note && <span class="bk__chip-note">{o.note}</span>}
									</a>
								</li>
							))}
						</ul>
						<a class="bk__more bk__more--foot" href={BOOKEND_ALL_OPTIONS.href}>
							{BOOKEND_ALL_OPTIONS.text}
							<Icon name="tabler:arrow-right" aria-hidden="true" />
						</a>
					</div>
				</div>
			)
		}

		{
			after.length > 0 && (
				<div class="bk__actions">
					{after.map(({ a, kind }) => (
						<a class:list={['bk__btn', `bk__btn--${kind}`]} href={a.href} {...a.attrs}>
							<Icon name={a.icon} aria-hidden="true" />
							{a.text}
						</a>
					))}
				</div>
			)
		}

		{
			ways === 'platforms' && (
				<div class="bk__platforms">
					<ul class="bk__chips">
						{BOOKEND_PLATFORMS.map((o) => (
							<li>
								<a class="bk__chip" href={o.href}>
									<SmartImage src={o.logo} alt="" width="90" height="18" loading="lazy" />
									{o.label}
									{o.note && <span class="bk__chip-note">{o.note}</span>}
								</a>
							</li>
						))}
					</ul>
				</div>
			)
		}

		{
			links.length > 0 && (
				<p class="bk__links">
					{links.map((l) => (
						<a class="bk__more" href={l.href}>
							{l.text}
							<Icon name="tabler:arrow-right" aria-hidden="true" />
						</a>
					))}
				</p>
			)
		}

		{
			ask && (
				<div class="bk__ask">
					<p class="bk__ask-label">{ask.label}</p>
					<a class="bk__btn bk__btn--secondary" href={ask.action.href}>
						<Icon name={ask.action.icon} aria-hidden="true" />
						{ask.action.text}
					</a>
				</div>
			)
		}

		{
			b.cross && (
				<p class="bk__cross">
					{b.cross.lead} <a href={b.cross.link.href}>{b.cross.link.text}</a>
					{b.cross.tail}
				</p>
			)
		}

		{
			b.note && (
				<p class="bk__note">
					<a href={b.note.href}>{b.note.text}</a>
				</p>
			)
		}
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	// ---- The two grounds ----------------------------------------------------------------------
	//
	// Everything below reads these, so a tone is one block. DARK is `ClosingCta`'s: `#121425`, white
	// type at the lede's 0.72, the wave in indigo. LIGHT is the product pages' `.page-closing`: the
	// page's own tint, the site's text colours, the wave in the page's accent.
	.bk {
		--bk-ground: #121425;
		--bk-text: #fff;
		--bk-soft: rgba(255, 255, 255, 0.72);
		--bk-muted: rgba(255, 255, 255, 0.6);
		--bk-outline: rgba(255, 255, 255, 0.35);
		--bk-outline-hover: rgba(255, 255, 255, 0.14);
		--bk-card: rgba(255, 255, 255, 0.07);
		--bk-card-hover: rgba(255, 255, 255, 0.12);
		--bk-panel: rgba(255, 255, 255, 0.04);
		--bk-wave: #8b9bff;
		--bk-focus: #fff;
		--bk-link: #fff;
		--bk-us: #8b9bff;
		--bk-eu: #2dd4bf;

		position: relative;
		overflow: hidden;
		// A stacking context, so the field's `z-index: -1` lands above this ground rather than behind it.
		isolation: isolate;
		padding: 96px 0;
		background-color: var(--bk-ground);
		color: var(--bk-text);

		@include media-down(md) {
			padding: 64px 0;
		}

		// The field is another component's markup, which a scoped rule cannot reach.
		:global(.pricing-bg) {
			--pricing-wave-color: var(--bk-wave);
		}
	}

	.bk[data-tone='light'] {
		--bk-ground: var(--bk-band);
		--bk-text: var(--color-text, #17181c);
		--bk-soft: var(--color-text-secondary, #5b616e);
		--bk-muted: var(--color-text-secondary, #5b616e);
		--bk-outline: rgba(15, 23, 42, 0.22);
		--bk-outline-hover: rgba(15, 23, 42, 0.05);
		--bk-card: #fff;
		--bk-card-hover: #fff;
		--bk-panel: rgba(255, 255, 255, 0.72);
		--bk-wave: var(--bk-accent);
		--bk-focus: var(--bk-accent);
		--bk-link: var(--bk-accent);
		--bk-us: #3d50f5;
		--bk-eu: #0f9b8e;
	}

	a {
		text-decoration: none;
	}

	// The 960 measure inside 20px of padding — `ClosingCta`'s and every card grid's.
	.bk__inner {
		position: relative;
		z-index: 1;
		max-width: calc(960px + #{$spacing-5} * 2);
		margin-inline: auto;
		padding-inline: $spacing-5;
		text-align: center;
	}

	// ---- Mark, title, lead ---------------------------------------------------------------------

	.bk__mark {
		display: none;
		align-items: center;
		justify-content: center;
		width: 80px;
		height: 80px;
		margin: 0 auto 14px;
		padding: 12px;
		border-radius: 32%;

		:global(svg) {
			display: block;
			width: 100%;
			height: 100%;
		}
	}

	.bk[data-tone='dark'] .bk__mark--dark {
		display: flex;
		color: #000;
		background: linear-gradient(155deg, #fff 35%, color-mix(in srgb, #3d50f5 5%, #fff) 100%);
	}

	.bk[data-tone='light'] .bk__mark--light {
		display: flex;
		padding: 14px;
		color: #fff;
		background: var(--bk-accent);
	}

	.bk__title {
		margin: 0 auto $spacing-5;
		max-width: 28ch;
		font-size: clamp(30px, calc(0.5rem + 2.6vw), 40px);
		font-weight: $font-weight-bold;
		line-height: 1.2;
		text-wrap: balance;
		color: var(--bk-text);
	}

	.bk__lead {
		@include type-body;
		margin: 0 auto $spacing-8;
		max-width: 52ch;
		color: var(--bk-soft);
		text-wrap: pretty;
	}

	// ---- Buttons -------------------------------------------------------------------------------
	//
	// `ClosingCta`'s geometry, which is the hero pair's: 44 high, 16 across, an 18px glyph.

	.bk__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: $spacing-3;
	}

	.bk__btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 44px;
		padding: 0 16px;
		border-radius: $radius-md;
		font-size: 16px;
		font-weight: $font-weight-bold;
		transition:
			background-color 0.15s,
			border-color 0.15s,
			background-image 0.15s;

		:global(svg) {
			width: 18px;
			height: 18px;
			flex: 0 0 auto;
		}

		&:focus-visible {
			outline: 2px solid var(--bk-focus);
			outline-offset: 3px;
		}
	}

	.bk__btn--primary,
	.bk__btn--guide {
		border: 1px solid var(--bk-accent);
		background-color: var(--bk-accent);
		color: #fff;

		&:hover {
			background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2));
		}
	}

	// The homepage's two-path form: the On-premises guide in the On-premises green, beside Cloud's
	// regions in theirs — the installations hub's own button.
	.bk__btn--guide {
		--bk-accent: #178649;
	}

	.bk__btn--secondary {
		border: 1px solid var(--bk-outline);
		color: var(--bk-text);

		&:hover {
			background-color: var(--bk-outline-hover);
		}
	}

	// ---- Regions -------------------------------------------------------------------------------
	//
	// The installations hub's rows: a globe in the region's hue, the region over where its data stays,
	// "Sign up" at the end. Two across in the centred column; one on a phone.

	// What the regions are: the primary's own words ("Start free on Cloud"), over them.
	.bk__caption {
		margin: 0 0 $spacing-3;
		font-size: $font-size-sm;
		font-weight: $font-weight-bold;
		line-height: 1.5;
		color: var(--bk-text);
	}

	// 820, not the hub's 480 a row: two across, and the longer note ("Data stored in the European
	// Union", ~230px at 14) holds one line beside the globe and "Sign up" — at 640 both broke, at
	// 760 Europe's still did.
	.bk__regions {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: $spacing-3;
		max-width: 820px;
		margin: 0 auto $spacing-6;
		padding: 0;
		list-style: none;
		text-align: left;

		@include media-down(md) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.bk__region {
		--region-hue: var(--bk-us);

		&[data-region='eu'] {
			--region-hue: var(--bk-eu);
		}

		a {
			display: flex;
			align-items: center;
			gap: $spacing-3;
			padding: $spacing-3 $spacing-4;
			border-radius: $radius-lg;
			background: var(--bk-card);
			color: var(--bk-text);
			transition:
				background-color 0.15s,
				box-shadow 0.15s;

			&:hover {
				background: var(--bk-card-hover);
			}

			&:focus-visible {
				outline: 2px solid var(--bk-focus);
				outline-offset: 3px;
			}
		}
	}

	.bk[data-tone='light'] .bk__region a {
		box-shadow:
			0 1px 2px rgba(23, 24, 28, 0.06),
			0 6px 18px rgba(23, 24, 28, 0.06);

		&:hover {
			box-shadow:
				0 1px 2px rgba(23, 24, 28, 0.08),
				0 10px 24px rgba(23, 24, 28, 0.1);
		}
	}

	.bk__globe {
		display: grid;
		flex: none;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 50%;
		background: color-mix(in srgb, var(--region-hue) 16%, transparent);
		color: var(--region-hue);

		:global(svg) {
			width: 20px;
			height: 20px;
		}
	}

	.bk__region-name {
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		min-width: 0;
		font-weight: $font-weight-bold;
		line-height: 1.3;

		small {
			font-size: $font-size-sm;
			font-weight: $font-weight-normal;
			line-height: 1.5;
			color: var(--bk-muted);
		}
	}

	.bk__region-cta {
		display: inline-flex;
		flex: none;
		align-items: center;
		gap: $spacing-1;
		font-size: $font-size-sm;
		font-weight: $font-weight-bold;
		color: var(--region-hue);
		white-space: nowrap;

		:global(svg) {
			width: 18px;
			height: 18px;
		}
	}

	// ---- Platforms -----------------------------------------------------------------------------
	//
	// The hub's chips: a wordmark and the name, each to its guide. White in both tones — the
	// wordmarks are drawn for a light ground, and Docker's penguin and apple are black.

	.bk__platforms {
		margin-top: $spacing-6;
	}

	.bk__chips {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: $spacing-2;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.bk__chip {
		display: inline-flex;
		align-items: center;
		gap: $spacing-2;
		height: 40px;
		padding: 0 $spacing-4;
		border: 1px solid rgba(23, 24, 28, 0.12);
		border-radius: $radius-full;
		background: #fff;
		color: #17181c;
		font-size: $font-size-base;
		font-weight: $font-weight-medium;
		white-space: nowrap;
		transition: border-color 0.15s;

		:global(img) {
			width: auto;
			height: 20px;
		}

		&:hover {
			border-color: rgba(23, 24, 28, 0.36);
		}

		&:focus-visible {
			outline: 2px solid var(--bk-focus);
			outline-offset: 3px;
		}
	}

	.bk[data-tone='dark'] .bk__chip {
		border-color: transparent;

		&:hover {
			border-color: rgba(255, 255, 255, 0.6);
		}
	}

	.bk__chip-note {
		color: #5b616e;
		font-weight: $font-weight-normal;
	}

	// ---- Links, the ask, the line across, the note ---------------------------------------------

	.bk__more {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		margin-top: $spacing-4;
		font-size: $font-size-sm;
		font-weight: $font-weight-medium;
		line-height: 1.5;
		color: var(--bk-link);

		:global(svg) {
			width: 16px;
			height: 16px;
			transition: transform 0.15s;
		}

		&:hover {
			text-decoration: underline;
			text-underline-offset: 3px;

			:global(svg) {
				transform: translateX(2px);
			}
		}
	}

	.bk__links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0 $spacing-6;
		margin: $spacing-2 0 0;
	}

	// The last link in a path's panel sits on its foot, so the two panels end on one line.
	.bk__more--foot {
		margin-top: auto;
		padding-top: $spacing-4;
	}

	.bk__ask {
		margin-top: $spacing-8;
	}

	.bk__ask-label {
		@include type-body;
		margin: 0 0 $spacing-3;
		color: var(--bk-soft);
	}

	.bk__cross {
		margin: $spacing-6 0 0;
		font-size: $font-size-sm;
		line-height: 1.5;
		color: var(--bk-muted);

		a {
			font-weight: $font-weight-medium;
			color: var(--bk-text);
			text-decoration: underline;
			text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
			text-underline-offset: 3px;

			&:hover {
				text-decoration-color: currentColor;
			}
		}
	}

	.bk__note {
		margin: $spacing-6 0 0;
		font-size: $font-size-sm;
		line-height: 1.5;

		a {
			color: var(--bk-muted);
			text-decoration: underline;
			text-underline-offset: 3px;

			&:hover {
				color: var(--bk-text);
			}
		}
	}

	// ---- Two paths (the homepage's) ------------------------------------------------------------
	//
	// Cloud and On-premises side by side, each on a panel of its own: its name, one line, its way in.
	// Left-aligned inside the centred band, as the installations hub sets them. One column on a phone.

	.bk__paths {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: $spacing-5;
		text-align: left;

		@include media-down(md) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.bk__path {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: $spacing-6;
		border-radius: $radius-xl;
		background: var(--bk-panel);

		@include media-down(md) {
			padding: $spacing-5;
		}

		.bk__regions {
			grid-template-columns: minmax(0, 1fr);
			width: 100%;
			max-width: none;
			margin: 0;
		}

		.bk__chips {
