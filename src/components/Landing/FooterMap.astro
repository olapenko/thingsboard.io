---
import { Icon } from 'astro-icon/components';
import NavIcon from '@components/Landing/NavIcon.astro';
import SmartImage from '@components/SmartImage.astro';
import logo from '@root/assets/images/landings/thingsboard-logo.svg?raw';
import tbMark from '@root/assets/images/landings/draft/thingsboard-mark.svg?raw';
import { socialNetworks } from '@data/socialNetworks';
import {
	FOOTER_COLUMNS,
	FOOTER_ECOSYSTEM,
	FOOTER_HIGHLIGHTS,
	FOOTER_LEGAL,
	FOOTER_NEWSLETTER,
	FOOTER_LICENSE_PORTAL,
	FOOTER_PLATFORM_LINKS,
	FOOTER_PLATFORMS,
	FOOTER_SOCIAL,
	FOOTER_TAGLINE,
	type FooterProduct,
} from '@data/footer-map';

/**
 * A FOOTER THAT MAPS THE PLATFORM — the candidate for `Landing/Footer`, judged at
 * `/internal/sections/footer/`. On the homepage for running orders A and B (`footer: 'map'` in
 * `data/home-compositions.ts`); every other page keeps `Landing/Footer`.
 *
 * The one in use is a newsletter, four award badges, six links and the social row. It says nothing
 * about what ThingsBoard is made of, which is the one thing a reader who has scrolled to the bottom
 * of any page is still asking. This one answers it in three tiers, top to bottom:
 *
 * 1. THE BRAND ROW: the logo, one sentence on what it is, the three channels that are kept up; the newsletter beside it.
 * 2. THE PLATFORM, as the Products menu groups it: the two ways to run it, then the six products
 *    around it, each with its mark, its hue and one line. `layout` decides how much room that takes:
 *    - `map`: a panel of tiles, name and line under each mark — the platform unpacked.
 *    - `focus`: one "Platform" group of four peers — ThingsBoard Cloud, ThingsBoard, Pricing,
 *      Installation options — a mark and a name each; the ecosystem moves to a link column, the
 *      License Portal at its foot.
 * 3. FOUR LINK COLUMNS: the solutions, the developer references, services and partners, the
 *    company. Then the bottom line: copyright, the cookie policy, the badges.
 *
 * THE GROUND is black (2026-09-30). It was the bookends' `#121425` with a hairline under the closing
 * band; black is a clear step down from the band's indigo rather than a continuation of it, so the
 * seam needs no line. Not the `#0f161d` the footer in use has, which sat NEAR the band's ground
 * without matching it — the near-miss the closing band's own note warns about.
 *
 * THE MEASURE is the page's: 960 inside 20px of padding, the construction `ClosingCta` and every
 * card grid use, so the footer's left edge is the edge of everything above it.
 */

interface Props {
	layout?: 'map' | 'focus';
	/** The element's id. Only the page's own footer takes one (`footer`); the sandbox's several do not. */
	id?: string;
}

const { layout = 'map', id } = Astro.props;

// Ids for the form's label and field, per render: the sandbox shows several footers on one page, and
// a duplicated id points every label at the first field.
const uid = `fm-${Math.random().toString(36).slice(2, 10)}`;

// The logo in the ink of whatever it sits in, instead of the old footer's CSS `filter` that pushed a
// dark background image to white.
const logoSvg = logo.replace(/fill="#212529"/g, 'fill="currentColor"').replace(/<svg\b/, '<svg aria-hidden="true"');

const year = new Date().getFullYear();

// The kept-up channels, in `FOOTER_SOCIAL`'s order, with their links from the shared list.
const social = FOOTER_SOCIAL.map(({ icon, name }) => {
	const n = socialNetworks.find((x) => x.icon === icon);
	return n && { ...n, name };
}).filter((n) => n !== undefined);

const isTabler = (p: FooterProduct) => p.icon.startsWith('tabler:');

// `focus`: the ecosystem as the first link column, and no column repeats a page the panel shows.
const focus = layout === 'focus';
const highlighted = new Set(FOOTER_HIGHLIGHTS.map((h) => h.href));
const columns = focus
	? [
			{
				// The License Portal last: the one thing in the column that is an account, not a product.
				title: 'Ecosystem',
				links: [
					...FOOTER_ECOSYSTEM.map((p) => ({ label: p.name, href: p.href, external: p.external })),
					{ label: FOOTER_LICENSE_PORTAL.label, href: FOOTER_LICENSE_PORTAL.href, external: true },
				],
			},
			...FOOTER_COLUMNS.map((c) => ({ ...c, links: c.links.filter((l) => !highlighted.has(l.href)) })),
		]
	: FOOTER_COLUMNS;
const ext = (external?: boolean) => (external ? { target: '_blank', rel: 'noopener noreferrer' } : {});
---

<footer id={id} class:list={['fm', `fm--${layout}`]}>
	<div class="fm__inner">
		<div class="fm__top">
			<div class="fm__brand">
				<a href="/" class="fm__logo" aria-label="ThingsBoard home" set:html={logoSvg} />
				<p class="fm__tagline">{FOOTER_TAGLINE}</p>
			</div>

			<div class="fm__keep">
				{
					/* The same MailerLite endpoint and field names as the footer in use, posted natively. The
			    footer in use does the same today: its script waits for a "Sign up for news" button this
			    branch removed, so MailerLite's own script never loads there either. */
				}
				<form class="fm__news" action={FOOTER_NEWSLETTER.action} method="POST" target="_blank">
					<label class="fm__news-label" for={`${uid}-email`}>{FOOTER_NEWSLETTER.label}</label>
					<p class="fm__news-lede" id={`${uid}-lede`}>{FOOTER_NEWSLETTER.lede}</p>
					<div class="fm__field">
						<input
							id={`${uid}-email`}
							type="email"
							name="fields[email]"
							required
							placeholder="you@company.com"
							autocomplete="email"
							spellcheck="false"
							autocapitalize="off"
							aria-describedby={`${uid}-lede`}
						/>
						<input type="hidden" name="ml-submit" value="1" />
						<button type="submit">Subscribe</button>
					</div>
					<p class="fm__consent">{FOOTER_NEWSLETTER.consent}</p>
				</form>
				{
					/* The kept-up channels, as a quiet line under the form: the same "keep up" block, but links,
				    not buttons. As bordered buttons behind a rule they outweighed the form they follow;
				    under the tagline they split the two ways of keeping up across the row. */
				}
				<p class="fm__follow">
					<span class="fm__follow-label">Follow</span>
					{
						social.map((n) => (
							<a href={n.href} target="_blank" rel="noopener noreferrer">
								{n.icon && <Icon name={n.icon} aria-hidden="true" />}
								{n.name}
							</a>
						))
					}
				</p>
			</div>
		</div>

		<nav class="fm__map" aria-label="Products">
			{
				/* `focus`: ONE group, "Platform" — the product in its two forms and the two pages that
			    decide it, as four peers with a mark and a name each and no line. The other layouts:
			    the two platforms with a line each, as the Products menu has them. */
			}
			<div class="fm__group fm__group--run">
				<h2 class="fm__kicker">{focus ? 'Platform' : 'IoT platforms'}</h2>
				<ul class="fm__products">
					{
						FOOTER_PLATFORMS.map((p) => (
							<li>
								<a class="fm__product fm__product--platform" href={p.href} style={`--hue: ${p.hue}`}>
									<span class="fm__mark fm__mark--badge">
										<NavIcon src={p.icon} size={36} />
									</span>
									<span class="fm__pname">{p.name}</span>
									{!focus && <span class="fm__pline">{p.line}</span>}
								</a>
							</li>
						))
					}
					{
						focus &&
							FOOTER_HIGHLIGHTS.map((l) => (
								<li>
									<a class="fm__product" href={l.href} style="--hue: #8b9bff">
										<span class="fm__mark">
											<Icon name={l.icon} aria-hidden="true" />
										</span>
										<span class="fm__pname">{l.label}</span>
									</a>
								</li>
							))
					}
				</ul>
			</div>

			{
				!focus && (
					<Fragment>
						<div class="fm__group fm__group--eco">
							<h2 class="fm__kicker">Product ecosystem</h2>
							<ul class="fm__products">
								{FOOTER_ECOSYSTEM.map((p) => (
									<li>
										<a class="fm__product" href={p.href} style={`--hue: ${p.hue}`} {...ext(p.external)}>
											<span class="fm__mark">
												{p.icon === 'mark' ? (
													<span class="fm__tbmark" set:html={tbMark} />
												) : isTabler(p) ? (
													<Icon name={p.icon} aria-hidden="true" />
												) : (
													<NavIcon src={p.icon} size={26} />
												)}
											</span>
											<span class="fm__pname">
												{p.name}
												{p.external && (
													<Icon name="tabler:arrow-up-right" class="fm__ext" aria-label="(opens a new site)" />
												)}
											</span>
											<span class="fm__pline">{p.line}</span>
										</a>
									</li>
								))}
							</ul>
						</div>
						{/* Across the whole map, under both groups: the platform's next steps on the left, set as
					    the columns' "All use cases →"; the License Portal at the right end, captioned, for the
					    customer who is past choosing. */}
						<div class="fm__next">
							<ul class="fm__plinks">
								{FOOTER_PLATFORM_LINKS.map((l) => (
									<li>
										<a href={l.href}>
											{l.label}
											<Icon name="tabler:arrow-right" aria-hidden="true" />
										</a>
									</li>
								))}
							</ul>
							<p class="fm__portal">
								<span>{FOOTER_LICENSE_PORTAL.caption}</span>
								<a href={FOOTER_LICENSE_PORTAL.href} target="_blank" rel="noopener noreferrer">
									{FOOTER_LICENSE_PORTAL.label}
									<Icon name="tabler:arrow-up-right" aria-hidden="true" />
									<span class="fm__sr">(opens a new site)</span>
								</a>
							</p>
						</div>
					</Fragment>
				)
			}
		</nav>

		<nav class="fm__cols" aria-label="Site">
			{
				columns.map((col) => (
					<div class="fm__col">
						<h2 class="fm__col-title">{col.title}</h2>
						<ul>
							{col.links.map((l) => (
								<li>
									<a href={l.href} {...ext(l.external)}>
										{l.label}
										{l.external && (
											<Icon name="tabler:arrow-up-right" class="fm__ext" aria-label="(opens a new site)" />
										)}
									</a>
								</li>
							))}
						</ul>
						{col.more && (
							<a class="fm__more" href={col.more.href}>
								{col.more.label}
								<Icon name="tabler:arrow-right" aria-hidden="true" />
							</a>
						)}
						{col.sub && (
							<>
								<h3 class="fm__col-title fm__col-title--sub">{col.sub.title}</h3>
								<ul>
									{col.sub.links.map((l) => (
										<li>
											<a href={l.href}>{l.label}</a>
										</li>
									))}
								</ul>
								{col.sub.more && (
									<a class="fm__more" href={col.sub.more.href}>
										{col.sub.more.label}
										<Icon name="tabler:arrow-right" aria-hidden="true" />
									</a>
								)}
							</>
						)}
					</div>
				))
			}
		</nav>

		<div class="fm__base">
			<div class="fm__legalblock">
				<p class="fm__copy">&copy; {year} The ThingsBoard Authors</p>
				<ul class="fm__legal" aria-label="Legal">
					{
						FOOTER_LEGAL.map((l) => (
							<li>
								<a href={l.href}>{l.label}</a>
							</li>
						))
					}
				</ul>
			</div>
			<div class="fm__badges">
				<SmartImage
					src="/src/assets/images/landings/footer/crozdesk-quality-choice-badge.png"
					alt="Crozdesk Quality Choice"
					height="64"
					width="64"
				/>
				<SmartImage
					src="/src/assets/images/landings/footer/crozdesk-trusted-vendor-badge.png"
					alt="Crozdesk Trusted Vendor"
					height="64"
					width="64"
				/>
				<SmartImage
					src="/src/assets/images/landings/footer/crozdesk-happiest-users-badge.png"
					alt="Crozdesk Happiest Users"
					height="64"
					width="64"
				/>
				<SmartImage
					src="/src/assets/images/landings/footer/supplier-retail.webp"
					alt="Top Supplier in Retail 2024"
					height="64"
					width="44"
				/>
			</div>
		</div>
	</div>
</footer>

<style lang="scss">
	@use '../../styles/variables' as *;

	// Every shade here is white at an alpha over the one ground, so the whole footer retunes from
	// `--fm-ground`. Measured on black: 0.64 is 8.1:1, 0.5 is 5.3:1 — both clear AA for 14px type.
	.fm {
		--fm-ground: #000;
		--fm-text: #fff;
		--fm-soft: rgba(255, 255, 255, 0.72);
		--fm-muted: rgba(255, 255, 255, 0.64);
		--fm-faint: rgba(255, 255, 255, 0.5);
		--fm-rule: rgba(255, 255, 255, 0.09);
		// 7% on black (#121212): at the 4% it had on #121425 the panel vanished once the ground went
		// black, and without a rim the fill is the only thing that makes it a panel.
		--fm-panel: rgba(255, 255, 255, 0.07);
		--fm-hover: rgba(255, 255, 255, 0.06);
		--fm-focus: #8b9bff;

		// From the top: a trace of the closing band's indigo where the footer meets it, settling to
		// black just past halfway. (Tried the other way, black at the top into indigo at the foot.)
		// #08091a, half the lift of the #0d0f24 first tried: a hint under the band, not a band of its own.
		background: linear-gradient(180deg, #08091a 0%, var(--fm-ground) 55%);
		color: var(--fm-text);

		a {
			color: inherit;
			text-decoration: none;
		}

		a:focus-visible,
		button:focus-visible,
		input:focus-visible {
			outline: 2px solid var(--fm-focus);
			outline-offset: 2px;
			border-radius: 4px;
		}

		// Resets at a single class's weight (`:where` adds nothing), so each piece's own margin below
		// beats them. As `.fm ul` / `.fm h2` they outranked every one: the column titles lost their
		// 12px, the social row its rule and the platforms' links their 16px.
		:where(ul) {
			list-style: none;
			margin: 0;
			padding: 0;
		}

		:where(h2, h3) {
			margin: 0;
		}
	}

	.fm__inner {
		max-width: calc(960px + #{$spacing-5} * 2);
		margin-inline: auto;
		padding: $spacing-16 $spacing-5 $spacing-8;

		@include media-down(md) {
			padding-top: $spacing-12;
		}
	}

	// ---- 1. Brand row ------------------------------------------------------------------------

	.fm__top {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 400px);
		gap: $spacing-10 $spacing-16;
		align-items: start;
		padding-bottom: $spacing-10;

		// Side by side down to a tablet, the form narrowing first; stacked on a phone.
		@include media-down(lg) {
			grid-template-columns: minmax(0, 1fr) minmax(0, 340px);
			column-gap: $spacing-10;
		}

		@include media-down(md) {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	.fm__logo {
		display: inline-flex;
		color: #fff;

		:global(svg) {
			display: block;
			width: 168px;
			height: auto;
		}
	}

	.fm__tagline {
		margin: $spacing-3 0 0;
		max-width: 38ch;
		@include type-body;
		color: var(--fm-soft);
		text-wrap: pretty;
	}

	// "Follow" and three named links on one line: 14px, the columns' link colour, no rims. The icon
	// carries the channel at a glance, the name makes it a link you can read.
	.fm__follow {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: $spacing-2 $spacing-5;
		margin: $spacing-5 0 0;
		font-size: $font-size-sm;
		line-height: 1.5;

		a {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			color: var(--fm-muted);
			transition: color 0.15s;

			&:hover {
				color: #fff;
				text-decoration: underline;
				text-underline-offset: 3px;
			}
		}

		:global(svg) {
			width: 18px;
			height: 18px;
		}
	}

	.fm__follow-label {
		color: var(--fm-faint);
	}

	.fm__news-label {
		display: block;
		font-size: $font-size-base;
		font-weight: $font-weight-bold;
		line-height: 1.5;
	}

	.fm__news-lede {
		margin: $spacing-1 0 $spacing-3;
		font-size: $font-size-sm;
		line-height: 1.5;
		color: var(--fm-muted);
	}

	// Field and button as one control: the seam is the button's own left edge.
	.fm__field {
		display: flex;
		height: 44px;

		input[type='email'] {
			flex: 1 1 auto;
			min-width: 0;
			height: 100%;
			padding: 0 14px;
			border: 1px solid rgba(255, 255, 255, 0.16);
			border-right: 0;
			border-radius: $radius-md 0 0 $radius-md;
			background: rgba(255, 255, 255, 0.05);
			color: #fff;
			font: inherit;
			font-size: $font-size-base;

			&::placeholder {
				color: var(--fm-faint);
			}

			&:hover {
				border-color: rgba(255, 255, 255, 0.28);
			}

			&:focus-visible {
				border-radius: $radius-md 0 0 $radius-md;
				outline-offset: -1px;
			}
		}

		button {
			flex: 0 0 auto;
			height: 100%;
			padding: 0 18px;
			border: 0;
			border-radius: 0 $radius-md $radius-md 0;
			background-color: var(--color-brand, #3d50f5);
			color: #fff;
			font: inherit;
			font-size: $font-size-base;
			font-weight: $font-weight-bold;
			cursor: pointer;

			// The site's primary hover, as "Try for free" in the header and the bookend have it: the fill
			// darkened by a black overlay, 20% on hover and 30% pressed — it lightened toward white before,
			// the one primary that went the other way. No shimmer: it is a form's submit, not a way on.
			&:hover {
				background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2));
			}

			&:active {
				background-image: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3));
			}
		}
	}

	.fm__consent {
		margin: $spacing-2 0 0;
		font-size: $font-size-xs;
		line-height: 1.5;
		color: var(--fm-faint);
	}

	// ---- 2. The platform ---------------------------------------------------------------------

	// The platforms' column is as wide as its longest line needs — "Deploy it inside your own
	// network", 201px at 13px, beside the 40px mark and its 12px gap — and the ecosystem takes the
	// rest. At 1fr/2fr the ecosystem's lines got 140px and "Dedicated MQTT broker" (142) broke; at
	// 256 they get 153.
	.fm__map {
		display: grid;
		grid-template-columns: 256px minmax(0, 1fr);
		gap: $spacing-8;
		padding: $spacing-6;
		// A fill, no rim: the panel is one of five strokes in a footer that had too many, and the
		// ground alone sets it apart.
		border-radius: $radius-xl;
		background: var(--fm-panel);

		@include media-down(lg) {
			grid-template-columns: minmax(0, 1fr);
			gap: $spacing-6;
		}

		@include media-down(md) {
			padding: $spacing-4;
		}
	}

	.fm__kicker {
		margin: 0 0 $spacing-3;
		font-size: $font-size-xs;
		font-weight: $font-weight-medium;
		line-height: 1.5;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--fm-faint);
	}

	.fm__group--run {
		display: flex;
		flex-direction: column;
	}

	.fm__group--run .fm__products {
		display: grid;
		gap: $spacing-1;

		// Tablet: the map is one column there, so the two platforms go side by side rather than
		// stacking over the ecosystem's grid.
		@media (min-width: $breakpoint-md) and (max-width: #{$breakpoint-lg - 1px}) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	// Three across down to a tablet; one on a phone, where two across left the names 98px and
	// "Trendz Analytics" and "Mobile Application" broke. One column there is the menu's own shape.
	.fm__group--eco .fm__products {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: $spacing-1;

		@include media-down(md) {
			grid-template-columns: minmax(0, 1fr);
			gap: 0;
		}
	}

	// One product: its mark, its name, its line. The whole tile is the link.
	.fm__product {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		grid-template-rows: auto auto;
		column-gap: $spacing-3;
		align-items: center;
		padding: 10px 0;

		// Hover is the name underlined and nothing else: no ground under the tile, no hue on the line.
		// A lit tile read as a button in a panel that is a list of links.
		&:hover .fm__pname {
			text-decoration: underline;
			text-underline-offset: 3px;
		}
	}

	.fm__mark {
		grid-row: 1 / span 2;
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 12px;
		color: var(--hue);
		// The ecosystem's glyphs sit on a wash of their own hue: the Products section's badges in
		// outline, so the six read as a family beside the two filled platform badges.
		background: color-mix(in srgb, var(--hue) 14%, transparent);

		// The nav glyphs are drawn inside a 54 box with ~5 of air on each side, so 26 here shows a
		// ~22px glyph: the tile's 40 less 9 on each side, the proportion of the Products badges.
		:global(svg) {
			width: 26px;
			height: 26px;
			display: block;
		}
	}

	// The ThingsBoard mark (the Mobile App's): drawn to its box edge, so it runs smaller than the
	// nav glyphs, whose 54 box carries air — 20 here reads as their 26.
	.fm__tbmark {
		display: grid;
		width: 20px;
		height: 20px;
	}

	// Heavier than the marks' own svg size (26), so the mark fills its box.
	.fm .fm__mark .fm__tbmark :global(svg) {
		width: 100%;
		height: 100%;
	}

