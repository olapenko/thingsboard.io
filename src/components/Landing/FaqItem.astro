---
import { Icon } from 'astro-icon/components';

/**
 * One question of a product page's FAQ (`ProductFaq`), as a native `<details>`: it opens without a
 * script, and the browser's find-in-page opens the one a match is in.
 *
 * The states are the standalone link's: the accent with a 1px underline on hover, 2px pressed, the
 * site's ring on focus. The chevron is inside the click target and lights with the words, since
 * lighting half a row reads as a bug rather than as a state.
 *
 * COPY LINK, as main's Pricing FAQ has it: an answer with an id gets a link icon in the row's right
 * rail, before the chevron — shown on hover and focus, always on a touch screen (no hover to find it
 * by) — that copies the page's address with the answer's id as its hash; "Copy link" on hover,
 * "Copied" for two seconds after. A sibling of the `<details>`, not inside its `<summary>`: a button
 * inside the summary's button is two controls in one. `ProductFaq` runs it and opens the answer a
 * hash names on arrival.
 */
interface Props {
	question: string;
	/** Answer markup, from the page's own data files; rendered with `set:html`. */
	answer: string;
	/** Held back behind its panel's "More questions" (`hidden` until then). */
	extra?: boolean;
	/** An id, for a link to this one answer (Pricing's tooltips link into their FAQ); it gets a copy link. */
	id?: string;
	/** The answer's id in its data, unprefixed — what main's addresses carry in their hash. */
	faqId?: string;
	/** Rendered open. */
	open?: boolean;
}

const { question, answer, extra = false, id, faqId, open = false } = Astro.props;
---

<div class="faq-q" hidden={extra} data-faq-extra={extra ? '' : undefined}>
	<details class="faq-q__details" id={id} data-faq-id={faqId} open={open}>
		<summary class="faq-q__summary" data-copy={id ? '' : undefined}>
			<span class="faq-q__question">{question}</span>
			<Icon name="tabler:chevron-down" class="faq-q__chevron" aria-hidden="true" />
		</summary>
		<div class="faq-q__answer" set:html={answer} />
	</details>
	{id && (
		<button type="button" class="faq-q__copy print:hidden" data-faq-copy aria-label={`Copy link to: ${question}`}>
			<Icon name="tabler:link" aria-hidden="true" />
			<span class="faq-q__tip" aria-hidden="true" data-faq-tip>
				Copy link
			</span>
		</button>
	)}
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	.faq-q {
		position: relative;
		border-bottom: 1px solid var(--color-border);
	}

	// `hidden` is a presentation hint that any author `display` beats; stated, so a later rule cannot
	// silently show the held-back answers.
	.faq-q[hidden] {
		display: none;
	}

	// Arriving from a link, the answer lands under the bar rather than behind it.
	.faq-q__details {
		scroll-margin-top: calc(var(--header-height, 64px) + #{$spacing-6});
	}

	.faq-q__summary {
		// The tables' step. The FAQ is the page's other long read, and at 14 beside a 16px table it
		// looked like small print rather than a second section.
		@include type-body;

		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: $spacing-4;
		padding: $spacing-4 0;
		font-weight: $font-weight-medium;
		color: var(--color-text);
		cursor: pointer;
		// Safari draws its own triangle from the default `list-item` display; both properties are
		// needed to retire it, and the chevron replaces it.
		list-style: none;

		&::-webkit-details-marker {
			display: none;
		}

		// Room in the right rail for the copy link, between the words and the chevron.
		&[data-copy] .faq-q__question {
			margin-right: 24px;
		}

		@media (hover: hover) {
			&:hover {
				color: var(--accent-ink);

				.faq-q__question {
					text-decoration-line: underline;
				}
			}
		}

		&:active .faq-q__question {
			text-decoration-line: underline;
			text-decoration-thickness: 2px;
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 2px;
		}

		@media (forced-colors: active) {
			color: CanvasText;
		}
	}

	// The underline rides the words, not the row: on the summary itself it would run under the gap
	// and the chevron too.
	.faq-q__question {
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}

	.faq-q__chevron {
		flex: none;
		width: 20px;
		height: 20px;
		margin-top: 1px;
		color: var(--color-text-secondary);
		transition: transform 0.15s ease;

		@media (prefers-reduced-motion: reduce) {
			transition: none;
		}

		@media (forced-colors: active) {
			color: CanvasText;
		}
	}

	@media (hover: hover) {
		.faq-q__summary:hover .faq-q__chevron {
			color: var(--accent-ink);
		}
	}

	.faq-q__details[open] .faq-q__chevron {
		transform: rotate(180deg);
	}

	// The copy link: 28 square, in the rail left of the chevron, on the question's first line. Hidden
	// and out of reach until the row is hovered or the button focused — an invisible target there
	// would copy a link the reader never saw instead of opening the answer — and shown at all times on
	// a touch screen, which has no hover to reveal it.
	.faq-q__copy {
		position: absolute;
		top: calc(#{$spacing-4} + 12px - 14px);
		right: 28px;
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		padding: 0;
		border: 0;
		border-radius: $radius-md;
		background: none;
		color: var(--color-text-secondary);
		cursor: pointer;
		opacity: 0;
		pointer-events: none;
		transition:
			opacity 0.15s ease,
			color 0.15s ease,
			background-color 0.15s ease;

		svg {
			width: 16px;
			height: 16px;
		}

		.faq-q:hover > &,
		&:focus-visible {
			opacity: 1;
			pointer-events: auto;
		}

		&:hover {
			color: var(--accent-ink);
			background: color-mix(in srgb, currentColor 10%, transparent);
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 2px;
		}

		@media (pointer: coarse) {
			opacity: 1;
			pointer-events: auto;
		}

		@media (prefers-reduced-motion: reduce) {
			transition: none;
		}

		&[data-copied] {
			opacity: 1;
			color: var(--color-success, #178649);
		}
	}

	// The tip over the icon: "Copy link" on hover or focus, "Copied" once it has.
	.faq-q__tip {
		position: absolute;
		bottom: calc(100% + 6px);
		left: 50%;
		padding: 4px 8px;
		border-radius: $radius-sm;
		background: var(--color-text);
		color: var(--color-bg-surface);
		font-size: 12px;
		font-weight: $font-weight-medium;
		line-height: 1.3;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		transform: translateX(-50%);
		transition: opacity 0.15s ease;

		.faq-q__copy:hover > &,
		.faq-q__copy:focus-visible > &,
		.faq-q__copy[data-copied] > & {
			opacity: 1;
		}

		.faq-q__copy[data-copied] > & {
			background: var(--color-success, #178649);
			color: #fff;
		}
	}

	.faq-q__answer {
		@include type-body;

		padding: 0 0 $spacing-4;
		color: var(--color-text-secondary);

		// SIZE STATED ON THE CHILDREN, not just here. The site sets `<p>` at 18px/1.6 globally, and
		// these answers arrive through `set:html` with no classes on them, so they would be the only
		// paragraphs on the page still inheriting it, running 18px beside a 16px table.
		:global(p),
		:global(li) {
			@include type-body;
		}

		:global(p) {
			margin: 0 0 $spacing-3;
		}

		:global(ul) {
			margin: 0 0 $spacing-3;
			padding-left: $spacing-5;
		}

		:global(p:last-child),
		:global(ul:last-child) {
			margin-bottom: 0;
		}

		:global(li) {
			margin-bottom: $spacing-1;
		}

		:global(a) {
			color: var(--accent-ink);
			text-decoration: underline;
			text-underline-offset: 3px;
		}
	}
</style>
