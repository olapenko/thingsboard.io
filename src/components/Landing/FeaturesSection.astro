---
import SectionHeader from '@components/Landing/SectionHeader.astro';
import FeatureTile from '@components/Landing/FeatureTile.astro';
import Band from '@components/ui/Band.astro';
import CardGrid from '@components/ui/CardGrid.astro';
import { HOME_FEATURES_COPY, homeFeatures } from '@data/homeFeatures';
import { LIVE_FEATURES } from '@data/home-live';

/**
 * "Why choose": the heading over the twelve feature tiles, on the page's one light tint.
 *
 * Its own component, out of `HomeSections` and `index.astro`, so the homepage and its sandbox page
 * (`/internal/sections/features/`) render the one section. Its rules came with it, keyed to the same
 * ids at the same specificity, so the page did not change by moving them.
 *
 * Heading and cards both come from `develop`'s own closing feature section, so the two pages make
 * the same argument in the same words. The lede sets the section against the ecosystem above it:
 * that one is what you can add, this one is what's in the box.
 */

interface Props {
	/**
	 * `why` — develop's heading, as the handoff homepage runs it. `value` keeps those words and adds a
	 * claim over them: the develop heading becomes the eyebrow, and the heading says what twelve tiles
	 * of "in the box" are worth. `live` — main's "ThingsBoard Features", with no lede.
	 */
	heading?: 'why' | 'value' | 'live';
}

const { heading = 'why' } = Astro.props;

const title =
	heading === 'live'
		? LIVE_FEATURES.title
		: heading === 'value'
			? HOME_FEATURES_COPY.valueTitle
			: HOME_FEATURES_COPY.title;
---

{
	/* The page's ONE light tint (`--band-tint`), 64 over the heading and 80 under the tiles. The tiles
	   three across, two from 750, one on a phone, a short last row centred (ten cards over three
	   columns leave one on its own, and a grid would pin it hard against the left edge). */
}
<Band id="bottom-features" ground="tint" pad={{ top: 'md', bottom: 'lg' }}>
	<SectionHeader
		eyebrow={heading === 'value' ? HOME_FEATURES_COPY.title : undefined}
		title={title}
		titleSize="section"
		subtitle={heading === 'live' ? undefined : HOME_FEATURES_COPY.subtitle}
		subtitleMeasure="copy"
		spacing="sm"
	/>
	<CardGrid layout="centred" attrs={{ id: 'cards' }}>
		{homeFeatures.map((feature) => <FeatureTile {...feature} />)}
	</CardGrid>
</Band>
