---
import SmartImage from '@components/SmartImage.astro';
import ReadMoreLink from './ReadMoreLink.astro';
---

<section id="scada">
	<div class="main-div">
		<div id="features-top-1">
			<div class="block scada">
				<div class="feature-des">
					<div class="scada-mode-selector">
						<div class="mode active gtm_button" data-mode="performance">
							<span>High-performance</span>
						</div>
						<div class="mode gtm_button" data-mode="traditional">
							<span>Traditional</span>
						</div>
					</div>
					<h3 class="phrase-heading scada-title">SCADA High-performance</h3>
					<p>
						Monitor and control your industrial processes in real time with SCADA. Use SCADA symbols on dashboards to
						create and manage any workflow, offering full flexibility to design and oversee operations according to your
						requirements.
					</p>
					<ReadMoreLink href="/use-cases/scada/" text="Read more about SCADA" />
				</div>
				<div class="scada-svg">
					<div class="scada-scheme-wrapper">
						<SmartImage
							class="scada-scheme high-perf"
							src="/src/assets/images/landings/ce/high-perf-scada-background.svg"
							alt="SCADA background block schema"
							width="1144"
							height="655"
							loading="lazy"
						/>
						<SmartImage
							class="scada-scheme trad scada-inactive"
							src="/src/assets/images/landings/ce/scada-background.svg"
							alt="SCADA background block schema"
							width="1144"
							height="655"
							loading="lazy"
						/>
					</div>
					<div class="scada-fade"></div>
					<div class="scada-background"></div>
				</div>
			</div>
		</div>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	p {
		color: var(--color-text);
	}

	#scada {
		:global(a.read-more-link) {
			color: #1a6fd4;
		}

		:global(a.read-more-link .arrow) {
			color: #1a6fd4;
		}
	}

	// Feature image styling
	#features-top-1 img {
		border-radius: $radius-md;
		box-shadow: var(--shadow-lg);
	}

	// Two-column block layout
	.block {
		justify-content: space-between;
		display: flex;
		align-items: center;
		flex-direction: column;

		@include media-up(lg) {
			flex-direction: row;
		}

		.scada-svg {
			margin-top: $spacing-8;

			@include media-up(lg) {
				margin-top: 0;
			}
		}

		.scada-svg {
			order: 2;

			@include media-up(lg) {
				order: unset;
			}
		}

		.feature-des {
			order: 1;

			@include media-up(lg) {
				order: unset;
			}

			h2 {
				margin-top: $spacing-24;

				@include media-up(lg) {
					margin-top: 0;
				}
			}
		}

		.feature-des {
			width: 100%;

			@include media-up(md) {
				width: 80%;
			}

			@include media-up(lg) {
				width: calc(50% - 80px);
			}
		}
	}

	.block.scada {
		margin-bottom: $spacing-24;

		@include media-down(2xl) {
			margin-top: $spacing-24;
		}
	}

	// Feature description spacing
	.feature-des {
		h3,
		.phrase-heading {
			margin-bottom: 0.25rem;
		}

		:global(.read-more-link) {
			margin-top: 1.125rem;
		}
	}

	// SCADA mode toggle
	.scada-mode-selector {
		display: flex;
		// No stroke: the tinted track already reads as a container, and the
		// hairline on top of it doubled the edge.
		height: 36px;
		width: min-content;
		border-radius: $radius-full;
		margin-bottom: 2rem;
		// Tint follows the mark's blue rather than the purple primary, so the
		// track and the thing sitting in it are the same hue.
		background-color: rgba(26, 111, 212, 0.08);
	}

	.scada-mode-selector .mode {
		position: relative;
		color: $color-text-primary;
		cursor: pointer;
		height: 100%;
		display: flex;
		align-items: center;
		padding: 0 18px;

		span {
			font-weight: $font-weight-medium;
			font-size: $font-size-sm;
			line-height: 20px;
			white-space: nowrap;

			@include media-up(sm) {
				font-size: 15px;
				line-height: 20px;
			}
		}

		&.active {
			// `$radius-full` rather than half the height, so it survives a height
			// change instead of going square-shouldered.
			border-radius: $radius-full;
			color: $color-white;
			background-color: #1a6fd4;
			// No shadow: it was --shadow-primary, a 16px cast tuned for a large
			// CTA, under a 36px pill sitting inside its own tinted track.
			box-shadow: none;
		}

		&:hover:not(.active) {
			color: $color-black;
		}
	}

	// SCADA diagram visual
	.scada-svg {
		margin-top: $spacing-10;
		width: 50%;
		z-index: -1;
		position: relative;

		@include media-down(2xl) {
			z-index: 1;
		}

		@include media-down(lg) {
			width: 76%;
		}

		@include media-down(md) {
			width: 94%;
		}

		img {
			box-shadow: none !important;
		}

		.scada-scheme-wrapper {
			width: 163.8%;
			aspect-ratio: 1144 / 655;
			position: relative;
			z-index: -2;
		}

		.scada-scheme {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			transition: opacity 0.3s ease;

			&.scada-inactive {
				opacity: 0;
				pointer-events: none;
			}
		}

		.scada-fade {
			width: 64.8%;
			height: 93.8%;
			position: absolute;
			top: 0;
			right: -498px;
			background: linear-gradient(to right, transparent 0%, var(--color-bg-light) 100%);

			@include media-down(lg) {
				display: none;
			}
		}

		.scada-background {
			position: absolute;
			top: 10.3%;
			z-index: -3;
			width: 96%;
			height: 73%;
			background-color: var(--color-bg-surface);
			border-radius: $radius-lg;
			box-shadow: var(--shadow-card);
		}
	}

	// Decorative background
</style>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const scadaModes = document.querySelectorAll('.scada-mode-selector .mode');
		scadaModes.forEach((mode) => {
			mode.addEventListener('click', () => {
				if (mode.classList.contains('active')) return;

				scadaModes.forEach((m) => m.classList.remove('active'));
				mode.classList.add('active');

				const isPerformance = mode.getAttribute('data-mode') === 'performance';
				const schemes = document.querySelectorAll('.scada-scheme');
				schemes[0].classList.toggle('scada-inactive', !isPerformance);
				schemes[1].classList.toggle('scada-inactive', isPerformance);

				const title = document.querySelector('.scada-title');
				if (title) {
					title.textContent = isPerformance ? 'SCADA High-performance' : 'SCADA Traditional';
				}
			});
		});
	});
</script>
