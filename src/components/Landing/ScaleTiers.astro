---
import { Icon } from 'astro-icon/components';
import { SCALE_TIERS_PAIR, SCALE_MACHINES_AXIS, type ScaleTier } from '@data/scale-visual';

/**
 * A third cut of the scale visual. ScaleChart and ScaleMachines both stay as they are; this one
 * sits beside them.
 *
 * Two quantities, each drawn as itself, and almost nothing in prose.
 *
 * THE BAR IS THE FLEET, to scale and linear: 100K draws at a tenth of 1M because it is a tenth of
 * 1M. A log axis would have made the stub a comfortable 83% of the long bar and quietly thrown away
 * the only thing the bar is for. The short one is meant to look short.
 *
 * THE ICONS ARE THE MACHINES, one glyph each, so the count is read by counting rather than by
 * trusting a number. Across the two tiers the fleet goes up 10x and the machines 12x — the two rows
 * ramp together, which is the argument the section makes.
 *
 * Everything else is a value or a tag. The sentences that were here have gone to the section copy,
 * where a sentence belongs.
 *
 * Two tiers, so both machine counts are sums of a table in the docs rather than shapes, and so the
 * composition is 420 units wide instead of 640 — which is what makes it legible on a phone.
 */

interface Props {
	/** Defaults to the pair whose machine counts the docs actually add up. */
	tiers?: ScaleTier[];
}

const { tiers = SCALE_TIERS_PAIR } = Astro.props;

const COL_W = 200;
const COL_GAP = 20;
const NATIVE = tiers.length * COL_W + (tiers.length - 1) * COL_GAP;

// The bars share one scale — the largest tier — so they can be compared across columns. The columns
// are equal width, which is what makes that comparison honest.
const peak = Math.max(...tiers.map((t) => t.count));

// Six glyphs to a row, so twelve is exactly two rows and the block's height is a known number
// rather than whatever the content happens to make it.
const ICON = 24;
const ICON_GAP = 7;
const PER_ROW = 6;
const ICON_ROWS = Math.ceil(Math.max(...tiers.map((t) => t.own + t.database)) / PER_ROW);
const ICONS_H = ICON_ROWS * ICON + (ICON_ROWS - 1) * ICON_GAP;

const vars = [
	// Ceiling raised above the family's 1.15 because this is drawn at 420 units, not 630, and would
	// otherwise stop growing well short of the width a feature row gives it. No floor: the width is
	// exactly 100cqw below the cap, so it cannot overflow at any size.
	`--tier-u: min(1.45px, calc(100cqw / ${NATIVE}))`,
	`--tier-native: ${NATIVE}`,
	`--tier-cols: ${tiers.length}`,
	`--tier-gap: ${COL_GAP}`,
	`--tier-icon: ${ICON}`,
	`--tier-icon-gap: ${ICON_GAP}`,
	`--tier-icons-h: ${ICONS_H}`,
].join('; ');
---

<div class="tiers-fit">
	<div class="tiers" style={vars}>
		<p class="tiers__axis">{SCALE_MACHINES_AXIS.caption}</p>

		<ul class="tiers__list">
			{
				tiers.map((t) => (
					<li class="tiers__tier">
						<p class="tiers__devices">
							<span class="tiers__num">{t.devices}</span> devices
						</p>

						{/* Linear and to scale against the largest tier. */}
						<div class="tiers__bar" style={`--tier-share: ${(t.count / peak) * 100}`} />

						{/* One glyph per machine, in a box sized for the largest count so the values below
						    stay on one line across the columns. */}
						<div class="tiers__icons">
							{Array.from({ length: t.own }).map(() => (
								<Icon name="tabler:server" aria-hidden="true" />
							))}
							{Array.from({ length: t.database }).map(() => (
								<Icon name="tabler:server" aria-hidden="true" class="tiers__icon--managed" />
							))}
						</div>

						<p class="tiers__machines">{t.machines}</p>
						<p class="tiers__load">{t.load}% CPU</p>

						<ul class="tiers__tags">
							{t.stack.map((s) => (
								<li>{s}</li>
							))}
						</ul>
					</li>
				))
			}
		</ul>
	</div>
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	// Every size is a multiple of one design unit, so the composition scales as a piece instead of
	// reflowing. See SolutionFlow for why the unit comes from the container.
	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	.tiers-fit {
		container-type: inline-size;
	}

	.tiers {
		--u: var(--tier-u);
		display: grid;
		gap: u(16);
		max-width: u(var(--tier-native));
		margin: 0 auto;
	}

	.tiers__axis {
		margin: 0;
		font-size: u(16);
		line-height: u(22);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-text-secondary, #5b616e);
	}

	.tiers__list {
		display: grid;
		grid-template-columns: repeat(var(--tier-cols), 1fr);
		gap: u(var(--tier-gap));
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tiers__tier {
		display: grid;
		align-content: start;
		gap: u(10);
	}

	// --- the fleet --------------------------------------------------------------------------

	.tiers__devices {
		display: flex;
		align-items: baseline;
		gap: u(6);
		margin: 0;
		font-size: u(16);
		line-height: u(22);
		color: var(--color-text-secondary, #5b616e);
	}

	// Mono because it is a quantity being compared across columns, and lining up digit for digit is
	// the comparison.
	.tiers__num {
		font-family: var(--flow-font-mono, #{$font-family-mono});
		font-size: u(40);
		font-weight: $font-weight-bold;
		line-height: u(44);
		color: var(--color-text);
	}

	// No track behind it. A track would have to mean "the largest tier", which is a strange thing to
	// draw inside the smallest one; two bars starting at the same left edge in equal columns compare
	// perfectly well on their own.
	.tiers__bar {
		width: calc(var(--tier-share) * 1%);
		height: u(14);
		border-radius: u(5);
		background: var(--color-primary, #3d50f5);
	}

	// --- the machines -----------------------------------------------------------------------

	.tiers__icons {
		display: flex;
		flex-wrap: wrap;
		gap: u(var(--tier-icon-gap));
		height: u(var(--tier-icons-h));
	}

	// Sized here, in design units, NOT with astro-icon's width/height attributes — those are
	// absolute pixels and do not scale with `--u`, which at phone width renders a 24px glyph at
	// nearly twice its intended size and bursts whatever holds it.
	.tiers__icons [data-icon] {
		flex: none;
		width: u(var(--tier-icon));
		height: u(var(--tier-icon));
		color: var(--color-primary, #3d50f5);
	}

	// A machine you buy rather than operate: the same glyph, dimmed, because it is the same kind of
	// thing and just not one of your boxes.
	.tiers__icons [data-icon].tiers__icon--managed {
		color: color-mix(in srgb, var(--color-primary, #3d50f5) 35%, transparent);
	}

	// --- values and tags --------------------------------------------------------------------

	.tiers__machines {
		margin: 0;
		font-size: u(20);
		font-weight: $font-weight-semibold;
		line-height: u(26);
		color: var(--color-text);
	}

	.tiers__load {
		margin: u(-6) 0 0;
		font-size: u(16);
		line-height: u(22);
		color: var(--color-text-secondary, #5b616e);
	}

	// The family's chips: an identifier on a wash, in mono.
	.tiers__tags {
		display: flex;
		flex-wrap: wrap;
		gap: u(6);
		margin: 0;
		padding: 0;
		list-style: none;

		li {
			padding: u(4) u(10);
			border-radius: u(var(--flow-radius, 8));
			font-family: var(--flow-font-mono, #{$font-family-mono});
			font-size: u(16);
			font-weight: $font-weight-bold;
			line-height: u(22);
			color: var(--color-text);
			background: color-mix(in srgb, var(--color-primary, #3d50f5) 12%, transparent);
		}
	}
</style>
