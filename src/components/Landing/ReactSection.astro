---
import SmartImage from '@components/SmartImage.astro';
import ReadMoreLink from './ReadMoreLink.astro';
---

<section id="react">
	<div class="main-div">
		<div id="features-top-2">
			<div class="block dark">
				<div class="process">
					<SmartImage
						class="react-img"
						src="/src/assets/images/landings/ce/react.svg"
						alt="Rule nodes chain"
						width="1031"
						height="230"
						loading="lazy"
					/>
					<SmartImage
						class="add-rule"
						src="/src/assets/images/landings/ce/add-rule.svg"
						alt="Add rule node example"
						width="626"
						height="482"
						loading="lazy"
					/>
				</div>
				<div class="feature-des">
					<h3 class="phrase-heading">Process and React</h3>
					<p>
						Define data processing rule chains. Transform and normalize your device data. Raise alarms on incoming
						telemetry events, attribute updates, device inactivity and user actions.
					</p>
					<ReadMoreLink href="/docs/pe/user-guide/rule-engine/" text="See how rule chains work" variant="light" />
				</div>
			</div>
			<div class="block micro">
				<div class="feature-des microservices">
					<h3 class="phrase-heading">Microservices</h3>
					<p>
						Construct your ThingsBoard cluster and get maximum scalability and fault-tolerance with microservices
						architecture. ThingsBoard also supports both cloud and on-premises deployments.
					</p>
					<ReadMoreLink href="/docs/pe/reference/architecture/microservices/" text="See the architecture" />
				</div>
				<SmartImage
					src="/src/assets/images/landings/ce/microservices.svg"
					alt="Microservices block schema"
					width="569"
					height="327"
					loading="lazy"
				/>
			</div>
		</div>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	.block.micro {
		:global(a.read-more-link) {
			color: #1a6fd4;
		}

		:global(a.read-more-link .arrow) {
			color: #1a6fd4;
		}

		p {
			color: var(--color-text);
		}

		h3,
		.phrase-heading {
			color: var(--color-text);
		}
	}

	// Feature image styling. `:not(.react-img)` because this is an ID selector
	// (1,0,1) and was silently beating `.process .react-img { box-shadow: none }`
	// (0,2,0) further down — so the rule-chain line art carried a 50px drop
	// shadow it was explicitly written to be exempt from. Invisible while the old
	// diagonal band ran past it; obvious now the stripe is bounded to the row and
	// the diagram's last 52px sit on white.
	#features-top-2 img:not(.react-img) {
		border-radius: $radius-md;
		box-shadow: var(--shadow-lg);
	}

	// Two-column block layout
	.block {
		justify-content: space-between;
		display: flex;
		align-items: center;
		flex-direction: column;

		@include media-up(lg) {
			flex-direction: row;
		}

		img,
		.process {
			order: 2;

			@include media-up(lg) {
				order: unset;
			}
		}

		.feature-des {
			order: 1;

			@include media-up(lg) {
				order: unset;
			}

			h2 {
				margin-top: $spacing-24;

				@include media-up(lg) {
					margin-top: 0;
				}
			}

			&.microservices h2 {
				@include media-down(md) {
					margin-top: 60px;
				}
			}
		}

		.feature-des,
		img,
		.process {
			width: 100%;

			@include media-up(md) {
				width: 80%;
			}

			@include media-up(lg) {
				width: calc(50% - 80px);
			}
		}
	}

	.block.dark {
		@include media-down(lg) {
			margin-bottom: 80px;
		}

		.feature-des {
			margin-bottom: 50px;

			@include media-down(lg) {
				margin-bottom: 68px;
			}

			h2,
			.phrase-heading {
				color: $color-white;
			}

			p {
				color: $color-text-disabled;
			}

			a {
				color: $color-white;

				img {
					filter: invert(98%) sepia(19%) saturate(109%) hue-rotate(232deg) brightness(115%) contrast(100%);
				}

				.icon {
					filter: sepia(19%) saturate(109%) hue-rotate(232deg) brightness(115%) contrast(100%);
				}
			}
		}
	}

	.block.micro {
		margin: 300px 0 $spacing-24 0;

		@include media-down(lg) {
			margin-top: 0;
		}

		img {
			box-shadow: unset !important;
			max-width: 569px;
		}

		.feature-des {
			margin-bottom: $spacing-5;
		}
	}

	// Feature description spacing
	.feature-des {
		h3,
		.phrase-heading {
			margin-bottom: 0.25rem;
		}

		:global(.read-more-link) {
			margin-top: 1.125rem;
		}
	}

	// Rule chain visual
	.process {
		position: relative;
		display: inline-block;

		.react-img {
			width: 167%;
			max-width: 1031px;
			border-radius: 0;
			position: absolute;
			box-shadow: none;
			z-index: -1;
			left: -95%;
			top: 316px;

			@include media-down(lg) {
				left: -76%;
				top: -55px;
			}
		}

		.add-rule {
			width: 100%;
		}
	}

</style>
