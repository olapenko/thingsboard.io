---
import { Icon } from 'astro-icon/components';
import Card from '@components/ui/Card.astro';
import Link from '@components/ui/Link.astro';

interface DocLink {
	term: string;
	href: string;
}

interface Props {
	icon: string;
	title: string;
	description: string;
	href: string;
	links?: DocLink[];
}

const { icon, title, description, href, links = [] } = Astro.props;

// Split the description around each linked term. Throws rather than silently
// dropping a link when a term no longer appears in the copy.
type Segment = { text: string; href?: string };

let segments: Segment[] = [{ text: description }];

for (const link of links) {
	const next: Segment[] = [];
	let matched = false;

	for (const segment of segments) {
		const at = segment.href ? -1 : segment.text.indexOf(link.term);

		if (at === -1 || matched) {
			next.push(segment);
			continue;
		}

		if (at > 0) next.push({ text: segment.text.slice(0, at) });
		next.push({ text: link.term, href: link.href });
		const rest = segment.text.slice(at + link.term.length);
		if (rest) next.push({ text: rest });
		matched = true;
	}

	if (!matched) {
		throw new Error(`FeatureTile "${title}": no "${link.term}" in the description to link.`);
	}

	segments = next;
}
---

{
	/* A link card (`ui/Card` tile, `href`): the title is the one anchor, stretched over the tile, so
	   the card is one big target without the accessible name swallowing the description; the doc
	   links in the description sit above it. Hover deepens the lift and turns the title to the
	   accent; nothing moves. */
}
<Card href={href} title={title} level={3} class="feature-tile">
	<Icon slot="mark" name={icon} class="feature-tile__icon" aria-hidden="true" />
	<p class="feature-tile__description">
		{
			// prettier-ignore
			segments.map((segment) => segment.href ? <Link variant="inline" tone="muted" href={segment.href}>{segment.text}</Link> : segment.text)
		}
	</p>
</Card>

<style lang="scss">
	@use '../../styles/variables' as *;

	// Between the hub's category tiles and the ecosystem cards: enough room for a line of
	// explanation, not enough to compete with the products above. The surface, the 20 padding and
	// the lift are the Card tile's.
	.feature-tile {
		gap: $spacing-2;
	}

	// Black and solid: the identification is the icon's job here, since there is no room for an
	// accent colour system across a grid of ten.
	.feature-tile__icon {
		width: 28px;
		height: 28px;
		margin-bottom: $spacing-1;
		color: var(--color-text);
	}

	.feature-tile__description {
		@include type-small;

		margin: 0;
		color: var(--color-text-secondary, #5b616e);
		text-wrap: pretty;
	}
</style>
