---
import { Icon } from 'astro-icon/components';

interface DocLink {
	term: string;
	href: string;
}

interface Props {
	icon: string;
	title: string;
	description: string;
	href: string;
	links?: DocLink[];
}

const { icon, title, description, href, links = [] } = Astro.props;

// Split the description around each linked term. Throws rather than silently
// dropping a link when a term no longer appears in the copy.
type Segment = { text: string; href?: string };

let segments: Segment[] = [{ text: description }];

for (const link of links) {
	const next: Segment[] = [];
	let matched = false;

	for (const segment of segments) {
		const at = segment.href ? -1 : segment.text.indexOf(link.term);

		if (at === -1 || matched) {
			next.push(segment);
			continue;
		}

		if (at > 0) next.push({ text: segment.text.slice(0, at) });
		next.push({ text: link.term, href: link.href });
		const rest = segment.text.slice(at + link.term.length);
		if (rest) next.push({ text: rest });
		matched = true;
	}

	if (!matched) {
		throw new Error(`FeatureTile "${title}": no "${link.term}" in the description to link.`);
	}

	segments = next;
}
---

<div class="feature-tile">
	<Icon name={icon} class="feature-tile__icon" aria-hidden="true" />
	<h3 class="feature-tile__title">
		<a class="feature-tile__link" href={href}>{title}</a>
	</h3>
	<p class="feature-tile__description">
		{
			// prettier-ignore
			segments.map((segment) => segment.href ? <a class="feature-tile__doc" href={segment.href}>{segment.text}</a> : segment.text)
		}
	</p>
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	// Between the hub's category tiles and the ecosystem cards: enough room for a
	// line of explanation, not enough to compete with the products above.
	.feature-tile {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: $spacing-2;
		padding: $spacing-5;

		// Two across is the odd tier here too — `#cards` drops to two between 750 and
		// 1023 while the grid keeps the page's 960 measure, so a tile runs 354 at 750
		// and 474 by 1023 against the 312 the three-across grid gives it. Same walls
		// as the ecosystem cards take in the same band, so the page's two card grids
		// stay one thing.
		@include media-up(md) {
			@include media-down(lg) {
				padding: $spacing-8;
			}
		}
		border-radius: $radius-lg;
		// No stroke, at rest or on hover — the same trade the ecosystem cards make
		// on this band. White on #f5f6ff is a luminance ratio of 1.076, so the edge
		// a stroke used to draw is given back as depth rather than as a line, and
		// hover reads as a change in that depth instead of a second edge appearing.
		box-shadow:
			0 1px 2px rgba(0, 0, 0, 0.04),
			0 8px 16px -8px rgba(0, 0, 0, 0.06);
		background-color: var(--color-bg-surface);
		color: var(--color-text);
		transition: box-shadow 0.18s ease;

		// Shadow and the links' underlines carry the hover — no lift, matching
		// every other card on the homepage.
		&:hover,
		&:focus-within {
			box-shadow: 0 12px 28px rgba(0, 0, 0, 0.07);
		}
	}

	// Black and solid — the identification is the icon's job here, since there is
	// no room for an accent colour system across a grid of ten.
	.feature-tile__icon {
		width: 28px;
		height: 28px;
		color: var(--color-text);
	}

	.feature-tile__title {
		@include type-tile;
		margin: $spacing-1 0 0;
	}

	// Stretched over the whole tile, so the card stays one big target without the
	// accessible name swallowing the description.
	.feature-tile__link {
		color: inherit;
		text-decoration: none;
		text-underline-offset: 2px;
		transition: color 0.15s ease;

		&::after {
			content: '';
			position: absolute;
			inset: 0;
			border-radius: inherit;
		}
	}

	.feature-tile__description {
		@include type-small;
		margin: 0;
		color: var(--color-text-secondary, #5b616e);
		text-wrap: pretty;
	}

	// Lifted above the stretched link so the deeper article stays reachable.
	.feature-tile__doc {
		position: relative;
		z-index: 1;
		color: inherit;
		text-decoration: none;
		text-underline-offset: 2px;
		transition: color 0.15s ease;
	}

	// The card hovers as one thing, so every link inside it admits to being a link
	// at the same moment.
	.feature-tile:hover .feature-tile__link,
	.feature-tile:hover .feature-tile__doc,
	.feature-tile:focus-within .feature-tile__link,
	.feature-tile:focus-within .feature-tile__doc {
		text-decoration: underline;
		text-decoration-color: rgba(0, 0, 0, 0.35);
	}

	// Pointing at one in particular lights that one. The title is keyed to its
	// heading box, not to the anchor — the anchor's hit area is the whole card.
	.feature-tile__title:hover .feature-tile__link,
	.feature-tile__link:focus-visible,
	.feature-tile__doc:hover,
	.feature-tile__doc:focus-visible {
		color: var(--color-primary, #{$color-brand});
		text-decoration-color: currentColor;
	}

</style>
