---
/**
 * A page's own intro: the eyebrow, the h1 and the lede, as Contact us, Thank you and Install open.
 * Not a component of its own: `SectionHeader` at level 1, the `title` size (40, 30 on phones), the
 * 18px lede (`type-lede`, 16 on phones) in the secondary grey, and the eyebrow in the scheme's ink,
 * so the page's accent colours it.
 * The slot follows the lede.
 */
import SectionHeader from '@components/Landing/SectionHeader.astro';

interface Props {
	title: string;
	lede?: string;
	eyebrow?: string;
	align?: 'left' | 'center';
	ledeMeasure?: 'wide' | 'copy' | 'narrow';
	/** The lede in the secondary grey (default), or the ink. */
	ledeTone?: 'ink' | 'muted';
	/** An id for the h1, where something is named by it. */
	titleId?: string;
	spacing?: 'none' | 'sm' | 'md' | 'lg';
	ledeSize?: 'body' | 'lede';
	/** Attributes for the eyebrow, the title and the lede, for a page script that rewrites them. */
	partAttrs?: {
		eyebrow?: Record<string, string>;
		title?: Record<string, string>;
		subtitle?: Record<string, string>;
	};
	class?: string;
}

const {
	title,
	lede,
	eyebrow,
	align = 'left',
	ledeMeasure = 'copy',
	spacing = 'none',
	ledeSize = 'lede',
	ledeTone = 'muted',
	titleId,
	partAttrs,
	class: className,
} = Astro.props;
---

<SectionHeader
	level={1}
	title={title}
	subtitle={lede}
	eyebrow={eyebrow}
	eyebrowTone="accent"
	align={align}
	titleSize="title"
	ledeSize={ledeSize}
	ledeTone={ledeTone}
	titleId={titleId}
	subtitleMeasure={ledeMeasure}
	spacing={spacing}
	partAttrs={partAttrs}
	class={className}
>
	<slot />
</SectionHeader>
