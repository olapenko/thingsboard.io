---
import { Icon } from 'astro-icon/components';
import PricingBackground from '@components/Pricing/PricingBackground.astro';
---

{
	/*
	The page's two dark sections are a bookend, so this carries the deployments
	band's ground rather than one of its own: the same near-black tinted with the
	primary, and the same wave field over it.

	It replaced a blurred crop of the hero photo. Two dark grounds that were
	nearly-but-not-quite alike read as an inconsistency rather than a pair, and
	the photo was the one carrying no meaning — it was the hero's image at 45%
	behind an 18px blur, i.e. texture. The wave field is already on the page and
	already paid for.
*/
}
<section class="closing-cta">
	<PricingBackground contained />

	<div class="closing-cta__inner">
		<h2 class="closing-cta__title">Ready to build your IoT solution with ThingsBoard?</h2>

		<p class="closing-cta__lead">
			Start free in the cloud, install On-premises on your own infrastructure, or talk to our team about your specific
			use case.
		</p>

		<div class="closing-cta__actions">
			<a class="closing-cta__primary" href="https://thingsboard.cloud/signup">
				<Icon name="tabler:cloud-filled" aria-hidden="true" />
				Start free on Cloud
			</a>

			<a class="closing-cta__secondary" href="/installations/">
				<Icon name="tabler:download" aria-hidden="true" />
				Install On-premises
			</a>
		</div>

		<p class="closing-cta__note">
			Evaluating for a large deployment?
			<a href="/contact-us/">
				Talk to an expert
				<Icon name="tabler:chevron-right" class="closing-cta__note-chevron" aria-hidden="true" />
			</a>
		</p>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	.closing-cta {
		position: relative;
		overflow: hidden;
		// The deployments band's ground, to the value: color-mix(in srgb,
		// #3d50f5 8%, #0e0f13). Set in both places rather than shared through a
		// token, since the two sections are the only things on the site using it
		// and a token would imply it is a theme colour.
		background-color: #121425;
		color: #fff;
		// `isolation` makes this a stacking context so the field's z-index:-1
		// lands above this background instead of dropping behind it — the same
		// reason `#products` carries it.
		isolation: isolate;
		padding: 96px 0;

		@include media-down(md) {
			padding: 64px 0;
		}

		// 3.5–5.5% ink: the brand indigo is not visible at that opacity on a
		// near-black, so the wave lightens while the band keeps the brand. Same
		// value as the deployments band.
		//
		// `:global()` because the field is another component's markup, which a
		// scoped rule cannot reach — without it this compiles to a selector that
		// matches nothing and the field silently keeps the pricing page's blue.
		:global(.pricing-bg) {
			--pricing-wave-color: #8b9bff;
		}
	}

	// The same construction as the page's `.main-div`: a 960 measure carried
	// inside 20px of padding, so 1000 declared. It was 960 with 24px of padding,
	// which put the content edge on 264 while every card grid above it sat on 240
	// — and on mobile, on 24 against their 20. A 4px near-miss reads worse than a
	// clean difference, and matching the container outright retires it at every
	// width rather than at one.
	.closing-cta__inner {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: calc(960px + #{$spacing-5} * 2);
		margin-inline: auto;
		padding-inline: $spacing-5;
	}

	.closing-cta__title {
		margin: 0 0 $spacing-5;
		max-width: 16ch;
		font-size: clamp(30px, calc(0.5rem + 2.6vw), 52px);
		font-weight: $font-weight-bold;
		line-height: 1.15;
		text-wrap: balance;
	}

	.closing-cta__lead {
		margin: 0 0 $spacing-8;
		max-width: 52ch;
		font-size: clamp(15px, calc(0.5rem + 0.7vw), 19px);
		line-height: 1.5;
		color: rgba(255, 255, 255, 0.72);
		text-wrap: pretty;
	}

	.closing-cta__actions {
		display: flex;
		flex-wrap: wrap;
		gap: $spacing-3;
	}

	// Geometry copied from the hero's pair — same height, padding, gap and icon
	// size — so the page opens and closes on buttons that match.
	.closing-cta__primary,
	.closing-cta__secondary {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 44px;
		padding: 0 16px;
		border-radius: $radius-md;
		font-size: 16px;
		font-weight: $font-weight-bold;
		text-decoration: none;

		svg {
			width: 18px;
			height: 18px;
			flex: 0 0 auto;
		}
	}

	// Same brand purple as the hero's primary, so the page opens and closes on
	// the same button.
	.closing-cta__primary {
		background-color: $color-brand;
		color: #fff;
		border: 1px solid $color-brand;
		transition: background-image 0.15s ease;

		&:hover,
		&:focus-visible {
			background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2));
		}
	}

	.closing-cta__secondary {
		border: 1px solid rgba(255, 255, 255, 0.35);
		color: #fff;
		transition:
			background-color 0.15s ease,
			border-color 0.15s ease;

		&:hover,
		&:focus-visible {
			background-color: rgba(255, 255, 255, 0.14);
			border-color: rgba(255, 255, 255, 0.55);
		}
	}

	// The third action was a second `__secondary` — same border, same height, same
	// weight as Install. Three buttons in a row read as three equal choices, and it
	// broke the hero's rule of one primary and one secondary. Talking to us is the
	// qualifying path, not a peer of the two self-serve ones, so it takes the
	// hero's note treatment instead: same 14px, same 0.6 / 0.85 alphas, same
	// stacked underlined link.
	.closing-cta__note {
		margin: $spacing-6 0 0;
		font-size: 14px;
		line-height: 1.4;
		color: rgba(255, 255, 255, 0.6);

		a {
			display: flex;
			width: fit-content;
			align-items: center;
			gap: 2px;
			margin-top: 6px;
			color: rgba(255, 255, 255, 0.85);
			text-decoration: underline;
			text-underline-offset: 3px;

			&:hover,
			&:focus-visible {
				color: #fff;
			}
		}

		// The button rule sizes every `svg` in this component at 18px; the note's
		// chevron follows the hero's 14px.
		.closing-cta__note-chevron {
			width: 14px;
			height: 14px;
			flex: 0 0 auto;
		}
	}
</style>
