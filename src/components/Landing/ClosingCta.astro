---
import { Icon } from 'astro-icon/components';

interface Props {
	/**
	 * Static backdrop. `filter: blur()` over a playing video re-runs on every
	 * decoded frame; over an image it is computed once — and at 28% behind an
	 * 18px blur the motion was imperceptible, so the video bought nothing.
	 */
	backdrop?: string;
}

const { backdrop = '/images/hero/tb-cover.webp' } = Astro.props;
---

<section class="closing-cta">
	<div class="closing-cta__backdrop" aria-hidden="true">
		<img src={backdrop} alt="" loading="lazy" decoding="async" />
	</div>

	<div class="closing-cta__inner">
		<h2 class="closing-cta__title">Ready to build your IoT solution with ThingsBoard?</h2>

		<p class="closing-cta__lead">
			Start free in the cloud, install On-premises on your own infrastructure, or talk to our team about your specific use
			case.
		</p>

		<div class="closing-cta__actions">
			<a class="closing-cta__primary" href="https://thingsboard.cloud/signup">
				<Icon name="tabler:cloud-filled" aria-hidden="true" />
				Start free on Cloud
			</a>

			<a class="closing-cta__secondary" href="/installations/">
				<Icon name="tabler:download" aria-hidden="true" />
				Install On-premises
			</a>

			<a class="closing-cta__secondary" href="/contact-us/">
				<Icon name="tabler:messages" aria-hidden="true" />
				Talk to an expert
			</a>
		</div>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	.closing-cta {
		position: relative;
		overflow: hidden;
		background-color: #000;
		color: #fff;
		padding: 96px 0;

		@include media-down(md) {
			padding: 64px 0;
		}
	}

	// Blur plus a low opacity turns the footage into ground rather than content —
	// legible enough to read as motion, quiet enough to sit under type.
	.closing-cta__backdrop {
		position: absolute;
		inset: 0;
		pointer-events: none;

		img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			opacity: 0.45;
			filter: blur(18px);
			// Hides the soft edge the blur leaves at the frame boundary.
			transform: scale(1.08);
		}
	}

	.closing-cta__inner {
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: 960px;
		margin-inline: auto;
		padding-inline: $spacing-6;
	}

	.closing-cta__title {
		margin: 0 0 $spacing-5;
		max-width: 16ch;
		font-size: clamp(30px, calc(0.5rem + 2.6vw), 52px);
		font-weight: $font-weight-bold;
		line-height: 1.15;
		text-wrap: balance;
	}

	.closing-cta__lead {
		margin: 0 0 $spacing-8;
		max-width: 52ch;
		font-size: clamp(15px, calc(0.5rem + 0.7vw), 19px);
		line-height: 1.5;
		color: rgba(255, 255, 255, 0.72);
		text-wrap: pretty;
	}

	.closing-cta__actions {
		display: flex;
		flex-wrap: wrap;
		gap: $spacing-3;
	}

	// Geometry copied from the hero's pair — same height, padding, gap and icon
	// size — so the page opens and closes on buttons that match.
	.closing-cta__primary,
	.closing-cta__secondary {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 44px;
		padding: 0 16px;
		border-radius: $radius-md;
		font-size: 16px;
		font-weight: $font-weight-bold;
		text-decoration: none;

		svg {
			width: 18px;
			height: 18px;
			flex: 0 0 auto;
		}
	}

	// Same brand purple as the hero's primary, so the page opens and closes on
	// the same button.
	.closing-cta__primary {
		background-color: $color-brand;
		color: #fff;
		border: 1px solid $color-brand;
		transition: background-image 0.15s ease;

		&:hover,
		&:focus-visible {
			background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2));
		}
	}

	.closing-cta__secondary {
		border: 1px solid rgba(255, 255, 255, 0.35);
		color: #fff;
		transition:
			background-color 0.15s ease,
			border-color 0.15s ease;

		&:hover,
		&:focus-visible {
			background-color: rgba(255, 255, 255, 0.14);
			border-color: rgba(255, 255, 255, 0.55);
		}
	}
</style>
