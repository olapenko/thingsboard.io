---
import { Icon } from 'astro-icon/components';
import PricingBackground from '@components/Pricing/PricingBackground.astro';
import { inkedMark } from '@util/tb-mark';
---

{
	/*
	The page's two dark sections are a bookend, so this carries the deployments
	band's ground rather than one of its own: the same near-black tinted with the
	primary, and the same wave field over it.

	It replaced a blurred crop of the hero photo. Two dark grounds that were
	nearly-but-not-quite alike read as an inconsistency rather than a pair, and
	the photo was the one carrying no meaning — it was the hero's image at 45%
	behind an 18px blur, i.e. texture. The wave field is already on the page and
	already paid for.
*/
}
<section class="closing-cta">
	<PricingBackground contained />

	<div class="closing-cta__inner">
		{
			/* The product's own mark, closing the page the way the section marks open each section —
		    and the same white tile the platform visuals give it, so the badge the reader has seen
		    at the centre of Platform, Connect and Turn is the one the page ends on. */
		}
		<span class="closing-cta__badge" aria-hidden="true" set:html={inkedMark()} />
		<h2 class="closing-cta__title">Ready to build your IoT solution with ThingsBoard?</h2>

		<p class="closing-cta__lead">
			Start free in the cloud, install On-premises on your own infrastructure, or talk to our team about your specific
			use case.
		</p>

		<div class="closing-cta__actions">
			<a class="closing-cta__primary" href="https://thingsboard.cloud/signup">
				<Icon name="tabler:cloud-filled" aria-hidden="true" />
				Start free on Cloud
			</a>

			<a class="closing-cta__secondary" href="/installations/">
				<Icon name="tabler:download" aria-hidden="true" />
				Install On-premises
			</a>
		</div>

		<p class="closing-cta__note">Evaluating for a large deployment?</p>

		<a class="closing-cta__secondary" href="/contact-us/">
			<Icon name="tabler:messages" aria-hidden="true" />
			Talk to an expert
		</a>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	.closing-cta {
		position: relative;
		overflow: hidden;
		// The deployments band's ground, to the value: color-mix(in srgb,
		// #3d50f5 8%, #0e0f13). Set in both places rather than shared through a
		// token, since the two sections are the only things on the site using it
		// and a token would imply it is a theme colour.
		background-color: #121425;
		color: #fff;
		// `isolation` makes this a stacking context so the field's z-index:-1
		// lands above this background instead of dropping behind it — the same
		// reason `#products` carries it.
		isolation: isolate;
		padding: 96px 0;

		@include media-down(md) {
			padding: 64px 0;
		}

		// 3.5–5.5% ink: the brand indigo is not visible at that opacity on a
		// near-black, so the wave lightens while the band keeps the brand. Same
		// value as the deployments band.
		//
		// `:global()` because the field is another component's markup, which a
		// scoped rule cannot reach — without it this compiles to a selector that
		// matches nothing and the field silently keeps the pricing page's blue.
		:global(.pricing-bg) {
			--pricing-wave-color: #8b9bff;
		}
	}

	// The same construction as the page's `.main-div`: a 960 measure carried
	// inside 20px of padding, so 1000 declared. It was 960 with 24px of padding,
	// which put the content edge on 264 while every card grid above it sat on 240
	// — and on mobile, on 24 against their 20. A 4px near-miss reads worse than a
	// clean difference, and matching the container outright retires it at every
	// width rather than at one.
	.closing-cta__inner {
		// Centred. The bookend is the page's last word and has nothing beside it to be read against,
		// so a left edge here was an edge to nothing — every other full-width closing element on the
		// page (the section headers, the band leads) is centred, and this was the one that was not.
		text-align: center;
		position: relative;
		z-index: 1;
		width: 100%;
		max-width: calc(960px + #{$spacing-5} * 2);
		margin-inline: auto;
		padding-inline: $spacing-5;
	}

	// The centred section marks' 56px and their 14px to the heading, so it reads as one more of
	// them; the mark at the platform badges' 69% of the tile (a 9px pad), and their white-into-primary
	// wash. No shadow: on this near-black ground the white tile has all the edge it needs, and a
	// dark shadow would not show.
	.closing-cta__badge {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 56px;
		height: 56px;
		margin: 0 auto 14px;
		padding: 9px;
		border-radius: 32%;
		color: #000;
		background: linear-gradient(155deg, #fff 35%, color-mix(in srgb, var(--color-primary, #3d50f5) 5%, #fff) 100%);

		:global(svg) {
			display: block;
			width: 100%;
			height: 100%;
		}
	}

	.closing-cta__title {
		// `auto` inline, so the measure stays a measure and centres inside the container rather than
		// sitting against its left edge.
		margin: 0 auto $spacing-5;
		// TWO LINES, via a measure — there is no "wrap to two lines" in CSS, so the cap is the lever
		// and the balancer picks the break. Measured on this copy at the desktop size: three lines at
		// 22ch and below, two from 24ch all the way up to ~38ch, and the balancer chooses the same
		// split at every one of them — "Ready to build your IoT / solution with ThingsBoard?". 28ch
		// sits in the middle of that plateau, four steps clear of the three-line threshold and ten
		// clear of the point where the line would fit whole.
		//
		// `ch` rather than px because the size is fluid — `clamp(30px, …, 40px)` — so a cap in the
		// element's own character width holds the line count across the range instead of only at the
		// top of it.
		max-width: 28ch;
		// Fluid between two rungs of the ladder rather than between two arbitrary numbers: 30 is the
		// mobile step the titles take and 40 is `type-title`, which is what Products now leads the
		// band with. The bookend and the band lead therefore land on the same size on a desktop.
		font-size: clamp(30px, calc(0.5rem + 2.6vw), 40px);
		font-weight: $font-weight-bold;
		line-height: 1.2;
		text-wrap: balance;
	}

	.closing-cta__lead {
		margin: 0 auto $spacing-8;
		max-width: 52ch;
		@include type-body;
		color: rgba(255, 255, 255, 0.72);
		text-wrap: pretty;
	}

	.closing-cta__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: $spacing-3;
	}

	// Geometry copied from the hero's pair — same height, padding, gap and icon
	// size — so the page opens and closes on buttons that match.
	.closing-cta__primary,
	.closing-cta__secondary {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		height: 44px;
		padding: 0 16px;
		border-radius: $radius-md;
		font-size: 16px;
		font-weight: $font-weight-bold;
		text-decoration: none;

		svg {
			width: 18px;
			height: 18px;
			flex: 0 0 auto;
		}
	}

	// Same brand purple as the hero's primary, so the page opens and closes on
	// the same button.
	.closing-cta__primary {
		background-color: $color-brand;
		color: #fff;
		border: 1px solid $color-brand;
		transition: background-image 0.15s ease;

		&:hover,
		&:focus-visible {
			background-image: linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2));
		}
	}

	.closing-cta__secondary {
		border: 1px solid rgba(255, 255, 255, 0.35);
		color: #fff;
		transition:
			background-color 0.15s ease,
			border-color 0.15s ease;

		&:hover,
		&:focus-visible {
			background-color: rgba(255, 255, 255, 0.14);
			border-color: rgba(255, 255, 255, 0.55);
		}
	}

	// Evaluating for a large deployment? is a LABEL for the button under it, not an aside, so it
	// takes the lede's treatment — same size, same 0.72 alpha — rather than the hero note's small
	// dimmed type. The question and its answer read as one pair that way, set off from the two
	// self-serve buttons above by the gap alone.
	.closing-cta__note {
		@include type-body;
		margin: $spacing-8 0 $spacing-3;
		color: rgba(255, 255, 255, 0.72);
	}

	// Talking to us was a stacked underlined link, which asked the reader to find it. It is the path
	// for the largest deployments on the page, so it takes the same `__secondary` button Install does
	// — same border, height, padding and weight — set on its own line under its label rather than
	// beside the two above it. That keeps the row above at one primary and one secondary, which is
	// the hero's rule, while giving this one a target of the same size.
	//
	// It carries no rule of its own: `inline-flex` is inline-level, so the centred column centres it,
	// and the gap above it is the note's own `margin-bottom`.
</style>
