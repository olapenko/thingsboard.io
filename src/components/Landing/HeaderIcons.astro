---
import SearchButton from '@components/SearchButton.astro';

interface Props {
	/** The search control's form (see `SearchButton`): `field` on the docs bar, the icon elsewhere. */
	searchForm?: 'icon' | 'field';
}

const { searchForm = 'icon' } = Astro.props;
---

<div class="icon-buttons">
	<SearchButton form={searchForm} />
</div>
