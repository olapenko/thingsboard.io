---
import { Icon } from 'astro-icon/components';
import {
	PLATFORM_ZONES,
	PLATFORM_STAGES,
	PLATFORM_FOUNDATIONS,
	PLATFORM_RUNS,
	PLATFORM_CORE,
	type Zone,
	type PlatformRun,
} from '@data/platform-visual';
import mark from '@root/assets/images/landings/draft/thingsboard-mark.svg?raw';

/**
 * The platform overview with the middle column treated as an object rather than a panel: the same
 * three zones and the same clockwise loop, but the platform is lifted off the page.
 *
 * A CANDIDATE BESIDE `PlatformLoop`, not a replacement for it. The two are separate files on
 * purpose — the same reason `ConnectCloud` and `ConnectFlow` are, and `DeployFork` restates the
 * connect visual's vocabulary rather than importing it: a rejected direction has to be able to die
 * without taking the other one with it. The path arithmetic below is therefore deliberately a copy,
 * and the numbers it is fed are this version's own.
 *
 * What differs from `PlatformLoop`, all of it in the middle column except the first:
 *
 * - LOOSER. `PlatformLoop` was tightened until the composition was 316 units tall, which turned
 *   out to be a few units past comfortable. The band is 34 rather than 30 and the paddings inside
 *   all three cards come back up; the inline heads, which is where most of the tightening actually
 *   came from, stay inline.
 * - RAISED. The platform carries the page's ambient shadow and no border. A hairline as well as a
 *   shadow reads as a card with an outline drawn on it; the shadow alone is what makes it sit above
 *   the two zones, which is the whole point of the treatment.
 * - NO RAIL. The arrow through the four stages is gone. It said the four were a sequence, which is
 *   a claim the four verbs already make on their own, and it was competing with the four runs
 *   around the outside — which are the arrows that carry the argument. Removing it also removes the
 *   knockout machinery it needed: the stage icons no longer paint the surface behind themselves or
 *   carry a gap on the right, because there is no longer a line for them to break.
 * - THE FOUR VERBS ARE INK. Connect, Model, Automate and Operate were indigo like everything else
 *   in the column, which left the heading, the icons and the four names all making the same claim
 *   on attention. In ink they read as the content of the card and the indigo is left to the mark,
 *   the icons and the heading.
 * - THE MARK IS LARGER and the heading is one weight. `ThingsBoard` bold with `Platform` in medium
 *   was a lockup in two voices; at 38 units the mark can carry the emphasis and the words can be
 *   one thing.
 *
 * Everything else — the geometry, the palette, the stacking threshold, the R of 86 — is as
 * `PlatformLoop` documents it, and that file is the one to read for why.
 */

interface Props {
	/** Show the foundations strip under the four stages. Off by default; see `PlatformLoop`. */
	foundations?: boolean;
}

const { foundations = false } = Astro.props;

// --- the grid, in design units -------------------------------------------------------------

const COL = { side: 272, gut: 44, mid: 528 };
const NATIVE = COL.side * 2 + COL.gut * 2 + COL.mid; // 1160
const NARROW = 480;

// --- the four runs -------------------------------------------------------------------------

/** 34 rather than `PlatformLoop`'s 30: the loosening starts here, where the picture breathes most. */
const BAND = 34;
const LANE = 6;
const BEND = 10;
const HEAD = 6;
const WING = 4;

const BAND_W = COL.gut * 2 + COL.mid; // 616
const X = { eq: 0, people: BAND_W };

const TURN = 112;
const MID_C = COL.gut + COL.mid / 2;
const IN_X = MID_C - TURN;
const OUT_X = MID_C + TURN;

/** One sweep for all four, because the loop goes one way. */
const CW = 1;
const LO = BAND - LANE;

const TOP = {
	telemetry: {
		line: `M ${X.eq},${LANE} H ${IN_X - BEND} A ${BEND},${BEND} 0 0 ${CW} ${IN_X},${LANE + BEND} V ${BAND}`,
		head: `M ${IN_X - WING},${BAND - HEAD} L ${IN_X},${BAND} L ${IN_X + WING},${BAND - HEAD}`,
	},
	views: {
		line: `M ${OUT_X},${BAND} V ${LANE + BEND} A ${BEND},${BEND} 0 0 ${CW} ${OUT_X + BEND},${LANE} H ${X.people}`,
		head: `M ${X.people - HEAD},${LANE - WING} L ${X.people},${LANE} L ${X.people - HEAD},${LANE + WING}`,
	},
};

const BOT = {
	commands: {
		line: `M ${IN_X},0 V ${LO - BEND} A ${BEND},${BEND} 0 0 ${CW} ${IN_X - BEND},${LO} H ${X.eq}`,
		head: `M ${X.eq + HEAD},${LO - WING} L ${X.eq},${LO} L ${X.eq + HEAD},${LO + WING}`,
	},
	actions: {
		line: `M ${X.people},${LO} H ${OUT_X + BEND} A ${BEND},${BEND} 0 0 ${CW} ${OUT_X},${LO - BEND} V 0`,
		head: `M ${OUT_X - WING},${HEAD} L ${OUT_X},0 L ${OUT_X + WING},${HEAD}`,
	},
};

const BANDS = { in: [TOP.telemetry, TOP.views], out: [BOT.commands, BOT.actions] };

// --- the stacked form's arrows ---------------------------------------------------------------

const STEM = { w: 14, h: 12 };
const HEAD_D = `M ${STEM.w / 2 - WING},${STEM.h - HEAD} L ${STEM.w / 2},${STEM.h} L ${STEM.w / 2 + WING},${STEM.h - HEAD}`;

const ORDER = ['equipment', 'platform', 'people'];
const dirOf = (r: PlatformRun) => (ORDER.indexOf(r.from) < ORDER.indexOf(r.to) ? 'down' : 'up');

const srcOf = (id: PlatformRun['id']) => PLATFORM_RUNS.find((r) => r.id === id)!.from;
const bandSrc = { in: ['telemetry', 'views'], out: ['commands', 'actions'] } as const;

const zoneItems = (z: Zone) => z.items;

const vars = [
	`--plat-u: min(1.15px, calc(100cqw / ${NATIVE}))`,
	`--plat-u-narrow: min(1.25px, calc(100cqw / ${NARROW}))`,
	`--plat-native: ${NATIVE}`,
	`--plat-narrow: ${NARROW}`,
	`--plat-col-side: ${COL.side}`,
	`--plat-col-gut: ${COL.gut}`,
	`--plat-col-mid: ${COL.mid}`,
	`--plat-band: ${BAND}`,
].join('; ');
---

<div class="plat-fit">
	<div class="plat" style={vars} data-found={foundations ? '' : undefined}>
		{
			PLATFORM_ZONES.map((z) => (
				<section class={`plat__zone plat__zone--${z.id}`} aria-labelledby={`plat-r-${z.id}`}>
					<header class="plat__zone-head">
						<Icon class="plat__zone-emblem" name={z.icon} aria-hidden="true" />
						<h3 class="plat__zone-title" id={`plat-r-${z.id}`}>
							{z.title}
						</h3>
					</header>
					<ul class="plat__items">
						{zoneItems(z).map((it) => (
							<li class="plat__item">
								<Icon class="plat__item-icon" name={it.icon} aria-hidden="true" />
								<div>
									<p class="plat__item-name">{it.name}</p>
									<p class="plat__item-note">{it.note}</p>
								</div>
							</li>
						))}
					</ul>
				</section>
			))
		}

		{
			PLATFORM_RUNS.map((r) => (
				<p class={`plat__run plat__run--${r.id}`} data-src={r.from}>
					<span class="plat__stem" data-dir={dirOf(r)} aria-hidden="true">
						<span class="plat__stem-line" />
						<svg class="plat__stem-head" viewBox={`0 0 ${STEM.w} ${STEM.h}`}>
							<path d={HEAD_D} />
						</svg>
					</span>
					<span>{r.label}</span>
				</p>
			))
		}

		{
			/* Before the platform in the DOM, so the card paints over the last unit of each run and a
		    rounded join cannot show a seam at the edge. The card's shadow falls across those same
		    units, which is the right reading: the runs pass under something raised. */
		}
		{
			(['in', 'out'] as const).map((which) => (
				<div class={`plat__band plat__band--${which}`} aria-hidden="true">
					<svg class="plat__wires" viewBox={`0 0 ${BAND_W} ${BAND}`} preserveAspectRatio="none">
						{BANDS[which].map((r, i) => (
							<Fragment>
								<path class="plat__wire" data-src={srcOf(bandSrc[which][i])} d={r.line} />
								<path class="plat__head" data-src={srcOf(bandSrc[which][i])} d={r.head} />
							</Fragment>
						))}
					</svg>
				</div>
			))
		}

		<section class="plat__core" aria-labelledby="plat-r-core">
			<header class="plat__core-head">
				<span class="plat__core-mark" aria-hidden="true" set:html={mark} />
				<h3 class="plat__core-title" id="plat-r-core">{PLATFORM_CORE.brand} {PLATFORM_CORE.product}</h3>
			</header>

			{
				/* No rail, so no absolute positioning and no knockout: a stage is just an icon, a verb
			    and a line of detail, in that order and in normal flow. */
			}
			<ol class="plat__stages">
				{
					PLATFORM_STAGES.map((s) => (
						<li class="plat__stage">
							<Icon class="plat__stage-icon" name={s.icon} aria-hidden="true" />
							<p class="plat__stage-name">{s.name}</p>
							<p class="plat__stage-note">{s.note}</p>
						</li>
					))
				}
			</ol>

			<ul class="plat__found">
				{
					PLATFORM_FOUNDATIONS.map((f) => (
						<li class="plat__found-item">
							<Icon class="plat__found-icon" name={f.icon} aria-hidden="true" />
							<span>{f.label}</span>
						</li>
					))
				}
			</ul>
		</section>
	</div>
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	.plat-fit {
		container-type: inline-size;
	}

	.plat {
		--u: var(--plat-u);

		--plat-equipment: #0e7490;
		--plat-platform: #{$color-brand};
		--plat-people: #b45309;

		--plat-surface: color-mix(in srgb, var(--plat-platform) 7%, #fff);
		--plat-paper: var(--color-bg-surface, #fff);
		--plat-line: var(--color-border, #ebebeb);
		--plat-ink: var(--color-text, #17181c);
		--plat-muted: var(--color-text-secondary, #5b616e);

		display: grid;
		grid-template-columns:
			u(var(--plat-col-side)) u(var(--plat-col-gut)) u(var(--plat-col-mid))
			u(var(--plat-col-gut)) u(var(--plat-col-side));
		grid-template-rows: auto u(var(--plat-band)) auto u(var(--plat-band)) auto;
		max-width: u(var(--plat-native));
		margin: 0 auto;
	}

	// --- the two outer zones ---------------------------------------------------------------

	.plat__zone {
		display: flex;
		flex-direction: column;
		grid-row: 2 / 5;
		padding: u(16) u(20);
		border: max(1px, #{u(1)}) solid var(--plat-line);
		border-radius: u(10);
		background: var(--plat-paper);
	}

	.plat__zone--equipment {
		--zone: var(--plat-equipment);
		grid-column: 1;
	}

	.plat__zone--people {
		--zone: var(--plat-people);
		grid-column: 5;
	}

	.plat__zone-head {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: u(10);
		padding-bottom: u(14);
		border-bottom: max(1px, #{u(1)}) solid var(--plat-line);
	}

	.plat__zone-emblem {
		flex: none;
		width: u(26);
		height: u(26);
		color: var(--zone);
	}

	.plat__zone-title {
		margin: 0;
		font-size: u(15);
		font-weight: $font-weight-medium;
		line-height: 1.2;
		letter-spacing: -0.005em;
		color: var(--zone);
	}

	.plat__items {
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	// Three equal shares of the card's height: what keeps the left column's rows level with the
	// right column's without either of them knowing the other exists.
	.plat__item {
		display: flex;
		flex: 1 1 0;
		align-items: center;
		gap: u(13);
		padding: u(14) 0;

		& + & {
			border-top: max(1px, #{u(1)}) solid var(--plat-line);
		}
	}

	.plat__item-icon {
		flex: none;
		width: u(27);
		height: u(27);
		color: var(--zone);
	}

	.plat__item-name {
		margin: 0;
		font-size: u(16);
		font-weight: $font-weight-bold;
		line-height: 1.2;
		letter-spacing: -0.015em;
		color: var(--plat-ink);
	}

	/* The floor of the composition, and so the number the stacking threshold is set from. */
	.plat__item-note {
		margin: u(3) 0 0;
		font-size: u(13.5);
		line-height: 1.35;
		color: var(--plat-muted);
	}

	// --- the platform, raised ------------------------------------------------------------------

	// No border. A hairline as well as a shadow reads as a card with an outline drawn on it; the
	// shadow on its own is what lifts it off the two zones. The recipe is the page's — a 1px contact
	// shadow that does not scale, over an ambient one that does.
	.plat__core {
		grid-column: 3;
		grid-row: 3;
		padding: u(20) u(26) u(24);
		border-radius: u(12);
		background: var(--plat-surface);
		box-shadow:
			0 1px 2px rgba(16, 24, 40, 0.04),
			0 #{u(12)} #{u(28)} #{u(-8)} rgba(16, 24, 40, 0.12);
	}

	.plat__core-head {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: u(13);
		padding-bottom: u(20);
	}

	// 38 rather than 26. The mark carries the emphasis the heading's two weights used to.
	.plat__core-mark {
		display: block;
		flex: none;
		width: u(38);
		height: u(38);
		color: var(--plat-platform);
	}

	// One weight for both words — a lockup in one voice rather than two.
	.plat__core-title {
		margin: 0;
		font-size: u(26);
		font-weight: $font-weight-bold;
		line-height: 1.1;
		letter-spacing: -0.025em;
		color: var(--plat-platform);
	}

	.plat__stages {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		column-gap: u(18);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	// In flow, not absolute: the rail it used to have to dodge is gone.
	.plat__stage-icon {
		display: block;
		width: u(30);
		height: u(30);
		margin-bottom: u(13);
		color: var(--plat-platform);
	}

	// Ink, not indigo. The heading, the mark and the icons are the column's colour; the four verbs
	// are its content, and colouring them made all four things compete for the same attention.
	.plat__stage-name {
		margin: 0;
		font-size: u(20);
		font-weight: $font-weight-bold;
		line-height: 1.15;
		letter-spacing: -0.025em;
		color: var(--plat-ink);
	}

	.plat__stage-note {
		margin: u(6) 0 0;
		font-size: u(13.5);
		line-height: 1.35;
		color: var(--plat-muted);
	}

	.plat__found {
		display: none;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		column-gap: u(18);
		margin: u(22) 0 0;
		padding: u(18) 0 0;
		border-top: max(1px, #{u(1)}) solid color-mix(in srgb, var(--plat-platform) 28%, #fff);
		list-style: none;
	}

	.plat[data-found] .plat__found {
		display: grid;
	}

	.plat__found-item {
		display: flex;
		align-items: center;
		gap: u(9);
		font-size: u(14);
		font-weight: $font-weight-medium;
		letter-spacing: -0.01em;
		color: var(--plat-platform);
	}

	.plat__found-icon {
		flex: none;
		width: u(21);
		height: u(21);
	}

	// --- the four runs ------------------------------------------------------------------------

	.plat__band {
		grid-column: 2 / 5;
	}

	.plat__band--in {
		grid-row: 2;
	}

	.plat__band--out {
		grid-row: 4;
	}

	// The global reset gives every `svg` a `max-width: 100%`; stated away rather than relied on.
	.plat__wires {
		display: block;
		width: 100%;
		max-width: none;
		height: 100%;
	}

	.plat__wire,
	.plat__head {
		fill: none;
		stroke: currentColor;
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.plat__wire[data-src='equipment'],
	.plat__head[data-src='equipment'] {
		stroke: var(--plat-equipment);
	}

	.plat__wire[data-src='platform'],
	.plat__head[data-src='platform'] {
		stroke: var(--plat-platform);
	}

	.plat__wire[data-src='people'],
	.plat__head[data-src='people'] {
		stroke: var(--plat-people);
	}

	.plat__run {
		margin: 0;
		max-width: u(230);
		font-size: u(15);
		font-weight: $font-weight-medium;
		line-height: 1.3;
		letter-spacing: -0.005em;

		&[data-src='equipment'] {
			color: var(--plat-equipment);
		}

		&[data-src='platform'] {
			color: var(--plat-platform);
		}

		&[data-src='people'] {
			color: var(--plat-people);
		}
	}

	.plat__run--telemetry,
	.plat__run--commands {
		grid-column: 2 / 4;
		justify-self: start;
	}

	.plat__run--views,
	.plat__run--actions {
		grid-column: 3 / 5;
		justify-self: end;
		text-align: right;
	}

	.plat__run--telemetry,
	.plat__run--views {
		grid-row: 1;
		margin-bottom: u(10);
	}

	.plat__run--commands,
	.plat__run--actions {
		grid-row: 5;
		margin-top: u(10);
	}

	.plat__stem {
		display: none;
	}

	.plat__stem-line {
		flex: 1 1 auto;
		width: u(3);
		border-radius: u(1.5);
		background: currentColor;
	}

	.plat__stem-head {
		flex: none;
		width: u(14);
		height: u(12);
		max-width: none;
		margin-top: u(-6);
		fill: none;
		stroke: currentColor;
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	// --- stacked -------------------------------------------------------------------------------
	//
	// As `PlatformLoop`: below a 1000px container the wide composition's floor is under 11.6px and
	// falling, so the picture stacks and re-derives its unit from 480 units. A container query, not
	// a media query.
	@container (max-width: 1000px) {
		.plat {
			--u: var(--plat-u-narrow);
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-template-rows: auto minmax(u(52), auto) auto minmax(u(52), auto) auto;
			max-width: u(var(--plat-narrow));
			row-gap: 0;
		}

		.plat__zone--equipment {
			grid-column: 1 / -1;
			grid-row: 1;
		}

		.plat__core {
			grid-column: 1 / -1;
			grid-row: 3;
		}

		.plat__zone--people {
			grid-column: 1 / -1;
			grid-row: 5;
		}

		.plat__band {
			display: none;
		}

		.plat__run {
			display: flex;
			align-items: center;
			gap: u(10);
			max-width: none;
			margin: 0;
		}

		.plat__run--telemetry,
		.plat__run--views {
			grid-column: 1;
			justify-self: start;
			text-align: left;
		}

		.plat__run--commands,
		.plat__run--actions {
			grid-column: 2;
			justify-self: end;
			text-align: right;
			flex-direction: row-reverse;
		}

		.plat__run--telemetry,
		.plat__run--commands {
			grid-row: 2;
		}

		.plat__run--views,
		.plat__run--actions {
			grid-row: 4;
		}

		.plat__stem {
			display: flex;
			flex: none;
			flex-direction: column;
			align-items: center;
			align-self: stretch;
			width: u(14);
		}

		.plat__stem[data-dir='up'] {
			flex-direction: column-reverse;

			.plat__stem-head {
				margin: 0 0 u(-6);
				transform: scaleY(-1);
			}
		}

		// Four stages in a 480-unit column give each one 110 units, which will not hold
		// "Rule chains, calculated fields, alarms". Two rows of two.
		.plat__stages {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			row-gap: u(22);
		}
	}
</style>
