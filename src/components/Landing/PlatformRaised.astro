	// --- stacked -------------------------------------------------------------------------------
	//
	// 768, not `PlatformLoop`'s 1000. The drawing is meant to stay horizontal and simply scale, and
	// to go vertical for phones and small tablets — so the number is the one the page around it
	// already switches at: `_home-rows.scss` stacks the homepage's rows at 768 too, and a visual that
	// turned at a different width from its own row would be two layout changes on one scroll.
	//
	// What it costs, stated rather than discovered later: at 768 the floor is 9.8px, and the wide cut
	// is asked to hold down to there. Below it the picture stacks and re-derives its unit from 480
	// units, which puts R at 34 and the floor back at 10.9px on a 367px phone column.
	@container (max-width: 768px) {
		.plat {
			--u: var(--plat-u-narrow);
			grid-template-columns: repeat(2, minmax(0, 1fr));
			// 48, not 52: a label over a 26-unit arrow. The band was 52 units of mostly nothing.
			grid-template-rows: auto minmax(u(48), auto) auto minmax(u(48), auto) auto;
			max-width: u(var(--plat-narrow));
			margin-inline: auto;
			row-gap: 0;
		}

		// The two outer cards are narrower than the core, and centred. 340 is the width the CORE
		// needs; the zones need 245 — "Gateways and platforms" at 180 plus 65 of chrome — so at the
		// full width their text ended two thirds of the way across a box with nothing in the rest of
		// it. 290 leaves them 45 units of slack instead of 95, and makes the platform visibly the
		// widest thing in the column, which is what the drawing is about.
		.plat__zone {
			max-width: u(290);
			margin-inline: auto;
		}

		.plat__zone--equipment {
			grid-column: 1 / -1;
			grid-row: 1;
		}

		.plat__core {
			grid-column: 1 / -1;
			grid-row: 3;
		}

		.plat__zone--people {
			grid-column: 1 / -1;
			grid-row: 5;
		}

		.plat__band {
			display: none;
		}

		// THE LABEL GOES OVER THE ARROW, not beside it, and that one move is what fixed this row.
		//
		// Beside it, the label needs the half-column minus the lane, minus the stem, minus the gap —
		// 97 units at this width, against the 148 "Views and alerts" needs. It only ever fitted
		// because the composition was 480 units wide, which is the same 480 that was making the cards
		// too wide for their contents. Over the arrow, the label has the whole half to itself and
		// still fits on one line at 340.
		//
		// Each run is then simply centred in its half, so the two stems land on the quarter points —
		// 85 and 255 — with no lane arithmetic at all. That also clears the badge, which straddles
		// the core's top edge and reaches 32 either side of centre.
		//
		// The label sits at the run's SOURCE end: above a downward arrow, below an upward one. So
		// every arrowhead touches the card it points at, and the words name the flow where it starts.
		.plat__run {
			display: flex;
			align-items: center;
			gap: u(4);
			width: 100%;
			max-width: 100%;
			margin: 0;
			justify-self: center;
			text-align: center;
		}

		// Reversed, because the stem comes FIRST in the markup. A downward run wants the label on top
		// and the arrowhead at the bottom edge, touching the card it points into; an upward run wants
		// the opposite. Getting this the wrong way round leaves each head 22 units short of its card,
		// which is exactly the unattached look this row is being fixed for.
		.plat__run--telemetry,
		.plat__run--views {
			grid-column: 1;
			flex-direction: column-reverse;
		}

		.plat__run--commands,
		.plat__run--actions {
			grid-column: 2;
			flex-direction: column;
		}

		.plat__run--telemetry,
		.plat__run--commands {
			grid-row: 2;
		}

		.plat__run--views,
		.plat__run--actions {
			grid-row: 4;
		}

		// `flex: 1` rather than a fixed height: the stem takes whatever the label leaves, so the arrow
		// still spans the gap from one card to the other however the label wraps.
		.plat__stem {
			display: flex;
			flex: 1 1 auto;
			flex-direction: column;
			align-items: center;
			width: u(14);
			min-height: u(26);
		}

		// 4 units and a 2px floor, against 3 units and none. At 480 units this line rendered 2.1px
		// grey in a 36px band of nothing, which is what read as thin and unattached — the geometry was
		// never the problem, both ends have always touched their cards.
		.plat__stem-line {
			width: max(2px, #{u(4)});
			border-radius: max(1px, #{u(2)});
		}

		.plat__stem[data-dir='up'] {
