---
import { Icon } from 'astro-icon/components';
import Button from '@components/ui/Button.astro';
import Tabs from '@components/ui/Tabs.astro';
import TabPanel from '@components/ui/TabPanel.astro';
import FaqItem from '@components/Landing/FaqItem.astro';

/**
 * The product pages' FAQ: a column of topics beside one panel of answers, each panel showing its
 * first `visibleCount` and holding the rest behind "More questions". Develop's arrangement, with
 * real tabs (`ui/Tabs`, `look="list"`): arrows move between topics, Home and End go to the ends,
 * and the column sticks under the header while a panel of seventeen answers scrolls past it. On a
 * phone the topics run as one scrolling row over the panel, since a column of seven would cost more
 * height than the answers under it.
 *
 * With no script a reader gets the first topic's first answers, as prose that opens (`FaqItem` is a
 * native `<details>`), rather than a column of dead buttons.
 *
 * Reads Pricing's `FaqCategory`, the shape `buildFaqPageSchema` takes, so a page that publishes the
 * FAQ as structured data passes the same array to its layout's `jsonLd`. That stays the page's
 * call: Cloud publishes it, On-premises deliberately does not (see the note there).
 *
 * LINKS TO ONE ANSWER, as main's Pricing FAQ has them. Every answer has an id (`<itemIdPrefix><id>`)
 * and a copy link beside it (`FaqItem`); an address whose hash names an answer — by that id, or by
 * the answer's own unprefixed id, which is what main's Pricing addresses carry — opens it on arrival:
 * its topic selected, "More questions" opened if it is held back, the answer expanded and scrolled to
 * under the bar. A page can ask the same with a `faq:open` event on the answer; before opening, the
 * answer sends `faq:reveal`, for a page whose FAQ sits inside a view of its own (Pricing's
 * deployments) to bring that view forward. `analytics` sends main's two events to the data layer:
 * `faq_node_interaction` when an answer is opened, `faq_copy_link` when its link is copied.
 */
/** Pricing's `FaqCategory`, with the pricing draft's optional `defaultOpen` per answer. */
interface Category {
	id: string;
	label: string;
	items: { id: string; question: string; answer: string; defaultOpen?: boolean }[];
}

interface Props {
	categories: Category[];
	/** Answers shown per topic before "More questions"; a topic at or under it renders no button. */
	visibleCount?: number;
	/** Prefixes the panel ids (`<prefix>-<category id>`; each tab is `<panel>-tab`). */
	idPrefix?: string;
	/** The tablist's accessible name. */
	label?: string;
	/** Prefixes every answer's id (`<itemIdPrefix><answer id>`); `<idPrefix>-q-` by default. */
	itemIdPrefix?: string;
	/** Sends main's FAQ events to the data layer (`faq_node_interaction`, `faq_copy_link`). */
	analytics?: boolean;
}

const {
	categories,
	visibleCount = 6,
	idPrefix = 'faq',
	label = 'FAQ topics',
	itemIdPrefix = `${idPrefix}-q-`,
	analytics = false,
} = Astro.props;
const panelId = (category: Category) => `${idPrefix}-${category.id}`;

// Every answer's id must be unique on the page, and the panels' ids live in the same namespace.
const answerIds = categories.flatMap((c) => c.items.map((item) => `${itemIdPrefix}${item.id}`));
const taken = new Set(categories.map(panelId));
for (const id of answerIds) {
	if (taken.has(id)) throw new Error(`[ProductFaq] the id "${id}" is used twice on the page`);
	taken.add(id);
}
---

<div class="product-faq" data-faq-analytics={analytics ? '' : undefined}>
	<Tabs
		look="list"
		sticky
		label={label}
		items={categories.map((category) => ({ label: category.label, panel: panelId(category) }))}
		class="product-faq__tabs"
	/>

	<div class="product-faq__panels">
		{categories.map((category, i) => (
			<TabPanel id={panelId(category)} selected={i === 0}>
				{category.items.map((item, j) => (
					<FaqItem
						question={item.question}
						answer={item.answer}
						extra={j >= visibleCount}
						open={item.defaultOpen}
						id={`${itemIdPrefix}${item.id}`}
						faqId={item.id}
					/>
				))}
				{category.items.length > visibleCount && (
					<Button
						variant="tertiary"
						flush
						class="product-faq__more"
						attrs={{ 'aria-expanded': 'false', 'data-faq-more': '' }}
					>
						<span data-faq-more-label>More questions</span>
						<Icon name="tabler:chevron-down" class="product-faq__more-chevron" aria-hidden="true" />
					</Button>
				)}
			</TabPanel>
		))}
	</div>
	{/* What the copy link did, for a screen reader: the button's own tip is drawn, not spoken. */}
	<span class="ui-sr" role="status" data-faq-status></span>
</div>

<script>
	// "More questions": shows the panel's held-back answers and says so on the button, both in its
	// label and in `aria-expanded`. Each answer keeps its own open or closed state either way.
	document.querySelectorAll<HTMLButtonElement>('[data-faq-more]').forEach((more) => {
		const panel = more.closest('[role="tabpanel"]');
		const label = more.querySelector('[data-faq-more-label]');

		more.addEventListener('click', () => {
			const expanded = more.getAttribute('aria-expanded') !== 'true';
			more.setAttribute('aria-expanded', String(expanded));
			panel?.querySelectorAll<HTMLElement>('[data-faq-extra]').forEach((item) => {
				item.hidden = !expanded;
			});
			if (label) label.textContent = expanded ? 'Fewer questions' : 'More questions';
		});
	});

	// --- one answer: open it, link to it ---------------------------------------------------------

	const ANSWER = '.faq-q__details';
	const track = (event: string, answer: Element) => {
		if (!answer.closest('[data-faq-analytics]')) return;
		const id = (answer as HTMLElement).dataset.faqId;
		(window as { dataLayer?: unknown[] }).dataLayer?.push({ event, faq_node_id: id });
	};

	/** The answer a hash names: by its element id, or by its own id in the data (main's addresses). */
	const answerFor = (hash: string): HTMLDetailsElement | null => {
		if (!hash) return null;
		let id = hash;
		try {
			id = decodeURIComponent(hash);
		} catch {
			/* a malformed escape: try it as it is */
		}
		const byId = document.getElementById(id);
		if (byId?.matches(ANSWER)) return byId as HTMLDetailsElement;
		return document.querySelector<HTMLDetailsElement>(`${ANSWER}[data-faq-id="${CSS.escape(id)}"]`);
	};

	/** Brings an answer into view, opened: its view, its topic, "More questions", then the answer. */
	const reveal = (answer: HTMLDetailsElement) => {
		answer.dispatchEvent(new CustomEvent('faq:reveal', { bubbles: true }));
		const panel = answer.closest<HTMLElement>('[role="tabpanel"]');
		if (panel?.hidden) document.getElementById(panel.getAttribute('aria-labelledby') ?? '')?.click();
		if (answer.closest<HTMLElement>('[data-faq-extra]')?.hidden)
			panel?.querySelector<HTMLButtonElement>('[data-faq-more]')?.click();
		answer.open = true;
		requestAnimationFrame(() => answer.scrollIntoView({ block: 'start', behavior: 'smooth' }));
	};

	const fromHash = () => {
		const answer = answerFor(location.hash.slice(1));
		if (answer) reveal(answer);
	};
	fromHash();
	window.addEventListener('hashchange', fromHash);

	// A page's own link into the FAQ (Pricing's tooltips) asks the same way.
	document.addEventListener('faq:open', (e) => {
		if ((e.target as Element).matches?.(ANSWER)) reveal(e.target as HTMLDetailsElement);
	});

	// main's `faq_node_interaction`: an answer opened, not closed.
	document.querySelectorAll<HTMLDetailsElement>(`[data-faq-analytics] ${ANSWER}`).forEach((answer) => {
		answer.addEventListener('toggle', () => answer.open && track('faq_node_interaction', answer));
	});

	// The copy link: the page's address with the answer's id as its hash, on the clipboard.
	document.addEventListener('click', (e) => {
		const button = (e.target as Element).closest<HTMLButtonElement>('[data-faq-copy]');
		const answer = button?.closest('.faq-q')?.querySelector<HTMLDetailsElement>(ANSWER);
		if (!button || !answer?.id) return;
		const url = new URL(location.href);
		url.hash = answer.id;
		const status = button.closest('.product-faq')?.querySelector<HTMLElement>('[data-faq-status]');
		const tip = button.querySelector<HTMLElement>('[data-faq-tip]');
		track('faq_copy_link', answer);
		navigator.clipboard
			?.writeText(url.toString())
			.then(() => {
				button.dataset.copied = '';
				if (tip) tip.textContent = 'Copied';
				if (status) status.textContent = 'Link copied';
				window.setTimeout(() => {
					delete button.dataset.copied;
					if (tip) tip.textContent = 'Copy link';
					if (status) status.textContent = '';
				}, 2000);
			})
			.catch(() => {});
	});
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	.product-faq {
		display: grid;
		// The column is a fixed 232 rather than a fraction: the topics are fixed strings, and a
		// proportional column re-wraps "Trials, Cancellations & Refunds" at every width.
		grid-template-columns: 232px minmax(0, 1fr);
		gap: $spacing-12;

		@include media-down(md) {
			grid-template-columns: minmax(0, 1fr);
			gap: $spacing-6;
		}
	}

	// `start`, or the grid stretches the column to the panel's height and it has nowhere to stick.
	// On a phone the row's 2px of padding (room for the focus ring inside its scroller) is taken
	// back from the gutter, so the first topic stays on the text edge.
	.product-faq__tabs {
		align-self: start;

		@include media-down(md) {
			margin-inline: -2px;
		}
	}

	.product-faq__more {
		margin-top: $spacing-4;
	}

	// The chevron rides in the slot rather than `iconEnd`, so these rules can turn it with the state:
	// it is a toggle beside its label, not a link's arrow. 20, the button glyph's own size.
	.product-faq__more-chevron {
		flex: none;
		width: 20px;
		height: 20px;
		transition: transform 0.15s ease;

		@media (prefers-reduced-motion: reduce) {
			transition: none;
		}
	}

	.product-faq__more[aria-expanded='true'] .product-faq__more-chevron {
		transform: rotate(180deg);
	}
</style>
