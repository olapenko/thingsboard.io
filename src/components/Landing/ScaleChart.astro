---
import { SCALE_PHASES, SCALE_AXIS, type ScalePhase } from '@data/scale-visual';

/**
 * What it costs to run ThingsBoard as the fleet grows, plotted rather than asserted.
 *
 * The brief was a chart of device count split into phases, each explaining what the platform does
 * there. The metric that answers "will it cope" is the one the repo already measures: average CPU
 * on the recommended machine, benchmarked over 24-hour runs at three device counts. So the bars are
 * capacity and the fill is load, and the empty part of each bar is the headroom — which is the
 * thing the headline actually promises and the thing a slider could never show.
 *
 * Read across, devices go up 10x while load goes 20 -> 40 -> 55. The load curve flattens against
 * the device curve. That is the whole argument, and the trend line is drawn so it can be seen in
 * one glance rather than reconstructed from three numbers.
 *
 * Not interactive on purpose. A slider makes the reader do the work of finding the interesting
 * value, and most never move it — every reader sees whatever position it was left in. Three fixed
 * points show the shape of the curve immediately, and the shape is the point.
 *
 * Built in the family's language — same design unit, same cards, same computed SVG geometry with
 * endpoints derived from known numbers rather than measured after layout.
 */

interface Props {
	/** The measured points to plot. Defaults to the three the docs benchmark. */
	phases?: ScalePhase[];
}

const { phases = SCALE_PHASES } = Astro.props;

// The composition, authored at 630 units wide as the rest of the family is.
const COL_GAP = 21;
const COLS = phases.length;
// 3 * 196 + 2 * 21 = 630 exactly.
const COL_W = (630 - COL_GAP * (COLS - 1)) / COLS;
const NATIVE = COL_W * COLS + COL_GAP * (COLS - 1);

// The bar. Full height is one machine's capacity, so every bar is the same height and only the fill
// differs — three bars of different heights would be comparing three different questions.
const TRACK_H = 172;

/** Where a load of `n` percent puts the top of the fill, measured from the top of the track. */
const topOf = (load: number) => (TRACK_H * (100 - load)) / 100;

// The trend line, in the chart's own coordinate space: one point per column centre at the top of
// its fill. Computed from the same numbers the fills are, so the line cannot drift off them.
const cx = phases.map((_, i) => COL_W / 2 + i * (COL_W + COL_GAP));
const points = phases.map((p, i) => `${cx[i]},${topOf(p.load)}`).join(' ');

const vars = [
	// No floor on the unit: the composition is exactly 100cqw below the cap, so it cannot overflow
	// at any width. See ConnectFlow for why the family's 0.45px floor is a liability here.
	`--scale-u: min(1.15px, calc(100cqw / ${NATIVE}))`,
	`--scale-native: ${NATIVE}`,
	`--scale-cols: ${COLS}`,
	`--scale-col: ${COL_W}`,
	`--scale-gap: ${COL_GAP}`,
	`--scale-track-h: ${TRACK_H}`,
].join('; ');
---

<div class="scale-fit">
	<div class="scale" style={vars}>
		<p class="scale__axis">{SCALE_AXIS.caption}</p>

		<div class="scale__plot">
			{
				phases.map((p) => (
					<div class="scale__track" style={`--scale-load: ${p.load}`}>
						{/* Inside its own fill, which is where a bar chart puts a value: above the fill it
						    collided with the trend line, and a big figure sitting over a bar gets read as
						    the bar's height. */}
						<span class="scale__fill">
							<span class="scale__pct">{p.load}%</span>
						</span>
					</div>
				))
			}

			{
				/* Over the bars, so the line reads as one measurement across three of them rather than
			    as decoration inside each. Its points come from the same percentages the fills use. */
			}
			<svg class="scale__trend" viewBox={`0 0 ${NATIVE} ${TRACK_H}`} aria-hidden="true">
				<polyline class="scale__trend-line" points={points}></polyline>
				{phases.map((p, i) => <circle class="scale__trend-dot" cx={cx[i]} cy={topOf(p.load)} r="4" />)}
			</svg>
		</div>

		<ul class="scale__facts">
			{
				phases.map((p) => (
					<li class="scale__fact">
						{/* The category under its bar, which is the only place it cannot be mistaken for
						    the bar's value. */}
						<p class="scale__devices">{p.devices}</p>
						<p class="scale__range">{p.range}</p>

						<div class="scale__meta">
							<p class="scale__rate">{p.rate}</p>
							<p class="scale__machine">{p.machine}</p>
							<ul class="scale__stack">
								{p.stack.map((s) => (
									<li>{s}</li>
								))}
							</ul>
							<p class="scale__note">{p.note}</p>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	// Every size is a multiple of one design unit, so the composition scales as a piece instead of
	// reflowing. See SolutionFlow for why the unit comes from the container.
	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	.scale-fit {
		container-type: inline-size;
	}

	.scale {
		--u: var(--scale-u);
		display: grid;
		gap: u(14);
		max-width: u(var(--scale-native));
		margin: 0 auto;
	}

	// --- the axis caption -------------------------------------------------------------------

	// Said once, above the plot, so every percentage below has a unit without repeating it three
	// times. Grey and small: it is the label, not the subject.
	.scale__axis {
		margin: 0;
		font-size: u(14);
		line-height: u(20);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-text-secondary, #5b616e);
	}

	// --- the plot ---------------------------------------------------------------------------

	.scale__plot {
		position: relative;
		display: grid;
		grid-template-columns: repeat(var(--scale-cols, 3), 1fr);
		gap: u(var(--scale-gap));
	}

	// One machine's capacity. Same height in every column, because the question is the same in
	// every column; the fill is the only thing the reader is asked to compare.
	.scale__track {
		position: relative;
		height: u(var(--scale-track-h));
		border-radius: u(var(--flow-radius, 8));
		// A wash of the fill's own colour, so the empty part reads as unused capacity of the same
		// kind rather than as a different material.
		background: color-mix(in srgb, var(--color-primary, #3d50f5) 8%, transparent);
	}

	.scale__fill {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding-top: u(8);
		// Straight from the measurement. The bar cannot disagree with the label inside it.
		height: calc(var(--scale-load) * 1%);
		border-radius: u(var(--flow-radius, 8));
		background: var(--color-primary, #3d50f5);
	}

	// At the top of its own fill, so the label's position on the track encodes the value a second
	// time. The shortest fill is 20% of 172 units, which holds this line and its padding with a
	// couple of units to spare — a smaller measured load than that would need the label outside.
	.scale__pct {
		font-family: var(--flow-font-mono, #{$font-family-mono});
		font-size: u(18);
		font-weight: $font-weight-bold;
		line-height: u(22);
		color: #fff;
	}

	// --- the trend --------------------------------------------------------------------------

	// Spans the whole plot rather than sitting inside a column, because it is one line through three
	// measurements. Pinned to the track's box, not the column's, so its coordinate space and the
	// fills' are the same space.
	.scale__trend {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		height: u(var(--scale-track-h));
		max-width: none;
		overflow: visible;
		pointer-events: none;
	}

	.scale__trend-line {
		fill: none;
		stroke: var(--color-primary, #3d50f5);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-dasharray: 5 4;
		// The box is scaled by the design unit, so the dashes would scale with it otherwise.
		vector-effect: non-scaling-stroke;
	}

	.scale__trend-dot {
		fill: var(--color-primary, #3d50f5);
		stroke: var(--color-bg-surface, #fff);
		stroke-width: 2;
		vector-effect: non-scaling-stroke;
	}

	// --- the phase explanations -------------------------------------------------------------

	.scale__facts {
		display: grid;
		grid-template-columns: repeat(var(--scale-cols, 3), 1fr);
		gap: u(var(--scale-gap));
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.scale__fact {
		display: grid;
		align-content: start;
		gap: u(4);
	}

	// The category label. Mono because it is a quantity being compared across columns, and lining
	// up digit for digit is the comparison.
	.scale__devices {
		margin: 0;
		font-family: var(--flow-font-mono, #{$font-family-mono});
		font-size: u(30);
		font-weight: $font-weight-bold;
		line-height: u(34);
		color: var(--color-text);
	}

	.scale__range {
		margin: 0;
		font-size: u(14);
		line-height: u(18);
		color: var(--color-text-secondary, #5b616e);
	}

	// The phase's own rule, separating what the chart measured from what it took to get there.
	.scale__meta {
		display: grid;
		align-content: start;
		gap: u(8);
		margin-top: u(10);
		padding-top: u(12);
		border-top: 1px solid var(--color-border, #ebebeb);
	}

	// What the load above was measured at. Without it the percentage is a free-floating claim.
	.scale__rate {
		margin: 0;
		font-size: u(14);
		line-height: u(18);
		color: var(--color-text-secondary, #5b616e);
	}

	.scale__machine {
		margin: 0;
		font-family: var(--flow-font-mono, #{$font-family-mono});
		font-size: u(15);
		font-weight: $font-weight-bold;
		line-height: u(20);
		color: var(--color-text);
	}

	// The family's chips, at this visual's scale: an identifier on a wash, in mono.
	.scale__stack {
		display: flex;
		flex-wrap: wrap;
		gap: u(6);
		margin: 0;
		padding: 0;
		list-style: none;

		li {
			padding: u(4) u(10);
			border-radius: u(var(--flow-radius, 8));
			font-family: var(--flow-font-mono, #{$font-family-mono});
			font-size: u(14);
			font-weight: $font-weight-bold;
			line-height: u(20);
			color: var(--color-text);
			background: color-mix(in srgb, var(--color-primary, #3d50f5) 12%, transparent);
		}
	}

	.scale__note {
		margin: 0;
		font-size: u(14);
		line-height: u(20);
		color: var(--color-text-secondary, #5b616e);
		text-wrap: pretty;
	}
</style>
