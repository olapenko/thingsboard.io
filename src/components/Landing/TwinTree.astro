---
import { Icon } from 'astro-icon/components';
import TwinUnit from '@components/Landing/TwinUnit.astro';
import { DIGITAL_TWIN_STAGES, PHYSICAL_ASSET, TWIN, TWIN_FLOWS, TWIN_HISTORY } from '@data/digital-twin-visual';
import { sparkPaths } from '@util/sparkline';

/**
 * The twin composition, tightened. A CANDIDATE beside `DigitalTwin`, which is untouched and still
 * the row the home preview shows.
 *
 * Four changes from it, in the order they were made, because each one paid for the next:
 *
 *   1. The connectors overlap the cards instead of running between them, so the gutter drops from
 *      96u to 64u. The gutter is a FIXED track, so every unit taken out of it comes straight off
 *      the composition's width and costs the cards nothing.
 *   2. Three devices against three attributes, an exact mirror: temp probe -> temperature, door
 *      sensor -> door, compressor -> duty cycle. Power meter and alarm were the two rows with
 *      nothing facing them. Dropping alarm costs the twin its one coloured value, but the unit's
 *      green LED already says "no alarm" and the sparkline keeps the platform's blue in the card.
 *   3. The history folds into the temperature row as a sparkline beneath it. That removes the
 *      block's title, its rule, its axis and its time labels.
 *   4. The site frame's header becomes a two-line tree: the customer, then the site under it. The
 *      copy beside this visual promises "devices, assets, customers, and hierarchies", and the
 *      shipped version shows no customer anywhere.
 *
 * --- why 3 matters more than it looks -----------------------------------------------------
 *
 * One number predicts whether a scaled composition survives a phone:
 *
 *     R = native width / smallest type, both in design units
 *
 * because the rendered size of that type is just `container / R`. `DigitalTwin` is 630u with a 12u
 * floor -- the chart's axis ticks, its time labels, and the connector names -- so R = 52.5 and the
 * smallest text lands at 7.0px in the 367px column a 375px phone gives it.
 *
 * The axis and the time labels were three of the four things at 12u. Removing the chart's
 * furniture removes them, the connector names go to 14u, and the floor rises to 14u for free.
 * Together with the narrower gutter that is R = 552/14 = 39.4, or 9.3px on the same phone.
 *
 * Nothing here is interactive, and the only thing that moves is the temperature reading.
 */

// --- content ------------------------------------------------------------------------------
//
// Derived from the shared data by slicing it, not by restating it: the cut is then visible as a
// cut, and nothing this candidate does can change what the shipped visual shows.

const OWNER = { name: 'Acme Inc', icon: 'tabler:building' };
const SITE = { name: PHYSICAL_ASSET.path[0], icon: 'tabler:building-warehouse' };

/** Temp probe, door sensor, compressor. The power meter is the device with no value facing it. */
const UNIT = {
	name: PHYSICAL_ASSET.name,
	icon: PHYSICAL_ASSET.icon,
	devices: PHYSICAL_ASSET.devices.slice(0, 3),
};

/** temperature, door, duty cycle -- in the devices' own order, so the mirror is row for row. */
const ATTRS = TWIN.attributes.filter((a) => a.key !== 'alarm');

const telemetry = TWIN_FLOWS.find((f) => f.to === 'twin');
const commands = TWIN_FLOWS.find((f) => f.to === 'physical');

// --- the sparkline ------------------------------------------------------------------------
//
// A full day, generated here rather than taken from `TWIN_HISTORY.series`. That series stops at
// 16:00 on purpose: the shipped chart labels its axis `00:00` / `24:00`, so the empty remainder
// is what says where in the day we are. With the labels gone an empty right third reads as a
// chart that failed to load, so this one fills its box. Same formula as the data file's, same
// domain -- the freezer's working band, not the series' own extent, so the line stays calm.
const TAU = Math.PI * 2;
const STEP_H = 0.5;
const SPARK_SERIES = Array.from({ length: TWIN_HISTORY.hours / STEP_H + 1 }, (_, i) => {
	const t = i * STEP_H;
	const v =
		-18.3 +
		0.9 * Math.sin((TAU * t) / 9 + 0.6) +
		0.3 * Math.sin((TAU * t) / 2.3) +
		1.1 * Math.pow(Math.max(0, Math.sin((TAU * t) / 6)), 6);
	return Math.round(v * 100) / 100;
});

const SPARK_VIEW = { w: 100, h: 34, pad: 0 };
const spark = sparkPaths(SPARK_SERIES, TWIN_HISTORY.domain, SPARK_VIEW);

// --- geometry -----------------------------------------------------------------------------
//
// Every height is computed rather than left to the content, because the connectors have to land
// on bands they cannot see. The CSS below sets these same numbers, so a mismatch between the two
// shows up as an overflow rather than as an arrow that quietly misses.

// Measured, not guessed. The unit card's intrinsic minimum is 195u — set by its head band, not
// by its device rows — so the frame column is that plus its padding plus a little slack. The twin's
// own text minimum is 144u; it is given far more than that because the sparkline needs a run to
// read as one, and because this is still the half the eye is meant to land on.
//
// The gutter is 76 rather than the 44 the overlap would allow, and the difference is entirely the
// two names: `commands` sets at 68.5u, and the label has to clear the twin's card edge. Dropping
// the names would buy 32u — R 39.4 -> 37.1, 9.3px -> 9.9px on a 375px phone — which is the price
// of saying which direction is which.
const NATIVE = 552;
const COL = { site: 232, gut: 76, twin: 244 };

const FRAME_PAD = 12;
const ORG_H = 20; // the customer line
const SITE_H = 24; // the site line beneath it
const TREE_H = ORG_H + SITE_H;
const TREE_GAP = 10; // tree to unit

// TwinUnit's own metrics, mirrored here so the arrows can be placed: 12 + 22 + 12 for the head
// band, 8 + 26 + 8 for a device row.
//
// What cannot be mirrored is its chrome: a 1px border top and bottom and a 1px hairline between
// each pair of rows, 4px in all, which are PIXELS and so do not scale with the unit. Measured, the
// card comes out 4px taller than the arithmetic below says.
//
// The frame is given the computed height anyway, so those 4px are eaten out of its 12u of bottom
// padding rather than added to the composition. Every band above the unit's last row is then
// exactly where the arithmetic puts it, and the one connector that aims below them — commands,
// into the last device row — lands 3px high of that row's centre, which is 7% of the row at the
// desktop cap. The alternative, stretching the drawing to the card's real height, was measured
// too: it trades that 3px for 2.9px at the other end. Not worth the machinery.
const UNIT_HEAD_H = 46;
const UNIT_ROW_H = 42;
const UNIT_H = UNIT_HEAD_H + UNIT.devices.length * UNIT_ROW_H;

const FRAME_H = FRAME_PAD * 2 + TREE_H + TREE_GAP + UNIT_H;
const UNIT_TOP = FRAME_PAD + TREE_H + TREE_GAP;

const TWIN_HEAD_H = 46;
const ATTR_H = 36; // 7 + 22 + 7
const SPARK_GAP = 6;
const SPARK_PAD_B = 12;
const SERIES_H = 7 + 22 + SPARK_GAP + SPARK_VIEW.h + SPARK_PAD_B;
const TWIN_H = TWIN_HEAD_H + SERIES_H + (ATTRS.length - 1) * ATTR_H;

const BODY_H = Math.max(FRAME_H, TWIN_H);
// Centred, not top-aligned: it puts the two cards' feet within a few units of each other, which
// is what lets the commands connector run almost flat.
const TWIN_TOP = (BODY_H - TWIN_H) / 2;

// How far the connectors reach past the card edges. Both land inside the 16u of padding the cards
// carry at that edge and no further: at 26 the telemetry chevron came down on the twin's head icon,
// and on the unit an end much past 16 would reach the head's text. Enough to be seen crossing an
// edge is all this has to be -- what carries the overlap is that the connectors are ABOVE the
// cards now, and that they attach to a head band and a foot row instead of to the middle of a gap.
const OVER_UNIT = 14;
const OVER_TWIN = 12;

// The connector layer's own box: the gutter, plus the frame's padding and both overhangs. It
// overflows its grid track by exactly the margins below.
const WIRE_W = OVER_UNIT + FRAME_PAD + COL.gut + OVER_TWIN;
const UNIT_EDGE = OVER_UNIT; // the unit's right edge, in the layer's coordinates
const TWIN_EDGE = OVER_UNIT + FRAME_PAD + COL.gut; // the twin's left edge

const TAIL = 10; // straight run before a chevron, so the head reads as a head
const EASE = 0.5;
const HEAD = 7;
const WING = 5;

// Both connectors leave and arrive horizontally, and the whole overhang at each end is straight:
// a curve crossing a card edge would look like it was bending around the card.
const upstream = { y0: UNIT_TOP + UNIT_HEAD_H / 2, y1: TWIN_TOP + TWIN_HEAD_H / 2 };
const downstream = {
	y0: TWIN_TOP + TWIN_H - ATTR_H / 2,
	y1: UNIT_TOP + UNIT_H - UNIT_ROW_H / 2,
};

const rightward = (y0: number, y1: number) => {
	const a = UNIT_EDGE;
	const b = WIRE_W - TAIL;
	const k = (b - a) * EASE;
	return `M 0,${y0} L ${a},${y0} C ${a + k},${y0} ${b - k},${y1} ${b},${y1} L ${WIRE_W},${y1}`;
};

const leftward = (y0: number, y1: number) => {
	const a = TWIN_EDGE;
	const b = UNIT_EDGE;
	const k = (a - b) * EASE;
	return `M ${WIRE_W},${y0} L ${a},${y0} C ${a - k},${y0} ${b + k},${y1} ${b},${y1} L 0,${y1}`;
};

const wires = {
	up: rightward(upstream.y0, upstream.y1),
	down: leftward(downstream.y0, downstream.y1),
	// The stretch that crosses the dark card, redrawn light on top of the grey. Straight, because
	// the overhang is straight, so the two align exactly without splitting the curve.
	upOverDark: `M 0,${upstream.y0} L ${UNIT_EDGE},${upstream.y0}`,
	downOverDark: `M ${UNIT_EDGE},${downstream.y1} L 0,${downstream.y1}`,
	upHead: `M ${WIRE_W - HEAD},${upstream.y1 - WING} L ${WIRE_W},${upstream.y1} L ${WIRE_W - HEAD},${upstream.y1 + WING}`,
	downHead: `M ${HEAD},${downstream.y1 - WING} L 0,${downstream.y1} L ${HEAD},${downstream.y1 + WING}`,
};

// Each name sits on its own line, knocked out of it, halfway between the two card EDGES -- not
// halfway across the gutter track, which is 12u further right because the frame's padding is only
// on one side. Centring on the track put `commands` a pixel over the twin's border.
const LABEL_X = (UNIT_EDGE + TWIN_EDGE) / 2;
const labels = {
	up: { x: LABEL_X, y: (upstream.y0 + upstream.y1) / 2 },
	down: { x: LABEL_X, y: (downstream.y0 + downstream.y1) / 2 },
};

/** As a share of the connector layer's box, so a label tracks the stretched line and not the grid. */
const at = (x: number, y: number) =>
	`--x: ${((x / WIRE_W) * 100).toFixed(3)}%; --y: ${((y / BODY_H) * 100).toFixed(3)}%`;

const vars = [
	`--tt-u: clamp(0.45px, calc(100cqw / ${NATIVE}), 1.15px)`,
	`--tt-native: ${NATIVE}`,
	`--tt-site: ${COL.site}`,
	`--tt-gut: ${COL.gut}`,
	`--tt-twin: ${COL.twin}`,
	`--tt-pad: ${FRAME_PAD}`,
	`--tt-body-h: ${BODY_H}`,
	`--tt-twin-h: ${TWIN_H}`,
	`--tt-tree-gap: ${TREE_GAP}`,
	`--tt-org-h: ${ORG_H}`,
	`--tt-site-h: ${SITE_H}`,
	`--tt-spark-h: ${SPARK_VIEW.h}`,
	`--tt-spark-gap: ${SPARK_GAP}`,
	`--tt-spark-pad-b: ${SPARK_PAD_B}`,
	`--tt-wire-w: ${WIRE_W}`,
	`--tt-wire-l: ${FRAME_PAD + OVER_UNIT}`,
	`--tt-wire-r: ${OVER_TWIN}`,
].join(';');
---

<div class="tt-fit">
	<div class="tt" style={vars} data-twin>
		<p class="tt__stage">{DIGITAL_TWIN_STAGES.physical}</p>
		<p class="tt__stage tt__stage--right">{DIGITAL_TWIN_STAGES.twin}</p>

		{
			/* --- the real thing, in its place --------------------------------------------------
		    The frame is the scope and its header is the path: the customer, and the site under it.
		    Two levels for the price of one line of type and no width at all, where a second frame
		    would have cost padding on both sides and made three nested rectangles of a picture that
		    only has one subject. */
		}
		<div class="tt__site">
			<p class="tt__org">
				<Icon name={OWNER.icon} aria-hidden="true" />
				<span>{OWNER.name}</span>
			</p>
			<p class="tt__site-name">
				<i class="tt__branch" aria-hidden="true"></i>
				<Icon name={SITE.icon} aria-hidden="true" />
				<span>{SITE.name}</span>
			</p>
			<TwinUnit unit={UNIT} class="tt__unit" />
		</div>

		{
			/* --- what crosses ------------------------------------------------------------------
		    Above both cards rather than under them, which is the whole change: the connectors are
		    no longer something that happens in the space between two objects, they are something
		    that reaches into them. */
		}
		<div class="tt__flows" aria-hidden="true">
			<svg
				class="tt__wires"
				viewBox={`0 0 ${WIRE_W} ${BODY_H}`}
				preserveAspectRatio="none"
				aria-hidden="true"
				focusable="false"
			>
				<path class="tt__wire" d={wires.up}></path>
				<path class="tt__wire" d={wires.down}></path>
				<path class="tt__wire tt__wire--head" d={wires.upHead}></path>
				{/* Redrawn over the dark card, where grey would be all but invisible. */}
				<path class="tt__wire tt__wire--light" d={wires.upOverDark}></path>
				<path class="tt__wire tt__wire--light" d={wires.downOverDark}></path>
				<path class="tt__wire tt__wire--light tt__wire--head" d={wires.downHead}></path>
			</svg>

			<span class="tt__flow-name" style={at(labels.up.x, labels.up.y)}>{telemetry?.label}</span>
			<span class="tt__flow-name" style={at(labels.down.x, labels.down.y)}>{commands?.label}</span>
		</div>

		{/* --- its twin ---------------------------------------------------------------------- */}
		<div class="tt__card">
			<header class="tt__head">
				<Icon name="tabler:box-model" aria-hidden="true" />
				<span class="tt__name">{TWIN.name}</span>
			</header>

			{
				/* A list, not a definition list: the temperature row carries its own history under it,
			    and a `dl` may hold nothing but `dt` and `dd`. */
			}
			<ul class="tt__attrs">
				{
					ATTRS.map((a, i) => (
						<li class:list={['tt__attr', i === 0 && 'tt__attr--series']} data-twin-attr={a.key}>
							<span class="tt__k">{a.key}</span>
							<span class="tt__v">{a.value}</span>
							{i === 0 && (
								<span class="tt__spark">
									<svg viewBox={`0 0 ${SPARK_VIEW.w} ${SPARK_VIEW.h}`} preserveAspectRatio="none" aria-hidden="true">
										<path class="tt__spark-area" d={spark.area} />
										<path class="tt__spark-line" d={spark.line} />
									</svg>
								</span>
							)}
						</li>
					))
				}
			</ul>
		</div>
	</div>
</div>

<script>
	/**
	 * The one thing that moves, as in the shipped visual: the temperature reading steps through a
	 * short precalculated loop, only while on screen. The sparkline underneath does not follow it —
	 * it is the day, and the day does not change every three seconds.
	 */
	const BEAT_MS = 3000;
	const TEMPS = [-18.4, -18.2, -18.6, -18.3, -18.7, -18.1];

	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll<HTMLElement>('.tt[data-twin]').forEach((root) => {
		if (reduce) return;
		const temp = root.querySelector<HTMLElement>('[data-twin-attr="temperature"] .tt__v');
		if (!temp) return;

		let beat = 0;
		let visible = false;
		let timer = 0;

		const tick = () => {
			if (!visible) return;
			beat++;
			temp.textContent = `−${Math.abs(TEMPS[beat % TEMPS.length]).toFixed(1)} °C`;
			timer = window.setTimeout(tick, BEAT_MS);
		};

		new IntersectionObserver(
			(entries) => {
				visible = entries.some((e) => e.isIntersecting);
				clearTimeout(timer);
				if (visible) timer = window.setTimeout(tick, BEAT_MS);
			},
			{ rootMargin: '80px' }
		).observe(root);
	});
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	.tt-fit {
		container-type: inline-size;
	}

	.tt {
		--u: var(--tt-u);
		// TwinUnit reads this one; it is the family's unit under its family name.
		--flow-u: var(--tt-u);
		display: grid;
		// Fixed tracks, not fr. The connectors are drawn from these numbers, so the numbers have to
		// be knowable at build time — and a fixed track that is too narrow shows as an overflow,
		// which is a thing you can see, where a fr track that is too narrow just squeezes the type.
		grid-template-columns: u(var(--tt-site)) u(var(--tt-gut)) u(var(--tt-twin));
		grid-template-rows: auto u(var(--tt-body-h));
		grid-template-areas:
			'stage-l .     stage-r'
			'site    flows digital';
		justify-content: center;
		max-width: u(var(--tt-native));
		margin: 0 auto;
	}

	// --- the two halves, named ------------------------------------------------------

	.tt__stage {
		grid-area: stage-l;
		min-height: u(24);
		margin: 0 0 u(8);
		font-size: u(15);
		line-height: u(24);
		text-align: center;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		white-space: nowrap;
		color: var(--color-text-secondary, #5b616e);
	}

	.tt__stage--right {
		grid-area: stage-r;
	}

	// --- the site frame -------------------------------------------------------------

	.tt__site {
		grid-area: site;
		// The computed height, not the content's: see the note on TwinUnit's pixel chrome above.
		height: u(var(--tt-body-h));
		padding: u(var(--tt-pad));
		border: 1px solid var(--color-border, #ebebeb);
		// The cards' own radius, so the frame is one more card and not a different kind of shape.
		border-radius: u(var(--flow-radius, 8));
		background: var(--color-bg-light, #f7f9fc);
	}

	// The customer: the quieter of the two lines, because it is context and the site is the scope
	// the unit actually sits in.
	.tt__org {
		display: flex;
		align-items: center;
		gap: u(8);
		height: u(var(--tt-org-h));
		margin: 0;
		font-size: u(14);
		line-height: u(20);
		white-space: nowrap;
		color: var(--color-text-secondary, #5b616e);

		[data-icon] {
			flex: none;
			width: u(16);
			height: u(16);
		}
	}

	// The site, indented under it. Medium against the customer's regular, so the second line is
	// the operative one even though it is the subordinate one.
	.tt__site-name {
		display: flex;
		align-items: center;
		gap: u(6);
		height: u(var(--tt-site-h));
		margin: 0;
		font-size: u(15);
		font-weight: $font-weight-medium;
		line-height: u(22);
		white-space: nowrap;
		color: var(--color-text-secondary, #5b616e);

		[data-icon] {
			flex: none;
			width: u(16);
			height: u(16);
		}
	}

	// The elbow between the two lines, drawn rather than typed: a box-drawing character would be a
	// glyph at the type's size and this has to be a hairline at the frame's.
	.tt__branch {
		flex: none;
		width: u(9);
		// Tall enough to start inside the customer's line rather than below it: a stub that begins in
		// the gap reads as a dash, and the point is that the site hangs off the line above it. Its
		// stem lands on the centre of that line's icon; its arm on the centre of this one's text.
		height: u(19);
		margin: u(-17) u(2) 0 u(7);
		border-bottom: 1px solid var(--color-border-strong, #d5d7dd);
		border-left: 1px solid var(--color-border-strong, #d5d7dd);
		border-bottom-left-radius: u(3);
	}

	.tt__unit {
		margin-top: u(var(--tt-tree-gap));
	}

	// --- the twin -------------------------------------------------------------------

	.tt__card {
		grid-area: digital;
		display: flex;
		overflow: hidden;
		flex-direction: column;
		// Centred against the frame, which puts the two cards' feet level and lets the commands
		// connector run almost flat. `center`, not the computed offset, so it stays centred against
		// the frame's real height.
		align-self: center;
		height: u(var(--tt-twin-h));
		border: 1px solid var(--color-border, #ebebeb);
		border-radius: u(var(--flow-radius, 8));
		background: var(--color-bg-surface, #fff);
	}

	.tt__head {
		display: flex;
		align-items: center;
		gap: u(10);
		padding: u(12) u(16);
		background: var(--color-bg-light, #f7f9fc);

		[data-icon] {
			flex: none;
			width: u(20);
			height: u(20);
			color: var(--color-text-secondary, #5b616e);
		}
	}

	.tt__name {
		font-size: u(16);
		font-weight: $font-weight-semibold;
		line-height: u(22);
		white-space: nowrap;
	}

	.tt__attrs {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	// Key left, value right, and — on the first row only — the value's own history beneath them
	// both. Under, not inline: a sparkline squeezed between the key and the value would be a third
	// column fighting for the same line, and it would be about a third as wide.
	.tt__attr {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: baseline;
		gap: 0 u(12);
		padding: u(7) u(16);
		font-size: u(14);
		line-height: u(22);

		& + & {
			border-top: 1px solid var(--sl-color-hairline-light, #ebebeb);
		}
	}

	.tt__attr--series {
		padding-bottom: u(var(--tt-spark-pad-b));
	}

	.tt__k {
		color: var(--color-text-secondary, #5b616e);
	}

	.tt__v {
		justify-self: end;
		font-weight: $font-weight-medium;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		color: var(--color-text);
	}

	// No axis, no ticks, no timeframe: the row above it says what the value is and this says it has
	// a past. Those labels were also three of the four things in the composition set at 12u, so
	// losing them is what lifts the type floor to 14u.
	.tt__spark {
		grid-column: 1 / -1;
		height: u(var(--tt-spark-h));
		margin-top: u(var(--tt-spark-gap));

		svg {
			display: block;
			width: 100%;
			height: 100%;
			overflow: visible;
		}
	}

	.tt__spark-area {
		fill: var(--color-primary, #3d50f5);
		opacity: 0.1;
	}

	.tt__spark-line {
		fill: none;
		stroke: var(--color-primary, #3d50f5);
		stroke-width: max(1px, #{u(2)});
		stroke-linecap: round;
		stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
	}

	// --- the connectors -------------------------------------------------------------

	.tt__flows {
		grid-area: flows;
		position: relative;
		height: u(var(--tt-body-h));
		// Every card in the picture has a 1px top border that the arithmetic above cannot see, so
		// every band sits a pixel or two below where the drawing expects it — and always downwards,
		// never up. Two pixels for the pair the connectors cross most often (the frame's and the
		// card's) brings the worst endpoint from 3.5px high of its row's centre to 1.5px, which is
