---
import SmartImage from '@components/SmartImage.astro';
import { Icon } from 'astro-icon/components';
import ReadMoreLink from './ReadMoreLink.astro';

interface LinkItem {
	href: string;
	text?: string;
	ariaLabel?: string;
	srOnlySuffix?: string;
	target?: string;
}

interface Props {
	heading: string;
	/** Heading level for the feature heading (3 = h3 default, 4 = h4) */
	headingLevel?: 3 | 4;
	description: string;
	/**
	 * The same description with markup in it, when a row needs some of its words to carry meaning
	 * the plain string cannot — the connect row names its four routes in the four colours its visual
	 * codes by, which is what lets that visual drop its legend.
	 *
	 * Ours, not a user's: it comes from a data file in this repo and is rendered with `set:html`.
	 * `description` stays required and stays the plain-text source of truth, so a row that passes
	 * both cannot end up with two different sentences.
	 */
	descriptionHtml?: string;
	links: LinkItem[];
	/**
	 * The media, when it is an image. Optional because a row can be given a COMPONENT instead, by
	 * passing it as the default slot — which is how the new key visuals sit in this row without
	 * being exported to PNG first.
	 */
	imageSrc?: string;
	imageAlt?: string;
	imageWidth?: number;
	imageHeight?: number;
	/** If true, image is placed before the text (image on left) */
	imageFirst?: boolean;
	/** Dark background variant (#262C28) */
	dark?: boolean;
	/** Background element ID (e.g. "background-white-labeling") — renders a real DOM background div */
	bgId?: string;
	/** Child div class names for the background element (e.g. ['main1', 'small1', 'small2', 'small3']) */
	bgDivs?: string[];
	/** Read-more link color variant */
	variant?: 'default' | 'light' | 'pe';
	/** Show "PE only" badge next to heading */
	peOnly?: boolean;
	/** Add shadow and border-radius to the image */
	imageShadow?: boolean;
	/** Use flex: 1 on the image (equal width with text, instead of the default flex: 2) */
	imageEqual?: boolean;
	/** Responsive image widths for srcset generation */
	imageWidths?: number[];
	/** sizes attribute to pair with srcset */
	imageSizes?: string;
	/** Optional decorative side icon (absolute positioned) */
	listIconSrc?: string;
	listIconAlt?: string;
	listIconWidth?: number;
	listIconHeight?: number;
	/** Horizontal offset in px from viewport center (positive = right, negative = left) */
	listIconLeft?: number;
	/** Vertical offset in px from section top */
	listIconTop?: number;
	/**
	 * A squircle mark above the heading: a Tabler icon on a filled tile in the section's own colour.
	 * Optional, so rows that have never had one are unchanged.
	 */
	badge?: { icon: string; color: string };
	id?: string;
}

const {
	heading,
	headingLevel = 3,
	description,
	descriptionHtml,
	links,
	imageSrc,
	imageAlt,
	imageWidth,
	imageHeight,
	imageFirst = false,
	dark = false,
	bgId,
	bgDivs,
	variant = 'default',
	listIconSrc,
	listIconAlt = '',
	listIconWidth,
	listIconHeight,
	listIconLeft = 460,
	listIconTop = 180,
	id,
	peOnly = false,
	imageShadow = false,
	imageEqual = false,
	imageWidths,
	imageSizes,
	badge,
} = Astro.props;

// Rendered to a string rather than placed as <slot />, because the media appears in one of two
// branches depending on `imageFirst` and a slot can only be consumed once. Existing callers pass no
// slot, so `hasMedia` is false for them and nothing about this component changes.
const hasMedia = Astro.slots.has('default');

// A row must have media of one kind or the other. Stated as a guard rather than left to a missing
// <img>, which renders as a stray alt string and is easy to miss on a long page.
if (!hasMedia && !(imageSrc && imageAlt)) {
	throw new Error(
		'FeatureBlockSection needs either an image (imageSrc and imageAlt) or a component in its default slot.'
	);
}

const linkVariant = variant !== 'default' ? variant : dark ? 'light' : 'default';
const hasPseudoBg = dark && !bgId;
const HeadingTag = `h${headingLevel}` as 'h3' | 'h4';
---

<section class:list={['feature-block-section', { dark, 'has-pseudo-bg': hasPseudoBg }]} {id}>
	{
		listIconSrc && (
			<div class="list-icon" style={`--icon-left:${listIconLeft}px;--icon-top:${listIconTop}px;`}>
				<SmartImage src={listIconSrc} alt={listIconAlt} width={listIconWidth} height={listIconHeight} loading="lazy" />
			</div>
		)
	}
	<div class="main-div">
		{
			bgId && (
				<div id={bgId} aria-hidden="true">
					{bgDivs?.map((cls) => (
						<div class={cls} />
					))}
				</div>
			)
		}
		<div class:list={['block', { 'image-first': imageFirst && !hasMedia }]}>
			{
				imageFirst && !hasMedia && (
					<SmartImage
						class:list={['preview', imageShadow && 'shadow', imageEqual && 'equal']}
						src={imageSrc!}
						alt={imageAlt!}
						width={imageWidth}
						height={imageHeight}
						widths={imageWidths}
						sizes={imageSizes}
						style={imageWidth ? `max-width: min(${imageWidth}px, 100%)` : undefined}
						loading="lazy"
					/>
				)
			}
			<div class="feature-des">
				{
					badge && (
						<span class="feature-badge" style={`--badge-color: ${badge.color}`} aria-hidden="true">
							<Icon name={badge.icon} />
						</span>
					)
				}
				<div class="heading-wrap">
					<HeadingTag class="phrase-heading">{heading}</HeadingTag>
					{peOnly && <span class="pe-badge">PE only</span>}
				</div>
				{descriptionHtml ? <p set:html={descriptionHtml} /> : <p>{description}</p>}
				<div class="links">
					{
						links.map((link) => (
							<ReadMoreLink
								href={link.href}
								text={link.text}
								ariaLabel={link.ariaLabel}
								srOnlySuffix={link.srOnlySuffix}
								variant={linkVariant}
								target={link.target}
							/>
						))
					}
				</div>
			</div>
			{
				!imageFirst && !hasMedia && (
					<SmartImage
						class:list={['preview', imageShadow && 'shadow', imageEqual && 'equal']}
						src={imageSrc!}
						alt={imageAlt!}
						width={imageWidth}
						height={imageHeight}
						widths={imageWidths}
						sizes={imageSizes}
						style={imageWidth ? `max-width: min(${imageWidth}px, 100%)` : undefined}
						loading="lazy"
					/>
				)
			}
			{
				/* Rendered once and placed by CSS, because a slot can only be consumed once and this
				    has to serve both orders. */
				hasMedia && (
					<div class:list={['preview', 'has-slot', imageEqual && 'equal', imageFirst && 'media-first']}>
						<slot />
					</div>
				)
			}
		</div>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	.feature-block-section {
		position: relative;
		width: 100%;
		overflow: visible;

		// Full-width dark background (no skew) — only when no bgId DOM div is provided
		&.has-pseudo-bg::before {
			content: '';
			position: absolute;
			inset: 0;
			width: 100vw;
			left: 50%;
			z-index: 0;
			transform: translateX(-50%);
			background-color: #262c28;
		}

		.main-div {
			position: relative;
			z-index: 1;
			max-width: 1200px;
			margin: 0 auto;
			padding: 5rem 1.875rem;

			@media screen and (min-width: 1500px) {
				max-width: 1400px;
				padding: 5rem 6.25rem;
			}

			@media screen and (max-width: 768px) {
				padding: 3rem 1.25rem;
			}
		}

		.block {
			display: flex;
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			gap: 60px;

			.preview {
				flex: 2;
				min-width: 0;
				max-width: 100%;
				height: auto;
			}

			// Slotted media leads the row without leading the markup, so the copy stays first for a
			// screen reader whichever side it is drawn on.
			:global(.preview.media-first) {
				order: -1;
			}

			:global(.preview.equal) {
				flex: 1;
			}

			:global(.preview.shadow) {
				border-radius: 12px;
				box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.12);
			}

			@media screen and (max-width: 768px) {
				flex-direction: column;
				gap: 32px;

				:global(.preview.media-first) {
					order: 0;
				}

				// Slotted media only, and it has to come after the rule above: both selectors score the
				// same, so on a row that is both, source order is what decides.
				//
				// `align-self`: `align-items: center` on this row makes the cross axis — width, once the
				// row stacks — shrink-to-fit, and a slotted component sized `width: 100%` resolves that
				// percentage against a parent that is itself sizing to its content. The two agree on
				// zero, and the visual disappears with no error.
				//
				// `order`: stacked, the diagram leads whichever side it was drawn on. It is what tells
				// you which section you have reached; the heading says the same thing in words a moment
				// later, and a screenful of prose before the picture reads as a wall.
				//
				// An <img> has an intrinsic width and never hits the first of those, and its rows were
				// authored to alternate — so both rules stay scoped to the slot.
				:global(.preview.has-slot) {
					align-self: stretch;
					order: -1;
					// Stretch resolves against max-width, and `.preview` carries `max-width: 100%` — the
					// container's own width. With that in place a page can pull the box out past the
					// gutter with negative margins and it slides rather than widens.
					max-width: none;
				}

				// Image rows only — see the class list. A slotted row leads with its media through
				// `order` above, and reversing the column as well would just put it back at the bottom.
				&.image-first {
					flex-direction: column-reverse;
				}
			}
		}

		// A squircle, at the 28% radius that is the closest a plain border-radius gets to the
		// superellipse an app icon uses — the same construction the platform badge in the connect and
		// deploy visuals uses, so the page has one idea of what a rounded tile is.
		.feature-badge {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 48px;
			height: 48px;
			margin-bottom: 20px;
			border-radius: 32%;
			background: var(--badge-color, #3d50f5);
			color: #fff;

			// The glyph takes about 58% of the tile. A mark on a tile is one object, and a small glyph
			// floating in a large square reads as two — the tile and, separately, something in it.
			:global([data-icon]) {
				width: 28px;
				height: 28px;
			}
		}

		.feature-des {
			flex: 1;

			.heading-wrap {
				display: flex;
				align-items: center;
				gap: 12px;
				flex-wrap: wrap;
				margin-bottom: 1.25rem;
			}

			.pe-badge {
				display: inline-flex;
				align-items: center;
				padding: 4px 8px;
				font-size: 12px;
				font-weight: $font-weight-medium;
				line-height: 20px;
				border-radius: 6px;
				color: $color-white;
				background: #1a7340;
				border: 1px solid $color-pe-link;
				white-space: nowrap;
				flex-shrink: 0;
			}

			.phrase-heading {
				font-size: $font-size-4xl;
				font-weight: $font-weight-semibold;
				color: $color-text-primary;
				margin: 0;
				line-height: 1.3;

				@media screen and (max-width: 768px) {
					font-size: $font-size-3xl;
				}
			}

			p {
				font-size: $font-size-lg;
				line-height: 1.7;
				color: #6b6b72;
				margin: 0;
			}

			.links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem 2rem;
				margin-top: 1rem;
			}
		}

		&.dark .feature-des {
			.phrase-heading {
				color: $color-white;
			}

			p {
				color: #9e9e9e;
			}
		}

		.list-icon {
			position: absolute;
			left: calc(50% + var(--icon-left, 460px));
			top: var(--icon-top, 180px);
			pointer-events: none;
			z-index: 2;

			:global(img) {
				border-radius: $radius-md;
				box-shadow:
					0 50px 50px -20px rgba(0, 0, 0, 0.15),
					0 0 30px 0 rgba(0, 0, 0, 0.1);
			}

			@media screen and (max-width: 1280px) {
				display: none;
			}
		}
	}
</style>
