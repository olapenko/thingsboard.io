---
import { Icon } from 'astro-icon/components';
import { SPARK_WINDOW, type SolutionCase } from '@data/solution-flow';
import { sparkPaths } from '@util/sparkline';

/**
 * The customer's app, as a small window: browser bar with their domain, branded bar with their
 * mark, navigation rail, one live reading and its alarm state.
 *
 * Takes a LIST of cases rather than one set of values. A single case renders a static app; several
 * make it rotate through them, which is the white-labeling argument — the same product becoming
 * somebody else's. That is a property of this component rather than of its caller, so a caller
 * only has to decide which cases apply.
 *
 * `--flow-accent` is declared here, on the shell's own root, which keeps the customer's colour off
 * anything outside it. The app is theirs; the platform that produced it is not. It resolves through
 * `--flow-brand-N` (N = the case's index), an optional override an environment may set to recolour
 * the brands as a set; unset, the case's own accent is used.
 *
 * Every size inside is in design pixels — `u(n)` below — resolved against `--flow-u`, which the
 * flow derives from the width it is given. Dropped anywhere else the unit is 1px and the shell
 * renders at its native size.
 *
 * Nothing here is interactive on purpose. It is a picture of an app, and real controls would be
 * tab stops that do nothing.
 */

interface RailItem {
	icon: string;
	/** The screen currently open. Exactly one item should carry this. */
	active?: boolean;
}

interface Props {
	rail: RailItem[];
	/** One case renders static; more than one rotates through them. */
	cases: SolutionCase[];
	/** Slide the history and step the reading, as a live dashboard would. */
	animate?: boolean;
	/** How long each brand holds before the next one takes over. */
	swapMs?: number;
}

const { rail, cases, animate = false, swapMs = 5200 } = Astro.props;

const VIEW = { w: 100, h: 28, pad: 3 };

// Everything the client needs, resolved once here so the server's first paint and every later
// frame are computed by the same rules. Defaults live in one place rather than being reapplied
// per tick.
const prepared = cases.map((c) => {
	const min = Math.min(...c.series);
	const max = Math.max(...c.series);
	const span = max - min || 1;
	return {
		name: c.brand.name,
		accent: c.brand.accent,
		host: c.brand.host,
		metricLabel: c.metricLabel,
		unit: c.unit ?? '',
		decimals: c.decimals ?? 0,
		series: c.series,
		alarms: c.alarms ?? 0,
		// Falls back to a padded fit only when the metric has no meaningful frame of its own.
		domain: c.domain ?? ([min - span * 0.25, max + span * 0.25] as [number, number]),
	};
});

const first = prepared[0];
const win = Math.min(SPARK_WINDOW, first.series.length);

// The window plus the point about to arrive, which sits just past the right edge and is clipped.
// Drawing it now means the client's first slide continues the curve rather than bending it.
const firstValues = Array.from({ length: win + 1 }, (_, i) => first.series[i % first.series.length]);
const paths = sparkPaths(firstValues, first.domain, VIEW, win);

// The newest point fully inside the box is the reading.
const reading = `${first.series[win - 1].toFixed(first.decimals)}${first.unit}`;
const rotates = prepared.length > 1;
const alarmText = (n: number) => (n > 0 ? `${n} ${n === 1 ? 'alarm' : 'alarms'}` : 'No alarms');
---

<div
	class="shell"
	style={`--flow-accent: var(--flow-brand-0, ${first.accent});`}
	data-shell
	data-animate={animate ? 'true' : undefined}
	data-rotate={rotates ? String(swapMs) : undefined}
	data-view={`${VIEW.w},${VIEW.h},${VIEW.pad}`}
	data-window={win}
>
	{
		/* The cases travel as JSON rather than as a wall of data attributes: they are nested, and one
	    parse is cheaper to read than eight attributes to reassemble. */
	}
	<script is:inline type="application/json" data-shell-cases set:html={JSON.stringify(prepared)} />

	{
		/* Browser chrome, and deliberately the only dark surface in the visual. Its job is the domain:
	    a customer's own address is the fastest way to say the app is theirs. One dot and the address,
	    nothing else — enough to read as a browser without anyone's window dressing. */
	}
	<p class="shell__chrome" aria-hidden="true">
		<i class="shell__chrome-dot"></i>
		<span class="shell__chrome-url shell__swap" data-shell-host>{first.host}</span>
	</p>

	{
		/* The whole bar carries the colour, so the name needs no separate mark beside it to say
	    whose product this is — the glyph beside it stands in for their logo. Every brand's glyph is
	    rendered and one is shown, so a swap toggles a class rather than building an icon on the
	    client. */
	}
	<p class="shell__topbar">
		<span class="shell__mark shell__swap" aria-hidden="true">
			{cases.map((c, i) => <Icon name={c.brand.icon} class={i === 0 ? 'is-active' : undefined} data-shell-mark={i} />)}
		</span>
		<span class="shell__swap" data-shell-name>{first.name}</span>
	</p>

	<div class="shell__lower">
		{
			/* The rail is what reads as an app rather than a chart. Kept neutral apart from the active
		    item, so it does not compete with the branded bar directly above it. */
		}
		<nav class="shell__rail" aria-hidden="true">
			{
				rail.map((item) => (
					<span class:list={['shell__rail-item', item.active && 'is-active']}>
						<Icon name={item.icon} />
					</span>
				))
			}
		</nav>

		<div class="shell__body">
			<p class="shell__metric-label shell__swap" data-shell-metric>{first.metricLabel}</p>
			{
				/* Reading above the sparkline, not beside it: the number is the subject and the line is
			    its history, so full width each reads in that order. */
			}
			<p class="shell__reading shell__swap" data-shell-value>{reading}</p>
			<svg
				class="shell__spark shell__swap"
				viewBox={`0 0 ${VIEW.w} ${VIEW.h}`}
				preserveAspectRatio="none"
				aria-hidden="true"
			>
				<g data-shell-plot>
					<path class="shell__spark-area" d={paths.area} data-shell-area></path>
					<path class="shell__spark-line" d={paths.line} data-shell-line></path>
				</g>
			</svg>

			{
				/* A banner rather than a line of text: alarm state is the one thing in this panel a
			    person scans for, and a full-width strip is what an app actually shows.
			    Both glyphs are rendered and one is hidden, so a swap toggles a class rather than
			    rebuilding an icon on the client. */
			}
			<p class:list={['shell__alarm-banner', 'shell__swap', first.alarms > 0 && 'is-active']} data-shell-alarm>
				<Icon class="shell__alarm-ok" name="tabler:check" aria-hidden="true" />
				<Icon class="shell__alarm-warn" name="tabler:alert-triangle" aria-hidden="true" />
				<span data-shell-alarm-text>{alarmText(first.alarms)}</span>
			</p>
		</div>
	</div>
</div>

<script>
	import { sparkPaths, segmentWidth } from '@util/sparkline';

	/**
	 * Drives every shell on the page: slides the history one point per reading, steps the number
	 * with it, and rotates the brand where more than one case was given.
	 *
	 * One script for all instances — Astro bundles it once however many shells render, so it queries
	 * them all rather than being wired per component.
	 *
	 * Nothing is invented here. Each case ships a precalculated loop of readings; the sparkline shows
	 * a window onto it and the window advances one point per step. The whole line translates left
	 * while the number counts to the incoming value, then the window is redrawn one point on with
	 * the translation reset — the same picture, so nothing jumps. Because the loop was designed, the
	 * curve keeps its character forever; a random walk flattened within a minute.
	 *
	 * Idle between steps. The frame loop runs only for the 700ms a step takes; the rest of the time a
	 * single timer waits for the next due event. Shells off-screen do no work at all.
	 *
	 * A brand swap is a crossfade: the swappable parts fade, the content changes at the midpoint, and
	 * they fade back. The window restarts at the new case's origin, so a temperature is never shown
	 * in a panel labelled as a percentage even for one frame.
	 */
	type Case = {
		name: string;
		accent: string;
		host: string;
		metricLabel: string;
		unit: string;
		decimals: number;
		series: number[];
		alarms: number;
		domain: [number, number];
	};

	type Shell = {
		el: HTMLElement;
		nameEl: HTMLElement;
		hostEl: HTMLElement;
		metricEl: HTMLElement;
		valueEl: HTMLElement;
		alarmEl: HTMLElement;
		alarmTextEl: HTMLElement;
		marks: HTMLElement[];
		plot: SVGGElement;
		line: SVGPathElement;
		area: SVGPathElement;
		cases: Case[];
		view: { w: number; h: number; pad: number };
		window: number;
		rotateMs: number;
		animate: boolean;
		caseIdx: number;
		/** Index into the loop of the first point in the window. */
		head: number;
		/** Set while a step is in flight. */
		tween: { from: number; to: number; started: number } | null;
		swapping: boolean;
		/** The coming swap has been announced. */
		announced: boolean;
		lastStep: number;
		lastSwap: number;
	};

	const STEP_MS = 2200; // how often a new reading arrives
	const TWEEN_MS = 700; // how long the line takes to slide it into place
	const FADE_MS = 180; // each half of a brand crossfade
	// How far ahead of a brand swap the shell says one is coming, so whatever frames it can lead
	// up to the change rather than react to it. The flow uses this to run its pulse.
	const LEAD_MS = 1000;

	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	const current = (s: Shell) => s.cases[s.caseIdx];
	const at = (c: Case, i: number) => c.series[i % c.series.length];
	const alarmText = (n: number) => (n > 0 ? `${n} ${n === 1 ? 'alarm' : 'alarms'}` : 'No alarms');

	/** The window plus the incoming point, drawn at rest. */
	function drawWindow(s: Shell) {
		const c = current(s);
		const values = Array.from({ length: s.window + 1 }, (_, i) => at(c, s.head + i));
		const p = sparkPaths(values, c.domain, s.view, s.window);
		s.line.setAttribute('d', p.line);
		s.area.setAttribute('d', p.area);
		s.plot.removeAttribute('transform');
		s.valueEl.textContent = `${at(c, s.head + s.window - 1).toFixed(c.decimals)}${c.unit}`;
	}

	/** Puts a case on screen from the start of its loop. */
	function applyCase(s: Shell) {
		const c = current(s);
		s.head = 0;
		// Through an optional per-brand override, so an environment can recolour the customers'
		// brands as a set — a token set matching an older palette, say — without touching the data.
		s.el.style.setProperty('--flow-accent', `var(--flow-brand-${s.caseIdx}, ${c.accent})`);
		s.nameEl.textContent = c.name;
		s.hostEl.textContent = c.host;
		s.metricEl.textContent = c.metricLabel;
		s.marks.forEach((m) => m.classList.toggle('is-active', Number(m.dataset.shellMark) === s.caseIdx));
		s.alarmEl.classList.toggle('is-active', c.alarms > 0);
		s.alarmTextEl.textContent = alarmText(c.alarms);
		drawWindow(s);
	}

	/**
	 * Fires `solution-swap-soon` on the shell, bubbling, `LEAD_MS` before the brand changes. Anything
	 * wrapping the shell can listen without the two components knowing each other's internals.
	 */
	function announce(s: Shell) {
		s.announced = true;
		s.el.dispatchEvent(new CustomEvent('solution-swap-soon', { bubbles: true, detail: { in: LEAD_MS } }));
	}

	function beginSwap(s: Shell, now: number) {
		s.swapping = true;
		s.announced = false;
		s.tween = null;
		s.lastSwap = now;
		s.el.classList.add('is-swapping');
		setTimeout(() => {
			s.caseIdx = (s.caseIdx + 1) % s.cases.length;
			applyCase(s);
			s.el.classList.remove('is-swapping');
			s.swapping = false;
			// The first step waits for the fade-in, so the new brand is seen at rest first.
			s.lastStep = performance.now() + FADE_MS;
			wake();
		}, FADE_MS);
	}

	function beginStep(s: Shell, now: number) {
		const c = current(s);
		s.tween = { from: at(c, s.head + s.window - 1), to: at(c, s.head + s.window), started: now };
		s.lastStep = now;
	}

	function progressStep(s: Shell, now: number) {
		const tw = s.tween;
		if (!tw) return;
		const c = current(s);
		const t = Math.min(1, (now - tw.started) / TWEEN_MS);
		if (t >= 1) {
			// Advance and redraw at rest. Identical to the tween's end state, so there is no jump.
			s.head = (s.head + 1) % c.series.length;
			s.tween = null;
			drawWindow(s);
			return;
		}
		// easeOutCubic: quick to move, settles rather than stopping dead.
		const e = 1 - Math.pow(1 - t, 3);
		s.plot.setAttribute('transform', `translate(${(-segmentWidth(s.window, s.view) * e).toFixed(3)} 0)`);
		s.valueEl.textContent = `${(tw.from + (tw.to - tw.from) * e).toFixed(c.decimals)}${c.unit}`;
	}

	function setup(now: number): Shell[] {
		const out: Shell[] = [];
		document.querySelectorAll<HTMLElement>('[data-shell]').forEach((el) => {
			const q = <T extends Element>(sel: string) => el.querySelector<T>(sel);
			const json = q<HTMLElement>('[data-shell-cases]');
			const nameEl = q<HTMLElement>('[data-shell-name]');
			const hostEl = q<HTMLElement>('[data-shell-host]');
			const metricEl = q<HTMLElement>('[data-shell-metric]');
			const valueEl = q<HTMLElement>('[data-shell-value]');
			const alarmEl = q<HTMLElement>('[data-shell-alarm]');
			const alarmTextEl = q<HTMLElement>('[data-shell-alarm-text]');
			const plot = q<SVGGElement>('[data-shell-plot]');
			const line = q<SVGPathElement>('[data-shell-line]');
			const area = q<SVGPathElement>('[data-shell-area]');
			if (!json || !nameEl || !hostEl || !metricEl || !valueEl || !alarmEl || !alarmTextEl || !plot || !line || !area)
				return;

			const rotateMs = Number(el.dataset.rotate ?? 0);
			const animate = el.dataset.animate === 'true';
			if (!rotateMs && !animate) return; // nothing to drive

			let cases: Case[];
			try {
				cases = JSON.parse(json.textContent ?? '[]');
			} catch {
				return;
			}
			if (!cases.length) return;

			const [w, h, pad] = (el.dataset.view ?? '100,28,3').split(',').map(Number);
			out.push({
				el,
				nameEl,
				hostEl,
				metricEl,
				valueEl,
				alarmEl,
				alarmTextEl,
				marks: Array.from(el.querySelectorAll<HTMLElement>('[data-shell-mark]')),
				plot,
				line,
				area,
				cases,
				view: { w, h, pad },
				window: Number(el.dataset.window ?? 32),
				rotateMs,
				animate,
				caseIdx: 0,
				head: 0,
				tween: null,
				swapping: false,
				announced: false,
				lastStep: now,
				lastSwap: now,
			});
		});
		return out;
	}

	const shells = reduce ? [] : setup(performance.now());
	const visible = new Set<HTMLElement>();
	let raf = 0;
	let timer = 0;

	/** Runs a frame if one is not already queued. */
	function wake() {
		if (!raf) raf = requestAnimationFrame(frame);
	}

	/** Sleeps until the earliest due event across the shells on screen. */
	function armTimer(now: number) {
		let due = Infinity;
		shells.forEach((s) => {
			if (!visible.has(s.el) || s.swapping) return;
			if (s.animate) due = Math.min(due, s.lastStep + STEP_MS);
			if (s.rotateMs) due = Math.min(due, s.lastSwap + s.rotateMs - (s.announced ? 0 : LEAD_MS));
		});
		clearTimeout(timer);
		if (due < Infinity) timer = window.setTimeout(wake, Math.max(0, due - now));
	}

	function frame(now: number) {
		raf = 0;
		let busy = false;
		shells.forEach((s) => {
			if (!visible.has(s.el) || s.swapping) return;

			if (s.rotateMs && now - s.lastSwap >= s.rotateMs) {
				beginSwap(s, now);
				return; // a swap is this shell's whole frame
			}
			if (s.rotateMs && !s.announced && now - s.lastSwap >= s.rotateMs - LEAD_MS) announce(s);

			if (!s.animate) return;
			if (!s.tween && now - s.lastStep >= STEP_MS) beginStep(s, now);
			if (s.tween) {
				progressStep(s, now);
				busy = true;
			}
		});

		if (busy) raf = requestAnimationFrame(frame);
		else armTimer(now);
	}

	if (shells.length) {
		// Only shells actually on screen do any work; a page can hold several of these.
		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((e) =>
					e.isIntersecting ? visible.add(e.target as HTMLElement) : visible.delete(e.target as HTMLElement)
				);
				wake();
			},
			{ rootMargin: '80px' }
		);
		shells.forEach((s) => io.observe(s.el));
	}
</script>

<style lang="scss">
	@use '../../styles/variables' as *;

	// One design pixel. The flow sets `--flow-u` from the width it is given; on its own the shell
	// is native size.
	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	.shell {
		--u: var(--flow-u, 1px);
		display: flex;
		overflow: hidden;
		flex-direction: column;
		// A number in design pixels; see the flow's list for why it is not a length.
		border-radius: u(var(--flow-radius, 8));
		// No border: the shadow alone separates the window from the page. An outline plus a lift
		// reads as two different ways of saying the same thing, and the stroke was what made the
		// chrome look drawn rather than rendered.
		//
		// Two layers rather than a token: `--shadow-md` is a tight, dark Material-style stack and
		// `--shadow-lg` is tuned for full-width cards with a 50px offset that would fall clear of a
		// panel this size. A close contact shadow plus a wide, faint ambient one is what reads as an
		// object resting on the page.
		//
		// Both overridable — `--flow-radius` and `--flow-shadow` — so a token set can change the
		// object's feel, not only its colours.
		box-shadow: var(
			--flow-shadow,
			0 1px 2px rgba(16, 24, 40, 0.04),
			0 #{u(12)} #{u(28)} #{u(-8)} rgba(16, 24, 40, 0.12)
		);
	}

	// --- browser bar --------------------------------------------------------

	// The same dark as the CLI terminal's title bar, so the two visuals share one idea of "chrome".
	// Kept low: it is a frame around the app, not a part of it.
	.shell__chrome {
		display: flex;
		align-items: center;
		gap: u(8);
		margin: 0;
		padding: u(5) u(12);
		background: var(--flow-chrome, #1b1e27);
	}

	// One filled dot, dim: a presence, not a control.
	.shell__chrome-dot {
		display: block;
		flex: none;
		width: u(6);
		height: u(6);
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.35);
	}

	// The address as plain text. Mono because an address is a string, and because it ties this bar
	// to the terminal visual beside it.
	.shell__chrome-url {
		min-width: 0;
		font-family: $font-family-mono;
		font-size: u(11);
		line-height: u(14);
		white-space: nowrap;
		color: rgba(255, 255, 255, 0.62);
	}

	// --- brand bar ----------------------------------------------------------

	.shell__topbar {
		display: flex;
		align-items: center;
		gap: u(8);
		margin: 0;
		// 14 on an 18 line with 7 above and below: the bar keeps its 32 height while the name gets
		// the size a product name deserves.
		padding: u(7) u(14);
		font-size: u(14);
		font-weight: $font-weight-semibold;
		line-height: u(18);
		color: var(--color-white, #fff);
		// Eased so a brand swap is a change of colour rather than a cut.
		background: var(--flow-accent);
		transition: background-color 400ms ease;
	}

	// Stands in for the customer's logo. Every brand's glyph is in the DOM; only the active one
	// shows. `display: none` rather than opacity so the hidden ones take no space in the row.
	.shell__mark {
		display: flex;
		flex: none;

		[data-icon] {
			display: none;
			width: u(16);
			height: u(16);
			color: rgba(255, 255, 255, 0.95);
		}

		[data-icon].is-active {
			display: block;
		}
	}

	// --- app body -----------------------------------------------------------

	.shell__lower {
		display: flex;
		flex: 1;
		// White so the branded bar and the rail are what stand out.
		background: var(--color-white, #fff);
	}

	.shell__rail {
		display: flex;
		flex: none;
		flex-direction: column;
		gap: u(4);
		padding: u(8);
		// No divider either: the rail's own fill already separates it from the content area.
		color: var(--color-text-secondary, #5b616e);
		background: var(--color-bg-light, #f7f9fc);
	}

	.shell__rail-item {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: u(4);
		border-radius: u(4);

		[data-icon] {
			width: u(22);
			height: u(22);
		}
	}

	// The brand colour itself on a wash of the same colour, rather than a solid fill with a white
	// glyph. A filled chip read as a button — something to press — when all it marks is which screen
	// is open. This still carries the brand (the accent's third home during a swap) but at the
	// volume a selected nav item deserves.
	//
	// `color-mix` keeps the wash tied to whatever accent is passed in, so it stays correct for every
	// brand instead of needing a second colour per customer.
	.shell__rail-item.is-active {
		color: var(--flow-accent);
		background: color-mix(in srgb, var(--flow-accent) 12%, transparent);
		transition:
			color 400ms ease,
			background-color 400ms ease;
	}

	.shell__body {
		display: flex;
		flex: 1;
		min-width: 0;
		flex-direction: column;
		padding: u(16);
	}

	.shell__metric-label {
		margin: 0;
		font-size: u(14);
		line-height: u(24);
		color: var(--color-text-secondary, #5b616e);
	}

	.shell__reading {
		margin: 0;
		font-size: u(34);
		// The reading is the loudest thing in the panel by size alone: regular weight, so the digits
		// keep their shape and the number reads as data rather than a headline.
		font-weight: $font-weight-normal;
		line-height: $line-height-tight;
		// Equal-width digits, so a stepping value does not jitter the line beside it.
		font-variant-numeric: tabular-nums;
		color: var(--color-text);
	}

	// Clipped left and right only: the incoming point is drawn past the right edge and slides in,
	// while the stroke may still round off above and below the box.
	.shell__spark {
		width: 100%;
		height: u(28);
		margin-top: u(8);
		overflow: visible;
		clip-path: inset(u(-4) 0);
	}

	.shell__spark-area {
		fill: var(--flow-accent);
		opacity: 0.12;
		transition: fill 400ms ease;
	}

	.shell__spark-line {
		fill: none;
		stroke: var(--flow-accent);
