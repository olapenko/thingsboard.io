---
import Navigation from '@components/Landing/Navigation.astro';
import HeaderScrollWatch from '@components/Landing/HeaderScrollWatch.astro';
import SearchButton from '@components/SearchButton.astro';
import SiteSearch from '@components/SiteSearch.astro';
import GitHubButton from '@components/Landing/GitHubButton.astro';
import NButton from '@components/Landing/NButton.astro';
import CloudRegionDialog from '@components/Landing/CloudRegionDialog.astro';
import { Icon } from 'astro-icon/components';
import { Products } from '@models/site.models';
import type { HeaderConfig } from '@util/header-config';

interface Props {
	gitHubPlatform?: Products;
	// Always supplied by the only caller, starlight/Header.astro.
	headerConfig: HeaderConfig;
}

const { gitHubPlatform, headerConfig } = Astro.props;
const { look, hero } = headerConfig;

// The marketing look has two states, top and scrolled; the docs look one. The watch is a few lines
// of inline script, shipped only where a state can change.
const needsScrollState = look === 'marketing';
const currentYear = new Date().getFullYear();
---

<div class="logo-burger" data-header-look={look} data-header-hero={hero}>
	<a href="/" class="logo" aria-label="Link to homepage"></a>
	<span class="header-copyright print:only">&copy; {currentYear} The ThingsBoard Authors</span>
</div>

{/* Before <Navigation> on purpose: its ~125 KiB of markup shifted the centred nav (≈0.012 CLS); `order` restores the visual order. */}
<div class="head-buttons print:hidden" data-header-look={look} data-header-hero={hero}>
	<div class="icon-buttons">
		<SearchButton />
	</div>
	<GitHubButton platform={gitHubPlatform} />
	{/* Both open the `CloudRegionDialog`; the hrefs are the no-script fallback. */}
	<a
		class="region-signin__trigger"
		href="https://thingsboard.cloud/login"
		target="_blank"
		rel="noopener noreferrer"
		data-cloud-auth="signin"
	>
		Sign in
	</a>
	<NButton
		id="Menu_TryItNow"
		href="/installations/choose-region/"
		variant="filled"
		class="try gtm_button"
		data-cloud-auth="signup"
	>
		Try for free
	</NButton>
	<button onclick="Burger()" class="burger" aria-expanded="false">
		<Icon name="tabler:menu-2" class="icon-open" aria-hidden="true" />
		<Icon name="tabler:x" class="icon-close" aria-hidden="true" />
		<span class="burger__label">
			<span class="label-open">Menu</span>
			<span class="label-close">Close</span>
		</span>
	</button>
</div>

<Navigation />

<CloudRegionDialog signupIds={headerConfig.cloudSignupIds} />

{/* The search dialog, once per page; the control above and the keys open it. */}
<SiteSearch />

{needsScrollState && <HeaderScrollWatch />}

<script>
	import { lockScroll, unlockScroll } from '@util/scroll-lock';

	// Burger menu toggle
	function Burger() {
		const header = document.querySelector('header.header');

		if (header?.classList.contains('opened-burger')) {
			header.classList.remove('opened-burger');
			const subMenus = document.querySelectorAll('nav.head-menu > ul > li > div.centered-sub > ul.sub-menu');
			subMenus.forEach((menu) => menu.classList.remove('open-sub'));
			unlockScroll();
		} else {
			header?.classList.add('opened-burger');
			lockScroll();
		}

		// Read back from the class, so the swipe gestures that also toggle the drawer keep it right.
		const open = header?.classList.contains('opened-burger') ?? false;
		header?.querySelector('.burger')?.setAttribute('aria-expanded', String(open));
	}

	// Make function available globally
	(window as any).Burger = Burger;

	// Swipe to open/close mobile menus:
	//   Starlight sidebar — swipe RIGHT from left edge to open, swipe LEFT to close
	//   Burger menu      — swipe LEFT from right edge to open, swipe RIGHT to close
	(function () {
		const OPEN_EDGE = 30; // px from screen edge that starts an open gesture
		const MIN_DIST = 60; // minimum horizontal travel to trigger
		const MAX_ANGLE = 35; // max degrees from horizontal (avoids triggering on scrolls)

		let startX = 0;
		let startY = 0;
		let tracking: 'sidebar' | 'burger' | null = null;

		// Starlight drops the sidebar's `popover` attribute on desktop viewports, where the sidebar
		// is always shown; `togglePopover()` throws on an element without it.
		function isSidebarDrawer() {
			return !!document.getElementById('starlight__sidebar')?.popover;
		}

		function isSidebarOpen() {
			return !!document.getElementById('starlight__sidebar')?.matches(':popover-open');
		}

		function isBurgerOpen() {
			return document.querySelector('header.header')?.classList.contains('opened-burger') ?? false;
		}

		function triggerSidebar() {
			document.getElementById('starlight__sidebar')?.togglePopover();
		}

		function triggerBurger() {
			(window as any).Burger?.();
		}

		document.addEventListener(
			'touchstart',
			(e) => {
				const t = e.touches[0];
				startX = t.clientX;
				startY = t.clientY;

				// A modal dialog owns the page: a drawer toggled under it would fight it for the scroll lock.
				if (document.querySelector('dialog[open]')) tracking = null;
				else if (isSidebarOpen()) tracking = 'sidebar';
				else if (isBurgerOpen()) tracking = 'burger';
				else if (startX <= OPEN_EDGE && isSidebarDrawer()) tracking = 'sidebar';
				else if (startX >= window.innerWidth - OPEN_EDGE) tracking = 'burger';
				else tracking = null;
			},
			{ passive: true }
		);

		document.addEventListener(
			'touchend',
			(e) => {
				const which = tracking;
				tracking = null;
				if (!which) return;

				const t = e.changedTouches[0];
				const dx = t.clientX - startX;
				const dy = t.clientY - startY;

				if (Math.abs(dx) < MIN_DIST) return;

				const angle = Math.abs(Math.atan2(Math.abs(dy), Math.abs(dx)) * (180 / Math.PI));
				if (angle > MAX_ANGLE) return;

				if (which === 'sidebar') {
					if (!isSidebarOpen() && dx > 0)
						triggerSidebar(); // swipe right → open
					else if (isSidebarOpen() && dx < 0) triggerSidebar(); // swipe left → close
				} else {
					if (!isBurgerOpen() && dx < 0)
						triggerBurger(); // swipe left from right edge → open
					else if (isBurgerOpen() && dx > 0) triggerBurger(); // swipe right → close
				}
			},
			{ passive: true }
		);
	})();
</script>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	// Wordmark, the page's icons and Menu; the account pair moves into the drawer.
	@mixin compact-bar {
		&:not(.opened-burger) .head-buttons {
			.region-signin__trigger,
			.n-button {
				display: none;
			}
		}

		// Icon only: a square reads the same in both states, so nothing shifts.
		.burger {
			width: 40px;
			padding: 0;

			// Still the button's accessible name, so hidden visually rather than with `display: none`.
			.burger__label {
				@include visually-hidden;
			}
		}

		&.opened-burger {
			.head-buttons {
				position: static;
				order: 0;
				height: auto;
				// 20px on the header's gutter lines this row up with the nav below.
				padding: 10px 0 2px 20px;
				// Hidden in the closed bar, so it arrives rather than travels.
				transform: none;
				transition: none;
			}

			.head-menu {
				order: 1;
			}

			// The bar's row holds still; the icons clear Close's 40px square plus the gap.
			.burger,
			.icon-buttons {
				position: absolute;
				top: calc((#{$header-height} - 40px) / 2);
				z-index: 1;
			}

			.burger {
				right: var(--tb-bar-right);
			}

			.icon-buttons {
				right: calc(var(--tb-bar-right) + 48px);
				height: 40px;
			}
		}
	}

	header.header {
		// The gutter the hero's text column uses, so the wordmark lines up with the headline.
		--tb-bar-inset: #{$bar-inset};
		// For absolute children: their padding box sees neither gutter nor scroll-lock.
		--tb-bar-right: calc(var(--tb-bar-inset) + var(--tb-scrollbar-comp, 0px));
		position: fixed;
		// Sits below the promo banner; tracks the live offset so it slides to
		// top:0 as the banner collapses on scroll (--promo-cur → 0).
		top: var(--promo-cur, var(--promo-h, 0px));
		left: 0;
		// No `filter`: it would become the containing block for the fixed promo banner.
		transition:
			background-color 0.3s ease,
			box-shadow 0.3s ease;
		width: 100%;
		height: $header-height;
		z-index: 8888;
		// Reset Starlight's default border (variants opt back in); else it shows
		// through the transparent header.
		border-bottom: none;
		// Page-independent; else the header inherits Starlight's body line-height
		// (1.75 docs / 1.5 marketing) and its text renders taller on docs.
		line-height: $line-height-base;
		background-color: var(--sl-color-bg-sidebar);
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 20px;

		.logo-burger {
			position: relative;
			display: flex;
			height: 100%;
			align-items: center;
			gap: 0.875rem;
			padding-left: calc(var(--tb-bar-inset) - 20px);
		}

		.head-buttons {
			// head-buttons is placed before <Navigation /> in DOM order to avoid
			// the centred-nav layout shift on slow CPUs. `order: 1` keeps it
			// visually after the nav (which keeps the default order: 0).
			order: 1;
			padding-right: calc(var(--tb-bar-inset) - 20px);
			display: flex;
			flex-direction: row;
			align-items: center;
			gap: 8px;

			.icon-buttons {
				display: flex;
				align-items: center;
			}

			.n-button {
				min-width: 90px;
				// Match the 40px sign-in control beside it; the `md` ramp is 47px.
				height: 40px;
				min-height: 40px;
				padding: 0 18px;
				font-size: 14px;
				display: flex;
				align-items: center;
				justify-content: center;

				@media screen and (min-width: 1500px) {
					min-width: 110px;
				}

				// One fill everywhere; hover darkens via NButton's filled overlay.
				&.try {
					background-color: var(--color-brand);
					color: var(--color-brand-contrast);
					font-weight: $font-weight-bold;

					&:hover {
						color: var(--color-brand-contrast);
					}
				}
			}
		}

		.region-signin__trigger {
			display: inline-flex;
			align-items: center;
			height: 40px;
			padding: 0 16px;
			border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
			border-radius: 4px;
			color: inherit;
			font-size: 14px;
			line-height: 1;
			white-space: nowrap;
			text-decoration: none;
			transition:
				background-color 0.15s ease,
				border-color 0.15s ease;

			&:hover,
			&:focus-visible {
				background-color: color-mix(in srgb, currentColor 12%, transparent);
				border-color: color-mix(in srgb, currentColor 55%, transparent);
			}
		}

		.logo {
			position: relative;
			display: block;
			// The redesign's wordmark sizes. The art is 168x44 and `contain` keeps its ratio inside the
			// box, so the width drives the rendered size until the 50px height caps it (at 191 wide):
			// 215 where the bar has room, 160 across the laptop band where the nav, the cluster and the
			// star count all compete for it, and a phone step under that.
			width: 175px;
			height: 50px;
			// The SVG has a left margin; this puts the glyph, not the box, on the inset.
			transform: translateX(-3.571%);
			background-image: url(../../assets/images/landings/thingsboard-logo.svg);
			background-size: contain;
			background-position: center center;
			background-repeat: no-repeat;

			[data-theme='dark'] & {
				filter: invert(100%) sepia(68%) saturate(0%) hue-rotate(350deg) brightness(113%) contrast(101%);
			}

			@media screen and (min-width: 1025px) {
				width: 215px;
			}

			@media screen and (min-width: 1281px) and (max-width: 1599px) {
				width: 160px;
			}

			@media screen and (max-width: 767px) {
				width: 168px;
				height: 48px;
			}

			@media screen and (max-width: 480px) {
				width: 152px;
				height: 44px;
			}
		}
	}

	// Same pill as the sign-in control beside it, so the cluster reads as one row.
	.burger {
		display: none;
		align-items: center;
		justify-content: center;
		gap: 8px;
		height: 40px;
		padding: 0 14px;
		border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
		border-radius: 4px;
		background: none;
		color: inherit;
		font: inherit;
		font-size: 14px;
		line-height: 1;
		white-space: nowrap;
		cursor: pointer;
		transition:
			background-color 0.15s ease,
			border-color 0.15s ease;

		&:hover,
		&:focus-visible {
			background-color: color-mix(in srgb, currentColor 12%, transparent);
			border-color: color-mix(in srgb, currentColor 55%, transparent);
		}

		svg {
			width: 20px;
			height: 20px;
		}

		.icon-close {
			display: none;
		}

		// One shared cell, so the box is as wide as the longer word in either state.
		.burger__label {
			display: grid;

			> * {
				grid-area: 1 / 1;
			}
		}

		.label-close {
			visibility: hidden;
		}
	}

	.opened-burger .burger {
		.icon-open {
			display: none;
		}

		.icon-close {
			display: block;
		}

		.label-open {
			visibility: hidden;
		}

		.label-close {
			visibility: visible;
		}
	}

	// Responsive styles
	@media screen and (max-width: 1280px) {
		header.header {
			display: block; // stays position:fixed (base rule); block keeps it a proper box — `unset` would resolve to inline and break it
			height: unset !important;
			transition-property: height; // `top` follows --promo-cur; don't transition it here

			.logo-burger {
				height: $header-height;
			}

			&.opened-burger {
				// Anchor the drawer where the bar already sits (top stays at --promo-cur,
				// below the banner) and fill to the viewport bottom, so opening at the top
				// shifts nothing. The banner stays visible above the drawer (when scrolled
				// it has already collapsed off-screen, so the drawer reaches top:0).
				bottom: 0;
				z-index: 10000;
				display: flex !important;
				flex-direction: column;
				align-items: stretch;

				.logo-burger {
					box-shadow: 0 1px 0 rgba(48, 86, 128, 0.07);
					flex-shrink: 0;
				}

				.head-buttons {
					display: flex;
					flex-shrink: 0;
					padding: 20px 0;
				}

				// Slide + fade the drawer content in on open. The bar (.logo-burger)
				// stays put and top/height are pinned, so the menu glides down into
				// place with no banner-height jump. Enter only; closing is instant.
				.head-menu,
				.head-buttons {
					opacity: 1;
					transform: translateY(0);
					transition:
						opacity 0.22s ease,
						transform 0.22s ease,
						display 0.22s allow-discrete;

					@starting-style {
						opacity: 0;
						transform: translateY(-8px);
					}
				}

				@media (prefers-reduced-motion: reduce) {
					.head-menu,
					.head-buttons {
						transition: none;
						transform: none;
					}
				}
			}

			.burger {
				display: flex;
			}

			&:not(.opened-burger) {
				display: flex;
				align-items: center;

				// Scoped away from the open state, a column where this would grow downward.
				.logo-burger {
					flex: 1;
				}
			}

			// The nav list flows down the drawer; the cluster stays pinned over the bar.
			&.opened-burger .head-buttons {
				position: absolute;
				top: 0;
				// Not `right: 0`: the padding box ignores the header's own 20px gutter.
				right: var(--tb-bar-right);
				z-index: 1;
				height: $header-height;
				padding: 0;
				transform: none;
				transition: none;
			}
		}
	}

	// The floor of the full bar, every look carrying the search icon now: the 168 wordmark, the
	// 40 icon, Sign in (78), Try for free (110) and Menu (94), two 24px insets and four 8px gaps come
	// to 586. Under 600 the account pair steps into the drawer.
	@media screen and (max-width: 599px) {
		header.header {
			@include compact-bar;
		}
	}

	// The star count joins the open drawer's cluster at every width: the closed bar hides it where
	// the room runs out, but the open drawer has the room, and the account cluster is where a reader
	// looks for the repo.
	header.header.opened-burger .head-buttons .gh-wrap {
		display: block;
	}

	// ============================================
	// THE TWO LOOKS AND THEIR STATES
	// ============================================

	// Docs: the sidebar ground with a hairline, and one state.
	header.header:has([data-header-look='docs']) {
		border-bottom: 1px solid var(--sl-color-hairline-shade);
	}

	// Marketing: the surface with a hairline at the top of the page; scrolled, the shadow takes the
	// hairline's place and the bar lifts off the page it now covers.
	header.header:has([data-header-look='marketing']) {
		background-color: var(--color-bg-surface);
		border-bottom: 1px solid var(--color-border);

		&[data-header-scrolled] {
			border-bottom-color: transparent;
			box-shadow: var(--shadow-header);
		}
	}

	// Over a hero, the bar starts transparent: neither surface nor line nor shadow, until it is
	// scrolled past or the drawer opens, both of which want a surface of their own.
	header.header:not(.opened-burger):not([data-header-scrolled]):has([data-header-hero]) {
		background-color: transparent;
		border-bottom-color: transparent;
		box-shadow: none;
	}

	// A dark hero takes white ink. Every control draws itself in `currentColor`, so naming the colour
	// once is the whole of it; the wordmark is an image and inverts.
	header.header:not(.opened-burger):not([data-header-scrolled]):has([data-header-hero='dark']) {
		.logo {
			filter: invert(100%) sepia(68%) saturate(0%) hue-rotate(350deg) brightness(113%) contrast(101%);
		}

		.region-signin__trigger,
		.burger,
		.gh-button,
		.search-toggle-btn {
			color: $color-white;
		}
	}

	// A hero page's call to action keeps the wider cell at every width.
	header.header:has([data-header-hero]) .n-button {
		min-width: 110px;
	}

	// The bar over a hero takes no clearance, BUT the promo banner's band is still reserved, so the
	// hero starts below the banner and the bar floats over the hero as before.
	.page:has(header.header [data-header-hero]) .main-frame {
		padding-top: var(--promo-h, 0px);
	}

	// Mobile burger drawer — identical on every page. `--color-bg-light` is the
	// brightest surface per theme, so it sits above the page bg in dark too.
	header.header.opened-burger {
		// Don't reposition on open — the bar stays put (the mobile block fills the
		// drawer downward from there), so there is no jump at the banner position.
		// Only bg + shadow ease.
		transition:
			background-color $transition-base,
			box-shadow $transition-base;
		background-color: var(--color-bg-light);
		box-shadow: var(--shadow-header);

		.head-menu ul {
			a,
			a:not([href]),
			span.main-menu-link {
				color: var(--color-text);
			}

			// Highlight the expanded section (`.open-sub`, toggled in listburg).
			li:has(.open-sub) > a,
			li:has(.open-sub) > span.main-menu-link {
				color: var(--color-primary);
			}

			// Hover highlight for pointer devices only — touch `:hover` sticks
			// after a tap, so touch relies on `.open-sub` above instead.
			@media (hover: hover) {
				li:hover > a,
				li:hover > span.main-menu-link {
					color: var(--color-primary);
				}
			}
		}
	}

	// Starlight mobile sidebar: 90% width, toggle button left when closed / right edge when open
	@media (max-width: 50rem) {
		#starlight__sidebar {
			width: 90%;
		}

		.sl-menu-button {
			inset-inline-end: auto;
			inset-inline-start: var(--sl-nav-pad-x);
			// Just below the header bottom (= --promo-cur + header height); tracks the banner up as it hides.
			top: calc(var(--promo-cur, var(--promo-h, 0px)) + var(--header-height) + 0.75rem);
		}

		.sl-menu-button:has(~ :popover-open) {
			inset-inline-start: 90%;
		}

		// On pages with a TOC, the sidebar toggle is embedded inside the TOC bar
		html[data-has-toc] .sl-menu-button {
			display: none;
		}
		// But when the sidebar is open it covers the TOC bar, so restore the close button
		html[data-has-toc] .sl-menu-button:has(~ :popover-open) {
			display: flex;
		}
	}

	// Dark-mode dropdown tinting. `!important` beats Navigation's per-brand rules
	// (light keeps its brand colours; only dark flattens to primary). Force-light
	// pages are locked to light, so they never match — no exclusion needed.
	html[data-theme='dark'] header.header {
		.head-menu .sub-menu .group-name {
			color: var(--color-primary) !important;
		}

		.head-menu .sub-menu a:hover .sub-text span.item-heading {
			color: var(--color-primary) !important;
		}

		// Top-level link hover — pointer devices only (touch `:hover` sticks).
		@media (hover: hover) {
			.head-menu ul li:hover a,
			.head-menu ul li:hover span.main-menu-link,
			.head-menu ul li a:not([href]):hover,
			.head-menu ul li span.main-menu-link:hover {
				color: var(--color-primary) !important;
			}
		}

		// Active-tab indicator (the underline + arrow under the hovered top item)
		.head-menu .indicator .head-arrow {
			border-bottom-color: var(--color-primary) !important;
		}
		.head-menu .indicator .line {
			background-color: var(--color-primary) !important;
		}
	}

	// Print: `position: fixed` above makes Chrome stamp this bar onto every sheet.
	// `static` returns it to the flow, where it lands once as a masthead.
	@media print {
		header.header {
			position: static;
			display: block;
			height: auto;
			padding: 0 0 0.6rem;
			margin: 0 0 1.5rem;

			&,
			&:has([data-header-look]),
			&[data-header-scrolled]:has([data-header-look]),
			&:has([data-header-look]):hover {
				border-bottom: 1px solid #d7d9e0;
				background: none;
				box-shadow: none;
			}

			.logo-burger {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: 0.25rem 1rem;
				height: auto;
				padding-left: 0;
			}

			.header-copyright {
				font-size: 0.8rem;
				color: #4a4d55;
			}

			// The wordmark is the `background-image` above, and Chrome skips
			// backgrounds unless the reader ticks "Background graphics". `content`
			// makes it a replaced element, which prints either way.
			.logo {
