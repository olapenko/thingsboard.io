---
import Navigation from '@components/Landing/Navigation.astro';
import HeaderScrollWatch from '@components/Landing/HeaderScrollWatch.astro';
import HeaderIcons from '@components/Landing/HeaderIcons.astro';
import GitHubButton from '@components/Landing/GitHubButton.astro';
import NButton from '@components/Landing/NButton.astro';
import SmartImage from '@components/SmartImage.astro';
import { Icon } from 'astro-icon/components';
import { Products } from '@models/site.models';
import type { HeaderConfig } from '@util/header-config';

interface Props {
	gitHubPlatform?: Products;
	// Always supplied by the only caller, starlight/Header.astro.
	headerConfig: HeaderConfig;
	/** Homepage facelift: larger logo, Pricing moved into the nav. */
	homeNav?: boolean;
}

const { gitHubPlatform, headerConfig, homeNav = false } = Astro.props;
const { variant, cta, showSearch, showThemeToggle } = headerConfig;

// Ship the scroll-flip script only on the variants that go transparent.
const needsScrollState = variant === 'transparent' || variant === 'transparent-hover';
---

<div class="logo-burger" data-header-variant={variant} data-header-cta={cta} data-home-nav={homeNav ? '' : undefined}>
	{
		/* Homepage carries the u24 link as a kicker above the hero H1 instead. */
		!homeNav && (
			<a href="https://u24.gov.ua/" target="_blank" class="support-ukraine">
				<SmartImage
					src="/src/assets/images/support-ukraine-banner.webp"
					alt="Stand with Ukraine flag"
					width="48"
					height="31"
				/>
			</a>
		)
	}
	<a href="/" class:list={['logo', homeNav && 'logo--lg']} aria-label="Link to homepage"></a>
	<div class="burger-group">
		<HeaderIcons showSearch={showSearch} showThemeToggle={showThemeToggle} />
		<button onclick="Burger()" class="burger" aria-expanded="false">
			<Icon name="tabler:menu-2" class="icon-open" aria-hidden="true" />
			<Icon name="tabler:x" class="icon-close" aria-hidden="true" />
			<span class="label-open">Menu</span>
			<span class="label-close">Close</span>
		</button>
	</div>
	{!homeNav && <GitHubButton platform={gitHubPlatform} />}
</div>

<!-- head-buttons is rendered BEFORE Navigation in the source so it parses
     and paints quickly. <Navigation> ships ~125 KiB of inline submenu
     markup; with that between <nav> and the right-side buttons, slow CPUs
     paint the centred nav before head-buttons exists, which made flexbox
     `space-between` pin the nav to the right edge and shift it left once
     head-buttons finally arrived (≈0.012 CLS). Visual order is restored
     with `order` in the header layout below. -->
<div class="head-buttons" data-header-variant={variant} data-header-cta={cta} data-home-nav={homeNav ? '' : undefined}>
	<HeaderIcons showSearch={showSearch} showThemeToggle={showThemeToggle} />
	{homeNav && <GitHubButton platform={gitHubPlatform} />}
	{
		!homeNav && (
			<NButton id="Menu_Pricing" href="/pricing/" variant="text" class="price gtm_button">
				Pricing
			</NButton>
		)
	}
	{
		/* Cloud has two regions and no single sign-in host, so the button asks
		   before it sends you somewhere you can't sign in. */
		homeNav && (
			<details class="region-signin">
				<summary aria-haspopup="menu">Sign in</summary>
				<div class="region-signin__menu" role="menu">
					<span class="region-signin__label">Choose your region</span>
					<a href="https://thingsboard.cloud" role="menuitem" target="_blank" rel="noopener noreferrer">
						<span class="region-badge region-badge--us" aria-hidden="true">
							US
						</span>
						United States
					</a>
					<a href="https://eu.thingsboard.cloud" role="menuitem" target="_blank" rel="noopener noreferrer">
						<span class="region-badge region-badge--eu" aria-hidden="true">
							EU
						</span>
						Europe
					</a>
				</div>
			</details>
		)
	}
	<NButton id="Menu_TryItNow" href="/installations/" variant="filled" class="try gtm_button">
		{homeNav ? 'Try for free' : 'Try it now'}
	</NButton>
</div>

<Navigation homeNav={homeNav} />

{needsScrollState && <HeaderScrollWatch />}

<script>
	import { lockScroll, unlockScroll } from '@util/scroll-lock';

	// <details> stays open on outside click and ignores Escape, so wire both.
	document.addEventListener('click', (e) => {
		const open = document.querySelector<HTMLDetailsElement>('.region-signin[open]');
		if (open && !open.contains(e.target as Node)) open.removeAttribute('open');
	});
	document.addEventListener('keydown', (e) => {
		if (e.key !== 'Escape') return;
		const open = document.querySelector<HTMLDetailsElement>('.region-signin[open]');
		if (open) {
			open.removeAttribute('open');
			open.querySelector('summary')?.focus();
		}
	});

	// Burger menu toggle
	function Burger() {
		const header = document.querySelector('header.header');

		if (header?.classList.contains('opened-burger')) {
			header.classList.remove('opened-burger');
			const subMenus = document.querySelectorAll('nav.head-menu > ul > li > div.centered-sub > ul.sub-menu');
			subMenus.forEach((menu) => menu.classList.remove('open-sub'));
			unlockScroll();
		} else {
			header?.classList.add('opened-burger');
			lockScroll();
		}

		// Keep the button's state in the accessibility tree, not just in a class.
		document
			.querySelector('.burger')
			?.setAttribute('aria-expanded', String(header?.classList.contains('opened-burger') ?? false));
	}

	// Make function available globally
	(window as any).Burger = Burger;

	// Swipe to open/close mobile menus:
	//   Starlight sidebar — swipe RIGHT from left edge to open, swipe LEFT to close
	//   Burger menu      — swipe LEFT from right edge to open, swipe RIGHT to close
	(function () {
		const OPEN_EDGE = 30; // px from screen edge that starts an open gesture
		const MIN_DIST = 60; // minimum horizontal travel to trigger
		const MAX_ANGLE = 35; // max degrees from horizontal (avoids triggering on scrolls)

		let startX = 0;
		let startY = 0;
		let tracking: 'sidebar' | 'burger' | null = null;

		function isSidebarOpen() {
			return document.body.hasAttribute('data-mobile-menu-expanded');
		}

		function isBurgerOpen() {
			return document.querySelector('header.header')?.classList.contains('opened-burger') ?? false;
		}

		function triggerSidebar() {
			(document.querySelector('starlight-menu-button button') as HTMLElement)?.click();
		}

		function triggerBurger() {
			(window as any).Burger?.();
		}

		document.addEventListener(
			'touchstart',
			(e) => {
				const t = e.touches[0];
				startX = t.clientX;
				startY = t.clientY;

				if (isSidebarOpen()) tracking = 'sidebar';
				else if (isBurgerOpen()) tracking = 'burger';
				else if (startX <= OPEN_EDGE) tracking = 'sidebar';
				else if (startX >= window.innerWidth - OPEN_EDGE) tracking = 'burger';
				else tracking = null;
			},
			{ passive: true }
		);

		document.addEventListener(
			'touchend',
			(e) => {
				const which = tracking;
				tracking = null;
				if (!which) return;

				const t = e.changedTouches[0];
				const dx = t.clientX - startX;
				const dy = t.clientY - startY;

				if (Math.abs(dx) < MIN_DIST) return;

				const angle = Math.abs(Math.atan2(Math.abs(dy), Math.abs(dx)) * (180 / Math.PI));
				if (angle > MAX_ANGLE) return;

				if (which === 'sidebar') {
					if (!isSidebarOpen() && dx > 0)
						triggerSidebar(); // swipe right → open
					else if (isSidebarOpen() && dx < 0) triggerSidebar(); // swipe left → close
				} else {
					if (!isBurgerOpen() && dx < 0)
						triggerBurger(); // swipe left from right edge → open
					else if (isBurgerOpen() && dx > 0) triggerBurger(); // swipe right → close
				}
			},
			{ passive: true }
		);
	})();
</script>

<style lang="scss" is:global>
	@use '../../styles/variables' as *;

	// Bordered Pricing button — used on marketing and scrolled-transparent headers,
	// where the rest-state white Pricing text would vanish on the solid surface.
	@mixin marketing-price {
		&.price {
			border: 1px solid var(--color-border);
			color: var(--color-text);
			background-color: transparent;

			&:hover {
				border: 2px solid var(--color-text);
			}
		}
	}

	header.header {
		position: fixed;
		// Sits below the promo banner; tracks the live offset so it slides to
		// top:0 as the banner collapses on scroll (--promo-cur → 0).
		top: var(--promo-cur, var(--promo-h, 0px));
		left: 0;
		// No `filter` here: the header itself never gets one (only .logo/.burger
		// do), and a filter would make it the containing block for the fixed promo
		// banner inside it, breaking the banner's viewport anchoring on docs.
		// Transition is scoped to the flip properties only — a blanket `all` would
		// also ease `top`, making the header lag behind the scroll-tied offset.
		transition:
			background-color 0.1s ease,
			box-shadow 0.1s ease;
		width: 100%;
		height: $header-height;
		z-index: 8888;
		// Reset Starlight's default border (variants opt back in); else it shows
		// through the transparent header.
		border-bottom: none;
		// Page-independent; else the header inherits Starlight's body line-height
		// (1.75 docs / 1.5 marketing) and its text renders taller on docs.
		line-height: $line-height-base;
		background-color: var(--sl-color-bg-sidebar);
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 20px;

		.logo-burger {
			position: relative;
			display: flex;
			height: 100%;
			align-items: center;
			gap: 0.875rem;

			// Homepage facelift: the logo leads and its left edge lines up with the
			// hero H1. The hero column's own inset is the same clamp(); the header
			// already carries 20px, so we only make up the difference. The flag
			// follows the logo rather than preceding it.
			// The logo is first in the row on the homepage anyway — the flag has
			// moved to the hero — so this only handles the alignment.
			&[data-home-nav] {
				padding-left: calc(clamp(24px, calc(0.5rem + 2vw), 56px) - 20px);
			}
		}

		// Secondary in the menu. Border follows the label colour so it survives the
		// header's flip from transparent to solid without a second rule.
		.region-signin {
			position: relative;

			summary {
				display: inline-flex;
				align-items: center;
				height: 40px;
				padding: 0 16px;
				border: 1px solid rgba(255, 255, 255, 0.35);
				border-color: color-mix(in srgb, currentColor 35%, transparent);
				border-radius: 4px;
				font-size: 14px;
				cursor: pointer;
				list-style: none;
				white-space: nowrap;
				transition:
					background-color 0.15s ease,
					border-color 0.15s ease;

				&::-webkit-details-marker {
					display: none;
				}

				&:hover,
				&:focus-visible {
					background-color: color-mix(in srgb, currentColor 12%, transparent);
					border-color: color-mix(in srgb, currentColor 55%, transparent);
				}
			}

			&[open] summary {
				background-color: color-mix(in srgb, currentColor 12%, transparent);
			}

			&__menu {
				position: absolute;
				top: calc(100% + 8px);
				right: 0;
				z-index: 40;
				display: flex;
				flex-direction: column;
				min-width: 180px;
				padding: 6px;
				border-radius: 6px;
				background-color: var(--color-bg-surface, #fff);
				border: 1px solid var(--sl-color-hairline-light);
				box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);

				a {
					padding: 8px 10px;
					border-radius: 4px;
					font-size: 14px;
					color: var(--sl-color-text, #24292f);
					text-decoration: none;

					&:hover,
					&:focus-visible {
						background-color: rgba(61, 80, 245, 0.08);
					}
				}
			}

			&__label {
				padding: 4px 10px 6px;
				font-size: 12px;
				opacity: 0.6;
			}
		}

		.head-buttons {
			// head-buttons is placed before <Navigation /> in DOM order to avoid
			// the centred-nav layout shift on slow CPUs. `order: 1` keeps it
			// visually after the nav (which keeps the default order: 0).
			order: 1;

			// Mirrors the logo side so the menu sits on the hero's own margins
			// rather than the header's default 20px.
			&[data-home-nav] {
				padding-right: calc(clamp(24px, calc(0.5rem + 2vw), 56px) - 20px);
			}
			display: flex;
			flex-direction: row;
			align-items: center;
			gap: 0.875rem;

			.icon-buttons {
				display: flex;
				align-items: center;
			}

			.divider {
				width: 1px;
				height: 32px;
				background-color: var(--sl-color-hairline-light);
				flex-shrink: 0;

				@media screen and (min-width: 1281px) and (max-width: 1499px) {
					display: none;
				}
			}

			.n-button {
				width: 90px;
				padding: 0;
				display: flex;
				align-items: center;
				justify-content: center;

				@media screen and (min-width: 1500px) {
					width: 110px;
				}

				&.price {
					color: var(--sl-color-white);
					border: 1px solid transparent;
				}

				// Brand-indigo "Try it now" — one fill everywhere; hover darkens via
				// NButton's filled overlay, like the pricing "Get started" buttons.
				&.try {
					background-color: var(--color-brand);
					color: var(--color-brand-contrast);

					&:hover {
						color: var(--color-brand-contrast);
					}
				}
			}
		}

		.support-ukraine {
			display: flex;
			align-items: center;
			img {
				height: 31px;
				width: auto;
			}

			// Laptop widths — shrink the flag so the nav row doesn't wrap.
			@media screen and (min-width: 1281px) and (max-width: 1599px) {
				img {
					height: 20px;
				}
			}
		}

		.logo {
			position: relative;
			display: block;
			width: 140px;
			height: 60px;
			background-image: url(../../assets/images/landings/thingsboard-logo.svg);
			background-size: contain;
			background-position: center center;
			background-repeat: no-repeat;

			[data-theme='dark'] & {
				filter: invert(100%) sepia(68%) saturate(0%) hue-rotate(350deg) brightness(113%) contrast(101%);
			}

			@media screen and (min-width: 1025px) {
				width: 180px;
			}

			// Laptop widths — smaller logo to keep the nav row from wrapping.
			@media screen and (min-width: 1281px) and (max-width: 1599px) {
				width: 120px;
			}

			// Homepage facelift. The art is 168x44, so inside the 60px-tall box
			// width drives the rendered size until ~229px, where height takes over.
			&.logo--lg {
				// The SVG pads its own art: the ink sits at x=6 in a 168-wide viewBox,
				// so the box's left edge leads the mark by 3.571% of the rendered
				// width, which read as the logo drifting right of the hero lede below.
				// Nudge it back by exactly that fraction so the ink, not the bounding
				// box, lands on the hero's inset.
				//
				// translateX resolves its percentage against this element's own
				// rendered width, so it stays right at every breakpoint AND under the
				// flex shrink the logo takes in a tight header. A negative margin could
				// not manage the second: it would be keyed to the declared width while
				// the box renders narrower, and it would itself hand the flex line more
				// free space and change how far the logo shrinks.
				transform: translateX(-3.571%);
				width: 180px;

				@media screen and (min-width: 1025px) {
					width: 225px;
				}

				@media screen and (min-width: 1281px) and (max-width: 1599px) {
					width: 156px;
				}
			}

			// Small phones — shrink so the wordmark doesn't collide with the icons.
			@media screen and (max-width: 480px) {
				width: 110px;
			}
		}
	}

	.burger-group {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		right: 0;
		display: none;
		align-items: center;
		gap: 0.875rem;

		.icon-buttons {
			display: flex;
			align-items: center;
		}

		.divider {
			width: 1px;
			height: 32px;
			background-color: var(--sl-color-hairline-light);
			flex-shrink: 0;
		}
	}

	// Labelled Menu button rather than a bare hamburger: the glyph alone carries
	// no name for anyone who hasn't learnt it, and it read as decoration next to
	// the wordmark. Border follows the label colour so it survives the header's
	// flip from transparent to solid, the same trick .region-signin uses.
	.burger {
		display: none;
		border: 1px solid;
		border-color: color-mix(in srgb, currentColor 35%, transparent);
		border-radius: 4px;
		background: none;
		padding: 0 14px;
		cursor: pointer;
		color: inherit;
		height: 40px;
		gap: 8px;
		align-items: center;
		justify-content: center;
		font-family: inherit;
		font-size: 14px;
		line-height: 1;
		white-space: nowrap;
		transition:
			background-color 0.15s ease,
			border-color 0.15s ease;

		svg {
			width: 20px;
			height: 20px;
		}

		.icon-close {
			display: none;
		}

		.label-close {
			display: none;
		}

		&:hover,
		&:focus-visible {
			background-color: color-mix(in srgb, currentColor 12%, transparent);
			border-color: color-mix(in srgb, currentColor 55%, transparent);
		}

		// The old rule killed the focus ring outright, leaving keyboard users with
		// nothing on the one control that opens the whole menu.
		&:focus-visible {
			outline: 2px solid currentColor;
			outline-offset: 3px;
		}
	}

	.opened-burger .burger {
		.icon-open {
			display: none;
		}

		.icon-close {
			display: block;
		}

		.label-open {
			display: none;
		}

		.label-close {
			display: inline;
		}
	}

	// Responsive styles
	@media screen and (max-width: 1280px) {
		header.header {
			display: block; // stays position:fixed (base rule); block keeps it a proper box — `unset` would resolve to inline and break it
			height: unset !important;
			transition-property: height; // `top` follows --promo-cur; don't transition it here

			.logo-burger {
				height: var(--home-header-h, #{$header-height});
			}

			&.opened-burger {
				// Anchor the drawer where the bar already sits (top stays at --promo-cur,
				// below the banner) and fill to the viewport bottom, so opening at the top
				// shifts nothing. The banner stays visible above the drawer (when scrolled
				// it has already collapsed off-screen, so the drawer reaches top:0).
				bottom: 0;
				z-index: 10000;
				display: flex !important;
				flex-direction: column;
				align-items: stretch;

				.logo-burger {
					box-shadow: 0 1px 0 rgba(48, 86, 128, 0.07);
					flex-shrink: 0;
				}

				.head-buttons {
					display: flex;
					flex-shrink: 0;
					gap: 0.875rem;
					padding: 20px 0;

					.icon-buttons {
						display: none;
					}

					.divider {
						display: none;
					}

					.n-button {
						display: flex;
						margin: 0;
						width: 110px;
					}
				}

				// Slide + fade the drawer content in on open. The bar (.logo-burger)
				// stays put and top/height are pinned, so the menu glides down into
				// place with no banner-height jump. Enter only; closing is instant.
				.head-menu,
				.head-buttons {
					opacity: 1;
					transform: translateY(0);
					transition:
						opacity 0.22s ease,
						transform 0.22s ease,
						display 0.22s allow-discrete;

					@starting-style {
						opacity: 0;
						transform: translateY(-8px);
					}
				}

				@media (prefers-reduced-motion: reduce) {
					.head-menu,
					.head-buttons {
						transition: none;
						transform: none;
					}
				}
			}

			.burger-group {
				display: flex;
			}

			.burger {
				display: flex;
			}

			.head-buttons {
				display: none;
			}

			.n-button {
				display: none;
			}
		}
	}

	// Tablet keeps the account controls in the bar. The drawer is only needed for
	// the nav itself at these widths — the row has room left over once the
	// wordmark and Menu button are placed, and burying Sign in and Try for free
	// behind a tap costs the two actions the page is actually asking for. Under
	// 768 the row can't hold them without crowding the wordmark, so there they
	// stay in the drawer.
	@media screen and (min-width: 768px) and (max-width: 1280px) {
		header.header {
			display: flex;
			align-items: center;

			// Height is `unset !important` on the block above, so the bar takes its
			// height from .logo-burger — left alone here rather than fought.
			//
			// `:not(.opened-burger)` is essential, not tidiness: the open drawer turns
			// this header into `flex-direction: column`, where `flex: 1` grows the
			// logo row down the drawer instead of across the bar. Unscoped it measured
			// 352px tall against a 64px bar, centring the wordmark in a band of empty
			// space above the nav list.
			&:not(.opened-burger) .logo-burger {
				// Takes up the slack so .burger-group, absolute against this box, still
				// pins right — landing the Menu button just ahead of the buttons.
				flex: 1;
			}

			.head-buttons {
				display: flex;
			}

			.n-button {
				display: flex;
			}
		}
	}

	// ============================================
	// PAGE-SPECIFIC HEADER STYLES
	// ============================================

	// Solid marketing header with a drop shadow (no border). `services` is
	// solid-border instead, per the design.
	header.header:has([data-header-variant='solid-shadow']) {
		// Same surface bg as solid-border so all marketing headers match.
		background-color: var(--color-bg-surface);
		box-shadow:
			0 0 20px rgba(0, 0, 0, 0.1),
			0 0 40px rgba(0, 0, 0, 0.1);
	}

	// Transparent header over a hero (transparent variant).
	header.header:has([data-header-variant='transparent']) {
		background-color: transparent;
		box-shadow: none;

		.logo,
		.burger {
			filter: invert(100%) sepia(68%) saturate(0%) hue-rotate(350deg) brightness(113%) contrast(101%);
		}

		.burger {
			color: $color-black;
		}

		.n-button {
			width: 110px;

			// Translucent Pricing button unique to the transparent (over-hero) header.
			&.price {
				color: $color-white;
				transition-duration: 0s;
				border: none;
				background-color: rgba(255, 255, 255, 0.05);

				&:hover {
					text-decoration: none;
					color: var(--color-text);
					background-color: var(--color-bg-surface);
				}
			}
		}
	}

	// Marketing CTA buttons (`cta='marketing'` — solid-shadow pages + services).
	header.header:has([data-header-cta='marketing']) .n-button {
		@include marketing-price;
	}

