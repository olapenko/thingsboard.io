			> .main-menu-link:hover .main-menu-chevron,
			> .main-menu-link:focus-visible .main-menu-chevron {
				opacity: 1;
			}

			// Points at the panel it opened, once that panel is open.
			&:has(.sub-menu.open-sub) > .main-menu-link .main-menu-chevron {
