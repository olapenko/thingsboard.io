			}

			.head-menu {
				display: none;

				ul {
					display: unset;

					li {
						height: unset;
						width: 100% !important;

						a,
						span.main-menu-link {
							text-align: left;
							&:focus {
								.centered-sub {
									margin: 0;
									.sub-menu {
										display: block;
									}
								}
							}
						}
						display: block;

						.centered-sub {
							margin: 0;
							.sub-menu {
								position: unset;
								box-shadow: unset;
								padding: 12px 0;

								&.open-sub {
									display: flex;
									width: 100%;
									flex-wrap: wrap;

									// THE SECTIONS SIT SIDE BY SIDE where two fit; each one's items stay in a single file under
									// its own heading. Only these two: Products and Use Cases have two sections each; a lone
