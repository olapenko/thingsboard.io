	// Over a dark hero the links are white, until the bar is scrolled onto its own surface or the
	// drawer opens — both light grounds where white text would vanish.
	header.header:not(.opened-burger):not([data-header-scrolled]):has([data-header-hero='dark']) .head-menu {
