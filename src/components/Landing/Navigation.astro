			.main-menu-chevron {
				display: block;
				width: 20px;
				height: 20px;
				flex: 0 0 auto;
				// Below the label's weight at rest: it marks the kind of item, it is not the thing read.
				opacity: 0.5;
				transition:
					transform 0.2s ease,
					opacity 0.15s ease;
