	// ---------------------------------------------------------------------------------------------
	.main-menu-chevron {
		display: none;
	}

	@media screen and (max-width: 1280px) {
		header.header.opened-burger .head-menu > ul > li {
			// ONE inset for the drawer, and it is the bar's: the nav's own 20px padding,
			// with nothing added on the row. The row was inheriting the desktop `10px 12px
			// 14px`, where the 12px separated items in a horizontal run and the uneven
			// 10/14 left room under the label for the hover indicator. Stacked, neither
			// does anything except misalign: the label landed at 52px while the logo and
			// the buttons above it sat at 20, the hairline floated in at 40, and the label
			// rode above the centre of its own row. Symmetric padding fixes the second,
			// dropping the horizontal fixes the first, and the row still clears 44px.
			padding: 14px 0;

			// A hairline per row, on the SAME token the header's own chrome uses, so the
			// drawer is ruled by the site's lightest line rather than a new one. It sits on
			// the `li` rather than on the label, so an expanded item keeps its submenu on
			// its own side of the line instead of being underlined by it.
			border-bottom: 1px solid var(--sl-color-hairline-light);

			// Nothing follows the last row, so a line under it would read as the start of a
			// section that is not there.
			&:last-child {
				border-bottom: none;
			}

			> .main-menu-link {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 12px;
				// 500, the step Ubuntu actually ships between 400 and 700 — a stacked list
