			color: var(--color-text);
		}

		.centered-sub .sub-menu li {
			a {
				color: var(--color-text);
			}

			&:hover a {
				color: var(--color-primary);
			}
		}
	}

	// Mobile burger opened state navigation — applies on every page so the
	// drawer looks identical regardless of the underlying nav theme.
	.opened-burger .head-menu {
		ul {
			a,
			a:not([href]),
			span.main-menu-link {
				color: var(--color-text);
			}

			.centered-sub {
				margin: 0;
				width: 100%;

				.sub-menu {
					background-color: transparent;

					li {
						a {
							color: var(--color-text);
						}

						&:hover a {
							color: var(--color-primary);
						}
					}
				}
			}
		}
	}
	// ---------------------------------------------------------------------------------------------
	// THE OPEN DRAWER
	//
	// Below 1281px the row becomes a stacked list, and a stacked list gives no hint which of its
	// items open a submenu and which navigate away. Seven of the ten expand, and the markup cannot
	// tell you which, so the chevron is driven by `submenuId` rather than by the tag rendered.
	// Confined to the drawer: the desktop row answers the question with the sliding `.indicator`
	// under the hovered item, and seven chevrons in a bar whose width is the scarce resource would
	// be noise.
	// ---------------------------------------------------------------------------------------------
	.main-menu-chevron {
		display: none;
	}

	@media screen and (max-width: 1280px) {
		header.header.opened-burger .head-menu > ul > li {
			// ONE inset for the drawer, the bar's: the nav's own 20px, with nothing added on the row. The
			// row inherited the desktop `10px 12px 14px`, where the 12px separated items in a horizontal
			// run and the uneven 10/14 left room under the label for the hover indicator; stacked, both
			// only misaligned it. Symmetric padding keeps the row over 44px.
			padding: 14px 0;

			// A hairline per row, on the token the header's own chrome uses. On the `li` rather than the
			// label, so an expanded item keeps its submenu on its own side of the line.
			border-bottom: 1px solid var(--sl-color-hairline-light);

			// Nothing follows the last row, so a line under it would open a section that is not there.
			&:last-child {
				border-bottom: none;
			}

			> .main-menu-link {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 12px;
				// 500, the step Ubuntu ships between 400 and 700: a stacked list carries more weight than
				// the row did without becoming headings.
				font-weight: $font-weight-medium;
				transition: color 0.15s ease;

				&:focus-visible {
					color: var(--color-primary);
