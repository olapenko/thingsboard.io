---
import { Icon } from 'astro-icon/components';
import {
	PLATFORM_ZONES,
	PLATFORM_STAGES,
	PLATFORM_FOUNDATIONS,
	PLATFORM_RUNS,
	PLATFORM_CORE,
	type Zone,
	type PlatformRun,
} from '@data/platform-visual';
import mark from '@root/assets/images/landings/draft/thingsboard-mark.svg?raw';

/**
 * The platform overview: equipment on the left, people on the right, and a clockwise loop through
 * the middle.
 *
 * Adapted from a standalone HTML sandbox. What changed, and why each change was worth making:
 *
 * 1. THE ELBOWS NO LONGER NEED JAVASCRIPT. The original centred the platform box in a grid row
 *    whose height came from the two outer columns, then measured it — `getBoundingClientRect` on
 *    load, on resize and again on `fonts.ready` — to publish `--pt` and `--pb` for the connectors
 *    to hang off. Here the bands are grid ROWS of their own, one above the platform and one below,
 *    so a band's height is `u(BAND)` by construction and an elbow cannot land anywhere else. No
 *    measurement, no resize listener, and no frame where the lines are in the wrong place because
 *    the web font has not settled yet.
 *
 * 2. ONE PATH PER RUN, instead of a bordered div for the corner, a 3px-tall div for each gutter
 *    leg and a separate `<svg>` for the head — twelve absolutely-positioned boxes held together by
 *    hand-tuned seam fudges (`right: -2px`, `left: -3px`, `top: -5.5px`, `left: calc(28% - 7.5px)`).
 *    Every one of those was a hard pixel, and per this directory's notes pixels do not scale: at
 *    phone scale the seams open. A path has no seams to close.
 *
 * 3. EVERY NUMBER IS A DESIGN UNIT. The original was fixed pixels throughout and only worked at
 *    the one width it was drawn at.
 *
 * 4. THE ICON PICKER IS GONE. It shipped ~40 KB of inlined Tabler paths and a popover for trying a
 *    dozen candidates per slot. The choosing is finished; `astro-icon` resolves the chosen names.
 *
 * Only the "in & out" arrow layout survives. The sandbox also carried an inline variant with all
 * four arrows on the cards' own centre line, which read as one two-way pipe rather than a loop.
 *
 * HOW THE THREE COLUMNS STAY IN STEP. The two outer cards are stretched across all three middle
 * rows, so a run always meets a card edge; their three items then divide that height equally
 * (`flex: 1 1 0`) rather than stacking from the top and leaving the remainder at the bottom. Both
 * cards hold three items of equal height in a box of equal height, so row one on the left is level
 * with row one on the right at every width, with nothing measured and no magic number to keep in
 * step. It also means the slack shows up as breathing room between rows instead of a hole under the
 * last one — and there is little of it left, because the middle column is no longer carrying the
 * foundations row (see `foundations` below).
 *
 * WHAT THIS VISUAL CANNOT DO. It is authored at 1160 units with a 13.5-unit floor (the notes under
 * each item and each stage), so R = 86 — and R is the whole story on a narrow screen, because the
 * rendered size of the smallest type is exactly `container ÷ R`. At 1160px the floor is 13.5px; at
 * 1000px it is 11.6px; on a 367px phone column it would be 4.3px. Three columns of prose side by
 * side cannot be made to survive that by scaling, so below a 1000px container the composition
 * STACKS and re-derives its unit from a 480-unit native width, which puts R at 36 and the floor
 * back at 10.3px on the same phone. That switch is a container query, not a media query: the
 * visual still only knows how much room it was handed.
 */

interface Props {
	/**
	 * Show the foundations strip under the four stages.
	 *
	 * OFF by default. It was three more things to read in the densest part of the picture, and it
	 * was the part carrying none of the argument — the loop is the argument, and identity, APIs and
	 * scale are true of every platform in the category. It is kept rather than deleted because it is
	 * the one claim about what is underneath the four stages, and the sandbox can switch it back on
	 * to compare. The markup renders either way and CSS does the hiding, so the sandbox's toggle can
	 * reach it without the page re-rendering anything.
	 */
	foundations?: boolean;
}

const { foundations = false } = Astro.props;

// --- the grid, in design units -------------------------------------------------------------
//
// The column widths are real numbers rather than `fr`, because the connector geometry below is
// computed from them. Written as `fr` they would live in two places and be free to disagree, and
// the symptom would be elbows that miss the platform's edge at some widths and not others.
//
// The outer columns took 24 units each off the gutters and the middle (from 248/56/552). Measured,
// 248 was eight units short of holding "Gateways and platforms" on one line, and that one wrap was
// what made the left column's rows sit lower than the right column's. Widening it is what lets the
// two sets of three line up as three equal rows rather than as five lines against four.
const COL = { side: 272, gut: 44, mid: 528 };
const NATIVE = COL.side * 2 + COL.gut * 2 + COL.mid; // 1160 — the site's own measure

/** The stacked composition's native width. See the note above about R. */
const NARROW = 480;

// --- the four runs -------------------------------------------------------------------------

/** How far a run drops or rises between a gutter lane and the platform's edge. */
const BAND = 30;
/** A lane's distance from the band's outer edge, leaving room for an arrowhead's wings. */
const LANE = 6;
/** The corner radius where a run turns. */
const BEND = 10;
/** Arrowhead length and half-width, in the proportion the source drawing used. */
const HEAD = 6;
const WING = 4;

// x is measured from the band's own left edge, which is the equipment card's right edge: a band
// spans the two gutters and the platform column, so it never overlaps a card and never has to be
// offset to account for one.
const BAND_W = COL.gut * 2 + COL.mid; // 616
const X = { eq: 0, people: BAND_W };

// The two turn columns, set symmetrically about the platform's centre. At 112 units either side
// they land at 29% and 71% of the platform column — far enough in that a run reads as entering the
// box rather than clipping its corner, far enough out that the four stages still have the middle.
const TURN = 112;
const MID_C = COL.gut + COL.mid / 2;
const IN_X = MID_C - TURN; // where the inbound runs meet the platform
const OUT_X = MID_C + TURN; // where the outbound runs leave it

// Every arc sweeps the same way, because the loop goes one way: right→down, up→right, down→left
// and left→up are all clockwise turns in a y-down coordinate system. If one of these ever has to
// be 0, the loop has stopped being a loop.
const CW = 1;

/** The bottom band's lane, measured from its top. */
const LO = BAND - LANE;

/** Top band: telemetry arrives from the equipment, views and alerts leave for the people. */
const TOP = {
	telemetry: {
		line: `M ${X.eq},${LANE} H ${IN_X - BEND} A ${BEND},${BEND} 0 0 ${CW} ${IN_X},${LANE + BEND} V ${BAND}`,
		head: `M ${IN_X - WING},${BAND - HEAD} L ${IN_X},${BAND} L ${IN_X + WING},${BAND - HEAD}`,
	},
	views: {
		line: `M ${OUT_X},${BAND} V ${LANE + BEND} A ${BEND},${BEND} 0 0 ${CW} ${OUT_X + BEND},${LANE} H ${X.people}`,
		head: `M ${X.people - HEAD},${LANE - WING} L ${X.people},${LANE} L ${X.people - HEAD},${LANE + WING}`,
	},
};

/** Bottom band: actions arrive from the people, commands and updates leave for the equipment. */
const BOT = {
	commands: {
		line: `M ${IN_X},0 V ${LO - BEND} A ${BEND},${BEND} 0 0 ${CW} ${IN_X - BEND},${LO} H ${X.eq}`,
		head: `M ${X.eq + HEAD},${LO - WING} L ${X.eq},${LO} L ${X.eq + HEAD},${LO + WING}`,
	},
	actions: {
		line: `M ${X.people},${LO} H ${OUT_X + BEND} A ${BEND},${BEND} 0 0 ${CW} ${OUT_X},${LO - BEND} V 0`,
		head: `M ${OUT_X - WING},${HEAD} L ${OUT_X},0 L ${OUT_X + WING},${HEAD}`,
	},
};

const BANDS = {
	in: [TOP.telemetry, TOP.views],
	out: [BOT.commands, BOT.actions],
};

// --- the stacked form's arrows ---------------------------------------------------------------
//
// The same four runs rotated a quarter turn: the loop is unchanged, it is just read top to bottom.
// Each one travels with its label rather than being drawn into a band, so there is no second
// alignment problem to solve when a label wraps to two lines.
//
// A flexing line plus a fixed head, the construction the stage rail already uses, rather than one
// SVG for the whole arrow. An SVG has to know its own height to draw a line the length of the gap,
// and the gap is whatever the label needs; this stretches to it, so a stem meets the card above and
// the card below exactly, which is the property the wide form's elbows have.
const STEM = { w: 14, h: 12 };
const HEAD_D = `M ${STEM.w / 2 - WING},${STEM.h - HEAD} L ${STEM.w / 2},${STEM.h} L ${STEM.w / 2 + WING},${STEM.h - HEAD}`;

// Stacked, the zones read equipment → platform → people down the page, so a run points down when
// its destination sits below its source and up when it does not.
const ORDER = ['equipment', 'platform', 'people'];
const dirOf = (r: PlatformRun) => (ORDER.indexOf(r.from) < ORDER.indexOf(r.to) ? 'down' : 'up');

const srcOf = (id: PlatformRun['id']) => PLATFORM_RUNS.find((r) => r.id === id)!.from;
const bandSrc = { in: ['telemetry', 'views'], out: ['commands', 'actions'] } as const;

const zoneItems = (z: Zone) => z.items;

const vars = [
	`--plat-u: min(1.15px, calc(100cqw / ${NATIVE}))`,
	// A higher cap on the stacked form so it uses the room a tablet gives it rather than sitting in
	// the middle of it: 1.25 × 480 caps that drawing at 600px.
	`--plat-u-narrow: min(1.25px, calc(100cqw / ${NARROW}))`,
	`--plat-native: ${NATIVE}`,
	`--plat-narrow: ${NARROW}`,
	`--plat-col-side: ${COL.side}`,
	`--plat-col-gut: ${COL.gut}`,
	`--plat-col-mid: ${COL.mid}`,
	`--plat-band: ${BAND}`,
].join('; ');
---

<div class="plat-fit">
	<div class="plat" style={vars} data-found={foundations ? '' : undefined}>
		{
			PLATFORM_ZONES.map((z) => (
				<section class={`plat__zone plat__zone--${z.id}`} aria-labelledby={`plat-${z.id}`}>
					<header class="plat__zone-head">
						<Icon class="plat__zone-emblem" name={z.icon} aria-hidden="true" />
						<h3 class="plat__zone-title" id={`plat-${z.id}`}>
							{z.title}
						</h3>
					</header>
					{/* Three rows dividing the card's height equally, so the left column's rows are level
					    with the right column's without either of them knowing the other exists. */}
					<ul class="plat__items">
						{zoneItems(z).map((it) => (
							<li class="plat__item">
								<Icon class="plat__item-icon" name={it.icon} aria-hidden="true" />
								<div>
									<p class="plat__item-name">{it.name}</p>
									<p class="plat__item-note">{it.note}</p>
								</div>
							</li>
						))}
					</ul>
				</section>
			))
		}

		{
			/* The four run labels. Each is a real element rather than SVG text, so it takes the page's
		    font stack and wraps where the room runs out. The wide form parks them in the rows above
		    and below the bands; the stacked form moves them into the gaps between the zones, and the
		    stem inside each one is the arrow it needs once it is on its own. */
		}
		{
			PLATFORM_RUNS.map((r) => (
				<p class={`plat__run plat__run--${r.id}`} data-src={r.from}>
					<span class="plat__stem" data-dir={dirOf(r)} aria-hidden="true">
						<span class="plat__stem-line" />
						<svg class="plat__stem-head" viewBox={`0 0 ${STEM.w} ${STEM.h}`}>
							<path d={HEAD_D} />
						</svg>
					</span>
					<span>{r.label}</span>
				</p>
			))
		}

		{
			/* The bands. Each spans the two gutters and the platform column — never a card — so its
		    SVG is full-bleed inside its row and the drawing's x coordinates are the band's own.
		    `preserveAspectRatio="none"` because the box is exactly `BAND_W × BAND` units by
		    construction: there is no ratio to preserve, and the default would letterbox a sub-pixel
		    rounding error into a visible gap between an elbow and the platform's edge. */
		}
		{
			(['in', 'out'] as const).map((which) => (
				<div class={`plat__band plat__band--${which}`} aria-hidden="true">
					<svg class="plat__wires" viewBox={`0 0 ${BAND_W} ${BAND}`} preserveAspectRatio="none">
						{BANDS[which].map((r, i) => (
							<Fragment>
								<path class="plat__wire" data-src={srcOf(bandSrc[which][i])} d={r.line} />
								<path class="plat__head" data-src={srcOf(bandSrc[which][i])} d={r.head} />
							</Fragment>
						))}
					</svg>
				</div>
			))
		}

		<section class="plat__core" aria-labelledby="plat-core">
			{
				/* The product lockup: the mark, then the name in bold and the product in medium. The
			    mark is inlined rather than an `<img>` so it draws in `currentColor` and takes the
			    platform's accent like everything else in this column. */
			}
			<header class="plat__core-head">
				<span class="plat__core-mark" aria-hidden="true" set:html={mark} />
				<h3 class="plat__core-title" id="plat-core">
					<b>{PLATFORM_CORE.brand}</b>
					{PLATFORM_CORE.product}
				</h3>
			</header>

			<div class="plat__stages-wrap">
				{
					/* The rail runs behind the stage icons at their centre line and stops where the last
				    one begins, which is what its head points into. Each icon paints the platform's own
				    surface behind itself and carries a gap on its right, and that is what knocks the
				    rail into four segments — the line is never actually broken, so nothing has to be
				    measured to break it in the right places. Absolutely positioned, and earlier in the
				    DOM than the icons, which are positioned too: same paint step, so document order
				    decides and the icons win. */
				}
				<span class="plat__rail" aria-hidden="true">
					<span class="plat__rail-line"></span>
					<svg class="plat__rail-head" viewBox="0 0 12 14"><path d="M3 2.9 9 7 3 11.1"></path></svg>
				</span>

				<ol class="plat__stages">
					{
						PLATFORM_STAGES.map((s) => (
							<li class="plat__stage">
								<Icon class="plat__stage-icon" name={s.icon} aria-hidden="true" />
								<p class="plat__stage-name">{s.name}</p>
								<p class="plat__stage-note">{s.note}</p>
							</li>
						))
					}
				</ol>
			</div>

			<ul class="plat__found">
				{
					PLATFORM_FOUNDATIONS.map((f) => (
						<li class="plat__found-item">
							<Icon class="plat__found-icon" name={f.icon} aria-hidden="true" />
							<span>{f.label}</span>
						</li>
					))
				}
			</ul>
		</section>
	</div>
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	// Every size below is a multiple of one design unit, so the whole composition scales as a piece
	// instead of reflowing. See SolutionFlow for why the unit comes from the container.
	@function u($n) {
		@return calc(#{$n} * var(--u));
	}

	.plat-fit {
		container-type: inline-size;
	}

	.plat {
		--u: var(--plat-u);

		// Three hues, one per zone, and a line always takes the colour of the zone it LEAVES. Two of
		// them are already measured members of this family — the connect visual's cyan and amber
		// route accents — and the third is the brand indigo, because the middle column is the product.
		//
		// The source drawing used a steel blue, a forest green and a brown of its own. The green in
		// particular would read as PE here rather than as the platform.
		--plat-equipment: #0e7490;
		--plat-platform: #{$color-brand};
		--plat-people: #b45309;

		// Derived from the platform hue rather than written out, so moving that accent moves the
		// surface and the hairline with it.
		--plat-surface: color-mix(in srgb, var(--plat-platform) 7%, #fff);
		--plat-edge: color-mix(in srgb, var(--plat-platform) 28%, #fff);
		--plat-paper: var(--color-bg-surface, #fff);
		--plat-line: var(--color-border, #ebebeb);
		--plat-ink: var(--color-text, #17181c);
		--plat-muted: var(--color-text-secondary, #5b616e);

		display: grid;
		// Real widths, not `fr`: the connector geometry is computed from these same numbers.
		grid-template-columns:
			u(var(--plat-col-side)) u(var(--plat-col-gut)) u(var(--plat-col-mid))
			u(var(--plat-col-gut)) u(var(--plat-col-side));
		// Label · band · platform · band · label. The bands being rows of a known height is the whole
		// reason the elbows need no measuring.
		grid-template-rows: auto u(var(--plat-band)) auto u(var(--plat-band)) auto;
		max-width: u(var(--plat-native));
		margin: 0 auto;
	}

	// --- the two outer zones ---------------------------------------------------------------

	// Stretched across all three middle rows, so a run always meets a card edge rather than starting
	// in mid-air beside one. A column, so the items below can take what the head does not.
	.plat__zone {
		display: flex;
		flex-direction: column;
		grid-row: 2 / 5;
		padding: u(13) u(17);
		border: max(1px, #{u(1)}) solid var(--plat-line);
		border-radius: u(10);
		background: var(--plat-paper);
	}

	.plat__zone--equipment {
		--zone: var(--plat-equipment);
		grid-column: 1;
	}

	.plat__zone--people {
		--zone: var(--plat-people);
		grid-column: 5;
	}

	// Inline, not stacked. The source drawing gave this an 84px column of its own with the emblem
	// above the words; at the sizes the rest of the card now runs at, that was the single largest
	// piece of empty space in the composition.
	.plat__zone-head {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: u(9);
		padding-bottom: u(11);
		border-bottom: max(1px, #{u(1)}) solid var(--plat-line);
	}

	.plat__zone-emblem {
		flex: none;
		width: u(24);
		height: u(24);
		color: var(--zone);
	}

	.plat__zone-title {
		margin: 0;
		font-size: u(15);
		font-weight: $font-weight-medium;
		line-height: 1.2;
		letter-spacing: -0.005em;
		color: var(--zone);
	}

	.plat__items {
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	// `flex: 1 1 0` — three equal shares of whatever the card's height turns out to be. This is what
	// aligns the left column's rows with the right column's: both cards are the same height and hold
	// the same number of rows, so nothing has to agree on a row height in advance. It also spends the
	// card's spare height as space between the rows instead of leaving a hole under the last one.
	.plat__item {
		display: flex;
		flex: 1 1 0;
		align-items: center;
		gap: u(12);
		padding: u(10) 0;

		& + & {
			border-top: max(1px, #{u(1)}) solid var(--plat-line);
		}
	}

	.plat__item-icon {
		flex: none;
		width: u(26);
		height: u(26);
		color: var(--zone);
	}

	.plat__item-name {
		margin: 0;
		font-size: u(16);
		font-weight: $font-weight-bold;
		line-height: 1.2;
		letter-spacing: -0.015em;
		color: var(--plat-ink);
	}

	// The floor of the composition, and so the number that decides the stacking threshold below.
	.plat__item-note {
		margin: u(3) 0 0;
		font-size: u(13.5);
		line-height: 1.35;
		color: var(--plat-muted);
	}

	// --- the platform ------------------------------------------------------------------------

	.plat__core {
		grid-column: 3;
		grid-row: 3;
		padding: u(13) u(22) u(20);
		border: max(1px, #{u(1)}) solid var(--plat-edge);
		border-radius: u(10);
		background: var(--plat-surface);
	}

	.plat__core-head {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: u(10);
		padding-bottom: u(15);
	}

	.plat__core-mark {
		display: block;
		flex: none;
		width: u(26);
		height: u(26);
		color: var(--plat-platform);
	}

	.plat__core-title {
		margin: 0;
		font-size: u(24);
		font-weight: $font-weight-medium;
		line-height: 1.1;
		letter-spacing: -0.025em;
		color: var(--plat-platform);

		b {
			font-weight: $font-weight-bold;
		}
	}

	.plat__stages-wrap {
		position: relative;
	}

	.plat__stages {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		column-gap: u(18);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.plat__rail {
		position: absolute;
		top: u(13.5);
		left: 0;
		// Stops where the fourth stage begins, so the head points into the last one rather than past
		// it. A percentage because the four columns are `fr` and may be re-divided.
		right: calc(25% - #{u(13)});
		display: flex;
		align-items: center;
	}

	.plat__rail-line {
		flex: 1 1 auto;
		height: u(3);
		border-radius: u(1.5);
		background: var(--plat-platform);
	}

	.plat__rail-head {
		flex: none;
		width: u(12);
		height: u(14);
		max-width: none;
		margin-left: u(-7);
		fill: none;
		stroke: var(--plat-platform);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.plat__stage {
		position: relative;
		padding-top: u(42);
	}

	// Paints the surface behind itself, which is what breaks the rail into segments.
	.plat__stage-icon {
		position: absolute;
		top: 0;
		left: 0;
		box-sizing: content-box;
		width: u(30);
		height: u(30);
		padding-right: u(12);
		background: var(--plat-surface);
		color: var(--plat-platform);
	}

	.plat__stage-name {
		margin: 0;
		font-size: u(20);
		font-weight: $font-weight-bold;
		line-height: 1.15;
		letter-spacing: -0.025em;
		color: var(--plat-platform);
	}

	.plat__stage-note {
		margin: u(5) 0 0;
		font-size: u(13.5);
		line-height: 1.35;
		color: var(--plat-muted);
	}

	// Not a fifth stage: these are true of all four, so they sit under a rule rather than beside
	// them in the row. Off unless asked for — see the `foundations` prop for why.
	.plat__found {
		display: none;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		column-gap: u(18);
		margin: u(20) 0 0;
		padding: u(16) 0 0;
		border-top: max(1px, #{u(1)}) solid var(--plat-edge);
		list-style: none;
	}

	.plat[data-found] .plat__found {
		display: grid;
	}

	.plat__found-item {
		display: flex;
		align-items: center;
		gap: u(9);
		font-size: u(14);
		font-weight: $font-weight-medium;
		letter-spacing: -0.01em;
		color: var(--plat-platform);
	}

	.plat__found-icon {
		flex: none;
		width: u(21);
