---
/**
 * The ways a product installs, as the installations hub lists them: one `ChipGroup` per group of
 * `@data/installationsHub`, its title as the group's eyebrow label, and every option a link chip
 * with its wordmark and, in grey after the name, what the old page qualified it with in brackets
 * (Docker, Linux / macOS), so a row of Dockers reads by platform.
 *
 * The labels are the hub's data, never a copy: the hub renders this for every product with
 * something to install, and Bookend's pick of four is cut from the same entries. The box around the
 * chips (a panel, a band, nothing) is the caller's.
 */
import Chip from '@components/ui/Chip.astro';
import ChipGroup from '@components/ui/ChipGroup.astro';
import type { InstallOptionGroup } from '@data/installationsHub';

interface Props {
	groups: InstallOptionGroup[];
	class?: string;
}

const { groups, class: className } = Astro.props;
---

<div class:list={['install-options', className]}>
	{groups.map((group) => (
		<ChipGroup label={group.title} class="install-options__group">
			{group.items.map((option) => (
				<li>
					<Chip href={option.href} logo={option.logo} note={option.note}>
						{option.label}
					</Chip>
				</li>
			))}
		</ChipGroup>
	))}
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	// Groups one after another, as On-premises' cloud accounts sit under its servers: 20 apart, the
	// step the hub's columns already keep between their blocks.
	.install-options__group + .install-options__group {
		margin-top: $spacing-5;
	}
</style>
