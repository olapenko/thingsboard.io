			--cf-border-hover: #6e7079;
			--cf-field-bg: #17181b;
			--cf-error: #ff8a80;
			--cf-error-ring: rgba(255, 138, 128, 0.2);
			--cf-card-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.5);
		}
	}

	.cf--popup {
		padding: 0;
	}

	.cf-card {
		position: relative;
		margin: 0;
		padding: $spacing-8;
		background: var(--color-bg-surface);
		color: var(--color-text);
		border-radius: $radius-xl;
		box-shadow: var(--cf-card-shadow);

		@include media-down(md) {
			padding: $spacing-6 $spacing-5;
		}

		// Resets through `:where()` so every class rule below outranks them.
		:where(p, h2) {
			margin: 0;
		}
	}

	.cf-head {
		margin-bottom: $spacing-6;
	}

	.cf-title {
		@include type-card;
		color: var(--color-text);
	}

	.cf-sub {
		@include type-small;
		margin-top: $spacing-1;
		color: var(--color-text-secondary);
