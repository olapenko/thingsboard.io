	.cf-range-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 2px $spacing-4;
	}

	.cf-range-value {
		@include type-link;
		color: var(--color-primary);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;

		&.is-empty {
			font-weight: $font-weight-normal;
			color: var(--color-text-secondary);
		}
	}

	// Native range, restyled: keyboard, touch and screen readers come with it. `--p` (0–1) is the
	// thumb's position, set by the script; the fill stops under the thumb's centre, so it runs from
	// half a thumb in to half a thumb short of the end rather than across the whole track.
	.cf-range {
		--thumb: 24px;
		--track: 6px;
		--p: 0;
		--fill: calc(var(--thumb) / 2 + (100% - var(--thumb)) * var(--p));

		width: 100%;
		height: var(--thumb);
		margin: 6px 0 0;
		background: transparent;
		cursor: pointer;
		appearance: none;
		-webkit-appearance: none;

		&::-webkit-slider-runnable-track {
			height: var(--track);
			border-radius: 999px;
			background: linear-gradient(to right, var(--color-primary) var(--fill), var(--cf-border) var(--fill));
		}

		&::-moz-range-track {
			height: var(--track);
			border-radius: 999px;
			background: linear-gradient(to right, var(--color-primary) var(--fill), var(--cf-border) var(--fill));
		}

		&::-webkit-slider-thumb {
			width: var(--thumb);
			height: var(--thumb);
			margin-top: calc((var(--track) - var(--thumb)) / 2);
			background: var(--color-bg-surface);
			border: 2px solid var(--color-primary);
			border-radius: 50%;
			box-shadow: 0 1px 3px rgba(var(--color-shadow-ui-rgb, 16, 24, 40), 0.2);
			transition: box-shadow 0.15s ease;
			-webkit-appearance: none;
		}

		&::-moz-range-thumb {
			box-sizing: border-box;
			width: var(--thumb);
			height: var(--thumb);
			background: var(--color-bg-surface);
			border: 2px solid var(--color-primary);
			border-radius: 50%;
			box-shadow: 0 1px 3px rgba(var(--color-shadow-ui-rgb, 16, 24, 40), 0.2);
		}

		&:hover::-webkit-slider-thumb {
			box-shadow: 0 0 0 6px var(--cf-ring);
		}

		&:focus {
			outline: none;
		}

		&:focus-visible::-webkit-slider-thumb {
			box-shadow: 0 0 0 6px var(--cf-ring);
		}

		&:focus-visible::-moz-range-thumb {
			box-shadow: 0 0 0 6px var(--cf-ring);
		}
	}

	// One tick per stop, centred under where the thumb lands: inset half a thumb at each end.
	.cf-range-ticks {
		display: flex;
		justify-content: space-between;
		padding: 0 calc(12px - 1px);

		span {
			width: 2px;
			height: 6px;
			border-radius: 1px;
