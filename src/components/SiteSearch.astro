---
import { Products, productDocsPrefix } from '@models/site.models.ts';
import { productVersions } from '@util/path-utils';

/**
 * THE SEARCH DIALOG, rendered once per page by the bar and opened by any `<search-button>` on the
 * page (`SearchButton`, the bar's trigger) and by the keys: ⌘K or Ctrl K anywhere, `/` outside a
 * text field.
 *
 * Google Programmable Search in a panel, built on first use. cse.js costs ~170 KiB and ~200ms of
 * main thread, so it loads on the first hover, focus or click of a trigger and never before; it
 * scans the DOM for `.gcse-search` once as it executes, so the panel is built in the same breath.
 *
 * NOT A `<dialog>`, on purpose. Google renders its autocomplete dropdown (`.gssb_c`) at the body
 * root, and a modal dialog in the top layer would cover it whatever z-index it carried. So the
 * panel is a positioned layer of its own, and what a `<dialog>` gives for free is done by hand:
 * the backdrop, the close button and Escape close it, Tab wraps inside it, and focus returns to the
 * control that opened it.
 *
 * Drawn on the kit: the Dialog's panel (the surface, 16px corners, `--elev-dialog`, the 55% ink
 * backdrop, a sheet from the foot on a phone), the Field's box around Google's input, the primary
 * Button for its submit, and the result rows on the type ladder — titles only, the ink, the brand
 * on hover.
 *
 * GOOGLE'S ATTRIBUTION STAYS VISIBLE. The free Programmable Search Engine asks that Google's
 * branding show with the search. The field drops the wordmark Google paints into it (it fights the
 * Field's box) and the results drop Google's own branding rows, so the panel carries the label
 * itself, in Google's words: the head reads "Search ThingsBoard · enhanced by Google", on every
 * open, before and after the results arrive, at every width. Do not hide it.
 */

// TBMQ docs moved off-site, so no `/docs/mqtt-broker/**` pages — and no search page — exist here
// any more. The prefixes stay in `productDocsPrefix` for the links that still point at the broker,
// but they must not produce a search route to a page we don't build.
const offSiteProducts: Products[] = [Products.TBMQ, Products.TBMQ_PE];

// Search-page routes, derived rather than retyped: every docs product hosted here maps mechanically
// to `/docs/<prefix>search/`. Sorting by prefix length descending yields the specificity order the
// lookup needs — a prefix that extends another is always strictly longer, so `paas/eu/` precedes
// `paas/`, and CE's empty prefix lands last as the catch-all. Non-docs routes stay explicit.
const searchRoutes: [string, string][] = [
	['/iot-hub/', '/iot-hub/search/'],
	...Object.entries(productDocsPrefix)
		.filter(([product]) => !offSiteProducts.includes(product as Products))
		.map(([, prefix]) => prefix)
		.sort((a, b) => b.length - a.length)
		.map((prefix): [string, string] => [`/docs/${prefix}`, `/docs/${prefix}search/`]),
];

// A result's path line names the docs product by the site's own name for it (`ThingsBoard PE`,
// `ThingsBoard Edge`), longest prefix first, so `edge/pe/` wins over `edge/`; CE's empty prefix last.
const docsProducts: [string, string][] = Object.values(productVersions)
	.map((v): [string, string] => [v.prefix, v.titleName])
	.sort((a, b) => b[0].length - a[0].length);
---

<site-search
	data-search-routes={JSON.stringify(searchRoutes)}
	data-search-products={JSON.stringify(docsProducts)}
></site-search>

<script>
	import { lockScroll, unlockScroll } from '@util/scroll-lock';

	// Rendered once by the bar; the flag guards a second copy (a stage, a sandbox page) all the same.
	if (!(window as any).__tbSearch) {
		(window as any).__tbSearch = true;

		// Lazy-load Google CSE on first interaction. cse.js scans the DOM for `.gcse-search` elements
		// once at execute time (default `parsetags=onload`), so the panel holding that element MUST be
		// in the DOM before cse.js runs — `loadCse()` and `buildModal()` always go together via `init()`.
		let cseLoaded = false;
		const loadCse = () => {
			if (cseLoaded) return;
			cseLoaded = true;
			const script = document.createElement('script');
			script.async = true;
			script.src = 'https://cse.google.com/cse.js?cx=006967103846171422263:o5lnt35mvwq';
			// Blocked or offline: say so in the panel, with the full search page as the way round, rather
			// than leave a loader running over an empty panel.
			script.addEventListener('error', () => {
				loaderBar?.classList.remove('active');
				const err = modal?.querySelector<HTMLElement>('[data-search-error]');
				const page = err?.querySelector<HTMLAnchorElement>('[data-search-page]');
				if (page) page.href = getSearchPageUrl('');
				if (err) err.hidden = false;
				modal?.querySelector<HTMLElement>('[data-search-meta]')?.setAttribute('hidden', '');
			});
			document.head.appendChild(script);
		};

		// Detaches the hover/focus preload listeners once the first interaction has done their job.
		const preloadCtrl = new AbortController();

		const init = () => {
			buildModal();
			loadCse();
			preloadCtrl.abort();
		};

		// The "more results" page for the section the reader is in; the routes come from the frontmatter.
		const routesAttr = document.querySelector('site-search')?.getAttribute('data-search-routes');
		const searchRoutes: [string, string][] = routesAttr ? JSON.parse(routesAttr) : [];

		const getSearchPageUrl = (query: string) => {
			const path = window.location.pathname;
			const match = searchRoutes.find(([prefix]) => path.startsWith(prefix));
			const searchPage = match ? match[1] : '/docs/pe/search/';
			return query ? `${searchPage}?q=${encodeURIComponent(query)}` : searchPage;
		};

		let modal: HTMLElement | null = null;
		let box: HTMLElement | null = null;
		let loaderBar: HTMLElement | null = null;
		// The control that opened the dialog, to hand focus back to on close.
		let opener: HTMLElement | null = null;

		const isOpen = () => !!modal?.classList.contains('open');

		const close = () => {
			if (!modal || !isOpen()) return;
			modal.classList.remove('open');
			document.documentElement.classList.remove('tb-search-open');
			unlockScroll('search');
			stopFocusRetention();
			const back = opener;
			opener = null;
			if (back && back.isConnected) back.focus({ preventScroll: true });
		};

		const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])';

		const buildModal = (): HTMLElement => {
			if (modal) return modal;
			modal = document.createElement('div');
			modal.id = 'tb-search-modal';
			modal.className = 'print:hidden';
			modal.setAttribute('role', 'dialog');
			modal.setAttribute('aria-modal', 'true');
			modal.setAttribute('aria-labelledby', 'tb-search-title');
			modal.innerHTML = `
				<div class="tb-search-overlay" data-search-close></div>
				<div class="tb-search-box">
					<div class="tb-loader-bar"></div>
					<div class="tb-search-head">
						<span class="tb-search-eyebrow" id="tb-search-title">Search ThingsBoard</span>
						<button type="button" class="tb-search-close" aria-label="Close search" data-search-close>
							<kbd class="tb-search-close-key" aria-hidden="true">Esc</kbd>
							<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
							<span class="tb-search-close-word" aria-hidden="true">Close</span>
						</button>
					</div>
					<div class="gcse-search" data-linkTarget="_self"></div>
					<div class="tb-search-meta" data-search-meta>
						<p class="tb-search-hint">Type a few words and press Search or Enter; suggestions appear as you type.</p>
						<p class="tb-search-attrib">
							<span>Search enhanced by</span>
							<img class="tb-search-g tb-search-g--light" src="https://www.google.com/images/branding/googlelogo/1x/googlelogo_color_92x30dp.png" srcset="https://www.google.com/images/branding/googlelogo/2x/googlelogo_color_92x30dp.png 2x" width="46" height="15" alt="Google" />
							<img class="tb-search-g tb-search-g--dark" src="https://www.google.com/images/branding/googlelogo/1x/googlelogo_light_color_92x30dp.png" srcset="https://www.google.com/images/branding/googlelogo/2x/googlelogo_light_color_92x30dp.png 2x" width="46" height="15" alt="Google" />
						</p>
					</div>
					<p class="tb-search-error" data-search-error hidden>
						Search couldn't load. Check your connection, or try <a data-search-page href="/docs/pe/search/">the search page</a>.
					</p>
				</div>
			`;
			document.body.appendChild(modal);

			box = modal.querySelector<HTMLElement>('.tb-search-box');
			loaderBar = modal.querySelector<HTMLElement>('.tb-loader-bar');
			const showLoader = () => loaderBar?.classList.add('active');
			const hideLoader = () => loaderBar?.classList.remove('active');

			// The backdrop and the close button both close; a click anywhere else in the panel is Google's.
			modal.addEventListener('click', (e) => {
				if ((e.target as Element).closest('[data-search-close]')) close();
			});

			// Tab wraps inside the panel, since nothing makes the page behind it inert (see the note above).
			modal.addEventListener('keydown', (e) => {
				if (e.key !== 'Tab' || !box) return;
				const items = [...box.querySelectorAll<HTMLElement>(FOCUSABLE)].filter((el) => el.offsetParent !== null);
				if (!items.length) return;
				const first = items[0];
				const last = items[items.length - 1];
				if (e.shiftKey && document.activeElement === first) {
					e.preventDefault();
					last.focus();
				} else if (!e.shiftKey && document.activeElement === last) {
					e.preventDefault();
					first.focus();
				}
			});

			// THE RESULT FEED, from Google's markup. Each result keeps its title, cut at the site's own suffix
			// ("Device provisioning | Docs | ThingsBoard IoT Gateway" reads "Device provisioning"); under it a
			// path line built from the URL in the site's own names ("Docs › ThingsBoard IoT Gateway ›
			// Features"); then Google's snippet, two lines. The whole row is the link.
			const productsAttr = document.querySelector('site-search')?.getAttribute('data-search-products');
			const docsProducts: [string, string][] = productsAttr ? JSON.parse(productsAttr) : [];
			const SECTIONS: Record<string, string> = {
				blog: 'Blog',
				'iot-hub': 'IoT Hub',
				'use-cases': 'Use cases',
				'case-studies': 'Case studies',
				products: 'Products',
				pricing: 'Pricing',
				partners: 'Partners',
				services: 'Services',
				installations: 'Installations',
			};
			const words = (slug: string) => {
				const w = decodeURIComponent(slug).replace(/[-_]+/g, ' ').trim();
				return w.charAt(0).toUpperCase() + w.slice(1);
			};
			const pathLine = (href: string) => {
				let url: URL;
				try {
					url = new URL(href, location.origin);
				} catch {
					return '';
				}
				const segs = url.pathname.split('/').filter(Boolean);
				if (!segs.length) return 'ThingsBoard';
				if (segs[0] !== 'docs') return SECTIONS[segs[0]] ?? words(segs[0]);
				const rest = segs.slice(1).join('/') + '/';
				const [prefix, name] = docsProducts.find(([p]) => rest.startsWith(p)) ?? ['', 'ThingsBoard'];
				const area = rest.slice(prefix.length).split('/').filter(Boolean)[0];
				return ['Docs', name, area && words(area)].filter(Boolean).join(' › ');
			};
			/**
			 * Cuts a title at the site's suffix — its first " | ", or a closing " - ThingsBoard…" — keeping
			 * Google's highlighting before it.
			 */
			const cutTitle = (a: HTMLElement) => {
				const text = a.textContent ?? '';
				let at = text.indexOf(' | ');
				if (at <= 0) at = /\s[-\u2013\u2014]\s+ThingsBoard\b.*$/.exec(text)?.index ?? -1;
				if (at <= 0) return;
				const walker = document.createTreeWalker(a, NodeFilter.SHOW_TEXT);
				const texts: Text[] = [];
				while (walker.nextNode()) texts.push(walker.currentNode as Text);
				let seen = 0;
				for (const t of texts) {
					const len = t.data.length;
					if (seen >= at) t.remove();
					else if (seen + len > at) t.data = t.data.slice(0, at - seen);
					seen += len;
				}
				a.querySelectorAll('b').forEach((b) => !b.textContent && b.remove());
			};
			const enhanceResults = () => {
				for (const r of modal!.querySelectorAll<HTMLElement>('.gsc-webResult.gsc-result:not([data-tb])')) {
					r.dataset.tb = '';
					r.querySelectorAll<HTMLElement>('a.gs-title').forEach(cutTitle);
					const title = r.querySelector<HTMLElement>('.gsc-table-cell-snippet-close .gs-title');
					const href = title?.querySelector('a')?.getAttribute('href');
					if (!title || !href) continue;
					const line = document.createElement('div');
					line.className = 'tb-result-path';
					line.textContent = pathLine(href);
					title.after(line);
				}
				// Nothing found: say what was looked for and where else to look.
				const none = modal!.querySelector<HTMLElement>('.gs-no-results-result .gs-snippet:not([data-tb])');
				if (none) {
					none.dataset.tb = '';
					const query = modal!.querySelector<HTMLInputElement>('input.gsc-input')?.value.trim() ?? '';
					none.textContent = query ? `Nothing found for “${query}”. ` : 'Nothing found. ';
					const more = document.createElement('a');
					more.href = getSearchPageUrl(query);
					more.textContent = 'Try the full search page';
					none.append(more, '.');
				}
			};

			// Google's form is the field and its button; the hint and the attribution sit right under it,
			// above any results, and the field gets a placeholder that says what can be found.
			// Held by reference: if Google rebuilds its control, the row is put back rather than lost.
			const meta = modal.querySelector<HTMLElement>('[data-search-meta]');
			const placeMeta = () => {
				const form = modal!.querySelector('.gsc-control-cse .gsc-search-box');
				if (form && meta && form.nextElementSibling !== meta) form.after(meta);
				const input = modal!.querySelector<HTMLInputElement>('input.gsc-input');
				if (input && !input.placeholder) input.placeholder = 'Search the docs, guides and IoT Hub';
			};

			const injectMoreLink = () => {
				const branding = modal!.querySelector('.gcsc-more-maybe-branding-root');
				if (!branding || branding.querySelector('.tb-more-link')) return;
				const query = modal!.querySelector<HTMLInputElement>('input.gsc-input')?.value || '';
				const link = document.createElement('a');
				link.className = 'tb-more-link';
				link.href = getSearchPageUrl(query);
				link.textContent = 'Search more results';
				branding.prepend(link);
			};

			modal.addEventListener('submit', showLoader, true);
			modal.addEventListener(
				'click',
				(e) => {
					if ((e.target as HTMLElement).closest('.gsc-search-button')) showLoader();
				},
				true
			);
			modal.addEventListener(
				'keydown',
				(e) => {
					if ((e.target as HTMLElement).classList.contains('gsc-input') && e.key === 'Enter') showLoader();
				},
				true
			);
			new MutationObserver((mutations) => {
				for (const m of mutations) {
					if (
						(m.target as Element).classList?.contains('gsc-results') ||
						(m.target as Element).closest?.('.gsc-results')
					) {
						hideLoader();
						break;
					}
				}
				placeMeta();
				enhanceResults();
				injectMoreLink();
			}).observe(modal, { childList: true, subtree: true });

			return modal;
		};

		const focusInput = (m: HTMLElement) => {
			const input = m.querySelector<HTMLInputElement>('input.gsc-input');
			if (input && document.activeElement !== input) input.focus();
		};

		// Two mechanisms keep Google's input focused while the dialog is open; both stop on close.
		// 1. Google rebuilds its input several times during its async mount, so one focus() when the
		//    first input appears gets blown away: re-focus on every mutation inside the panel.
		// 2. A late script moving focus to <body>/null (not to an element the reader chose) is undone
		//    on the next frame; a real move — to the close button, a result, outside — is left alone.
		let focusObs: MutationObserver | null = null;
		let focusOutHandler: ((e: FocusEvent) => void) | null = null;

		const startFocusRetention = (m: HTMLElement) => {
			focusInput(m);

			focusObs?.disconnect();
			focusObs = new MutationObserver(() => {
				// Only while the input is what has focus, or nothing has: a reader on the close button or a
				// result keeps their place through Google's re-renders.
				const a = document.activeElement;
				if (!a || a === document.body || a.classList.contains('gsc-input')) focusInput(m);
			});
			focusObs.observe(m, { childList: true, subtree: true });

			if (focusOutHandler) m.removeEventListener('focusout', focusOutHandler);
			focusOutHandler = (e: FocusEvent) => {
				if (!isOpen()) return;
				const input = m.querySelector<HTMLInputElement>('input.gsc-input');
				if (!input || e.target !== input) return;
				const next = e.relatedTarget as Node | null;
				if (next && m.contains(next)) return;
				if (next && next !== document.body) return;
				requestAnimationFrame(() => {
					if (isOpen()) input.focus();
				});
			};
			m.addEventListener('focusout', focusOutHandler);
		};

		const stopFocusRetention = () => {
			focusObs?.disconnect();
			focusObs = null;
			if (focusOutHandler && modal) modal.removeEventListener('focusout', focusOutHandler);
			focusOutHandler = null;
		};

		const open = () => {
			init();
			const m = modal!;
			if (isOpen()) return;
			opener = document.activeElement instanceof HTMLElement ? document.activeElement : null;
			document.documentElement.classList.add('tb-search-open');
			lockScroll('search');
			m.classList.add('open');
			// The loader until Google has mounted its input: the first open only, while cse.js arrives.
			if (!m.querySelector('input.gsc-input')) {
				loaderBar?.classList.add('active');
				const obs = new MutationObserver(() => {
					if (m.querySelector('input.gsc-input')) {
						loaderBar?.classList.remove('active');
						startFocusRetention(m);
						obs.disconnect();
					}
				});
				obs.observe(m, { childList: true, subtree: true });
			} else {
				requestAnimationFrame(() => startFocusRetention(m));
			}
		};

		// Escape closes — caught in the CAPTURE phase: Google's input handles the key itself and it
		// never bubbles to the document, so a reader with the caret in the field could not leave with
		// Escape (2026-10-07). While Google's suggestions are open, the first Escape is theirs and
		// dismisses them; the next one closes the dialog.
		document.addEventListener(
			'keydown',
			(e) => {
				if (e.key !== 'Escape' || !isOpen()) return;
				// Shown, not `offsetParent`: the dropdown is pinned `fixed` while the dialog is open, and a
				// fixed element has no offsetParent whether it shows or not.
				const suggestions = document.querySelector<HTMLElement>('.gssb_c');
				if (suggestions && getComputedStyle(suggestions).display !== 'none' && suggestions.getClientRects().length)
					return;
				e.preventDefault();
				close();
			},
			{ capture: true }
		);

		// Warm cse.js and the panel on hover or focus of a trigger, so the click feels instant; the
		// listeners go on the first interaction, so they do not run for the rest of the page's life.
		const preload = (e: Event) => {
			if ((e.target as Element)?.closest?.('search-button')) init();
		};
		document.addEventListener('pointerover', preload, { capture: true, passive: true, signal: preloadCtrl.signal });
		document.addEventListener('focusin', preload, { capture: true, signal: preloadCtrl.signal });

		// Every trigger on the page, by delegation.
		document.addEventListener('click', (e) => {
			if ((e.target as Element).closest('search-button')) open();
		});

		// The keys: ⌘K or Ctrl K anywhere, `/` when focus is not in a text field. They open the dialog
		// from the trigger on show, so focus has somewhere to return to.
		const ua =
			(navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform ||
			navigator.userAgent;
		if (/mac|iphone|ipad|ipod/i.test(ua)) {
			document.querySelectorAll('.search-toggle-btn__kbd').forEach((k) => (k.textContent = '⌘K'));
		}

		const typing = (t: EventTarget | null) =>
			t instanceof HTMLElement && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName));

		document.addEventListener('keydown', (e) => {
			if (e.defaultPrevented || e.isComposing) return;
			const combo = (e.metaKey || e.ctrlKey) && !e.altKey && !e.shiftKey && e.key.toLowerCase() === 'k';
			const slash = e.key === '/' && !e.metaKey && !e.ctrlKey && !e.altKey && !typing(e.target);
			if (!combo && !slash) return;
			// Open already: ⌘K stays ours rather than the browser's, and does nothing.
			if (isOpen()) {
				if (combo) e.preventDefault();
				return;
			}
			const all = [...document.querySelectorAll<HTMLButtonElement>('search-button button')];
			const btn = all.find((b) => b.offsetParent !== null) ?? all[0];
			if (!btn) return;
			e.preventDefault();
			btn.focus({ preventScroll: true });
			btn.click();
		});
	}
</script>

<style is:global lang="scss">
	@use '../styles/variables' as *;
	@use '../styles/kbd' as *;

	// The layer. Built by the script and appended to <body>, so nothing here is scoped.
	#tb-search-modal {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 9999;
		align-items: flex-start;
		justify-content: center;
		padding: clamp(32px, 10vh, 96px) 16px 16px;

		&.open {
			display: flex;
		}

		// A phone: the whole screen, the field at the top. Not a sheet from the foot: the keyboard takes
		// the lower half of the screen, a field down there rides on it, and Google's suggestions open
		// under the field — under the keyboard.
		@media (width < 560px) {
			align-items: stretch;
			padding: 0;
		}
	}

	.tb-search-overlay {
		position: absolute;
		inset: 0;
		background: rgb(23 24 28 / 55%);
	}

	// The panel: the Dialog's surface, corners and lift.
	.tb-search-box {
		position: relative;
		z-index: 1;
		width: 640px;
		max-width: 100%;
		max-height: 100%;
		overflow-y: auto;
		padding: 16px 24px 20px;
		border-radius: $radius-xl;
		background: var(--color-bg-surface, #fff);
		color: var(--color-text, #17181c);
		box-shadow: var(--elev-dialog);
		scrollbar-width: thin;
		scrollbar-color: color-mix(in srgb, currentColor 20%, transparent) transparent;

		@media (width < 560px) {
			width: 100vw;
			height: 100dvh;
			max-height: none;
			padding: calc(8px + env(safe-area-inset-top, 0px)) 16px calc(24px + env(safe-area-inset-bottom, 0px));
			border-radius: 0;
		}

		// High contrast drops the shadow: a border keeps the panel off the backdrop.
		@media (forced-colors: active) {
			border: 1px solid CanvasText;
		}
	}

	.tb-search-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin: 0 0 12px;
	}

	.tb-search-eyebrow {
		@include type-eyebrow;
		color: var(--color-text-secondary, #5b616e);
	}

	// Under the field: how to search, until there are results, and Google's attribution — required
	// with the free search (see the header), with Google's own logo, never hidden.
	// One line where it fits; on a phone the hint takes the width and the attribution the next line,
	// at its end.
	.tb-search-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px 16px;
