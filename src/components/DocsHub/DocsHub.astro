---
import { Icon } from 'astro-icon/components';
import Mark from '@components/ui/Mark.astro';
import { markBySrc, type MarkName } from '@data/marks';
import type { FooterProduct } from '@data/footer-map';
import {
	DOCS_HUB_COMMUNITY,
	DOCS_HUB_ECOSYSTEM,
	DOCS_HUB_LISTS,
	DOCS_HUB_PLATFORMS,
	DOCS_HUB_START,
} from '@data/docs-hub';
import { externalLinkAttrs } from '@util/external-links';

// An ecosystem badge's glyph, as the footer's map draws it: the ThingsBoard logo (the Mobile App's), a
// tabler icon, or the product's logo found by the file the data names.
const glyphOf = (p: FooterProduct) =>
	p.icon === 'mark'
		? { logo: 'thingsboard' as const }
		: p.icon.startsWith('tabler:')
			? { icon: p.icon }
			: { product: markBySrc(p.icon) as Exclude<MarkName, 'thingsboard'> };

/**
 * THE DOCS HUB's body, under the page's hero (`docs/index.mdx`): the first stops, the products by
 * their marks — the Docs menu's own groups — and three short lists. `not-content` keeps Starlight's
 * Markdown styles (bullets, link underlines) off it; the page is a splash, so this sets its own measure.
 */
---

<div class="dh not-content">
	<section class="dh__sec" aria-labelledby="dh-start">
		<h2 class="dh__h" id="dh-start">
			Start here
		</h2>
		<ul class="dh__start">
			{DOCS_HUB_START.map((l) => (
				<li>
					<a class="dh__tile" href={l.href}>
						{l.icon && <Icon name={l.icon} class="dh__tile-icon" aria-hidden="true" />}
						<span class="dh__tile-title">{l.title}</span>
						<span class="dh__tile-line">{l.line}</span>
					</a>
				</li>
			))}
		</ul>
	</section>

	<section class="dh__sec" aria-labelledby="dh-products">
		<h2 class="dh__h" id="dh-products">
			Choose your product
		</h2>
		<p class="dh__kicker">IoT platforms</p>
		<ul class="dh__platforms">
			{DOCS_HUB_PLATFORMS.map((p) => (
				<li>
					<a class="dh__product dh__product--platform" href={p.href} {...externalLinkAttrs(p.href)}>
						<Mark size={48} logo="thingsboard" accent={p.mark.hue} class="dh__mark" />
						<span class="dh__pname">{p.heading}</span>
						<span class="dh__pline">{p.description}</span>
					</a>
					{p.href === DOCS_HUB_COMMUNITY.under && (
						<p class="dh__community">
							{DOCS_HUB_COMMUNITY.text} <a href={DOCS_HUB_COMMUNITY.link.href}>{DOCS_HUB_COMMUNITY.link.title} ›</a>
						</p>
					)}
				</li>
			))}
		</ul>
		<p class="dh__kicker">Product ecosystem</p>
		<ul class="dh__eco">
			{DOCS_HUB_ECOSYSTEM.map((p) => (
				<li>
					<a class="dh__product" href={p.href} {...externalLinkAttrs(p.href)}>
						<Mark size={40} fill="wash" accent={p.mark.hue} class="dh__mark" {...glyphOf(p.mark)} />
						<span class="dh__pname">{p.heading}</span>
						<span class="dh__pline">{p.description}</span>
					</a>
				</li>
			))}
		</ul>
	</section>

	<div class="dh__lists">
		{DOCS_HUB_LISTS.map((list, i) => (
			<section aria-labelledby={`dh-list-${i}`}>
				<h2 class="dh__h dh__h--list" id={`dh-list-${i}`}>
					{list.title}
				</h2>
				<ul>
					{list.links.map((l) => (
						<li>
							<a href={l.href}>{l.title}</a>
						</li>
					))}
				</ul>
			</section>
		))}
	</div>
</div>

<style lang="scss">
	@use '../../styles/variables' as *;

	// The hero's column (the splash page's content, 1152 at most), and Starlight's colours so it
	// follows the docs' theme.
	.dh {
		--dh-ink: var(--sl-color-white);
		--dh-soft: var(--sl-color-gray-2);
		--dh-faint: var(--sl-color-gray-3);
		--dh-rule: var(--sl-color-hairline);
		--dh-accent: var(--sl-color-accent);
		--dh-fill: color-mix(in srgb, var(--sl-color-accent) 5%, transparent);

		display: grid;
		gap: 56px;
		padding: 8px 0 80px;
	}

	.dh ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.dh__h {
		margin: 0 0 20px;
		font-size: 24px;
		font-weight: $font-weight-bold;
		line-height: 1.25;
		color: var(--dh-ink);
	}

	.dh__h--list {
		margin-bottom: 12px;
		font-size: 16px;
	}

	.dh__kicker {
		margin: 0 0 12px;
		font-size: 12px;
		font-weight: $font-weight-medium;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--dh-faint);
	}

	// Start here: four tiles, two on a tablet, one on a phone.
	.dh__start {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 16px;

		@include media-down(lg) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		@include media-down(sm) {
			grid-template-columns: 1fr;
		}
	}

	.dh__tile,
	.dh__product {
		display: grid;
		height: 100%;
		border: 1px solid var(--dh-rule);
		border-radius: 12px;
		color: var(--dh-ink);
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			background-color 0.15s ease;

		&:hover,
		&:focus-visible {
			border-color: var(--dh-accent);
			background: var(--dh-fill);
		}
	}

	.dh__tile {
		align-content: start;
		gap: 4px;
		padding: 20px;
	}

	.dh__tile-icon {
		width: 24px;
		height: 24px;
		margin-bottom: 12px;
		color: var(--dh-accent);
	}

	.dh__tile-title {
		font-size: 16px;
		font-weight: $font-weight-bold;
	}

	.dh__tile-line {
		font-size: 14px;
		line-height: 1.45;
		color: var(--dh-soft);
	}

	// A product: its mark, then its name over its line.
	.dh__product {
		grid-template-columns: auto 1fr;
		grid-template-rows: auto auto;
		column-gap: 14px;
		align-items: center;
		padding: 16px 18px;

		:global(.dh__mark) {
			grid-row: 1 / span 2;
		}
	}

	.dh__pname {
		align-self: end;
		font-size: 16px;
		font-weight: $font-weight-bold;
		line-height: 1.3;
	}

	.dh__pline {
		align-self: start;
		font-size: 14px;
		line-height: 1.4;
		color: var(--dh-soft);
	}

	.dh__platforms,
	.dh__eco {
		display: grid;
		gap: 16px;
	}

	// `.dh ul` zeroes a list's margins; this one keeps its gap to the ecosystem's kicker.
	.dh .dh__platforms {
		grid-template-columns: repeat(2, minmax(0, 1fr));
		margin-bottom: 32px;

		.dh__product {
			height: auto;
			padding: 22px 24px;
		}

		.dh__pname {
			font-size: 18px;
		}

		@include media-down(sm) {
			grid-template-columns: 1fr;
		}
	}

	.dh__eco {
		grid-template-columns: repeat(3, minmax(0, 1fr));

		@include media-down(lg) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		@include media-down(sm) {
			grid-template-columns: 1fr;
		}
	}

	// The retired edition: one quiet line under ThingsBoard's card, there for whoever looks for it.
	.dh__community {
		margin: 10px 0 0 4px;
		font-size: 13px;
		color: var(--dh-faint);

		a {
			color: inherit;
			text-decoration: underline;
			text-underline-offset: 3px;

			&:hover {
				color: var(--dh-ink);
			}
		}
	}

	// Three short lists, side by side, then stacked.
	.dh__lists {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 32px;
		padding-top: 40px;
		border-top: 1px solid var(--dh-rule);

		@include media-down(md) {
			grid-template-columns: 1fr;
			gap: 24px;
		}

		ul {
			display: grid;
			gap: 2px;
		}

		a {
			display: inline-block;
			padding: 4px 0;
			font-size: 15px;
			color: var(--dh-soft);
			text-decoration: none;

			&:hover {
				color: var(--dh-accent);
				text-decoration: underline;
				text-underline-offset: 3px;
			}
		}
	}
</style>
