---
import { Icon } from 'astro-icon/components';

/**
 * Appearance: System · Light · Dark, labelled, as a radio group. It replaces the bar's theme icon on
 * the pages that carry the new bar and footer — rendered in `FooterMap`'s base row and at the foot
 * of the new bar's Menu drawer, and only where the page follows the theme (`followsTheme`). Pages
 * locked light show neither, because there is nothing to switch.
 *
 * Why not the icon: it cycles three states in one unlabelled button, draws System as a monitor, and
 * which state comes next depends on the OS theme. Here every state is named and one click away.
 *
 * Same storage as the icon and Starlight's own picker — `starlight-theme`, '' for System — so a
 * choice made with either carries over, and anyone who already picked Dark keeps it.
 *
 * `tone`: `footer` is white on the footer's black, which is black on every page; `page` takes the
 * page's own tokens (the drawer follows the theme).
 */
interface Props {
	tone?: 'footer' | 'page';
}

const { tone = 'page' } = Astro.props;

// Ids per render: the footer and the drawer can both be on one page.
const uid = `tc-${Math.random().toString(36).slice(2, 10)}`;

const OPTIONS = [
	{ value: 'auto', label: 'System', icon: 'tabler:device-desktop' },
	{ value: 'light', label: 'Light', icon: 'tabler:sun' },
	{ value: 'dark', label: 'Dark', icon: 'tabler:moon' },
] as const;
---

<theme-choice class="tc" data-tone={tone}>
	<span class="tc__label" id={`${uid}-label`}>Appearance</span>
	<span class="tc__group" role="radiogroup" aria-labelledby={`${uid}-label`}>
		{
			OPTIONS.map((o) => (
				<button
					type="button"
					class="tc__opt"
					role="radio"
					aria-checked={o.value === 'auto' ? 'true' : 'false'}
					tabindex={o.value === 'auto' ? 0 : -1}
					data-value={o.value}
				>
					<Icon name={o.icon} aria-hidden="true" />
					{o.label}
				</button>
			))
		}
	</span>
</theme-choice>

<script>
	type Theme = 'auto' | 'light' | 'dark';
	const KEY = 'starlight-theme';
	const ORDER: Theme[] = ['auto', 'light', 'dark'];
	declare const StarlightThemeProvider: { updatePickers: (theme: string) => void } | undefined;

	const stored = (): Theme => {
		try {
			const v = localStorage.getItem(KEY);
			return v === 'light' || v === 'dark' ? v : 'auto';
		} catch {
			return 'auto';
		}
	};
	const system = () => (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');

	// Every control on the page shows the same state: this one in the footer and the drawer, the
	// bar's icon and Starlight's picker where a page has them.
	function show(theme: Theme) {
		document.querySelectorAll('theme-choice').forEach((el) => (el as ThemeChoice).reflect(theme));
		document.querySelectorAll('theme-toggle').forEach((t) => t.setAttribute('data-theme', theme));
		if (typeof StarlightThemeProvider !== 'undefined') StarlightThemeProvider.updatePickers(theme);
	}

	function apply(theme: Theme) {
		document.documentElement.dataset.theme = theme === 'auto' ? system() : theme;
		try {
			localStorage.setItem(KEY, theme === 'auto' ? '' : theme);
		} catch {
			/* private mode: the choice holds for this page only */
		}
		show(theme);
	}

	class ThemeChoice extends HTMLElement {
		connectedCallback() {
			this.reflect(stored());
			this.addEventListener('click', (e) => {
				const opt = (e.target as Element).closest<HTMLButtonElement>('.tc__opt');
				if (opt) apply(opt.dataset.value as Theme);
			});
			// Arrow keys move the choice, as in any radio group; Home and End jump to the ends.
			this.addEventListener('keydown', (e) => {
				const i = ORDER.indexOf(stored());
				const next =
					e.key === 'ArrowRight' || e.key === 'ArrowDown'
						? (i + 1) % 3
						: e.key === 'ArrowLeft' || e.key === 'ArrowUp'
							? (i + 2) % 3
							: e.key === 'Home'
								? 0
								: e.key === 'End'
									? 2
									: -1;
				if (next < 0) return;
				e.preventDefault();
				apply(ORDER[next]);
				this.querySelector<HTMLButtonElement>(`.tc__opt[data-value="${ORDER[next]}"]`)?.focus();
			});
		}

		reflect(theme: Theme) {
			this.querySelectorAll<HTMLButtonElement>('.tc__opt').forEach((b) => {
				const on = b.dataset.value === theme;
				b.setAttribute('aria-checked', String(on));
				b.tabIndex = on ? 0 : -1;
			});
		}
	}

	if (!customElements.get('theme-choice')) {
		customElements.define('theme-choice', ThemeChoice);
		// System follows the OS while the page is open.
		matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
			if (stored() === 'auto') document.documentElement.dataset.theme = system();
		});
	}
</script>

<style lang="scss">
	@use '../styles/variables' as *;

	.tc {
		--tc-ink: var(--color-text-secondary);
		--tc-ink-on: var(--color-primary);
		--tc-rule: var(--color-border);
		--tc-on: color-mix(in srgb, var(--color-primary) 12%, transparent);
		--tc-hover: color-mix(in srgb, currentColor 8%, transparent);
		--tc-focus: var(--color-primary);

		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: $spacing-2 $spacing-3;
		color: var(--tc-ink);

		// On the footer's black. Its own shades, at the footer's alphas: 0.64 is the legal links' ink.
		&[data-tone='footer'] {
			--tc-ink: rgba(255, 255, 255, 0.64);
			--tc-ink-on: #fff;
			--tc-rule: rgba(255, 255, 255, 0.2);
			--tc-on: rgba(255, 255, 255, 0.14);
			--tc-hover: rgba(255, 255, 255, 0.06);
			--tc-focus: #8b9bff;
		}
	}

	.tc__label {
		font-size: 13px;
		line-height: 1.4;
	}

	.tc__group {
		display: inline-flex;
		gap: 2px;
		padding: 2px;
		border: 1px solid var(--tc-rule);
		border-radius: $radius-md;
	}

	.tc__opt {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 28px;
		padding: 0 10px;
		border: 0;
		border-radius: $radius-sm;
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 13px;
		line-height: 1;
		white-space: nowrap;
		cursor: pointer;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;

		:global(svg) {
			width: 16px;
			height: 16px;
			flex: none;
		}

		&:hover {
			background: var(--tc-hover);
		}

		&[aria-checked='true'] {
			background: var(--tc-on);
			color: var(--tc-ink-on);
			font-weight: $font-weight-medium;
		}

		&:focus-visible {
			outline: 2px solid var(--tc-focus);
			outline-offset: 1px;
		}
	}
</style>
