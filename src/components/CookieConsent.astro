---
/**
 * The cookie consent: a card in the bottom-left corner of every page and the preferences dialog
 * behind it, mounted once per page from `starlight/SkipLink.astro`.
 *
 * WHAT IT DOES (the compliance side, unchanged since upstream #704): Accept all and Reject all as two
 * equal buttons, Manage preferences for a choice per category (Analytics, Marketing), the choice
 * stored in the `tb_consent` cookie for 180 days and pushed to Google Consent Mode v2. `GtmHead.astro`
 * parses the stored choice into `window.tbConsent` before GTM loads and sets the consent default:
 * keep `CONSENT_COOKIE` / `CONSENT_VERSION` in step with it. Any element with
 * `data-cc="show-preferences"` (the footers' "Cookie settings", the Cookie Policy page) reopens the
 * dialog; the click is delegated on the document so the footers need no script of their own.
 *
 * HOW IT LOOKS: main's card (#704), on the kit. A 340 card 20px in from the bottom-left corner — the
 * bottom-right is the chat launcher's — on the page's own surface, so it follows the theme: "We use
 * cookies" over upstream's sentence and its Cookie Policy link (`ui/Link`), Accept all and Reject all
 * as two equal buttons (`ui/ButtonGroup`), Manage preferences under them (`ui/Button`, tertiary).
 * The words are upstream's, unchanged. The dialog is `ui/Dialog`: the browser's focus trap and
 * Escape, focus back to the opener on close (`util/dialog`), a bottom sheet under 560.
 *
 * THE CHAT LAUNCHER (44, 16px in from the bottom-right corner) has the other corner from a tablet up.
 * On a phone the card takes the width and the launcher lifts above it: the script publishes the
 * card's footprint — its height and its inset — as `--cc-card-h` on the root, which `ChatLauncher`
 * adds to its own inset below 768, 0 once the card has gone.
 *
 * Hidden in print (`print:hidden`, and its own rule for pages without the utility).
 */
import Button from '@components/ui/Button.astro';
import ButtonGroup from '@components/ui/ButtonGroup.astro';
import Dialog from '@components/ui/Dialog.astro';
import Link from '@components/ui/Link.astro';

interface Props {
	/**
	 * Sandbox only: always shown on load, and no choice writes the cookie or reaches GTM, so trying
	 * it never dismisses the real card on the rest of the site.
	 */
	demo?: boolean;
	/** A second instance on one page (the sandbox) needs its own id. */
	id?: string;
}

const { demo = false, id = 'cookie-consent' } = Astro.props;

const POLICY_HREF = '/cookie-policy/';

const categories = [
	{
		id: 'analytics',
		title: 'Analytics',
		description: 'Show us which pages people read and how they find the site, so we can improve it (Google Analytics).',
	},
	{
		id: 'marketing',
		title: 'Marketing',
		description: 'Show us which of our ad campaigns bring visitors to the site (Google Ads).',
	},
];
---

<div class="cc" id={id} data-cc-root data-cc-demo={demo ? '' : undefined} data-pagefind-ignore>
	{/* A `div` with the region role, not a `section`: the homepage strips every section's background. */}
	<div
		class="cc__card print:hidden"
		role="region"
		aria-labelledby={`${id}-title`}
		aria-describedby={`${id}-desc`}
		hidden
	>
		<p class="cc__title" id={`${id}-title`}>
			We use cookies
		</p>
		<p class="cc__text" id={`${id}-desc`}>
			We use cookies to understand how our site is used and to improve it. We never sell your data. You can change your
			choice anytime in Cookie settings.{' '}
			<Link href={POLICY_HREF} variant="inline">
				Cookie Policy
			</Link>
		</p>
		<ButtonGroup equal gap="sm" class="cc__choice">
			<Button attrs={{ 'data-cc': 'accept-all' }}>Accept all</Button>
			<Button variant="secondary" attrs={{ 'data-cc': 'reject-all' }}>
				Reject all
			</Button>
		</ButtonGroup>
		<Button
			variant="tertiary"
			size="sm"
			class="cc__manage"
			attrs={{ 'data-cc': 'show-preferences', 'aria-haspopup': 'dialog' }}
		>
			Manage preferences
		</Button>
	</div>
	{/* Inline and right after the card, so it runs before first paint: a visitor who has chosen never
	    sees it flash, and one who has not sees it with the page, never late as the LCP element. */}
	<script is:inline>
		(function (el) {
			if (el && (el.parentElement.hasAttribute('data-cc-demo') || !window.tbConsent)) el.hidden = false;
		})(document.currentScript && document.currentScript.previousElementSibling);
	</script>
	<Dialog
		id={`${id}-prefs`}
		title="Cookie preferences"
		lede="We use cookies for our own analytics and to see how our campaigns perform. We never sell your data."
		class="cc__dialog"
	>
		<ul class="cc__cats">
			<li class="cc__cat">
				<div class="cc__cat-head">
					<label class="cc__cat-title" for={`${id}-necessary`}>
						Strictly necessary
					</label>
					<input
						type="checkbox"
						role="switch"
						class="cc__switch"
						id={`${id}-necessary`}
						aria-describedby={`${id}-necessary-desc`}
						checked
						disabled
					/>
				</div>
				<p class="cc__cat-desc" id={`${id}-necessary-desc`}>
					Security, load balancing and remembering your cookie choice. These keep the site working and cannot be
					switched off.
				</p>
			</li>
			{categories.map((c) => (
				<li class="cc__cat">
					<div class="cc__cat-head">
						<label class="cc__cat-title" for={`${id}-${c.id}`}>
							{c.title}
						</label>
						<input
							type="checkbox"
							role="switch"
							class="cc__switch"
							id={`${id}-${c.id}`}
							aria-describedby={`${id}-${c.id}-desc`}
							data-category={c.id}
						/>
					</div>
					<p class="cc__cat-desc" id={`${id}-${c.id}-desc`}>
						{c.description}
					</p>
				</li>
			))}
		</ul>
		{/* The link mid-sentence, with a word after it: a full stop right after the link would gain the
		    whitespace Prettier puts between the link and the text (the `DocsNotice` lesson). */}
		<p class="cc__note">
			Our{' '}
			<Link variant="inline" tone="ink" href={POLICY_HREF}>
				Cookie Policy
			</Link>{' '}
			lists every cookie we set and what each one does.
		</p>
		{/* Reject all and Accept all as the pair they are on the card; Save at the end of the row, for the
		    reader who used the switches. Under 480 (the sheet) the three stack. */}
		<ButtonGroup slot="footer" stackBelow={480} gap="sm" class="cc__dialog-actions">
			<Button variant="secondary" attrs={{ 'data-cc': 'reject-all' }}>
				Reject all
			</Button>
			<Button attrs={{ 'data-cc': 'accept-all' }}>Accept all</Button>
			<Button variant="secondary" class="cc__save" attrs={{ 'data-cc': 'save' }}>
				Save preferences
			</Button>
		</ButtonGroup>
	</Dialog>
</div>

<script>
	import { openDialog } from '@util/dialog';

	const CONSENT_COOKIE = 'tb_consent';
	const CONSENT_VERSION = 1;
	const MAX_AGE_SECONDS = 180 * 24 * 60 * 60;
	/** The card's footprint while it shows — its height and its inset — for the chat launcher above it on a phone. */
	const CARD_FOOT_VAR = '--cc-card-h';
	const CARD_INSET = 20;
	const LEAVE_MS = 160;

	type Category = 'analytics' | 'marketing';
	type Action = 'accept-all' | 'reject-all' | 'save' | 'show-preferences';

	const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

	function mount(root: HTMLElement) {
		const demo = root.hasAttribute('data-cc-demo');
		const card = root.querySelector<HTMLElement>('.cc__card')!;
		const dialog = root.querySelector<HTMLDialogElement>('dialog')!;
		const switches = [...dialog.querySelectorAll<HTMLInputElement>('input[data-category]')];
		// The sandbox's instance keeps its choice to itself; the page's is `window.tbConsent`.
		let demoConsent: TbConsent | null = null;
		const current = () => (demo ? demoConsent : window.tbConsent);

		// The card's footprint, published while it shows, 0 once it has gone. The page's instance only:
		// several sandbox instances would fight over the one variable.
		if (!demo) {
			const publish = () =>
				document.documentElement.style.setProperty(
					CARD_FOOT_VAR,
					`${card.hidden || card.hasAttribute('data-cc-leaving') ? 0 : card.getBoundingClientRect().height + CARD_INSET}px`
				);
			publish();
			new ResizeObserver(publish).observe(card);
		}

		function hideCard() {
			if (card.hidden) return;
			const done = () => {
				card.hidden = true;
				card.removeAttribute('data-cc-leaving');
			};
			if (reducedMotion.matches) return done();
			card.setAttribute('data-cc-leaving', '');
			setTimeout(done, LEAVE_MS);
		}

		function saveConsent(analytics: boolean, marketing: boolean) {
			const consent: TbConsent = { v: CONSENT_VERSION, analytics, marketing };
			if (demo) {
				demoConsent = consent;
			} else {
				window.tbConsent = consent;
				const secure = location.protocol === 'https:' ? '; Secure' : '';
				document.cookie = `${CONSENT_COOKIE}=${encodeURIComponent(JSON.stringify(consent))}; max-age=${MAX_AGE_SECONDS}; path=/; SameSite=Lax${secure}`;

				const ads = marketing ? 'granted' : 'denied';
				window.gtag('consent', 'update', {
					analytics_storage: analytics ? 'granted' : 'denied',
					ad_storage: ads,
					ad_user_data: ads,
					// Never granted — see GtmHead.astro.
					ad_personalization: 'denied',
				});
			}

			if (dialog.open) dialog.close();
			hideCard();
		}

		function showPreferences(opener: HTMLElement | null) {
			const consent = current();
			switches.forEach((s) => (s.checked = consent?.[s.dataset.category as Category] ?? false));
			openDialog(dialog, { opener });
		}

		const choice = (id: Category) => switches.find((s) => s.dataset.category === id)?.checked ?? false;
		const actions: Record<Action, (opener: HTMLElement | null) => void> = {
			'accept-all': () => saveConsent(true, true),
			'reject-all': () => saveConsent(false, false),
			save: () => saveConsent(choice('analytics'), choice('marketing')),
			'show-preferences': showPreferences,
		};

		return { demo, run: (action: Action, opener: HTMLElement | null) => actions[action]?.(opener) };
	}

	const instances = new Map<HTMLElement, ReturnType<typeof mount>>();
	document.querySelectorAll<HTMLElement>('[data-cc-root]').forEach((root) => instances.set(root, mount(root)));
	const page = [...instances.values()].find((i) => !i.demo);

	// Delegated on the document so the footers' "Cookie settings" and the Cookie Policy page reach the
	// dialog too. A trigger inside an instance (the card's or the dialog's own buttons) drives that
	// instance; one anywhere else drives the page's.
	document.addEventListener('click', (e) => {
		const trigger = (e.target as Element).closest<HTMLElement>('[data-cc]');
		if (!trigger) return;
		const root = trigger.closest<HTMLElement>('[data-cc-root]');
		const instance = root ? instances.get(root) : page;
		if (!instance) return;
		e.preventDefault();
		instance.run(trigger.dataset.cc as Action, trigger);
	});
</script>

<style is:global lang="scss">
	// Link-styled "Cookie settings" trigger used in the footers in use and on the Cookie Policy page.
	.cookie-settings {
		padding: 0;
		font: inherit;
		color: inherit;
		text-decoration: underline;
		background: none;
		border: none;
		cursor: pointer;
	}
</style>

<style lang="scss">
	@use '../styles/variables' as *;

	// ---- The card ---------------------------------------------------------------------------
	//
	// Main's card, on the kit's tokens: the page's surface and text, the hairline and the panel's lift,
	// so it is a light card on a light page and a dark one on a dark page. 20px in from the corner (the
	// home indicator's inset added on a phone), never taller than the window less its insets.
	.cc__card {
		position: fixed;
		left: 20px;
		bottom: calc(20px + env(safe-area-inset-bottom, 0px));
		z-index: $z-modal; // the chat launcher sits above, at the 32-bit maximum
		display: flex;
		flex-direction: column;
		gap: $spacing-3;
		box-sizing: border-box;
		width: min(340px, calc(100vw - 40px));
		max-height: calc(100dvh - 40px);
		overflow-y: auto;
		padding: $spacing-5 $spacing-5 $spacing-3;
		font-family: var(--font-family, $font-family-base);
		color: var(--color-text, #17181c);
		background: var(--color-bg-surface, #fff);
		border: 1px solid var(--color-border, #e5e7eb);
		border-radius: $radius-lg;
		box-shadow: var(--elev-panel);
		animation: cc-in 200ms cubic-bezier(0.2, 0.7, 0.2, 1) both;

		&[hidden] {
			display: none;
		}

		&[data-cc-leaving] {
			animation: cc-out 160ms ease-in forwards;
		}

		@media (prefers-reduced-motion: reduce) {
			animation: none;
		}

		@media print {
			display: none;
		}
	}

	@keyframes cc-in {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
	}

	@keyframes cc-out {
		to {
			opacity: 0;
			transform: translateY(8px);
		}
	}

	.cc__title {
		@include type-tile-lg;
		margin: 0;
	}

	.cc__text {
		@include type-small;
		margin: 0;
		text-wrap: pretty;
	}

	.cc__choice {
		margin-top: $spacing-1;
	}

	.cc__manage {
		align-self: center;
	}

	// ---- The dialog -------------------------------------------------------------------------

	.cc__cats {
		display: grid;
		gap: $spacing-2;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	// One category: its name and switch on a line, its line under them, on the page's light ground.
	.cc__cat {
		padding: $spacing-3 $spacing-4;
		border-radius: $radius-lg;
		background: var(--color-bg-light, #f4f5f7);
	}

	.cc__cat-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: $spacing-4;
	}

	.cc__cat-title {
		@include type-tile;
		line-height: 24px;
		color: var(--color-text, #17181c);
		cursor: pointer;
	}

	.cc__cat-desc {
		@include type-small;
		margin: $spacing-1 0 0;
		color: var(--color-text-secondary, #63656c);
	}

	// The switch: a 44 × 24 track, the knob 20. Off, the track is the field's edge grey (#868d9a, 3:1
	// on white); on, the scheme's fill with the knob in its on-fill. The ring from the ground, as
	// every control's.
	.cc__switch {
		--_track: #868d9a;
		--_knob: #fff;

		position: relative;
		flex: none;
		box-sizing: border-box;
		width: 44px;
		height: 24px;
		margin: 0;
		appearance: none;
		background: var(--_track);
		border: 0;
		border-radius: $radius-full;
		cursor: pointer;
		transition: background-color 0.2s ease;

		&::after {
			content: '';
			position: absolute;
			top: 2px;
			left: 2px;
			width: 20px;
			height: 20px;
			background: var(--_knob);
			border-radius: 50%;
			box-shadow: 0 1px 2px rgba(16, 24, 40, 0.24);
			transition: transform 0.2s ease;
		}

		&:checked {
			--_track: var(--accent-fill, #3d50f5);
			--_knob: var(--accent-on-fill, #fff);

			&::after {
				transform: translateX(20px);
			}
		}

		&:disabled {
			opacity: 0.5;
			cursor: not-allowed;
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 3px;
		}

		@media (prefers-reduced-motion: reduce) {
			transition: none;

			&::after {
				transition: none;
			}
		}

		@media (forced-colors: active) {
			border: 1px solid ButtonText;

			&::after {
				background: ButtonText;
			}
		}
	}

	.cc__note {
		@include type-small;
		margin: $spacing-4 0 0;
		color: var(--color-text-secondary, #63656c);
	}

	// Save at the end of the row, apart from the pair. In the sheet's column every button is the row.
	.cc__save {
		margin-inline-start: auto;
	}
</style>
