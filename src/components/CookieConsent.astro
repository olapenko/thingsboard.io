---
/**
 * The cookie consent: an indigo bar at the foot of every page and the preferences dialog behind it,
 * mounted once per page from `starlight/SkipLink.astro`.
 *
 * WHAT IT DOES (the compliance side, unchanged since upstream #704): Accept all and Reject all as two
 * equal buttons, Manage preferences for a choice per category (Analytics, Marketing), the choice
 * stored in the `tb_consent` cookie for 180 days and pushed to Google Consent Mode v2. `GtmHead.astro`
 * parses the stored choice into `window.tbConsent` before GTM loads and sets the consent default:
 * keep `CONSENT_COOKIE` / `CONSENT_VERSION` in step with it. Any element with
 * `data-cc="show-preferences"` (the footers' "Cookie settings", the Cookie Policy page) reopens the
 * dialog; the click is delegated on the document so the footers need no script of their own.
 *
 * HOW IT LOOKS (the redesign's `CookieNotice`, folded in here 2026-10-04): the bar edge to edge on the
 * bookends' indigo, "Cookie policy ›" as the heading and the one link to the policy (`ui/Link`, ink on
 * dark), one short sentence at 13/20 — a step under the ladder's 14px floor, for chrome rather than
 * page — and the actions in `ui/Button`: Manage preferences as a tertiary, Reject all and Accept all
 * equal in a `ui/ButtonGroup`. `data-surface="dark"` on the bar gives the kit its dark tones and the
 * yellow ring. The dialog is `ui/Dialog`: the browser's focus trap and Escape, focus back to the
 * opener on close (`util/dialog`), a bottom sheet under 560.
 *
 * THE CHAT LAUNCHER shares the foot of the window (44, 16px in from the bottom-right corner). From a
 * tablet up the bar's copy stops 90px short of the right edge — the launcher's 44 and 16 and 30
 * clear — and the launcher is centred on the button row (16 + 44 + 16) while the bar is up. On a
 * phone the bar takes the whole width and the launcher lifts above it instead: the script publishes
 * the bar's height as `--cc-bar-h` on the root, which `ChatLauncher` adds to its inset below 768.
 *
 * Hidden in print (`print:hidden`, and its own rule for pages without the utility).
 */
import Button from '@components/ui/Button.astro';
import ButtonGroup from '@components/ui/ButtonGroup.astro';
import Dialog from '@components/ui/Dialog.astro';
import Link from '@components/ui/Link.astro';

interface Props {
	/**
	 * Sandbox only: always shown on load, and no choice writes the cookie or reaches GTM, so trying
	 * it never dismisses the real bar on the rest of the site.
	 */
	demo?: boolean;
	/** A second instance on one page (the sandbox) needs its own id. */
	id?: string;
}

const { demo = false, id = 'cookie-consent' } = Astro.props;

const POLICY_HREF = '/cookie-policy/';

const categories = [
	{
		id: 'analytics',
		title: 'Analytics',
		description: 'Show us which pages people read and how they find the site, so we can improve it (Google Analytics).',
	},
	{
		id: 'marketing',
		title: 'Marketing',
		description: 'Show us which of our ad campaigns bring visitors to the site (Google Ads).',
	},
];
---

<div class="cc" id={id} data-cc-root data-cc-demo={demo ? '' : undefined} data-pagefind-ignore>
	{/* A `div` with the region role, not a `section`: the homepage strips every section's background. */}
	<div
		class="cc__bar print:hidden"
		role="region"
		data-surface="dark"
		data-accent="brand"
		aria-labelledby={`${id}-title`}
		aria-describedby={`${id}-desc`}
		hidden
	>
		<div class="cc__in">
			<div class="cc__copy">
				{/* The heading IS the link to the policy: one link to the page, not one in the heading and one in the sentence. */}
				<p class="cc__title" id={`${id}-title`}>
					<Link href={POLICY_HREF} tone="ink">
						Cookie policy
					</Link>
				</p>
				<p class="cc__text" id={`${id}-desc`}>
					We use cookies to understand how our site is used and to improve it. We never sell your data. You can change
					your choice anytime in Cookie settings.
				</p>
			</div>
			<div class="cc__actions">
				<Button
					variant="tertiary"
					size={{ base: 'sm', md: 'md' }}
					class="cc__manage"
					attrs={{ 'data-cc': 'show-preferences', 'aria-haspopup': 'dialog' }}
				>
					Manage preferences
				</Button>
				<ButtonGroup equal gap="sm" class="cc__choice">
					<Button variant="secondary" attrs={{ 'data-cc': 'reject-all' }}>
						Reject all
					</Button>
					<Button attrs={{ 'data-cc': 'accept-all' }}>Accept all</Button>
				</ButtonGroup>
			</div>
		</div>
	</div>
	{/* Inline and right after the bar, so it runs before first paint: a visitor who has chosen never
	    sees it flash, and one who has not sees it with the page, never late as the LCP element. */}
	<script is:inline>
		(function (el) {
			if (el && (el.parentElement.hasAttribute('data-cc-demo') || !window.tbConsent)) el.hidden = false;
		})(document.currentScript && document.currentScript.previousElementSibling);
	</script>
	<Dialog
		id={`${id}-prefs`}
		title="Cookie preferences"
		lede="We use cookies for our own analytics and to see how our campaigns perform. We never sell your data."
		class="cc__dialog"
	>
		<ul class="cc__cats">
			<li class="cc__cat">
				<div class="cc__cat-head">
					<label class="cc__cat-title" for={`${id}-necessary`}>
						Strictly necessary
					</label>
					<input
						type="checkbox"
						role="switch"
						class="cc__switch"
						id={`${id}-necessary`}
						aria-describedby={`${id}-necessary-desc`}
						checked
						disabled
					/>
				</div>
				<p class="cc__cat-desc" id={`${id}-necessary-desc`}>
					Security, load balancing and remembering your cookie choice. These keep the site working and cannot be
					switched off.
				</p>
			</li>
			{categories.map((c) => (
				<li class="cc__cat">
					<div class="cc__cat-head">
						<label class="cc__cat-title" for={`${id}-${c.id}`}>
							{c.title}
						</label>
						<input
							type="checkbox"
							role="switch"
							class="cc__switch"
							id={`${id}-${c.id}`}
							aria-describedby={`${id}-${c.id}-desc`}
							data-category={c.id}
						/>
					</div>
					<p class="cc__cat-desc" id={`${id}-${c.id}-desc`}>
						{c.description}
					</p>
				</li>
			))}
		</ul>
		{/* The link mid-sentence, with a word after it: a full stop right after the link would gain the
		    whitespace Prettier puts between the link and the text (the `DocsNotice` lesson). */}
		<p class="cc__note">
			Our{' '}
			<Link variant="inline" tone="ink" href={POLICY_HREF}>
				Cookie Policy
			</Link>{' '}
			lists every cookie we set and what each one does.
		</p>
		{/* Reject all and Accept all as the pair they are in the bar; Save at the end of the row, for the
		    reader who used the switches. Under 480 (the sheet) the three stack. */}
		<ButtonGroup slot="footer" stackBelow={480} gap="sm" class="cc__dialog-actions">
			<Button variant="secondary" attrs={{ 'data-cc': 'reject-all' }}>
				Reject all
			</Button>
			<Button attrs={{ 'data-cc': 'accept-all' }}>Accept all</Button>
			<Button variant="secondary" class="cc__save" attrs={{ 'data-cc': 'save' }}>
				Save preferences
			</Button>
		</ButtonGroup>
	</Dialog>
</div>

<script>
	import { openDialog } from '@util/dialog';

	const CONSENT_COOKIE = 'tb_consent';
	const CONSENT_VERSION = 1;
	const MAX_AGE_SECONDS = 180 * 24 * 60 * 60;
	/** The bar's height while it shows, for whatever shares the foot of the window (`ChatLauncher`). */
	const BAR_HEIGHT_VAR = '--cc-bar-h';
	const LEAVE_MS = 160;

	type Category = 'analytics' | 'marketing';
	type Action = 'accept-all' | 'reject-all' | 'save' | 'show-preferences';

	const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

	function mount(root: HTMLElement) {
		const demo = root.hasAttribute('data-cc-demo');
		const bar = root.querySelector<HTMLElement>('.cc__bar')!;
		const dialog = root.querySelector<HTMLDialogElement>('dialog')!;
		const switches = [...dialog.querySelectorAll<HTMLInputElement>('input[data-category]')];
		// The sandbox's instance keeps its choice to itself; the page's is `window.tbConsent`.
		let demoConsent: TbConsent | null = null;
		const current = () => (demo ? demoConsent : window.tbConsent);

		// The bar's height, published while it shows, 0 once it has gone. The page's instance only:
		// several sandbox instances would fight over the one variable.
		if (!demo) {
			const publish = () =>
				document.documentElement.style.setProperty(
					BAR_HEIGHT_VAR,
					`${bar.hidden || bar.hasAttribute('data-cc-leaving') ? 0 : bar.getBoundingClientRect().height}px`
				);
			publish();
			new ResizeObserver(publish).observe(bar);
		}

		function hideBar() {
			if (bar.hidden) return;
			const done = () => {
				bar.hidden = true;
				bar.removeAttribute('data-cc-leaving');
			};
			if (reducedMotion.matches) return done();
			bar.setAttribute('data-cc-leaving', '');
			setTimeout(done, LEAVE_MS);
		}

		function saveConsent(analytics: boolean, marketing: boolean) {
			const consent: TbConsent = { v: CONSENT_VERSION, analytics, marketing };
			if (demo) {
				demoConsent = consent;
			} else {
				window.tbConsent = consent;
				const secure = location.protocol === 'https:' ? '; Secure' : '';
				document.cookie = `${CONSENT_COOKIE}=${encodeURIComponent(JSON.stringify(consent))}; max-age=${MAX_AGE_SECONDS}; path=/; SameSite=Lax${secure}`;

				const ads = marketing ? 'granted' : 'denied';
				window.gtag('consent', 'update', {
					analytics_storage: analytics ? 'granted' : 'denied',
					ad_storage: ads,
					ad_user_data: ads,
					// Never granted — see GtmHead.astro.
					ad_personalization: 'denied',
				});
			}

			if (dialog.open) dialog.close();
			hideBar();
		}

		function showPreferences(opener: HTMLElement | null) {
			const consent = current();
			switches.forEach((s) => (s.checked = consent?.[s.dataset.category as Category] ?? false));
			openDialog(dialog, { opener });
		}

		const choice = (id: Category) => switches.find((s) => s.dataset.category === id)?.checked ?? false;
		const actions: Record<Action, (opener: HTMLElement | null) => void> = {
			'accept-all': () => saveConsent(true, true),
			'reject-all': () => saveConsent(false, false),
			save: () => saveConsent(choice('analytics'), choice('marketing')),
			'show-preferences': showPreferences,
		};

		return { demo, run: (action: Action, opener: HTMLElement | null) => actions[action]?.(opener) };
	}

	const instances = new Map<HTMLElement, ReturnType<typeof mount>>();
	document.querySelectorAll<HTMLElement>('[data-cc-root]').forEach((root) => instances.set(root, mount(root)));
	const page = [...instances.values()].find((i) => !i.demo);

	// Delegated on the document so the footers' "Cookie settings" and the Cookie Policy page reach the
	// dialog too. A trigger inside an instance (the bar's or the dialog's own buttons) drives that
	// instance; one anywhere else drives the page's.
	document.addEventListener('click', (e) => {
		const trigger = (e.target as Element).closest<HTMLElement>('[data-cc]');
		if (!trigger) return;
		const root = trigger.closest<HTMLElement>('[data-cc-root]');
		const instance = root ? instances.get(root) : page;
		if (!instance) return;
		e.preventDefault();
		instance.run(trigger.dataset.cc as Action, trigger);
	});
</script>

<style is:global lang="scss">
	// Link-styled "Cookie settings" trigger used in the footers in use and on the Cookie Policy page.
	.cookie-settings {
		padding: 0;
		font: inherit;
		color: inherit;
		text-decoration: underline;
		background: none;
		border: none;
		cursor: pointer;
	}
</style>

<style lang="scss">
	@use '../styles/variables' as *;

	// ---- The bar ----------------------------------------------------------------------------
	//
	// Solid on the bookends' indigo (`--band-indigo`, #121425), not black, so the brand-blue button sits
	// on a ground of its own family; the copy is white at 78%, 11:1 on it. The same in both themes:
	// it is chrome, and the dark theme's page (#141517) sits close enough that the hairline on top is
	// what separates them there.
	.cc__bar {
		--cc-ground: var(--band-indigo, #121425);
		--cc-text: #fff;
		--cc-muted: rgba(255, 255, 255, 0.78);
		--cc-edge: rgba(255, 255, 255, 0.12);

		// No `display` here: the UA's `[hidden] { display: none }` is what hides it, and an author
		// display on this element would beat it.
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 9999; // the chat launcher sits above, at the 32-bit maximum
		box-sizing: border-box;
		font-family: var(--font-family, $font-family-base);
		color: var(--cc-text);
		background: var(--cc-ground);
		border-top: 1px solid var(--cc-edge);
		box-shadow: 0 -8px 24px -16px rgba(16, 24, 40, 0.3);
		animation: cc-in 200ms cubic-bezier(0.2, 0.7, 0.2, 1) both;

		&[data-cc-leaving] {
			animation: cc-out 160ms ease-in forwards;
		}

		@media (prefers-reduced-motion: reduce) {
			animation: none;
		}

		@media print {
			display: none;
		}
	}

	@keyframes cc-in {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
	}

	@keyframes cc-out {
		to {
			opacity: 0;
			transform: translateY(8px);
		}
	}

	// The redesigned pages' measure (`--band-gutter`: 960 inside 20px gutters, centred), but never
	// closer than 90px to the right edge: the launcher's 44 and its 16px inset, and 30 clear of it. At
	// 1440 the gutter is 240 and the bar is symmetric; on a docs page past the sidebar it is 90 either
	// side; at 1024 the right holds 90 and the line gives up the difference.
	//
	// Bottom-aligned, not centred: the buttons then sit 16 up whatever the sentence wraps to, and the
	// launcher (44, 16 up) is centred on their row.
	.cc__in {
		display: flex;
		align-items: flex-end;
		gap: $spacing-8;
		padding: $spacing-4 max(90px, var(--band-gutter)) $spacing-4 var(--band-gutter);
	}

	.cc__copy {
		flex: 1;
		min-width: 0;
	}

	.cc__title {
		margin: 0;
	}

	// The ladder's `type-small` is 14/22, the floor for page text; a notice that is chrome rather than
	// page takes one step under it, 13/20, as the redesign's notice did.
	.cc__text {
		@include type-small;
		margin: $spacing-1 0 0;
		font-size: 13px;
		line-height: 20px;
		color: var(--cc-muted);
		text-wrap: pretty;
	}

	.cc__actions {
		flex: none;
		display: flex;
		align-items: center;
		gap: $spacing-2;
	}

	// A phone: three rows — the heading with Manage preferences (at 40) at the end of its line, the
	// sentence, the pair full width — 192px of an 812px screen; stacked, the actions alone were 100.
	// The two wrappers give up their boxes so the grid places the four pieces. The home indicator's
	// inset under it all. The launcher lifts above the bar here.
	@include media-down(md) {
		.cc__in {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto;
			grid-template-areas:
				'title manage'
				'text text'
				'choice choice';
			align-items: center;
			gap: 0 $spacing-3;
			padding: $spacing-4 $spacing-4 calc(#{$spacing-4} + env(safe-area-inset-bottom, 0px));
		}

		.cc__copy,
		.cc__actions {
			display: contents;
		}

		.cc__title {
			grid-area: title;
		}

		// Its label on the pair's right edge: the button's own side padding, taken back.
		.cc__manage {
			grid-area: manage;
			margin-inline-end: calc(-1 * var(--btn-px));
		}

		.cc__text {
			grid-area: text;
		}

		.cc__choice {
			grid-area: choice;
			margin-top: $spacing-3;
		}
	}

	// Docs pages: past 72rem Starlight draws the sidebar, and the bar starts where the page does.
	@media (min-width: 72rem) {
		:global(html[data-has-sidebar]) .cc__bar {
			left: var(--sl-sidebar-width);
		}
	}

	// ---- The dialog -------------------------------------------------------------------------

	.cc__cats {
		display: grid;
		gap: $spacing-2;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	// One category: its name and switch on a line, its line under them, on the page's light ground.
	.cc__cat {
		padding: $spacing-3 $spacing-4;
		border-radius: $radius-lg;
		background: var(--color-bg-light, #f4f5f7);
	}

	.cc__cat-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: $spacing-4;
	}

	.cc__cat-title {
		@include type-tile;
		line-height: 24px;
		color: var(--color-text, #17181c);
		cursor: pointer;
	}

	.cc__cat-desc {
		@include type-small;
		margin: $spacing-1 0 0;
		color: var(--color-text-secondary, #63656c);
	}

	// The switch: a 44 × 24 track, the knob 20. Off, the track is the field's edge grey (#868d9a, 3:1
	// on white); on, the scheme's fill with the knob in its on-fill. The ring from the ground, as
	// every control's.
	.cc__switch {
		--_track: #868d9a;
		--_knob: #fff;

		position: relative;
		flex: none;
		box-sizing: border-box;
		width: 44px;
		height: 24px;
		margin: 0;
		appearance: none;
		background: var(--_track);
		border: 0;
		border-radius: $radius-full;
		cursor: pointer;
		transition: background-color 0.2s ease;

		&::after {
			content: '';
			position: absolute;
			top: 2px;
			left: 2px;
			width: 20px;
			height: 20px;
			background: var(--_knob);
			border-radius: 50%;
			box-shadow: 0 1px 2px rgba(16, 24, 40, 0.24);
			transition: transform 0.2s ease;
		}

		&:checked {
			--_track: var(--accent-fill, #3d50f5);
			--_knob: var(--accent-on-fill, #fff);

			&::after {
				transform: translateX(20px);
			}
		}

		&:disabled {
			opacity: 0.5;
			cursor: not-allowed;
		}

		&:focus-visible {
			outline: 2px solid var(--focus-ring);
			outline-offset: 3px;
		}

		@media (prefers-reduced-motion: reduce) {
			transition: none;

			&::after {
				transition: none;
			}
		}

		@media (forced-colors: active) {
			border: 1px solid ButtonText;

			&::after {
				background: ButtonText;
			}
		}
	}

	.cc__note {
		@include type-small;
		margin: $spacing-4 0 0;
		color: var(--color-text-secondary, #63656c);
	}

	// Save at the end of the row, apart from the pair. In the sheet's column every button is the row.
	.cc__save {
		margin-inline-start: auto;
	}
</style>
