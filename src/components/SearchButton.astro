---
/**
 * The bar's search control: ONE CONTROL AT TWO SIZES. The 40px box with the magnifier — stroked
 * like Sign in beside it, no label — wherever the row is tight, and from `$search-field-from` the
 * field: the magnifier, "Search" and the key hint inside the same stroke, 152 wide.
 *
 * The room decides, not the page. The menu's row packs beside the wordmark and the cluster keeps its
 * width, so the field — 112 more than the box — goes where the slack between the row's last item and
 * the cluster clears the row's 16px floor with the field in it. Measured on the dev server with the
 * nine items, the 160 wordmark, the star count, Sign in and Try for free: the row and the field first
 * fit unsqueezed at about 1530; 1540 keeps a margin. (With the nav centred it was 1480.)
 *
 * It opens `SiteSearch`, rendered once by the bar, which also wires the keys it advertises: ⌘K or
 * Ctrl K anywhere, `/` outside a text field. Below the field they still work; they are just not shown.
 */
---

<search-button>
	<button type="button" class="search-toggle-btn" aria-label="Search" aria-keyshortcuts="Control+K Meta+K /">
		<svg
			width="20"
			height="20"
			viewBox="0 0 20 20"
			fill="none"
			stroke="currentColor"
			stroke-linecap="round"
			stroke-linejoin="round"
			stroke-width="2"
			aria-hidden="true"
		>
			<path d="M14.386 14.386l4.0877 4.0877-4.0877-4.0877c-2.9418 2.9419-7.7115 2.9419-10.6533 0-2.9419-2.9418-2.9419-7.7115 0-10.6533 2.9418-2.9419 7.7115-2.9419 10.6533 0 2.9419 2.9418 2.9419 7.7115 0 10.6533z"></path>
		</svg>
		<span class="search-toggle-btn__label" aria-hidden="true">
			Search
		</span>
		{/* "Ctrl K" from the server, most readers; Apple devices get "⌘K" once the script runs. */}
		<kbd class="search-toggle-btn__kbd" aria-hidden="true">
			Ctrl K
		</kbd>
	</button>
</search-button>

<style lang="scss">
	@use '../styles/variables' as *;

	$search-field-from: 1540px;

	// Sign in's values, so the two read as one row: 40px, 4px corners, the ink at 35% for the stroke,
	// 12% fill and 55% on hover. `currentColor` throughout, so it follows the bar through white over a
	// hero, the ink once scrolled, and dark.
	.search-toggle-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
		border-radius: $radius-sm;
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 14px;
		line-height: 1;
		white-space: nowrap;
		cursor: pointer;
		transition:
			background-color 0.15s ease,
			border-color 0.15s ease;

		&:hover,
		&:focus-visible {
			background-color: color-mix(in srgb, currentColor 12%, transparent);
			border-color: color-mix(in srgb, currentColor 55%, transparent);
		}

		&:focus-visible {
			outline: 2px solid currentColor;
			outline-offset: 3px;
		}

		svg {
			width: 20px;
			height: 20px;
			flex: none;
		}
	}

	.search-toggle-btn__label,
	.search-toggle-btn__kbd {
		display: none;
	}

	// The field, where the row has the room.
	@media screen and (min-width: $search-field-from) {
		.search-toggle-btn {
			width: 152px;
			justify-content: flex-start;
			padding: 0 8px 0 12px;

			svg {
				width: 16px;
				height: 16px;
				opacity: 0.8;
			}
		}

		.search-toggle-btn__label {
			display: inline;
			opacity: 0.8;
		}

		.search-toggle-btn__kbd {
			display: inline-flex;
			margin-left: auto;
			padding: 3px 5px;
			border: 1px solid color-mix(in srgb, currentColor 28%, transparent);
			border-radius: 3px;
			font: inherit;
			font-size: 11.5px;
			line-height: 1;
			opacity: 0.8;
		}
	}
</style>
