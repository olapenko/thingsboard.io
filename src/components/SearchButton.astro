---
import { Icon } from 'astro-icon/components';
import Kbd from '@components/ui/Kbd.astro';

/**
 * The bar's search control: ONE CONTROL AT TWO SIZES. The 40px box with the magnifier — the kit's
 * secondary at the bar's 40, as Sign in beside it, no label — wherever the row is tight, and from
 * `$search-field-from` the field: the magnifier, "Search" and the key hint inside the same stroke,
 * 152 wide.
 *
 * The room decides, not the page. The menu's row packs beside the wordmark and the cluster keeps its
 * width, so the field — 112 more than the box — goes where the slack between the row's last item and
 * the cluster clears the row's 16px floor with the field in it. Measured on the dev server with the
 * seven items (since 2026-10-05; nine before, when it took 1540), the 160 wordmark, Sign in and Try
 * for free: at 1281, where the row starts, and at 1340, where the star count comes back, 169px lie
 * between the row and the cluster, 41 to spare with the field in. So the field shows wherever the
 * row does.
 *
 * It opens `SiteSearch`, rendered once by the bar, which also wires the keys it advertises: ⌘K or
 * Ctrl K anywhere, `/` outside a text field. Below the field they still work; they are just not shown.
 *
 * On the kit (2026-10-07): the `ui-button` mixin rather than `ui/Button`, since the label and the
 * hint show only at the field's width, which the component does not express. Its dark look comes
 * with `data-surface` on the cluster (`HeaderScrollWatch`), so the style is global, as the kit's are.
 */
---

<search-button>
	<button type="button" class="search-toggle-btn" aria-label="Search" aria-keyshortcuts="Control+K Meta+K /">
		{/* Tabler's magnifier, the kit's icon set (2026-10-07; a hand-drawn one before). */}
		<Icon name="tabler:search" aria-hidden="true" />
		<span class="search-toggle-btn__label" aria-hidden="true">
			Search
		</span>
		{/* "Ctrl K" from the server, most readers; Apple devices get "⌘K" once the script runs. */}
		<Kbd class="search-toggle-btn__kbd">Ctrl K</Kbd>
	</button>
</search-button>

<style lang="scss" is:global>
	@use '../styles/variables' as *;
	@use '../styles/button' as *;

	$search-field-from: $menu-row-from;

	// The kit's secondary at the bar's 40, regular, as Sign in, Menu and the star count are: one
	// corner, one stroke, one hover across the cluster, and the dark look from `data-surface`.
	.search-toggle-btn {
		@include ui-button(secondary, sm);

		--btn-px: 0px;

		width: 40px;
		font-weight: $font-weight-normal;

		svg {
			width: 20px;
			height: 20px;
			flex: none;
		}
	}

	.search-toggle-btn__label,
	.search-toggle-btn__kbd {
		display: none;
	}

	// The field, where the row has the room.
	@media screen and (min-width: $search-field-from) {
		// 12 before the magnifier, 8 after the hint: the box reads as a field, its hint at the edge.
		.search-toggle-btn {
			width: 152px;
			justify-content: flex-start;
			padding: 0 8px 0 12px;

			svg {
				width: 16px;
				height: 16px;
				opacity: 0.8;
			}
		}

		.search-toggle-btn__label {
			display: inline;
			opacity: 0.8;
		}

		.search-toggle-btn__kbd {
			display: inline-flex;
			margin-left: auto;
		}
	}
</style>
