---
import DocLink from '@components/DocLink.astro';
import { SOURCE_AVAILABLE_FROM_VER } from '@data/versions';
import { Products } from '@models/site.models';

/**
 * In-content product callout, authored inline in MDX.
 *
 * Sibling component: `src/components/starlight/Banner.astro` fills Starlight's
 * `Banner` slot with route-level announcements the page never asks for. Rule of
 * thumb — reach for this one to annotate a passage, that one to announce
 * something about the page's edition. The two share a visual language (accent
 * per variant, tinted wash, accent link); keep them in step when restyling.
 */
type Variant = 'peFeature' | 'ce' | 'pe' | 'cloud' | 'trendz';

interface Props {
	/** Banner color variant:
	 *  'peFeature' — green, renders only on CE pages. Marks a feature Community Edition
	 *    lacks but ThingsBoard {@link SOURCE_AVAILABLE_FROM_VER}+ and Cloud have — from
	 *    that release CE and PE are one product, so there is no "Professional" edition to
	 *    name. Links the page's `/docs/pe/` twin, labelled with that version, and the Cloud
	 *    installation page. It names no Community Grant: the grant leaves out integrations,
	 *    the scheduler, reporting and white-labeling (the paid Professional Pack adds them),
	 *    so "free with the grant" would be wrong on most callers; the CE docs notice
	 *    (`@data/docsAnnouncements`) links the program already;
	 *  'ce' | 'pe' | 'cloud' | 'trendz' — matching product color, always renders. */
	variant: Variant;
	/** Current product context. Required for variant='peFeature'. */
	product?: Products;
	/** Path of the corresponding `/docs/pe/` page (without leading/trailing slash) — the
	 *  current product's docs, linked from the version. Defaults to 'installation'.
	 *  Ignored when a default slot is provided (the slot replaces the standard sentence). */
	path?: string;
	/** What the `peFeature` sentence names in place of "This feature", e.g. 'AI Assistant'.
	 *  Prefer it to a slot override, which copies the licensing sentence into the page. */
	feature?: string;
}

const { variant, product, path, feature = 'This feature' } = Astro.props;

const show = variant === 'peFeature' ? product === Products.CE : true;
const linkPath = path || 'installation';
// A slot override replaces the default `peFeature` sentence (rather than appending to it),
// so callers can substitute custom wording while keeping the same color/visibility logic.
const hasSlotOverride = Astro.slots.has('default');
---

{show && (
	<aside class="tb-banner" data-variant={variant}>
		<div class="tb-banner-content">
			<p>
				{hasSlotOverride ? (
					<slot />
				) : variant === 'peFeature' ? (
					<>{feature} is not part of Community Edition. It is available in <DocLink product={Products.PE} path={linkPath} target="_blank">ThingsBoard {SOURCE_AVAILABLE_FROM_VER}</DocLink> and later, and in <a href="/installations/?product=thingsboard-cloud" target="_blank" rel="noopener noreferrer" class="tb-banner-ext"><b>ThingsBoard Cloud</b></a>.</>
				) : null}
			</p>
		</div>
	</aside>
)}

<style>
	.tb-banner {
		border: 1px solid var(--tb-banner-color);
		border-inline-start: 4px solid var(--tb-banner-color);
		border-radius: 0.5rem;
		padding: 0.75rem 1rem;
		margin-bottom: 1.5rem;
		background: color-mix(in srgb, var(--tb-banner-color) 6%, transparent);
	}

	.tb-banner[data-variant='peFeature'],
	.tb-banner[data-variant='pe'] {
		--tb-banner-color: var(--color-product-pe, #00695c);
	}

	.tb-banner[data-variant='ce'] {
		--tb-banner-color: var(--color-product-ce, #305680);
	}

	.tb-banner[data-variant='cloud'] {
		--tb-banner-color: var(--color-product-cloud, #3d50f5);
	}

	.tb-banner[data-variant='trendz'] {
		--tb-banner-color: var(--color-product-trendz, #2696f3);
	}

	/* Info-style banners (non-peFeature) shrink to fit content */
	.tb-banner:not([data-variant='peFeature']) {
		display: inline-block;
		width: fit-content;
	}

	.tb-banner-content p {
		margin: 0;
		line-height: 1.6;
	}

	.tb-banner a:not(.tb-banner-ext) {
		color: var(--tb-banner-color);
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--tb-banner-color) 40%, transparent);
		text-underline-offset: 2px;
	}

	.tb-banner a:not(.tb-banner-ext):hover {
		text-decoration-color: var(--tb-banner-color);
	}

	/* Print: kept — it carries real constraints a printed procedure still needs.
	   Chrome skips backgrounds by default, so the tint becomes a border. */
	@media print {
		.tb-banner {
			background: none;
			box-shadow: none;
			border: 1px solid #c9ccd4;
			break-inside: avoid;
		}
	}
</style>
