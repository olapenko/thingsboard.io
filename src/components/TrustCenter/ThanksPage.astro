---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/Landing/PageIntro.astro';
import PricingBackground from '@components/Pricing/PricingBackground.astro';
import Card from '@components/ui/Card.astro';
import Link from '@components/ui/Link.astro';
import LinkCard from '@components/ui/LinkCard.astro';
import Mark from '@components/ui/Mark.astro';
import './trust-center.scss';

/**
 * A Trust Center form's thank-you page, on Contact us's (`pages/contact-us-thanks.astro`), part for
 * part: the form's card with the outcome in it (the success green's check popping in, the eyebrow,
 * the h1, the lede), "Edit and send again" under it, then "While you wait" as two link cards and the
 * way back. What a page adds goes in the card under the lede: what was asked for, what happens next.
 *
 * The words here are the generic ones. Each page's inline script, after its content, swaps them for
 * the reader's own from what the form kept (`CONTACT_SENT_KEY`, `REPORT_SENT_KEY`) before first
 * paint, through the `data-thanks` parts: `eyebrow`, `title`, `lede`, `fix`, `fix-link`.
 *
 * PROTOTYPE: the forms post nowhere, and the card says so at its foot until they do.
 */

export interface NextLink {
	icon: string;
	title: string;
	line: string;
	href: string;
	/** The one tile in colour, the step the page leads with. */
	accent?: boolean;
}

interface Props {
	metaTitle: string;
	description: string;
	eyebrow: string;
	title: string;
	lede: string;
	/** "Edit and send again"'s words; its address is the script's, from where the form was. */
	fixLead?: string;
	/** After the link: what the form can't bring back (the report's attachments). */
	fixTail?: string;
	next: NextLink[];
	nextTitle?: string;
	back: { href: string; label: string };
}

const {
	metaTitle,
	description,
	eyebrow,
	title,
	lede,
	fixLead = 'Wrong address, or forgot something?',
	fixTail,
	next,
	nextTitle = 'While you wait',
	back,
} = Astro.props;
---

<BaseLayout forceLightTheme noIndex title={metaTitle} description={description}>
	<PricingBackground />
	<div class="tc-thanks">
		<Card as="section" role="panel" pad="xl" class="tc-thanks__card" attrs={{ 'aria-labelledby': 'tc-thanks-title' }}>
			<div class="tc-thanks__intro" data-accent="onprem">
				<Mark size={64} icon="tabler:check" lift class="tc-thanks__mark" />
				<PageIntro
					align="center"
					eyebrow={eyebrow}
					title={title}
					lede={lede}
					ledeMeasure="narrow"
					titleId="tc-thanks-title"
					partAttrs={{
						eyebrow: { 'data-thanks': 'eyebrow' },
						title: { 'data-thanks': 'title' },
						subtitle: { 'data-thanks': 'lede' },
					}}
				/>
			</div>
			<slot />
			<p class="tc-thanks__fix" data-thanks="fix" hidden>
				{fixLead}{' '}
				<Link variant="inline" href="#" attrs={{ 'data-thanks': 'fix-link' }}>
					Edit and send again
				</Link>
				{fixTail}
			</p>
			<p class="tc-thanks__proto">Prototype: this form isn’t connected yet, so nothing was sent.</p>
		</Card>

		<section class="tc-thanks__next" aria-labelledby="tc-thanks-next-title">
			<h2 class="tc-thanks__next-title" id="tc-thanks-next-title">
				{nextTitle}
			</h2>
			<ul class="tc-thanks__links">
				{next.map((link) => (
					<LinkCard
						as="li"
						href={link.href}
						title={link.title}
						line={link.line}
						icon={link.icon}
						markFill={link.accent ? 'wash' : 'neutral'}
					/>
				))}
			</ul>
		</section>

		<Link class="tc-thanks__back" href={back.href} dir="back" tone="muted">
			{back.label}
		</Link>
	</div>
	<slot name="script" />
</BaseLayout>

<style lang="scss" is:global>
	:root:not([data-theme='dark']) body:has(.tc-thanks) {
		background-color: transparent;
	}
</style>

<style lang="scss">
	@use '../../styles/variables' as *;

	// Contact us's thank-you, rule for rule, with room in the card for what was asked and what's next.
	.tc-thanks {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: $page-measure-box;
		margin: 0 auto;
		// The header is in the page's flow here, so the room under it is the step alone (as on `FormPage`).
		padding: $spacing-12 $spacing-5 $spacing-20;

		@include media-down(md) {
			padding: $spacing-8 $spacing-4 $spacing-16;
		}

		:where(p, h2, ul, ol) {
			margin: 0;
		}
	}

	.tc-thanks__card {
		width: 100%;
		max-width: 620px;
		text-align: center;
	}

	.tc-thanks__intro :global(.tc-thanks__mark) {
		margin-bottom: $spacing-6;
		animation: tc-thanks-pop 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.3) both;

		@media (prefers-reduced-motion: reduce) {
			animation: none;
		}
	}

	@keyframes tc-thanks-pop {
		from {
			transform: scale(0.6);
			opacity: 0;
		}
	}

	.tc-thanks__intro {
		:global(.section-header .section-header__title) {
			margin-bottom: $spacing-4;
		}

		:global(.section-header .section-header__subtitle) {
			overflow-wrap: anywhere;
		}

		:global(.section-header__subtitle strong) {
			font-weight: $font-weight-medium;
			color: var(--color-text);
		}
	}

	.tc-thanks__fix {
		@include type-small;
		margin-top: $spacing-6;
		color: var(--color-text-secondary);

		&[hidden] {
			display: none;
		}
	}

	.tc-thanks__proto {
		@include type-small;
		margin-top: $spacing-6;
		padding-top: $spacing-4;
		border-top: 1px dashed var(--color-border);
		color: var(--color-text-muted);
	}

	.tc-thanks__next {
		width: 100%;
		margin-top: $spacing-16;

		@include media-down(md) {
			margin-top: $spacing-12;
		}
	}

	.tc-thanks__next-title {
		@include type-card;
		margin-bottom: $spacing-5;
		text-align: center;
		color: var(--color-text);
	}

	.tc-thanks__links {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: $spacing-4;
		max-width: 820px;
		margin: 0 auto;
		padding: 0;
		list-style: none;

		@include media-down(md) {
			grid-template-columns: minmax(0, 1fr);
			max-width: 620px;
		}
	}

	.tc-thanks :global(.tc-thanks__back) {
		margin-top: $spacing-10;
	}
</style>
