---
import { Icon } from 'astro-icon/components';
import Link from '@components/ui/Link.astro';
import { isOffSite, type Access } from '@data/trust-center/documents';
import { newTabAttrs } from '@util/external-links';

/**
 * One document, the same everywhere it is listed (the hub, the Documents page, Cloud and
 * On-premises): an access icon before its name (a globe for public, a lock for what needs an NDA, a
 * clock for what is planned, as the document pages have it; the hover names it: Public, NDA
 * required, Planned), and its actions at the end
 * of the row. A public document is "View"; the others
 * are "Request", straight to the contact form with the document ticked.
 *
 * In the library (`pick`), a document that has to be requested also leads with a checkbox, for
 * requesting several at once (`DocLibrary`'s selection bar); a public one keeps the column empty, so
 * the names line up.
 */

export interface DocItemAction {
	label: string;
	href: string;
	/** A link the draft left dead (`href="#"`): drawn, goes nowhere. */
	dead?: boolean;
}

interface Props {
	name: string;
	/** Where the name goes (the document's page); a name without one is plain text. */
	href?: string;
	/** A column of its own between the name and the actions (the category); under the name on phones. */
	meta?: string;
	access: Access;
	actions: DocItemAction[];
	/** The library's selection: the document's slug, the box's value. */
	pick?: string;
	attrs?: Record<string, string | undefined>;
}

const { name, href, meta, access, actions, pick, attrs = {} } = Astro.props;
const pickable = pick !== undefined && access !== 'public';

const ACCESS_NOTE: Record<Access, { icon: string; note: string }> = {
	public: { icon: 'tabler:world', note: 'Public' },
	nda: { icon: 'tabler:lock', note: 'NDA required' },
	pending: { icon: 'tabler:clock', note: 'Planned' },
};
const badge = ACCESS_NOTE[access];
---

<li class:list={['tc-doc', meta && 'tc-doc--meta', pick !== undefined && 'tc-doc--pick']} {...attrs}>
	<div class="tc-doc__text">
		{pick !== undefined && (
			<span class="tc-doc__pick">
				{pickable && (
					<input class="tc-check__box" type="checkbox" value={pick} aria-label={`Select ${name}`} data-doc-pick />
				)}
			</span>
		)}
		<span class:list={['tc-access', `tc-access--${access}`]}>
			<Icon name={badge.icon} aria-hidden="true" />
			<span class="tc-access__tip">{badge.note}</span>
		</span>
		<span class="tc-doc__body">
			{href ? (
				<a class="tc-doc__name" href={href} {...newTabAttrs(isOffSite(href))}>
					{name}
				</a>
			) : (
				<span class="tc-doc__name">{name}</span>
			)}
		</span>
	</div>
	{meta && <span class="tc-doc__meta">{meta}</span>}
	<div class="tc-doc__actions">
		{actions.map((action) =>
			action.dead ? (
				<a class="tc-dead" href="#" data-dead aria-disabled="true">
					{action.label}
				</a>
			) : (
				<Link href={action.href} size="sm" external={isOffSite(action.href)} srSuffix={name}>
					{action.label}
				</Link>
			)
		)}
	</div>
</li>
