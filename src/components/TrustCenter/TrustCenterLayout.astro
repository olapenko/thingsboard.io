---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/Landing/PageIntro.astro';
import PricingBackground from '@components/Pricing/PricingBackground.astro';
import Breadcrumb from '@components/TrustCenter/Breadcrumb.astro';
import { FOOTER_LINE, LAST_UPDATED, type Crumb } from '@data/trust-center/nav';
import './trust-center.scss';

/**
 * Every Trust Center page: the shared draft's structure and words, on the site's own page treatment.
 *
 * The frame is Contact us': the pricing wave behind the page, the page measure, `PageIntro` for the
 * h1 and the lede (centred on the two forms, as the draft centres them), and the site's chrome
 * around it. Above the intro, the draft's breadcrumb (`Trust Center › …`) and, where a view had one,
 * its back link (`before-title`). Under the content, the draft's footer line.
 *
 * A draft: its forms are not connected and its facts are not signed off, so it stays out of search.
 */

interface Props {
	/** The page's h1. */
	title: string;
	lede?: string;
	description?: string;
	/** The breadcrumb trail; none on the hub. */
	crumbs?: Crumb[];
	align?: 'left' | 'center';
	/** The browser title, where it should differ from the h1. */
	metaTitle?: string;
}

const { title, lede, description, crumbs, align = 'left', metaTitle } = Astro.props;
const pageTitle = metaTitle ?? (crumbs ? `${title} · Trust Center` : title);
---

<BaseLayout forceLightTheme noIndex title={pageTitle} description={description}>
	<PricingBackground />
	<div class:list={['tc-page', align === 'center' && 'tc-page--center']}>
		<header class="tc-intro">
			{crumbs && <Breadcrumb items={crumbs} />}
			<slot name="before-title" />
			<PageIntro title={title} lede={lede} align={align} ledeMeasure={align === 'center' ? 'copy' : 'wide'} />
			<slot name="intro" />
		</header>
		<slot />
		<div class="tc-foot">
			<p>{FOOTER_LINE}</p>
			<p>{LAST_UPDATED}</p>
		</div>
	</div>
</BaseLayout>

<script>
	// The draft's dead links (a document not published yet): drawn, and they go nowhere.
	document.querySelectorAll<HTMLAnchorElement>('a[data-dead]').forEach((a) => {
		a.addEventListener('click', (event) => event.preventDefault());
	});
</script>

<style is:global>
	/* The pricing page's ground, as Contact us lets it through: the wave field is fixed behind the
	   page, so the body has to be transparent in light mode. */
	:root:not([data-theme='dark']) body:has(.tc-page) {
		background-color: transparent;
	}
</style>
