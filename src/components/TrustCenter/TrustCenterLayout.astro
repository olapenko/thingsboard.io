---
import BaseLayout from '@layouts/BaseLayout.astro';
import Bookend from '@components/Landing/Bookend.astro';
import PageIntro from '@components/Landing/PageIntro.astro';
import Band from '@components/ui/Band.astro';
import Breadcrumb from '@components/TrustCenter/Breadcrumb.astro';
import ReadNext from '@components/TrustCenter/ReadNext.astro';
import type { Crumb } from '@data/trust-center/nav';
import { keepReading, pageAt, type TcPage } from '@data/trust-center/pages';
import './trust-center.scss';

/**
 * Every Trust Center page: the shared draft's structure and words, on the site's own page treatment.
 *
 * The page opens on a hero band, the product pages' idiom: a fade to the brand tint, with the wave
 * field on the hub (`wave`), holding the draft's breadcrumb (`Trust Center › …`), the h1 and the
 * lede (`PageIntro`), and what a page puts in its `actions` and `visual` slots (the hub's two buttons
 * and its certificates). The content follows on the page's own white ground, in the page measure,
 * then "Read next" (`ReadNext`): two pages to go on to, from the page list (`@data/trust-center/pages`),
 * found by the page's own address. The page closes on the Trust Center's bookend, as the hub does.
 *
 * The draft's footer line ("© … · Owner: IMS Manager · Reviewed at least every six months · Last
 * updated") is gone from the pages: the hub states the review once, and Sub-processors dates its list.
 *
 * A draft: its forms are not connected and its facts are not signed off, so it stays out of search.
 */

interface Props {
	/** The page's h1. */
	title: string;
	lede?: string;
	/** An uppercase kicker over the h1. */
	eyebrow?: string;
	description?: string;
	/** The breadcrumb trail; none on the hub. */
	crumbs?: Crumb[];
	align?: 'left' | 'center';
	/** The browser title, where it should differ from the h1. */
	metaTitle?: string;
	/** The wave field over the hero's wash: the hub. Every other page takes the wash alone. */
	wave?: boolean;
	/**
	 * The hero's wash by section: the brand tint by default (the hub, Compliance, Documents, Cloud), a
	 * cooler cyan on the Security pages, the on-premises green on On-premises, and the Deployments
	 * band's blue-to-green on Commitments. Marks and links keep their own colours.
	 */
	family?: 'security' | 'onprem' | 'deployment';
	/** "Read next", where the page knows better than the list (a document's neighbours). */
	next?: TcPage[];
	/** How many pages "Read next" offers: 2 by default (TEST: 3 on Access control). */
	nextCount?: number;
}

const {
	title,
	lede,
	eyebrow,
	description,
	crumbs,
	align = 'left',
	metaTitle,
	wave = false,
	family,
	next,
	nextCount = 2,
} = Astro.props;
const FAMILY_HUE = {
	security: 'var(--color-accent-cyan, #0e7490)',
	onprem: '#178649',
} as const;
const hue = family && family !== 'deployment' ? FAMILY_HUE[family] : undefined;
const pageTitle = metaTitle ?? (crumbs ? `${title} · Trust Center` : title);
const hasVisual = Astro.slots.has('visual');

const page = pageAt(Astro.url.pathname);
// The content, rendered first, so "Read next" can leave out the pages it already links to.
const body = await Astro.slots.render('default');
const linked = new Set([...body.matchAll(/href="(\/[^"#?]*)/g)].map((m) => m[1]));
const reading = next ?? keepReading(page, linked, nextCount);
---

<BaseLayout forceLightTheme noIndex title={pageTitle} description={description}>
	<Band
		ground="fade"
		strength={10}
		hue={hue}
		wave={wave}
		pad={{ top: 'md', bottom: 'md' }}
		class:list={['tc-hero', family && `tc-hero--${family}`]}
		as="div"
	>
		<header
			class:list={[
				'tc-hero__inner',
				hasVisual && 'tc-hero__inner--visual',
				align === 'center' && 'tc-hero__inner--center',
			]}
		>
			<div class="tc-hero__text">
				{crumbs && <Breadcrumb items={crumbs} />}
				<PageIntro
					title={title}
					lede={lede}
					eyebrow={eyebrow}
					align={align}
					ledeMeasure={align === 'center' ? 'copy' : 'wide'}
				/>
				<slot name="intro" />
				{Astro.slots.has('actions') && (
					<div class="tc-hero__actions">
						<slot name="actions" />
					</div>
				)}
			</div>
			{hasVisual && (
				<div class="tc-hero__visual">
					<slot name="visual" />
				</div>
			)}
		</header>
	</Band>
	<div class:list={['tc-page', align === 'center' && 'tc-page--center']}>
		<Fragment set:html={body} />
		{reading.length > 0 && <ReadNext pages={reading} />}
	</div>
	<Bookend id="trust" />
</BaseLayout>

<script>
	// The draft's dead links (a document not published yet): drawn, and they go nowhere.
	document.querySelectorAll<HTMLAnchorElement>('a[data-dead]').forEach((a) => {
		a.addEventListener('click', (event) => event.preventDefault());
	});
</script>
