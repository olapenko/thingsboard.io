---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/Landing/PageIntro.astro';
import Band from '@components/ui/Band.astro';
import Link from '@components/ui/Link.astro';
import SectionNav from '@components/TrustCenter/SectionNav.astro';
import VersionSwitch from '@components/TrustCenter/VersionSwitch.astro';
import { LAST_UPDATED, SECTIONS, sectionFor } from '@data/trust-center/nav';
import './trust-center.scss';

// Every Trust Center page: the section bar directly under the site's bar, then a short hero on the
// section's hue — what is on the page, the h1 and the lede, and on the right whatever the page puts
// in the `visual` slot, and across its foot the `heroFoot` slot (the overview's topics) — then the
// page's own bands, then the date the content was last updated. The
// section's hue is the page's accent: the kit's buttons, links and description tags inside take it,
// as the On-premises page takes green.
//
// A page made of a section's merged pages lists its parts (`anchors`, "On this page") in a sticky
// sidebar from 1024, beside a narrower reading column, with the part in view marked and the
// section's pages of their own under it; below 1024 the same list sits under the lede and scrolls
// away with the hero, so the sticky header stays two rows. A page under its section's own (Cloud,
// On-premises, Sub-processors, a document) has the way back where the eyebrow stands: `PageIntro`'s
// eyebrow is text, so it is the kit's back link instead.
//
// The page composes its body from `ui/Band`s: white for running content, the tint for cards (a
// white card reads on a tint, not on white).

interface Props {
	/** The page's h1. */
	title: string;
	/** The browser title, where it should differ from the h1. */
	metaTitle?: string;
	description?: string;
	/** Over the h1. Default: the section's name, or "Trust Center" on the section's own page. */
	eyebrow?: string;
	lede?: string;
	/** The page's sections, listed "On this page" at the top of the hero. */
	anchors?: { label: string; href: string }[];
	/**
	 * The section bar. Off on the overview (the landing logic): there the six topics list the
	 * sections right under the hero, and the hero carries the two actions.
	 */
	bar?: boolean;
	/**
	 * The page stands for its section's own page at another address (a proposed version of it),
	 * so it has the section's eyebrow, not a way back to the section.
	 */
	sectionPage?: boolean;
}

const { title, metaTitle, description, lede, anchors = [], bar = true, sectionPage = false } = Astro.props;
const section = sectionFor(Astro.url.pathname);
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
// The section this page sits under, when it is not the section's own page.
const parent =
	!sectionPage && section.key !== 'overview' && SECTIONS.includes(section) && section.href !== path
		? section
		: undefined;
const eyebrow = parent
	? undefined
	: (Astro.props.eyebrow ?? (title === section.label ? 'Trust Center' : section.label));
const hasVisual = Astro.slots.has('visual');
const aside = anchors.length > 0;
// The section's pages of their own, listed under the parts: what is not a part of this page.
const elsewhere = aside ? section.pages.filter((p) => p.href.split('#')[0] !== path) : [];
const hueVars = [
	`--tc-hue: ${section.hue}`,
	`--accent-fill: ${section.hue}`,
	`--accent-ink: ${section.hue}`,
	`--accent-light: color-mix(in srgb, ${section.hue} 30%, #fff)`,
	'--accent-on-fill: #fff',
	// Section washes: every tinted band on the page takes the section's hue, not the brand lavender.
	`--band-tint: color-mix(in srgb, ${section.hue} 7%, #fff)`,
].join('; ');
---

{/* A draft: its forms are not connected and its facts are not signed off, so it stays out of search. */}
<BaseLayout
	title={metaTitle ?? (title === 'Trust Center' ? title : `${title} · Trust Center`)}
	description={description}
	forceLightTheme
	noIndex
>
	<div class:list={['tc', aside && 'tc--aside']} data-section={section.key} style={hueVars}>
		{bar && <SectionNav section={section} />}
		<Band ground="fade" hue={section.hue} strength={10} wave pad={{ top: 'md', bottom: 'md' }} class="tc-hero">
			<div class:list={['tc-hero__inner', hasVisual && 'tc-hero__inner--visual']}>
				<div class="tc-hero__text">
					<div class="tc-hero__intro">
						{parent && (
							<Link href={parent.href} dir="back" size="sm" class="tc-hero__back">
								{parent.label}
							</Link>
						)}
						<PageIntro eyebrow={eyebrow} title={title} lede={lede} />
					</div>
					{aside && (
						<nav class="tc-anchors" aria-labelledby="tc-anchors-label">
							<p class="tc-anchors__label" id="tc-anchors-label">
								On this page
							</p>
							<ul class="tc-anchors__list">
								{anchors.map((a) => (
									<li>
										<a class="tc-anchors__link" href={a.href} data-tc-anchor>
											{a.label}
										</a>
									</li>
								))}
							</ul>
						</nav>
					)}
					<slot name="hero" />
				</div>
				{hasVisual && (
					<div class="tc-hero__visual">
						<slot name="visual" />
					</div>
				)}
			</div>
			{Astro.slots.has('heroFoot') && (
				<div class="tc-hero__foot">
					<slot name="heroFoot" />
				</div>
			)}
		</Band>
		{aside ? (
			<div class="tc-body">
				<div class="tc-rail">
					<div class="tc-rail__inner">
						<nav class="tc-aside" aria-labelledby="tc-aside-label">
							<p class="tc-aside__label" id="tc-aside-label">
								On this page
							</p>
							<ul class="tc-aside__list">
								{anchors.map((a) => (
									<li>
										<a class="tc-aside__link" href={a.href} data-tc-anchor>
											{a.label}
										</a>
									</li>
								))}
							</ul>
							{elsewhere.length > 0 && (
								<>
									<p class="tc-aside__label">Also in {section.label}</p>
									<ul class="tc-aside__list tc-aside__list--pages">
										{elsewhere.map((p) => (
											<li>
												<Link href={p.href} size="sm" class="tc-aside__page">
													{p.label}
												</Link>
											</li>
										))}
									</ul>
								</>
							)}
						</nav>
					</div>
				</div>
				<slot />
			</div>
		) : (
			<slot />
		)}
		<Band pad={{ top: 'sm', bottom: 'md' }} class="tc-foot">
			<p class="tc-foot__updated">Last updated {LAST_UPDATED}</p>
		</Band>
	</div>
	{/* TEMP-VERSION-SWITCH: dev server only, never in a build. */}
	{import.meta.env.DEV && <VersionSwitch />}
</BaseLayout>

<script>
	// "You are here": the part whose top has passed the upper third of the window is current, in the
	// sidebar and in the list under the lede alike; the first part until then. The line is never above
	// where a jump to the part lands (the page's scroll padding plus the part's scroll margin), so the
	// part a link was clicked for is the one marked.
	const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-tc-anchor]')];
	const targets = [...new Set(links.map((a) => a.hash))]
		.map((hash) => document.getElementById(decodeURIComponent(hash.slice(1))))
		.filter((el): el is HTMLElement => el !== null);

	if (targets.length > 0) {
		let frame = 0;
		const update = () => {
			frame = 0;
			const padding = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
			const line = (el: HTMLElement) =>
				Math.max(innerHeight * 0.3, padding + (parseFloat(getComputedStyle(el).scrollMarginTop) || 0) + 48);
			const atEnd = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
			const current = atEnd
				? targets[targets.length - 1]
				: (targets.filter((el) => el.getBoundingClientRect().top <= line(el)).pop() ?? targets[0]);
			for (const a of links) {
				if (a.hash === `#${current.id}`) a.setAttribute('aria-current', 'location');
				else a.removeAttribute('aria-current');
			}
		};
		const schedule = () => (frame ||= requestAnimationFrame(update));
		addEventListener('scroll', schedule, { passive: true });
		addEventListener('resize', schedule);
		update();
	}
</script>
