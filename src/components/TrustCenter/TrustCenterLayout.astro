---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/Landing/PageIntro.astro';
import Band from '@components/ui/Band.astro';
import SectionNav from '@components/TrustCenter/SectionNav.astro';
import SectionPages from '@components/TrustCenter/SectionPages.astro';
import { LAST_UPDATED, sectionFor } from '@data/trust-center/nav';
import './trust-center.scss';

// Every Trust Center page (build v3): the section bar directly under the site's bar, then a short
// hero on the section's hue — the section's pages as pills, the h1 and the lede, and on the right
// whatever the page puts in the `visual` slot — then the page's own bands, then the date the content
// was last updated. The section's hue is the page's accent: the kit's buttons, links and description
// tags inside take it, as the On-premises page takes green.
//
// The page composes its body from `ui/Band`s: white for running content, the tint for cards (a
// white card reads on a tint, not on white).

interface Props {
	/** The page's h1. */
	title: string;
	/** The browser title, where it should differ from the h1. */
	metaTitle?: string;
	description?: string;
	/** Over the h1, where the section's pages are not listed there. Default: the section's name. */
	eyebrow?: string;
	lede?: string;
}

const { title, metaTitle, description, lede } = Astro.props;
const section = sectionFor(Astro.url.pathname);
const listed = section.pages.length > 1;
// The pills name the section already; a page of a single-page section is named by its eyebrow.
const eyebrow = listed
	? undefined
	: (Astro.props.eyebrow ?? (title === section.label ? 'Trust Center' : section.label));
const hasVisual = Astro.slots.has('visual');
const hueVars = [
	`--tc-hue: ${section.hue}`,
	`--accent-fill: ${section.hue}`,
	`--accent-ink: ${section.hue}`,
	`--accent-light: color-mix(in srgb, ${section.hue} 30%, #fff)`,
	'--accent-on-fill: #fff',
	// Section washes: every tinted band on the page takes the section's hue, not the brand lavender.
	`--band-tint: color-mix(in srgb, ${section.hue} 7%, #fff)`,
].join('; ');
---

{/* A draft: its forms are not connected and its facts are not signed off, so it stays out of search. */}
<BaseLayout
	title={metaTitle ?? (title === 'Trust Center' ? title : `${title} · Trust Center`)}
	description={description}
	forceLightTheme
	noIndex
>
	<div class="tc" data-section={section.key} style={hueVars}>
		<SectionNav section={section} />
		<Band ground="fade" hue={section.hue} strength={10} wave pad={{ top: 'md', bottom: 'md' }} class="tc-hero">
			<div class:list={['tc-hero__inner', hasVisual && 'tc-hero__inner--visual']}>
				<div class="tc-hero__text">
					{listed && <SectionPages section={section} />}
					<PageIntro eyebrow={eyebrow} title={title} lede={lede} />
					<slot name="hero" />
				</div>
				{hasVisual && (
					<div class="tc-hero__visual">
						<slot name="visual" />
					</div>
				)}
			</div>
		</Band>
		<slot />
		<Band pad={{ top: 'sm', bottom: 'md' }} class="tc-foot">
			<p class="tc-foot__updated">Last updated {LAST_UPDATED}</p>
		</Band>
	</div>
</BaseLayout>
