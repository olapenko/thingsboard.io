---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/Landing/PageIntro.astro';
import Band from '@components/ui/Band.astro';
import Breadcrumb from '@components/TrustCenter/Breadcrumb.astro';
import { FOOTER_LINE, LAST_UPDATED, type Crumb } from '@data/trust-center/nav';
import './trust-center.scss';

/**
 * Every Trust Center page: the shared draft's structure and words, on the site's own page treatment.
 *
 * The page opens on a hero band, the product pages' idiom: a fade to the brand tint with the wave
 * field, holding the draft's breadcrumb (`Trust Center › …`), its back link where a view had one,
 * the h1 and the lede (`PageIntro`, centred on the two forms as the draft centres them), and what a
 * page puts in its `actions` and `visual` slots (the hub's two buttons and its certificates). The
 * content follows on the page's own white ground, in the page measure, and ends on the draft's
 * footer line.
 *
 * A draft: its forms are not connected and its facts are not signed off, so it stays out of search.
 */

interface Props {
	/** The page's h1. */
	title: string;
	lede?: string;
	/** An uppercase kicker over the h1. */
	eyebrow?: string;
	description?: string;
	/** The breadcrumb trail; none on the hub. */
	crumbs?: Crumb[];
	align?: 'left' | 'center';
	/** The browser title, where it should differ from the h1. */
	metaTitle?: string;
}

const { title, lede, eyebrow, description, crumbs, align = 'left', metaTitle } = Astro.props;
const pageTitle = metaTitle ?? (crumbs ? `${title} · Trust Center` : title);
const hasVisual = Astro.slots.has('visual');
---

<BaseLayout forceLightTheme noIndex title={pageTitle} description={description}>
	<Band ground="fade" strength={10} wave pad={{ top: 'md', bottom: 'md' }} class="tc-hero" as="div">
		<header
			class:list={[
				'tc-hero__inner',
				hasVisual && 'tc-hero__inner--visual',
				align === 'center' && 'tc-hero__inner--center',
			]}
		>
			<div class="tc-hero__text">
				{crumbs && <Breadcrumb items={crumbs} />}
				<slot name="before-title" />
				<PageIntro
					title={title}
					lede={lede}
					eyebrow={eyebrow}
					align={align}
					ledeMeasure={align === 'center' ? 'copy' : 'wide'}
				/>
				<slot name="intro" />
				{Astro.slots.has('actions') && (
					<div class="tc-hero__actions">
						<slot name="actions" />
					</div>
				)}
			</div>
			{hasVisual && (
				<div class="tc-hero__visual">
					<slot name="visual" />
				</div>
			)}
		</header>
	</Band>
	<div class:list={['tc-page', align === 'center' && 'tc-page--center']}>
		<slot />
		<div class="tc-foot">
			<p>{FOOTER_LINE}</p>
			<p>{LAST_UPDATED}</p>
		</div>
	</div>
</BaseLayout>

<script>
	// The draft's dead links (a document not published yet): drawn, and they go nowhere.
	document.querySelectorAll<HTMLAnchorElement>('a[data-dead]').forEach((a) => {
		a.addEventListener('click', (event) => event.preventDefault());
	});
</script>
