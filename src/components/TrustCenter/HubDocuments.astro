---
import { Icon } from 'astro-icon/components';
import Link from '@components/ui/Link.astro';
import DocItem from '@components/TrustCenter/DocItem.astro';
import DocSearch from '@components/TrustCenter/DocSearch.astro';
import { DOCS, DOC_GROUPS, HUB_DOCS, docAction, docHref } from '@data/trust-center/documents';
import { tc } from '@data/trust-center/nav';

/**
 * The hub's documents, as drafted: the 18 documents in their four groups, each row the shared
 * `DocItem` (the name opens the document's page, "View" the document, "Request" the contact form).
 * One change to the draft's order: in each group the public documents come first, so a group opens
 * on what you can view straight away; the rest keep the draft's order.
 *
 * The hub shows the highlights; the search happens on the Documents page. `DocSearch` here is the
 * query and Search, a form that opens that page with the query.
 */

const publicFirst = (docs: typeof HUB_DOCS) => [
	...docs.filter((d) => d.access === 'public'),
	...docs.filter((d) => d.access !== 'public'),
];
const groups = DOC_GROUPS.map((group, i) => ({ ...group, docs: publicFirst(HUB_DOCS.filter((d) => d.group === i)) }));
---

<div class="tc-hubdocs">
	<DocSearch />
	<div class="tc-docgroups">
		{groups.map((group) => (
			<section class="tc-docgroup">
				<h3 class="tc-docgroup__title">
					<Icon name={group.icon} class="tc-docgroup__icon" aria-hidden="true" />
					{group.name}
				</h3>
				<ul class="tc-doclist">
					{group.docs.map((d) => (
						<DocItem name={d.name} href={docHref(d)} access={d.access} actions={[docAction(d)]} />
					))}
				</ul>
			</section>
		))}
	</div>
	<div class="tc-hubdocs__all">
		<Link href={tc('documents')}>All {DOCS.length} documents</Link>
	</div>
</div>
