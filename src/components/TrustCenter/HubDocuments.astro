---
import Button from '@components/ui/Button.astro';
import Field from '@components/ui/Field.astro';
import Link from '@components/ui/Link.astro';
import DocItem from '@components/TrustCenter/DocItem.astro';
import { DOC_GROUPS, HUB_DOCS, docAction, docHref } from '@data/trust-center/documents';
import { tc } from '@data/trust-center/nav';

/**
 * The hub's documents, as drafted: the 18 documents in their four groups, each row the shared
 * `DocItem` (the name opens the document's page, "View" the document, "Request" the contact form).
 *
 * The hub shows the highlights; the search happens on the Documents page. The field is a form that
 * opens the library with the query (`?q=…`), where `DocLibrary` applies it.
 */

const groups = DOC_GROUPS.map((name, i) => ({ name, docs: HUB_DOCS.filter((d) => d.group === i) }));
---

<div class="tc-hubdocs">
	<form class="tc-toolbar" action={tc('documents')} method="get" role="search">
		<Field
			name="q"
			id="tc-hub-q"
			label="Search documents"
			labelHidden
			optional
			placeholder="Search documents, e.g. backup policy"
			size="md"
			class="tc-toolbar__search"
			attrs={{ autocomplete: 'off' }}
		/>
		<Button type="submit" size="md" icon="tabler:search">
			Search
		</Button>
	</form>
	<div class="tc-docgroups">
		{groups.map((group) => (
			<section class="tc-docgroup">
				<h3 class="tc-docgroup__title">{group.name}</h3>
				<ul class="tc-doclist">
					{group.docs.map((d) => (
						<DocItem name={d.name} href={docHref(d)} access={d.access} actions={[docAction(d)]} />
					))}
				</ul>
			</section>
		))}
	</div>
	<div class="tc-hubdocs__all">
		<Link href={tc('documents')}>All documents</Link>
	</div>
</div>
