---
// A run of facts: a term and its value per row, ruled on the page's ground (the draft's two-column
// tables, without the box). A row's `id` is its anchor, for a link from the FAQ or another page.
// Values are HTML: running text with `<b>` and links, built with `@data/trust-center/html`.

export interface Fact {
	term: string;
	html: string;
	id?: string;
}

interface Props {
	rows: Fact[];
	class?: string;
}

const { rows, class: className } = Astro.props;
---

<dl class:list={['tc-facts', className]}>
	{rows.map((row) => (
		<div class="tc-facts__row" id={row.id}>
			<dt class="tc-facts__term">{row.term}</dt>
			<dd class="tc-facts__value" set:html={row.html} />
		</div>
	))}
</dl>
