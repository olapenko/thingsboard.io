---
import { Icon } from 'astro-icon/components';
import Button from '@components/ui/Button.astro';
import Card from '@components/ui/Card.astro';
import Field from '@components/ui/Field.astro';
import { DOCS, NDA_DOC_OPTIONS } from '@data/trust-center/documents';
import { CONTACT_SUBJECTS, MESSAGE_OPTIONAL_FOR } from '@data/trust-center/forms';

/**
 * The Trust Center contact form, as drafted: first and last name, work email, company, a subject,
 * the documents (for "Request documents under NDA") and a message. On the site's form parts: a kit
 * `Card` panel of kit `Field`s, the subject a native select in the field's clothes (`ui/Field` has
 * no select), the submit a kit `Button`.
 *
 * The subject drives the rest, as in the draft: its prompt becomes the message's placeholder,
 * "Request documents under NDA" shows the documents and makes the message optional, and so does
 * "Sub-processor change notifications". Other pages prefill it through the query
 * (`?subject=nda&doc=<slug>` ticks that document; another subject with a document asks when it will
 * be available).
 *
 * Not connected, as in the draft: a valid request shows the thank-you state and says nothing was
 * sent (see the INTEGRATION NOTE in `@data/trust-center/forms`).
 */

const DOC_NAMES = Object.fromEntries(DOCS.map((d) => [d.slug, d.name]));
---

<div
	class="tc-formwrap"
	data-tc-contact
	data-doc-names={JSON.stringify(DOC_NAMES)}
	data-message-optional={JSON.stringify(MESSAGE_OPTIONAL_FOR)}
>
	{/* `novalidate` spelled out: Astro drops a boolean attribute given an empty string. */}
	<Card as="form" role="panel" class="tc-form" attrs={{ id: 'cform', method: 'post', novalidate: 'novalidate' }}>
		<fieldset class="tc-form__fields">
			<legend class="ui-sr">Your details and request</legend>

			<Field
				name="firstName"
				id="cf-first"
				label="First name"
				maxLength={50}
				autocomplete="given-name"
				attrs={{ autocapitalize: 'words' }}
			/>
			<Field
				name="lastName"
				id="cf-last"
				label="Last name"
				maxLength={50}
				autocomplete="family-name"
				attrs={{ autocapitalize: 'words' }}
			/>
			<Field
				name="email"
				id="cf-email"
				label="Work email"
				type="email"
				maxLength={80}
				autocomplete="email"
				inputmode="email"
				attrs={{ autocapitalize: 'off', spellcheck: 'false', pattern: '[^@\\s]+@[^@\\s]+\\.[^@\\s]+' }}
			/>
			<Field name="company" id="cf-company" label="Company" maxLength={80} autocomplete="organization" />

			<div class="ui-field ui-field--lg tc-form__full">
				<label class="ui-field__label" for="cf-subject">
					Subject
				</label>
				<div class="ui-field__row tc-select">
					<select
						class="ui-field__control tc-select__control is-empty"
						id="cf-subject"
						name="subject"
						required
						aria-invalid="false"
					>
						<option value="" selected disabled>
							Select a subject
						</option>
						{CONTACT_SUBJECTS.map((s) => (
							<option value={s.value} data-prompt={s.prompt}>
								{s.label}
							</option>
						))}
					</select>
					<Icon name="tabler:chevron-down" class="tc-select__chevron" aria-hidden="true" />
				</div>
			</div>

			{/* Only for "Request documents under NDA": at least one. */}
			<fieldset class="tc-form__full tc-docs" id="cf-docs" aria-describedby="cf-docs-hint" hidden>
				<legend class="ui-field__label tc-docs__legend">Documents you need</legend>
				<ul class="tc-checks">
					{NDA_DOC_OPTIONS.map((d) => (
						<li>
							<label class="tc-check">
								<input class="tc-check__box" type="checkbox" name="documents" value={d.value} aria-invalid="false" />
								<span>{d.label}</span>
							</label>
						</li>
					))}
				</ul>
				<p class="tc-form__hint" id="cf-docs-hint">
					We send you our mutual NDA first. Once it's signed, you get the documents within two business days.
				</p>
			</fieldset>

			{/* The message, in the field's clothes too: its label says "(optional)" for the subjects where it is. */}
			<div class="ui-field ui-field--lg ui-field--area tc-form__full">
				<label class="ui-field__label" for="cf-msg">
					Message{' '}
					<span class="tc-form__optional" id="cf-msg-optional" hidden>
						(optional)
					</span>
				</label>
				<div class="ui-field__row">
					<textarea
						class="ui-field__control"
						id="cf-msg"
						name="message"
						rows="5"
						required
						aria-invalid="false"
					></textarea>
				</div>
			</div>
		</fieldset>

		<p class="tc-form__alert" id="cf-err" role="alert" hidden></p>

		<div class="tc-form__foot">
			<Button type="submit" size="lg" attrs={{ style: '--btn-min-w: 160px' }}>
				Submit
			</Button>
			<p class="tc-form__note">
				We use these details only to answer your request. See our{' '}
				<a href="/products/paas/privacy-policy/">Privacy Policy</a>.
			</p>
		</div>
	</Card>

	<Card role="panel" class="tc-form__done" attrs={{ id: 'cf-done', hidden: 'hidden' }}>
		<p class="tc-form__done-title">
			Thank you, <span id="cf-done-name"></span>!
		</p>
		<p class="tc-form__done-text" id="cf-done-msg"></p>
		<p class="tc-form__proto">Draft: this form isn't connected yet, so nothing was sent.</p>
		<div>
			<Button variant="secondary" size="md" attrs={{ id: 'cf-again' }}>
				Send another request
			</Button>
		</div>
	</Card>
</div>

<script>
	type Control = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

	document.querySelectorAll<HTMLElement>('[data-tc-contact]').forEach((root) => {
		const byId = <T extends HTMLElement>(id: string) => root.querySelector<T>(`#${id}`)!;
		const form = byId<HTMLFormElement>('cform');
		const subject = byId<HTMLSelectElement>('cf-subject');
		const docs = byId<HTMLFieldSetElement>('cf-docs');
		const message = byId<HTMLTextAreaElement>('cf-msg');
		const messageOptional = byId('cf-msg-optional');
		const alert = byId('cf-err');
		const done = byId('cf-done');
		const docNames: Record<string, string> = JSON.parse(root.dataset.docNames ?? '{}');
		const optionalFor: string[] = JSON.parse(root.dataset.messageOptional ?? '[]');

		const mark = (el: Element, bad: boolean) => el.setAttribute('aria-invalid', String(bad));

		// The subject drives the documents, whether the message is required, and its placeholder.
		const applySubject = () => {
			const k = subject.value;
			const optional = optionalFor.includes(k);
			subject.classList.toggle('is-empty', k === '');
			docs.hidden = k !== 'nda';
			message.required = !optional;
			messageOptional.hidden = !optional;
			message.placeholder = subject.selectedOptions[0]?.dataset.prompt ?? '';
		};

		const prefill = () => {
			const params = new URLSearchParams(window.location.search);
			const k = params.get('subject');
			const doc = params.get('doc');
			if (!k || ![...subject.options].some((o) => o.value === k)) return;
			subject.value = k;
			applySubject();
			if (!doc) return;
			if (k === 'nda') {
				const box = docs.querySelector<HTMLInputElement>(`input[value="${CSS.escape(doc)}"]`);
				if (box) box.checked = true;
			} else if (docNames[doc] && !message.value.trim()) {
				message.value = `I'm interested in your ${docNames[doc]}. When will it be available?`;
			}
		};

		subject.addEventListener('change', applySubject);

		// An error clears the moment its field changes; the line under the form goes with the last one.
		form.addEventListener('input', (event) => {
			const target = event.target as HTMLElement;
			if (target.matches('[aria-invalid]')) mark(target, false);
			if (target.closest('#cf-docs')) docs.classList.remove('is-bad');
			if (!form.querySelector('[aria-invalid="true"], .is-bad')) alert.hidden = true;
		});

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const bad: HTMLElement[] = [];
			form.querySelectorAll<Control>('input[required], select[required], textarea[required]').forEach((el) => {
				const ok = el.value.trim() !== '' && el.checkValidity();
				mark(el, !ok);
				if (!ok) bad.push(el);
			});
			const k = subject.value;
			const docsOk = k !== 'nda' || !!docs.querySelector('input:checked');
			docs.classList.toggle('is-bad', !docsOk);
			if (!docsOk) bad.push(docs.querySelector<HTMLInputElement>('input')!);
			if (bad.length) {
				const email = byId<HTMLInputElement>('cf-email');
				let text = 'Please fill in the highlighted fields.';
				if (email.value.trim() && !email.checkValidity()) {
					text = 'Please enter a valid work email and fill in any other highlighted fields.';
				}
				if (!docsOk && bad.length === 1) text = 'Choose at least one document.';
				alert.textContent = text;
				alert.hidden = false;
				bad[0].focus();
				return;
			}
			const email = byId<HTMLInputElement>('cf-email').value.trim();
			byId('cf-done-name').textContent = byId<HTMLInputElement>('cf-first').value.trim();
			byId('cf-done-msg').textContent =
				k === 'nda'
					? `We'll send our mutual NDA to ${email}. Once it's signed, you'll get the documents within two business days.`
					: k === 'subprocessors'
						? `We'll email ${email} when our list of sub-processors changes.`
						: `We'll reply to ${email}.`;
			form.hidden = true;
			done.hidden = false;
			window.scrollTo({ top: 0, behavior: 'smooth' });
		});

		byId('cf-again').addEventListener('click', () => {
			form.reset();
			applySubject();
			form.querySelectorAll('[aria-invalid="true"]').forEach((el) => mark(el, false));
			docs.classList.remove('is-bad');
			alert.hidden = true;
			form.hidden = false;
			done.hidden = true;
			byId<HTMLInputElement>('cf-first').focus();
		});

		applySubject();
		prefill();
	});
</script>
