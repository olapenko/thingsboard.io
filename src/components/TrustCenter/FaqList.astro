---
import Button from '@components/ui/Button.astro';
import FaqItem from '@components/Landing/FaqItem.astro';
import { TC_FAQ } from '@data/trust-center/faq';

/**
 * The hub's FAQ, as drafted: category headings over the questions, ten shown, and "Load more FAQ"
 * revealing the other thirteen with the last two headings. The questions are the product pages'
 * `FaqItem`, a native `<details>`, so they open without a script.
 */
---

<div class="tc-faq" data-faq>
	{TC_FAQ.map((cat) => (
		<section
			class="tc-faq__cat"
			aria-labelledby={`tc-faq-${cat.id}`}
			hidden={cat.moreHeading}
			data-faq-more={cat.moreHeading ? '' : undefined}
		>
			<h3 class="tc-h3 tc-faq__title" id={`tc-faq-${cat.id}`}>
				{cat.title}
			</h3>
			{cat.items.map((item) => (
				<FaqItem question={item.question} answer={item.answer} extra={item.more} />
			))}
		</section>
	))}
	<div class="tc-faq__foot">
		<Button variant="secondary" size="md" attrs={{ 'data-faq-load': '' }}>
			Load more FAQ
		</Button>
	</div>
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-faq]').forEach((root) => {
		const button = root.querySelector<HTMLButtonElement>('[data-faq-load]');
		button?.addEventListener('click', () => {
			root.querySelectorAll<HTMLElement>('[data-faq-extra], [data-faq-more]').forEach((el) => {
				el.hidden = false;
			});
			button.parentElement!.hidden = true;
		});
	});
</script>
