---
import ItemList, { type Item, type ItemAction } from '@components/TrustCenter/ItemList.astro';
import Link from '@components/ui/Link.astro';
import {
	DEPLOYMENTS,
	libraryFor,
	requestIn,
	TIER_TAG,
	type Deployment,
	type LibraryDoc,
} from '@data/trust-center/library';

// A deployment page's documents as a view of the library, not a list of its own. An open document
// opens; a requested one is marked with its tier and requested in the library, which opens with it
// ticked. The link under the list opens the library on this deployment, with the documents for every
// deployment too.

interface Props {
	items: LibraryDoc[];
	deployment: Deployment;
}

const { items, deployment } = Astro.props;
const label = DEPLOYMENTS.find((d) => d.id === deployment)?.label ?? '';

const actionsOf = (d: LibraryDoc): ItemAction[] =>
	d.href
		? [{ label: 'Open', href: d.href, external: /^https?:/.test(d.href) }]
		: [{ label: 'Request', href: requestIn([d.slug], deployment) }];

const rows: Item[] = items.map((d) => ({
	title: d.name,
	tags: d.tier === 'open' ? [] : [TIER_TAG[d.tier]],
	actions: actionsOf(d),
}));
---

<ItemList items={rows} />
<p class="tc-copy">
	<Link href={libraryFor(deployment)} size="sm">
		All documents that apply to {label}
	</Link>
</p>
