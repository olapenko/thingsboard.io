---
import ItemList, { type Item, type ItemAction } from '@components/TrustCenter/ItemList.astro';
import Link from '@components/ui/Link.astro';
import {
	askAbout,
	DEPLOYMENTS,
	LIBRARY_ACCESS,
	libraryFor,
	type Deployment,
	type LibraryDoc,
} from '@data/trust-center/documents-proposed';

// PROPOSED (review of 2026-10-12): a deployment page's documents as a view of the product-wide
// library, not a list of its own. The rows are the library's documents for this deployment; one
// under NDA is requested in the library, which opens with it added, and the link under the list
// opens the library on this deployment, with the documents for every deployment too.

interface Props {
	items: LibraryDoc[];
	deployment: Deployment;
}

const { items, deployment } = Astro.props;
const label = DEPLOYMENTS.find((d) => d.id === deployment)?.label ?? '';
const library = libraryFor(deployment);

const actionsOf = (d: LibraryDoc): ItemAction[] => {
	if (d.href) return [{ label: 'Open', href: d.href, external: /^https?:/.test(d.href) }];
	if (d.links) return d.links.map((l) => ({ label: l.label, href: l.href, external: true }));
	if (d.access === 'nda') return [{ label: 'Request', href: `${library}&request=${d.slug}#${d.slug}` }];
	return [{ label: d.access === 'planned' ? 'Ask about it' : 'Ask for it', href: askAbout(d) }];
};

const rows: Item[] = items.map((d) => ({ title: d.name, tags: [LIBRARY_ACCESS[d.access]], actions: actionsOf(d) }));
---

<ItemList items={rows} />
<p class="tc-copy">
	<Link href={library} size="sm">
		All documents that apply to {label}
	</Link>
</p>
