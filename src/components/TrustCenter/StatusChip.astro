---
import Chip from '@components/ui/Chip.astro';

/**
 * The draft's status chip (Certified, Public, NDA, Planned, Built in, Configurable, Depends on
 * deployment) as the kit's tag: the accent tint for the positive ones (`ok`), the neutral tint for
 * the rest. The kit's two tones, no new colours.
 */

interface Props {
	tone: 'ok' | 'nda' | 'warn' | 'flat';
	class?: string;
}

const { tone, class: className } = Astro.props;
---

<Chip tone={tone === 'ok' ? 'accent' : 'neutral'} class={className}>
	<slot />
</Chip>
