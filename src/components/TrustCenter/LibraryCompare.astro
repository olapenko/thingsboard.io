---
/**
 * TEMP-LIBRARY-COMPARE: Current · Proposed, in the hero of both document libraries, so the review
 * of 2026-10-12 can be compared on the real pages. Goes when one of the two is chosen.
 */
interface Props {
	current: 'current' | 'proposed';
}

const { current } = Astro.props;
const OPTIONS = [
	{ id: 'current', label: 'Current library', href: '/trust-center/documents/' },
	{ id: 'proposed', label: 'Proposed', href: '/trust-center/documents/proposed/' },
];
---

<nav class="tc-compare" aria-label="Library versions">
	{OPTIONS.map((o) => (
		<a
			class:list={['tc-compare__link', o.id === current && 'is-here']}
			href={o.href}
			aria-current={o.id === current ? 'page' : undefined}
		>
			{o.label}
		</a>
	))}
</nav>

<style>
	.tc-compare {
		display: flex;
		width: max-content;
		max-width: 100%;
		gap: 2px;
		margin-top: 16px;
		padding: 3px;
		border: 1px dashed color-mix(in srgb, var(--accent-fill) 45%, transparent);
		border-radius: 999px;
		background: rgb(255 255 255 / 70%);
	}

	.tc-compare__link {
		padding: 6px 12px;
		border-radius: 999px;
		color: var(--color-text-secondary);
		font-size: 13px;
		font-weight: 500;
		line-height: 1.2;
		text-decoration: none;

		&:hover {
			color: var(--color-text);
			background: rgb(23 24 28 / 6%);
		}

		&.is-here {
			background: var(--accent-fill);
			color: #fff;
		}
	}
</style>
