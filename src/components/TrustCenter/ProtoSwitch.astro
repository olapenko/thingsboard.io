---
/**
 * PROTOTYPE: a switch between the versions of one page, at the top of each, so the team can compare
 * them in place. The report page has three: the email composer (the page itself), the template to
 * copy, and the form that posts. Goes, with the versions not chosen, once one is.
 */

export interface ProtoVersion {
	id: string;
	label: string;
	href: string;
}

interface Props {
	versions: ProtoVersion[];
	current: string;
}

const { versions, current } = Astro.props;
---

<nav class="tc-proto" aria-label="Prototype versions">
	<span class="tc-proto__label">Prototype</span>
	{versions.map((v) => (
		<a class="tc-proto__link" href={v.href} aria-current={v.id === current ? 'page' : undefined}>
			{v.label}
		</a>
	))}
</nav>
