---
import Link from '@components/ui/Link.astro';
import StatusChip from '@components/TrustCenter/StatusChip.astro';
import { STATUS_LABEL, type CatalogRow } from '@data/trust-center/catalogs';

/**
 * A topic page's rows (Product security, Data security, Access control, Dev security): the title
 * with its status, the text, and the documentation link where the draft has one.
 */

interface Props {
	rows: CatalogRow[];
	/** The list's accessible name. */
	label: string;
}

const { rows, label } = Astro.props;
const TONE = { in: 'ok', cfg: 'warn', dep: 'flat' } as const;
---

<ul class="tc-cat" aria-label={label}>
	{rows.map((row) => (
		<li class="tc-cat__row">
			<div class="tc-cat__head">
				<h2 class="tc-cat__title">{row.title}</h2>
				<StatusChip tone={TONE[row.status]}>{STATUS_LABEL[row.status]}</StatusChip>
			</div>
			<p class="tc-cat__text">
				<Fragment set:html={row.html} />
				{row.docs && (
					<Link href={row.docs} size="sm" class="tc-cat__docs">
						Docs
					</Link>
				)}
			</p>
		</li>
	))}
</ul>
