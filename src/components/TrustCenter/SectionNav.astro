---
import { Icon } from 'astro-icon/components';
import Button from '@components/ui/Button.astro';
import { SECTIONS, TC_ACTIONS, type Section } from '@data/trust-center/nav';

// The Trust Center's section bar: one row, directly under the site's bar and sticking to it, so the
// two read as one header (build v3; under the hero, in v2, it sat oddly mid-page). The Trust
// Center's name leads it and is the way to the overview; then the four sections, the current one in
// its hue; the two actions at the end as buttons. A section's parts are not a second row here: a
// section is one page with anchored parts, listed "On this page" in its hero (`TrustCenterLayout`),
// so no page carries a second bar of tabs. On a phone the row scrolls sideways, the current section
// brought into view.
//
// Links, not `ui/Tabs`: these go to other pages, and tabs switch panels in place. The look follows
// the kit's list tabs, a tint of the accent under the current one.

interface Props {
	section: Section;
}

const { section } = Astro.props;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
---

<nav class="tc-bar" aria-label="Trust Center">
	<div class="tc-bar__inner">
		<div class="tc-bar__row">
			<a class="tc-bar__home" href={SECTIONS[0].href} aria-current={section.key === 'overview' ? 'page' : undefined}>
				Trust Center
			</a>
			<ul class="tc-bar__sections">
				{SECTIONS.filter((s) => s.key !== 'overview').map((s) => (
					<li>
						<a
							class="tc-bar__section"
							href={s.href}
							style={`--tc-tab-hue: ${s.hue}`}
							aria-current={s.key === section.key ? (s.href === path ? 'page' : 'true') : undefined}
						>
							<Icon name={s.icon} class="tc-bar__icon" aria-hidden="true" />
							{s.label}
						</a>
					</li>
				))}
			</ul>
			<div class="tc-bar__actions">
				{TC_ACTIONS.map((action, i) => (
					<Button
						href={action.href}
						size="sm"
						variant={i === 0 ? 'secondary' : 'tertiary'}
						accent="brand"
						attrs={action.href === path ? { 'aria-current': 'page' } : {}}
					>
						{action.label}
					</Button>
				))}
			</div>
		</div>
	</div>
</nav>

<script>
	// On a narrow screen the row scrolls sideways: bring the current section into view, without
	// scrolling the page itself.
	document.querySelectorAll<HTMLElement>('.tc-bar__row').forEach((row) => {
		const el = row.querySelector<HTMLElement>('.tc-bar__section[aria-current]');
		if (!el || row.scrollWidth <= row.clientWidth) return;
		row.scrollLeft = el.offsetLeft - (row.clientWidth - el.offsetWidth) / 2;
	});
</script>
