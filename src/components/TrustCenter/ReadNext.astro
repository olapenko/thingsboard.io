---
import { Icon } from 'astro-icon/components';
import type { TcPage } from '@data/trust-center/pages';

/**
 * "Read next" at a page's foot: two pages to go on to (three on a test page), as light link rows, not
 * cards, a line between them. The bookend
 * right under it is three tall cards with marks; this stays quieter than it so the page ends on one
 * row of cards, not two. Each item: the page's own icon (the hub tile's), plain, beside the title and
 * its chevron, the one line under the title, the icon in the accent's ink. The whole item is the link; its title takes the accent
 * on hover, and a page with its own accent (the vulnerability report's red) brings it along.
 */

interface Props {
	pages: TcPage[];
}

const { pages } = Astro.props;
---

<section class="tc-section tc-keep" aria-labelledby="tc-keep-title">
	<h2 class="tc-h3" id="tc-keep-title">
		Read next
	</h2>
	<ul class="tc-next" style={`--tc-next-count: ${pages.length}`}>
		{pages.map((p) => (
			<li>
				<a class="tc-next__link" href={p.href} data-accent={p.accent}>
					<Icon name={p.icon} class="tc-next__icon" aria-hidden="true" />
					<span class="tc-next__title">
						{p.title}
						<Icon name="tabler:chevron-right" class="tc-next__chevron" aria-hidden="true" />
					</span>
					<span class="tc-next__line">{p.line}</span>
				</a>
			</li>
		))}
	</ul>
</section>
