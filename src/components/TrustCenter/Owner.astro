---
import Link from '@components/ui/Link.astro';
import { TC_OWNER } from '@data/trust-center/pages';

/**
 * An owner as the Trust Center names it: the IMS Manager by name and title ("Oleg Reutskyi, IMS
 * Manager"), the name a link to their profile, where an owner applies: the hub's line, in grey so it
 * stays quiet there, and a document's page, in the link blue. Any other owner (a role, a certification
 * body) stays as written.
 *
 * The link and the title are one array, so no template whitespace falls between the arrow and the
 * comma; `.tc-owner` drops the whitespace the kit's Link keeps inside its own anchor.
 */

interface Props {
	/** A document's owner; the IMS Manager when left out (the Trust Center's own). */
	owner?: string;
	/** The link's colour: the link blue, or grey (`muted`) in the hub's line. */
	tone?: 'accent' | 'muted';
	/** The title on a line of its own, in grey, under the name: a document's Owner cell. */
	stacked?: boolean;
}

const { owner = TC_OWNER.role, tone = 'accent', stacked = false } = Astro.props;
---

{owner === TC_OWNER.role
	? [
			<Link variant="inline" tone={tone} href={TC_OWNER.href} external class="tc-owner">
				{TC_OWNER.name}
			</Link>,
			stacked ? <span class="tc-owner__role">{TC_OWNER.role}</span> : `, ${TC_OWNER.role}`,
		]
	: owner}
