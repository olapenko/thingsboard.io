---
import Band from '@components/ui/Band.astro';
import DocumentLibrary from '@components/TrustCenter/DocumentLibrary.astro';
import FeatureSwitch from '@components/TrustCenter/FeatureSwitch.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { LIBRARY } from '@data/trust-center/library';

// The Documents page, at its own address and at every requested document's (`documents/<slug>/`).
// A requested document's address is the library with that document in the request, scrolled to: a
// link that shares as the document (its name and description are the page's title and description).
// An open document has no such address: its own page or file is its address.

interface Props {
	/** The requested document this address is for. */
	open?: string;
}

const { open } = Astro.props;
const doc = open ? LIBRARY.find((d) => d.slug === open) : undefined;
---

<TrustCenterLayout
	title="Documents"
	sectionPage
	metaTitle={doc ? `${doc.name} · Trust Center` : undefined}
	lede="Open a document, or select the ones that are requested and request them together."
	description={
		doc
			? doc.description
			: "ThingsBoard's security, compliance and privacy documents: certificates, audit evidence, policies, legal terms and questionnaires."
	}
>
	<Band pad={{ top: 'sm', bottom: 'lg' }}>
		<DocumentLibrary open={doc?.slug} />
	</Band>
	{/* TEMP-FEATURE-SWITCH: dev server only, never in a build. */}
	{import.meta.env.DEV && (
		<FeatureSwitch
			features={[
				{
					id: 'filters',
					label: 'Filters',
					options: [
						{ value: 'chips', label: 'Chips' },
						{ value: 'rail', label: 'Sidebar' },
					],
				},
				{
					id: 'tags',
					label: 'Tags',
					options: [
						{ value: 'outline', label: 'Outline' },
						{ value: 'grey', label: 'Grey' },
					],
				},
				{
					id: 'pack',
					label: 'Pack banner',
					options: [
						{ value: 'off', label: 'Off' },
						{ value: 'on', label: 'On' },
					],
				},
			]}
		/>
	)}
</TrustCenterLayout>
