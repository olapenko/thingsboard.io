---
import { Icon } from 'astro-icon/components';
import Button from '@components/ui/Button.astro';

/**
 * PROTOTYPE, the report's version A: one Copy button, alike for the address, the subject and the
 * template, borderless inside the grey box of what it copies. Its width holds whatever it says, so "Copied" moves nothing; copied, it turns to the
 * success green's check and "Copied" for a moment (the page's script sets `data-copied`).
 */

interface Props {
	/** What it copies, for screen readers: "the address" makes "Copy the address". */
	what: string;
	/** The text itself, or the id of the element whose text it copies. */
	text?: string;
	from?: string;
}

const { what, text, from } = Astro.props;
---

<Button
	variant="tertiary"
	size="sm"
	srSuffix={what}
	class="tc-tcopy"
	attrs={{ 'data-copy': text, 'data-copy-from': from }}
>
	<Icon name="tabler:copy" class="ui-btn__icon tc-tcopy__icon" aria-hidden="true" />
	<Icon name="tabler:circle-check-filled" class="ui-btn__icon tc-tcopy__done" aria-hidden="true" />
	<span data-copy-label>Copy</span>
</Button>
