---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/Landing/PageIntro.astro';
import PricingBackground from '@components/Pricing/PricingBackground.astro';
import Link from '@components/ui/Link.astro';
import Mark from '@components/ui/Mark.astro';
import './trust-center.scss';

/**
 * The Trust Center's form pages (the contact form and the vulnerability report), on the site's
 * Contact us page: the intro and "Looking for something else?" in a 344 column, the form card beside
 * it in 656, over the pricing page's wave field. The grid, the measure and the aside are that page's
 * (`pages/contact-us.astro`), so the two read as one family with it. No Trust Center footer line: an
 * owner and a review date say nothing about a form.
 */

export interface ElsewhereItem {
	icon: string;
	lead: string;
	label: string;
	href: string;
	external?: boolean;
	/** A `data-accent` for this item: `alert` (the Trust Center's red) on the vulnerability report. */
	accent?: string;
}

interface Props {
	title: string;
	lede: string;
	description: string;
	/** The browser title, where it should differ from the h1. */
	metaTitle?: string;
	/**
	 * A way back over the intro, "‹ Trust Center": a form page is a step out of the Trust Center, not a
	 * place in its tree, so one link back rather than a breadcrumb and a kicker.
	 */
	back?: { label: string; href: string };
	elsewhereTitle?: string;
	elsewhere?: ElsewhereItem[];
	/**
	 * The page's hue: `alert`, the Trust Center's red, on the vulnerability report. It reaches the
	 * eyebrow, links, the submit, the checks and the wave field behind the page.
	 */
	accent?: 'alert';
}

const {
	title,
	lede,
	description,
	metaTitle,
	back,
	elsewhereTitle = 'Looking for something else?',
	elsewhere = [],
	accent,
} = Astro.props;
---

<BaseLayout forceLightTheme noIndex title={metaTitle ?? title} description={description}>
	<PricingBackground hue={accent ? 'var(--color-accent-red)' : undefined} />
	<div class="tc-fp" data-accent={accent}>
		{/* PROTOTYPE: a switch between a page's versions (`ProtoSwitch`), a row of its own over both columns. */}
		{Astro.slots.has('top') && (
			<div class="tc-fp__top">
				<slot name="top" />
			</div>
		)}
		<header class="tc-fp__intro">
			{back && (
				<Link href={back.href} dir="back" size="sm" class="tc-fp__back">
					{back.label}
				</Link>
			)}
			<PageIntro title={title} lede={lede} ledeMeasure="narrow" />
			{/* What has to be read before the form, on a phone too, where the aside falls under it. */}
			<slot name="intro" />
		</header>
		<div class="tc-fp__form">
			<slot />
		</div>
		<aside class="tc-fp__aside" aria-labelledby={elsewhere.length > 0 ? 'tc-fp-aside-title' : undefined}>
			<slot name="aside" />
			{elsewhere.length > 0 && (
				<>
					<h2 class="tc-fp__aside-title" id="tc-fp-aside-title">
						{elsewhereTitle}
					</h2>
					<ul class="tc-fp__list">
						{elsewhere.map((item) => (
							<li class="tc-fp__item" data-accent={item.accent}>
								<Mark size={48} icon={item.icon} fill="white" accent={item.accent ? undefined : 'neutral'} lift />
								<span class="tc-fp__text">
									<span class="tc-fp__lead">{item.lead}</span>
									{/* An external link's arrow is drawn here, held to the last word, so a label that wraps
									    keeps it at its end; the Link's own sits apart from the words. The new tab and its
									    screen-reader note still come from the Link (`target`). */}
									<Link
										class="tc-fp__link"
										href={item.href}
										tone="ink"
										dir="none"
										attrs={item.external ? { target: '_blank', rel: 'noopener noreferrer' } : undefined}
									>
										{item.external
											? [
													item.label.split(' ').slice(0, -1).join(' '),
													' ',
													<span class="tc-fp__last">
														{[
															item.label.split(' ').at(-1),
															<Icon name="tabler:arrow-up-right" class="tc-fp__out" aria-hidden="true" />,
														]}
													</span>,
												]
											: item.label}
									</Link>
								</span>
							</li>
						))}
					</ul>
				</>
			)}
		</aside>
	</div>
</BaseLayout>

<style lang="scss" is:global>
	// The pricing page's ground, as Contact us has it: the wave field is fixed behind the page, so the
	// body lets it through in light mode.
	:root:not([data-theme='dark']) body:has(.tc-fp) {
		background-color: transparent;
	}
</style>

<style lang="scss">
	@use '../../styles/variables' as *;

	// Contact us's grid, rule for rule: 344 for the intro, 656 for the form, in the footer's measure.
	.tc-fp {
		display: grid;
		grid-template-columns: minmax(0, 344px) minmax(0, 1fr);
		grid-template-rows: auto auto 1fr;
		grid-template-areas:
			'top top'
			'intro form'
			'aside form';
		gap: 0 $spacing-10;
		max-width: $page-measure-box;
		margin: 0 auto;
		// Contact us adds the header's height to this, its header floating over the page; here the header
		// is in the page's flow, so the room under it is the step alone (the Trust Center pages' 48, 32).
		padding: $spacing-12 $spacing-5 $spacing-24;

		@include media-down(lg) {
			grid-template-columns: minmax(0, 1fr);
			grid-template-rows: none;
			grid-template-areas: 'top' 'intro' 'form' 'aside';
			padding-top: $spacing-8;
			padding-bottom: $spacing-16;
		}

		:where(p, h2, ul) {
			margin: 0;
		}
	}

	.tc-fp__top {
		grid-area: top;
	}

	.tc-fp__intro {
		grid-area: intro;
		padding-top: $spacing-6;

		@include media-down(lg) {
			padding-top: 0;
			margin-bottom: $spacing-8;
		}

		:global(.tc-fp__back) {
			margin-bottom: $spacing-5;
		}

		:global(.section-header .section-header__title) {
			@include media-up(lg) {
				font-size: 34px;
			}

			text-wrap: balance;
		}
	}

	.tc-fp__form {
		grid-area: form;
		min-width: 0;
	}

	.tc-fp__aside {
		display: grid;
		grid-area: aside;
		align-self: start;
		gap: $spacing-5;
		margin-top: $spacing-12;

		@include media-down(lg) {
			margin-top: $spacing-10;
		}
	}

	.tc-fp__aside-title {
		@include type-tile;
		color: var(--color-text);
	}

	.tc-fp__list {
		display: grid;
		gap: $spacing-5;
		padding: 0;
		list-style: none;

		// Stacked under the form (below lg), the list runs the page's width: its three ways out side by
		// side. Beside the form (lg up) the column is narrow, and on phones there is no room.
		@include media-down(lg) {
			@include media-up(md) {
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: $spacing-5 $spacing-6;
			}
		}
	}

	.tc-fp__item {
		display: flex;
		align-items: flex-start;
		gap: 14px;

		// In the three columns, the mark over the words: beside them, a column's text was too narrow for
		// the email address, which broke mid-word.
		@include media-down(lg) {
			@include media-up(md) {
				flex-direction: column;
				gap: $spacing-3;
			}
		}
	}

	.tc-fp__text {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.tc-fp__lead {
		@include type-small;
		color: var(--color-text-secondary);
	}

	// A block of text, not the Link's flex row, so the words wrap as text and the arrow rides at their
	// end; as wide as the words, so the link is no wider than what it says.
	.tc-fp__item :global(.tc-fp__link) {
		display: block;
		width: fit-content;
		max-width: 100%;
		white-space: normal;
		overflow-wrap: anywhere;
	}

	.tc-fp__last {
		white-space: nowrap;
	}

	// The Link's own new-tab arrow, at its size and gap.
	.tc-fp__item :global(.tc-fp__out) {
		display: inline-block;
		width: 1em;
		height: 1em;
		margin-inline-start: 4px;
		vertical-align: -0.125em;
	}
</style>
