---
import Chip from '@components/ui/Chip.astro';
import Field from '@components/ui/Field.astro';
import DocItem from '@components/TrustCenter/DocItem.astro';
import { DOCS, docAction, docHref } from '@data/trust-center/documents';

/**
 * The Documents page's library, as drafted: a filter field, the access filters (Questionnaires
 * filters by category, the others by access) and one flat list of all 20 documents, each row the
 * shared `DocItem` with the category under the name.
 */

const FILTERS = [
	{ value: 'all', label: 'All' },
	{ value: 'public', label: 'Public' },
	{ value: 'nda', label: 'NDA' },
	{ value: 'pending', label: 'Planned' },
	{ value: 'qnr', label: 'Questionnaires' },
];
---

<div class="tc-library" data-doc-filter>
	<div class="tc-toolbar">
		<Field
			name="q"
			id="tc-library-q"
			label="Search documents"
			labelHidden
			optional
			placeholder="Search documents, e.g. backup policy"
			size="md"
			class="tc-toolbar__search"
			attrs={{ 'data-doc-query': '', autocomplete: 'off' }}
		/>
		<ul class="tc-toolbar__filters" role="group" aria-label="Access level">
			{FILTERS.map((f, i) => (
				<li>
					<Chip kind="toggle" size="sm" pressed={i === 0} attrs={{ 'data-doc-filter-value': f.value }}>
						{f.label}
					</Chip>
				</li>
			))}
		</ul>
	</div>
	<ul class="tc-doclist" data-doc-list>
		{DOCS.map((d) => (
			<DocItem
				name={d.name}
				href={docHref(d)}
				meta={d.category}
				access={d.access}
				actions={[docAction(d)]}
				attrs={{
					'data-access': d.access,
					'data-category': d.category,
					'data-text': `${d.name} ${d.category}`.toLowerCase(),
				}}
			/>
		))}
	</ul>
	<p class="tc-empty" data-doc-empty hidden>
		Nothing matches that filter.
	</p>
</div>

<script>
	// The draft's filter: a text match on the name and category, and one access filter at a time
	// (`qnr` is the Questionnaires category rather than an access level).
	document.querySelectorAll<HTMLElement>('[data-doc-filter]').forEach((root) => {
		const query = root.querySelector<HTMLInputElement>('[data-doc-query]');
		const toggles = [...root.querySelectorAll<HTMLButtonElement>('[data-doc-filter-value]')];
		const rows = [...root.querySelectorAll<HTMLElement>('.tc-doc')];
		const empty = root.querySelector<HTMLElement>('[data-doc-empty]');
		let filter = 'all';

		// Arriving from the hub's search (`?q=…&access=…`): the query fills the field and presses the chip.
		const params = new URLSearchParams(window.location.search);
		const fromHub = params.get('access') ?? '';
		if (toggles.some((b) => b.dataset.docFilterValue === fromHub)) {
			filter = fromHub;
			toggles.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.docFilterValue === filter)));
		}
		if (query && params.get('q')) query.value = params.get('q') ?? '';

		const render = () => {
			const q = (query?.value ?? '').trim().toLowerCase();
			let shown = 0;
			rows.forEach((row) => {
				const byFilter =
					filter === 'all' ||
					(filter === 'qnr' ? row.dataset.category === 'Questionnaires' : row.dataset.access === filter);
				const byQuery = q === '' || (row.dataset.text ?? '').includes(q);
				const show = byFilter && byQuery;
				row.hidden = !show;
				if (show) shown += 1;
			});
			if (empty) empty.hidden = shown > 0;
		};

		toggles.forEach((button) => {
			button.addEventListener('click', () => {
				filter = button.dataset.docFilterValue ?? 'all';
				toggles.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
				render();
			});
		});
		query?.addEventListener('input', render);
		render();
	});
</script>
