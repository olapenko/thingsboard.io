---
import Button from '@components/ui/Button.astro';
import DocItem from '@components/TrustCenter/DocItem.astro';
import DocSearch from '@components/TrustCenter/DocSearch.astro';
import { LIBRARY_DOCS, docActions, docHref } from '@data/trust-center/documents';
import { SECURITY_TOPICS } from '@data/trust-center/forms';
import { contactHref } from '@data/trust-center/nav';

/**
 * The Documents page's library: the documents search (`DocSearch`, live here) and one flat list of
 * all 23 documents, each row the shared `DocItem` with the category under the name. The query, the
 * category and the access toggle narrow the list together; the line above the list counts what is
 * shown and clears the filters.
 *
 * The access toggle is Public or Under NDA, the two kinds you can get; a planned document shows with
 * neither, as it can't be had yet.
 *
 * An NDA document has "Add" in Request's place (`DocItem`'s `pick`), to request
 * several at once: a bar then holds at the foot of the screen with the count, that they are shared
 * after a mutual NDA (everything that can be added is), Clear, and "Request N
 * documents", the contact form with the documents topic and every added one (`?doc=` once each). A
 * filter hides rows but keeps what was added; the count is of everything added. No "select all":
 * a reviewer asks for what their assessment needs, not the whole shelf.
 */

const REQUEST = contactHref(SECURITY_TOPICS.documents.value);
---

<div class="tc-library" data-doc-filter>
	<DocSearch live />
	<div class="tc-results">
		<p class="tc-results__count" aria-live="polite" data-doc-count>
			{LIBRARY_DOCS.length} documents
		</p>
		<Button
			variant="tertiary"
			size="xs"
			weight="regular"
			icon="tabler:x"
			class="tc-results__clear"
			attrs={{ 'data-doc-reset': '', hidden: '' }}
		>
			Clear filters
		</Button>
		<p class="tc-results__hint">Add the documents you need, then request them together.</p>
	</div>
	<ul class="tc-doclist" data-doc-list>
		{LIBRARY_DOCS.map((d) => (
			<DocItem
				name={d.name}
				href={docHref(d)}
				meta={d.category}
				access={d.access}
				actions={docActions(d)}
				pick={d.slug}
				attrs={{
					'data-access': d.access,
					'data-category': d.category,
					'data-text': `${d.name} ${d.category}`.toLowerCase(),
				}}
			/>
		))}
	</ul>
	<p class="tc-empty" data-doc-empty hidden>
		Nothing matches that filter.
	</p>
	<div class="tc-picked" data-doc-picked hidden>
		<p class="tc-picked__what">
			<span class="tc-picked__count" data-doc-picked-count></span>
			<span class="tc-picked__note">Shared after a mutual NDA</span>
		</p>
		<Button variant="tertiary" size="sm" weight="regular" attrs={{ 'data-doc-picked-clear': '' }}>
			Clear
		</Button>
		<Button href={REQUEST} size="md" class="tc-picked__request" attrs={{ 'data-doc-picked-request': '' }}>
			Request documents
		</Button>
	</div>
	<p class="ui-sr" aria-live="polite" data-doc-picked-status></p>
</div>

<script>
	// The list follows the search as you type or pick; Search does the same. The state stays in the
	// address (`?q=…&category=…&access=…`), which is also how the hub's search arrives here.
	document.querySelectorAll<HTMLElement>('[data-doc-filter]').forEach((root) => {
		const form = root.querySelector<HTMLFormElement>('[data-doc-search]');
		const query = root.querySelector<HTMLInputElement>('[data-doc-query]');
		const category = root.querySelector<HTMLSelectElement>('[data-doc-category]');
		const access = root.querySelector<HTMLInputElement>('[data-access-input]');
		const rows = [...root.querySelectorAll<HTMLElement>('.tc-doc')];
		const empty = root.querySelector<HTMLElement>('[data-doc-empty]');
		const count = root.querySelector<HTMLElement>('[data-doc-count]');
		const reset = root.querySelector<HTMLButtonElement>('[data-doc-reset]');

		const state = () => ({
			q: (query?.value ?? '').trim(),
			category: category?.value ?? '',
			access: access && !access.disabled ? access.value : '',
		});

		const render = () => {
			const { q, category: cat, access: acc } = state();
			const needle = q.toLowerCase();
			let shown = 0;
			rows.forEach((row) => {
				const show =
					(acc === '' || row.dataset.access === acc) &&
					(cat === '' || row.dataset.category === cat) &&
					(needle === '' || (row.dataset.text ?? '').includes(needle));
				row.hidden = !show;
				if (show) shown += 1;
			});
			if (empty) empty.hidden = shown > 0;
			const filtered = Boolean(q || cat || acc);
			if (count) count.textContent = filtered ? `${shown} of ${rows.length} documents` : `${rows.length} documents`;
			if (reset) reset.hidden = !filtered;
		};

		const remember = () => {
			const next = new URLSearchParams();
			Object.entries(state()).forEach(([key, value]) => value && next.set(key, value));
			const search = next.toString();
			window.history.replaceState(null, '', search ? `?${search}` : window.location.pathname);
		};

		form?.addEventListener('docsearch', () => {
			render();
			remember();
		});
		reset?.addEventListener('click', () => {
			form?.dispatchEvent(new CustomEvent('docsearch:reset'));
		});
		form?.addEventListener('submit', (event) => {
			event.preventDefault();
			render();
			remember();
		});
		render();

		// The selection: the bar shows while anything is added, its link carries every added document.
		const picks = [...root.querySelectorAll<HTMLInputElement>('[data-doc-pick]')];
		const bar = root.querySelector<HTMLElement>('[data-doc-picked]');
		const barCount = root.querySelector<HTMLElement>('[data-doc-picked-count]');
		const request = root.querySelector<HTMLAnchorElement>('[data-doc-picked-request]');
		const status = root.querySelector<HTMLElement>('[data-doc-picked-status]');
		const base = request?.getAttribute('href') ?? '';
		const documents = (n: number) => `${n} document${n === 1 ? '' : 's'}`;
		// The bar's height, for the site's chat button to clear it (`trust-center.scss`).
		const measureBar = () => {
			if (bar?.offsetHeight) document.documentElement.style.setProperty('--tc-picked-h', `${bar.offsetHeight}px`);
		};

		const syncPicked = (announce = false) => {
			const ticked = picks.filter((box) => box.checked);
			const n = ticked.length;
			if (bar) bar.hidden = n === 0;
			measureBar();
			if (barCount) barCount.textContent = `${documents(n)} selected`;
			if (status && announce) status.textContent = n ? `${documents(n)} selected` : 'Selection cleared';
			if (request) {
				const url = new URL(base, window.location.href);
				ticked.forEach((box) => url.searchParams.append('doc', box.value));
				request.href = `${url.pathname}${url.search}`;
				request.textContent = `Request ${documents(n)}`;
			}
		};
		picks.forEach((box) => box.addEventListener('change', () => syncPicked(true)));
		root.querySelector('[data-doc-picked-clear]')?.addEventListener('click', () => {
			picks.forEach((box) => (box.checked = false));
			syncPicked(true);
			picks.find((box) => !box.closest<HTMLElement>('.tc-doc')?.hidden)?.focus();
		});
		// Back from the form, the browser may have kept the ticks.
		window.addEventListener('pageshow', () => syncPicked());
		syncPicked();

		// And again as the bar wraps on a narrow screen or its text grows.
		if (bar && 'ResizeObserver' in window) new ResizeObserver(measureBar).observe(bar);
	});
</script>
