---
import { Icon } from 'astro-icon/components';

/**
 * The mark of a regulation we declare compliance with (GDPR, CCPA), against the ISO seals of what is
 * certified. Deliberately not a seal: flat, no ribbon, no "Certified", in the page's ink on its
 * tint, so it can't read as a certificate.
 *
 * - `gdpr`: a ring of twelve small stars around a shield, a reference to Europe that is not the EU
 *   flag (no gold on blue): the Commission lets third parties use its emblem only where it implies
 *   no endorsement, and a seal reading "GDPR" beside certificate seals would come close.
 * - `ccpa`: "CA" in a plain ring; California's state seal is restricted by law, so no emblem.
 */

interface Props {
	kind: 'gdpr' | 'ccpa';
	/** The tile's side, px. */
	size?: number;
	class?: string;
}

const { kind, size = 64, class: className } = Astro.props;

// Twelve five-pointed stars on a ring, the first at the top, as the European stars are set.
const star = (cx: number, cy: number, outer = 3.1, inner = 1.25): string => {
	const points: string[] = [];
	for (let i = 0; i < 10; i++) {
		const r = i % 2 === 0 ? outer : inner;
		const a = -Math.PI / 2 + (i * Math.PI) / 5;
		points.push(`${(cx + r * Math.cos(a)).toFixed(2)},${(cy + r * Math.sin(a)).toFixed(2)}`);
	}
	return points.join(' ');
};
const stars = Array.from({ length: 12 }, (_, i) => {
	const a = -Math.PI / 2 + (i * Math.PI) / 6;
	return star(32 + 22 * Math.cos(a), 32 + 22 * Math.sin(a));
});
---

<span
	class:list={['tc-declared', `tc-declared--${kind}`, className]}
	style={`--tc-declared-size: ${size}px`}
	aria-hidden="true"
>
	<svg viewBox="0 0 64 64" class="tc-declared__ring">
		{kind === 'gdpr' ? (
			stars.map((points) => <polygon points={points} />)
		) : (
			<circle cx="32" cy="32" r="22" fill="none" stroke-width="1.5" />
		)}
	</svg>
	{kind === 'gdpr' ? (
		<Icon name="tabler:shield-check" class="tc-declared__glyph" />
	) : (
		<span class="tc-declared__text">CA</span>
	)}
</span>

<style lang="scss">
	@use '../../styles/variables' as *;

	// The tint of a `Mark` wash (the accent at 10%), the stars, ring and glyph in the accent's ink.
	.tc-declared {
		position: relative;
		display: inline-grid;
		flex: none;
		place-items: center;
		width: var(--tc-declared-size);
		height: var(--tc-declared-size);
		border-radius: 50%;
		background: color-mix(in srgb, var(--accent-fill, #{$color-brand}) 10%, var(--color-bg-surface, #fff));
		color: var(--accent-ink, #{$color-brand});
	}

	.tc-declared__ring {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		fill: currentColor;
		stroke: currentColor;
	}

	.tc-declared--gdpr .tc-declared__ring {
		stroke: none;
	}

	.tc-declared :global(.tc-declared__glyph) {
		width: 40%;
		height: 40%;
	}

	.tc-declared__text {
		font-size: calc(var(--tc-declared-size) * 0.26);
		font-weight: $font-weight-bold;
		letter-spacing: 0.02em;
		line-height: 1;
	}
</style>
