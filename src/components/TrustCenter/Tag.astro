---
import Chip from '@components/ui/Chip.astro';
import type { TagLook } from '@data/trust-center/status';

// One of the Trust Center's tags (`@data/trust-center/status`) as the kit's `Chip`. A verdict brings
// its status colour; a description has none and takes the section's hue from the page's accent.

interface Props {
	tag: TagLook;
}

const { tag } = Astro.props;
---

<Chip kind="tag" look={tag.look} accent={tag.accent} tone={tag.tone ?? 'accent'} icon={tag.icon}>
	{tag.label}
</Chip>
