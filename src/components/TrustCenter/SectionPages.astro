---
import type { Section } from '@data/trust-center/nav';

// A section's pages, its hub first, as a row of pills at the top of its hero (build v3): there on
// every page of the section, gone once the reader scrolls past the hero, so the sticky header stays
// two rows (the site's bar and the section bar). The current page is filled in the section's hue.

interface Props {
	section: Section;
}

const { section } = Astro.props;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
---

<nav class="tc-pages" aria-label={`${section.label} pages`}>
	<ul class="tc-pages__list">
		{section.pages.map((p) => (
			<li>
				<a class="tc-pages__link" href={p.href} aria-current={p.href === path ? 'page' : undefined}>
					{p.label}
				</a>
			</li>
		))}
	</ul>
</nav>

<script>
	// On a phone the pills scroll sideways: bring the current page into view.
	document.querySelectorAll<HTMLElement>('.tc-pages__list').forEach((row) => {
		const el = row.querySelector<HTMLElement>('[aria-current]');
		if (!el || row.scrollWidth <= row.clientWidth) return;
		row.scrollLeft = el.offsetLeft - (row.clientWidth - el.offsetWidth) / 2;
	});
</script>
