---
import { Icon } from 'astro-icon/components';
import Card from '@components/ui/Card.astro';
import Tag from '@components/TrustCenter/Tag.astro';
import type { TagLook } from '@data/trust-center/status';

// The Trust Center's card: the kit's `Card` with a set inside, so every card spaces the same. The
// kit's card stacks its parts with no gap between them; this one gives each its room.
//
// - `row` (a certificate, a regulation): the lead (a seal, a mark) on the left, the title and its
//   line beside it, and the tag at the right, centred on the card. On a phone the tag drops under
//   the line.
// - `tile` (a deployment, getting in touch): the lead on top, then the title, the text, and the
//   footer (a button) at the foot, at the same place in every card of a row.
//
// A link card's title ends in a chevron, which steps forward on hover, so the card reads as a way
// in. `facts` is a short term-and-value list under the text (a deployment's summary rows).

interface Props {
	layout?: 'row' | 'tile';
	title: string;
	href?: string;
	text?: string;
	tag?: TagLook;
	/** Term and value rows under the text; the value is HTML. */
	facts?: { term: string; html: string }[];
	class?: string;
}

const { layout = 'tile', title, href, text, tag, facts = [], class: className } = Astro.props;
---

<Card
	role={layout === 'row' ? 'row' : 'tile'}
	pad="lg"
	href={href}
	title={title}
	titleSize="tile"
	class:list={['tc-card', `tc-card--${layout}`, className]}
>
	<div slot="mark" class="tc-card__lead">
		<slot name="lead" />
	</div>
	{href && <Icon slot="title" name="tabler:chevron-right" class="tc-card__chevron" aria-hidden="true" />}
	{text && <p class="tc-card__text">{text}</p>}
	{facts.length > 0 && (
		<dl class="tc-card__facts">
			{facts.map((f) => (
				<div class="tc-card__fact">
					<dt>{f.term}</dt>
					<dd set:html={f.html} />
				</div>
			))}
		</dl>
	)}
	<slot />
	{(tag || Astro.slots.has('footer')) && (
		<div slot="footer" class="tc-card__foot">
			{tag && <Tag tag={tag} />}
			<slot name="footer" />
		</div>
	)}
</Card>
