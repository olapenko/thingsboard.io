---
import Card from '@components/ui/Card.astro';
import Tag from '@components/TrustCenter/Tag.astro';
import type { TagLook } from '@data/trust-center/status';

// The Trust Center's card: the kit's `Card` with a set inside, so every card spaces the same. The
// kit's card stacks its parts with no gap between them; this one gives each its room.
//
// - `row` (a certificate, a regulation): the lead (a seal, a mark) on the left, the title and its
//   line beside it, and the tag at the right, centred on the card. On a phone the tag drops under
//   the line.
// - `tile` (a deployment, getting in touch): the lead on top, then the title, the text, and the
//   footer (a button) at the foot, at the same place in every card of a row.

interface Props {
	layout?: 'row' | 'tile';
	title: string;
	href?: string;
	text?: string;
	tag?: TagLook;
	class?: string;
}

const { layout = 'tile', title, href, text, tag, class: className } = Astro.props;
---

<Card
	role={layout === 'row' ? 'row' : 'tile'}
	pad="lg"
	href={href}
	title={title}
	titleSize="tile"
	class:list={['tc-card', `tc-card--${layout}`, className]}
>
	<div slot="mark" class="tc-card__lead">
		<slot name="lead" />
	</div>
	{text && <p class="tc-card__text">{text}</p>}
	<slot />
	{(tag || Astro.slots.has('footer')) && (
		<div slot="footer" class="tc-card__foot">
			{tag && <Tag tag={tag} />}
			<slot name="footer" />
		</div>
	)}
</Card>
