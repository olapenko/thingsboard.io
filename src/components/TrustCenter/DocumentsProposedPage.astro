---
import Band from '@components/ui/Band.astro';
import DocumentLibraryProposed from '@components/TrustCenter/DocumentLibraryProposed.astro';
import LibraryCompare from '@components/TrustCenter/LibraryCompare.astro';
import TrustCenterLayout from '@components/TrustCenter/TrustCenterLayout.astro';
import { LIBRARY } from '@data/trust-center/documents-proposed';

// PROPOSED (review of 2026-10-12): the document library's page, at its own address and at every
// document's (`proposed/<slug>/`). A document's address is the library with that document's details
// open over it: a link that shares as the document (its name and description are the page's title
// and description) and lands in the list it belongs to.

interface Props {
	/** The document whose details open over the list. */
	open?: string;
}

const { open } = Astro.props;
const doc = open ? LIBRARY.find((d) => d.slug === open) : undefined;
---

<TrustCenterLayout
	title="Documents"
	sectionPage
	metaTitle={doc ? `${doc.name} · Trust Center` : undefined}
	lede="Public documents open right away. Add the ones under NDA you need and request them together: we send our mutual NDA, then the documents within two business days."
	description={
		doc
			? doc.description
			: "ThingsBoard's security, compliance and privacy documents: certificates, audit evidence, policies, legal terms and questionnaires."
	}
>
	<LibraryCompare slot="hero" current="proposed" />
	<Band pad={{ top: 'sm', bottom: 'lg' }}>
		<DocumentLibraryProposed open={doc?.slug} />
	</Band>
</TrustCenterLayout>
