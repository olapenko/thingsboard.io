---
import ItemList, { type Item } from '@components/TrustCenter/ItemList.astro';
import type { Control } from '@data/trust-center/controls';
import { KIND } from '@data/trust-center/status';

// A Security topic's controls on the one list: each a heading with its anchor (so the FAQ can link
// straight to it), its kind as a description tag in the section's hue, the text, and its docs page.
// The headings are h3 under the topic's h2 on the Security page; `level` 2 where the list is the page.

interface Props {
	items: Control[];
	level?: 2 | 3;
}

const { level = 2 } = Astro.props;

const items: Item[] = Astro.props.items.map((c) => ({
	id: c.id,
	level,
	title: c.title,
	tags: [KIND[c.kind]],
	html: c.html,
	actions: c.docs ? [{ label: 'Documentation', href: c.docs }] : [],
}));
---

<ItemList items={items} />
