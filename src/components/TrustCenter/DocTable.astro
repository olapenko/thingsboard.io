---
import DocItem from '@components/TrustCenter/DocItem.astro';
import type { DocRow } from '@data/trust-center/deployment';

/**
 * The deployment pages' documents, as drafted, in the same rows as everywhere else (`DocItem`): a
 * public document opens (on the site or off it), an NDA one is requested on the contact form, and one
 * whose address the draft left out says "Link needed" until it has one.
 */

interface Props {
	/** What the list is, for screen readers. */
	caption: string;
	rows: DocRow[];
}

const { caption, rows } = Astro.props;
---

{/* At the main measure: a name and its action read together. The Documents library keeps the page's
    full width for its filters and meta column; the hub keeps its own layout. */}
<ul class="tc-doclist tc-doclist--main" aria-label={caption}>
	{rows.map((row) => (
		<DocItem name={row.name} access={row.access} actions={row.actions} />
	))}
</ul>
