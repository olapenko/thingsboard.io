---
import { Icon } from 'astro-icon/components';
import type { Responsibility } from '@data/trust-center/deployment';

// Who handles what in one deployment: what ThingsBoard handles and what you do, two lists side by
// side from 768 (one over the other on a phone), each under its own h3. It replaces the Deployment
// hub's matrix, which compared the deployments: on its own page, a deployment only needs its column.

interface Props {
	items: Responsibility;
}

const { items } = Astro.props;
const lists = [
	{ title: 'ThingsBoard handles', icon: 'tabler:building', items: items.us },
	{ title: 'You handle', icon: 'tabler:user', items: items.you },
];
---

<div class="tc-who">
	{lists.map((list) => (
		<div class="tc-who__col">
			<h3 class="tc-who__title">
				<Icon name={list.icon} aria-hidden="true" />
				{list.title}
			</h3>
			<ul class="tc-who__list">
				{list.items.map((item) => (
					<li>
						<Icon name="tabler:check" aria-hidden="true" />
						{item}
					</li>
				))}
			</ul>
		</div>
	))}
</div>

<style is:global lang="scss">
	@use '../../styles/variables' as *;

	.tc-who {
		display: grid;
		gap: $spacing-8;

		@include media-up(md) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: $spacing-10;
		}
	}

	.tc-who__col {
		display: grid;
		gap: $spacing-4;
		align-content: start;
	}

	.tc-who__title {
		@include type-tile-lg;
		display: flex;
		align-items: center;
		gap: $spacing-2;
		padding-bottom: $spacing-3;
		border-bottom: 1px solid var(--color-border-light);
		color: var(--color-text);

		svg {
			width: 20px;
			height: 20px;
			color: var(--accent-ink);
		}
	}

	.tc-who__list {
		display: grid;
		gap: $spacing-2;
		padding: 0;
		list-style: none;

		li {
			@include type-body;
			display: grid;
			grid-template-columns: 20px minmax(0, 1fr);
			gap: $spacing-3;
			color: var(--color-text-secondary);
		}

		svg {
			width: 20px;
			height: 20px;
			margin-top: 2px;
			color: var(--accent-ink);
		}
	}
</style>
