---
import type { Crumb } from '@data/trust-center/nav';

/** The draft's breadcrumb trail: `Trust Center › section › item`, the last one the page itself. */

interface Props {
	items: Crumb[];
}

const { items } = Astro.props;
const last = items.length - 1;
---

<nav class="tc-crumbs" aria-label="Breadcrumb">
	<ol class="tc-crumbs__list">
		{items.map((item, i) => (
			<li class="tc-crumbs__item">
				{item.href && i < last ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
			</li>
		))}
	</ol>
</nav>
