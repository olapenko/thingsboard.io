---
import DataTable from '@components/DataTable.astro';

/**
 * The draft's two-column fact table: a label and its text per row, no header. On `DataTable`, like
 * every marketing table, so the caption and the row headers are the shell's. Stacks on phones.
 */

interface Props {
	/** The table's accessible name, hidden. */
	caption: string;
	rows: { label: string; html: string }[];
	class?: string;
}

const { caption, rows, class: className } = Astro.props;
---

<DataTable
	caption={caption}
	columns={[{ srLabel: 'Topic' }, { srLabel: 'Details' }]}
	colgroup={false}
	headerHidden
	class:list={['tc-facts', className]}
>
	{rows.map((row) => (
		<tr>
			<th scope="row">{row.label}</th>
			<td set:html={row.html} />
		</tr>
	))}
</DataTable>
